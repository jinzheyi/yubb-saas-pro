## local host mysql/redis env
## 适用：本地复用宿主机已运行的 MySQL/Redis（不迁移数据），Docker 只启动 server+kkfileview+前端

## server
SERVER_HOST_PORT=48080
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

## datasource (host mysql)
## 对齐 shengyu-server/src/main/resources/application-local.yaml
MASTER_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/shengyu-saas?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=password
SLAVE_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/shengyu-saas?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&nullCatalogMeansCurrent=true
SLAVE_DATASOURCE_USERNAME=root
SLAVE_DATASOURCE_PASSWORD=password

## redis (host redis)
## 对齐 application-local.yaml: database=0, 默认无密码
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

## Janus
## url 会下发给 Flutter Web；api-url 仅在 server Docker 内访问宿主机 Janus。
JANUS_URL=ws://MacBook-Pro-3.local:8188
JANUS_API_URL=http://host.docker.internal:8088/janus
JANUS_API_SECRET=

## kkfileview
KKFILEVIEW_HOST_PORT=48090
KKFILEVIEW_JAVA_OPTS=-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom

## admin-vue3
ADMIN_HOST_PORT=8080
ADMIN_VITE_BASE_URL=http://localhost:${SERVER_HOST_PORT}
ADMIN_VITE_API_URL=/admin-api
ADMIN_VITE_PLATFORM_API_URL=/platform-api
ADMIN_VITE_BASE_PATH=/
ADMIN_VITE_OUT_DIR=dist-admin

## platform-vue3
PLATFORM_HOST_PORT=8081
PLATFORM_VITE_BASE_URL=http://localhost:${SERVER_HOST_PORT}
PLATFORM_VITE_API_URL=/platform-api
PLATFORM_VITE_BASE_PATH=/
PLATFORM_VITE_OUT_DIR=dist-platform
