## local docker compose env
## 适用：本地（Mac/Windows/Linux）一键起全套（mysql+redis+server+kkfileview+前端）

## mysql (container)
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=shengyu-saas
MYSQL_ROOT_PASSWORD=123456

## server
SERVER_HOST_PORT=48080
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

## datasource (point to docker mysql service)
MASTER_DATASOURCE_URL=jdbc:mysql://mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}

## redis (container)
REDIS_HOST_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

## kkfileview
KKFILEVIEW_HOST_PORT=48090
KKFILEVIEW_JAVA_OPTS=-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom

## admin-vue3
ADMIN_HOST_PORT=8080
ADMIN_VITE_BASE_URL=http://localhost:${SERVER_HOST_PORT}
ADMIN_VITE_API_URL=/admin-api
ADMIN_VITE_PLATFORM_API_URL=/platform-api
ADMIN_VITE_BASE_PATH=/
ADMIN_VITE_OUT_DIR=dist-admin

## platform-vue3
PLATFORM_HOST_PORT=8081
PLATFORM_VITE_BASE_URL=http://localhost:${SERVER_HOST_PORT}
PLATFORM_VITE_API_URL=/platform-api
PLATFORM_VITE_BASE_PATH=/
PLATFORM_VITE_OUT_DIR=dist-platform
