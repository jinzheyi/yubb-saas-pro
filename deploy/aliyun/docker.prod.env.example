## Production example for Aliyun single-host deployment.
## Copy to docker.prod.env on the server and fill secrets there.

MYSQL_DATABASE=shengyu-saas
MYSQL_ROOT_PASSWORD=CHANGE_ME_ONLY_IF_USING_COMPOSE_MYSQL

JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
SPRING_PROFILES_ACTIVE=dev

## 2C/4G 单机性能基线。机器或在线人数扩容时，可只调整这些参数，无需修改代码。
SHENGYU_TOMCAT_MAX_THREADS=80
SHENGYU_TOMCAT_MIN_SPARE_THREADS=10
SHENGYU_TOMCAT_ACCEPT_COUNT=100
SHENGYU_TOMCAT_MAX_CONNECTIONS=4096
SHENGYU_DRUID_INITIAL_SIZE=2
SHENGYU_DRUID_MIN_IDLE=5
SHENGYU_DRUID_MAX_ACTIVE=30
SHENGYU_REDIS_POOL_MAX_ACTIVE=40
SHENGYU_REDIS_POOL_MAX_IDLE=10
SHENGYU_REDIS_POOL_MIN_IDLE=2
SHENGYU_QUARTZ_THREAD_COUNT=8
SHENGYU_NETTY_BOSS_THREADS=1
SHENGYU_NETTY_WORKER_THREADS=8

## If production MySQL/Redis already run on the host, keep these host.docker.internal values.
MASTER_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=CHANGE_ME_ON_SERVER
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=CHANGE_ME_ON_SERVER

SHENGYU_CAPTCHA_ENABLE=true
SHENGYU_SECURITY_MOCK_ENABLE=false
SHENGYU_ACCESS_LOG_ENABLE=false

SHENGYU_PAY_ORDER_NOTIFY_URL=https://apisaas.shengyukj.top/admin-api/pay/notify/order
SHENGYU_PAY_REFUND_NOTIFY_URL=https://apisaas.shengyukj.top/admin-api/pay/notify/refund
SHENGYU_PAY_TRANSFER_NOTIFY_URL=https://apisaas.shengyukj.top/admin-api/pay/notify/transfer

## Must match deploy/aliyun/livekit.prod.env.example.
IM_CALL_LIVEKIT_URL=wss://rtc.shengyukj.top
IM_CALL_LIVEKIT_API_KEY=CHANGE_ME_ON_SERVER
IM_CALL_LIVEKIT_API_SECRET=CHANGE_ME_ON_SERVER
IM_CALL_LIVEKIT_TOKEN_EXPIRE_SECONDS=600
IM_CALL_LIVEKIT_ALLOW_INSECURE=false

SERVER_HOST_PORT=48080
IM_WEBSOCKET_HOST_PORT=9000
KKFILEVIEW_HOST_PORT=48090
KKFILEVIEW_JAVA_OPTS=-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom

## The backend should not start a second kkFileView process when kkfileview is already a compose service.
IM_KKFILEVIEW_ENABLED=true
IM_KKFILEVIEW_AUTO_START=false
IM_KKFILEVIEW_BASE_URL=https://preview.shengyukj.top
IM_KKFILEVIEW_SOURCE_BASE_URL=https://apisaas.shengyukj.top
IM_KKFILEVIEW_STOP_ON_SHUTDOWN=false

ADMIN_HOST_PORT=8080
ADMIN_VITE_BASE_URL=https://apisaas.shengyukj.top
ADMIN_VITE_API_URL=/admin-api
ADMIN_VITE_PLATFORM_API_URL=/platform-api
ADMIN_VITE_BASE_PATH=/
ADMIN_VITE_OUT_DIR=dist-admin

PLATFORM_HOST_PORT=8081
PLATFORM_VITE_BASE_URL=https://apisaas.shengyukj.top
PLATFORM_VITE_API_URL=/platform-api
PLATFORM_VITE_BASE_PATH=/
PLATFORM_VITE_OUT_DIR=dist-platform

## YuXin Flutter Web, served by im.shengyukj.top.
IM_FLUTTER_WEB_HOST_PORT=8082
