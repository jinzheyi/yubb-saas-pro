<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shengyu.local-api-bonjour</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/dns-sd</string>
        <string>-R</string>
        <string>Shengyu Local API</string>
        <string>_http._tcp</string>
        <string>local</string>
        <string>48080</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.shengyu.local-api-bonjour.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.shengyu.local-api-bonjour.err</string>
</dict>
</plist>
