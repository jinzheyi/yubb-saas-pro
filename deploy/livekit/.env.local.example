# Mac/Linux 局域网联调模板；真实密钥只写入被 Git 忽略的 .env。
LIVEKIT_VERSION=v1.13.1
IM_CALL_LIVEKIT_URL=ws://MacBook-Pro-3.local:7880
IM_CALL_LIVEKIT_API_KEY=replace-with-local-key
IM_CALL_LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
IM_CALL_LIVEKIT_ALLOW_INSECURE=true
IM_CALL_LIVEKIT_TOKEN_EXPIRE_SECONDS=600
LIVEKIT_DOMAIN=MacBook-Pro-3.local
# start-local.sh 会用当前默认网卡的 IPv4 覆盖该值。
LIVEKIT_NODE_IP=192.168.1.10
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:48080/app-api/system/im/call/livekit/webhook
REDIS_PASSWORD=replace-with-at-least-32-random-characters
