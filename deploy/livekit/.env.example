# 每个客户环境必须生成独立值；禁止提交真实密钥。
LIVEKIT_VERSION=v1.13.1
IM_CALL_LIVEKIT_URL=wss://rtc.example.com
IM_CALL_LIVEKIT_API_KEY=replace-with-customer-key
IM_CALL_LIVEKIT_API_SECRET=replace-with-a-long-random-secret
IM_CALL_LIVEKIT_ALLOW_INSECURE=false
IM_CALL_LIVEKIT_TOKEN_EXPIRE_SECONDS=600
LIVEKIT_DOMAIN=rtc.example.com
# 必须是客户端可路由的宿主机 IPv4；生产填公网 IP，局域网调试填宿主机 LAN IPv4。
LIVEKIT_NODE_IP=203.0.113.10
# 本机局域网调试使用 false；生产公网单节点使用 true。
LIVEKIT_USE_EXTERNAL_IP=true
# LiveKit 容器可访问的业务服务地址；生产必须使用 HTTPS。
LIVEKIT_WEBHOOK_URL=https://api.example.com/app-api/system/im/call/livekit/webhook
REDIS_PASSWORD=replace-with-a-long-random-password
