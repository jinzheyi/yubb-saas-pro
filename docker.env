## mysql
MYSQL_DATABASE=shengyu-saas
MYSQL_ROOT_PASSWORD=123456

## server
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
SPRING_PROFILES_ACTIVE=local

MASTER_DATASOURCE_URL=jdbc:mysql://shengyu-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}
REDIS_HOST=shengyu-redis
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

## 生产单机（宿主机已运行 MySQL/Redis）推荐：把上面 datasource/redis 改为宿主机地址
## - docker-compose.yml 已增加 host.docker.internal 映射（Linux）
## - 下面两行按需取消注释即可
# MASTER_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
# REDIS_HOST=host.docker.internal

## kkfileview
KKFILEVIEW_HOST_PORT=48090
KKFILEVIEW_JAVA_OPTS=-Xms512m -Xmx1024m -Djava.security.egd=file:/dev/./urandom

## admin-vue3（租户端）
ADMIN_HOST_PORT=8080
ADMIN_VITE_BASE_URL=http://localhost:48080
ADMIN_VITE_API_URL=/admin-api
ADMIN_VITE_PLATFORM_API_URL=/platform-api
ADMIN_VITE_BASE_PATH=/
ADMIN_VITE_OUT_DIR=dist-admin

## platform-vue3（平台端）
PLATFORM_HOST_PORT=8081
PLATFORM_VITE_BASE_URL=http://localhost:48080
PLATFORM_VITE_API_URL=/platform-api
PLATFORM_VITE_BASE_PATH=/
PLATFORM_VITE_OUT_DIR=dist-platform

## 生产域名（与你现网 Nginx 一致）：
## - 租户端域名: saas.shengyukj.top
## - 平台端域名: saasadmin.shengyukj.top
## - API 域名: apisaas.shengyukj.top
## 若前端也走 Docker 构建（Vite 构建时注入），建议改为下面（按需取消注释）：
# ADMIN_VITE_BASE_URL=http://apisaas.shengyukj.top
# PLATFORM_VITE_BASE_URL=http://apisaas.shengyukj.top
