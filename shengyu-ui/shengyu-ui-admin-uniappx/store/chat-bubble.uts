export type ChatBubbleMode = 'preset' | 'custom'

export type ChatBubbleConfig = {
	color: string
	mode: ChatBubbleMode
}

type ChatBubbleListener = (config: ChatBubbleConfig) => void

const CHAT_BUBBLE_KEY = 'APP_CHAT_BUBBLE_CONFIG'
const DEFAULT_BUBBLE_COLOR = '#D2E3FC'
const DEFAULT_BUBBLE_MODE: ChatBubbleMode = 'preset'
const listeners: ChatBubbleListener[] = []

function normalizeColor(raw: any): string {
	const text = raw != null ? String(raw).trim().toUpperCase() : ''
	return /^#[0-9A-F]{6}$/.test(text) ? text : DEFAULT_BUBBLE_COLOR
}

function normalizeMode(raw: any): ChatBubbleMode {
	return raw === 'custom' ? 'custom' : 'preset'
}

function normalizeConfig(raw: any): ChatBubbleConfig {
	return {
		color: normalizeColor(raw != null ? raw.color : ''),
		mode: normalizeMode(raw != null ? raw.mode : '')
	}
}

function notifyBubbleListeners(config: ChatBubbleConfig): void {
	for (let i = 0; i < listeners.length; i++) {
		try {
			listeners[i](config)
		} catch (e) {
			console.error('[chat-bubble] notify listener failed:', e)
		}
	}
}

export function getDefaultChatBubbleConfig(): ChatBubbleConfig {
	return {
		color: DEFAULT_BUBBLE_COLOR,
		mode: DEFAULT_BUBBLE_MODE
	}
}

export function getChatBubbleConfig(): ChatBubbleConfig {
	try {
		const raw = uni.getStorageSync(CHAT_BUBBLE_KEY)
		if (raw == null || raw === '') {
			return getDefaultChatBubbleConfig()
		}
		if (typeof raw === 'string') {
			return normalizeConfig(JSON.parse(raw))
		}
		return normalizeConfig(raw)
	} catch (e) {
		return getDefaultChatBubbleConfig()
	}
}

export function setChatBubbleConfig(config: ChatBubbleConfig): void {
	const normalized = normalizeConfig(config)
	uni.setStorageSync(CHAT_BUBBLE_KEY, JSON.stringify(normalized))
	notifyBubbleListeners(normalized)
}

export function setChatBubbleColor(color: string, mode: ChatBubbleMode): void {
	setChatBubbleConfig({
		color: normalizeColor(color),
		mode: normalizeMode(mode)
	})
}

export function resetChatBubbleConfig(): void {
	setChatBubbleConfig(getDefaultChatBubbleConfig())
}

export function subscribeChatBubbleChange(listener: ChatBubbleListener): () => void {
	listeners.push(listener)
	try {
		listener(getChatBubbleConfig())
	} catch (e) {
		// ignore
	}
	return () => {
		const index = listeners.indexOf(listener)
		if (index >= 0) {
			listeners.splice(index, 1)
		}
	}
}
