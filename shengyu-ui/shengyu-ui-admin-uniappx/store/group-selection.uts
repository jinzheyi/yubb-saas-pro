/**
 * 群聊创建 - 成员选择状态管理
 */

// 选中的成员列表
const selectedMembers = ref<any[]>([])

// 是否处于选择模式
const isInSelectionMode = ref(false)

// 选择数量上限：0 表示不限制
const selectionLimit = ref(0)

/**
 * 开始选择模式
 * @param limit 选择数量上限，0 表示不限制
 */
export function startSelection(limit : number = 0) {
	isInSelectionMode.value = true
	selectionLimit.value = limit > 0 ? Math.floor(limit) : 0
	selectedMembers.value = []
}

/**
 * 结束选择模式（清空数据）
 */
export function endSelection() {
	isInSelectionMode.value = false
	selectionLimit.value = 0
	selectedMembers.value = []
}

/**
 * 获取是否处于选择模式
 */
export function getIsInSelectionMode() : boolean {
	return isInSelectionMode.value
}

/**
 * 获取当前选择数量上限，0 表示不限制
 */
export function getSelectionLimit() : number {
	return selectionLimit.value
}

/**
 * 设置选择数量上限
 */
export function setSelectionLimit(limit : number) {
	selectionLimit.value = limit > 0 ? Math.floor(limit) : 0
	if (selectionLimit.value > 0 && selectedMembers.value.length > selectionLimit.value) {
		selectedMembers.value = selectedMembers.value.slice(0, selectionLimit.value)
	}
}

/**
 * 添加成员到选中列表
 */
export function addMember(member : any) {
	const memberId = member != null && member.id != null ? String(member.id) : ''
	if (memberId === '') {
		return
	}
	const payload = {
		id: memberId,
		name: member != null
			? (member.name != null ? String(member.name) : (member.displayName != null ? String(member.displayName) : (member.nickname != null ? String(member.nickname) : '')))
			: '',
		role: member != null && member.role != null ? String(member.role) : '',
		avatarText: member != null && member.avatarText != null ? String(member.avatarText) : '',
		avatarBg: member != null && member.avatarBg != null ? String(member.avatarBg) : '',
		deptName: member != null && member.deptName != null ? String(member.deptName) : '',
		postName: member != null && member.postName != null ? String(member.postName) : '',
		avatar: member != null && member.avatar != null ? String(member.avatar) : ''
	}

	if (selectionLimit.value === 1) {
		selectedMembers.value = [payload]
		return
	}

	const exists = selectedMembers.value.some(m => String(m.id) === memberId)
	if (!exists) {
		if (selectionLimit.value > 0 && selectedMembers.value.length >= selectionLimit.value) {
			return
		}
		selectedMembers.value.push(payload)
	}
}

/**
 * 从选中列表移除成员
 */
export function removeMember(memberId : string) {
	const index = selectedMembers.value.findIndex(m => String(m.id) === memberId)
	if (index > -1) {
		selectedMembers.value.splice(index, 1)
	}
}

/**
 * 批量添加成员
 */
export function addMembers(members : any[]) {
	for (let i = 0; i < members.length; i++) {
		addMember(members[i])
	}
}

/**
 * 批量移除成员
 */
export function removeMembers(memberIds : string[]) {
	for (let i = 0; i < memberIds.length; i++) {
		removeMember(memberIds[i])
	}
}

/**
 * 检查成员是否已选中
 */
export function isMemberSelected(memberId : string) : boolean {
	return selectedMembers.value.some(m => String(m.id) === memberId)
}

/**
 * 获取所有选中的成员
 */
export function getSelectedMembers() : any[] {
	return selectedMembers.value
}

/**
 * 获取选中的成员数量
 */
export function getSelectedCount() : number {
	return selectedMembers.value.length
}

/**
 * 切换成员选中状态
 */
export function toggleMember(member : any) {
	const memberId = member != null && member.id != null ? String(member.id) : ''
	if (memberId === '') {
		return
	}
	if (isMemberSelected(memberId)) {
		removeMember(memberId)
	} else {
		addMember(member)
	}
}

/**
 * 设置选中的成员列表（用于恢复状态）
 */
export function setSelectedMembers(members : any[]) {
	if (!Array.isArray(members)) {
		selectedMembers.value = []
		return
	}
	if (selectionLimit.value > 0) {
		selectedMembers.value = members.slice(0, selectionLimit.value)
		return
	}
	selectedMembers.value = members
}
