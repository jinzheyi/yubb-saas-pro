/**
 * 国际化 Store
 * 管理语言切换
 * 兼容 Android、iOS、Web 三端
 * 参考 PC 端 store/modules/locale.ts
 */

import zhCN from '../locales/zh-CN.uts'
import en from '../locales/en.uts'

// 存储 Key
const LOCALE_KEY = 'LOCALE'
const LANGUAGE_MODE_KEY = 'LANGUAGE_MODE'
const FRAMEWORK_LOCALE_ZH_HANS = 'zh-Hans'
const FRAMEWORK_LOCALE_EN = 'en'

/**
 * 语言类型
 */
export type LocaleType = 'zh-CN' | 'en'
export type LanguageMode = 'system' | LocaleType

/**
 * 语言配置
 */
export type LocaleConfig = {
	lang: LocaleType
	name: string
}

type LocaleListener = (resolvedLocale: LocaleType, languageMode: LanguageMode) => void

/**
 * 语言包映射
 */
const localeMap: Map<LocaleType, any> = new Map([
	['zh-CN', zhCN],
	['en', en]
])

/**
 * 可用语言列表
 */
const availableLocales: LocaleConfig[] = [
	{
		lang: 'zh-CN',
		name: '简体中文'
	},
	{
		lang: 'en',
		name: 'English'
	}
]

const localeListeners: LocaleListener[] = []

/**
 * 获取当前语言
 * @returns 当前语言类型
 */
export function getCurrentLocale(): LocaleType {
	return resolveLocale(getLanguageMode())
}

/**
 * 设置当前语言
 * @param locale 语言类型
 */
export function setCurrentLocale(locale: LocaleType) {
	setLanguageMode(locale)
}

export function getLanguageMode(): LanguageMode {
	const languageMode = uni.getStorageSync(LANGUAGE_MODE_KEY)
	if (languageMode === 'system' || languageMode === 'zh-CN' || languageMode === 'en') {
		return languageMode as LanguageMode
	}
	const legacyLocale = uni.getStorageSync(LOCALE_KEY)
	if (legacyLocale === 'zh-CN' || legacyLocale === 'en') {
		return legacyLocale as LanguageMode
	}
	return 'system'
}

export function setLanguageMode(languageMode: LanguageMode) {
	uni.setStorageSync(LANGUAGE_MODE_KEY, languageMode)
	const resolvedLocale = resolveLocale(languageMode)
	uni.setStorageSync(LOCALE_KEY, resolvedLocale)
	applyFrameworkLocale(resolvedLocale)
	emitLocaleChange(resolvedLocale, languageMode)
}

export function resolveLocale(languageMode: LanguageMode): LocaleType {
	if (languageMode === 'zh-CN' || languageMode === 'en') {
		return languageMode
	}
	return getSystemLocale()
}

export function getResolvedLocale(): LocaleType {
	return getCurrentLocale()
}

function toFrameworkLocale(locale: LocaleType): string {
	return locale === 'en' ? FRAMEWORK_LOCALE_EN : FRAMEWORK_LOCALE_ZH_HANS
}

function applyFrameworkLocale(resolvedLocale: LocaleType): void {
	try {
		const nextLocale = toFrameworkLocale(resolvedLocale)
		const anyUni = uni as any
		const currentLocale = typeof anyUni.getLocale === 'function' ? String(anyUni.getLocale() || '') : ''
		if (currentLocale === nextLocale) {
			return
		}
		if (typeof anyUni.setLocale === 'function') {
			anyUni.setLocale(nextLocale)
		}
	} catch (e) {
		console.warn('[locale] apply framework locale failed:', e)
	}
}

function emitLocaleChange(resolvedLocale: LocaleType, languageMode: LanguageMode) {
	localeListeners.forEach((listener) => {
		try {
			listener(resolvedLocale, languageMode)
		} catch (e) {
			console.warn('[locale] locale listener failed:', e)
		}
	})
}

export function subscribeLocaleChange(listener: LocaleListener): () => void {
	localeListeners.push(listener)
	return () => {
		const index = localeListeners.indexOf(listener)
		if (index >= 0) {
			localeListeners.splice(index, 1)
		}
	}
}

/**
 * 获取可用语言列表
 * @returns 语言配置列表
 */
export function getAvailableLocales(): LocaleConfig[] {
	return availableLocales
}

/**
 * 获取当前语言包
 * @returns 语言包对象
 */
export function getCurrentMessages(): any {
	const locale = getCurrentLocale()
	return localeMap.get(locale) || zhCN
}

/**
 * 获取指定语言包
 * @param locale 语言类型
 * @returns 语言包对象
 */
export function getMessages(locale: LocaleType): any {
	return localeMap.get(locale) || zhCN
}

/**
 * 翻译函数
 * @param key 翻译键（支持点号分隔的路径，如 'common.login'）
 * @param params 参数对象或默认值（可选）
 * @returns 翻译后的文本
 */
export function t(key: string, params?: any): string {
	const messages = getCurrentMessages()
	
	// 分割键路径
	const keys = key.split('.')
	let value: any = messages
	
	// 逐级查找
	for (let i = 0; i < keys.length; i++) {
		if (value && typeof value === 'object') {
			value = value[keys[i]]
		} else {
			value = null
			break
		}
	}
	
	// 如果找到翻译文本
	if (value && typeof value === 'string') {
		// 如果 params 是对象，进行参数替换
		if (params && typeof params === 'object') {
			let result = value
			// 替换所有 {key} 格式的占位符
			for (const paramKey in params) {
				const regex = new RegExp('\\{' + paramKey + '\\}', 'g')
				result = result.replace(regex, params[paramKey].toString())
			}
			return result
		}
		return value
	}
	
	// 如果 params 是字符串，作为默认值返回
	if (params && typeof params === 'string') {
		return params
	}
	
	return key
}

/**
 * 切换语言
 * @param locale 语言类型
 */
export function switchLocale(locale: LocaleType) {
	setLanguageMode(locale)
	
	// 提示用户
	uni.showToast({
		title: t('common.switchSuccess'),
		icon: 'success'
	})
}

/**
 * 获取系统语言
 * @returns 系统语言类型
 */
export function getSystemLocale(): LocaleType {
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	// 获取系统语言
	const systemInfo = uni.getSystemInfoSync()
	const language = systemInfo.language
	
	if (language.indexOf('zh') !== -1) {
		return 'zh-CN'
	} else if (language.indexOf('en') !== -1) {
		return 'en'
	}
	// #endif
	
	// #ifdef H5
	// 获取浏览器语言
	// @ts-ignore
	const language = navigator.language || navigator.userLanguage
	if (language.indexOf('zh') !== -1) {
		return 'zh-CN'
	} else if (language.indexOf('en') !== -1) {
		return 'en'
	}
	// #endif
	
	// 默认返回中文
	return 'zh-CN'
}

/**
 * 初始化语言
 * 如果没有设置过语言，则使用系统语言
 */
export function initLocale() {
	const languageMode = uni.getStorageSync(LANGUAGE_MODE_KEY)
	const locale = uni.getStorageSync(LOCALE_KEY)
	if (!languageMode && !locale) {
		setLanguageMode('system')
		return
	}
	applyFrameworkLocale(getCurrentLocale())
	emitLocaleChange(getCurrentLocale(), getLanguageMode())
}
