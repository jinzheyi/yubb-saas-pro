// 认证相关API
import request from '@/utils/request.uts'

/**
 * 用户信息类型
 */
export type UserInfo = {
  id: number
  nickname: string
  avatar?: string
  username: string
}

/**
 * 邮箱密码登录请求参数
 */
export type EmailLoginParams = {
  username: string
  password: string
  captchaVerification: string
}

/**
 * 手机号验证码登录请求参数
 */
export type SmsLoginParams = {
  mobile: string
  code: string
}

/**
 * 发送验证码请求参数
 */
export type SendSmsParams = {
  mobile: string
  scene: number
}

/**
 * 登录响应数据
 */
export type LoginResponse = {
  accessToken: string
  refreshToken: string
  user: UserInfo
}

/**
 * 邮箱密码登录
 * @param params 登录参数
 * @returns 登录结果
 */
export const emailLogin = (params: EmailLoginParams) => {
  return request<LoginResponse>({
    url: '/system/auth/login',
    method: 'POST',
    data: params
  })
}

/**
 * 手机号验证码登录
 * @param params 登录参数
 * @returns 登录结果
 */
export const smsLogin = (params: SmsLoginParams) => {
  return request<LoginResponse>({
    url: '/system/auth/sms-login',
    method: 'POST',
    data: params
  })
}

/**
 * 发送手机验证码
 * @param params 发送验证码参数
 * @returns 发送结果
 */
export const sendSmsCode = (params: SendSmsParams) => {
  return request<boolean>({
    url: '/system/auth/send-sms-code',
    method: 'POST',
    data: params
  })
}

/**
 * 登出
 * @returns 登出结果
 */
export const logout = () => {
  return request<boolean>({
    url: '/system/auth/logout',
    method: 'POST'
  })
}

/**
 * 刷新token
 * @param refreshToken 刷新token
 * @returns 新的token信息
 */
export const refreshToken = (refreshToken: string) => {
  return request<LoginResponse>({
    url: '/system/auth/refresh-token',
    method: 'POST',
    params: {
      refreshToken
    }
  })
}

/**
 * 获取用户权限信息
 * @returns 用户权限信息
 */
export const getPermissionInfo = () => {
  return request({
    url: '/system/auth/get-permission-info',
    method: 'GET'
  })
}