import { request } from '../utils/request.uts'
import { BASE_URL as CONFIG_BASE_URL } from '../config/app.config.uts'
import { getToken, getTenantId } from '../utils/request.uts'

/**
 * 上传群文件
 */
export function uploadGroupFile(groupId: string, filePath: string): Promise<any> {
  return new Promise((resolve, reject) => {
    // 获取 token 和租户 ID
    const token = getToken()
    const tenantId = getTenantId()
    
    // 构建请求头
    const header: UTSJSONObject = {}
    if (token) {
      header['Authorization'] = 'Bearer ' + token
    }
    if (tenantId) {
      header['tenant-id'] = tenantId
    }
    
    // 使用 uni.uploadFile 上传
    uni.uploadFile({
      url: CONFIG_BASE_URL + '/app-api/system/im/group/file/upload',
      filePath: filePath,
      name: 'file',
      formData: {
        groupId: groupId
      },
      header: header,
      success: (res) => {
        if (res.statusCode === 200) {
          try {
            const data = JSON.parse(res.data)
            if (data.code === 0) {
              resolve(data.data)
            } else {
              reject(data)
            }
          } catch (e) {
            reject(new Error('解析响应失败'))
          }
        } else {
          reject(new Error('上传失败，状态码：' + res.statusCode))
        }
      },
      fail: (err) => {
        reject(err)
      }
    })
  })
}

/**
 * 获取群文件列表
 */
export function getGroupFileList(params: any) {
  const groupId = params.groupId || ''
  const pageNo = params.pageNo || 1
  const pageSize = params.pageSize || 20
  const fileName = params.fileName || ''
  const fileType = params.fileType || ''
  
  let url = `/system/im/group/file/list?groupId=${groupId}&pageNo=${pageNo}&pageSize=${pageSize}`
  if (fileName) {
    url += `&fileName=${fileName}`
  }
  if (fileType) {
    url += `&fileType=${fileType}`
  }
  
  return request({
    url: url,
    method: 'GET'
  })
}

/**
 * 删除群文件
 */
export function deleteGroupFile(id: number) {
  return request({
    url: `/system/im/group/file/delete?id=${id}`,
    method: 'DELETE'
  })
}

/**
 * 记录文件下载
 */
export function downloadGroupFile(id: number) {
  return request({
    url: `/system/im/group/file/download?id=${id}`,
    method: 'POST'
  })
}
