/**
 * 部门管理 API
 */

import { get } from '../utils/request.uts'

/**
 * 获取我的部门树
 * 获取当前用户所在部门及其父级部门的树形结构
 * @param keyword 搜索关键词（可选）
 */
export function getMyDeptTree(keyword?: string): Promise<any> {
	const url = keyword ? `/system/dept/my-dept-tree?keyword=${encodeURIComponent(keyword)}` : '/system/dept/my-dept-tree'
	return get(url)
}

/**
 * 获取组织结构树
 * 获取完整的组织结构树（不包含成员数据，成员需通过getDeptMembers按需加载）
 */
export function getOrgTree(): Promise<any> {
	return get('/system/dept/org-tree')
}

/**
 * 获取部门成员
 * 获取指定部门的成员列表，支持搜索
 * @param deptId 部门ID
 * @param keyword 搜索关键词（可选）
 */
export function getDeptMembers(deptId: string, keyword?: string): Promise<any> {
	const url = keyword 
		? `/system/dept/dept-members?deptId=${deptId}&keyword=${encodeURIComponent(keyword)}` 
		: `/system/dept/dept-members?deptId=${deptId}`
	return get(url)
}

/**
 * 获取部门详情
 * @param id 部门ID（字符串，避免精度丢失）
 */
export function getDept(id: string): Promise<any> {
	return get(`/system/dept/get?id=${id}`)
}
