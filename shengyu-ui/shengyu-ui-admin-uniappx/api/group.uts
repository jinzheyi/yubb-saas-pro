/**
 * 群组管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 创建群组
 */
export function createGroup(data: any): Promise<any> {
  return request({
    url: '/system/im/group/create',
    method: 'POST',
    data: data
  })
}

/**
 * 更新群组信息
 */
export function updateGroup(data: any): Promise<any> {
  return request({
    url: '/system/im/group/update',
    method: 'PUT',
    data: data
  })
}

/**
 * 解散群组
 */
export function dissolveGroup(id: string): Promise<any> {
  return request({
    url: `/system/im/group/dissolve?id=${id}`,
    method: 'DELETE'
  })
}

/**
 * 退出群组
 */
export function quitGroup(id: string): Promise<any> {
  return request({
    url: `/system/im/group/quit?id=${id}`,
    method: 'POST'
  })
}

/**
 * 获取群组信息
 */
export function getGroup(id: string): Promise<any> {
  return request({
    url: `/system/im/group/get?id=${id}`,
    method: 'GET'
  })
}

/**
 * 获取用户的群组列表
 */
export function getGroupList(): Promise<any> {
  return request({
    url: '/system/im/group/list',
    method: 'GET'
  })
}

/**
 * 添加群成员
 */
export function addGroupMembers(data: any): Promise<any> {
  return request({
    url: '/system/im/group/member/add',
    method: 'POST',
    data: data
  })
}

/**
 * 移除群成员
 */
export function removeGroupMember(groupId: string, memberUserId: string): Promise<any> {
  return request({
    url: `/system/im/group/member/remove?groupId=${groupId}&memberUserId=${memberUserId}`,
    method: 'DELETE'
  })
}

/**
 * 获取群成员列表
 */
export function getGroupMembers(groupId: string): Promise<any> {
  return request({
    url: `/system/im/group/member/list?groupId=${groupId}`,
    method: 'GET'
  })
}

/**
 * 设置群成员角色
 */
export function setGroupMemberRole(groupId: string, memberUserId: string, role: number): Promise<any> {
  return request({
    url: `/system/im/group/member/set-role?groupId=${groupId}&memberUserId=${memberUserId}&role=${role}`,
    method: 'PUT'
  })
}

/**
 * 设置群成员禁言
 */
export function setGroupMemberMuted(groupId: string, memberUserId: string, muted: boolean): Promise<any> {
  return request({
    url: `/system/im/group/member/set-muted?groupId=${groupId}&memberUserId=${memberUserId}&muted=${muted}`,
    method: 'PUT'
  })
}

/**
 * 设置群成员昵称
 */
export function setGroupMemberNickname(data: any): Promise<any> {
  return request({
    url: '/system/im/group/member/set-nickname',
    method: 'PUT',
    data: data
  })
}

/**
 * 转让群主
 */
export function transferGroupOwner(groupId: string, newOwnerId: string): Promise<any> {
  return request({
    url: `/system/im/group/transfer-owner?groupId=${groupId}&newOwnerId=${newOwnerId}`,
    method: 'PUT'
  })
}

// ==================== 群邀请码相关接口 ====================

/**
 * 生成群邀请码
 * @param data { groupId: string, expireHours?: number, maxUseCount?: number }
 */
export function generateGroupInvite(data: any): Promise<any> {
  return request({
    url: '/system/im/group/invite/generate',
    method: 'POST',
    data: data
  })
}

/**
 * 验证邀请码
 * @param code 邀请码
 */
export function verifyInviteCode(code: string): Promise<any> {
  return request({
    url: `/system/im/group/invite/verify?code=${code}`,
    method: 'GET'
  })
}

/**
 * 通过邀请码加入群
 * @param code 邀请码
 */
export function joinGroupByInvite(code: string): Promise<any> {
  return request({
    url: '/system/im/group/invite/join',
    method: 'POST',
    data: { inviteCode: code }
  })
}

export function getGroupJoinRequests(groupId: string, status?: number): Promise<any> {
  const statusQuery = status != null ? `&status=${status}` : ''
  return request({
    url: `/system/im/group/join-request/list?groupId=${groupId}${statusQuery}`,
    method: 'GET'
  })
}

export function getGroupJoinRequestPendingCount(groupId: string): Promise<any> {
  return request({
    url: `/system/im/group/join-request/pending-count?groupId=${groupId}`,
    method: 'GET'
  })
}

export function approveGroupJoinRequest(requestId: string): Promise<any> {
  return request({
    url: '/system/im/group/join-request/approve',
    method: 'PUT',
    data: { requestId: requestId }
  })
}

export function rejectGroupJoinRequest(requestId: string, rejectReason: string = ''): Promise<any> {
  return request({
    url: '/system/im/group/join-request/reject',
    method: 'PUT',
    data: { requestId: requestId, rejectReason: rejectReason }
  })
}

/**
 * 获取群的有效邀请码
 * @param groupId 群组ID
 */
export function getGroupInviteCode(groupId: string): Promise<any> {
  return request({
    url: `/system/im/group/invite/get?groupId=${groupId}`,
    method: 'GET'
  })
}

// ==================== 群公告相关接口 ====================

/**
 * 更新群公告
 * @param data { groupId: string, notice: string }
 */
export function updateGroupNotice(data: any): Promise<any> {
  return request({
    url: '/system/im/group/notice/update',
    method: 'PUT',
    data: data
  })
}
