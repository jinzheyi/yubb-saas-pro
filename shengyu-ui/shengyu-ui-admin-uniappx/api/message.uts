/**
 * 消息管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 获取消息列表（分页）
 * @param chatId ChatID
 * @param pageNo 页码（默认1）
 * @param pageSize 每页数量（默认20）
 */
export function getMessageList(chatId: string, pageNo: number = 1, pageSize: number = 20): Promise<any> {
  return request({
    url: `/system/im/message/list-by-chat?chatId=${chatId}&pageNo=${pageNo}&pageSize=${pageSize}`,
    method: 'GET'
  })
}

/**
 * 撤回消息
 */
export function recallMessage(id: string): Promise<any> {
  return request({
    url: `/system/im/message/recall?id=${id}`,
    method: 'PUT'
  })
}

/**
 * 删除消息
 */
export function deleteMessage(id: string): Promise<any> {
  return request({
    url: `/system/im/message/delete?id=${id}`,
    method: 'DELETE'
  })
}

/**
 * 标记消息已读
 * @param messageIds 消息ID列表
 */
export function markMessageRead(messageIds: string[]): Promise<any> {
  return request({
    url: '/system/im/message/mark-read',
    method: 'PUT',
    params: {
      messageIds: messageIds
    }
  })
}

/**
 * 获取未读消息数
 */
export function getUnreadCount(): Promise<any> {
  return request({
    url: '/system/im/message/unread-count',
    method: 'GET'
  })
}

/**
 * 搜索聊天记录
 * @param chatId ChatID
 * @param keyword 搜索关键词
 * @param startTime 开始时间（可选）
 * @param endTime 结束时间（可选）
 * @param pageNo 页码（默认1）
 * @param pageSize 每页数量（默认20）
 */
export function searchMessages(
  chatId: string,
  keyword: string,
  startTime?: string,
  endTime?: string,
  pageNo: number = 1,
  pageSize: number = 20
): Promise<any> {
  let url = `/system/im/message/search?chatId=${chatId}&keyword=${encodeURIComponent(keyword)}&pageNo=${pageNo}&pageSize=${pageSize}`
  if (startTime) {
    url += `&startTime=${encodeURIComponent(startTime)}`
  }
  if (endTime) {
    url += `&endTime=${encodeURIComponent(endTime)}`
  }
  return request({
    url: url,
    method: 'GET'
  })
}
