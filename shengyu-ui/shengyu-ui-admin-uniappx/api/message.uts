/**
 * 消息管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 获取消息列表（分页）
 * @param chatId ChatID
 * @param pageNo 页码（默认1）
 * @param pageSize 每页数量（默认20）
 */
export function getMessageList(chatId: string, pageNo: number = 1, pageSize: number = 20): Promise<any> {
  return request({
    url: `/system/im/message/list-by-chat?chatId=${chatId}&pageNo=${pageNo}&pageSize=${pageSize}`,
    method: 'GET'
  })
}

/**
 * 获取聊天页消息窗口（latest / anchor）
 */
export function getMessageWindow(params: {
  chatId: string
  mode?: string | null
  anchorSequence?: string | null
  anchorMessageId?: string | null
  limit?: number | null
  beforeLimit?: number | null
  afterLimit?: number | null
}): Promise<any> {
  const query: string[] = [`chatId=${encodeURIComponent(params.chatId)}`]
  if (params.mode != null && params.mode !== '') {
    query.push(`mode=${encodeURIComponent(params.mode)}`)
  }
  if (params.anchorSequence != null && params.anchorSequence !== '') {
    query.push(`anchorSequence=${encodeURIComponent(params.anchorSequence)}`)
  }
  if (params.anchorMessageId != null && params.anchorMessageId !== '') {
    query.push(`anchorMessageId=${encodeURIComponent(params.anchorMessageId)}`)
  }
  if (params.limit != null && params.limit > 0) {
    query.push(`limit=${params.limit}`)
  }
  if (params.beforeLimit != null && params.beforeLimit > 0) {
    query.push(`beforeLimit=${params.beforeLimit}`)
  }
  if (params.afterLimit != null && params.afterLimit > 0) {
    query.push(`afterLimit=${params.afterLimit}`)
  }
  return request({
    url: `/system/im/message/window?${query.join('&')}`,
    method: 'GET'
  })
}

/**
 * 获取更早历史消息
 */
export function getMessageHistory(chatId: string, beforeSequence: string, limit: number = 30): Promise<any> {
  return request({
    url: `/system/im/message/history?chatId=${encodeURIComponent(chatId)}&beforeSequence=${encodeURIComponent(beforeSequence)}&limit=${limit}`,
    method: 'GET'
  })
}

/**
 * 撤回消息
 */
export function recallMessage(id: string): Promise<any> {
  return request({
    url: `/system/im/message/recall?id=${id}`,
    method: 'PUT'
  })
}

export function getRecallConfig(): Promise<any> {
  return request({
    url: '/system/im/message/recall-config',
    method: 'GET'
  })
}

/**
 * 删除消息
 */
export function deleteMessage(id: string): Promise<any> {
  return request({
    url: `/system/im/message/delete?id=${id}`,
    method: 'DELETE'
  })
}

export function clearConversationMessages(chatId: string): Promise<any> {
  return request({
    url: `/system/im/message/clear?chatId=${chatId}`,
    method: 'DELETE'
  })
}

/**
 * 获取未读消息数
 */
export function getUnreadCount(): Promise<any> {
  return request({
    url: '/system/im/message/unread-count',
    method: 'GET'
  })
}

/**
 * 搜索聊天记录
 * @param chatId ChatID
 * @param keyword 搜索关键词
 * @param startTime 开始时间（可选）
 * @param endTime 结束时间（可选）
 * @param pageNo 页码（默认1）
 * @param pageSize 每页数量（默认20）
 */
export function searchMessages(
  chatId: string,
  keyword: string,
  startTime?: string,
  endTime?: string,
  pageNo: number = 1,
  pageSize: number = 20
): Promise<any> {
  let url = `/system/im/message/search?chatId=${chatId}&keyword=${encodeURIComponent(keyword)}&pageNo=${pageNo}&pageSize=${pageSize}`
  if (startTime) {
    url += `&startTime=${encodeURIComponent(startTime)}`
  }
  if (endTime) {
    url += `&endTime=${encodeURIComponent(endTime)}`
  }
  return request({
    url: url,
    method: 'GET'
  })
}

/**
 * 增量拉取消息（断线补偿）
 * @param chatId ChatID
 * @param lastSequence 最后拉取的 sequence（水位）
 * @param limit 拉取条数（默认200，最大500）
 */
export function pullMessages(chatId: string, lastSequence: string = '0', limit: number = 200): Promise<any> {
  return request({
    url: `/system/im/message/pull?chatId=${chatId}&lastSequence=${lastSequence}&limit=${limit}`,
    method: 'GET'
  })
}

export function sendMessage(data: any): Promise<string> {
  return request({
    url: '/system/im/message/send',
    method: 'POST',
    data: data
  })
}

/**
 * 标记消息已读（批量）
 * @param messageIds 消息ID列表
 */
export function markMessageRead(messageIds: string[]): Promise<any> {
  const ids = messageIds != null ? messageIds.filter(id => id != null && id !== '' && id !== '0') : []
  if (ids.length === 0) {
    return Promise.resolve(true)
  }
  const qs = ids.map(id => `messageIds=${encodeURIComponent(id)}`).join('&')
  return request({
    url: `/system/im/message/mark-read?${qs}`,
    method: 'PUT'
  })
}

/**
 * 标记语音消息已播放（多端同步未听点）
 * @param messageId 消息ID
 */
export function markVoicePlayed(messageId: string): Promise<any> {
  const mid = messageId != null ? String(messageId) : ''
  if (mid === '' || mid === '0') {
    return Promise.resolve(true)
  }
  return request({
    url: `/system/im/message/mark-voice-played?messageId=${encodeURIComponent(mid)}`,
    method: 'PUT'
  })
}

/**
 * 批量标记语音消息已播放（用于 300ms 聚合上报）
 * @param messageIds 消息ID列表
 */
export function markVoicePlayedBatch(messageIds: string[]): Promise<any> {
  const ids = messageIds != null ? messageIds.filter(id => id != null && id !== '' && id !== '0') : []
  if (ids.length === 0) {
    return Promise.resolve(true)
  }
  const qs = ids.map(id => `messageIds=${encodeURIComponent(id)}`).join('&')
  return request({
    url: `/system/im/message/mark-voice-played-batch?${qs}`,
    method: 'PUT'
  })
}

/**
 * 查询语音消息已播放状态（用于推送丢失补偿）
 * @param chatId 会话ID
 * @param messageIds 消息ID列表
 */
export function getVoicePlayedStatus(chatId: string, messageIds: string[]): Promise<any> {
  const cid = chatId != null ? String(chatId) : ''
  const ids = messageIds != null ? messageIds.filter(id => id != null && id !== '' && id !== '0') : []
  if (cid === '' || cid === '0' || ids.length === 0) {
    return Promise.resolve([])
  }
  const qs = ids.map(id => `messageIds=${encodeURIComponent(id)}`).join('&')
  return request({
    url: `/system/im/message/voice-played-status?chatId=${encodeURIComponent(cid)}&${qs}`,
    method: 'GET'
  })
}

export function forwardMessages(targetChatId: string, messageIds: string[], forwardType: number, comment: string | null = null): Promise<any> {
  const ids = messageIds != null ? messageIds.filter(id => id != null && id !== '' && id !== '0') : []
  if (targetChatId == null || targetChatId === '' || targetChatId === '0' || ids.length === 0) {
    return Promise.reject(new Error('invalid forward params'))
  }
  const body: any = {
    targetChatId: targetChatId,
    messageIds: ids,
    forwardType: forwardType === 2 ? 2 : 1
  }
  if (comment != null && comment !== '') {
    body.comment = comment
  }
  return request({
    url: '/system/im/message/forward',
    method: 'POST',
    data: body
  })
}

export function getMessageDetail(messageId: string): Promise<any> {
  const mid = messageId != null ? String(messageId) : ''
  if (mid === '' || mid === '0') {
    return Promise.reject(new Error('invalid messageId'))
  }
  return request({
    url: `/system/im/message/detail?id=${encodeURIComponent(mid)}`,
    method: 'GET'
  })
}

/**
 * 位置检索（服务端代理，避免前端依赖 uniCloud/地图插件）
 */
export function searchLocation(keyword: string, latitude?: number, longitude?: number, pageSize: number = 20): Promise<any> {
  const kw = keyword != null ? keyword.trim() : ''
  const query: string[] = [
    `pageSize=${Math.max(1, Math.min(20, pageSize))}`
  ]
  if (kw !== '') {
    query.push(`keyword=${encodeURIComponent(kw)}`)
  }
  if (latitude != null && !isNaN(latitude)) {
    query.push(`latitude=${encodeURIComponent(String(latitude))}`)
  }
  if (longitude != null && !isNaN(longitude)) {
    query.push(`longitude=${encodeURIComponent(String(longitude))}`)
  }
  return request({
    url: `/system/im/message/location-search?${query.join('&')}`,
    method: 'GET'
  })
}
