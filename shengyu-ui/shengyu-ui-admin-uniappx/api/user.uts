/**
 * 用户管理 API
 */

import { del, get, put } from '../utils/request.uts'
import { API_BASE_URL, MAX_IMAGE_SIZE } from '../config/app.config.uts'
import { uploadFile } from '../utils/upload.uts'
import type { ThemeMode } from '../config/theme.uts'
import type { ChatBubbleConfig } from '../store/chat-bubble.uts'

/**
 * 获取用户详情
 * @param id 用户ID（字符串，避免精度丢失）
 */
export function getUserDetail(id: string): Promise<any> {
	const userId = id != null ? String(id) : ''
	return get(`/system/user/get?id=${encodeURIComponent(userId)}`)
}

/**
 * 获取当前用户详情
 */
export function getCurrentUserDetail(): Promise<any> {
	return get('/system/user/get-profile')
}

/**
 * 更新当前用户头像
 * @param filePath 本地文件路径
 * @param onProgress 上传进度回调
 */
export function updateCurrentUserAvatar(
	filePath: string,
	onProgress?: (progress: number) => void
): Promise<string> {
	return new Promise((resolve, reject) => {
		uploadFile(filePath, {
			url: API_BASE_URL + '/system/user/avatar',
			name: 'avatarFile',
			maxSize: MAX_IMAGE_SIZE,
			showToast: true,
			onProgress: onProgress
		}).then((result) => {
			const data = result.data as any
			if (typeof data === 'string') {
				resolve(data)
				return
			}
			if (data && data.url) {
				resolve(data.url)
				return
			}
			reject(new Error('头像上传返回数据无效'))
		}).catch((err) => {
			reject(err)
		})
	})
}

/**
 * 删除当前用户自定义头像
 */
export function clearCurrentUserAvatar(): Promise<boolean> {
	return del('/system/user/avatar')
}

/**
 * 更新当前用户主题偏好
 */
export function updateCurrentUserThemePreference(themeMode: ThemeMode): Promise<boolean> {
	return put('/system/user/theme', {
		themeMode: themeMode
	} as UTSJSONObject)
}

/**
 * 更新当前用户聊天气泡偏好
 */
export function updateCurrentUserChatBubblePreference(config: ChatBubbleConfig): Promise<boolean> {
	return put('/system/user/chat-bubble', {
		chatBubbleColor: config.color,
		chatBubbleMode: config.mode
	} as UTSJSONObject)
}

/**
 * 获取用户列表（按部门）
 * @param params 查询参数
 */
export function getUserList(params?: UTSJSONObject): Promise<any> {
	return get('/system/user/list', params)
}
