/**
 * 会话管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 获取会话列表
 */
export function getConversationList(): Promise<any> {
  return request({
    url: '/system/im/conversation/list',
    method: 'GET'
  })
}

/**
 * 搜索会话（群聊/单聊）
 */
export function searchConversations(keyword: string, conversationType: number | null, pageNo: number = 1, pageSize: number = 20): Promise<any> {
  const kw = keyword != null ? String(keyword) : ''
  const typePart = conversationType != null ? `&conversationType=${conversationType}` : ''
  return request({
    url: `/system/im/conversation/search?keyword=${encodeURIComponent(kw)}${typePart}&pageNo=${pageNo}&pageSize=${pageSize}`,
    method: 'GET'
  })
}

/**
 * 创建会话
 */
export function createConversation(data: any): Promise<any> {
  return request({
    url: '/system/im/conversation/create',
    method: 'POST',
    data: data
  })
}

/**
 * 删除会话
 * @param chatId ChatID
 */
export function deleteConversation(chatId: string): Promise<any> {
  return request({
    url: `/system/im/conversation/delete?chatId=${chatId}`,
    method: 'DELETE'
  })
}

/**
 * 置顶会话
 * @param chatId ChatID（字符串，避免精度丢失）
 * @param pinned 是否置顶
 */
export function pinConversation(chatId: string, pinned: boolean): Promise<any> {
  return request({
    url: '/system/im/conversation/update',
    method: 'PUT',
    data: { 
      chatId: chatId,
      isPinned: pinned 
    }
  })
}

/**
 * 设置免打扰
 * @param chatId ChatID（字符串，避免精度丢失）
 * @param noDisturb 是否免打扰
 */
export function setNoDisturb(chatId: string, noDisturb: boolean): Promise<any> {
  return request({
    url: '/system/im/conversation/update',
    method: 'PUT',
    data: { 
      chatId: chatId,
      noDisturb: noDisturb 
    }
  })
}

/**
 * 标记会话已读（按 sequence 水位推进）
 * @param chatId ChatID
 * @param readSequence 已读 sequence 水位
 */
export function markReadBySequence(chatId: string, readSequence: string): Promise<any> {
  return request({
    url: `/system/im/conversation/mark-read-seq?chatId=${chatId}&readSequence=${readSequence}`,
    method: 'PUT'
  })
}

/**
 * 根据目标ID和类型获取会话
 * @param targetId 目标ID（群聊为群ID，单聊为对方用户ID）
 * @param conversationType 会话类型（1-单聊 2-群聊）
 */
export function getConversationByTarget(targetId: string, conversationType: number): Promise<any> {
  const target = targetId != null ? String(targetId) : ''
  return request({
    url: `/system/im/conversation/get-by-target?targetId=${encodeURIComponent(target)}&conversationType=${conversationType}`,
    method: 'GET'
  })
}
