/**
 * 会话管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 获取会话列表
 */
export function getConversationList(): Promise<any> {
  return request({
    url: '/system/im/conversation/list',
    method: 'GET'
  })
}

/**
 * 创建会话
 */
export function createConversation(data: any): Promise<any> {
  return request({
    url: '/system/im/conversation/create',
    method: 'POST',
    data: data
  })
}

/**
 * 删除会话
 */
export function deleteConversation(id: string): Promise<any> {
  return request({
    url: `/system/im/conversation/delete?id=${id}`,
    method: 'DELETE'
  })
}

/**
 * 置顶会话
 * @param id 会话ID（字符串，避免精度丢失）
 * @param pinned 是否置顶
 */
export function pinConversation(id: string, pinned: boolean): Promise<any> {
  return request({
    url: '/system/im/conversation/update',
    method: 'PUT',
    data: { 
      id: id,
      isPinned: pinned 
    }
  })
}

/**
 * 设置免打扰
 * @param id 会话ID（字符串，避免精度丢失）
 * @param noDisturb 是否免打扰
 */
export function setNoDisturb(id: string, noDisturb: boolean): Promise<any> {
  return request({
    url: '/system/im/conversation/update',
    method: 'PUT',
    data: { 
      id: id,
      noDisturb: noDisturb 
    }
  })
}

/**
 * 清空未读数
 */
export function clearUnreadCount(id: string): Promise<any> {
  return request({
    url: `/system/im/conversation/mark-read?id=${id}`,
    method: 'PUT'
  })
}

/**
 * 根据目标ID和类型获取会话
 * @param targetId 目标ID（群聊为群ID，单聊为对方用户ID）
 * @param conversationType 会话类型（1-单聊 2-群聊）
 */
export function getConversationByTarget(targetId: string, conversationType: number): Promise<any> {
  return request({
    url: `/system/im/conversation/get-by-target?targetId=${targetId}&conversationType=${conversationType}`,
    method: 'GET'
  })
}
