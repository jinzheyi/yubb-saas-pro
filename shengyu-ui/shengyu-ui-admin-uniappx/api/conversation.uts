/**
 * 会话管理 API
 */

import { request } from '../utils/request.uts'

/**
 * 获取会话列表
 */
export function getConversationList(): Promise<any> {
  return request({
    url: '/system/im/conversation/list',
    method: 'GET'
  })
}

/**
 * 创建会话
 */
export function createConversation(data: any): Promise<any> {
  return request({
    url: '/system/im/conversation/create',
    method: 'POST',
    data: data
  })
}

/**
 * 删除会话
 */
export function deleteConversation(id: number): Promise<any> {
  return request({
    url: `/system/im/conversation/delete?id=${id}`,
    method: 'DELETE'
  })
}

/**
 * 置顶会话
 */
export function pinConversation(id: number, pinned: boolean): Promise<any> {
  return request({
    url: `/system/im/conversation/pin?id=${id}`,
    method: 'PUT',
    data: { pinned: pinned }
  })
}

/**
 * 设置免打扰
 */
export function setNoDisturb(id: number, noDisturb: boolean): Promise<any> {
  return request({
    url: `/system/im/conversation/no-disturb?id=${id}`,
    method: 'PUT',
    data: { noDisturb: noDisturb }
  })
}

/**
 * 清空未读数
 */
export function clearUnreadCount(id: number): Promise<any> {
  return request({
    url: `/system/im/conversation/clear-unread?id=${id}`,
    method: 'PUT'
  })
}
