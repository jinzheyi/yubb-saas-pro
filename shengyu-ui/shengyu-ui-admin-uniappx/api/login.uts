/**
 * 登录相关 API
 */
import { post, postRaw, get } from '../utils/request.uts'
import { getDeviceInfo } from '../utils/device.uts'

/**
 * 账号密码登录
 * 自动添加设备信息（设备类型、设备ID、应用版本）
 */
export function login(data: UTSJSONObject): Promise<any> {
	// 添加设备信息
	const deviceInfo = getDeviceInfo()
	const loginData = {
		...data,
		deviceType: deviceInfo.deviceType,
		deviceId: deviceInfo.deviceId,
		clientVersion: deviceInfo.clientVersion
	}
	return post('/system/auth/login', loginData)
}

/**
 * 短信验证码登录
 * 自动添加设备信息（设备类型、设备ID、应用版本）
 */
export function smsLogin(data: UTSJSONObject): Promise<any> {
	// 添加设备信息
	const deviceInfo = getDeviceInfo()
	const loginData = {
		...data,
		deviceType: deviceInfo.deviceType,
		deviceId: deviceInfo.deviceId,
		clientVersion: deviceInfo.clientVersion
	}
	return post('/system/auth/sms-login', loginData)
}

/**
 * 发送短信验证码
 */
export function sendSmsCode(data: UTSJSONObject): Promise<any> {
	return post('/system/auth/send-sms-code', data)
}

/**
 * 获取用户权限信息
 * 包含用户信息、权限列表、角色列表、菜单列表
 */
export function getPermissionInfo(): Promise<any> {
	return get('/system/auth/get-permission-info')
}

/**
 * 登出
 */
export function logout(): Promise<any> {
	return post('/system/auth/logout')
}

/**
 * 刷新访问令牌
 */
export function refreshToken(refreshToken: string): Promise<any> {
	return post('/system/auth/refresh-token?refreshToken=' + refreshToken)
}

/**
 * 获取图形验证码（返回完整响应）
 */
export function getCaptcha(data: UTSJSONObject): Promise<any> {
	return postRaw('/system/captcha/get', data)
}

/**
 * 校验图形验证码（返回完整响应）
 */
export function checkCaptcha(data: UTSJSONObject): Promise<any> {
	return postRaw('/system/captcha/check', data)
}
