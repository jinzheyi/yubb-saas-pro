/**
 * 联系人管理 API
 */

import { request } from '../utils/request.uts'

export type PageResult<T> = {
	list: T[]
	total: number
}

/**
 * 获取联系人列表
 */
export function getContactList(): Promise<any> {
  return request({
    url: '/system/im/contact/list',
    method: 'GET'
  })
}

/**
 * 搜索联系人
 */
export function searchContact(keyword: string): Promise<any> {
  return request({
    url: `/system/im/contact/search?keyword=${keyword}`,
    method: 'GET'
  })
}

/**
 * 获取联系人详情
 */
export function getContact(contactId: string): Promise<any> {
  return request({
    url: `/system/im/contact/get?contactId=${contactId}`,
    method: 'GET'
  })
}

/**
 * 更新联系人设置
 */
export function updateContactSetting(data: any): Promise<any> {
  return request({
    url: '/system/im/contact/setting/update',
    method: 'PUT',
    data: data
  })
}

/**
 * 关注/取消关注联系人
 * @param contactId 联系人ID（字符串，避免精度丢失）
 * @param star 是否关注（true=关注，false=取消关注）
 */
export function toggleContactStar(contactId: string, star: boolean): Promise<any> {
  return request({
    url: '/system/im/contact/setting/update',
    method: 'PUT',
    data: {
      contactId: contactId,
      star: star
    }
  })
}

/**
 * 根据部门ID获取联系人列表
 */
export function getContactListByDept(deptId: string): Promise<any> {
  return request({
    url: `/system/im/contact/list-by-dept?deptId=${deptId}`,
    method: 'GET'
  })
}

/**
 * 根据部门ID分页获取联系人列表
 */
export function getContactPageByDept(deptId: string, pageNo: number = 1, pageSize: number = 20, keyword: string = ''): Promise<PageResult<any>> {
  const kw = keyword != null ? String(keyword) : ''
  const kwPart = kw !== '' ? `&keyword=${encodeURIComponent(kw)}` : ''
  return request({
    url: `/system/im/contact/list-by-dept-page?deptId=${deptId}&pageNo=${pageNo}&pageSize=${pageSize}${kwPart}`,
    method: 'GET'
  })
}

/**
 * 获取星标联系人列表
 */
export function getStarContactList(): Promise<any> {
  return request({
    url: '/system/im/contact/list-star',
    method: 'GET'
  })
}
