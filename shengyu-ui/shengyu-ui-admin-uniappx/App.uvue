<script lang="uts">
  // #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
  // #endif
	import { isLoggedIn, isTokenExpired, getExpiresTime, clearAuthInfo } from '@/utils/auth.uts'
	import { apiConfig } from '@/config/apiConfig.uts'
	
	// 用户最后活动时间
	let lastActivityTime = Date.now()
	// 登录超时检查定时器
	let timeoutCheckTimer: number | null = null
	// 超时时间（毫秒） - 30分钟
	const INACTIVITY_TIMEOUT = 30 * 60 * 1000
	
	export default {
		onLaunch: function () {
			console.log('App Launch')
			// 应用启动时检查登录状态
			this.checkLoginStatus()
			// 初始化用户活动监听
			this.initActivityListener()
			// 启动登录超时检查
			this.startTimeoutCheck()
		},
		onShow: function () {
			console.log('App Show')
			// 应用显示时更新最后活动时间
			this.updateLastActivityTime()
		},
		onHide: function () {
			console.log('App Hide')
		},
		// #ifdef APP-ANDROID || APP-HARMONY
		onLastPageBackPress: function () {
			console.log('App LastPageBackPress')
			if (firstBackTime == 0) {
				uni.showToast({
					title: '再按一次退出应用',
					position: 'bottom',
				})
				firstBackTime = Date.now()
				setTimeout(() => {
					firstBackTime = 0
				}, 2000)
			} else if (Date.now() - firstBackTime < 2000) {
				firstBackTime = Date.now()
				uni.exit()
			}
		},
		// #endif
		onExit: function () {
			console.log('App Exit')
			// 清除定时器
			this.clearTimeoutCheck()
		},
		methods: {
			/**
			 * 检查登录状态
			 */
			checkLoginStatus() {
				// 检查登录状态，这里只做日志记录，具体页面的登录检查由页面自己处理
				console.log('当前登录状态:', isLoggedIn() ? '已登录' : '未登录')
			},
			
			/**
			 * 初始化用户活动监听
			 */
			initActivityListener() {
				// 监听全局触摸事件
				uni.$on('userActivity', () => {
					this.updateLastActivityTime()
				})
				
				// 监听页面路由变化
				uni.$on('routeChange', () => {
					this.updateLastActivityTime()
				})
			},
			
			/**
			 * 更新最后活动时间
			 */
			updateLastActivityTime() {
				lastActivityTime = Date.now()
			},
			
			/**
			 * 启动登录超时检查
			 */
			startTimeoutCheck() {
				// 每分钟检查一次
				timeoutCheckTimer = setInterval(() => {
					this.checkLoginTimeout()
				}, 60 * 1000)
			},
			
			/**
			 * 清除登录超时检查
			 */
			clearTimeoutCheck() {
				if (timeoutCheckTimer) {
					clearInterval(timeoutCheckTimer)
					timeoutCheckTimer = null
				}
			},
			
			/**
			 * 检查登录超时
			 */
			checkLoginTimeout() {
				// 如果未登录，不检查
				if (!isLoggedIn()) {
					return
				}
				
				// 检查token是否已过期
				const isExpired = isTokenExpired()
				// 检查用户是否长时间未操作
				const isInactive = Date.now() - lastActivityTime > INACTIVITY_TIMEOUT
				
				if (isExpired || isInactive) {
					// 显示登录超时提示
					uni.showModal({
						title: '登录超时',
						content: apiConfig.timeoutMessage,
						showCancel: false,
						confirmText: '确定',
						success: () => {
							// 清除认证信息
							clearAuthInfo()
							// 跳转到登录页面
							uni.redirectTo({
								url: '/pages/login/login'
							})
						}
					})
					// 清除定时器
					this.clearTimeoutCheck()
				}
			}
		}
	}
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
	
	/* 全局样式重置 */
	page {
		background-color: #f5f5f5;
	}
</style>