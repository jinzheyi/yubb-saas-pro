import { parseGroupInvitePayload, openJoinGroupByPayload } from './group-invite.uts'
import { navToBlockedContent, navToSecureBrowser } from './secure-browser.uts'
import { t } from '../store/locale.uts'

export function routeScanResult(rawResult: any, redirect: boolean = false): boolean {
	const rawText = rawResult != null ? String(rawResult).trim() : ''
	if (rawText === '') {
		uni.showToast({
			title: t('runtime.scan.noValidContent'),
			icon: 'none'
		})
		return false
	}

	const invitePayload = parseGroupInvitePayload(rawText)
	if (invitePayload != null) {
		openJoinGroupByPayload(invitePayload, redirect)
		return true
	}

	if (/^https?:\/\//i.test(rawText) || /^www\./i.test(rawText)) {
		navToSecureBrowser(rawText, t('runtime.scan.resultTitle'), 'scan', redirect)
		return true
	}

	navToBlockedContent(rawText, t('runtime.scan.resultTitle'), 'scan', redirect)
	return true
}
