/**
 * 头像相关工具函数
 */

/**
 * 预定义的头像背景色列表
 */
const AVATAR_COLORS = ['#F197BC', '#5FB6F7', '#c084fc', '#10b981', '#f59e0b', '#ec4899', '#3b82f6', '#8b5cf6', '#22c55e', '#f43f5e', '#14b8a6', '#a855f7', '#0ea5e9', '#f97316', '#84cc16', '#06b6d4']

function modFromNumericString(value: string, mod: number): number {
	let result = 0
	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i)
		if (code < 48 || code > 57) {
			return hashToIndex(value)
		}
		result = (result * 10 + (code - 48)) % mod
	}
	return result
}

function hashToIndex(value: string): number {
	let hash = 0
	for (let i = 0; i < value.length; i++) {
		hash = (hash * 31 + value.charCodeAt(i)) | 0
	}
	const positive = hash < 0 ? -hash : hash
	return positive % AVATAR_COLORS.length
}

function hashToInt(value: string): number {
	let hash = 0
	for (let i = 0; i < value.length; i++) {
		hash = (hash * 31 + value.charCodeAt(i)) | 0
	}
	return hash
}

function toHex2(n: number): string {
	const v = n & 0xff
	const s = v.toString(16)
	return s.length === 1 ? ('0' + s) : s
}

function hashToPastelHex(value: string, salt: number): string {
	const h = (hashToInt(value) ^ salt) >>> 0
	let r = (h >> 16) & 0xff
	let g = (h >> 8) & 0xff
	let b = h & 0xff
	// pastelize: mix with white to ensure readable, pleasant colors
	r = Math.floor((r + 255) / 2)
	g = Math.floor((g + 255) / 2)
	b = Math.floor((b + 255) / 2)
	return '#' + toHex2(r) + toHex2(g) + toHex2(b)
}

/**
 * 根据用户ID获取固定的头像背景色
 * 同一个用户ID总是返回相同的颜色
 * 
 * @param userId 用户ID
 * @returns 头像背景色（十六进制颜色值）
 */

export function getUserAvatarColor(userId : number | string) : string {
	const userIdStr = typeof userId === 'number' ? userId.toString() : userId
	return hashToPastelHex(userIdStr, 0)
}

/**
 * 根据群组ID获取固定的头像背景色
 * 同一个群组ID总是返回相同的颜色
 * 为了避免与用户ID冲突，群组使用不同的偏移量
 * 
 * @param groupId 群组ID
 * @returns 头像背景色（十六进制颜色值）
 */

export function getGroupAvatarColor(groupId : number | string) : string {
	const groupIdStr = typeof groupId === 'number' ? groupId.toString() : groupId
	return hashToPastelHex(groupIdStr, 100000)
}

/**
 * 根据会话类型和目标ID获取固定的头像背景色
 * 适用于消息列表等需要区分单聊和群聊的场景
 * 
 * @param conversationType 会话类型 (1-单聊 2-群聊)
 * @param targetId 目标ID (单聊为用户ID，群聊为群组ID)
 * @returns 头像背景色（十六进制颜色值）
 */

export function getConversationAvatarColor(conversationType : number, targetId : number | string) : string {
	if (conversationType === 2) {
		return getGroupAvatarColor(targetId)
	}
	return getUserAvatarColor(targetId)
}

export function getBusinessAvatarColor(scene: string, id: number | string): string {
	const idStr = typeof id === 'number' ? id.toString() : id
	return hashToPastelHex(scene + ':' + idStr, 200000)
}

/**
 * 从姓名中提取头像文字
 * 中文姓名取前2个字符，英文姓名取首字母
 * 
 * @param name 姓名
 * @returns 头像文字
 */
export function getAvatarText(name : string) : string {
	if (!name || name.length === 0) {
		return '?'
	}
	
	// 中文姓名取前2个字符
	if (name.length <= 2) {
		return name
	}
	
	// 检查是否包含中文字符
	const hasChinese = /[\u4e00-\u9fa5]/.test(name)
	if (hasChinese) {
		return name.substring(0, 2)
	}
	
	// 英文姓名取首字母
	const words = name.split(' ')
	if (words.length >= 2) {
		return (words[0].substring(0, 1) + words[1].substring(0, 1)).toUpperCase()
	}
	
	return name.substring(0, 1).toUpperCase()
}
