import { decodeIdParam, encodeIdParam } from './id-param.uts'

export type GroupInvitePayload = {
  inviteCode: string
  groupId: string
  rawText: string
}

function safeDecode(value: string): string {
  try {
    return decodeURIComponent(value)
  } catch (e) {
    return value
  }
}

function readQueryValue(text: string, key: string): string {
  const pattern = new RegExp('(?:[?&#]|^)' + key + '=([^&#]+)')
  const match = pattern.exec(text)
  if (match != null && match.length > 1) {
    return safeDecode(match[1])
  }
  return ''
}

function normalizeInviteCode(text: string): string {
  const raw = text != null ? String(text).trim() : ''
  if (raw === '') {
    return ''
  }
  const match = /GRP[A-Z0-9]{10,}/i.exec(raw)
  if (match != null && match.length > 0) {
    return String(match[0]).toUpperCase()
  }
  const compact = raw.replace(/\s+/g, '')
  if (/^GRP[A-Z0-9]{10,}$/i.test(compact)) {
    return compact.toUpperCase()
  }
  return ''
}

export function parseGroupInvitePayload(raw: any): GroupInvitePayload | null {
  const rawText = raw != null ? String(raw).trim() : ''
  if (rawText === '') {
    return null
  }
  const decoded = safeDecode(rawText)
  const codeFromQuery = readQueryValue(decoded, 'code')
  const groupIdFromQuery = readQueryValue(decoded, 'groupId')
  const inviteCode = normalizeInviteCode(codeFromQuery !== '' ? codeFromQuery : decoded)
  if (inviteCode === '') {
    return null
  }
  return {
    inviteCode: inviteCode,
    groupId: groupIdFromQuery !== '' ? decodeIdParam(groupIdFromQuery) : '',
    rawText: rawText
  }
}

export function buildJoinGroupUrl(payload: GroupInvitePayload, manual: boolean = false): string {
  const query: string[] = []
  if (payload.inviteCode !== '') {
    query.push('code=' + encodeURIComponent(payload.inviteCode))
  }
  if (payload.groupId !== '') {
    query.push('groupId=' + encodeIdParam(payload.groupId))
  }
  if (manual) {
    query.push('manual=1')
  }
  return '/pages/message/join-group' + (query.length > 0 ? '?' + query.join('&') : '')
}

export function openJoinGroupByPayload(payload: GroupInvitePayload, redirect: boolean = false): void {
  const url = buildJoinGroupUrl(payload, false)
  if (redirect) {
    uni.redirectTo({ url })
    return
  }
  uni.navigateTo({ url })
}
