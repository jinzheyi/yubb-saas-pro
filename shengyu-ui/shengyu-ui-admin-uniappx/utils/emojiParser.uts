import { emojiMap } from './emojiData.uts'

/**
 * 消息内容 Token 类型
 */
export type MessageToken = {
	type : string; // 'text' | 'emoji'
	content : string;
	code?: string; // 原始代码
	visualWidth?: number; // 视觉宽度单位 (ASCII=1, CJK=2)
}

/**
 * 计算字符串的视觉宽度单位
 */
export function getVisualWidthUnits(text : string) : number {
	let units = 0
	for (let i = 0; i < text.length; i++) {
		const charCode = text.charCodeAt(i)
		// 简单判断：标准 ASCII 字符占 1 个单位，其他（如汉字）占 2 个单位
		if (charCode >= 0 && charCode <= 128) {
			units += 1
		} else {
			units += 2
		}
	}
	return units
}

/**
 * 将包含表情代码的字符串解析为 Token 数组
 */
export function parseMessageText(text : string | any) : MessageToken[] {
	const tokens : MessageToken[] = []
	// 如果不是字符串，先转换为字符串
	if (typeof text !== 'string') {
		if (text == null) return tokens
		// 如果是对象，尝试获取 content 字段，否则转为字符串
		if (typeof text === 'object') {
			text = text.content || text.toString()
		} else {
			text = String(text)
		}
	}
	// 空字符串检查
	if (!text || text.trim().length === 0) return tokens

	const regex = /\[[\u4e00-\u9fa5\w]+\]/g
	let lastIndex = 0
	let match : RegExpExecArray | null

	while ((match = regex.exec(text)) !== null) {
		if (match.index > lastIndex) {
			tokens.push({
				type: 'text',
				content: text.substring(lastIndex, match.index)
			} as MessageToken)
		}

		const emojiCode = match[0]
		const emojiPath = emojiMap.get(emojiCode)

		if (emojiPath != null) {
			tokens.push({
				type: 'emoji',
				content: emojiPath,
				code: emojiCode,
				visualWidth: getVisualWidthUnits(emojiCode)
			} as MessageToken)
		} else {
			tokens.push({
				type: 'text',
				content: emojiCode
			} as MessageToken)
		}

		lastIndex = regex.lastIndex
	}

	if (lastIndex < text.length) {
		tokens.push({
			type: 'text',
			content: text.substring(lastIndex)
		} as MessageToken)
	}

	return tokens
}
