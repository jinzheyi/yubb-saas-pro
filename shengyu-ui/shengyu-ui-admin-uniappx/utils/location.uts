import { t } from '../store/locale.uts'

export type LocationOpenParams = {
	latitude: number
	longitude: number
	name: string
	address: string
}

export function buildLocationClipboardPayload(name: string, address: string, latitude: number, longitude: number): string {
	const lines: string[] = []
	const safeName = name !== '' ? name : t('chat.label.locationDefault')
	const safeAddress = address !== '' ? address : t('chat.label.locationCoordinate')
	lines.push(safeName)
	lines.push(safeAddress)
	lines.push('lat: ' + latitude.toString())
	lines.push('lng: ' + longitude.toString())
	return lines.join('\n')
}

export function canOpenSystemLocation(): boolean {
	const anyUni: any = uni as any
	return anyUni != null && typeof anyUni.openLocation === 'function'
}

export function openLocationWithFallback(params: LocationOpenParams): boolean {
	if (isNaN(params.latitude) || isNaN(params.longitude)) {
		return false
	}
	if (canOpenSystemLocation()) {
		uni.openLocation({
			latitude: params.latitude,
			longitude: params.longitude,
			address: params.address,
			name: params.name
		})
		return true
	}
	uni.navigateTo({
		url: '/pages/common/location-view'
			+ '?latitude=' + encodeURIComponent(params.latitude.toString())
			+ '&longitude=' + encodeURIComponent(params.longitude.toString())
			+ '&name=' + encodeURIComponent(params.name)
			+ '&address=' + encodeURIComponent(params.address)
	})
	return true
}
