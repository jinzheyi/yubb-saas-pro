/**
 * WebSocket 连接管理类
 * 
 * 功能:
 * 1. WebSocket 连接建立和管理
 * 2. 断线自动重连（指数退避策略）
 * 3. 心跳保活机制
 * 4. 消息收发队列
 * 5. 连接状态管理
 * 
 * 使用示例:
 * ```typescript
 * import { WebSocketManager } from '@/utils/websocket.uts'
 * 
 * const wsManager = WebSocketManager.getInstance()
 * wsManager.connect()
 * wsManager.send(message)
 * ```
 */

import { getAccessToken, getRefreshToken, setToken, removeToken } from '../store/user.uts'
import { getCurrentDeviceType, getDeviceId, getAppVersion, getDeviceName } from './device.uts'
import { WS_URL, WS_HEARTBEAT_INTERVAL, WS_HEARTBEAT_TIMEOUT, WS_MAX_RECONNECT_COUNT } from '../config/app.config.uts'
import { badgeService } from '../services/badge-service.uts'
import { refreshToken as refreshTokenApi } from '../api/login.uts'
import { onAccessTokenRefreshed } from './request.uts'
import { generateMessageId as generateLongSafeMessageId } from './message-utils.uts'
import * as ImProto from './proto/im_message_pb.esm.js'

/**
 * WebSocket 连接状态枚举
 */
export enum WebSocketState {
  CONNECTING = 0,  // 连接中
  OPEN = 1,        // 已连接
  CLOSING = 2,     // 关闭中
  CLOSED = 3       // 已关闭
}

/**
 * 消息类型枚举（对应 Protobuf MessageType）
 */
export enum MessageType {
  UNKNOWN = 0,
  
  // 系统消息
  HEARTBEAT_REQ = 1,      // 心跳请求
  HEARTBEAT_RESP = 2,     // 心跳响应
  AUTH_REQ = 3,           // 认证请求
  AUTH_RESP = 4,          // 认证响应
  CLOSE = 5,              // 连接关闭

  // 协议控制（企业级扩展）：连接建立后的探测与回执
  PROBE = 6,              // 首帧探测（协商能力/codec/features）
  PROBE_RESP = 7,         // 探测响应
  ACK = 8,                // 协议级 ACK（轻量阶段：仅回执，不做重发）
  ACK_RESP = 9,           // ACK 响应（可选，便于联调与打点）
  
  // 业务消息
  TEXT = 100,             // 文本消息
  IMAGE = 101,            // 图片消息
  VOICE = 102,            // 语音消息
  VIDEO = 103,            // 视频消息
  FILE = 104,             // 文件消息
  LOCATION = 105,         // 位置消息
  CUSTOM = 106,           // 自定义消息
  
  // 通知消息
  SYSTEM_NOTIFY = 200,    // 系统通知
  READ_RECEIPT = 201,     // 消息已读回执
  RECALL = 202,           // 消息撤回
  TYPING = 203,           // 正在输入
  BADGE_UPDATE = 204,     // 角标更新
  QUOTE_REPLY = 205,      // 引用回复
  CALL_SIGNAL = 206,      // 通话信令
  WORKFLOW_NOTIFY = 207,  // 流程通知
  TODO_REMINDER = 208     // 待办提醒
}

/**
 * 消息监听器类型
 */
export type MessageListener = (message: any) => void

/**
 * 连接状态监听器类型
 */
export type StateListener = (state: WebSocketState) => void

/**
 * WebSocket 管理器（单例模式）
 */
export class WebSocketManager {
  
  private static instance: WebSocketManager | null = null
  
  // WebSocket 实例
  private ws: SocketTask | null = null
  
  // 连接状态
  private state: WebSocketState = WebSocketState.CLOSED
  
  // 重连相关
  private reconnectCount: number = 0
  private maxReconnectCount: number = WS_MAX_RECONNECT_COUNT
  private reconnectTimer: number = 0
  
  // 心跳相关
  private heartbeatTimer: number = 0
  private heartbeatInterval: number = WS_HEARTBEAT_INTERVAL
  private heartbeatTimeout: number = WS_HEARTBEAT_TIMEOUT
  private heartbeatTimeoutTimer: number = 0

  // 会话是否已被服务端宣告失效（如被踢下线/注销/需要重新登录）
  private sessionInvalidated: boolean = false

  // 防止重复 connect（多处 onShow/login/app 同时触发）
  private connectInFlight: boolean = false
  
  // 消息队列（连接建立前的消息缓存）
  private messageQueue: any[] = []
  
  // 消息监听器
  private messageListeners: Map<MessageType, MessageListener[]> = new Map()
  
  // 连接状态监听器
  private stateListeners: StateListener[] = []
  
  // 是否已认证
  private authenticated: boolean = false

  // 是否允许自动重连（被踢下线/需要重登时应停止重连）
  private allowReconnect: boolean = true

  // 是否正在执行无感续期
  private renewing: boolean = false

  // 续期/重认证去重合并
  private reauthPending: boolean = false
  private lastReauthAt: number = 0

  private authFail401Count: number = 0
  private authFail401WindowStartAt: number = 0

  private appForeground: boolean = true

  private strictPresenceMode: boolean = false

  private realtimeBizActive: boolean = false

  private lastResumeSyncAt: number = 0
  
  // WebSocket 服务器地址
  private wsUrl: string = ''

  // 企业级默认：PB 优先，JSON 兜底（pb 不可用时会自动熔断并回落到 json）
  private wsProtocols: string[] = ['im.pb.v1', 'im.json.v1']

  // PB 熔断截止时间（ms）：在该时间前不再尝试 pb，直接走 json
  private pbDisabledUntil: number = 0

  // PB 认证 SLA 定时器（pb onOpen 后在 SLA 内必须完成认证，否则降级）
  private pbAuthSlaTimer: number = 0

  // PB 认证 SLA：默认 5s（可按 probeTimeoutMs+buffer 调整，但端侧先保守固定）
  private pbAuthSlaMs: number = 5000
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 从配置获取 WebSocket 地址
    this.wsUrl = WS_URL

	// 方案 C：HTTP 刷新 token 后，在同一条 WS 连接上重新 AUTH_REQ（不断链续期）
	onAccessTokenRefreshed((_tokenData) => {
		this.requestReauth('http_refresh')
	})
  }

  private nowMs(): number {
    return Date.now()
  }

  private isPbCircuitOpen(): boolean {
    try {
      const now = this.nowMs()
      return this.pbDisabledUntil > 0 && now < this.pbDisabledUntil
    } catch (e) {
      return false
    }
  }

  private openPbCircuit(ttlMs: number, reason: string): void {
    try {
      const now = this.nowMs()
      const ttl = ttlMs > 0 ? ttlMs : 10 * 60 * 1000
      this.pbDisabledUntil = now + ttl
      console.warn('[WebSocket] PB circuit opened:', { until: this.pbDisabledUntil, ttlMs: ttl, reason: reason })
    } catch (e) {
    }
  }

  private closePbCircuitIfExpired(): void {
    try {
      if (this.pbDisabledUntil > 0 && this.nowMs() >= this.pbDisabledUntil) {
        this.pbDisabledUntil = 0
      }
    } catch (e) {
    }
  }

  private ensureProtocolsByPreference(): void {
    try {
      this.closePbCircuitIfExpired()
      if (this.isPbCircuitOpen()) {
        this.wsProtocols = ['im.json.v1']
        return
      }
      this.wsProtocols = ['im.pb.v1', 'im.json.v1']
    } catch (e) {
    }
  }

  private clearPbAuthSlaTimer(): void {
    try {
      if (this.pbAuthSlaTimer !== 0) {
        clearTimeout(this.pbAuthSlaTimer)
        this.pbAuthSlaTimer = 0
      }
    } catch (e) {
    }
  }

  private startPbAuthSlaTimer(source: string): void {
    try {
      this.clearPbAuthSlaTimer()
      const sla = this.pbAuthSlaMs > 0 ? this.pbAuthSlaMs : 5000
      this.pbAuthSlaTimer = setTimeout(() => {
        try {
          if (this.state !== WebSocketState.OPEN) return
          if (this.authenticated) return
          if (!this.allowReconnect || this.sessionInvalidated) return
          if (!this.isPbEnabled()) return
          console.warn('[WebSocket] PB auth SLA timeout, downgrade to json:', { source: source, slaMs: sla })
          this.downgradePbToJsonAndReconnect('PB_AUTH_SLA_TIMEOUT')
        } catch (e) {
        }
      }, sla)
    } catch (e) {
    }
  }

  private downgradePbToJsonAndReconnect(reason: string): void {
    try {
      if (!this.isPbEnabled()) return
      this.openPbCircuit(10 * 60 * 1000, reason)
      this.wsProtocols = ['im.json.v1']
      try { this.close() } catch (e) {}
      try { this.connect() } catch (e) {}
    } catch (e) {
    }
  }

  private tryParseCloseBodyFromHeaderExtra(message: any): any | null {
    try {
      if (message == null || message.header == null) return null
      const extra: any = (message.header as any).extra
      if (extra == null || extra === '') return null
      if (typeof extra !== 'string') return null
      const obj = JSON.parse(extra)
      return (obj != null && typeof obj === 'object') ? obj : null
    } catch (e) {
      return null
    }
  }

  private triggerResumeConversationSync(): void {
	try {
		const now = Date.now()
		if (now - this.lastResumeSyncAt < 1200) {
			return
		}
		this.lastResumeSyncAt = now
		void import('@/services/conversation-service.uts').then((m) => {
			try {
				void m.conversationService.syncConversationsIncrementally(false)
			} catch (e) {
				console.error('[WebSocket] resume conversation sync failed:', e)
			}
		}).catch((e) => {
			console.error('[WebSocket] load conversationService failed:', e)
		})
	} catch (e) {
		console.error('[WebSocket] triggerResumeConversationSync failed:', e)
	}
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): WebSocketManager {
    if (WebSocketManager.instance === null) {
      WebSocketManager.instance = new WebSocketManager()
    }
    return WebSocketManager.instance
  }
  
  /**
   * 设置 WebSocket 服务器地址
   */
  public setUrl(url: string): void {
    this.wsUrl = url
  }

  public setProtocols(protocols: string[]): void {
    try {
      if (protocols != null && Array.isArray(protocols) && protocols.length > 0) {
        this.wsProtocols = protocols
      }
    } catch (e) {
      // ignore
    }
  }

  private maybeSendAckForInboundMessage(messageType: MessageType, message: any): void {
    try {
      if (!this.authenticated) {
        return
      }
      if (messageType === MessageType.ACK || messageType === MessageType.ACK_RESP || messageType === MessageType.PROBE || messageType === MessageType.PROBE_RESP) {
        return
      }
      if (messageType === MessageType.AUTH_RESP || messageType === MessageType.HEARTBEAT_RESP || messageType === MessageType.CLOSE) {
        return
      }
      const header: any = message && message.header ? message.header : {}

      const messageIdStr = header && header.messageId != null ? String(header.messageId) : ''
      const chatIdStr = header && header.chatId != null ? String(header.chatId) : ''
      const sequenceStr = header && header.sequence != null ? String(header.sequence) : ''
      const tenantIdStr = header && header.tenantId != null ? String(header.tenantId) : ''
      const originalTimestampStr = header && header.timestamp != null ? String(header.timestamp) : ''
      const clientReceivedAt = Date.now()

      if (this.isPbEnabled()) {
        try {
          const root: any = (ImProto as any)
          if (root != null && root.AckMessage != null) {
            const ackBody = root.AckMessage.create({
              messageId: messageIdStr,
              chatId: chatIdStr,
              sequence: sequenceStr,
              ackType: 'RECEIVED',
              clientReceivedAt: clientReceivedAt.toString(),
              originalTimestamp: originalTimestampStr
            })
            const bodyBytes = root.AckMessage.encode(ackBody).finish() as Uint8Array
            const ackHeader: any = {
              messageId: generateLongSafeMessageId(),
              messageType: MessageType.ACK,
              senderId: '0',
              receiverId: '0',
              groupId: '0',
              tenantId: tenantIdStr != '' ? tenantIdStr : '0',
              timestamp: Date.now().toString(),
              sequence: '0',
              extra: ''
            }
            this.sendPbImMessage(ackHeader, bodyBytes)
            return
          }
        } catch (e) {
        }
      }

      const ack = {
        header: {
          messageId: generateLongSafeMessageId(),
          messageType: MessageType.ACK,
          timestamp: Date.now()
        },
        body: {
          // 关键：ID/sequence 全程 string，禁止 number 化（避免精度丢失影响去重/重发/观测）
          messageId: messageIdStr,
          chatId: chatIdStr,
          sequence: sequenceStr,
          tenantId: tenantIdStr,
          ackType: 'RECEIVED',
          // 观测字段：用于统计端到端投递延迟（phase1 仅日志/指标，不做重发）
          clientReceivedAt: clientReceivedAt,
          originalTimestamp: originalTimestampStr
        }
      }
      this.sendRaw(JSON.stringify(ack))
    } catch (e) {
      // ignore
    }
  }

  public setAppForeground(isForeground: boolean): void {
    this.appForeground = isForeground
  }

  public setStrictPresenceMode(strict: boolean): void {
    this.strictPresenceMode = strict
  }

  public setRealtimeBizActive(active: boolean): void {
    this.realtimeBizActive = active
  }
  
  /**
   * 连接 WebSocket
   */
  public connect(): void {
    if (this.connectInFlight) {
      return
    }

    // 已在连接中/已连接：避免重复发起连接导致服务端“自踢”
    if (this.state === WebSocketState.CONNECTING || this.state === WebSocketState.OPEN) {
      if (this.ws !== null) {
        if (this.state === WebSocketState.OPEN && !this.authenticated) {
          try {
            console.log('[WebSocket] connect() detected OPEN but unauthenticated, resend AUTH_REQ')
          } catch (e) {
          }
          try {
            if (this.isPbEnabled()) {
              this.sendAuthRequestPb()
            } else {
              this.sendAuthRequest()
            }
          } catch (e) {
            // ignore
          }
        }
        return
      }
    }

    // 检查 Token 是否存在
    const token = getAccessToken()
    if (token == null || token == '') {
      console.log('[WebSocket] Token 不存在，跳过连接')
      return
    }

    this.connectInFlight = true

    // 建链前按熔断状态调整协议优先级（pb 熔断时直接走 json）
    this.ensureProtocolsByPreference()

    // 新一轮连接，恢复默认允许重连（除非后续被 CLOSE/KICKED 设置为 false）
    this.allowReconnect = true
    this.sessionInvalidated = false

    console.log('[WebSocket] connect() token length:', token.length)
    
    console.log('[WebSocket] 开始连接:', this.wsUrl)
    this.setState(WebSocketState.CONNECTING)
    
    try {
      const socketTask = uni.connectSocket({
        url: this.wsUrl,
        protocols: this.wsProtocols,
        success: () => {
          console.log('[WebSocket] 连接请求已发送')
        },
        fail: (err) => {
          console.error('[WebSocket] 连接失败:', err)
          this.connectInFlight = false
          this.setState(WebSocketState.CLOSED)
        }
      })
      this.ws = socketTask
      
      // 监听连接打开
      socketTask.onOpen(() => {
        this.handleOpen(socketTask)
      })
      
      // 监听消息接收
      socketTask.onMessage((res) => {
        this.handleMessage(res, socketTask)
      })
      
      // 监听连接关闭
      socketTask.onClose(() => {
        this.handleClose(socketTask)
      })
      
      // 监听连接错误
      socketTask.onError((err) => {
        this.handleError(err, socketTask)
      })
      
    } catch (e) {
      console.error('[WebSocket] 连接异常:', e)
      this.connectInFlight = false
      this.setState(WebSocketState.CLOSED)
    }
  }
  
  /**
   * 处理连接打开
   */
  private handleOpen(source?: SocketTask): void {
    if (source != null && this.ws != null && source !== this.ws) {
      return
    }
    console.log('[WebSocket] 连接已建立')
    this.connectInFlight = false
    this.setState(WebSocketState.OPEN)
    this.reconnectCount = 0

    // 企业级：pb 子协议下优先走二进制 AUTH_REQ（服务端会按 subprotocol 绑定 codec=pb）
    if (this.isPbEnabled()) {
      this.startPbAuthSlaTimer('pb_open')
      this.sendAuthRequestPb()
      return
    }

    // JSON 栈：先发送 PROBE（探测/协商），再发送认证请求
    this.sendProbe()
    this.sendAuthRequest()
  }

  private sendProbe(): void {
    try {
      const protocolCodec = (this.wsProtocols != null
        && Array.isArray(this.wsProtocols)
        && this.wsProtocols.indexOf('im.pb.v1') >= 0) ? 'pb' : 'json'
      const probeMessage = {
        header: {
          messageId: generateLongSafeMessageId(),
          messageType: MessageType.PROBE,
          timestamp: Date.now()
        },
        body: {
          version: 1,
          codec: protocolCodec,
          features: {
            ack: true
          },
          client: {
            deviceType: getCurrentDeviceType(),
            deviceId: getDeviceId(),
            deviceName: getDeviceName(),
            clientVersion: getAppVersion()
          }
        }
      }
      this.sendRaw(JSON.stringify(probeMessage))
    } catch (e) {
      // ignore
    }
  }
  
  /**
   * 发送认证请求
   */
  private sendAuthRequest(): void {
    const accessToken = getAccessToken()
    if (accessToken === null || accessToken === '') {
      console.error('[WebSocket] Token 为空，无法认证')
      this.close()
      return
    }
    
    const authMessage = {
      header: {
        messageId: generateLongSafeMessageId(),
        messageType: MessageType.AUTH_REQ,
        timestamp: Date.now()
      },
      body: {
        accessToken: accessToken,
        deviceType: getCurrentDeviceType(),
        deviceId: getDeviceId(),
        deviceName: getDeviceName(),
        clientVersion: getAppVersion()
      }
    }
    
    console.log('[WebSocket] 发送认证请求')
    this.sendRaw(JSON.stringify(authMessage))
  }

  private sendAuthRequestPb(): void {
    const accessToken = getAccessToken()
    if (accessToken === null || accessToken === '') {
      console.error('[WebSocket] Token 为空，无法认证')
      this.close()
      return
    }

    try {
      // 严格模式：先 PROBE（TextFrame），再 AUTH_REQ（BinaryFrame）
      this.sendProbe()

      const root: any = (ImProto as any)
      const bodyBytes: Uint8Array = root.AuthRequest.encode({
        accessToken: accessToken,
        deviceType: getCurrentDeviceType(),
        deviceId: getDeviceId(),
        clientVersion: getAppVersion()
      }).finish() as Uint8Array

      const header: any = {
        messageId: generateLongSafeMessageId(),
        messageType: MessageType.AUTH_REQ,
        senderId: '0',
        receiverId: '0',
        groupId: '0',
        tenantId: '0',
        timestamp: Date.now().toString(),
        sequence: '0',
        extra: ''
      }

      console.log('[WebSocket] 发送认证请求(pb)')
      this.sendPbImMessage(header, bodyBytes)
    } catch (e) {
      console.error('[WebSocket] 发送认证请求(pb)失败:', e)
      this.close()
    }
  }

  /**
   * 处理消息接收
   */
  private handleMessage(res: any, source?: SocketTask): void {
    if (source != null && this.ws != null && source !== this.ws) {
      return
    }
    try {
      // B4：二进制帧（pb stack）：BinaryFrame = varint32 length-prefix + ImMessage bytes
      try {
        if (res != null && (res as any).data != null && typeof (res as any).data !== 'string') {
          const u8 = this.toUint8Array((res as any).data)
          if (u8 === null) {
            console.log('[WebSocket] 收到二进制消息(无法转 Uint8Array)')
            return
          }
          this.handleBinaryPayload(u8)
          return
        }
      } catch (e) {
        console.error('[WebSocket] binary message handling failed:', e)
        return
      }

      const message = JSON.parse(res.data as string)
      this.normalizeInboundJsonMessage(message)
      const messageType = message.header.messageType as MessageType
      
      console.log('[WebSocket] 收到消息:', messageType)

  // 打印业务消息概要，便于定位服务端是否返回错误/ACK
  if (messageType !== MessageType.AUTH_RESP
      && messageType !== MessageType.HEARTBEAT_RESP
      && messageType !== MessageType.CLOSE) {
    try {
      const header = message.header || {}
      const body = message.body || {}
      console.log('[WebSocket] 收到业务消息概要:', {
        messageType: header.messageType,
        messageId: header.messageId,
        chatId: header.chatId,
        senderId: header.senderId,
        receiverId: header.receiverId,
        groupId: header.groupId,
        tenantId: header.tenantId,
        sequence: header.sequence,
        bodyKeys: body && typeof body === 'object' ? Object.keys(body) : typeof body
      })
    } catch (e) {
      console.log('[WebSocket] 收到业务消息概要解析失败:', e)
    }
  }
      
      this.handleDecodedMessage(messageType, message)
      
    } catch (e) {
      console.error('[WebSocket] 消息解析失败:', e)
    }
  }

  private handleDecodedMessage(messageType: MessageType, message: any): void {
    if (messageType === MessageType.AUTH_RESP) {
      this.handleAuthResponse(message)
      return
    }
    if (messageType === MessageType.HEARTBEAT_RESP) {
      this.handleHeartbeatResponse()
      return
    }
    if (messageType === MessageType.SYSTEM_NOTIFY) {
      this.maybeSendAckForInboundMessage(messageType, message)
      void this.handleSystemNotify(message)
      return
    }
    if (messageType === MessageType.CLOSE) {
      this.handleCloseMessage(message)
      return
    }
    if (messageType === MessageType.PROBE_RESP) {
      try {
        console.log('[WebSocket] 收到 PROBE_RESP:', message.body)
      } catch (e) {
      }
      return
    }

    this.maybeSendAckForInboundMessage(messageType, message)
    this.dispatchMessage(messageType, message)
  }

  private toUint8Array(dataAny: any): Uint8Array | null {
    try {
      if (dataAny == null) {
        return null
      }
      try {
        if (dataAny instanceof ArrayBuffer) {
          return new Uint8Array(dataAny as ArrayBuffer)
        }
      } catch (e) {
      }
      try {
        if ((dataAny as any).buffer != null && (dataAny as any).byteLength != null) {
          const offset = (dataAny as any).byteOffset != null ? Number((dataAny as any).byteOffset) : 0
          const len = Number((dataAny as any).byteLength)
          return new Uint8Array((dataAny as any).buffer as ArrayBuffer, offset, len)
        }
      } catch (e) {
      }
      return null
    } catch (e) {
      return null
    }
  }

  private normalizeInboundJsonMessage(message: any): void {
    try {
      if (message == null) {
        return
      }
      const header: any = (message as any).header
      if (header != null) {
        if (header.messageId != null) header.messageId = header.messageId.toString()
        if (header.chatId != null) header.chatId = header.chatId.toString()
        if (header.senderId != null) header.senderId = header.senderId.toString()
        if (header.receiverId != null) header.receiverId = header.receiverId.toString()
        if (header.groupId != null) header.groupId = header.groupId.toString()
        if (header.tenantId != null) header.tenantId = header.tenantId.toString()
        if (header.sequence != null) header.sequence = header.sequence.toString()
      }
      const body: any = (message as any).body
      if (body != null) {
        if (body.messageId != null) body.messageId = body.messageId.toString()
        if (Array.isArray(body.messageIds)) {
          body.messageIds = (body.messageIds as any[]).map((x: any) => x != null ? x.toString() : '')
        }
      }
    } catch (e) {
    }
  }

  private readVarint32(buf: Uint8Array, offset: number): { value: number; bytes: number } | null {
    let result = 0
    let shift = 0
    let pos = offset
    while (pos < buf.length && shift < 35) {
      const b = buf[pos]
      result |= (b & 0x7f) << shift
      pos++
      if ((b & 0x80) === 0) {
        return { value: (result >>> 0), bytes: pos - offset }
      }
      shift += 7
    }
    return null
  }

  private handleBinaryPayload(u8: Uint8Array): void {
    let pos = 0
    const total = u8.byteLength
    console.log('[WebSocket] 收到二进制消息:', { byteLength: total })

    while (pos < total) {
      const lenInfo = this.readVarint32(u8, pos)
      if (lenInfo === null) {
        console.error('[WebSocket] binary decode failed: invalid length prefix')
        return
      }
      pos += lenInfo.bytes
      const frameLen = lenInfo.value
      if (frameLen <= 0 || pos + frameLen > total) {
        console.error('[WebSocket] binary decode failed: length out of range', { frameLen, pos, total })
        return
      }

      const msgBytes = u8.subarray(pos, pos + frameLen)
      pos += frameLen

      try {
        const root: any = (ImProto as any)
        const im = root.ImMessage.decode(msgBytes)
        const imObj = root.ImMessage.toObject(im, { longs: String, enums: Number, bytes: Uint8Array })
        const converted = this.convertPbImMessageToJson(imObj)
        if (converted != null) {
          const mt = converted.header.messageType as MessageType
          try {
            console.log('[WebSocket] 二进制帧解码成功:', {
              frameLen: frameLen,
              messageType: mt,
              messageId: converted.header && converted.header.messageId ? converted.header.messageId : '',
              tenantId: converted.header && converted.header.tenantId ? converted.header.tenantId : ''
            })
            if (mt === MessageType.AUTH_RESP) {
              console.log('[WebSocket] 收到 AUTH_RESP(pb):', converted.body)
            }
          } catch (e) {
          }
          this.handleDecodedMessage(mt, converted)
        }
      } catch (e) {
        console.error('[WebSocket] ImMessage.decode failed:', e)
      }
    }
  }

  private convertPbImMessageToJson(imObj: any): any | null {
    try {
      if (imObj == null || (imObj as any).header == null) {
        return null
      }

      const h: any = (imObj as any).header
      const messageTypeNum = Number(h.messageType)

      const jsonHeader: any = {
        messageId: h.messageId != null ? String(h.messageId) : generateLongSafeMessageId(),
        messageType: messageTypeNum,
        senderId: h.senderId != null ? String(h.senderId) : '0',
        receiverId: h.receiverId != null ? String(h.receiverId) : '0',
        groupId: h.groupId != null ? String(h.groupId) : '0',
        tenantId: h.tenantId != null ? String(h.tenantId) : '0',
        timestamp: h.timestamp != null ? String(h.timestamp) : String(Date.now()),
        sequence: h.sequence != null ? String(h.sequence) : '0',
        extra: h.extra != null ? String(h.extra) : ''
      }

      const bodyBytes: Uint8Array = (imObj as any).body != null ? ((imObj as any).body as Uint8Array) : new Uint8Array(0)
      const bodyObj = this.decodePbBody(messageTypeNum, bodyBytes)

      return {
        header: jsonHeader,
        body: bodyObj
      }
    } catch (e) {
      console.error('[WebSocket] convertPbImMessageToJson failed:', e)
      return null
    }
  }

  private decodePbBody(messageTypeNum: number, bodyBytes: Uint8Array): any {
    const mt = messageTypeNum as MessageType
    try {
      const root: any = (ImProto as any)
      if (mt === MessageType.AUTH_RESP) {
        const o: any = root.AuthResponse.toObject(root.AuthResponse.decode(bodyBytes), { longs: String, enums: Number, bytes: Uint8Array })
        try {
          if (o != null) {
            if (o.userId != null) o.userId = String(o.userId)
            if (o.tenantId != null) o.tenantId = String(o.tenantId)
          }
        } catch (e) {
        }
        return o
      }
      if (mt === MessageType.AUTH_REQ) {
        return root.AuthRequest.toObject(root.AuthRequest.decode(bodyBytes), { longs: String, enums: Number, bytes: Uint8Array })
      }
      if (mt === MessageType.TEXT || mt === MessageType.CUSTOM) {
        const o: any = root.TextMessage.toObject(root.TextMessage.decode(bodyBytes), { longs: String, enums: Number, bytes: Uint8Array })
        try {
          if (o != null && o.atUserIds != null && o.atUserIds instanceof Array) {
            const out: string[] = []
            for (let i = 0; i < o.atUserIds.length; i++) {
              out.push(String(o.atUserIds[i]))
            }
            o.atUserIds = out
          }
        } catch (e) {
        }
        return o
      }
      if (mt === MessageType.QUOTE_REPLY) {
        const o: any = root.QuoteReplyMessage.toObject(root.QuoteReplyMessage.decode(bodyBytes), { longs: String, enums: Number, bytes: Uint8Array })
        try {
          if (o != null) {
            if (o.quoteMessageId != null) {
              o.quoteMessageId = String(o.quoteMessageId)
            }
            if (o.quoteSenderId != null) {
              o.quoteSenderId = String(o.quoteSenderId)
            }
            if (o.atUserIds != null && o.atUserIds instanceof Array) {
              const out: string[] = []
              for (let i = 0; i < o.atUserIds.length; i++) {
                out.push(String(o.atUserIds[i]))
              }
              o.atUserIds = out
            }
          }
        } catch (e) {
        }
        return o
      }
      if (mt === MessageType.VOICE) {
        const o: any = root.VoiceMessage.toObject(root.VoiceMessage.decode(bodyBytes), { longs: String, enums: Number, bytes: Uint8Array })
        try {
          if (o != null) {
            o.duration = o.duration != null ? Number(o.duration) : 0
            o.size = o.size != null ? Number(o.size) : 0
          }
        } catch (e) {
        }
        return o
      }

      return {
        rawBytes: bodyBytes
      }
    } catch (e) {
      return {
        rawBytes: bodyBytes
      }
    }
  }

  public sendBinary(data: ArrayBuffer): void {
    if (this.ws === null) {
      console.error('[WebSocket] WebSocket 实例为空')
      return
    }
    if (this.state !== WebSocketState.OPEN) {
      console.log('[WebSocket] 连接未打开，跳过 sendBinary')
      return
    }
    try {
      const len = data != null ? (data as any).byteLength : 0
      console.log('[WebSocket] sendBinary:', { byteLength: len })
    } catch (e) {
    }
    try {
      this.ws.send({
        data: data as any,
        success: () => {
          console.log('[WebSocket] 二进制消息发送成功')
        },
        fail: (err) => {
          console.error('[WebSocket] 二进制消息发送失败:', err)
        }
      })
    } catch (e) {
      console.error('[WebSocket] sendBinary 异常:', e)
    }
  }
  
  /**
   * 处理认证响应
   */
  private handleAuthResponse(message: any): void {
    const success = message.body.success as boolean

    if (success) {
      // pb 模式：认证成功即停止 SLA 计时（避免误触发降级）
      this.clearPbAuthSlaTimer()

      // pb 成功后解除熔断，允许后续继续尝试 pb 优先
      try {
        if (this.isPbEnabled()) {
          this.pbDisabledUntil = 0
        }
      } catch (e) {
      }

      if (this.sessionInvalidated || !this.allowReconnect) {
        console.warn('[WebSocket] ignore AUTH_SUCCESS because sessionInvalidated/allowReconnect=false')
        return
      }

      const token = getAccessToken()
      if (token == null || token == '') {
        console.warn('[WebSocket] ignore AUTH_SUCCESS because accessToken missing')
        return
      }

      console.log('[WebSocket] 认证成功')
      this.authenticated = true

      try {
        console.log('[WebSocket] AUTH 标记完成:', { state: this.state, authenticated: this.authenticated })
      } catch (e) {
      }

	  // P1：重连/认证成功后首包补偿 sync，避免断线期间无 WS 也不触发 gap 检测
	  this.triggerResumeConversationSync()

      this.authFail401Count = 0
      this.authFail401WindowStartAt = 0
      
      // 启动心跳
      this.startHeartbeat()
      
      // 发送队列中的消息
      this.flushMessageQueue()
      
      // 同步角标数据（仅在会话仍有效时执行）
      if (!this.sessionInvalidated) {
        this.syncBadgeData()
      }
      
    } else {
      const body: any = message && message.body ? message.body : {}
      const code = body && typeof body === 'object' ? (body.code as number) : 0
      const reason = body && typeof body === 'object' ? (body.message as string) : ''

      console.error('[WebSocket] 认证失败:', body)
      console.error('[WebSocket] 认证失败后状态:', { state: this.state, authenticated: this.authenticated, code: code })

      if (code === 401) {
        const now = Date.now()
        if (this.authFail401WindowStartAt === 0 || (now - this.authFail401WindowStartAt) > 30_000) {
          this.authFail401WindowStartAt = now
          this.authFail401Count = 0
        }
        this.authFail401Count++

        if (this.authFail401Count <= 2) {
          void this.renewAuthSilently()
          return
        }

        this.allowReconnect = false
        removeToken()
        uni.showModal({
          title: '登录已过期',
          content: reason || '登录已过期，请重新登录',
          showCancel: false,
          success: () => {
            uni.reLaunch({ url: '/pages/login/login' })
          }
        })
        this.close()
        return
      }

      if (code === 400 || code === 403) {
        this.allowReconnect = false
        removeToken()
        uni.showModal({
          title: '认证失败',
          content: reason || '认证失败，请重新登录',
          showCancel: false,
          success: () => {
            uni.reLaunch({ url: '/pages/login/login' })
          }
        })
        this.close()
        return
      }

      if (code >= 500) {
        uni.showToast({
          title: reason || '认证失败，正在重试',
          icon: 'none'
        })
        this.close()
        return
      }

      this.close()
    }
  }
  
  /**
   * 处理心跳响应
   */
  private handleHeartbeatResponse(): void {
    console.log('[WebSocket] 收到心跳响应')
    
    // 清除心跳超时定时器
    if (this.heartbeatTimeoutTimer !== 0) {
      clearTimeout(this.heartbeatTimeoutTimer)
      this.heartbeatTimeoutTimer = 0
    }
  }
  
  /**
   * 处理被踢下线
   */
  private handleCloseMessage(message: any): void {
    const body: any = message && message.body ? message.body : {}
    let action = body && typeof body === 'object' ? (body.action as string) : ''
    let code = body && typeof body === 'object' ? (body.code as number) : 0
    let reason = body && typeof body === 'object' ? (body.message as string) : (body as string)
    const kickedAt = body && typeof body === 'object' ? (body.kickedAt as number) : 0
    const byDevice = body && typeof body === 'object' ? (body.byDevice as string) : ''

    // PB CLOSE：服务端把 action/code/message 写在 header.extra(JSON string)
    // 这里做兼容读取，避免 pb 模式下丢失关闭原因导致无法降级
    if ((action == null || action === '') && (code == null || code === 0)) {
      try {
        const extraBody = this.tryParseCloseBodyFromHeaderExtra(message)
        if (extraBody != null) {
          if (action == null || action === '') action = extraBody.action != null ? String(extraBody.action) : ''
          if (code == null || code === 0) {
            try {
              code = extraBody.code != null ? Number(extraBody.code) : 0
            } catch (e) {
              code = 0
            }
          }
          if (reason == null || reason === '') reason = extraBody.message != null ? String(extraBody.message) : ''
        }
      } catch (e) {
      }
    }

    console.log('[WebSocket] 收到 CLOSE:', { action: action, code: code, reason: reason })

    // 企业级：pb 协议/协商错误，直接降级 json 并熔断 pb（避免无限重连失败）
    if (this.isPbEnabled()) {
      if (action === 'CODEC_UNBOUND' || action === 'CODEC_MISMATCH' || action === 'PROBE_REQUIRED' || action === 'PROBE_TIMEOUT') {
        console.warn('[WebSocket] downgrade pb -> json due to CLOSE action:', { action: action, code: code, reason: reason })
        this.downgradePbToJsonAndReconnect(action)
        return
      }
    }

    // 关键：被踢/需要重登时禁止重连（避免死循环）
    if (action === 'KICKED' || action === 'LOGOUT' || action === 'REVOKED' || action === 'REAUTH_REQUIRED') {
      this.allowReconnect = false
      this.sessionInvalidated = true
    }

    // 停止心跳
    this.stopHeartbeat()

    // 主动关闭也需要清理 pb 认证 SLA 定时器（避免降级/断开后误触发）
    this.clearPbAuthSlaTimer()

    // 关闭连接（会触发 onClose -> handleClose，但 allowReconnect 已经控制不会再重连）
    this.close()

    // 根据 action 做 UX（企微/钉钉：明确提示原因 + 引导登录）
    if (action === 'REAUTH_REQUIRED') {
      removeToken()
      uni.showModal({
        title: '登录已过期',
        content: reason || '登录已过期，请重新登录',
        showCancel: false,
        success: () => {
          setTimeout(() => {
            uni.reLaunch({ url: '/pages/login/login' })
          }, 50)
        }
      })
      return
    }

    if (action === 'LOGOUT' || action === 'KICKED' || action === 'REVOKED') {
      removeToken()

      let content = reason || '您的账号已下线'
      if (action === 'KICKED' && kickedAt > 0 && byDevice != null && byDevice != '') {
        try {
          const dt = new Date(kickedAt)
          const pad2 = (n: number): string => (n < 10 ? '0' + n : '' + n)
          const kickedAtText = `${dt.getFullYear()}-${pad2(dt.getMonth() + 1)}-${pad2(dt.getDate())} ${pad2(dt.getHours())}:${pad2(dt.getMinutes())}:${pad2(dt.getSeconds())}`
          content = `当前账号于${kickedAtText}在${byDevice}设备上登录。此客户端已退出登录。`
        } catch (e) {
          content = reason || '您的账号已下线'
        }
      }
      uni.showModal({
        title: '下线通知',
        content: content,
        showCancel: false,
        success: () => {
          setTimeout(() => {
            uni.reLaunch({ url: '/pages/login/login' })
          }, 50)
        }
      })
      return
    }

    // 未知 CLOSE：保持原有行为（提示后自动重连由 allowReconnect 控制）
    uni.showToast({
      title: reason || '连接已关闭',
      icon: 'none'
    })
  }

  private async handleSystemNotify(message: any): Promise<void> {
    const body: any = message && message.body ? message.body : {}
    const action = body && typeof body === 'object' ? (body.action as string) : ''

    if (action === 'RENEW_SUGGEST') {
      console.log('[WebSocket] 收到 RENEW_SUGGEST:', body)
      await this.renewAuthSilently()
      return
    }

    // 其他系统通知交给业务层监听（如有需要可在 MessageService 里注册）
    this.dispatchMessage(MessageType.SYSTEM_NOTIFY, message)
  }

  private requestReauth(source: string): void {
    if (this.state !== WebSocketState.OPEN) {
      return
    }
    if (!this.allowReconnect) {
      return
    }
    const token = getAccessToken()
    if (token == null || token == '') {
      return
    }

    // 合并：短时间内多次触发只执行一次 AUTH_REQ
    const now = Date.now()
    if (this.reauthPending) {
      return
    }
    if (now - this.lastReauthAt < 800) {
      return
    }

    this.reauthPending = true
    setTimeout(() => {
      try {
        if (this.state !== WebSocketState.OPEN) {
          return
        }
        if (!this.allowReconnect) {
          return
        }
        console.log('[WebSocket] requestReauth -> AUTH_REQ', { source: source })
        if (this.isPbEnabled()) {
          this.sendAuthRequestPb()
        } else {
          this.sendAuthRequest()
        }
        this.lastReauthAt = Date.now()
      } finally {
        this.reauthPending = false
      }
    }, 0)
  }
  
  /**
   * 分发消息给监听器
   */
  private dispatchMessage(messageType: MessageType, message: any): void {
    const listeners = this.messageListeners.get(messageType)
    if (listeners !== null) {
      listeners.forEach((listener) => {
        try {
          listener(message)
        } catch (e) {
          console.error('[WebSocket] 消息监听器执行失败:', e)
        }
      })
    }
  }
  
  /**
   * 处理连接关闭
   */
  private handleClose(source?: SocketTask): void {
    if (source != null && this.ws != null && source !== this.ws) {
      return
    }
    console.log('[WebSocket] 连接已关闭')
    this.connectInFlight = false
    this.setState(WebSocketState.CLOSED)
    this.authenticated = false

	// 连接关闭：清理 pb 认证 SLA 定时器
	this.clearPbAuthSlaTimer()
    
    // 停止心跳
    this.stopHeartbeat()
    
    // 尝试重连
    this.reconnect()
  }
  
  /**
   * 处理连接错误
   */
  private handleError(err: any, source?: SocketTask): void {
    if (source != null && this.ws != null && source !== this.ws) {
      return
    }
    console.error('[WebSocket] 连接错误:', err)
    this.setState(WebSocketState.CLOSED)
    this.authenticated = false

	// 连接错误：清理 pb 认证 SLA 定时器
	this.clearPbAuthSlaTimer()
    
    // 停止心跳
    this.stopHeartbeat()
    
    // 尝试重连
    this.reconnect()
  }
  
  /**
   * 重连
   */
  private reconnect(): void {
    if (this.reconnectTimer !== 0) {
      clearTimeout(this.reconnectTimer)
      this.reconnectTimer = 0
    }

    if (!this.allowReconnect) {
      return
    }

    if (this.reconnectCount >= this.maxReconnectCount) {
      console.log('[WebSocket] 已达到最大重连次数，停止重连')
      return
    }

    this.reconnectCount++

    // 指数退避策略: 1s, 2s, 4s, 8s, 16s
    const delay = Math.min(1000 * Math.pow(2, this.reconnectCount - 1), 30000)

    console.log(`[WebSocket] ${delay}ms 后进行第 ${this.reconnectCount} 次重连...`)

    this.reconnectTimer = setTimeout(() => {
      this.connect()
    }, delay)
  }
  
  /**
   * 启动心跳
   */
  private startHeartbeat(): void {
    console.log('[WebSocket] 启动心跳')
    
    // 清除旧的定时器
    this.stopHeartbeat()
    
    // 定时发送心跳
    this.heartbeatTimer = setInterval(() => {
      this.sendHeartbeat()
    }, this.heartbeatInterval)
  }
  
  /**
   * 停止心跳
   */
  private stopHeartbeat(): void {
    if (this.heartbeatTimer !== 0) {
      clearInterval(this.heartbeatTimer)
      this.heartbeatTimer = 0
    }
    
    if (this.heartbeatTimeoutTimer !== 0) {
      clearTimeout(this.heartbeatTimeoutTimer)
      this.heartbeatTimeoutTimer = 0
    }
  }
  
  /**
   * 发送心跳
   */
  private sendHeartbeat(): void {
    if (this.state !== WebSocketState.OPEN || !this.authenticated) {
      return
    }

    const presence = this.appForeground && (!this.strictPresenceMode || this.realtimeBizActive)
    
    if (this.isPbEnabled()) {
      try {
        const extraObj: any = {
          presence: presence
        }
        const header: any = {
          messageId: generateLongSafeMessageId(),
          messageType: MessageType.HEARTBEAT_REQ,
          senderId: '0',
          receiverId: '0',
          groupId: '0',
          tenantId: '0',
          timestamp: Date.now().toString(),
          sequence: '0',
          extra: JSON.stringify(extraObj)
        }
        // 当前 proto 未定义 HeartbeatRequest，按 bytes 空体发送（服务端仅用 messageType 即可）
        console.log('[WebSocket] 发送心跳(pb)')
        this.sendPbImMessage(header, new Uint8Array(0))
      } catch (e) {
        console.error('[WebSocket] 发送心跳(pb)失败:', e)
      }
    } else {
      const heartbeatMessage = {
        header: {
          messageId: generateLongSafeMessageId(),
          messageType: MessageType.HEARTBEAT_REQ,
          timestamp: Date.now()
        },
        body: {
          // presence：让服务端将心跳视为业务活跃，从而延长 lease（企微/钉钉体验）
          presence: presence
        }
      }

      console.log('[WebSocket] 发送心跳')
      this.sendRaw(JSON.stringify(heartbeatMessage))
    }
    
    // 设置心跳超时定时器
    this.heartbeatTimeoutTimer = setTimeout(() => {
      console.error('[WebSocket] 心跳超时，关闭连接')
      this.close()
    }, this.heartbeatTimeout)
  }
  
  /**
   * 发送消息
   */
  public send(message: any): void {
    try {
      const mt = message && message.header ? message.header.messageType : null
      const mid = message && message.header ? message.header.messageId : null
      console.log('[WebSocket] send() attempt:', { state: this.state, authenticated: this.authenticated, messageType: mt, messageId: mid })
    } catch (e) {
      console.log('[WebSocket] send() attempt: <unable to inspect message>', e)
    }

    if (this.sessionInvalidated || !this.allowReconnect) {
      console.warn('[WebSocket] 会话已失效，丢弃发送请求')
      return
    }

    if (!this.authenticated) {
      console.log('[WebSocket] 未认证，消息加入队列')
      this.messageQueue.push(message)

	  // 未认证但连接已断开：主动触发连接（否则消息会一直堆在队列里）
	  if (this.state === WebSocketState.CLOSED) {
		  try {
			  this.connect()
		  } catch (e) {
			  // ignore
		  }
	  }
      return
    }
    
    if (this.state !== WebSocketState.OPEN) {
      console.log('[WebSocket] 连接未打开，消息加入队列')
      this.messageQueue.push(message)

	  // 连接未打开：主动触发连接（避免无声排队）
	  if (this.state === WebSocketState.CLOSED) {
		  try {
			  this.connect()
		  } catch (e) {
			  // ignore
		  }
	  }
      return
    }
    
    if (this.isPbEnabled()) {
      try {
        this.sendPbFromJsonMessage(message)
      } catch (e) {
        console.error('[WebSocket] pb send failed, fallback to json:', e)
        this.sendRaw(JSON.stringify(message))
      }
      return
    }

    this.sendRaw(JSON.stringify(message))
  }

  private isPbEnabled(): boolean {
    try {
      return this.wsProtocols != null
        && Array.isArray(this.wsProtocols)
        && this.wsProtocols.indexOf('im.pb.v1') >= 0
    } catch (e) {
      return false
    }
  }

  private writeVarint32(value: number): Uint8Array {
    const out: number[] = []
    let v = value >>> 0
    while (v >= 0x80) {
      out.push((v & 0x7f) | 0x80)
      v >>>= 7
    }
    out.push(v)
    return new Uint8Array(out)
  }

  private concatBytes(a: Uint8Array, b: Uint8Array): Uint8Array {
    const out = new Uint8Array(a.byteLength + b.byteLength)
    out.set(a, 0)
    out.set(b, a.byteLength)
    return out
  }

  private sendPbImMessage(header: any, bodyBytes: Uint8Array): void {
    const root: any = (ImProto as any)
    const im = root.ImMessage.create({
      header: header,
      body: bodyBytes
    })
    const raw: Uint8Array = root.ImMessage.encode(im).finish() as Uint8Array
    const prefix = this.writeVarint32(raw.byteLength)
    const framed = this.concatBytes(prefix, raw)
    this.sendBinary(framed.buffer)
  }

  private encodePbBody(messageType: MessageType, bodyAny: any): Uint8Array {
    const root: any = (ImProto as any)

    if (bodyAny == null) {
      return new Uint8Array(0)
    }

    // 兼容：上层若已放入 rawBytes，则直接发送
    try {
      if (bodyAny.rawBytes != null) {
        const rb: any = bodyAny.rawBytes
        if (rb instanceof Uint8Array) {
          return rb
        }
        if (rb instanceof ArrayBuffer) {
          return new Uint8Array(rb as ArrayBuffer)
        }
      }
    } catch (e) {
    }

    if (messageType === MessageType.TEXT) {
      const mentions = Array.isArray(bodyAny.mentions)
        ? bodyAny.mentions.map((m: any) => ({
            userId: m != null && m.userId != null ? String(m.userId) : '0',
            nickname: m != null && m.nickname != null ? String(m.nickname) : '',
            startIndex: m != null && m.startIndex != null ? Number(m.startIndex) : 0,
            endIndex: m != null && m.endIndex != null ? Number(m.endIndex) : 0
          }))
        : []
      return root.TextMessage.encode({
        content: bodyAny.content != null ? String(bodyAny.content) : '',
        atUserIds: Array.isArray(bodyAny.atUserIds) ? bodyAny.atUserIds.map((x: any) => x != null ? String(x) : '0') : [],
        mentions: mentions
      }).finish() as Uint8Array
    }

    if (messageType === MessageType.QUOTE_REPLY) {
      const mentions = Array.isArray(bodyAny.mentions)
        ? bodyAny.mentions.map((m: any) => ({
            userId: m != null && m.userId != null ? String(m.userId) : '0',
            nickname: m != null && m.nickname != null ? String(m.nickname) : '',
            startIndex: m != null && m.startIndex != null ? Number(m.startIndex) : 0,
            endIndex: m != null && m.endIndex != null ? Number(m.endIndex) : 0
          }))
        : []
      return root.QuoteReplyMessage.encode({
        quoteMessageId: bodyAny.quotedMessageId != null ? String(bodyAny.quotedMessageId) : '0',
        quoteContent: bodyAny.quotedContent != null ? String(bodyAny.quotedContent) : '',
        quoteSenderName: bodyAny.quotedSenderName != null ? String(bodyAny.quotedSenderName) : '',
        quoteSenderId: bodyAny.quotedSenderId != null ? String(bodyAny.quotedSenderId) : '0',
        replyContent: bodyAny.content != null ? String(bodyAny.content) : '',
        atUserIds: Array.isArray(bodyAny.atUserIds) ? bodyAny.atUserIds.map((x: any) => x != null ? String(x) : '0') : [],
        mentions: mentions
      }).finish() as Uint8Array
    }

    if (messageType === MessageType.VOICE) {
      return root.VoiceMessage.encode({
        url: bodyAny.url != null ? String(bodyAny.url) : '',
        duration: bodyAny.duration != null ? Number(bodyAny.duration) : 0,
        size: bodyAny.size != null ? Number(bodyAny.size) : 0
      }).finish() as Uint8Array
    }

    return new Uint8Array(0)
  }

  private sendPbFromJsonMessage(message: any): void {
    if (message == null || message.header == null) {
      return
    }
    const headerIn: any = message.header
    const mt: MessageType = headerIn.messageType as MessageType
    const bodyBytes = this.encodePbBody(mt, message.body)

    const header: any = {
      messageId: headerIn.messageId != null ? headerIn.messageId.toString() : generateLongSafeMessageId(),
      messageType: mt,
      senderId: headerIn.senderId != null ? headerIn.senderId.toString() : '0',
      receiverId: headerIn.receiverId != null ? headerIn.receiverId.toString() : '0',
      groupId: headerIn.groupId != null ? headerIn.groupId.toString() : '0',
      tenantId: headerIn.tenantId != null ? headerIn.tenantId.toString() : '0',
      timestamp: headerIn.timestamp != null ? headerIn.timestamp.toString() : Date.now().toString(),
      sequence: headerIn.sequence != null ? headerIn.sequence.toString() : '0',
      extra: headerIn.extra != null ? String(headerIn.extra) : ''
    }

    this.sendPbImMessage(header, bodyBytes)
  }
  
  /**
   * 发送原始数据
   */
  private sendRaw(data: string): void {
    if (this.ws === null) {
      console.error('[WebSocket] WebSocket 实例为空')
      return
    }
    
    try {
      let parsedType: any = null
      let parsedId: any = null
	  let parsedHeader: any = null
      try {
        const parsed = JSON.parse(data)
        parsedType = parsed && parsed.header ? parsed.header.messageType : null
        parsedId = parsed && parsed.header ? parsed.header.messageId : null
		parsedHeader = parsed && parsed.header ? parsed.header : null
      } catch (e) {
        // ignore
      }

	  // 仅对业务消息打印概要（避免图片/文件过大）
	  if (parsedType !== null && typeof parsedType === 'number' && parsedType >= 100) {
		try {
			console.log('[WebSocket] sendRaw business header:', {
				messageType: parsedHeader ? parsedHeader.messageType : parsedType,
				messageId: parsedHeader ? parsedHeader.messageId : parsedId,
				senderId: parsedHeader ? parsedHeader.senderId : null,
				receiverId: parsedHeader ? parsedHeader.receiverId : null,
				groupId: parsedHeader ? parsedHeader.groupId : null,
				tenantId: parsedHeader ? parsedHeader.tenantId : null
			})
		} catch (e) {
			console.log('[WebSocket] sendRaw business header log failed:', e)
		}
	  }

      this.ws.send({
        data: data,
        success: () => {
          console.log('[WebSocket] 消息发送成功', { messageType: parsedType, messageId: parsedId })
        },
        fail: (err) => {
          console.error('[WebSocket] 消息发送失败:', err, { messageType: parsedType, messageId: parsedId })
        }
      })
    } catch (e) {
      console.error('[WebSocket] 发送异常:', e)
    }
  }
  
  /**
   * 发送队列中的消息
   */
  private flushMessageQueue(): void {
    if (this.messageQueue.length === 0) {
      return
    }

    console.log(`[WebSocket] 发送队列中的 ${this.messageQueue.length} 条消息`, { state: this.state, authenticated: this.authenticated })
    
    while (this.messageQueue.length > 0) {
      const message = this.messageQueue.shift()
      if (message !== null) {
        try {
          if (this.isPbEnabled()) {
            this.sendPbFromJsonMessage(message)
          } else {
            this.sendRaw(JSON.stringify(message))
          }
        } catch (e) {
          try {
            this.sendRaw(JSON.stringify(message))
          } catch (e2) {
            // ignore
          }
        }
      }
    }
  }
  
  /**
   * 同步角标数据
   * WebSocket 重连后从服务器同步最新的角标数据
   */
  private syncBadgeData(): void {
    console.log('[WebSocket] WebSocket 连接成功，同步角标数据')
    
    try {
      // 调用 badgeService 从服务器同步角标数据
      badgeService.syncFromServer()
    } catch (e) {
      console.error('[WebSocket] 同步角标数据失败:', e)
      // 失败不影响其他功能，badgeService 会使用本地缓存
    }
  }
  
  /**
   * 关闭连接
   */
  public close(): void {
    console.log('[WebSocket] 主动关闭连接')
    
    // 清除重连定时器
    if (this.reconnectTimer !== 0) {
      clearTimeout(this.reconnectTimer)
      this.reconnectTimer = 0
    }
    
    // 停止心跳
    this.stopHeartbeat()

    // 主动关闭也需要清理 pb 认证 SLA 定时器（避免降级/断开后误触发）
    this.clearPbAuthSlaTimer()
    
    // 关闭 WebSocket
    if (this.ws !== null) {
      this.ws.close({
        success: () => {
          console.log('[WebSocket] 连接已关闭')
        },
        fail: (err) => {
          console.error('[WebSocket] 关闭失败:', err)
        }
      })
      this.ws = null
    }
    
    this.setState(WebSocketState.CLOSED)
    this.authenticated = false
  }

  public disableReconnectAndClose(): void {
    this.allowReconnect = false
    this.close()
  }

  private async renewAuthSilently(): Promise<void> {
    if (this.renewing) {
      return
    }
    if (this.state !== WebSocketState.OPEN) {
      return
    }

    this.renewing = true
    try {
      const refresh = getRefreshToken()
      if (refresh != null && refresh != '') {
        try {
          const tokenData = await refreshTokenApi(refresh)
          if (tokenData != null) {
            setToken(tokenData)
          }
        } catch (e) {
          console.warn('[WebSocket] refreshToken failed, fallback to AUTH_REQ with existing token', e)
        }
      }

      // 无感续期：同一条连接重新发送 AUTH_REQ（服务端允许已认证连接重复 AUTH_REQ）
      this.requestReauth('renew_suggest')
    } finally {
      this.renewing = false
    }
  }
  
  /**
   * 添加消息监听器
   */
  public addMessageListener(messageType: MessageType, listener: MessageListener): void {
    let listeners = this.messageListeners.get(messageType)
    if (listeners === null) {
      listeners = []
      this.messageListeners.set(messageType, listeners)
    }
    listeners.push(listener)
  }
  
  /**
   * 移除消息监听器
   */
  public removeMessageListener(messageType: MessageType, listener: MessageListener): void {
    const listeners = this.messageListeners.get(messageType)
    if (listeners !== null) {
      const index = listeners.indexOf(listener)
      if (index !== -1) {
        listeners.splice(index, 1)
      }
    }
  }
  
  /**
   * 添加连接状态监听器
   */
  public addStateListener(listener: StateListener): void {
    this.stateListeners.push(listener)
  }
  
  /**
   * 移除连接状态监听器
   */
  public removeStateListener(listener: StateListener): void {
    const index = this.stateListeners.indexOf(listener)
    if (index !== -1) {
      this.stateListeners.splice(index, 1)
    }
  }
  
  /**
   * 设置连接状态
   */
  private setState(state: WebSocketState): void {
    if (this.state === state) {
      return
    }
    
    this.state = state
    console.log('[WebSocket] 状态变更:', state)
    
    // 通知监听器
    this.stateListeners.forEach((listener) => {
      try {
        listener(state)
      } catch (e) {
        console.error('[WebSocket] 状态监听器执行失败:', e)
      }
    })
  }
  
  /**
   * 获取连接状态
   */
  public getState(): WebSocketState {
    return this.state
  }
  
  /**
   * 判断是否已连接
   */
  public isConnected(): boolean {
    return this.state === WebSocketState.OPEN && this.authenticated
  }
}

/**
 * 导出单例实例
 */
export const wsManager = WebSocketManager.getInstance()
