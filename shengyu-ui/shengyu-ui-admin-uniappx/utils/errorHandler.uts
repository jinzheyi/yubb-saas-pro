// 错误处理工具类
import { apiConfig } from '@/config/apiConfig.uts'

/**
 * UniError类型定义
 */
export type UniError = {
  errSubject: string
  errCode: number
  errMsg: string
  cause?: any
}

/**
 * 错误主题枚举
 */
export enum ErrorSubject {
  API = 'uni-api',
  AUTH = 'uni-auth',
  NETWORK = 'uni-network'
}

/**
 * 错误码枚举
 */
export enum ErrorCode {
  // 通用错误
  SUCCESS = 0,
  FAIL = 1,
  
  // 网络错误
  NETWORK_ERROR = 1000000,
  TIMEOUT = 1000001,
  
  // 认证错误
  UNAUTHORIZED = 2000000,
  TOKEN_EXPIRED = 2000001,
  REFRESH_TOKEN_EXPIRED = 2000002
}

/**
 * 创建UniError对象
 * @param subject 错误主题
 * @param code 错误码
 * @param message 错误信息
 * @param cause 源错误
 * @returns UniError对象
 */
export const createUniError = (subject: ErrorSubject, code: ErrorCode, message: string, cause?: any): UniError => {
  return {
    errSubject: subject,
    errCode: code,
    errMsg: message,
    cause
  }
}

/**
 * 处理网络错误
 * @param err 原始错误
 * @returns UniError对象
 */
export const handleNetworkError = (err: any): UniError => {
  if (err && err.errMsg && err.errMsg.includes('timeout')) {
    return createUniError(
      ErrorSubject.NETWORK,
      ErrorCode.TIMEOUT,
      apiConfig.apiTimeoutMessage || '接口请求超时,请刷新页面重试!',
      err
    )
  } else if (err && err.errMsg && err.errMsg.includes('request:fail')) {
    return createUniError(
      ErrorSubject.NETWORK,
      ErrorCode.NETWORK_ERROR,
      apiConfig.apiRequestFailed || '请求出错，请稍候重试',
      err
    )
  } else {
    return createUniError(
      ErrorSubject.NETWORK,
      ErrorCode.NETWORK_ERROR,
      apiConfig.networkExceptionMsg || '网络异常，请检查您的网络连接是否正常!',
      err
    )
  }
}

/**
 * 处理API错误
 * @param response API响应
 * @returns UniError对象
 */
export const handleApiError = (response: any): UniError => {
  let message = ''
  let code = ErrorCode.FAIL
  
  switch (response.code) {
    case 401:
      message = apiConfig.errMsg401 || '用户没有权限（令牌、用户名、密码错误）!'
      code = ErrorCode.UNAUTHORIZED
      break
    case 403:
      message = apiConfig.errMsg403 || '用户得到授权，但是访问是被禁止的。!'
      break
    case 404:
      message = apiConfig.errMsg404 || '网络请求错误,未找到该资源!'
      break
    case 405:
      message = apiConfig.errMsg405 || '网络请求错误,请求方法未允许!'
      break
    case 408:
      message = apiConfig.errMsg408 || '网络请求超时!'
      code = ErrorCode.TIMEOUT
      break
    case 500:
      message = apiConfig.errMsg500 || '服务器错误,请联系管理员!'
      break
    case 501:
      message = apiConfig.errMsg501 || '网络未实现!'
      break
    case 502:
      message = apiConfig.errMsg502 || '网络错误!'
      break
    case 503:
      message = apiConfig.errMsg503 || '服务不可用，服务器暂时过载或维护!'
      break
    case 504:
      message = apiConfig.errMsg504 || '网络超时!'
      code = ErrorCode.TIMEOUT
      break
    case 505:
      message = apiConfig.errMsg505 || 'http版本不支持该请求!'
      break
    case 901:
      message = apiConfig.errMsg901 || '演示模式，无法进行写操作!'
      break
    default:
      message = response.msg || response.message || apiConfig.errorMessage || '操作失败,系统异常!'
      break
  }
  
  return createUniError(
    ErrorSubject.API,
    code,
    message,
    response
  )
}
