export function canOpenExternalUrl(): boolean {
	// #ifdef H5
	try {
		if (typeof window !== 'undefined' && (window as any).open != null) {
			return true
		}
	} catch (e) {
		return false
	}
	// #endif

	// #ifdef APP-PLUS || APP-HARMONY
	try {
		const plusAny = plus as any
		return plusAny != null && plusAny.runtime != null && typeof plusAny.runtime.openURL === 'function'
	} catch (e) {
		return false
	}
	// #endif

	return false
}

export function openExternalUrl(url: string): Promise<void> {
	return new Promise((resolve, reject) => {
		if (!url) {
			reject(new Error('empty url'))
			return
		}
		// #ifdef H5
		try {
			if (typeof window !== 'undefined' && (window as any).open != null) {
				(window as any).open(url, '_blank')
				resolve()
				return
			}
		} catch (e) {
			reject(e)
			return
		}
		// #endif
		// #ifdef APP-PLUS || APP-HARMONY
		try {
			const plusAny = plus as any
			if (plusAny != null && plusAny.runtime != null && typeof plusAny.runtime.openURL === 'function') {
				plusAny.runtime.openURL(url, () => resolve(), (err: any) => reject(err))
				return
			}
		} catch (e) {
			reject(e)
			return
		}
		// #endif
		reject(new Error('unsupported open url'))
	})
}
