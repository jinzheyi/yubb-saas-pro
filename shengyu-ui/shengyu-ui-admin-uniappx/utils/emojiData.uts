/**
 * 微信 1:1 表情映射表
 * 资源存放于 static/images/emoji/ 及其子目录下
 */

export const emojiMap = new Map<string, string>()

// 批量注册函数
function registerEmojis(names : string[], folder : string) {
	names.forEach(name => {
		const code = `[${name}]`
		const path = `/static/images/emoji/${folder}/${name}.png`
		emojiMap.set(code, path)
	})
}

// 1. 人脸表情 (Face) - 严格匹配文件列表
registerEmojis([
	'666', 'Emm', '亲亲', '偷笑', '傲慢', '再见', '加油', '发呆', '发怒', '可怜', 
	'右哼哼', '叹气', '吃瓜', '吐', '呲牙', '咒骂', '哇', '嘘', '嘿哈', '囧', 
	'困', '坏笑', '大哭', '天啊', '失望', '奸笑', '好的', '委屈', '害羞', '尴尬', 
	'得意', '微笑', '快哭了', '恐惧', '悠闲', '惊恐', '惊讶', '愉快', '憨笑', '打脸', 
	'抓狂', '抠鼻', '捂脸', '撇嘴', '擦汗', '敲打', '无语', '旺柴', '晕', '机智', 
	'汗', '流泪', '生病', '疑问', '白眼', '皱眉', '睡', '破涕为笑', '社会社会', '笑脸', 
	'翻白眼', '耶', '脸红', '色', '苦涩', '衰', '裂开', '让我看看', '调皮', '鄙视', 
	'闭嘴', '阴险', '难过', '骷髅', '鼓掌'
], 'face')

// 2. 手势 (Gesture)
registerEmojis(['OK', '勾引', '合十', '弱', '强', '抱拳', '拥抱', '拳头', '握手', '胜利'], 'gesture')

// 3. 动物/植物 (Animal)
registerEmojis(['发抖', '猪头', '跳跳', '转圈'], 'animal')

// 4. 祝福 (Blessing)
registerEmojis(['庆祝', '烟花', '爆竹', '發', '礼物', '福', '红包'], 'blessing')

// 5. 其他 (Other)
registerEmojis(['便便', '凋谢', '咖啡', '啤酒', '嘴唇', '太阳', '心碎', '月亮', '炸弹', '爱心', '玫瑰', '菜刀', '蛋糕'], 'other')

/**
 * 导出数组格式供 UI 渲染使用
 */
export const emojiList = Array.from(emojiMap.keys()).map(code => ({
	code: code,
	path: emojiMap.get(code)
}))

/**
 * 反向映射表：路径 -> 代码 (用于 Editor 解析)
 */
export const pathMap = new Map<string, string>()
emojiMap.forEach((path, code) => {
	pathMap.set(path, code)
})

