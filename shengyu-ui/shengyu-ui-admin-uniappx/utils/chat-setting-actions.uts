import { clearConversationMessages } from '../api/message.uts'
import { conversationService } from '../services/conversation-service.uts'
import { groupService } from '../services/group-service.uts'
import { messageService } from '../services/message-service.uts'
import { t } from '../store/locale.uts'

export const GROUP_LIFECYCLE_NOTICE_KEY = 'IM_GROUP_REMOVAL_NOTICE'
export const SUPPRESS_GROUP_LIFECYCLE_ERROR_TOAST_UNTIL_KEY = 'IM_SUPPRESS_GROUP_LIFECYCLE_ERROR_TOAST_UNTIL'
const CONVERSATION_NOT_EXISTS_CODE = 1002030000
const GROUP_NOT_EXISTS_CODE = 1002030200
const GROUP_MEMBER_NOT_EXISTS_CODE = 1002030201
const GROUP_DISSOLVED_CODE = 1002030204

function normalizeId(raw: any): string {
	return raw != null ? String(raw).trim() : ''
}

function extractErrorCode(error: any): number {
	try {
		if (error != null && error.code != null) {
			return Number(error.code)
		}
		if (error != null && error.data != null && error.data.code != null) {
			return Number(error.data.code)
		}
	} catch (e) {
		// ignore
	}
	return 0
}

function rememberGroupLifecycleNotice(notice: string): void {
	const normalizedNotice = notice != null ? String(notice).trim() : ''
	if (normalizedNotice !== '') {
		try {
			uni.setStorageSync(GROUP_LIFECYCLE_NOTICE_KEY, normalizedNotice)
		} catch (e) {
			// ignore
		}
	}
	armGroupLifecycleErrorToastSuppression()
}

export function armGroupLifecycleErrorToastSuppression(durationMs: number = 8000): void {
	try {
		uni.setStorageSync(SUPPRESS_GROUP_LIFECYCLE_ERROR_TOAST_UNTIL_KEY, String(Date.now() + durationMs))
	} catch (e) {
		// ignore
	}
}

export function cleanupConversationRuntime(chatId: string): void {
	const normalizedChatId = normalizeId(chatId)
	if (normalizedChatId === '') {
		return
	}
	try {
		conversationService.clearUnreadLocal(normalizedChatId)
		messageService.clearUnreadCount(normalizedChatId)
		messageService.clearChatCache(normalizedChatId)
	} catch (e) {
		console.error('[ChatSettingActions] 清理会话运行态失败:', e)
	}
}

export async function clearConversationHistory(chatId: string): Promise<void> {
	const normalizedChatId = normalizeId(chatId)
	if (normalizedChatId === '') {
		throw new Error('chatId is empty')
	}
	await clearConversationMessages(normalizedChatId)
	cleanupConversationRuntime(normalizedChatId)
}

export async function deleteConversationForCurrentUser(chatId: string): Promise<boolean> {
	const normalizedChatId = normalizeId(chatId)
	if (normalizedChatId === '') {
		return true
	}
	const success = await conversationService.deleteConversation(normalizedChatId)
	if (success) {
		cleanupConversationRuntime(normalizedChatId)
		return true
	}
	conversationService.removeConversationLocal(normalizedChatId)
	cleanupConversationRuntime(normalizedChatId)
	return false
}

export function finalizeGroupLifecycleExit(groupId: string, chatId: string, notice: string): void {
	const normalizedGroupId = normalizeId(groupId)
	const normalizedChatId = normalizeId(chatId)
	rememberGroupLifecycleNotice(notice)
	if (normalizedGroupId !== '') {
		groupService.invalidateGroup(normalizedGroupId)
		groupService.invalidateGroupMembers(normalizedGroupId)
	}
	if (normalizedChatId !== '') {
		conversationService.removeConversationLocal(normalizedChatId)
		cleanupConversationRuntime(normalizedChatId)
	}
	try {
		messageService.setActiveChatAutoReadEnabled(false)
		messageService.setActiveChatId(null)
	} catch (e) {
		// ignore
	}
	uni.switchTab({
		url: '/pages/message/message'
	})
}

export function resolveGroupLifecycleErrorNotice(error: any, fallbackNotice: string = ''): string {
	const code = extractErrorCode(error)
	if (code === CONVERSATION_NOT_EXISTS_CODE) {
		return fallbackNotice !== '' ? fallbackNotice : t('chat.joinGroup.groupUnavailable')
	}
	if (code === GROUP_MEMBER_NOT_EXISTS_CODE) {
		return fallbackNotice !== '' ? fallbackNotice : t('im.notify.removed_from_group')
	}
	if (code === GROUP_NOT_EXISTS_CODE || code === GROUP_DISSOLVED_CODE) {
		return fallbackNotice !== '' ? fallbackNotice : t('chat.groupSettings.groupDissolved')
	}
	return ''
}

export async function quitGroupAndDeleteConversation(groupId: string, chatId: string): Promise<void> {
	const normalizedGroupId = normalizeId(groupId)
	if (normalizedGroupId === '') {
		throw new Error('groupId is empty')
	}
	armGroupLifecycleErrorToastSuppression()
	const quitSuccess = await groupService.quitGroup(normalizedGroupId)
	if (!quitSuccess) {
		throw new Error('quit group failed')
	}
	const normalizedChatId = normalizeId(chatId)
	if (normalizedChatId !== '') {
		try {
			await conversationService.deleteConversation(normalizedChatId)
		} catch (e) {
			console.error('[ChatSettingActions] 删除会话失败，转本地移除:', e)
		}
		conversationService.removeConversationLocal(normalizedChatId)
		cleanupConversationRuntime(normalizedChatId)
	}
	finalizeGroupLifecycleExit(normalizedGroupId, normalizedChatId, t('chat.groupSettings.quitSuccess'))
}

export async function dissolveGroupAndDeleteConversation(groupId: string, chatId: string): Promise<void> {
	const normalizedGroupId = normalizeId(groupId)
	if (normalizedGroupId === '') {
		throw new Error('groupId is empty')
	}
	armGroupLifecycleErrorToastSuppression()
	const dismissSuccess = await groupService.dismissGroup(normalizedGroupId)
	if (!dismissSuccess) {
		throw new Error('dismiss group failed')
	}
	const normalizedChatId = normalizeId(chatId)
	if (normalizedChatId !== '') {
		conversationService.removeConversationLocal(normalizedChatId)
		cleanupConversationRuntime(normalizedChatId)
	}
	finalizeGroupLifecycleExit(normalizedGroupId, normalizedChatId, t('chat.groupSettings.groupDissolved'))
}
