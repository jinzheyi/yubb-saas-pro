const ID_PARAM_PREFIX = 'sid:'

export function encodeIdParam(id: string | number | null): string {
	if (id == null) {
		return ''
	}
	return encodeURIComponent(ID_PARAM_PREFIX + String(id))
}

export function decodeIdParam(raw: any): string {
	if (raw == null) {
		return ''
	}
	const text = String(raw)
	if (text === '') {
		return ''
	}
	let decoded = text
	try {
		decoded = decodeURIComponent(text)
	} catch (e) {
		decoded = text
	}
	if (decoded.startsWith(ID_PARAM_PREFIX)) {
		return decoded.substring(ID_PARAM_PREFIX.length)
	}
	return decoded
}
