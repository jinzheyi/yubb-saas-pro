import { ClientPlatformCode, getCurrentClientPlatform } from './device.uts'

export type SystemShareImageOptions = {
	imagePath: string
	title?: string
}

export function canUseSystemShare(): boolean {
	const anyUni: any = uni as any
	return anyUni != null && typeof anyUni.shareWithSystem === 'function'
}

export function isSystemShareCanceled(err: any): boolean {
	const errCode = err != null && (err as any).errCode != null ? Number((err as any).errCode) : 0
	if (errCode === 1310600) {
		return true
	}
	const errMsg = err != null && (err as any).errMsg != null ? String((err as any).errMsg).toLowerCase() : ''
	return errMsg.indexOf('cancel') > -1
}

export function shareSingleImage(options: SystemShareImageOptions): Promise<boolean> {
	return new Promise((resolve, reject) => {
		const imagePath = options.imagePath != null ? String(options.imagePath).trim() : ''
		const title = options.title != null ? String(options.title) : ''
		if (imagePath === '') {
			reject(new Error('share image path empty'))
			return
		}

		const anyUni: any = uni as any
		if (canUseSystemShare()) {
			anyUni.shareWithSystem({
				type: 'image',
				imagePaths: [imagePath],
				success: () => resolve(true),
				fail: (err: any) => reject(err)
			})
			return
		}

		if (getCurrentClientPlatform() === ClientPlatformCode.WEB) {
			reject(new Error('system share unsupported on web'))
			return
		}

		const shareOptions: any = {
			provider: 'weixin',
			type: 0,
			imageUrl: imagePath,
			title: title,
			success: () => resolve(true),
			fail: (err: any) => reject(err)
		}
		uni.share(shareOptions)
	})
}
