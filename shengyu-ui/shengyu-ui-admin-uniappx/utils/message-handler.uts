/**
 * 消息处理器
 * 
 * 功能:
 * 1. 构建各种类型的消息
 * 2. 解析接收到的消息
 * 3. 消息格式转换
 * 
 * 说明:
 * 当前使用 JSON 格式，后续可升级为 Protobuf
 */

import { MessageType } from './websocket.uts'
import { generateMessageId as generateLongSafeMessageId } from './message-utils.uts'

/**
 * 消息头
 */
export type MessageHeader = {
  messageId: string
  messageType: MessageType
  senderId: string
  receiverId: string
  groupId: string
  chatId?: string
  tenantId: string
  timestamp: number
  sequence: string
  extra: string
}

/**
 * 完整消息
 */
export type ImMessage = {
  header: MessageHeader
  body: any
  conversationSnapshot?: any
}

/**
 * 文本消息体
 */
export type TextMessageBody = {
  content: string
  atUserIds: string[]
  mentions?: MentionUser[]
}

export type MentionUser = {
  userId: string
  nickname: string
  startIndex: number
  endIndex: number
}

/**
 * 图片消息体
 */
export type ImageMessageBody = {
  fileId?: string
  url: string
  thumbnailUrl: string
  width: number
  height: number
  size: number
}

/**
 * 语音消息体
 */
export type VoiceMessageBody = {
  fileId?: string
  url: string
  duration: number
  size: number
}

/**
 * 视频消息体
 */
export type VideoMessageBody = {
  fileId?: string
  url: string
  coverUrl: string
  duration: number
  width: number
  height: number
  size: number
}

/**
 * 文件消息体
 */
export type FileMessageBody = {
  fileId?: string
  url: string
  fileName: string
  size: number
  fileType: string
}

/**
 * 位置消息体
 */
export type LocationMessageBody = {
  latitude: number
  longitude: number
  address: string
}

/**
 * 已读回执消息体
 */
export type ReadReceiptMessageBody = {
  messageIds: string[]
}

/**
 * 消息撤回消息体
 */
export type RecallMessageBody = {
  messageId: string
}

/**
 * 引用回复消息体
 */
export type QuoteReplyMessageBody = {
  content: string
  quotedMessageId: string
  quotedContent: string
  quotedSenderName: string
  atUserIds: string[]
  mentions?: MentionUser[]
}

/**
 * 消息构建器
 */
export class MessageBuilder {
  
  /**
   * 生成消息 ID（使用时间戳 + 随机数）
   */
  public static generateMessageId(): string {
    return generateLongSafeMessageId()
  }

  /**
   * 构建图片消息（V2：双写 fileId + url，便于灰度迁移）
   */
  public static buildImageMessageV2(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    fileId: string,
    url: string,
    thumbnailUrl: string,
    width: number,
    height: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.IMAGE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )

    const body: ImageMessageBody = {
      fileId: fileId,
      url: url,
      thumbnailUrl: thumbnailUrl,
      width: width,
      height: height,
      size: size
    }

    return {
      header: header,
      body: body
    }
  }

  /**
   * 构建视频消息（V2：双写 fileId + url，便于灰度迁移）
   */
  public static buildVideoMessageV2(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    fileId: string,
    url: string,
    coverUrl: string,
    duration: number,
    width: number,
    height: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.VIDEO,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: VideoMessageBody = {
      fileId: fileId,
      url: url,
      coverUrl: coverUrl,
      duration: duration,
      width: width,
      height: height,
      size: size
    }
    
    return {
      header: header,
      body: body
    }
  }

  /**
   * 构建语音消息（V2：双写 fileId + url，便于灰度迁移）
   */
  public static buildVoiceMessageV2(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    fileId: string,
    url: string,
    duration: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.VOICE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )

    const body: VoiceMessageBody = {
      fileId: fileId,
      url: url,
      duration: duration,
      size: size
    }

    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建消息头
   */
  public static buildHeader(
    messageType: MessageType,
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string
  ): MessageHeader {
    return {
      messageId: MessageBuilder.generateMessageId(),
      messageType: messageType,
      senderId: senderId,
      receiverId: receiverId,
      groupId: groupId,
      tenantId: tenantId,
      timestamp: Date.now(),
      sequence: '0',  // 由服务端生成
      extra: ''
    }
  }
  
  /**
   * 构建文本消息
   */
  public static buildTextMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    content: string,
    atUserIds: string[] = [],
    mentions: MentionUser[] = []
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.TEXT,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: TextMessageBody = {
      content: content,
      atUserIds: atUserIds,
      mentions: mentions
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建图片消息
   */
  public static buildImageMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    url: string,
    thumbnailUrl: string,
    width: number,
    height: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.IMAGE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: ImageMessageBody = {
      url: url,
      thumbnailUrl: thumbnailUrl,
      width: width,
      height: height,
      size: size
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建语音消息
   */
  public static buildVoiceMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    url: string,
    duration: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.VOICE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: VoiceMessageBody = {
      url: url,
      duration: duration,
      size: size
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建视频消息
   */
  public static buildVideoMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    url: string,
    coverUrl: string,
    duration: number,
    width: number,
    height: number,
    size: number
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.VIDEO,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: VideoMessageBody = {
      url: url,
      coverUrl: coverUrl,
      duration: duration,
      width: width,
      height: height,
      size: size
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建文件消息
   */
  public static buildFileMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    url: string,
    fileName: string,
    size: number,
    fileType: string
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.FILE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )

    // 三端一致：header.extra 也写入文件元数据（JSON）
    try {
      header.extra = JSON.stringify({
        url: url,
        fileName: fileName,
        size: size,
        fileType: fileType
      })
    } catch (e) {
      // ignore
    }
    
    const body: FileMessageBody = {
      url: url,
      fileName: fileName,
      size: size,
      fileType: fileType
    }
    
    return {
      header: header,
      body: body
    }
  }

  /**
   * 构建文件消息（V2：双写 fileId + url，便于灰度迁移）
   */
  public static buildFileMessageV2(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    fileId: string,
    url: string,
    fileName: string,
    size: number,
    fileType: string
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.FILE,
      senderId,
      receiverId,
      groupId,
      tenantId
    )

    // 三端一致：header.extra 也写入文件元数据（JSON）
    try {
      header.extra = JSON.stringify({
        fileId: fileId,
        url: url,
        fileName: fileName,
        size: size,
        fileType: fileType
      })
    } catch (e) {
      // ignore
    }
    
    const body: FileMessageBody = {
      fileId: fileId,
      url: url,
      fileName: fileName,
      size: size,
      fileType: fileType
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建位置消息
   */
  public static buildLocationMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    latitude: number,
    longitude: number,
    address: string
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.LOCATION,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: LocationMessageBody = {
      latitude: latitude,
      longitude: longitude,
      address: address
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建已读回执消息
   */
  public static buildReadReceiptMessage(
    senderId: string,
    receiverId: string,
    tenantId: string,
    messageIds: string[]
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.READ_RECEIPT,
      senderId,
      receiverId,
      '0',
      tenantId
    )
    
    const body: ReadReceiptMessageBody = {
      messageIds: messageIds
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建消息撤回消息
   */
  public static buildRecallMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    messageId: string
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.RECALL,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: RecallMessageBody = {
      messageId: messageId
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建引用回复消息
   */
  public static buildQuoteReplyMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    content: string,
    quotedMessageId: string,
    quotedContent: string,
    quotedSenderName: string,
    atUserIds: string[] = [],
    mentions: MentionUser[] = []
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.QUOTE_REPLY,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body: QuoteReplyMessageBody = {
      content: content,
      quotedMessageId: quotedMessageId,
      quotedContent: quotedContent,
      quotedSenderName: quotedSenderName,
      atUserIds: atUserIds,
      mentions: mentions
    }
    
    return {
      header: header,
      body: body
    }
  }
  
  /**
   * 构建正在输入消息
   */
  public static buildTypingMessage(
    senderId: string,
    receiverId: string,
    groupId: string,
    tenantId: string,
    senderName: string
  ): ImMessage {
    const header = MessageBuilder.buildHeader(
      MessageType.TYPING,
      senderId,
      receiverId,
      groupId,
      tenantId
    )
    
    const body = {
      senderName: senderName
    }
    
    return {
      header: header,
      body: body
    }
  }
}

/**
 * 消息解析器
 */
export class MessageParser {
  
  /**
   * 解析消息
   */
  public static parse(data: string): ImMessage | null {
    try {
      const message = JSON.parse(data) as ImMessage
      return message
    } catch (e) {
      console.error('[MessageParser] 解析消息失败:', e)
      return null
    }
  }
  
  /**
   * 序列化消息
   */
  public static stringify(message: ImMessage): string {
    return JSON.stringify(message)
  }
  
  /**
   * 获取消息摘要（用于会话列表显示）
   */
  public static getSummary(message: ImMessage): string {
    const messageType = message.header.messageType
    
    switch (messageType) {
      case MessageType.TEXT:
        const textBody = message.body as TextMessageBody
        return textBody.content
      case MessageType.IMAGE:
        return '[图片]'
      case MessageType.VOICE:
        return '[语音]'
      case MessageType.VIDEO:
        return '[视频]'
      case MessageType.FILE:
        return '[文件]'
      case MessageType.LOCATION:
        return '[位置]'
      case MessageType.CUSTOM:
        try {
          const body: any = message.body as any
          const raw = body != null ? body.content : null
          if (raw != null && raw !== '') {
            const obj = MessageParser.tryParseJsonLike(raw)
            if (obj != null && obj.type != null && String(obj.type) === 'FORWARD_COMBINE') {
              return '[聊天记录]'
            }
            if (obj != null && obj.type != null && String(obj.type) === 'STICKER') {
              return '[动画表情]'
            }
          }
        } catch (e) {
        }
        return '[自定义消息]'
      case MessageType.QUOTE_REPLY:
        const quoteBody = message.body as QuoteReplyMessageBody
        return quoteBody.content
      default:
        return '[消息]'
    }
  }

  private static tryParseJsonLike(raw: any): any {
    try {
      if (raw == null) {
        return raw
      }
      if (typeof raw !== 'string') {
        return raw
      }
      const text = raw.trim()
      if (text === '' || text === '[object Object]' || text === '[object UTSJSONObject]' || text === '[object Array]') {
        return raw
      }
      const first = text.charAt(0)
      const last = text.charAt(text.length - 1)
      const isObjectJson = first === '{' && last === '}'
      const isArrayJson = first === '[' && last === ']'
      if (!isObjectJson && !isArrayJson) {
        return raw
      }
      if (isArrayJson) {
        const inner = text.substring(1, text.length - 1).trim()
        if (inner !== '') {
          const c0 = inner.charAt(0)
          const isLikelyJsonArray =
            c0 === '{' || c0 === '[' || c0 === '"' || c0 === '-' ||
            (c0 >= '0' && c0 <= '9') || c0 === 't' || c0 === 'f' || c0 === 'n'
          if (!isLikelyJsonArray) {
            return raw
          }
        }
      }
      return JSON.parse(text)
    } catch (e) {
      return raw
    }
  }
  
  /**
   * 格式化时间显示
   */
  public static formatTime(timestamp: number): string {
    const now = Date.now()
    const diff = now - timestamp
    
    // 1分钟内
    if (diff < 60000) {
      return '刚刚'
    }
    
    // 1小时内
    if (diff < 3600000) {
      const minutes = Math.floor(diff / 60000)
      return minutes + '分钟前'
    }
    
    const date = new Date(timestamp)
    const today = new Date()
    
    // 今天
    if (date.toDateString() === today.toDateString()) {
      const hours = date.getHours().toString().padStart(2, '0')
      const minutes = date.getMinutes().toString().padStart(2, '0')
      return hours + ':' + minutes
    }
    
    // 昨天
    const yesterday = new Date(today)
    yesterday.setDate(yesterday.getDate() - 1)
    if (date.toDateString() === yesterday.toDateString()) {
      return '昨天'
    }
    
    // 今年
    if (date.getFullYear() === today.getFullYear()) {
      const month = (date.getMonth() + 1).toString().padStart(2, '0')
      const day = date.getDate().toString().padStart(2, '0')
      return month + '-' + day
    }
    
    // 更早
    const year = date.getFullYear()
    const month = (date.getMonth() + 1).toString().padStart(2, '0')
    const day = date.getDate().toString().padStart(2, '0')
    return year + '-' + month + '-' + day
  }
}
