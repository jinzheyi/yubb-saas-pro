/**
 * 消息工具函数
 * 
 * 功能:
 * 1. 消息类型转换
 * 2. 消息内容解析
 * 3. 时间格式化
 * 4. 头像生成
 * 5. 消息 ID 生成
 */

import { MessageType } from './websocket.uts'

/**
 * 数据库消息类型映射到字符串
 */
export function mapDbTypeToString(dbType: number): string {
  switch (dbType) {
    case 1: return 'text'
    case 2: return 'image'
    case 3: return 'voice'
    case 4: return 'video'
    case 5: return 'file'
    case 6: return 'location'
    default: return 'unknown'
  }
}

/**
 * Protobuf 消息类型映射到字符串
 */
export function mapProtobufTypeToString(protobufType: MessageType): string {
  switch (protobufType) {
    case MessageType.TEXT: return 'text'
    case MessageType.IMAGE: return 'image'
    case MessageType.VOICE: return 'voice'
    case MessageType.VIDEO: return 'video'
    case MessageType.FILE: return 'file'
    case MessageType.LOCATION: return 'location'
    case MessageType.QUOTE_REPLY: return 'quote'
    case MessageType.READ_RECEIPT: return 'receipt'
    case MessageType.RECALL: return 'recall'
    case MessageType.TYPING: return 'typing'
    default: return 'unknown'
  }
}

/**
 * 智能获取消息类型字符串（自动判断输入类型）
 */
export function getMessageTypeString(type: any): string {
  if (typeof type === 'number') {
    // 判断是数据库类型还是 Protobuf 类型
    if (type >= 100) {
      // Protobuf 类型（100-199）
      return mapProtobufTypeToString(type as MessageType)
    } else {
      // 数据库类型（1-10）
      return mapDbTypeToString(type)
    }
  }
  return 'unknown'
}

/**
 * 解析消息内容（支持 JSON 字符串和对象）
 */
export function parseMessageContent(content: any): any {
  if (content === null || content === undefined) {
    return null
  }
  
  // 如果已经是对象，直接返回
  if (typeof content === 'object') {
    return content
  }
  
  // 如果是字符串，尝试解析为 JSON
  if (typeof content === 'string') {
    // 快速检查：如果不是 JSON 格式，直接返回
    const trimmed = content.trim()
    if (trimmed.length === 0) return content
    const firstChar = trimmed.charAt(0)
    const lastChar = trimmed.charAt(trimmed.length - 1)
    const looksLikeJson = (firstChar === '{' && lastChar === '}') || (firstChar === '[' && lastChar === ']')
    if (!looksLikeJson) return content
    
    try {
      const parsed = JSON.parse(trimmed)
      // 如果解析后还是字符串（可能是嵌套 JSON），不再递归，直接返回
      if (typeof parsed === 'string') {
        return parsed
      }
      return parsed
    } catch (e) {
      // 解析失败，返回原字符串
      return content
    }
  }
  
  return content
}

/**
 * 格式化消息时间
 * 
 * @param timestamp 时间戳（毫秒）
 * @returns 格式化后的时间字符串
 */
export function formatMessageTime(timestamp: number): string {
  const now = Date.now()
  const diff = now - timestamp
  const oneMinute = 60 * 1000
  const oneHour = 60 * oneMinute
  const oneDay = 24 * oneHour
  
  // 1分钟内
  if (diff < oneMinute) {
    return '刚刚'
  }
  
  // 1小时内
  if (diff < oneHour) {
    const minutes = Math.floor(diff / oneMinute)
    return minutes + '分钟前'
  }
  
  const date = new Date(timestamp)
  const today = new Date()
  
  // 今天
  if (date.toDateString() === today.toDateString()) {
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return hours + ':' + minutes
  }
  
  // 昨天
  const yesterday = new Date(today)
  yesterday.setDate(yesterday.getDate() - 1)
  if (date.toDateString() === yesterday.toDateString()) {
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return '昨天 ' + hours + ':' + minutes
  }
  
  // 本周内
  if (diff < 7 * oneDay) {
    const weekDays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return weekDays[date.getDay()] + ' ' + hours + ':' + minutes
  }
  
  // 本年内
  if (date.getFullYear() === today.getFullYear()) {
    const month = date.getMonth() + 1
    const day = date.getDate()
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return month + '月' + day + '日 ' + hours + ':' + minutes
  }
  
  // 跨年
  const year = date.getFullYear()
  const month = date.getMonth() + 1
  const day = date.getDate()
  const hours = String(date.getHours()).padStart(2, '0')
  const minutes = String(date.getMinutes()).padStart(2, '0')
  return year + '年' + month + '月' + day + '日 ' + hours + ':' + minutes
}

/**
 * 判断是否应该显示时间戳
 * 
 * @param currentTimestamp 当前消息时间戳
 * @param previousTimestamp 上一条消息时间戳
 * @returns 是否显示时间戳
 */
export function shouldShowTime(currentTimestamp: number, previousTimestamp: number): boolean {
  // 如果没有上一条消息，显示时间
  if (previousTimestamp === 0) {
    return true
  }
  
  // 如果时间差超过5分钟，显示时间
  const diff = currentTimestamp - previousTimestamp
  return diff > 5 * 60 * 1000
}

/**
 * 获取头像文本（取名字的前两个字符）
 * 
 * @param name 用户名称
 * @returns 头像文本
 */
export function getAvatarText(name: string): string {
  if (!name || name.length === 0) {
    return '?'
  }
  
  // 移除空格
  name = name.trim()
  
  // 中文名：取最后两个字
  // 英文名：取首字母
  const chineseRegex = /[\u4e00-\u9fa5]/
  if (chineseRegex.test(name)) {
    // 包含中文
    return name.length > 2 ? name.substring(name.length - 2) : name
  } else {
    // 英文或其他
    const words = name.split(' ')
    if (words.length >= 2) {
      // 取前两个单词的首字母
      return (words[0].charAt(0) + words[1].charAt(0)).toUpperCase()
    } else {
      // 取前两个字符
      return name.substring(0, Math.min(2, name.length)).toUpperCase()
    }
  }
}

/**
 * 获取用户头像颜色（根据用户ID生成固定颜色）
 * 
 * @param userId 用户ID
 * @returns 颜色值（十六进制）
 */
export function getUserAvatarColor(userId: number | string): string {
  const colors = [
    '#409EFF', // 蓝色
    '#67C23A', // 绿色
    '#E6A23C', // 橙色
    '#F56C6C', // 红色
    '#909399', // 灰色
    '#00D7FF', // 青色
    '#FF6EC7', // 粉色
    '#A78BFA', // 紫色
    '#FCD34D', // 黄色
    '#34D399'  // 翠绿色
  ]
  
  if (typeof userId === 'number') {
    const index = userId % colors.length
    return colors[index]
  }
  // 字符串 ID：用简单 hash 避免 parseInt 导致精度丢失
  let hash = 0
  for (let i = 0; i < userId.length; i++) {
    hash = (hash * 31 + userId.charCodeAt(i)) | 0
  }
  const positive = hash < 0 ? -hash : hash
  return colors[positive % colors.length]
}

/**
 * 生成消息 ID（使用雪花算法简化版）
 * 
 * @returns 消息ID
 */
let sequence = 0
let lastTimestamp = 0

export function generateMessageId(): string {
  let timestamp = Date.now()
  
  // 如果在同一毫秒内，序列号递增
  if (timestamp === lastTimestamp) {
    sequence = (sequence + 1) & 0xFFF  // 12位序列号
    if (sequence === 0) {
      // 序列号溢出，等待下一毫秒
      while (timestamp <= lastTimestamp) {
        timestamp = Date.now()
      }
    }
  } else {
    sequence = 0
  }
  
  lastTimestamp = timestamp
  
  // 组合：时间戳（42位） + 序列号（12位）
  // 注意：JavaScript 的 number 类型是 64 位浮点数，可以安全表示 53 位整数
  return (timestamp * 4096 + sequence).toString()
}

/**
 * 生成序列号
 * 
 * @returns 序列号
 */
export function generateSequence(): string {
  return (sequence++).toString()
}

/**
 * 验证消息内容是否为空
 * 
 * @param content 消息内容
 * @returns 是否为空
 */
export function isEmptyContent(content: any): boolean {
  if (content === null || content === undefined) {
    return true
  }
  
  if (typeof content === 'string') {
    return content.trim().length === 0
  }
  
  if (typeof content === 'object') {
    // 检查对象是否为空
    return Object.keys(content).length === 0
  }
  
  return false
}

/**
 * 获取消息内容摘要（用于通知显示）
 * 
 * @param type 消息类型
 * @param content 消息内容
 * @param maxLength 最大长度
 * @returns 摘要文本
 */
export function getMessageSummary(type: string, content: any, maxLength: number = 50): string {
  switch (type) {
    case 'text':
      const text = typeof content === 'string' ? content : content.content || ''
      return text.length > maxLength ? text.substring(0, maxLength) + '...' : text
    case 'image':
      return '[图片]'
    case 'voice':
      return '[语音]'
    case 'video':
      return '[视频]'
    case 'file':
      return '[文件]'
    case 'location':
      return '[位置]'
    case 'quote':
      return '[引用回复]'
    default:
      return '[消息]'
  }
}
