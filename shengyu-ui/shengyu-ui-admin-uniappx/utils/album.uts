export function canSaveImageToAlbum(): boolean {
	const anyUni: any = uni as any
	return anyUni != null && typeof anyUni.saveImageToPhotosAlbum === 'function'
}

export function canSaveVideoToAlbum(): boolean {
	const anyUni: any = uni as any
	return anyUni != null && typeof anyUni.saveVideoToPhotosAlbum === 'function'
}

export function saveImageFileToAlbum(tempFilePath: string): Promise<boolean> {
	return new Promise((resolve, reject) => {
		if (!canSaveImageToAlbum()) {
			reject(new Error('saveImageToPhotosAlbum unavailable'))
			return
		}
		uni.saveImageToPhotosAlbum({
			filePath: tempFilePath,
			success: () => resolve(true),
			fail: (err: any) => reject(err)
		})
	})
}

export function saveVideoFileToAlbum(tempFilePath: string): Promise<void> {
	return new Promise((resolve, reject) => {
		const anyUni: any = uni as any
		if (!canSaveVideoToAlbum()) {
			reject(new Error('saveVideoToPhotosAlbum unavailable'))
			return
		}
		anyUni.saveVideoToPhotosAlbum({
			filePath: tempFilePath,
			success: () => resolve(),
			fail: (err: any) => reject(err)
		})
	})
}
