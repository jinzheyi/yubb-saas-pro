type NavStateRecord = {
	payload: any
	expireAt: number
}

const NAV_STATE_PREFIX = 'NAV_STATE:'
const NAV_STATE_INDEX_KEY = 'NAV_STATE_INDEX'
const NAV_STATE_MAX_COUNT = 80

function buildNavStateId(): string {
	const ts = Date.now().toString(36)
	const rd = Math.random().toString(36).slice(2, 10)
	return `${ts}${rd}`
}

function loadIndex(): string[] {
	try {
		const raw: any = uni.getStorageSync(NAV_STATE_INDEX_KEY)
		if (raw == null || raw === '') {
			return []
		}
		if (typeof raw === 'string') {
			const arr = JSON.parse(raw)
			return Array.isArray(arr) ? arr.map(v => String(v)) : []
		}
		return Array.isArray(raw) ? (raw as any[]).map(v => String(v)) : []
	} catch (e) {
		return []
	}
}

function saveIndex(index: string[]): void {
	try {
		uni.setStorageSync(NAV_STATE_INDEX_KEY, JSON.stringify(index))
	} catch (e) {
	}
}

function cleanupNavState(index: string[]): string[] {
	const next: string[] = []
	const now = Date.now()
	for (let i = 0; i < index.length; i++) {
		const id = index[i]
		if (!id) {
			continue
		}
		try {
			const raw: any = uni.getStorageSync(NAV_STATE_PREFIX + id)
			if (raw == null || raw === '') {
				continue
			}
			const rec = typeof raw === 'string' ? JSON.parse(raw) as NavStateRecord : raw as NavStateRecord
			const exp = rec != null && (rec as any).expireAt != null ? Number((rec as any).expireAt) : 0
			if (exp > now) {
				next.push(id)
			} else {
				uni.removeStorageSync(NAV_STATE_PREFIX + id)
			}
		} catch (e) {
			try {
				uni.removeStorageSync(NAV_STATE_PREFIX + id)
			} catch (e2) {
			}
		}
	}
	while (next.length > NAV_STATE_MAX_COUNT) {
		const removed = next.shift()
		if (removed != null && removed !== '') {
			try {
				uni.removeStorageSync(NAV_STATE_PREFIX + removed)
			} catch (e) {
			}
		}
	}
	return next
}

export function createNavState(payload: any, ttlMs: number = 5 * 60 * 1000): string {
	const id = buildNavStateId()
	const record: NavStateRecord = {
		payload: payload,
		expireAt: Date.now() + (ttlMs > 0 ? ttlMs : 5 * 60 * 1000)
	}
	try {
		uni.setStorageSync(NAV_STATE_PREFIX + id, JSON.stringify(record))
		const index = loadIndex()
		index.push(id)
		const next = cleanupNavState(index)
		saveIndex(next)
	} catch (e) {
	}
	return id
}

export function consumeNavState(stateId: string): any | null {
	const id = stateId != null ? String(stateId) : ''
	if (id === '') {
		return null
	}
	try {
		const raw: any = uni.getStorageSync(NAV_STATE_PREFIX + id)
		uni.removeStorageSync(NAV_STATE_PREFIX + id)
		const index = loadIndex().filter(v => v !== id)
		saveIndex(index)
		if (raw == null || raw === '') {
			return null
		}
		const rec = typeof raw === 'string' ? JSON.parse(raw) as NavStateRecord : raw as NavStateRecord
		if (rec == null) {
			return null
		}
		const exp = rec.expireAt != null ? Number(rec.expireAt) : 0
		if (exp <= Date.now()) {
			return null
		}
		return rec.payload != null ? rec.payload : null
	} catch (e) {
		return null
	}
}
