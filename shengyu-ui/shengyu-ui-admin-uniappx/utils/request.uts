// 请求工具类
import { getToken, getRefreshToken, setToken, setRefreshToken, setExpiresTime, removeToken, removeRefreshToken, getTenantId, clearAuthInfo } from './auth.uts'
import { refreshToken as refreshTokenApi } from '@/api/auth.uts'
import { handleNetworkError, handleApiError, createUniError, ErrorSubject, ErrorCode } from './errorHandler.uts'
import { apiConfig } from '@/config/apiConfig.uts'

// 是否正在刷新token
let isRefreshing = false
// 等待刷新token的请求队列
let refreshSubscribers: Array<(token: string) => void> = []

// 环境配置
const env = {
  // 基础URL
  baseUrl: 'http://localhost:48080',
  // 接口地址前缀
  apiUrl: '/admin-api',
  // 平台接口地址前缀
  platformApiUrl: '/platform-api'
}

/**
 * 请求配置
 */
interface RequestConfig {
  url: string
  method: 'GET' | 'POST' | 'PUT' | 'DELETE'
  data?: any
  params?: any
  header?: Record<string, string>
  isPlatform?: boolean
  [key: string]: any
}

/**
 * 响应数据
 */
interface ResponseData<T = any> {
  code: number
  message?: string
  msg?: string
  data: T
}

/**
 * 处理刷新token后的请求
 * @param token 新的token
 */
const onRefreshed = (token: string) => {
  refreshSubscribers.forEach(cb => cb(token))
  refreshSubscribers = []
}

/**
 * 添加到刷新队列
 * @param cb 回调函数
 */
const addRefreshSubscriber = (cb: (token: string) => void) => {
  refreshSubscribers.push(cb)
}

/**
 * 构建完整请求URL
 * @param url 请求路径
 * @param isPlatform 是否为平台接口
 * @returns 完整URL
 */
const buildUrl = (url: string, isPlatform: boolean = false): string => {
  // 如果已经是完整URL，直接返回
  if (url.startsWith('http://') || url.startsWith('https://')) {
    return url
  }
  
  // 根据是否为平台接口选择不同的前缀
  const apiPrefix = isPlatform ? env.platformApiUrl : env.apiUrl
  
  // 构建完整URL
  return `${env.baseUrl}${apiPrefix}${url}`
}

/**
 * 请求函数
 * @param config 请求配置
 * @returns 响应数据
 */
const request = <T = any>(config: RequestConfig) => {
  // 构建完整URL
  const fullUrl = buildUrl(config.url, config.isPlatform)
  
  // 确保header对象存在
  const headers = config.header || {}
  
  // 创建请求配置副本
  const requestConfig: any = {
    ...config,
    url: fullUrl,
    method: config.method,
    data: config.data,
    params: config.params,
    header: {
      ...headers,
      'Content-Type': 'application/json'
    }
  }

  // 添加token到请求头
  const token = getToken()
  if (token) {
    requestConfig.header.Authorization = `Bearer ${token}`
  }
  
  // 添加租户ID到请求头
  const tenantId = getTenantId()
  if (tenantId) {
    requestConfig.header['tenant-id'] = tenantId
  }

  // 返回Promise
  return new Promise<ResponseData<T>>((resolve, reject) => {
    uni.request({
      url: requestConfig.url,
      method: requestConfig.method,
      data: requestConfig.data,
      params: requestConfig.params,
      header: requestConfig.header,
      timeout: apiConfig.requestTimeout, // 设置请求超时时间
      success: (res: any) => {
        // 处理响应
        const response = res.data as ResponseData<T>
        
        // 请求成功（后端返回code为0表示成功）
        if (response.code === apiConfig.resultCode) {
          resolve(response)
        } 
        // token过期（后端可能返回的token过期code）
        else if (response.code === 401) {
          // 处理token过期
          handleTokenExpired(requestConfig, resolve, reject)
        } 
        // 其他API错误
        else {
          const uniError = handleApiError(response)
          uni.showToast({
            title: uniError.errMsg,
            icon: 'none'
          })
          reject(new Error(uniError.errMsg))
        }
      },
      fail: (err: any) => {
        const uniError = handleNetworkError(err)
        
        uni.showToast({
          title: uniError.errMsg,
          icon: 'none'
        })
        reject(new Error(uniError.errMsg))
      }
    })
  })
}

/**
 * 处理token过期
 * @param config 请求配置
 * @param resolve 成功回调
 * @param reject 失败回调
 */
const handleTokenExpired = (config: any, resolve: any, reject: any) => {
  if (!isRefreshing) {
    isRefreshing = true
    
    // 获取刷新token
    const refreshToken = getRefreshToken()
    
    if (!refreshToken) {
      // 没有刷新token，需要重新登录
      isRefreshing = false
      handleAuthorized(reject)
      return
    }
    
    // 调用刷新token接口
        refreshTokenApi(refreshToken)
          .then(res => {
            const { accessToken, refreshToken: newRefreshToken, expiresTime } = res.data
            
            // 保存新的token
            setToken(accessToken)
            setRefreshToken(newRefreshToken)
            
            // 保存新的过期时间
            if (expiresTime) {
              setExpiresTime(expiresTime)
            }
            
            // 更新请求头
            if (!config.header) {
              config.header = {}
            }
            config.header.Authorization = `Bearer ${accessToken}`
            
            // 执行队列中的请求
            isRefreshing = false
            onRefreshed(accessToken)
        
        // 重新发送当前请求
        uni.request({
          url: config.url,
          method: config.method,
          data: config.data,
          params: config.params,
          header: config.header,
          success: (res: any) => {
            resolve(res.data)
          },
          fail: (err: any) => {
            reject(err)
          }
        })
      })
      .catch(err => {
        isRefreshing = false
        
        // 刷新token失败，需要重新登录
        handleAuthorized(reject)
      })
  } else {
    // 正在刷新token，将请求加入队列
    addRefreshSubscriber((token: string) => {
      // 更新请求头
      if (!config.header) {
        config.header = {}
      }
      config.header.Authorization = `Bearer ${token}`
      
      // 重新发送请求
      uni.request({
        url: config.url,
        method: config.method,
        data: config.data,
        params: config.params,
        header: config.header,
        success: (res: any) => {
          resolve(res.data)
        },
        fail: (err: any) => {
          reject(err)
        }
      })
    })
  }
}

/**
 * 处理登录过期
 * @param reject 失败回调
 */
const handleAuthorized = (reject: any) => {
  // 弹出登录超时提示
  uni.showModal({
    title: '提示',
    content: apiConfig.timeoutMessage,
    showCancel: true,
    cancelText: '取消',
    confirmText: '重新登录',
    success: (res) => {
      if (res.confirm) {
        // 清除认证信息
        clearAuthInfo()
        // 跳转到登录页
        goToLogin()
      }
      // 无论用户选择什么，都拒绝当前请求
      reject(new Error(apiConfig.timeoutMessage))
    },
    fail: () => {
      reject(new Error(apiConfig.timeoutMessage))
    }
  })
}

/**
 * 跳转到登录页
 */
const goToLogin = () => {
  // 清除token
  removeToken()
  removeRefreshToken()
  
  // 跳转到登录页
  uni.redirectTo({
    url: '/pages/login/login'
  })
}

export default request