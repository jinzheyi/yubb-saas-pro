/**
 * 网络请求封装
 * 严格参考 PC 端实现
 * 兼容 Android、iOS、Web 三端
 */

import { 
	BASE_URL as CONFIG_BASE_URL, 
	API_PREFIX,
	API_BASE_URL,
	TIMEOUT as CONFIG_TIMEOUT, 
	TENANT_ENABLE 
} from '../config/app.config.uts'
import { 
	getAccessToken, 
	getRefreshToken, 
	getTenantId,
	setToken,
	removeToken,
	clearUserCache,
	formatToken
} from '../store/user.uts'

// 请求配置 - 使用统一的 API 配置
const BASE_URL = API_BASE_URL // 移动端使用 app-api 前缀
const TIMEOUT = CONFIG_TIMEOUT

// Token 刷新相关
let isRefreshing = false // 是否正在刷新 Token
let requestQueue: any[] = [] // 请求队列

let accessTokenRefreshedListeners: any[] = []

export function onAccessTokenRefreshed(listener: (tokenData: any) => void): () => void {
	accessTokenRefreshedListeners.push(listener)
	return () => {
		const idx = accessTokenRefreshedListeners.indexOf(listener)
		if (idx !== -1) {
			accessTokenRefreshedListeners.splice(idx, 1)
		}
	}
}

function notifyAccessTokenRefreshed(tokenData: any) {
	try {
		accessTokenRefreshedListeners.forEach((listener) => {
			try {
				listener(tokenData)
			} catch (e) {
				console.warn('[request] onAccessTokenRefreshed listener error:', e)
			}
		})
	} catch (e) {
		console.warn('[request] notifyAccessTokenRefreshed error:', e)
	}
}

function ensureHeader(config: UTSJSONObject): any {
	const existing: any = config['header']
	if (existing != null) {
		try {
			const merged: any = {}
			Object.assign(merged, existing)
			config['header'] = merged
			return merged
		} catch (e) {
			// ignore
		}
	}
	const header: any = {}
	config['header'] = header
	return header
}

function applyAuthHeader(config: UTSJSONObject, token: string) {
	const header = ensureHeader(config)
	const v = formatToken(token)
	// 规范化：避免大小写不同导致在 H5/部分实现中被合并为重复值（"Bearer x, Bearer x"）
	try {
		delete header['Authorization']
		delete header['authorization']
	} catch (e) {
		// ignore
	}
	header['Authorization'] = v
}

function applyTenantHeaderIfNeeded(config: UTSJSONObject) {
	if (TENANT_ENABLE !== 'true') {
		return
	}
	const url = config['url'] as string
	if (url == null) {
		return
	}
	// 检查是否在租户白名单中
	for (let i = 0; i < tenantWhiteList.length; i++) {
		if (url.indexOf(tenantWhiteList[i]) > -1) {
			return
		}
	}
	const tenantId = getTenantId()
	if (tenantId != null && tenantId != '') {
		const header = ensureHeader(config)
		try {
			delete header['tenant-id']
			delete header['Tenant-Id']
			delete header['Tenant-ID']
		} catch (e) {
			// ignore
		}
		header['tenant-id'] = tenantId
	}
}

// 请求白名单，无须 token 的接口
const whiteList: string[] = [
	'/system/captcha/',              // 验证码相关接口
	'/login',                        // 登录接口
	'/refresh-token',                // 刷新 Token 接口
	'/system/tenant/get-id-by-name'  // 获取租户 ID 接口
]

// 租户白名单，无须 tenant-id 的接口（验证码等公共接口）
const tenantWhiteList: string[] = [
	'/system/captcha/',              // 验证码相关接口
	'/login',                        // 登录接口
	'/refresh-token',                // 刷新 Token 接口
	'/system/tenant/get-id-by-name'  // 获取租户 ID 接口
]

/**
 * 请求拦截器
 * 严格参考 PC 端 service.ts 的 request 拦截器
 */
function requestInterceptor(config: UTSJSONObject): UTSJSONObject {
	// 是否需要设置 token
	let isToken = true
	
	// 检查是否在白名单中
	const url = config['url'] as string
	for (let i = 0; i < whiteList.length; i++) {
		if (url.indexOf(whiteList[i]) > -1) {
			isToken = false
			break
		}
	}
	
	// 添加 token
	if (isToken) {
		const token = getAccessToken()
		if (token != null && token != '') {
			applyAuthHeader(config, token)
		}
	}
	
	// 设置租户 ID（严格参考 PC 端逻辑）
	// PC 端代码：if (tenantEnable && tenantEnable === 'true')
	applyTenantHeaderIfNeeded(config)
	
	// 防止 GET 请求缓存（参考 PC 端）
	const method = config['method'] as string
	if (method && method.toUpperCase() === 'GET') {
		const header = ensureHeader(config)
		header['Cache-Control'] = 'no-cache'
		header['Pragma'] = 'no-cache'
	}
	
	// POST 请求设置 Content-Type
	if (method && method.toUpperCase() === 'POST') {
		const header = ensureHeader(config)
		// 如果没有设置 Content-Type，默认使用 application/json
		if (!header['Content-Type'] && !header['content-type']) {
			header['Content-Type'] = 'application/json'
		}
	}
	
	return config
}

/**
 * 响应拦截器
 * 严格参考 PC 端 service.ts 的 response 拦截器
 */
function responseInterceptor(response: any): any {
	let data = response.data
	const config = response.config
	
	if (data === null || data === undefined) {
		throw new Error('响应数据为空')
	}
	if (typeof data === 'string') {
		try {
			data = JSON.parse(data)
		} catch (e) {
			// #ifdef H5
			const raw = (data as string)
			const snippet = raw.length > 200 ? raw.substring(0, 200) : raw
			console.error('[request] JSON.parse 失败，响应片段：', snippet)
			// #endif
			throw new Error('响应不是有效 JSON')
		}
	}
	
	// 二进制数据则直接返回（例如 Excel 导出）
	if (response.request && response.request.responseType === 'arraybuffer') {
		return data
	}
	
	// 成功响应
	if (response.statusCode == 200) {
		// 未设置状态码则默认成功状态
		const code = data.code || 0
		
		// 业务成功（code === 0）
		if (code === 0) {
			return data.data
		}
		// 401 未授权 - Token 过期
		else if (code === 401) {
			return handle401Error(response)
		}
		// 500 服务器错误
		else if (code === 500) {
			uni.showToast({
				title: '服务器错误',
				icon: 'none'
			})
			return Promise.reject(new Error(data.msg || '服务器错误'))
		}
		// 901 演示模式
		else if (code === 901) {
			uni.showToast({
				title: '演示模式，无法操作',
				icon: 'none',
				duration: 3000
			})
			return Promise.reject(new Error(data.msg || '演示模式'))
		}
		// 其他业务错误
		else {
			const msg = data.msg || '请求失败'
			
			// 忽略的错误消息（不显示 Toast）
			const ignoreMsgs = ['无效的刷新令牌', '刷新令牌已过期']
			if (ignoreMsgs.indexOf(msg) === -1) {
				uni.showToast({
					title: msg,
					icon: 'none'
				})
			}
			
			return Promise.reject(data)
		}
	}
	// 401 未授权 - HTTP 状态码
	else if (response.statusCode == 401) {
		return handle401Error(response)
	}
	// 其他 HTTP 错误
	else {
		uni.showToast({
			title: '网络请求失败',
			icon: 'none'
		})
		return Promise.reject(response)
	}
}

/**
 * 处理 401 错误 - Token 刷新机制
 */
async function handle401Error(response: any): Promise<any> {
	const config = response.config
	
	// 如果正在刷新 Token，将请求加入队列
	if (isRefreshing) {
		return new Promise((resolve, reject) => {
			requestQueue.push({
				resolve: resolve,
				reject: reject,
				config: config
			})
		})
	}
	
	// 开始刷新 Token
	isRefreshing = true
	
	// 获取 RefreshToken
	const refreshToken = getRefreshToken()
	
	// 如果没有 RefreshToken，直接跳转登录
	if (refreshToken == null || refreshToken == '') {
		isRefreshing = false
		handleTokenExpired()
		return Promise.reject('Token 已过期')
	}
	
	try {
		// 调用刷新 Token 接口
		const tokenData = await refreshAccessToken()
		
		// 保存新的 Token
		setToken(tokenData)
		notifyAccessTokenRefreshed(tokenData)
		
		// 重试原请求
		const newToken = getAccessToken()
		if (newToken != null && newToken != '') {
			applyAuthHeader(config, newToken)
		}
		applyTenantHeaderIfNeeded(config)
		const retryResponse = await uni.request(config)
		
		// 处理队列中的请求
		requestQueue.forEach(item => {
			if (newToken != null && newToken != '') {
				applyAuthHeader(item.config, newToken)
			}
			applyTenantHeaderIfNeeded(item.config)
			uni.request(item.config).then(res => {
				item.resolve(responseInterceptor(res))
			}).catch(err => {
				item.reject(err)
			})
		})
		
		// 清空队列
		requestQueue = []
		isRefreshing = false
		
		return responseInterceptor(retryResponse)
	} catch (error) {
		// 刷新失败，清空队列并跳转登录
		requestQueue.forEach(item => {
			item.reject(error)
		})
		requestQueue = []
		isRefreshing = false
		
		handleTokenExpired()
		return Promise.reject('Token 刷新失败')
	}
}

/**
 * 刷新访问令牌
 */
async function refreshAccessToken(): Promise<any> {
	const refreshToken = getRefreshToken()
	const tenantId = getTenantId()
	
	return new Promise((resolve, reject) => {
		const header: UTSJSONObject = {}
		if (tenantId != null && tenantId != '') {
			// 租户 ID 已经是字符串，直接使用
			header['tenant-id'] = tenantId
		}
		
		uni.request({
			url: BASE_URL + '/system/auth/refresh-token?refreshToken=' + refreshToken,
			method: 'POST',
			header: header,
			success: (res) => {
				if (res.statusCode == 200 && res.data.code == 0) {
					resolve(res.data.data)
				} else {
					reject(res.data)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * Token 过期处理
 */
function handleTokenExpired() {
	// 获取当前页面路径
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const currentRoute = currentPage ? currentPage.route : ''
	
	// 如果已经在登录页，不显示提示框，直接清除缓存
	if (currentRoute.indexOf('login') > -1) {
		clearUserCache()
		return
	}
	
	// 不在登录页，显示提示框
	uni.showModal({
		title: '提示',
		content: '登录已过期，请重新登录',
		showCancel: false,
		success: (res) => {
			if (res.confirm) {
				// 清除所有用户缓存（会自动跳转到登录页）
				clearUserCache()
			}
		}
	})
}

/**
 * 发起请求
 */
export function request(options: UTSJSONObject): Promise<any> {
	return new Promise((resolve, reject) => {
		// 请求拦截
		const config = requestInterceptor(options)
		
		// 设置完整 URL
		config['url'] = BASE_URL + config['url']
		config['timeout'] = TIMEOUT
		
		// 发起请求
		uni.request({
			...config,
			success: (res) => {
				try {
					const out = responseInterceptor(res)
					if (out && typeof (out as any).then === 'function') {
						;(out as Promise<any>).then(resolve).catch(reject)
					} else {
						resolve(out)
					}
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				uni.showToast({
					title: '网络连接失败',
					icon: 'none'
				})
				reject(err)
			}
		})
	})
}

/**
 * GET 请求
 */
export function get(url: string, params?: UTSJSONObject): Promise<any> {
	return request({
		url: url,
		method: 'GET',
		data: params
	})
}

/**
 * POST 请求
 */
export function post(url: string, data?: UTSJSONObject): Promise<any> {
	return request({
		url: url,
		method: 'POST',
		data: data,
		header: {
			'Content-Type': 'application/json'
		}
	})
}

/**
 * POST 请求（返回完整响应，不解析 data.data）
 * 用于验证码等特殊接口
 */
export function postRaw(url: string, data?: UTSJSONObject): Promise<any> {
	return new Promise((resolve, reject) => {
		// 请求拦截
		const config = requestInterceptor({
			url: url,
			method: 'POST',
			data: data,
			header: {
				'Content-Type': 'application/json'
			}
		})
		
		// 设置完整 URL
		config['url'] = BASE_URL + config['url']
		config['timeout'] = TIMEOUT
		
		// 发起请求
		uni.request({
			...config,
			success: (res) => {
				if (res.statusCode === 200) {
					// 直接返回完整响应数据，不解析 data.data
					resolve(res.data)
				} else {
					reject(res)
				}
			},
			fail: (err) => {
				uni.showToast({
					title: '网络连接失败',
					icon: 'none'
				})
				reject(err)
			}
		})
	})
}

/**
 * Token 管理
 * 从 user.uts 导出，供其他模块使用
 */
export { 
	setToken, 
	getAccessToken as getToken, 
	getRefreshToken, 
	removeToken,
	getTenantId,
	setTenantId
} from '../store/user.uts'
