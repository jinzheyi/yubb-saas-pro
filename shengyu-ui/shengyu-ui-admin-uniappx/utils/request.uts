/**
 * 网络请求封装
 */

// 请求配置
const BASE_URL = 'http://localhost:48080' // 根据实际情况修改
const TIMEOUT = 30000

// Token 存储 key
const TOKEN_KEY = 'ACCESS_TOKEN'
const REFRESH_TOKEN_KEY = 'REFRESH_TOKEN'
const TENANT_ID_KEY = 'TENANT_ID'

// Token 刷新相关
let isRefreshing = false // 是否正在刷新 Token
let requestQueue: any[] = [] // 请求队列

/**
 * 请求拦截器
 */
function requestInterceptor(config: UTSJSONObject): UTSJSONObject {
	// 添加 token
	const token = uni.getStorageSync(TOKEN_KEY)
	if (token != null && token != '') {
		config['header'] = {
			'Authorization': 'Bearer ' + token
		}
	}
	
	// 添加租户ID
	const tenantId = uni.getStorageSync(TENANT_ID_KEY)
	if (tenantId != null && tenantId != '') {
		if (config['header'] == null) {
			config['header'] = {}
		}
		config['header']['tenant-id'] = tenantId
	}
	
	return config
}

/**
 * 响应拦截器
 */
function responseInterceptor(response: any): any {
	const data = response.data
	
	// 成功响应
	if (response.statusCode == 200) {
		// 业务成功
		if (data.code == 0) {
			return data.data
		}
		// 业务失败
		else {
			uni.showToast({
				title: data.msg || '请求失败',
				icon: 'none'
			})
			return Promise.reject(data)
		}
	}
	// 401 未授权 - Token 过期
	else if (response.statusCode == 401) {
		return handle401Error(response)
	}
	// 其他错误
	else {
		uni.showToast({
			title: '网络请求失败',
			icon: 'none'
		})
		return Promise.reject(response)
	}
}

/**
 * 处理 401 错误 - Token 刷新机制
 */
async function handle401Error(response: any): Promise<any> {
	const config = response.config
	
	// 如果正在刷新 Token，将请求加入队列
	if (isRefreshing) {
		return new Promise((resolve, reject) => {
			requestQueue.push({
				resolve: resolve,
				reject: reject,
				config: config
			})
		})
	}
	
	// 开始刷新 Token
	isRefreshing = true
	
	// 获取 RefreshToken
	const refreshToken = uni.getStorageSync(REFRESH_TOKEN_KEY)
	
	// 如果没有 RefreshToken，直接跳转登录
	if (refreshToken == null || refreshToken == '') {
		isRefreshing = false
		handleTokenExpired()
		return Promise.reject('Token 已过期')
	}
	
	try {
		// 调用刷新 Token 接口
		const tokenData = await refreshAccessToken()
		
		// 保存新的 Token
		setToken(tokenData)
		
		// 重试原请求
		config['header']['Authorization'] = 'Bearer ' + uni.getStorageSync(TOKEN_KEY)
		const retryResponse = await uni.request(config)
		
		// 处理队列中的请求
		requestQueue.forEach(item => {
			item.config['header']['Authorization'] = 'Bearer ' + uni.getStorageSync(TOKEN_KEY)
			uni.request(item.config).then(res => {
				item.resolve(responseInterceptor(res))
			}).catch(err => {
				item.reject(err)
			})
		})
		
		// 清空队列
		requestQueue = []
		isRefreshing = false
		
		return responseInterceptor(retryResponse)
	} catch (error) {
		// 刷新失败，清空队列并跳转登录
		requestQueue.forEach(item => {
			item.reject(error)
		})
		requestQueue = []
		isRefreshing = false
		
		handleTokenExpired()
		return Promise.reject('Token 刷新失败')
	}
}

/**
 * 刷新访问令牌
 */
async function refreshAccessToken(): Promise<any> {
	const refreshToken = uni.getStorageSync(REFRESH_TOKEN_KEY)
	const tenantId = uni.getStorageSync(TENANT_ID_KEY)
	
	return new Promise((resolve, reject) => {
		uni.request({
			url: BASE_URL + '/system/auth/refresh-token?refreshToken=' + refreshToken,
			method: 'POST',
			header: {
				'tenant-id': tenantId
			},
			success: (res) => {
				if (res.statusCode == 200 && res.data.code == 0) {
					resolve(res.data.data)
				} else {
					reject(res.data)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * Token 过期处理
 */
function handleTokenExpired() {
	uni.showModal({
		title: '提示',
		content: '登录已过期，请重新登录',
		showCancel: false,
		success: () => {
			// 清除 Token
			removeToken()
			// 跳转到登录页
			uni.reLaunch({
				url: '/pages/login/login'
			})
		}
	})
}

/**
 * 发起请求
 */
export function request(options: UTSJSONObject): Promise<any> {
	return new Promise((resolve, reject) => {
		// 请求拦截
		const config = requestInterceptor(options)
		
		// 设置完整 URL
		config['url'] = BASE_URL + config['url']
		config['timeout'] = TIMEOUT
		
		// 发起请求
		uni.request({
			...config,
			success: (res) => {
				try {
					const data = responseInterceptor(res)
					resolve(data)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				uni.showToast({
					title: '网络连接失败',
					icon: 'none'
				})
				reject(err)
			}
		})
	})
}

/**
 * GET 请求
 */
export function get(url: string, params?: UTSJSONObject): Promise<any> {
	return request({
		url: url,
		method: 'GET',
		data: params
	})
}

/**
 * POST 请求
 */
export function post(url: string, data?: UTSJSONObject): Promise<any> {
	return request({
		url: url,
		method: 'POST',
		data: data,
		header: {
			'Content-Type': 'application/json'
		}
	})
}

/**
 * Token 管理
 */
export function setToken(tokenData: UTSJSONObject) {
	uni.setStorageSync(TOKEN_KEY, tokenData['accessToken'])
	uni.setStorageSync(REFRESH_TOKEN_KEY, tokenData['refreshToken'])
}

export function getToken(): string | null {
	return uni.getStorageSync(TOKEN_KEY)
}

export function getRefreshToken(): string | null {
	return uni.getStorageSync(REFRESH_TOKEN_KEY)
}

export function removeToken() {
	uni.removeStorageSync(TOKEN_KEY)
	uni.removeStorageSync(REFRESH_TOKEN_KEY)
}

export function setTenantId(tenantId: number) {
	uni.setStorageSync(TENANT_ID_KEY, tenantId.toString())
}

export function getTenantId(): string | null {
	return uni.getStorageSync(TENANT_ID_KEY)
}
