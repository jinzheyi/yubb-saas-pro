/**
 * 消息批量加载器
 * 用于管理消息列表的分页拉取和预加载
 */

export interface MessageLoaderOptions {
  pageSize?: number
  preloadThreshold?: number // 预加载阈值(例如：距离顶部还剩多少条时触发)
}

export class MessageLoader {
  private pageSize: number = 20
  private preloadThreshold: number = 5
  
  private isLoading: boolean = false
  private hasMore: boolean = true
  private pageNum: number = 1
  
  constructor(options: MessageLoaderOptions | null = null) {
    if (options !== null) {
      this.pageSize = options.pageSize || 20
      this.preloadThreshold = options.preloadThreshold || 5
    }
  }

  /**
   * 重置加载器状态
   */
  public reset() {
    this.isLoading = false
    this.hasMore = true
    this.pageNum = 1
  }

  /**
   * 加载更多（通常是向历史方向加载）
   * @param fetchFunction 实际抓取数据的回调函数
   */
  public async loadMore<T>(fetchFunction: (pageNum: number, pageSize: number) => Promise<T[]>): Promise<T[]> {
    if (this.isLoading || !this.hasMore) {
      return []
    }
    
    this.isLoading = true
    try {
      const data = await fetchFunction(this.pageNum, this.pageSize)
      
      if (data.length < this.pageSize) {
        this.hasMore = false
      }
      
      this.pageNum++
      return data
    } catch (error) {
      console.error('[MessageLoader] 加载失败:', error)
      return []
    } finally {
      this.isLoading = false
    }
  }

  /**
   * 检查并在需要时触发预加载
   * @param currentTopIndex 当前显示的顶部第一条消息索引
   * @param fetchFunction 拉取数据的回调
   */
  public async preloadNext<T>(currentTopIndex: number, fetchFunction: (pageNum: number, pageSize: number) => Promise<T[]>): Promise<T[] | null> {
    if (currentTopIndex <= this.preloadThreshold && this.hasMore && !this.isLoading) {
      return await this.loadMore(fetchFunction)
    }
    return null
  }

  /**
   * 是否正在加载
   */
  public getIsLoading(): boolean {
    return this.isLoading
  }

  /**
   * 是否还有更多
   */
  public getHasMore(): boolean {
    return this.hasMore
  }
}
