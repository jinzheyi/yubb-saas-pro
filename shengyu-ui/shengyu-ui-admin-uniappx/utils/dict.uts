/**
 * 数据字典工具类
 * 兼容 Android、iOS、Web 三端
 */

/**
 * 字典数据类型
 */
export type DictDataType = {
	dictType: string
	label: string
	value: string | number | boolean
	colorType: string
	cssClass: string
}

/**
 * 数字类型字典数据
 */
export type NumberDictDataType = {
	dictType: string
	label: string
	value: number
	colorType: string
	cssClass: string
}

/**
 * 字符串类型字典数据
 */
export type StringDictDataType = {
	dictType: string
	label: string
	value: string
	colorType: string
	cssClass: string
}

/**
 * 字典存储（使用 uni.getStorageSync/setStorageSync）
 */
class DictStore {
	private static STORAGE_KEY = 'DICT_DATA'
	
	/**
	 * 获取所有字典数据
	 */
	static getAllDict(): Map<string, DictDataType[]> {
		try {
			const data = uni.getStorageSync(this.STORAGE_KEY)
			if (data != null) {
				const jsonData = JSON.parse(data as string)
				const map = new Map<string, DictDataType[]>()
				for (const key in jsonData) {
					map.set(key, jsonData[key])
				}
				return map
			}
		} catch (e) {
			console.error('获取字典数据失败:', e)
		}
		return new Map<string, DictDataType[]>()
	}
	
	/**
	 * 保存所有字典数据
	 */
	static setAllDict(dictMap: Map<string, DictDataType[]>) {
		try {
			const jsonData: UTSJSONObject = {}
			dictMap.forEach((value, key) => {
				jsonData[key] = value
			})
			uni.setStorageSync(this.STORAGE_KEY, JSON.stringify(jsonData))
		} catch (e) {
			console.error('保存字典数据失败:', e)
		}
	}
	
	/**
	 * 根据字典类型获取字典数据
	 */
	static getDictByType(dictType: string): DictDataType[] {
		const allDict = this.getAllDict()
		return allDict.get(dictType) || []
	}
	
	/**
	 * 设置字典数据
	 */
	static setDictByType(dictType: string, dictData: DictDataType[]) {
		const allDict = this.getAllDict()
		allDict.set(dictType, dictData)
		this.setAllDict(allDict)
	}
	
	/**
	 * 清空所有字典数据
	 */
	static clearDict() {
		uni.removeStorageSync(this.STORAGE_KEY)
	}
}

/**
 * 获取 dictType 对应的数据字典数组
 * @param dictType 数据类型
 * @returns 数据字典数组
 */
export function getDictOptions(dictType: string): DictDataType[] {
	return DictStore.getDictByType(dictType)
}

/**
 * 获取整数类型的字典选项
 * @param dictType 字典类型
 * @returns 整数类型字典数组
 */
export function getIntDictOptions(dictType: string): NumberDictDataType[] {
	const dictOptions = getDictOptions(dictType)
	const result: NumberDictDataType[] = []
	
	dictOptions.forEach((dict: DictDataType) => {
		result.push({
			dictType: dict.dictType,
			label: dict.label,
			value: parseInt(dict.value.toString()),
			colorType: dict.colorType,
			cssClass: dict.cssClass
		})
	})
	
	return result
}

/**
 * 获取字符串类型的字典选项
 * @param dictType 字典类型
 * @returns 字符串类型字典数组
 */
export function getStrDictOptions(dictType: string): StringDictDataType[] {
	const dictOptions = getDictOptions(dictType)
	const result: StringDictDataType[] = []
	
	dictOptions.forEach((dict: DictDataType) => {
		result.push({
			dictType: dict.dictType,
			label: dict.label,
			value: dict.value.toString(),
			colorType: dict.colorType,
			cssClass: dict.cssClass
		})
	})
	
	return result
}

/**
 * 获取布尔类型的字典选项
 * @param dictType 字典类型
 * @returns 布尔类型字典数组
 */
export function getBoolDictOptions(dictType: string): DictDataType[] {
	const dictOptions = getDictOptions(dictType)
	const result: DictDataType[] = []
	
	dictOptions.forEach((dict: DictDataType) => {
		result.push({
			dictType: dict.dictType,
			label: dict.label,
			value: dict.value.toString() === 'true',
			colorType: dict.colorType,
			cssClass: dict.cssClass
		})
	})
	
	return result
}

/**
 * 获取指定字典类型的指定值对应的字典对象
 * @param dictType 字典类型
 * @param value 字典值
 * @returns 字典对象
 */
export function getDictObj(dictType: string, value: any): DictDataType | null {
	const dictOptions = getDictOptions(dictType)
	
	for (let i = 0; i < dictOptions.length; i++) {
		const dict = dictOptions[i]
		if (dict.value.toString() === value.toString()) {
			return dict
		}
	}
	
	return null
}

/**
 * 获得字典数据的文本展示
 * @param dictType 字典类型
 * @param value 字典数据的值
 * @returns 字典名称
 */
export function getDictLabel(dictType: string, value: any): string {
	const dictOptions = getDictOptions(dictType)
	
	for (let i = 0; i < dictOptions.length; i++) {
		const dict = dictOptions[i]
		if (dict.value.toString() === value.toString()) {
			return dict.label
		}
	}
	
	return ''
}

/**
 * 设置字典数据（用于从后端加载字典）
 * @param dictType 字典类型
 * @param dictData 字典数据
 */
export function setDictData(dictType: string, dictData: DictDataType[]) {
	DictStore.setDictByType(dictType, dictData)
}

/**
 * 清空所有字典数据
 */
export function clearDictData() {
	DictStore.clearDict()
}

