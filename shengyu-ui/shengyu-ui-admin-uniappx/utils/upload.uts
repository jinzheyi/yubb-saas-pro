/**
 * 文件上传工具类
 * 兼容 Android、iOS、Web 三端
 * 
 * 说明：文件上传统一走移动端代理接口（/app-api），由后端统一处理
 */
import {
	API_BASE_URL,
	MAX_FILE_SIZE,
	MAX_IMAGE_SIZE,
	MAX_VIDEO_SIZE
} from '../config/app.config.uts'
import { getToken, getTenantId } from './request.uts'
import { formatToken } from '../store/user.uts'
import { t } from '../store/locale.uts'

// 上传配置 - 使用统一的 API 配置
const UPLOAD_URL = API_BASE_URL + '/infra/file/upload'
const UPLOAD_AND_RETURN_ID_URL = API_BASE_URL + '/infra/file/upload-and-return-id'

/**
 * 上传进度回调类型
 */
export type UploadProgressCallback = (progress: number) => void

/**
 * 上传结果类型
 */
export type UploadResult = {
	code: number
	msg: string
	data: {
		url: string
		path: string
		name: string
		size: number
		type: string
	}
	tempFilePath?: string  // 临时文件路径
}

/**
 * 上传并返回 fileId 的结果类型
 */
export type UploadAndReturnIdResult = {
	code: number
	msg: string
	data: {
		fileId: number
		url?: string
		name: string
		size: number
		mimeType?: string
		md5?: string
		thumbFileId?: number
	}
	tempFilePath?: string
}

/**
 * 上传配置类型
 */
export type UploadConfig = {
	url?: string           // 上传地址（可选，默认使用 UPLOAD_URL）
	name?: string          // 文件字段名（默认 file）
	directory?: string     // 文件目录
	formData?: UTSJSONObject  // 额外的表单数据
	maxSize?: number       // 最大文件大小（字节）
	showToast?: boolean    // 是否显示错误提示（默认 true）
	onProgress?: UploadProgressCallback  // 进度回调
}

function buildUploadFormData(config: UploadConfig): UTSJSONObject {
	const formData: UTSJSONObject = {}
	if (config.directory) {
		formData['directory'] = config.directory
	}
	if (config.formData) {
		for (const key in config.formData) {
			formData[key] = config.formData[key]
		}
	}
	return formData
}

function buildUploadHeader(): UTSJSONObject {
	const token = getToken()
	const tenantId = getTenantId()
	const header: UTSJSONObject = {}
	if (token != null) {
		header['Authorization'] = formatToken(token)
	}
	if (tenantId != null) {
		header['tenant-id'] = tenantId
	}
	return header
}

/**
 * 格式化文件大小
 */
function formatFileSize(bytes: number): string {
	if (bytes < 1024) {
		return bytes + 'B'
	} else if (bytes < 1024 * 1024) {
		return (bytes / 1024).toFixed(2) + 'KB'
	} else if (bytes < 1024 * 1024 * 1024) {
		return (bytes / 1024 / 1024).toFixed(2) + 'MB'
	} else {
		return (bytes / 1024 / 1024 / 1024).toFixed(2) + 'GB'
	}
}

/**
 * 上传文件（核心方法）
 * @param filePath 文件路径
 * @param config 上传配置
 * @returns Promise<UploadResult>
 */
export function uploadFile(
	filePath: string,
	config?: UploadConfig
): Promise<UploadResult> {
	return new Promise(async (resolve, reject) => {
		// 默认配置
		const uploadConfig: UploadConfig = {
			url: UPLOAD_URL,
			showToast: true,
			...config
		}

		if (uploadConfig.maxSize != null && uploadConfig.maxSize > 0) {
			try {
				const localFileSize = await getLocalFileSize(filePath)
				if (!validateFileSize(localFileSize, uploadConfig.maxSize)) {
					reject(new Error(t('runtime.upload.fileTooLarge', { size: formatFileSize(uploadConfig.maxSize) })))
					return
				}
			} catch (e) {
				// ignore: 文件大小无法探测时，继续由服务端兜底
			}
		}
		
		// 构建表单数据
		const formData = buildUploadFormData(uploadConfig)
		const header = buildUploadHeader()
		
		// 创建上传任务
		const uploadTask = uni.uploadFile({
			url: uploadConfig.url!,
			filePath: filePath,
			name: uploadConfig.name != null && uploadConfig.name !== '' ? uploadConfig.name : 'file',
			formData: formData,
			header: header,
			success: (res) => {
				if (res.statusCode === 200) {
					try {
						const data = JSON.parse(res.data)
						if (data.code === 0) {
							const result = data as UploadResult
							result.tempFilePath = filePath
							resolve(result)
						} else {
							if (uploadConfig.showToast) {
								uni.showToast({
									title: data.msg || t('runtime.upload.uploadFailed'),
									icon: 'none'
								})
							}
							reject(new Error(data.msg || t('runtime.upload.uploadFailed')))
						}
					} catch (e) {
						if (uploadConfig.showToast) {
							uni.showToast({
								title: t('runtime.upload.parseResponseFailed'),
								icon: 'none'
							})
						}
						reject(new Error(t('runtime.upload.parseResponseFailed')))
					}
				} else {
					if (uploadConfig.showToast) {
						uni.showToast({
							title: t('runtime.upload.uploadFailedWithStatus', { statusCode: res.statusCode }),
							icon: 'none'
						})
					}
					reject(new Error(t('runtime.upload.uploadFailedWithStatus', { statusCode: res.statusCode })))
				}
			},
			fail: (err) => {
				if (uploadConfig.showToast) {
					uni.showToast({
						title: t('runtime.upload.uploadFailed'),
						icon: 'none'
					})
				}
				reject(err)
			}
		})
		
		// 监听上传进度
		if (uploadConfig.onProgress) {
			uploadTask.onProgressUpdate((res) => {
				uploadConfig.onProgress!(res.progress)
			})
		}
	})
}

/**
 * 选择图片（不上传）
 * @param count 最多可选择的图片数量（默认 9）
 */
export function chooseImage(count: number = 9): Promise<string[]> {
	return new Promise((resolve, reject) => {
		uni.chooseImage({
			count: count,
			sizeType: ['original', 'compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				resolve(res.tempFilePaths)
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择视频（不上传）
 */
export function chooseVideo(): Promise<any> {
	return new Promise((resolve, reject) => {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			success: (res) => {
				resolve(res)
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

export function formatSeconds(totalSeconds: number): string {
	const s = totalSeconds != null ? Math.max(0, Math.floor(totalSeconds)) : 0
	const m = Math.floor(s / 60)
	const ss = s % 60
	const mmStr = m < 10 ? '0' + m.toString() : m.toString()
	const ssStr = ss < 10 ? '0' + ss.toString() : ss.toString()
	return mmStr + ':' + ssStr
}

export function uploadFileForMulti(
	filePaths: string[],
	config?: UploadConfig
): Promise<UploadResult[]> {
	return new Promise((resolve, reject) => {
		try {
			const paths = Array.isArray(filePaths) ? filePaths : []
			const tasks: Promise<UploadResult>[] = []
			for (let i = 0; i < paths.length; i++) {
				const p = paths[i]
				if (p != null && String(p) !== '') {
					tasks.push(uploadFile(String(p), config))
				}
			}
			Promise.all(tasks).then(resolve).catch(reject)
		} catch (e) {
			reject(e)
		}
	})
}

export function uploadAudio(filePath: string, config?: UploadConfig): Promise<UploadResult> {
	return uploadFile(filePath, config)
}

/**
 * 选择文件（不上传，支持 H5 / App / 小程序）
 */
export function chooseFile(accept: string = '*/*', count: number = 1): Promise<any> {
	return new Promise((resolve, reject) => {
		// #ifdef H5
		uni.chooseFile({
			count: count,
			extension: [accept],
			success: (res) => {
				resolve(res)
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif

		// #ifdef APP-PLUS
		uni.chooseMessageFile({
			count: count,
			type: 'all',
			success: (res) => {
				resolve(res)
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif

		// #ifdef MP-WEIXIN
		uni.chooseMessageFile({
			count: count,
			type: 'all',
			success: (res) => {
				resolve(res)
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
	})
}

/**
 * 上传文件并返回 fileId（核心方法）
 */
export function uploadFileAndReturnId(
	filePath: string,
	config?: UploadConfig
): Promise<UploadAndReturnIdResult> {
	return new Promise((resolve, reject) => {
		// 默认配置
		const uploadConfig: UploadConfig = {
			url: UPLOAD_AND_RETURN_ID_URL,
			showToast: true,
			...config
		}
		
		// 构建表单数据
		const formData = buildUploadFormData(uploadConfig)
		const header = buildUploadHeader()
		
		// 创建上传任务
		const uploadTask = uni.uploadFile({
			url: uploadConfig.url || UPLOAD_AND_RETURN_ID_URL,
			filePath: filePath,
			name: 'file',
			formData: formData,
			header: header,
			success: (res) => {
				if (res.statusCode === 200) {
					try {
						const data = JSON.parse(res.data)
						if (data.code === 0) {
							const result = data as UploadAndReturnIdResult
							result.tempFilePath = filePath
							resolve(result)
							return
						}
						if (uploadConfig.showToast) {
							uni.showToast({
								title: data.msg || t('runtime.upload.uploadFailed'),
								icon: 'none'
							})
						}
						reject(new Error(data.msg || t('runtime.upload.uploadFailed')))
					} catch (e) {
						if (uploadConfig.showToast) {
							uni.showToast({
								title: t('runtime.upload.parseResponseFailed'),
								icon: 'none'
							})
						}
						reject(new Error(t('runtime.upload.parseResponseFailed')))
					}
					return
				}
				let msg = t('runtime.upload.uploadFailedWithStatus', { statusCode: res.statusCode })
				try {
					const data = JSON.parse(res.data)
					if (data && data.msg) {
						msg = data.msg
					}
				} catch (e) {
					// ignore
				}
				if (uploadConfig.showToast) {
					uni.showToast({
						title: msg,
						icon: 'none'
					})
				}
				reject(new Error(msg))
			},
			fail: (err) => {
				if (uploadConfig.showToast) {
					uni.showToast({
						title: t('runtime.upload.uploadFailed'),
						icon: 'none'
					})
				}
				reject(err)
			}
		})
		
		// 监听上传进度
		if (uploadConfig.onProgress) {
			uploadTask.onProgressUpdate((res) => {
				uploadConfig.onProgress!(res.progress)
			})
		}
	})
}

export function uploadBlobAndReturnId(
	blob: any,
	fileName: string,
	config?: UploadConfig
): Promise<UploadAndReturnIdResult> {
	return new Promise((resolve, reject) => {
		const uploadConfig: UploadConfig = {
			url: UPLOAD_AND_RETURN_ID_URL,
			showToast: true,
			...config
		}

		if (blob == null) {
			reject(new Error(t('runtime.upload.emptyFile')))
			return
		}

		const size = Number((blob as any).size || 0)
		const maxSize = uploadConfig.maxSize || MAX_FILE_SIZE
		if (size > 0 && !validateFileSize(size, maxSize)) {
			reject(new Error(t('runtime.upload.fileTooLarge', { size: formatFileSize(maxSize) })))
			return
		}

		// #ifdef H5
		try {
			const form = new FormData()
			const formData = buildUploadFormData(uploadConfig)
			for (const key in formData) {
				const raw = formData[key]
				if (raw != null) {
					form.append(key, String(raw))
				}
			}
			const normalizedFileName = fileName && fileName !== '' ? fileName : `upload-${Date.now()}`
			form.append('file', blob as Blob, normalizedFileName)

			const xhr = new XMLHttpRequest()
			xhr.open('POST', uploadConfig.url || UPLOAD_AND_RETURN_ID_URL, true)
			const header = buildUploadHeader()
			for (const key in header) {
				const value = header[key]
				if (value != null && value !== '') {
					xhr.setRequestHeader(key, String(value))
				}
			}

			if (xhr.upload != null && uploadConfig.onProgress) {
				xhr.upload.onprogress = (event: any) => {
					try {
						if (event != null && event.lengthComputable === true && event.total > 0) {
							const progress = Math.max(0, Math.min(100, Math.round((event.loaded / event.total) * 100)))
							uploadConfig.onProgress!(progress)
						}
					} catch (e) {
						// ignore
					}
				}
			}

			xhr.onload = () => {
				try {
					const status = xhr.status != null ? Number(xhr.status) : 0
					if (status < 200 || status >= 300) {
						let msg = t('runtime.upload.uploadFailed')
						try {
							const errorData = JSON.parse(xhr.responseText || '{}')
							if (errorData && errorData.msg) {
								msg = errorData.msg
							}
						} catch (e) {
							// ignore
						}
						if (uploadConfig.showToast) {
							uni.showToast({ title: msg, icon: 'none' })
						}
						reject(new Error(msg))
						return
					}
					const data = JSON.parse(xhr.responseText || '{}')
					if (data.code === 0) {
						const result = data as UploadAndReturnIdResult
						result.tempFilePath = ''
						resolve(result)
						return
					}
					const msg = data.msg || t('runtime.upload.uploadFailed')
					if (uploadConfig.showToast) {
						uni.showToast({ title: msg, icon: 'none' })
					}
					reject(new Error(msg))
				} catch (e) {
					if (uploadConfig.showToast) {
						uni.showToast({ title: t('runtime.upload.parseResponseFailed'), icon: 'none' })
					}
					reject(new Error(t('runtime.upload.parseResponseFailed')))
				}
			}

			xhr.onerror = () => {
				if (uploadConfig.showToast) {
					uni.showToast({ title: t('runtime.upload.uploadFailed'), icon: 'none' })
				}
				reject(new Error(t('runtime.upload.uploadFailed')))
			}

			xhr.send(form)
			return
		} catch (e) {
			if (uploadConfig.showToast) {
				uni.showToast({ title: t('runtime.upload.browserUploadFailed'), icon: 'none' })
			}
			reject(e)
			return
		}
		// #endif

		reject(new Error(t('runtime.upload.blobUploadUnsupported')))
	})
}

/**
 * 验证文件大小
 */
function validateFileSize(size: number, maxSize: number): boolean {
	if (size > maxSize) {
		uni.showToast({
			title: t('runtime.upload.fileTooLarge', { size: formatFileSize(maxSize) }),
			icon: 'none',
			duration: 2000
		})
		return false
	}
	return true
}

function getLocalFileSize(filePath: string): Promise<number> {
	return new Promise((resolve, reject) => {
		uni.getFileInfo({
			filePath: filePath,
			success: (res) => {
				resolve(res.size != null ? Number(res.size) : 0)
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传图片
 * @param count 最多可选择的图片数量（默认 1）
 * @param config 上传配置（可选）
 * @returns Promise<UploadResult[]>
 */
export function chooseAndUploadImage(
	count: number = 1,
	config?: UploadConfig
): Promise<UploadResult[]> {
	return new Promise((resolve, reject) => {
		uni.chooseImage({
			count: count,
			sizeType: ['original', 'compressed'],
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					const uploadPromises: Promise<UploadResult>[] = []
					
					for (let i = 0; i < res.tempFilePaths.length; i++) {
						const filePath = res.tempFilePaths[i]
						
						// 验证文件大小（如果有 tempFiles 信息）
						if (res.tempFiles && res.tempFiles[i]) {
							const fileSize = res.tempFiles[i].size
							const maxSize = config?.maxSize || MAX_IMAGE_SIZE
							if (!validateFileSize(fileSize, maxSize)) {
								continue
							}
						}
						
						const uploadPromise = uploadFile(filePath, config)
						uploadPromises.push(uploadPromise)
					}
					
					const results = await Promise.all(uploadPromises)
					resolve(results)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传视频
 * @param config 上传配置（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadVideo(
	config?: UploadConfig
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.size) {
						const maxSize = config?.maxSize || MAX_VIDEO_SIZE
						if (!validateFileSize(res.size, maxSize)) {
							reject(new Error('视频文件过大'))
							return
						}
					}
					
					const result = await uploadFile(res.tempFilePath, config)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传文件（支持 H5、Android、iOS）
 * @param accept 接受的文件类型（如 'image/*', '.pdf'）
 * @param config 上传配置（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadFile(
	accept: string = '*/*',
	config?: UploadConfig
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		// #ifdef H5
		uni.chooseFile({
			count: 1,
			extension: [accept],
			success: async (res) => {
				try {
					const result = await uploadFile(res.tempFilePaths[0], config)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
		
		// #ifdef APP-PLUS
		// App 平台使用 chooseMessageFile 选择文件
		uni.chooseMessageFile({
			count: 1,
			type: 'all',  // 'all' | 'video' | 'image' | 'file'
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.tempFiles[0].size) {
						const maxSize = config?.maxSize || MAX_FILE_SIZE
						if (!validateFileSize(res.tempFiles[0].size, maxSize)) {
							reject(new Error('文件过大'))
							return
						}
					}
					
					const result = await uploadFile(res.tempFiles[0].path, config)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
		
		// #ifdef MP-WEIXIN
		// 微信小程序使用 chooseMessageFile
		uni.chooseMessageFile({
			count: 1,
			type: 'all',
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.tempFiles[0].size) {
						const maxSize = config?.maxSize || MAX_FILE_SIZE
						if (!validateFileSize(res.tempFiles[0].size, maxSize)) {
							reject(new Error('文件过大'))
							return
						}
					}
					
					const result = await uploadFile(res.tempFiles[0].path, config)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
	})
}

/**
 * 获取上传 URL
 * @returns 上传 URL
 */
export function getUploadUrl(): string {
	return UPLOAD_URL
}

/**
 * 获取上传请求头
 * @returns 请求头对象
 */
export function getUploadHeader(): UTSJSONObject {
	const header: UTSJSONObject = {}
	
	const token = getToken()
	if (token != null) {
		header['Authorization'] = formatToken(token)
	}
	
	const tenantId = getTenantId()
	if (tenantId != null) {
		header['tenant-id'] = tenantId
	}
	
	return header
}
