/**
 * 文件上传工具类
 * 兼容 Android、iOS、Web 三端
 * 
 * 说明：文件上传统一走移动端代理接口（/app-api），由后端统一处理
 */
import { 
	API_BASE_URL,
	MAX_FILE_SIZE,
	MAX_IMAGE_SIZE,
	MAX_VIDEO_SIZE
} from '../config/app.config.uts'
import { getToken, getTenantId } from './request.uts'
import { formatToken } from '../store/user.uts'

// 上传配置 - 使用统一的 API 配置
const UPLOAD_URL = API_BASE_URL + '/infra/file/upload'

/**
 * 上传进度回调类型
 */
export type UploadProgressCallback = (progress: number) => void

/**
 * 上传结果类型
 */
export type UploadResult = {
	code: number
	msg: string
	data: {
		url: string
		path: string
		name: string
		size: number
		type: string
	}
	tempFilePath?: string  // 临时文件路径
}

/**
 * 上传配置类型
 */
export type UploadConfig = {
	url?: string           // 上传地址（可选，默认使用 UPLOAD_URL）
	directory?: string     // 文件目录
	formData?: UTSJSONObject  // 额外的表单数据
	maxSize?: number       // 最大文件大小（字节）
	showToast?: boolean    // 是否显示错误提示（默认 true）
	onProgress?: UploadProgressCallback  // 进度回调
}

/**
 * 格式化文件大小
 */
function formatFileSize(bytes: number): string {
	if (bytes < 1024) {
		return bytes + 'B'
	} else if (bytes < 1024 * 1024) {
		return (bytes / 1024).toFixed(2) + 'KB'
	} else if (bytes < 1024 * 1024 * 1024) {
		return (bytes / 1024 / 1024).toFixed(2) + 'MB'
	} else {
		return (bytes / 1024 / 1024 / 1024).toFixed(2) + 'GB'
	}
}

/**
 * 上传文件（核心方法）
 * 支持两种调用方式：
 * 1. uploadFile(filePath, config) - 新方式
 * 2. uploadFile(filePath, directory, onProgress) - 旧方式（向后兼容）
 * 
 * @param filePath 文件路径
 * @param configOrDirectory 上传配置对象 或 目录字符串（向后兼容）
 * @param onProgress 进度回调（仅在旧方式下使用）
 * @returns Promise<UploadResult>
 */
export function uploadFile(
	filePath: string,
	configOrDirectory?: UploadConfig | string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		// 兼容旧的调用方式：uploadFile(filePath, directory, onProgress)
		let uploadConfig: UploadConfig
		if (typeof configOrDirectory === 'string') {
			// 旧方式：第二个参数是 directory 字符串
			uploadConfig = {
				url: UPLOAD_URL,
				directory: configOrDirectory,
				onProgress: onProgress,
				showToast: true
			}
		} else {
			// 新方式：第二个参数是配置对象
			uploadConfig = {
				url: UPLOAD_URL,
				showToast: true,
				...configOrDirectory
			}
		}
		
		// 构建表单数据
		const formData: UTSJSONObject = {}
		if (uploadConfig.directory) {
			formData['directory'] = uploadConfig.directory
		}
		// 合并额外的表单数据
		if (uploadConfig.formData) {
			for (const key in uploadConfig.formData) {
				formData[key] = uploadConfig.formData[key]
			}
		}
		
		// 获取 token 和租户 ID
		const token = getToken()
		const tenantId = getTenantId()
		
		// 构建请求头
		const header: UTSJSONObject = {}
		if (token) {
			header['Authorization'] = formatToken(token)
		}
		if (tenantId) {
			header['tenant-id'] = tenantId
		}
		
		// 创建上传任务
		const uploadTask = uni.uploadFile({
			url: uploadConfig.url!,
			filePath: filePath,
			name: 'file',
			formData: formData,
			header: header,
			success: (res) => {
				if (res.statusCode === 200) {
					try {
						const data = JSON.parse(res.data)
						if (data.code === 0) {
							const result = data as UploadResult
							result.tempFilePath = filePath
							resolve(result)
						} else {
							if (uploadConfig.showToast) {
								uni.showToast({
									title: data.msg || '上传失败',
									icon: 'none'
								})
							}
							reject(new Error(data.msg || '上传失败'))
						}
					} catch (e) {
						if (uploadConfig.showToast) {
							uni.showToast({
								title: '解析响应失败',
								icon: 'none'
							})
						}
						reject(new Error('解析响应失败'))
					}
				} else {
					if (uploadConfig.showToast) {
						uni.showToast({
							title: '上传失败，状态码：' + res.statusCode,
							icon: 'none'
						})
					}
					reject(new Error('上传失败，状态码：' + res.statusCode))
				}
			},
			fail: (err) => {
				if (uploadConfig.showToast) {
					uni.showToast({
						title: '上传失败',
						icon: 'none'
					})
				}
				reject(err)
			}
		})
		
		// 监听上传进度
		if (uploadConfig.onProgress) {
			uploadTask.onProgressUpdate((res) => {
				uploadConfig.onProgress!(res.progress)
			})
		}
	})
}

/**
 * 验证文件大小
 */
function validateFileSize(size: number, maxSize: number): boolean {
	if (size > maxSize) {
		uni.showToast({
			title: `文件大小不能超过 ${formatFileSize(maxSize)}`,
			icon: 'none',
			duration: 2000
		})
		return false
	}
	return true
}

/**
 * 选择并上传图片
 * @param count 最多可选择的图片数量（默认 1）
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult[]>
 */
export function chooseAndUploadImage(
	count: number = 1,
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult[]> {
	return new Promise((resolve, reject) => {
		uni.chooseImage({
			count: count,
			sizeType: ['original', 'compressed'],
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					const uploadPromises: Promise<UploadResult>[] = []
					
					for (let i = 0; i < res.tempFilePaths.length; i++) {
						const filePath = res.tempFilePaths[i]
						
						// 验证文件大小（如果有 tempFiles 信息）
						if (res.tempFiles && res.tempFiles[i]) {
							const fileSize = res.tempFiles[i].size
							if (!validateFileSize(fileSize, MAX_IMAGE_SIZE)) {
								continue
							}
						}
						
						const uploadPromise = uploadFile(filePath, {
							directory: directory,
							onProgress: onProgress
						})
						uploadPromises.push(uploadPromise)
					}
					
					const results = await Promise.all(uploadPromises)
					resolve(results)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传视频
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadVideo(
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.size && !validateFileSize(res.size, MAX_VIDEO_SIZE)) {
						reject(new Error('视频文件过大'))
						return
					}
					
					const result = await uploadFile(res.tempFilePath, {
						directory: directory,
						onProgress: onProgress
					})
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传文件（支持 H5、Android、iOS）
 * @param accept 接受的文件类型（如 'image/*', '.pdf'）
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadFile(
	accept: string = '*/*',
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		// #ifdef H5
		uni.chooseFile({
			count: 1,
			extension: [accept],
			success: async (res) => {
				try {
					const result = await uploadFile(res.tempFilePaths[0], {
						directory: directory,
						onProgress: onProgress
					})
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
		
		// #ifdef APP-PLUS
		// App 平台使用 chooseMessageFile 选择文件
		uni.chooseMessageFile({
			count: 1,
			type: 'all',  // 'all' | 'video' | 'image' | 'file'
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.tempFiles[0].size && !validateFileSize(res.tempFiles[0].size, MAX_FILE_SIZE)) {
						reject(new Error('文件过大'))
						return
					}
					
					const result = await uploadFile(res.tempFiles[0].path, {
						directory: directory,
						onProgress: onProgress
					})
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
		
		// #ifdef MP-WEIXIN
		// 微信小程序使用 chooseMessageFile
		uni.chooseMessageFile({
			count: 1,
			type: 'all',
			success: async (res) => {
				try {
					// 验证文件大小
					if (res.tempFiles[0].size && !validateFileSize(res.tempFiles[0].size, MAX_FILE_SIZE)) {
						reject(new Error('文件过大'))
						return
					}
					
					const result = await uploadFile(res.tempFiles[0].path, {
						directory: directory,
						onProgress: onProgress
					})
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
		// #endif
	})
}

/**
 * 获取上传 URL
 * @returns 上传 URL
 */
export function getUploadUrl(): string {
	return UPLOAD_URL
}

/**
 * 获取上传请求头
 * @returns 请求头对象
 */
export function getUploadHeader(): UTSJSONObject {
	const header: UTSJSONObject = {}
	
	const token = getToken()
	if (token) {
		header['Authorization'] = formatToken(token)
	}
	
	const tenantId = getTenantId()
	if (tenantId) {
		header['tenant-id'] = tenantId
	}
	
	return header
}
