/**
 * 文件上传工具类
 * 兼容 Android、iOS、Web 三端
 * 
 * 说明：文件上传统一走平台端接口（/platform-api），由平台控制上传渠道
 */
import { BASE_URL as CONFIG_BASE_URL } from '../config/app.config.uts'
import { getToken, getTenantId } from './request.uts'

// 上传配置 - 使用平台端接口
const UPLOAD_URL = CONFIG_BASE_URL + '/platform-api/infra/file/upload'

/**
 * 上传进度回调类型
 */
export type UploadProgressCallback = (progress: number) => void

/**
 * 上传结果类型
 */
export type UploadResult = {
	code: number
	msg: string
	data: {
		url: string
		path: string
		name: string
		size: number
		type: string
	}
}

/**
 * 上传文件
 * @param filePath 文件路径
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function uploadFile(
	filePath: string,
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		// 构建表单数据
		const formData: UTSJSONObject = {}
		if (directory) {
			formData['directory'] = directory
		}
		
		// 获取 token 和租户 ID
		const token = getToken()
		const tenantId = getTenantId()
		
		// 构建请求头
		const header: UTSJSONObject = {}
		if (token) {
			header['Authorization'] = 'Bearer ' + token
		}
		if (tenantId) {
			header['tenant-id'] = tenantId
		}

		
		// 创建上传任务
		const uploadTask = uni.uploadFile({
			url: UPLOAD_URL,
			filePath: filePath,
			name: 'file',
			formData: formData,
			header: header,
			success: (res) => {
				if (res.statusCode === 200) {
					try {
						const data = JSON.parse(res.data)
						if (data.code === 0) {
							resolve(data as UploadResult)
						} else {
							uni.showToast({
								title: data.msg || '上传失败',
								icon: 'none'
							})
							reject(new Error(data.msg || '上传失败'))
						}
					} catch (e) {
						reject(new Error('解析响应失败'))
					}
				} else {
					reject(new Error('上传失败，状态码：' + res.statusCode))
				}
			},
			fail: (err) => {
				uni.showToast({
					title: '上传失败',
					icon: 'none'
				})
				reject(err)
			}
		})
		
		// 监听上传进度
		if (onProgress) {
			uploadTask.onProgressUpdate((res) => {
				onProgress(res.progress)
			})
		}
	})
}


/**
 * 选择并上传图片
 * @param count 最多可选择的图片数量（默认 1）
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult[]>
 */
export function chooseAndUploadImage(
	count: number = 1,
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult[]> {
	return new Promise((resolve, reject) => {
		uni.chooseImage({
			count: count,
			sizeType: ['original', 'compressed'],
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					const uploadPromises: Promise<UploadResult>[] = []
					
					for (let i = 0; i < res.tempFilePaths.length; i++) {
						const filePath = res.tempFilePaths[i]
						uploadPromises.push(uploadFile(filePath, directory, onProgress))
					}
					
					const results = await Promise.all(uploadPromises)
					resolve(results)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}

/**
 * 选择并上传视频
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadVideo(
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	return new Promise((resolve, reject) => {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			success: async (res) => {
				try {
					const result = await uploadFile(res.tempFilePath, directory, onProgress)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
}


/**
 * 选择并上传文件（仅 H5 支持）
 * @param accept 接受的文件类型（如 'image/*', '.pdf'）
 * @param directory 目录（可选）
 * @param onProgress 进度回调（可选）
 * @returns Promise<UploadResult>
 */
export function chooseAndUploadFile(
	accept: string = '*/*',
	directory?: string,
	onProgress?: UploadProgressCallback
): Promise<UploadResult> {
	// #ifdef H5
	return new Promise((resolve, reject) => {
		uni.chooseFile({
			count: 1,
			extension: [accept],
			success: async (res) => {
				try {
					const result = await uploadFile(res.tempFilePaths[0], directory, onProgress)
					resolve(result)
				} catch (e) {
					reject(e)
				}
			},
			fail: (err) => {
				reject(err)
			}
		})
	})
	// #endif
	
	// #ifndef H5
	return Promise.reject(new Error('当前平台不支持选择文件'))
	// #endif
}

/**
 * 获取上传 URL
 * @returns 上传 URL
 */
export function getUploadUrl(): string {
	return UPLOAD_URL
}

/**
 * 获取上传请求头
 * @returns 请求头对象
 */
export function getUploadHeader(): UTSJSONObject {
	const header: UTSJSONObject = {}
	
	const token = getToken()
	if (token) {
		header['Authorization'] = 'Bearer ' + token
	}
	
	const tenantId = getTenantId()
	if (tenantId) {
		header['tenant-id'] = tenantId
	}
	
	return header
}
