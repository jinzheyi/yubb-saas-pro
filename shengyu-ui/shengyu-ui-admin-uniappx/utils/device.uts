/**
 * 设备管理工具类
 * 提供设备类型识别、设备ID生成等功能
 */

/**
 * 设备类型枚举
 * 与后端 DeviceTypeEnum 保持一致
 */
export enum DeviceType {
	WEB = 1,          // Web浏览器
	IOS = 2,          // iPhone
	ANDROID = 3,      // Android手机
	MINI_PROGRAM = 4, // 微信小程序
	IPAD = 5,         // iPad
	MAC = 6,          // Mac电脑
	WINDOWS = 7       // Windows电脑
}

/**
 * 客户端平台编码
 * 用于升级中心、多端发布、平台差异化能力判断
 */
export enum ClientPlatformCode {
	WEB = 'WEB',
	IOS = 'IOS',
	ANDROID = 'ANDROID',
	HARMONY = 'HARMONY',
	MINI_PROGRAM = 'MINI_PROGRAM'
}

export type ClientPlatformInfo = {
	platformCode: string
	osName: string
	osVersion: string
	harmonyApiVersion: number | null
	harmonyDisplayVersion: string
	deviceBrand: string
	deviceModel: string
}

function getDeviceRuntimeInfo(): any {
	try {
		const anyUni = uni as any
		if (typeof anyUni.getDeviceInfo === 'function') {
			return anyUni.getDeviceInfo()
		}
		return uni.getSystemInfoSync()
	} catch (e) {
		return null
	}
}

function isHarmonyRuntime(info: any): boolean {
	if (info == null) {
		return false
	}
	const platform = String(info.platform || '').toLowerCase()
	const osName = String(info.osName || '').toLowerCase()
	return platform === 'harmonyos' || osName === 'harmonyos'
}

/**
 * 获取当前设备类型
 * 根据运行平台返回对应的设备类型
 */
export function getCurrentDeviceType(): number {
	// #ifdef APP-PLUS || APP-HARMONY
	const systemInfo = getDeviceRuntimeInfo()
	const platform = String(systemInfo?.platform || '').toLowerCase()
	
	if (platform === 'ios') {
		// 判断是否为 iPad
		const model = systemInfo?.model || systemInfo?.deviceModel
		if (model != null && model.indexOf('iPad') > -1) {
			return DeviceType.IPAD
		}
		return DeviceType.IOS
	} else if (platform === 'android' || platform === 'harmonyos' || isHarmonyRuntime(systemInfo)) {
		// 当前后端 DeviceTypeEnum 尚未拆出 Harmony 终端枚举，客户端先按移动端归为 Android 类别。
		return DeviceType.ANDROID
	}
	// #endif
	
	// #ifdef H5
	return DeviceType.WEB
	// #endif
	
	// #ifdef MP-WEIXIN
	return DeviceType.MINI_PROGRAM
	// #endif
	
	// 默认返回 Web
	return DeviceType.WEB
}

/**
 * 获取设备类型名称
 */
export function getDeviceTypeName(deviceType: number): string {
	switch (deviceType) {
		case DeviceType.WEB:
			return 'Web浏览器'
		case DeviceType.IOS:
			return 'iPhone'
		case DeviceType.ANDROID:
			return 'Android手机'
		case DeviceType.MINI_PROGRAM:
			return '微信小程序'
		case DeviceType.IPAD:
			return 'iPad'
		case DeviceType.MAC:
			return 'Mac电脑'
		case DeviceType.WINDOWS:
			return 'Windows电脑'
		default:
			return '未知设备'
	}
}

export function getCurrentClientPlatform(): string {
	// #ifdef APP-PLUS || APP-HARMONY
	const systemInfo = getDeviceRuntimeInfo()
	if (isHarmonyRuntime(systemInfo)) {
		return ClientPlatformCode.HARMONY
	}
	const platform = String(systemInfo?.platform || '').toLowerCase()
	if (platform === 'ios') {
		return ClientPlatformCode.IOS
	}
	if (platform === 'android') {
		return ClientPlatformCode.ANDROID
	}
	// #endif

	// #ifdef H5
	return ClientPlatformCode.WEB
	// #endif

	// #ifdef MP-WEIXIN
	return ClientPlatformCode.MINI_PROGRAM
	// #endif

	return ClientPlatformCode.WEB
}

export function isHarmonyOS(): boolean {
	return getCurrentClientPlatform() === ClientPlatformCode.HARMONY
}

export function getClientPlatformInfo(): ClientPlatformInfo {
	const deviceInfo = getDeviceRuntimeInfo()
	return {
		platformCode: getCurrentClientPlatform(),
		osName: String(deviceInfo?.osName || deviceInfo?.platform || ''),
		osVersion: String(deviceInfo?.osVersion || deviceInfo?.system || ''),
		harmonyApiVersion: typeof deviceInfo?.osHarmonySDKAPIVersion === 'number' ? deviceInfo.osHarmonySDKAPIVersion as number : null,
		harmonyDisplayVersion: String(deviceInfo?.osHarmonyDisplayVersion || ''),
		deviceBrand: String(deviceInfo?.deviceBrand || deviceInfo?.brand || ''),
		deviceModel: String(deviceInfo?.deviceModel || deviceInfo?.model || '')
	}
}

/**
 * 获取设备唯一标识
 * 优先从本地存储获取，如果不存在则生成新的设备ID
 */
export function getDeviceId(): string {
	// 优先从本地存储获取
	const deviceId = uni.getStorageSync('deviceId')
	if (deviceId != null && deviceId != '') {
		return deviceId as string
	}
	
	// 生成新的设备ID
	const newDeviceId = generateDeviceId()
	uni.setStorageSync('deviceId', newDeviceId)
	return newDeviceId
}

/**
 * 生成设备ID
 * 格式: 时间戳-随机字符串
 */
function generateDeviceId(): string {
	const timestamp = Date.now()
	const random = Math.random().toString(36).substring(2, 15)
	return `${timestamp}-${random}`
}

/**
 * 获取应用版本号
 */
export function getAppVersion(): string {
	// #ifdef APP-PLUS || APP-HARMONY
	const systemInfo = getDeviceRuntimeInfo()
	const appVersion = systemInfo?.appVersion
	if (appVersion != null && appVersion != '') {
		return appVersion as string
	}
	// #endif
	
	// #ifdef H5
	return '1.0.0'
	// #endif
	
	// #ifdef MP-WEIXIN
	const systemInfo = uni.getSystemInfoSync()
	const version = systemInfo.version
	if (version != null && version != '') {
		return version as string
	}
	// #endif
	
	return '1.0.0'
}

export function getAppVersionCode(): number {
	// #ifdef APP-PLUS || APP-HARMONY
	const systemInfo = getDeviceRuntimeInfo()
	const rawVersionCode = systemInfo?.appVersionCode || systemInfo?.versionCode
	if (rawVersionCode != null && rawVersionCode !== '') {
		const parsed = Number(rawVersionCode)
		if (!isNaN(parsed) && parsed > 0) {
			return parsed
		}
	}
	// #endif

	const version = getAppVersion()
	if (!version) {
		return 1
	}
	const parts = version.split('.')
	let major = 0
	let minor = 0
	let patch = 0
	if (parts.length > 0) {
		major = Number(parts[0]) || 0
	}
	if (parts.length > 1) {
		minor = Number(parts[1]) || 0
	}
	if (parts.length > 2) {
		patch = Number(parts[2]) || 0
	}
	const code = major * 10000 + minor * 100 + patch
	return code > 0 ? code : 1
}

export function getDeviceName(): string {
	// #ifdef APP-PLUS || APP-HARMONY
	try {
		const systemInfo = getDeviceRuntimeInfo()
		const brand = (systemInfo as any).deviceBrand || (systemInfo as any).brand
		const model = (systemInfo as any).deviceModel || (systemInfo as any).model
		if (brand != null && brand !== '' && model != null && model !== '') {
			return `${brand} ${model}`
		}
		if (model != null && model !== '') {
			return model as string
		}
	} catch (e) {
		// ignore
	}
	// #endif

	// #ifdef H5
	try {
		const ua = (typeof navigator !== 'undefined' && navigator.userAgent) ? navigator.userAgent : ''
		const l = ua.toLowerCase()
		if (l.indexOf('edg') > -1) {
			return 'Edge浏览器'
		}
		if (l.indexOf('chrome') > -1 && l.indexOf('safari') > -1) {
			return 'Chrome浏览器'
		}
		if (l.indexOf('safari') > -1 && l.indexOf('chrome') === -1) {
			return 'Safari浏览器'
		}
		if (l.indexOf('firefox') > -1) {
			return 'Firefox浏览器'
		}
		return 'Web浏览器'
	} catch (e) {
		return 'Web浏览器'
	}
	// #endif

	// #ifdef MP-WEIXIN
	return '微信小程序'
	// #endif

	return getDeviceTypeName(getCurrentDeviceType())
}

/**
 * 获取设备信息对象
 * 包含设备类型、设备ID、应用版本等信息
 */
export type DeviceInfo = {
	deviceType: number
	deviceId: string
	clientVersion: string
}

/**
 * 获取完整的设备信息
 */
export function getDeviceInfo(): DeviceInfo {
	return {
		deviceType: getCurrentDeviceType(),
		deviceId: getDeviceId(),
		clientVersion: getAppVersion()
	}
}

/**
 * 判断是否为移动端
 */
export function isMobile(): boolean {
	const platform = getCurrentClientPlatform()
	return platform === ClientPlatformCode.IOS
		|| platform === ClientPlatformCode.ANDROID
		|| platform === ClientPlatformCode.HARMONY
}

/**
 * 判断是否为PC端
 */
export function isPC(): boolean {
	const deviceType = getCurrentDeviceType()
	return deviceType === DeviceType.MAC || deviceType === DeviceType.WINDOWS || deviceType === DeviceType.WEB
}

/**
 * 判断是否为平板端
 */
export function isTablet(): boolean {
	const deviceType = getCurrentDeviceType()
	return deviceType === DeviceType.IPAD
}
