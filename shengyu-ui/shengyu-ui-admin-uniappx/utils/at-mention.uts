/**
 * @提醒工具
 * 
 * 功能:
 * 1. 解析@提醒
 * 2. 构建@提醒消息
 * 3. 高亮显示@的用户
 * 4. @所有人功能
 */

/**
 * @提醒信息
 */
export type AtMention = {
  userId: string
  userName: string
  startIndex: number
  endIndex: number
}

/**
 * 解析文本中的@提醒
 * 
 * @param text 文本内容
 * @returns @提醒列表
 */
export function parseAtMentions(text: string): AtMention[] {
  const mentions: AtMention[] = []
  
  // 匹配 @用户名 格式（支持中文、英文、数字、下划线）
  const regex = /@([\u4e00-\u9fa5a-zA-Z0-9_]+)/g
  let match: RegExpExecArray | null
  
  while ((match = regex.exec(text)) !== null) {
    mentions.push({
      userId: '0',  // 需要从用户列表中查找
      userName: match[1],
      startIndex: match.index,
      endIndex: match.index + match[0].length
    })
  }
  
  return mentions
}

/**
 * 提取@的用户ID列表
 * 
 * @param text 文本内容
 * @param userMap 用户名到用户ID的映射
 * @returns 用户ID列表
 */
export function extractAtUserIds(text: string, userMap: Map<string, string>): string[] {
  const mentions = parseAtMentions(text)
  const userIds: string[] = []
  
  mentions.forEach(mention => {
    // 检查是否是@所有人
    if (mention.userName === '所有人' || mention.userName === 'all') {
      userIds.push('-1')  // -1 表示@所有人
      return
    }
    
    // 从映射中查找用户ID
    const userId = userMap.get(mention.userName)
    if (userId !== null && !userIds.includes(userId)) {
      userIds.push(userId)
    }
  })
  
  return userIds
}

/**
 * 在文本中插入@提醒
 * 
 * @param text 当前文本
 * @param cursorPosition 光标位置
 * @param userName 要@的用户名
 * @returns 新文本和新光标位置
 */
export function insertAtMention(
  text: string,
  cursorPosition: number,
  userName: string
): { text: string, cursorPosition: number } {
  const atText = '@' + userName + ' '
  const newText = text.substring(0, cursorPosition) + atText + text.substring(cursorPosition)
  const newCursorPosition = cursorPosition + atText.length
  
  return {
    text: newText,
    cursorPosition: newCursorPosition
  }
}

/**
 * 检查文本是否包含@所有人
 * 
 * @param text 文本内容
 * @returns 是否包含@所有人
 */
export function containsAtAll(text: string): boolean {
  return text.includes('@所有人') || text.includes('@all')
}

/**
 * 检查文本是否包含@我
 * 
 * @param text 文本内容
 * @param myUserId 当前用户ID
 * @param atUserIds @的用户ID列表
 * @returns 是否包含@我
 */
export function containsAtMe(text: string, myUserId: string, atUserIds: string[]): boolean {
  // 检查是否@所有人
  if (atUserIds.includes('-1')) {
    return true
  }
  
  // 检查是否@了我
  return atUserIds.includes(myUserId)
}

/**
 * 高亮显示@的用户名
 * 
 * @param text 文本内容
 * @returns 带高亮标记的文本片段数组
 */
export type TextSegment = {
  type: 'text' | 'mention'
  content: string
}

export function highlightAtMentions(text: string): TextSegment[] {
  const segments: TextSegment[] = []
  const mentions = parseAtMentions(text)
  
  if (mentions.length === 0) {
    segments.push({ type: 'text', content: text })
    return segments
  }
  
  let lastIndex = 0
  
  mentions.forEach(mention => {
    // 添加@之前的普通文本
    if (mention.startIndex > lastIndex) {
      segments.push({
        type: 'text',
        content: text.substring(lastIndex, mention.startIndex)
      })
    }
    
    // 添加@提醒文本
    segments.push({
      type: 'mention',
      content: text.substring(mention.startIndex, mention.endIndex)
    })
    
    lastIndex = mention.endIndex
  })
  
  // 添加最后的普通文本
  if (lastIndex < text.length) {
    segments.push({
      type: 'text',
      content: text.substring(lastIndex)
    })
  }
  
  return segments
}

/**
 * 获取会话列表中的@提醒标识
 * 
 * @param atUserIds @的用户ID列表
 * @param myUserId 当前用户ID
 * @returns @提醒标识文本
 */
export function getAtMentionLabel(atUserIds: string[], myUserId: string): string {
  if (atUserIds.length === 0) {
    return ''
  }
  
  // 检查是否@所有人
  if (atUserIds.includes('-1')) {
    return '[有人@我]'
  }
  
  // 检查是否@了我
  if (atUserIds.includes(myUserId)) {
    return '[有人@我]'
  }
  
  return ''
}

/**
 * 验证用户是否有权限@所有人
 * 
 * @param isGroupOwner 是否是群主
 * @param isGroupAdmin 是否是管理员
 * @returns 是否有权限
 */
export function canAtAll(isGroupOwner: boolean, isGroupAdmin: boolean): boolean {
  return isGroupOwner || isGroupAdmin
}

/**
 * 构建@所有人的用户ID列表
 * 
 * @param groupMemberIds 群成员ID列表
 * @returns 用户ID列表（包含-1表示@所有人）
 */
export function buildAtAllUserIds(groupMemberIds: number[]): number[] {
  // 返回 -1 表示@所有人，后端会自动展开为所有群成员
  return [-1]
}

/**
 * 过滤@提醒消息（用于消息搜索）
 * 
 * @param messages 消息列表
 * @param myUserId 当前用户ID
 * @returns 包含@我的消息列表
 */
export function filterAtMeMessages(messages: any[], myUserId: string): any[] {
  return messages.filter(msg => {
    if (msg.type !== 'text') {
      return false
    }
    
    const atUserIds = msg.atUserIds || []
    return containsAtMe(msg.content, myUserId, atUserIds)
  })
}
