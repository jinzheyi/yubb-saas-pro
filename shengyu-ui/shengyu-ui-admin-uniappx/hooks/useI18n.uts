/**
 * 国际化组合式函数
 * 用于在组件中使用国际化功能
 * 兼容 Android、iOS、Web 三端
 */

import { 
	getCurrentLocale, 
	setCurrentLocale, 
	getLanguageMode,
	getAvailableLocales,
	getCurrentMessages,
	subscribeLocaleChange,
	t as translate,
	switchLocale as switchLang,
	type LocaleType,
	type LocaleConfig
} from '../store/locale.uts'
import { onUnmounted } from 'vue'

/**
 * 国际化组合式函数
 * @returns 国际化相关方法和状态
 */
export function useI18n() {
	/**
	 * 获取当前语言
	 * @returns 当前语言类型
	 */
	const locale = ref<LocaleType>(getCurrentLocale())
	
	/**
	 * 获取可用语言列表
	 * @returns 语言配置列表
	 */
	const availableLocales = ref<LocaleConfig[]>(getAvailableLocales())
	let unsubscribeLocale: (() => void) | null = subscribeLocaleChange((nextLocale, _languageMode) => {
		locale.value = nextLocale
	})
	
	/**
	 * 获取当前语言包（响应式）
	 * @returns 语言包对象
	 */
	const messages = computed(() => {
		// 依赖 locale.value 确保响应式更新
		const currentLocale = locale.value
		return getCurrentMessages()
	})
	
	/**
	 * 翻译函数（响应式）
	 * @param key 翻译键
	 * @param params 参数对象或默认值
	 * @returns 翻译后的文本
	 */
	const t = (key: string, params?: any): string => {
		// 依赖 locale.value 确保响应式更新
		const currentLocale = locale.value
		return translate(key, params)
	}
	
	/**
	 * 切换语言
	 * @param newLocale 新语言类型
	 */
	const switchLocale = (newLocale: LocaleType) => {
		setCurrentLocale(newLocale)
		locale.value = newLocale
		
		// 提示用户
		uni.showToast({
			title: translate('common.switchSuccess'),
			icon: 'success'
		})
	}
	
	/**
	 * 设置语言
	 * @param newLocale 新语言类型
	 */
	const setLocale = (newLocale: LocaleType) => {
		setCurrentLocale(newLocale)
		locale.value = newLocale
	}

	onUnmounted(() => {
		if (unsubscribeLocale != null) {
			unsubscribeLocale()
			unsubscribeLocale = null
		}
	})
	
	return {
		t,
		locale,
		languageMode: computed(() => getLanguageMode()),
		availableLocales,
		messages,
		switchLocale,
		setLocale
	}
}
