<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>

		<view class="header" :style="{ backgroundColor: theme.headerBg }">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">返回</text>
			</view>
			<view class="header-title-wrap">
				<text class="header-title" :style="{ color: theme.headerText }">选择会话</text>
			</view>
			<view class="header-right"></view>
		</view>

		<view class="search-container" :style="{ backgroundColor: theme.cardBg }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" v-model="keyword" placeholder="搜索" placeholder-class="placeholder" />
			</view>
		</view>

		<view v-if="messageCountText != ''" class="summary" :style="{ backgroundColor: theme.cardBg }">
			<text class="summary-text" :style="{ color: theme.textSecondary }">{{ summaryTextPrefix }} {{ messageCountText }} {{ summaryTextSuffix }}</text>
		</view>

		<view v-if="showForwardType" class="forward-type" :style="{ backgroundColor: theme.cardBg }">
			<view class="forward-type-item" :style="{ backgroundColor: forwardType === 1 ? theme.brandPrimarySoft : theme.cardBgMuted }" :class="{ 'forward-type-active': forwardType === 1 }" @click="setForwardTypeSingle">
				<text class="forward-type-text" :style="{ color: forwardType === 1 ? theme.brandPrimary : theme.textSecondary }">逐条转发</text>
			</view>
			<view class="forward-type-item" :style="{ backgroundColor: forwardType === 2 ? theme.brandPrimarySoft : theme.cardBgMuted }" :class="{ 'forward-type-active': forwardType === 2 }" @click="setForwardTypeCombine">
				<text class="forward-type-text" :style="{ color: forwardType === 2 ? theme.brandPrimary : theme.textSecondary }">合并转发</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="conv-list">
				<view
					v-for="item in filteredConversations"
					:key="item.chatId"
					class="conv-item"
					:style="{ backgroundColor: theme.cardBg }"
					hover-class="conv-item-active"
					@click="handleSelect(item.chatId)"
				>
					<view class="conv-avatar" :style="{ backgroundColor: item.avatarBg }">
						<image
							v-if="shouldShowConversationAvatar(item)"
							class="conv-avatar-image"
							:src="item.targetAvatar"
							mode="aspectFill"
							@error="handleConversationAvatarError(item)"
						/>
						<text v-else-if="item.conversationType === 2" class="iconfont conv-avatar-icon">&#xe616;</text>
						<text v-else class="conv-avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="conv-body">
						<text class="conv-name" :style="{ color: theme.textPrimary }">{{ item.targetName }}</text>
						<text class="conv-desc" :style="{ color: theme.textSecondary }">{{ item.lastMessageContent }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
import { conversationService, ConversationItem } from '../../services/conversation-service.uts'
import { forwardMessages as forwardMessagesApi } from '../../api/message.uts'
import { resendFavorite as resendFavoriteApi } from '../../api/favorite.uts'
import { encodeIdParam } from '../../utils/id-param.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import type { ThemeTokens } from '../../config/theme.uts'

const keyword = ref('')

const messageIds = ref<string[]>([])
const favoriteId = ref<string>('')
const forwardType = ref<number>(1)

const MAX_FORWARD_MESSAGE_COUNT = 50

const conversations = ref<ConversationItem[]>([])
const theme = ref<ThemeTokens>(getThemeTokens())
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
	theme.value = tokens
})

const filteredConversations = computed(() => {
	const kw = keyword.value != null ? keyword.value.trim() : ''
	if (kw === '') {
		return conversations.value
	}
	return conversations.value.filter(c => {
		const name = c != null && c.targetName != null ? String(c.targetName) : ''
		return name.indexOf(kw) > -1
	})
})

const messageCountText = computed(() => {
	if (favoriteId.value !== '' && favoriteId.value !== '0') {
		return '1 条消息'
	}
	const count = messageIds.value != null ? messageIds.value.length : 0
	return count > 0 ? count.toString() + ' 条消息' : ''
})

const summaryTextPrefix = computed(() => {
	return favoriteId.value !== '' && favoriteId.value !== '0' ? '将发送' : '将转发'
})

const summaryTextSuffix = computed(() => {
	return '到'
})

const showForwardType = computed(() => {
	if (favoriteId.value !== '' && favoriteId.value !== '0') {
		return false
	}
	const count = messageIds.value != null ? messageIds.value.length : 0
	return count > 1
})

function setForwardTypeSingle(): void {
	forwardType.value = 1
}

function setForwardTypeCombine(): void {
	forwardType.value = 2
}

function handleBack(): void {
	uni.navigateBack()
}

function parseMessageIds(value: string | null): string[] {
	if (value == null) {
		return []
	}
	const s = value.trim()
	if (s === '') {
		return []
	}
	const parts = s.split(',')
	const dedupe = new Set<string>()
	const ids: string[] = []
	for (let i = 0; i < parts.length; i++) {
		const p = parts[i] != null ? parts[i].trim() : ''
		if (p !== '' && p !== '0' && !dedupe.has(p)) {
			dedupe.add(p)
			ids.push(p)
		}
	}
	return ids
}

function loadConversationList(): void {
	try {
		conversations.value = conversationService.getConversations()
		if (conversations.value == null || conversations.value.length === 0) {
			void conversationService.loadConversations().then(() => {
				conversations.value = conversationService.getConversations()
			})
		}
	} catch (e) {
		conversations.value = []
	}
}

function normalizeAvatarUrl(raw: any): string {
	if (raw == null) {
		return ''
	}
	const text = String(raw).trim()
	return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
}

function shouldShowConversationAvatar(item: any): boolean {
	return normalizeAvatarUrl(item != null ? item.targetAvatar : '') !== '' && item.avatarError !== true
}

function handleConversationAvatarError(item: any): void {
	if (item == null) {
		return
	}
	item.avatarError = true
}

async function handleSelect(targetChatId: string): Promise<void> {
	const ids = messageIds.value != null ? messageIds.value : []
	const isFavoriteMode = favoriteId.value !== '' && favoriteId.value !== '0'
	if (targetChatId == null || targetChatId === '' || (!isFavoriteMode && ids.length === 0)) {
		uni.showToast({ title: '参数错误', icon: 'none' })
		return
	}
	if (!isFavoriteMode && ids.length > MAX_FORWARD_MESSAGE_COUNT) {
		uni.showToast({ title: `最多选择 ${MAX_FORWARD_MESSAGE_COUNT} 条消息`, icon: 'none' })
		return
	}
	try {
		uni.showLoading({ title: '发送中...' })
		if (isFavoriteMode) {
			await resendFavoriteApi(favoriteId.value, targetChatId)
			uni.hideLoading()
			uni.showToast({ title: '已发送', icon: 'success' })
			const chatIdParam = encodeIdParam(targetChatId)
			uni.redirectTo({
				url: `/pages/message/chat?chatId=${chatIdParam}&entryMode=latest`
			})
			return
		}
		const result: any = await forwardMessagesApi(targetChatId, ids, forwardType.value)
		uni.hideLoading()
		let successCount = ids.length
		if (Array.isArray(result)) {
			successCount = result.length
		} else if (result != null && Array.isArray((result as any).messageIds)) {
			successCount = (result as any).messageIds.length
		}
		const expectedCount = forwardType.value === 2 ? 1 : ids.length
		if (successCount <= 0) {
			uni.showToast({ title: '转发失败', icon: 'none' })
			return
		}
		if (successCount < expectedCount) {
			uni.showToast({ title: `部分成功 ${successCount}/${expectedCount}`, icon: 'none' })
		} else {
			uni.showToast({ title: '已转发', icon: 'success' })
		}
		const conv = conversationService.getConversation(targetChatId)
		if (conv != null) {
			const chatIdParam = encodeIdParam(targetChatId)
			uni.redirectTo({
				url: `/pages/message/chat?chatId=${chatIdParam}&entryMode=latest`
			})
			return
		}
		const chatIdParam = encodeIdParam(targetChatId)
		uni.redirectTo({
			url: `/pages/message/chat?chatId=${chatIdParam}&entryMode=latest`
		})
	} catch (e) {
		uni.hideLoading()
		uni.showToast({ title: '转发失败', icon: 'none' })
	}
}

onLoad((options: any) => {
	try {
		const fid = options != null ? (options['favoriteId'] as string | null) : null
		favoriteId.value = fid != null ? String(fid) : ''
		const ids = options != null ? (options['messageIds'] as string | null) : null
		messageIds.value = parseMessageIds(ids)
		if (favoriteId.value === '' && messageIds.value.length > MAX_FORWARD_MESSAGE_COUNT) {
			uni.showToast({ title: `最多选择 ${MAX_FORWARD_MESSAGE_COUNT} 条消息`, icon: 'none' })
			messageIds.value = []
			setTimeout(() => {
				uni.navigateBack()
			}, 200)
			return
		}
		if (favoriteId.value === '') {
			const t = options != null ? (options['forwardType'] as string | null) : null
			if (t != null && t !== '') {
				const n = Number(t)
				forwardType.value = n === 2 ? 2 : 1
			}
		}
	} catch (e) {
		messageIds.value = []
		favoriteId.value = ''
	}
	loadConversationList()
})

onShow(() => {
	loadConversationList()
})

onUnload(() => {
	if (unsubscribeTheme != null) {
		unsubscribeTheme()
		unsubscribeTheme = null
	}
})
</script>

<style scoped>
.page {
	flex: 1;
	display: flex;
	flex-direction: column;
	background-color: #f7f8fa;
}

.status-bar {
	height: 0px;
}

.header {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 12px;
}

.header-left {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.back-icon {
	font-size: 18px;
}

.back-text {
	margin-left: 6px;
	font-size: 14px;
}

.header-title-wrap {
	flex: 1;
	display: flex;
	flex-direction: row;
	justify-content: center;
}

.header-title {
	font-size: 16px;
	font-weight: 600;
}

.header-right {
	width: 40px;
}

.search-container {
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 10px;
	padding-bottom: 10px;
}

.search-bar {
	height: 36px;
	display: flex;
	flex-direction: row;
	align-items: center;
	border-radius: 8px;
	padding-left: 10px;
	padding-right: 10px;
}

.search-icon {
	font-size: 16px;
}

.search-input {
	flex: 1;
	margin-left: 6px;
	font-size: 14px;
}

.summary {
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 8px;
	padding-bottom: 8px;
}

.summary-text {
	font-size: 12px;
}

.forward-type {
	display: flex;
	flex-direction: row;
	padding-left: 12px;
	padding-right: 12px;
	padding-bottom: 10px;
}

.forward-type-item {
	flex: 1;
	height: 34px;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	border-radius: 8px;
}

.forward-type-item + .forward-type-item {
	margin-left: 10px;
}

.forward-type-active {
	background-color: rgba(51, 112, 255, 0.14);
}

.forward-type-text {
	font-size: 13px;
}

.content {
	flex: 1;
}

.conv-list {
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 10px;
}

.conv-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	border-radius: 10px;
	padding-left: 12px;
	padding-right: 12px;
	padding-top: 10px;
	padding-bottom: 10px;
	margin-bottom: 10px;
}

.conv-item-active {
	background-color: rgba(143, 149, 158, 0.12);
}

.conv-avatar {
	width: 44px;
	height: 44px;
	border-radius: 10px;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	overflow: hidden;
}

.conv-avatar-image {
	width: 44px;
	height: 44px;
	border-radius: 10px;
}

.conv-avatar-icon {
	font-size: 18px;
	color: #ffffff;
}

.conv-avatar-text {
	font-size: 16px;
	color: #ffffff;
	font-weight: 600;
}

.conv-body {
	flex: 1;
	display: flex;
	flex-direction: column;
	margin-left: 10px;
}

.conv-name {
	font-size: 14px;
	color: #111111;
	font-weight: 600;
}

.conv-desc {
	margin-top: 4px;
	font-size: 12px;
	color: #666666;
}
</style>
