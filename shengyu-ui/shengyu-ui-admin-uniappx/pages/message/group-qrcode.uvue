	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const groupName = ref('产品研发团队')
	const memberCount = ref(12)
	const groupId = ref(0)

	function handleBack() {
		uni.navigateBack()
	}

	function handleSave() {
		// 实际项目中使用 uni.canvasToTempFilePath 生成图片
		// 然后使用 uni.saveImageToPhotosAlbum 保存到相册
		uni.showToast({
			title: '保存成功',
			icon: 'success'
		})
	}

	function handleShare() {
		// 实际项目中使用 uni.share 分享
		uni.showActionSheet({
			itemList: ['分享到微信', '分享到朋友圈', '复制链接'],
			success: (res) => {
				uni.showToast({
					title: '分享功能开发中',
					icon: 'none'
				})
			}
		})
	}

	onLoad((options : any) => {
		if (options['groupId']) {
			groupId.value = parseInt(options['groupId'])
		}
		if (options['name']) {
			groupName.value = decodeURIComponent(options['name'])
		}
		if (options['memberCount']) {
			memberCount.value = parseInt(options['memberCount'])
		}
		
		// 实际项目中在这里生成二维码
		// generateQRCode()
	})
</script>

