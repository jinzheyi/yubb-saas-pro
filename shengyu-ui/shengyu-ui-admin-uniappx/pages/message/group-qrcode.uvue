<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">返回</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">群二维码</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 加载中 -->
			<view v-if="loading" class="loading-container">
				<text class="loading-text" :style="{ color: theme.textTertiary }">加载中...</text>
			</view>

			<!-- 二维码卡片 -->
			<view v-else class="qrcode-card" :style="{ backgroundColor: theme.cardBg }">
				<!-- 群信息 -->
				<view class="group-info">
					<view class="group-avatar" :style="{ backgroundColor: groupAvatarBg }">
						<text class="iconfont group-icon">&#xe616;</text>
					</view>
					<text class="group-name" :style="{ color: theme.textPrimary }">{{ groupName }}</text>
					<text class="group-desc" :style="{ color: theme.textSecondary }">{{ groupJoinHint }}</text>
				</view>

				<!-- 二维码 -->
				<view class="qrcode-container">
					<image 
						v-if="qrCodeImageUrl" 
						:src="qrCodeImageUrl" 
						class="qrcode-image"
						mode="aspectFit"
						@load="handleImageLoad"
						@error="handleImageError"
					></image>
					<view v-else class="qrcode-placeholder" :style="{ backgroundColor: theme.cardBgMuted }">
						<text class="placeholder-text" :style="{ color: theme.textTertiary }">二维码加载中...</text>
					</view>
				</view>

				<!-- 邀请码信息 -->
				<view class="invite-info">
					<view class="invite-code-row">
						<text class="invite-label" :style="{ color: theme.textTertiary }">邀请码：</text>
						<text class="invite-code" :style="{ color: theme.textPrimary }">{{ inviteCode }}</text>
					</view>
					<view class="invite-expire-row">
						<text class="invite-expire" :style="{ color: theme.textSecondary }">{{ expireText }}</text>
					</view>
					<view v-if="needApproval" class="invite-expire-row">
						<text class="invite-expire approval-text">开启邀请确认，扫码后需管理员审批</text>
					</view>
				</view>
			</view>

			<!-- 操作按钮 -->
			<view v-if="!loading" class="action-section">
				<view class="action-btn" :style="{ backgroundColor: theme.cardBg }" @click="handleSaveImage">
					<text class="iconfont action-icon">&#xe60d;</text>
					<text class="action-text" :style="{ color: theme.textPrimary }">保存到相册</text>
				</view>
				<view class="action-btn" :style="{ backgroundColor: theme.cardBg }" @click="handleShare">
					<text class="iconfont action-icon">&#xe60e;</text>
					<text class="action-text" :style="{ color: theme.textPrimary }">{{ shareActionText }}</text>
				</view>
				<view class="action-btn" :style="{ backgroundColor: theme.cardBg }" @click="handleRefresh">
					<text class="iconfont action-icon">&#xe60f;</text>
					<text class="action-text" :style="{ color: theme.textPrimary }">刷新二维码</text>
				</view>
			</view>

			<!-- 说明文字 -->
			<view v-if="!loading" class="tips-section" :style="{ backgroundColor: theme.cardBg }">
				<text class="tips-title" :style="{ color: theme.textPrimary }">使用说明</text>
				<text class="tips-item" :style="{ color: theme.textSecondary }">• 二维码有效期为24小时</text>
				<text class="tips-item" :style="{ color: theme.textSecondary }">• {{ joinFlowTip }}</text>
				<text class="tips-item" :style="{ color: theme.textSecondary }">• 当前可通过二维码图片或分享链接进入加群页</text>
				<text class="tips-item" :style="{ color: theme.textSecondary }">• 可保存图片分享给好友</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted } from 'vue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { getGroupInviteCode, generateGroupInvite } from '../../api/group.uts'
	import { saveImageToAlbum } from '../../utils/qrcode.uts'
	import { BASE_URL, API_BASE_URL, ADMIN_APP_DOMAIN } from '../../config/app.config.uts'
	import { getGroupAvatarColor } from '../../utils/avatar.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { armGroupLifecycleErrorToastSuppression, finalizeGroupLifecycleExit, resolveGroupLifecycleErrorNotice } from '../../utils/chat-setting-actions.uts'
	import { getTenantId } from '../../store/user.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	// 页面参数
	const groupId = ref('')
	const groupName = ref('')

	const groupAvatarBg = computed(() : string => {
		return groupId.value ? getGroupAvatarColor(groupId.value) : getGroupAvatarColor('0')
	})

	// 邀请码信息
	const inviteCode = ref('')
	const qrCodeUrl = ref('')
	const expireTime = ref(0) // 改为数字类型，存储时间戳
	const usedCount = ref(0)
	const maxUseCount = ref(0)
	const needApproval = ref(false)
	const currentTenantId = ref('')

	// 加载状态
	const loading = ref(true)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	let lifecycleRedirecting = false
	
	// 二维码图片 URL（后端生成）
	const qrCodeImageUrl = ref('')

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	// 过期时间文本
	const expireText = computed(() : string => {
		console.log('[GroupQRCode] expireText 计算中, expireTime.value:', expireTime.value)
		
		if (!expireTime.value || expireTime.value === 0) {
			console.log('[GroupQRCode] expireTime 为空或0，返回空字符串')
			return ''
		}
		
		const expire = new Date(expireTime.value)
		const now = new Date()
		const diff = expire.getTime() - now.getTime()
		
		console.log('[GroupQRCode] 过期时间计算:', {
			expireTime: expireTime.value,
			expire: expire.toString(),
			now: now.toString(),
			diff: diff
		})
		
		if (diff <= 0) {
			return '已过期'
		}
		
		const hours = Math.floor(diff / (1000 * 60 * 60))
		const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))
		
		if (hours > 0) {
			return `有效期：${hours}小时${minutes}分钟`
		} else {
			return `有效期：${minutes}分钟`
		}
	})

	const groupJoinHint = computed(() : string => {
		return needApproval.value ? '扫码后提交申请，等待管理员审批' : '扫码后可加入群聊'
	})

	const joinFlowTip = computed(() : string => {
		return needApproval.value ? '扫码后不会直接入群，而是进入申请审批流程' : '扫码后验证邀请码，可直接加入群聊'
	})

	const shareActionText = computed(() : string => {
		const platform = uni.getSystemInfoSync().platform
		return platform === 'web' ? '复制邀请链接' : '分享邀请'
	})

	const inviteLandingUrl = computed(() : string => {
		if (!inviteCode.value || !groupId.value) {
			return ''
		}
		return `${ADMIN_APP_DOMAIN}/pages/message/join-group?code=${encodeURIComponent(inviteCode.value)}&groupId=${encodeIdParam(groupId.value)}`
	})

	/**
	 * 加载群邀请码
	 */
	async function loadInviteCode() {
		if (!groupId.value || lifecycleRedirecting) return

		try {
			loading.value = true
			armGroupLifecycleErrorToastSuppression(3000)
			const result = await getGroupInviteCode(groupId.value)

			console.log('[GroupQRCode] API 返回结果:', JSON.stringify(result))

			if (result && result.inviteCode) {
				inviteCode.value = result.inviteCode
				// 后端返回相对路径，前端拼接完整 URL
				qrCodeUrl.value = result.qrCodeUrl ? `${BASE_URL}${result.qrCodeUrl}` : ''
				expireTime.value = result.expireTime || 0
				usedCount.value = result.usedCount || 0
				maxUseCount.value = result.maxUseCount || 0
				needApproval.value = result.needApproval === true

				console.log('[GroupQRCode] 加载邀请码成功:', {
					inviteCode: inviteCode.value,
					qrCodeUrl: qrCodeUrl.value,
					expireTime: expireTime.value,
					needApproval: needApproval.value
				})

				// 生成二维码
				await generateQRCode()
			} else {
				console.log('[GroupQRCode] 没有有效邀请码，尝试生成新的')
				// 如果没有有效邀请码，尝试生成新的
				await generateNewInviteCode()
			}
		} catch (e) {
			console.error('[GroupQRCode] 加载邀请码失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, '', lifecycleNotice)
				return
			}
			
			// 如果没有有效邀请码，尝试生成新的
			await generateNewInviteCode()
		} finally {
			loading.value = false
		}
	}

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	/**
	 * 生成新的邀请码
	 */
	async function generateNewInviteCode() {
		if (!groupId.value || lifecycleRedirecting) return

		try {
			armGroupLifecycleErrorToastSuppression(3000)
			const result = await generateGroupInvite({
				groupId: groupId.value,
				expireHours: 24,
				maxUseCount: 0
			})

			console.log('[GroupQRCode] 生成邀请码 API 返回:', JSON.stringify(result))

			if (result && result.inviteCode) {
				inviteCode.value = result.inviteCode
				// 后端返回相对路径，前端拼接完整 URL
				qrCodeUrl.value = result.qrCodeUrl ? `${BASE_URL}${result.qrCodeUrl}` : ''
				
				// 确保 expireTime 是数字类型（时间戳）
				const newExpireTime = result.expireTime || 0
				console.log('[GroupQRCode] 新的 expireTime 类型:', typeof newExpireTime, '值:', newExpireTime)
				expireTime.value = newExpireTime
				
				usedCount.value = result.usedCount || 0
				maxUseCount.value = result.maxUseCount || 0
				needApproval.value = result.needApproval === true

				console.log('[GroupQRCode] 生成邀请码成功:', {
					inviteCode: inviteCode.value,
					qrCodeUrl: qrCodeUrl.value,
					expireTime: expireTime.value,
					expireTimeType: typeof expireTime.value,
					needApproval: needApproval.value
				})

				// 生成二维码
				await generateQRCode()
			}
		} catch (e) {
			console.error('[GroupQRCode] 生成邀请码失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, '', lifecycleNotice)
				return
			}
			uni.showToast({
				title: '生成邀请码失败',
				icon: 'none'
			})
		}
	}

	/**
	 * 生成二维码
	 */
	async function generateQRCode() {
		if (!inviteCode.value) {
			console.log('[GroupQRCode] inviteCode 为空，无法生成二维码')
			return
		}

		// 使用后端生成的二维码图片 URL
		// 传递 ADMIN_APP_DOMAIN 参数，让后端生成包含移动端域名的完整 URL
		const tenantQuery = currentTenantId.value !== '' ? `&tenantId=${encodeURIComponent(currentTenantId.value)}` : ''
		qrCodeImageUrl.value = `${API_BASE_URL}/system/im/group/invite/qrcode-image?code=${encodeURIComponent(inviteCode.value)}&groupId=${encodeURIComponent(groupId.value)}&baseUrl=${encodeURIComponent(ADMIN_APP_DOMAIN)}${tenantQuery}`
		
		console.log('[GroupQRCode] 二维码图片 URL:', qrCodeImageUrl.value)
		console.log('[GroupQRCode] inviteCode:', inviteCode.value)
		console.log('[GroupQRCode] groupId:', groupId.value)
		console.log('[GroupQRCode] API_BASE_URL:', API_BASE_URL)
		console.log('[GroupQRCode] ADMIN_APP_DOMAIN:', ADMIN_APP_DOMAIN)
		console.log('[GroupQRCode] tenantId:', currentTenantId.value)
	}

	/**
	 * 保存图片到相册
	 */
	async function handleSaveImage() {
		if (!qrCodeImageUrl.value) {
			uni.showToast({
				title: '二维码未生成',
				icon: 'none'
			})
			return
		}

		// 判断当前平台
		const platform = uni.getSystemInfoSync().platform
		console.log('[GroupQRCode] 当前平台:', platform)
		
		// H5 环境：提示用户右键保存或长按保存
		if (platform === 'web') {
			uni.showModal({
				title: '保存二维码',
				content: 'PC端：请右键点击二维码图片选择"图片另存为"\n移动端：请长按二维码图片保存',
				showCancel: false,
				confirmText: '知道了'
			})
			return
		}

		// App 环境：保存到相册
		try {
			uni.showLoading({
				title: '保存中...'
			})
			
			const downloadRes = await uni.downloadFile({
				url: qrCodeImageUrl.value
			})
			
			if (downloadRes.statusCode !== 200) {
				throw new Error('下载图片失败')
			}

			// 保存到相册
			await saveImageToAlbum(downloadRes.tempFilePath)
			
			uni.hideLoading()
			uni.showToast({
				title: '保存成功',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupQRCode] 保存图片失败:', e)
			uni.hideLoading()
			
			// 如果是权限问题，引导用户去设置
			uni.showModal({
				title: '提示',
				content: '保存图片需要相册权限，是否前往设置？',
				success: (res) => {
					if (res.confirm) {
						uni.openSetting({
							success: (settingRes) => {
								console.log('打开设置页面', settingRes)
							}
						})
					}
				}
			})
		}
	}

	/**
	 * 分享给好友
	 */
	async function handleShare() {
		if (!qrCodeImageUrl.value && !inviteLandingUrl.value) {
			uni.showToast({
				title: '邀请信息未生成',
				icon: 'none'
			})
			return
		}

		try {
			const platform = uni.getSystemInfoSync().platform
			if (platform === 'web') {
				uni.setClipboardData({
					data: inviteLandingUrl.value,
					success: () => {
						uni.showToast({
							title: '邀请链接已复制',
							icon: 'success'
						})
					}
				})
				return
			}

			// 先下载图片到本地
			uni.showLoading({
				title: '准备中...'
			})
			
			const downloadRes = await uni.downloadFile({
				url: qrCodeImageUrl.value
			})
			
			uni.hideLoading()
			
			if (downloadRes.statusCode !== 200) {
				throw new Error('下载图片失败')
			}

			// 分享图片
			uni.share({
				provider: 'weixin',
				type: 0, // 图片
				imageUrl: downloadRes.tempFilePath,
				title: `邀请你加入群聊：${groupName.value}`,
				success: () => {
					console.log('[GroupQRCode] 分享成功')
				},
				fail: (err: any) => {
					console.error('[GroupQRCode] 分享失败:', err)
					throw err
				}
			} as any)
		} catch (e) {
			console.error('[GroupQRCode] 分享失败:', e)
			
			if (inviteLandingUrl.value) {
				uni.setClipboardData({
					data: inviteLandingUrl.value,
					success: () => {
						uni.showToast({
							title: '分享失败，已复制邀请链接',
							icon: 'none'
						})
					}
				})
				return
			}
			uni.showModal({
				title: '提示',
				content: '当前平台暂不支持直接分享，您可以保存图片后手动分享',
				showCancel: false
			})
		}
	}

	/**
	 * 刷新二维码
	 */
	async function handleRefresh() {
		uni.showLoading({
			title: '刷新中...'
		})

		try {
			console.log('[GroupQRCode] 刷新前 expireTime:', expireTime.value)
			await generateNewInviteCode()
			if (lifecycleRedirecting) {
				return
			}
			console.log('[GroupQRCode] 刷新后 expireTime:', expireTime.value)
			console.log('[GroupQRCode] 刷新后 expireText:', expireText.value)
			
			uni.showToast({
				title: '刷新成功',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupQRCode] 刷新失败:', e)
			uni.showToast({
				title: '刷新失败',
				icon: 'none'
			})
		} finally {
			uni.hideLoading()
		}
	}

	function handleBack() {
		uni.navigateBack()
	}

	/**
	 * 图片加载成功
	 */
	function handleImageLoad(e: any) {
		console.log('[GroupQRCode] 二维码图片加载成功:', e)
	}

	/**
	 * 图片加载失败
	 */
	function handleImageError(e: any) {
		console.error('[GroupQRCode] 二维码图片加载失败:', e)
		uni.showToast({
			title: '二维码加载失败',
			icon: 'none'
		})
	}

	onLoad((options : any) => {
		currentTenantId.value = getTenantId() || ''

		// 获取群组ID
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}

		// 获取群名称
		if (options['groupName']) {
			groupName.value = decodeURIComponent(options['groupName'])
		}

		console.log('[GroupQRCode] 页面参数:', { groupId: groupId.value, groupName: groupName.value })
	})

	onMounted(async () => {
		// 加载邀请码
		await loadInviteCode()
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	/* 加载状态 */
	.loading-container {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}

	.loading-text {
		font-size: 14px;
	}

	/* 二维码卡片 */
	.qrcode-card {
		margin: 16px;
		border-radius: 12px;
		padding: 24px;
		align-items: center;
	}

	/* 群信息 */
	.group-info {
		align-items: center;
		margin-bottom: 24px;
	}

	.group-avatar {
		width: 60px;
		height: 60px;
		background-color: #10b981;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-bottom: 12px;
	}

	.group-icon {
		font-size: 32px;
		color: #FFFFFF;
	}

	.group-name {
		font-size: 18px;
		font-weight: 600;
		margin-bottom: 6px;
	}

	.group-desc {
		font-size: 14px;
	}

	/* 二维码 */
	.qrcode-container {
		width: 200px;
		height: 200px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-bottom: 20px;
		overflow: hidden;
	}

	.qrcode-image {
		width: 200px;
		height: 200px;
	}

	.qrcode-placeholder {
		width: 100%;
		height: 100%;
		justify-content: center;
		align-items: center;
	}

	.placeholder-text {
		font-size: 14px;
	}

	/* 邀请码信息 */
	.invite-info {
		width: 100%;
		align-items: center;
	}

	.invite-code-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}

	.invite-label {
		font-size: 14px;
	}

	.invite-code {
		font-size: 14px;
		font-weight: 600;
		font-family: monospace;
	}

	.invite-expire-row {
		flex-direction: row;
		align-items: center;
	}

	.invite-expire {
		font-size: 12px;
	}

	/* 操作按钮 */
	.action-section {
		margin: 0 16px 16px;
		border-radius: 12px;
		overflow: hidden;
	}

	.action-btn {
		flex-direction: row;
		align-items: center;
		padding: 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.action-btn-last {
		border-bottom-width: 0;
	}

	.action-icon {
		font-size: 20px;
		color: #1677FF;
		margin-right: 12px;
	}

	.action-text {
		font-size: 15px;
