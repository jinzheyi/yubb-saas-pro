<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">群二维码</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 二维码卡片 -->
			<view class="qrcode-card">
				<!-- 群信息 -->
				<view class="group-info">
					<view class="group-avatar">
						<text class="iconfont group-icon">&#xe616;</text>
					</view>
					<text class="group-name">{{ groupName }}</text>
					<text class="group-desc">{{ memberCount }}人</text>
				</view>

				<!-- 二维码 -->
				<view class="qrcode-wrap">
					<view class="qrcode-placeholder">
						<text class="iconfont qrcode-icon">&#xea8b;</text>
					</view>
					<!-- 实际项目中使用 canvas 生成二维码 -->
					<!-- <canvas canvas-id="qrcode" class="qrcode-canvas"></canvas> -->
				</view>

				<text class="qrcode-tip">扫一扫上面的二维码加入群聊</text>
			</view>

			<!-- 操作按钮 -->
			<view class="action-buttons">
				<button class="action-btn primary-btn" @click="handleSave">
					<text class="iconfont btn-icon">&#xea72;</text>
					<text class="btn-text">保存到相册</text>
				</button>
				<button class="action-btn secondary-btn" @click="handleShare">
					<text class="iconfont btn-icon">&#xe63d;</text>
					<text class="btn-text">分享</text>
				</button>
			</view>

			<!-- 说明文字 -->
			<view class="tips-section">
				<text class="tips-title">如何使用二维码</text>
				<view class="tips-item">
					<text class="tips-number">1</text>
					<text class="tips-text">打开应用，点击右上角扫一扫</text>
