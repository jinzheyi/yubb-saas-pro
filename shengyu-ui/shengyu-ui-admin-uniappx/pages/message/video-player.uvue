<template>
	<view class="video-player-page">
		<view class="status-bar"></view>
		
		<!-- 导航栏 -->
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
			</view>
			<text class="header-title">{{ videoTitle }}</text>
			<view class="header-right"></view>
		</view>

		<!-- 视频播放器 -->
		<view class="video-container">
			<video
				:src="videoUrl"
				:controls="true"
				:autoplay="true"
				:show-center-play-btn="true"
				:show-fullscreen-btn="true"
				:enable-progress-gesture="true"
				class="video-player"
				@error="handleVideoError"
				@play="handleVideoPlay"
				@pause="handleVideoPause"
			></video>
		</view>

		<!-- 视频信息 -->
		<view class="video-info">
			<text class="video-name">{{ videoTitle }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const videoUrl = ref('')
	const videoTitle = ref('视频播放')

	function handleBack() {
		uni.navigateBack()
	}

	function handleVideoError(e: any) {
		console.error('[VideoPlayer] 视频播放错误:', e)
		uni.showToast({
			title: '视频加载失败',
			icon: 'none'
		})
	}

	function handleVideoPlay() {
		console.log('[VideoPlayer] 视频开始播放')
	}

	function handleVideoPause() {
		console.log('[VideoPlayer] 视频暂停')
	}

	onLoad((options: any) => {
		if (options['url']) {
			videoUrl.value = decodeURIComponent(options['url'])
		}
		if (options['title']) {
			videoTitle.value = decodeURIComponent(options['title'])
		}
		
		console.log('[VideoPlayer] 页面参数:', { 
			url: videoUrl.value, 
			title: videoTitle.value 
		})
	})
</script>

<style>
	.video-player-page {
		height: 100%;
		background-color: #000000;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #000000;
	}

	.header {
		background-color: rgba(0, 0, 0, 0.8);
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #FFFFFF;
		font-size: 20px;
	}

	.header-title {
		color: #FFFFFF;
		font-size: 17px;
		font-weight: 600;
		flex: 1;
		text-align: center;
		lines: 1;
		text-overflow: ellipsis;
	}

	.header-right {
		width: 80px;
	}

	.video-container {
		flex: 1;
		justify-content: center;
		align-items: center;
		background-color: #000000;
	}

	.video-player {
		width: 100%;
		height: 100%;
	}

	.video-info {
		background-color: rgba(0, 0, 0, 0.8);
		padding: 16px;
	}

	.video-name {
		color: #FFFFFF;
		font-size: 15px;
		lines: 2;
		text-overflow: ellipsis;
	}
</style>
