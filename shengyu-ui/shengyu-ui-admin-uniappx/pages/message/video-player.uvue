<template>
	<view class="video-player-page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		
		<!-- 导航栏 -->
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ videoTitle }}</text>
			<view class="header-right"></view>
		</view>

		<!-- 视频播放器 -->
		<view class="video-container" :style="{ backgroundColor: theme.pageBg }">
			<video
				:src="videoUrl"
				:controls="true"
				:autoplay="true"
				:show-center-play-btn="true"
				:show-fullscreen-btn="true"
				:enable-progress-gesture="true"
				class="video-player"
				@error="handleVideoError"
				@play="handleVideoPlay"
				@pause="handleVideoPause"
			></video>
		</view>

		<!-- 视频信息 -->
		<view class="video-info" :style="{ backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="video-name" :style="{ color: theme.textPrimary }">{{ videoTitle }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const videoUrl = ref('')
	const videoTitle = ref('')
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleVideoError(e: any) {
		console.error('[VideoPlayer] 视频播放错误:', e)
		uni.showToast({
			title: t('chat.videoPlayer.loadFailed'),
			icon: 'none'
		})
	}

	function handleVideoPlay() {
		console.log('[VideoPlayer] 视频开始播放')
	}

	function handleVideoPause() {
		console.log('[VideoPlayer] 视频暂停')
	}

	onLoad((options: any) => {
		if (options['url']) {
			videoUrl.value = decodeURIComponent(options['url'])
		}
		if (options['title']) {
			videoTitle.value = decodeURIComponent(options['title'])
		}
		if (videoTitle.value === '') {
			videoTitle.value = t('chat.label.videoPlay')
		}
		
		console.log('[VideoPlayer] 页面参数:', { 
			url: videoUrl.value, 
			title: videoTitle.value 
		})
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.video-player-page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
		flex: 1;
		text-align: center;
		lines: 1;
		text-overflow: ellipsis;
	}

	.header-right {
		width: 80px;
	}

	.video-container {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.video-player {
		width: 100%;
		height: 100%;
	}

	.video-info {
		padding: 16px;
		border-top-width: 0.5px;
	}

	.video-name {
		font-size: 15px;
		lines: 2;
		text-overflow: ellipsis;
	}
</style>
