<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.joinGroup.title') }}</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="manual-entry-card" :style="{ backgroundColor: theme.cardBg }">
				<text class="manual-entry-title" :style="{ color: theme.textPrimary }">{{ t('chat.joinGroup.manualTitle') }}</text>
				<input
					v-model="inviteInput"
					class="manual-entry-input"
					:style="{ color: theme.inputText, backgroundColor: theme.inputBg, borderColor: theme.borderColor }"
					:placeholder="t('chat.joinGroup.manualPlaceholder')"
					confirm-type="done"
					@confirm="handleManualVerify"
				/>
				<view class="manual-entry-actions">
					<view class="manual-action-btn manual-action-btn-secondary" :style="{ backgroundColor: theme.cardBgMuted }" @click="handlePasteInvite">
						<text class="manual-action-btn-text secondary-text" :style="{ color: theme.textSecondary }">{{ t('chat.joinGroup.paste') }}</text>
					</view>
					<view class="manual-action-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleManualVerify">
						<text class="manual-action-btn-text">{{ loading ? t('chat.joinGroup.verifying') : t('chat.joinGroup.verify') }}</text>
					</view>
				</view>
				<text class="manual-entry-hint" :style="{ color: theme.textTertiary }">{{ t('chat.joinGroup.manualHint') }}</text>
			</view>

			<!-- 加载中 -->
			<view v-if="loading" class="loading-container">
				<text class="loading-text" :style="{ color: theme.textTertiary }">{{ t('chat.joinGroup.verifying') }}</text>
			</view>

			<!-- 验证失败 -->
			<view v-else-if="hasVerifyAttempted && !isValid" class="error-container">
				<text class="iconfont error-icon">&#xe60a;</text>
				<text class="error-title" :style="{ color: theme.textPrimary }">{{ errorMessage }}</text>
				<text class="error-desc" :style="{ color: theme.textSecondary }">{{ t('chat.joinGroup.errorDesc') }}</text>
				<view class="error-btn" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleResetManual">
					<text class="error-btn-text">{{ t('chat.joinGroup.reenter') }}</text>
				</view>
			</view>

			<!-- 群信息预览 -->
			<view v-else-if="isValid" class="group-preview">
				<!-- 群头像 -->
				<view class="group-avatar-large" :style="{ backgroundColor: groupAvatarBg }">
					<text class="iconfont group-icon-large">&#xe616;</text>
				</view>

				<!-- 群信息 -->
				<view class="group-info">
					<text class="group-name" :style="{ color: theme.textPrimary }">{{ groupInfo.groupName }}</text>
					<text class="group-member-count" :style="{ color: theme.textTertiary }">{{ t('chat.group.memberCount', { count: groupInfo.memberCount }) }}</text>
				</view>

				<!-- 邀请码信息 -->
				<view class="invite-info-card" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }">
					<view class="invite-row">
						<text class="invite-label" :style="{ color: theme.textTertiary }">{{ t('chat.joinGroup.inviteCode') }}</text>
						<text class="invite-value" :style="{ color: theme.textPrimary }">{{ inviteCode }}</text>
					</view>
					<view class="invite-row">
						<text class="invite-label" :style="{ color: theme.textTertiary }">{{ t('chat.joinGroup.expireTime') }}</text>
						<text class="invite-value" :style="{ color: theme.textPrimary }">{{ expireText }}</text>
					</view>
					<view v-if="groupInfo.needApproval" class="invite-row">
						<text class="invite-label" :style="{ color: theme.textTertiary }">{{ t('chat.joinGroup.joinMethod') }}</text>
						<text class="invite-value approval-text">{{ t('chat.joinGroup.needApproval') }}</text>
					</view>
				</view>

				<!-- 已在群中提示 -->
				<view v-if="alreadyInGroup" class="already-in-group" :style="{ backgroundColor: theme.brandPrimarySoft }">
					<text class="iconfont check-icon">&#xe60b;</text>
					<text class="already-text">{{ t('chat.joinGroup.alreadyInGroup') }}</text>
				</view>

				<!-- 加入按钮 -->
				<view v-if="!alreadyInGroup" class="action-container">
					<view class="join-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleJoinGroup">
						<text class="join-btn-text">{{ joining ? t('chat.joinGroup.submitting') : joinActionText }}</text>
					</view>
				</view>

				<!-- 查看群聊按钮（已在群中） -->
				<view v-else class="action-container">
					<view class="view-btn" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleViewGroup">
						<text class="view-btn-text" :style="{ color: theme.textPrimary }">{{ t('chat.joinGroup.viewGroup') }}</text>
					</view>
				</view>
			</view>

			<view v-else class="empty-container">
				<text class="empty-title" :style="{ color: theme.textPrimary }">{{ t('chat.joinGroup.waitingTitle') }}</text>
				<text class="empty-desc" :style="{ color: theme.textSecondary }">{{ t('chat.joinGroup.waitingDesc') }}</text>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { verifyInviteCode, joinGroupByInvite } from '../../api/group.uts'
	import { getGroupAvatarColor } from '../../utils/avatar.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { parseGroupInvitePayload } from '../../utils/group-invite.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	// 页面参数
	const inviteCode = ref('')
	const groupId = ref('')
	const inviteInput = ref('')

	// 验证状态
	const loading = ref(true)
	const isValid = ref(false)
	const hasVerifyAttempted = ref(false)
	const errorMessage = ref('')
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	// 群信息
	const groupInfo = ref({
		groupId: '',
		groupName: '',
		groupAvatar: '',
		memberCount: 0,
		needApproval: false,
		expireTime: ''
	})

	// 加入状态
	const joining = ref(false)
	const alreadyInGroup = ref(false)

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const groupAvatarBg = computed(() : string => {
		const currentGroupId = groupInfo.value.groupId || groupId.value
		return currentGroupId ? getGroupAvatarColor(currentGroupId) : getGroupAvatarColor('0')
	})

	// 过期时间文本
	const expireText = computed(() : string => {
		if (!groupInfo.value.expireTime) return ''

		const expire = new Date(groupInfo.value.expireTime)
		const now = new Date()
		const diff = expire.getTime() - now.getTime()

		if (diff <= 0) {
			return t('chat.joinGroup.expired')
		}

		const hours = Math.floor(diff / (1000 * 60 * 60))
		const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))

		if (hours > 0) {
			return t('chat.joinGroup.expireInHoursMinutes', { hours, minutes })
		}
		return t('chat.joinGroup.expireInMinutes', { minutes })
	})

	const joinActionText = computed(() : string => {
		return groupInfo.value.needApproval ? t('chat.joinGroup.submitApply') : t('chat.joinGroup.title')
	})

	function resolveInviteErrorMessage(error: any, fallback: string): string {
		const rawMsg = error && error.data && error.data.msg
			? String(error.data.msg)
			: (error && error.msg ? String(error.msg) : (error && error.message ? String(error.message) : ''))
		const msg = rawMsg.trim()
		return msg !== '' ? msg : fallback
	}

	/**
	 * 验证邀请码
	 */
	async function verifyCode() {
		if (!inviteCode.value) {
			hasVerifyAttempted.value = true
			isValid.value = false
			errorMessage.value = t('chat.joinGroup.enterCode')
			return
		}

		try {
			hasVerifyAttempted.value = true
			loading.value = true
			const result = await verifyInviteCode(inviteCode.value)

			console.log('[JoinGroup] 验证邀请码结果:', result)

			if (result && result.valid) {
				isValid.value = true
				groupInfo.value = {
					groupId: result.groupId != null ? result.groupId.toString() : '',
					groupName: result.groupName || '',
					groupAvatar: result.groupAvatar || '',
					memberCount: result.memberCount || 0,
					needApproval: result.needApproval || false,
					expireTime: result.expireTime || ''
				}
				groupId.value = result.groupId != null ? result.groupId.toString() : ''
			} else {
				isValid.value = false
				errorMessage.value = t('chat.joinGroup.invalidOrExpired')
			}
		} catch (e : any) {
			console.error('[JoinGroup] 验证邀请码失败:', e)
			isValid.value = false
			errorMessage.value = resolveInviteErrorMessage(e, t('chat.joinGroup.verifyFailed'))
		} finally {
			loading.value = false
		}
	}

	function resetVerifyState() {
		isValid.value = false
		hasVerifyAttempted.value = false
		alreadyInGroup.value = false
		errorMessage.value = t('chat.joinGroup.invalidCode')
		groupInfo.value = {
			groupId: '',
			groupName: '',
			groupAvatar: '',
			memberCount: 0,
			needApproval: false,
			expireTime: ''
		}
	}

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	async function handleManualVerify() {
		if (loading.value) return
		hasVerifyAttempted.value = true
		const payload = parseGroupInvitePayload(inviteInput.value)
		if (payload == null) {
			isValid.value = false
			alreadyInGroup.value = false
			errorMessage.value = t('chat.joinGroup.invalidPayload')
			return
		}
		inviteCode.value = payload.inviteCode
		groupId.value = payload.groupId
		inviteInput.value = payload.rawText
		await verifyCode()
	}

	function handlePasteInvite() {
		uni.getClipboardData({
			success: (res : any) => {
				const text = res != null && res.data != null ? String(res.data) : ''
				if (text === '') {
					uni.showToast({
						title: t('chat.joinGroup.clipboardEmpty'),
						icon: 'none'
					})
					return
				}
				inviteInput.value = text
				void handleManualVerify()
			},
			fail: (err : any) => {
				console.error('[JoinGroup] 读取剪贴板失败:', err)
				uni.showToast({
					title: t('chat.joinGroup.clipboardReadFailed'),
					icon: 'none'
				})
			}
		})
	}

	/**
	 * 加入群聊
	 */
	async function handleJoinGroup() {
		if (joining.value) return

		try {
			joining.value = true

			const result = await joinGroupByInvite(inviteCode.value)

			console.log('[JoinGroup] 加入群聊结果:', result)

			const resultType = result && result.resultType != null ? Number(result.resultType) : 1
			const resultGroupId = result && result.groupId != null ? String(result.groupId) : groupId.value
			const message = result && result.message ? String(result.message) : (resultType === 2 ? t('chat.joinGroup.applySubmitted') : t('chat.joinGroup.joinSuccess'))

			uni.showToast({
				title: message,
				icon: resultType === 2 ? 'none' : 'success'
			})

			if (resultType === 2) {
				setTimeout(() => {
					const pages = getCurrentPages()
					if (pages.length > 1) {
						uni.navigateBack()
					} else {
						uni.switchTab({
							url: '/pages/message/message'
						})
					}
				}, 1000)
				return
			}

			setTimeout(() => {
				uni.redirectTo({
					url: `/pages/message/chat?groupId=${encodeIdParam(resultGroupId)}&targetId=${encodeIdParam(resultGroupId)}&targetType=2&type=group&entryMode=latest`
				})
			}, 1000)
		} catch (e : any) {
			console.error('[JoinGroup] 加入群聊失败:', e)

			// 解析错误信息
			let errorMsg = resolveInviteErrorMessage(e, t('chat.joinGroup.joinFailed'))
			if (errorMsg === t('chat.joinGroup.alreadyInGroup')) {
				alreadyInGroup.value = true
				return
			}
			if (errorMsg === t('chat.joinGroup.groupUnavailable')) {
				hasVerifyAttempted.value = true
				isValid.value = false
				errorMessage.value = errorMsg
				return
			}

			uni.showToast({
				title: errorMsg,
				icon: 'none',
				duration: 2000
			})
		} finally {
			joining.value = false
		}
	}

	/**
	 * 查看群聊（已在群中）
	 */
	function handleViewGroup() {
		uni.redirectTo({
			url: `/pages/message/chat?groupId=${encodeIdParam(groupId.value)}&targetId=${encodeIdParam(groupId.value)}&targetType=2&type=group&entryMode=latest`
		})
	}

	function handleResetManual() {
		resetVerifyState()
		loading.value = false
	}

	function handleBack() {
		uni.navigateBack()
	}

	onLoad((options : any) => {
		// 获取邀请码
		if (options['code']) {
			inviteCode.value = options['code'] as string
			inviteInput.value = inviteCode.value
		}

		// 获取群组ID（可选）
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}

		console.log('[JoinGroup] 页面参数:', { inviteCode: inviteCode.value, groupId: groupId.value })
	})

	onMounted(async () => {
		if (inviteCode.value) {
			await verifyCode()
			return
		}
		loading.value = false
		isValid.value = false
		hasVerifyAttempted.value = false
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.manual-entry-card {
		border-radius: 12px;
		padding: 16px;
		margin: 16px 16px 0 16px;
	}

	.manual-entry-title {
		font-size: 16px;
		font-weight: 600;
		margin-bottom: 12px;
	}

	.manual-entry-input {
		height: 44px;
		border-radius: 10px;
		padding: 0 12px;
		font-size: 14px;
	}

	.manual-entry-actions {
		flex-direction: row;
		margin-top: 12px;
		column-gap: 10px;
	}

	.manual-action-btn {
		flex: 1;
		height: 40px;
		border-radius: 10px;
		background-color: #1677FF;
		justify-content: center;
		align-items: center;
	}

	.manual-action-btn-secondary {
		background-color: rgba(51, 112, 255, 0.14);
	}

	.manual-action-btn-text {
		font-size: 14px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.secondary-text {
		color: #1677FF;
	}

	.manual-entry-hint {
		margin-top: 10px;
		font-size: 12px;
		line-height: 18px;
	}

	/* 加载状态 */
	.loading-container {
		padding: 80px 0;
		justify-content: center;
		align-items: center;
	}

	.loading-text {
		font-size: 14px;
	}

	.empty-container {
		padding: 56px 32px 40px;
		align-items: center;
	}

	.empty-title {
		font-size: 18px;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.empty-desc {
		font-size: 14px;
		text-align: center;
		line-height: 22px;
	}

	/* 错误状态 */
	.error-container {
		padding: 80px 40px;
		align-items: center;
	}

	.error-icon {
		font-size: 64px;
		color: #F54A45;
		margin-bottom: 20px;
	}

	.error-title {
		font-size: 18px;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.error-desc {
		font-size: 14px;
		text-align: center;
		margin-bottom: 32px;
	}

	.error-btn {
		width: 200px;
		height: 44px;
		background-color: #1677FF;
		border-radius: 22px;
		justify-content: center;
		align-items: center;
	}

	.error-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}

	/* 群信息预览 */
	.group-preview {
		padding: 40px 24px;
		align-items: center;
	}

	.group-avatar-large {
		width: 80px;
		height: 80px;
		background-color: #10b981;
		border-radius: 16px;
		justify-content: center;
		align-items: center;
		margin-bottom: 20px;
	}

	.group-icon-large {
		font-size: 40px;
		color: #FFFFFF;
	}

	.group-info {
		align-items: center;
		margin-bottom: 24px;
	}

	.group-name {
		font-size: 22px;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.group-member-count {
		font-size: 14px;
	}

	/* 邀请信息卡片 */
	.invite-info-card {
		width: 100%;
		border-radius: 12px;
		padding: 16px;
		margin-bottom: 24px;
	}

	.invite-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 10px 0;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.invite-row-last {
		border-bottom-width: 0;
	}

	.invite-label {
		font-size: 14px;
	}

	.invite-value {
		font-size: 14px;
		font-weight: 500;
	}

	.approval-text {
		color: #FF8C00;
	}

	/* 已在群中提示 */
	.already-in-group {
		flex-direction: row;
		align-items: center;
		background-color: #E8F5E9;
		padding: 12px 20px;
		border-radius: 8px;
		margin-bottom: 24px;
	}

	.check-icon {
		font-size: 18px;
		color: #10b981;
		margin-right: 8px;
	}

	.already-text {
		font-size: 14px;
		color: #10b981;
		font-weight: 500;
	}

	/* 操作按钮 */
	.action-container {
		width: 100%;
	}

	.join-btn {
		width: 100%;
		height: 48px;
		background-color: #1677FF;
		border-radius: 24px;
		justify-content: center;
		align-items: center;
	}

	.join-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.view-btn {
		width: 100%;
		height: 48px;
		border-radius: 24px;
		justify-content: center;
		align-items: center;
	}

	.view-btn-text {
		font-size: 16px;
		font-weight: 500;
	}

	.bottom-space {
		height: 40px;
	}
</style>
