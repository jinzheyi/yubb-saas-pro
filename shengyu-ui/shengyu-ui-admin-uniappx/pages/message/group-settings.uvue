		padding: 20px 20px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}
	
	.dialog-title {
		font-size: 17px;
		font-weight: 600;
		text-align: center;
	}
	
	.dialog-content {
		padding: 16px 20px;
	}
	
	.dialog-input {
		width: 100%;
		height: 40px;
		border-radius: 6px;
		padding: 0 12px;
		font-size: 15px;
		border-width: 1px;
	}
	
	.dialog-input-focus {
		border-color: #1677FF;
	}
	
	.dialog-hint {
		font-size: 12px;
		margin-top: 8px;
		text-align: right;
	}
	
	.dialog-footer {
		flex-direction: row;
		border-top-width: 0.5px;
