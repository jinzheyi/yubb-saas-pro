	}

	.add-btn {
		border-width: 1px;
		border-style: dashed;
	}

	.add-icon {
		font-size: 24px;
	}

	.remove-btn {
		border-width: 1px;
		border-style: dashed;
	}

	.remove-icon {
		font-size: 24px;
	}

	.member-name {
		font-size: 12px;
		text-align: center;
		lines: 1;
		text-overflow: ellipsis;
	}

	.view-all-btn {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 12px 0;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		margin-top: 8px;
	}

	.view-all-text {
