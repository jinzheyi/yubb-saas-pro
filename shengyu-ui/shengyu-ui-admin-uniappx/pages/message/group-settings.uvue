<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">群聊设置</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 群信息卡片 -->
			<view class="group-info-card">
				<view class="group-avatar">
					<text class="iconfont group-icon">&#xe616;</text>
				</view>
				<view class="group-details">
					<text class="group-name">{{ groupName }}</text>
					<text class="group-member-count">{{ memberCount }}人</text>
				</view>
			</view>

			<!-- 群成员列表 -->
			<view class="section">
				<view class="section-title">群成员</view>
				<view class="member-grid">
					<view class="member-item" v-for="(member, index) in displayMembers" :key="member.id" @click="handleMemberClick(member)">
						<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
							<text class="member-avatar-text">{{ member.avatarText }}</text>
						</view>
						<text class="member-name">{{ member.name }}</text>
					</view>
					<!-- 添加成员按钮 -->
					<view class="member-item" @click="handleAddMember">
						<view class="member-avatar add-btn">
							<text class="iconfont add-icon">&#xe726;</text>
						</view>
						<text class="member-name">添加</text>
					</view>
					<!-- 删除成员按钮 -->
					<view class="member-item" @click="handleRemoveMember">
						<view class="member-avatar remove-btn">
							<text class="iconfont remove-icon">&#xe602;</text>
						</view>
						<text class="member-name">删除</text>
					</view>
				</view>
				<view class="view-all-btn" @click="handleViewAllMembers">
					<text class="view-all-text">查看全部群成员</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
			</view>

			<!-- 群聊名称 -->
			<view class="setting-section">
				<view class="setting-item" @click="handleEditGroupName">
					<text class="setting-label">群聊名称</text>
					<view class="setting-value-wrap">
						<text class="setting-value">{{ groupName }}</text>
						<text class="iconfont arrow-icon">&#xeb03;</text>
					</view>
				</view>
			</view>

			<!-- 群聊设置 -->
			<view class="setting-section">
				<view class="setting-item" @click="handleGroupQRCode">
					<text class="setting-label">群二维码</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="setting-item" @click="handleGroupNotice">
					<text class="setting-label">群公告</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="setting-item" @click="handleGroupFiles">
					<text class="setting-label">群文件</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="setting-item" @click="handleChatHistory">
					<text class="setting-label">聊天记录</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
			</view>

			<!-- 消息设置 -->
			<view class="setting-section">
				<view class="setting-item">
					<text class="setting-label">消息免打扰</text>
					<switch class="setting-switch" :checked="noDisturb" @change="handleNoDisturbChange" />
				</view>
				<view class="setting-item">
					<text class="setting-label">置顶聊天</text>
					<switch class="setting-switch" :checked="isPinned" @change="handlePinnedChange" />
				</view>
				<view class="setting-item" @click="handleChatBubble">
					<text class="setting-label">聊天气泡</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
			</view>

			<!-- 群管理 -->
			<view class="setting-section">
				<view class="setting-item">
					<text class="setting-label">群聊邀请确认</text>
					<switch class="setting-switch" :checked="needApproval" @change="handleApprovalChange" />
				</view>
				<view class="setting-item" @click="handleMyNickname">
					<text class="setting-label">我在本群的昵称</text>
					<view class="setting-value-wrap">
						<text class="setting-value">{{ myNickname }}</text>
						<text class="iconfont arrow-icon">&#xeb03;</text>
					</view>
				</view>
				<view class="setting-item" @click="handleShowMemberNickname">
					<text class="setting-label">显示群成员昵称</text>
					<switch class="setting-switch" :checked="showMemberNickname" @change="handleShowNicknameChange" />
				</view>
			</view>

			<!-- 危险操作 -->
			<view class="setting-section">
				<view class="setting-item danger-item" @click="handleClearHistory">
					<text class="setting-label danger-text">清空聊天记录</text>
				</view>
				<view class="setting-item danger-item" @click="handleDeleteAndExit">
					<text class="setting-label danger-text">删除并退出</text>
				</view>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
		
		<!-- 修改群名称弹窗 -->
		<view v-if="showEditNameDialog" class="dialog-mask" @click.stop="handleCancelEditName">
			<view class="dialog-container" @click.stop="">
				<view class="dialog-header">
					<text class="dialog-title">修改群名称</text>
				</view>
				<view class="dialog-content">
					<input 
						class="dialog-input" 
						v-model="editingGroupName" 
						placeholder="请输入群名称（最多30字）"
						maxlength="30"
						:focus="showEditNameDialog"
					/>
					<text class="dialog-hint">{{ editingGroupName.length }}/30</text>
				</view>
				<view class="dialog-footer">
					<view class="dialog-btn dialog-btn-cancel" @click.stop="handleCancelEditName">
						<text class="dialog-btn-text">取消</text>
					</view>
					<view class="dialog-btn dialog-btn-confirm" @click.stop="handleConfirmEditName">
						<text class="dialog-btn-text dialog-btn-text-primary">确定</text>
					</view>
				</view>
			</view>
		</view>
		
		<!-- 修改昵称弹窗 -->
		<view v-if="showEditNicknameDialog" class="dialog-mask" @click.stop="handleCancelEditNickname">
			<view class="dialog-container" @click.stop="">
				<view class="dialog-header">
					<text class="dialog-title">修改我的群昵称</text>
				</view>
				<view class="dialog-content">
					<input 
						class="dialog-input" 
						v-model="editingNickname" 
						placeholder="请输入昵称（最多15字）"
						maxlength="15"
						:focus="showEditNicknameDialog"
					/>
					<text class="dialog-hint">{{ editingNickname.length }}/15</text>
				</view>
				<view class="dialog-footer">
					<view class="dialog-btn dialog-btn-cancel" @click.stop="handleCancelEditNickname">
						<text class="dialog-btn-text">取消</text>
					</view>
					<view class="dialog-btn dialog-btn-confirm" @click.stop="handleConfirmEditNickname">
						<text class="dialog-btn-text dialog-btn-text-primary">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroup, getGroupMembers, updateGroup, quitGroup } from '../../api/group.uts'
	import { getConversationByTarget, pinConversation, setNoDisturb } from '../../api/conversation.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getUserIdStr } from '../../store/user.uts'

	const { t } = useI18n()

	// 页面参数
	const groupId = ref('')
	const conversationId = ref('')
	
	// 当前用户
	const currentUserId = ref<string>('0')

	// 群聊信息
	const groupName = ref('')
	const memberCount = ref(0)
	const myNickname = ref('')
	const groupInfo = ref<any>(null)
	
	// 加载状态
	const loading = ref(false)
	
	// 编辑群名称弹窗
	const showEditNameDialog = ref(false)
	const editingGroupName = ref('')
	
	// 编辑昵称弹窗
	const showEditNicknameDialog = ref(false)
	const editingNickname = ref('')

	// 设置状态
	const noDisturb = ref(false)
	const isPinned = ref(false)
	const needApproval = ref(false)
	const showMemberNickname = ref(true)

	// 群成员数据
	const allMembers = ref<any[]>([])

	const displayMembers = computed(() : any[] => {
		return allMembers.value.slice(0, 8)
	})
	
	/**
	 * 加载群组信息
	 */
	async function loadGroupInfo() {
		if (!groupId.value) return
		
		try {
			loading.value = true
			const result = await getGroup(groupId.value)
			
			if (result) {
				groupInfo.value = result
				groupName.value = result.name || ''
				memberCount.value = result.memberCount || 0
				needApproval.value = result.needApproval || false
				
				console.log('[GroupSettings] 加载群组信息成功:', result)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载群组信息失败:', e)
			uni.showToast({
				title: '加载群组信息失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 加载群成员列表
	 */
	async function loadGroupMembers() {
		if (!groupId.value) return
		
		try {
			const members = await getGroupMembers(groupId.value)
			
			if (members && Array.isArray(members)) {
				allMembers.value = members.map(member => {
					// 查找当前用户的昵称
					if (member.userId === currentUserId.value) {
						myNickname.value = member.nickname || member.userNickname || ''
					}
					
					return {
						id: member.userId,
						name: member.nickname || member.userNickname || '未知',
						avatarText: getAvatarText(member.nickname || member.userNickname || ''),
						avatarBg: getUserAvatarColor(member.userId),
						role: member.role
					}
				})
				
				console.log('[GroupSettings] 加载群成员成功, 数量:', allMembers.value.length)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载群成员失败:', e)
		}
	}
	
	/**
	 * 加载会话设置
	 */
	async function loadConversationSettings() {
		if (!groupId.value) return
		
		try {
			// 通过 groupId 查询会话
			const conversation = await getConversationByTarget(groupId.value, 2)
			
			if (conversation && conversation.id) {
				conversationId.value = conversation.id.toString()
				noDisturb.value = conversation.noDisturb || false
				isPinned.value = conversation.isPinned || false
				
				console.log('[GroupSettings] 加载会话设置成功, conversationId:', conversationId.value)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载会话设置失败:', e)
		}
	}

	function handleBack() {
		uni.navigateBack()
	}

	function handleMemberClick(member : any) {
		uni.navigateTo({
			url: '/pages/contacts/user-detail?id=' + member.id
		})
	}

	function handleAddMember() {
		uni.navigateTo({
			url: '/pages/contacts/initiate-group?mode=add&groupId=' + groupId.value
		})
	}

	function handleRemoveMember() {
		// 跳转到成员列表页面，选择要删除的成员
		uni.navigateTo({
			url: '/pages/message/group-members?groupId=' + groupId.value + '&groupName=' + encodeURIComponent(groupName.value) + '&mode=remove'
		})
	}

	function handleViewAllMembers() {
		uni.navigateTo({
			url: '/pages/message/group-members?groupId=' + groupId.value + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleEditGroupName() {
		editingGroupName.value = groupName.value
		showEditNameDialog.value = true
	}
	
	function handleCancelEditName() {
		showEditNameDialog.value = false
		editingGroupName.value = ''
	}
	
	async function handleConfirmEditName() {
		const newName = editingGroupName.value.trim()
		
		// 验证群名称
		if (!newName) {
			uni.showToast({
				title: '群名称不能为空',
				icon: 'none'
			})
			return
		}
		
		if (newName.length > 30) {
			uni.showToast({
				title: '群名称不能超过30个字',
				icon: 'none'
			})
			return
		}
		
		// 如果名称没有变化，不调用接口
		if (newName === groupName.value) {
			showEditNameDialog.value = false
			return
		}
		
		try {
			await updateGroup({
				id: groupId.value,
				name: newName
			})
			groupName.value = newName
			showEditNameDialog.value = false
			uni.showToast({
				title: '修改成功',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 修改群名称失败:', e)
			uni.showToast({
				title: '修改失败',
				icon: 'none'
			})
		}
	}

	function handleGroupQRCode() {
		uni.navigateTo({
			url: '/pages/message/group-qrcode?groupId=' + groupId.value + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleGroupNotice() {
		uni.navigateTo({
			url: '/pages/message/group-notice?groupId=' + groupId.value + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleGroupFiles() {
		uni.navigateTo({
			url: '/pages/message/chat-files?groupId=' + groupId.value
		})
	}

	function handleChatHistory() {
		uni.navigateTo({
			url: `/pages/message/chat-history?conversationId=${conversationId.value}&groupName=${groupName.value}`
		})
	}

	async function handleNoDisturbChange(e : any) {
		const newValue = e.detail.value as boolean
		
		if (!conversationId.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		
		try {
			await setNoDisturb(conversationId.value, newValue)
			noDisturb.value = newValue
			uni.showToast({
				title: newValue ? '已开启免打扰' : '已关闭免打扰',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 设置免打扰失败:', e)
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		}
	}

	async function handlePinnedChange(e : any) {
		const newValue = e.detail.value as boolean
		
		if (!conversationId.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		
		try {
			await pinConversation(conversationId.value, newValue)
			isPinned.value = newValue
			uni.showToast({
				title: newValue ? '已置顶' : '已取消置顶',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 设置置顶失败:', e)
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		}
	}

	function handleChatBubble() {
		uni.navigateTo({
			url: '/pages/message/chat-bubble'
		})
	}

	function handleApprovalChange(e : any) {
		needApproval.value = e.detail.value
		// TODO: 调用后端 API 更新群设置
		uni.showToast({
			title: '群设置更新功能开发中',
			icon: 'none'
		})
	}

	function handleMyNickname() {
		editingNickname.value = myNickname.value
		showEditNicknameDialog.value = true
	}
	
	function handleCancelEditNickname() {
		showEditNicknameDialog.value = false
		editingNickname.value = ''
	}
	
	async function handleConfirmEditNickname() {
		const newNickname = editingNickname.value.trim()
		
		// 验证昵称
		if (!newNickname) {
			uni.showToast({
				title: '昵称不能为空',
				icon: 'none'
			})
			return
		}
		
		if (newNickname.length > 15) {
			uni.showToast({
				title: '昵称不能超过15个字',
				icon: 'none'
			})
			return
		}
		
		// 如果昵称没有变化，不调用接口
		if (newNickname === myNickname.value) {
			showEditNicknameDialog.value = false
			return
		}
		
		// TODO: 需要后端添加更新群成员昵称的 API
		showEditNicknameDialog.value = false
		uni.showToast({
			title: '该功能需要后端支持',
			icon: 'none'
		})
		
		// 后端 API 实现后的代码：
		// try {
		// 	await updateGroupMemberNickname({
		// 		groupId: groupId.value,
		// 		nickname: newNickname
		// 	})
		// 	myNickname.value = newNickname
		// 	showEditNicknameDialog.value = false
		// 	uni.showToast({
		// 		title: '修改成功',
		// 		icon: 'success'
		// 	})
		// } catch (e) {
		// 	console.error('[GroupSettings] 修改昵称失败:', e)
		// 	uni.showToast({
		// 		title: '修改失败',
		// 		icon: 'none'
		// 	})
		// }
	}

	function handleShowNicknameChange(e : any) {
		showMemberNickname.value = e.detail.value
	}

	function handleClearHistory() {
		uni.showModal({
			title: '清空聊天记录',
			content: '确定要清空聊天记录吗？此操作不可恢复',
			success: (res) => {
				if (res.confirm) {
					// TODO: 需要后端添加清空聊天记录的 API
					uni.showToast({
						title: '该功能需要后端支持',
						icon: 'none'
					})
				}
			}
		})
	}

	function handleDeleteAndExit() {
		uni.showModal({
			title: '退出群聊',
			content: '退出后将不再接收此群消息，确定要退出吗？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await quitGroup(groupId.value)
						uni.showToast({
							title: '已退出群聊',
							icon: 'success'
						})
						
						// 延迟返回，让用户看到提示
						setTimeout(() => {
							uni.navigateBack({
								delta: 2 // 返回到消息列表页
							})
						}, 1000)
					} catch (e) {
						console.error('[GroupSettings] 退出群聊失败:', e)
						uni.showToast({
							title: '退出失败',
							icon: 'none'
						})
					}
				}
			}
		})
	}

	onLoad((options : any) => {
		// 获取当前用户ID
		currentUserId.value = getUserIdStr()
		
		// 获取群组ID
		if (options['groupId']) {
			groupId.value = options['groupId'] as string
		}
		
		// 获取群名称（临时显示）
		if (options['name']) {
			groupName.value = decodeURIComponent(options['name'])
		}
		
		console.log('[GroupSettings] 页面参数:', { groupId: groupId.value, groupName: groupName.value })
	})
	
	onMounted(async () => {
		// 加载数据
		await loadGroupInfo()
		await loadGroupMembers()
		await loadConversationSettings()
	})
	
	onShow(async () => {
		// 页面显示时刷新数据（从添加成员页面返回时）
		if (groupId.value) {
			console.log('[GroupSettings] 页面显示，刷新数据')
			await loadGroupInfo()
			await loadGroupMembers()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	/* 群信息卡片 */
	.group-info-card {
		background-color: #FFFFFF;
		padding: 20px 16px;
		flex-direction: row;
		align-items: center;
		margin-bottom: 10px;
	}

	.group-avatar {
		width: 60px;
		height: 60px;
		background-color: #10b981;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-right: 16px;
	}

	.group-icon {
		font-size: 32px;
		color: #FFFFFF;
	}

	.group-details {
		flex: 1;
	}

	.group-name {
		font-size: 18px;
		color: #1F2329;
		font-weight: 600;
		margin-bottom: 6px;
	}

	.group-member-count {
		font-size: 14px;
		color: #8F959E;
	}

	/* 群成员区域 */
	.section {
		background-color: #FFFFFF;
		padding: 16px;
		margin-bottom: 10px;
	}

	.section-title {
