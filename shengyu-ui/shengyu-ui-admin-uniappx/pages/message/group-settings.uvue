<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">群聊设置</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" :style="{ backgroundColor: theme.pageBg }" scroll-y="true" show-scrollbar="false">
			<!-- 群信息卡片 -->
			<view class="group-info-card" :style="{ backgroundColor: theme.cardBg }">
				<view class="group-avatar">
					<text class="iconfont group-icon">&#xe616;</text>
				</view>
				<view class="group-details">
					<text class="group-name" :style="{ color: theme.textPrimary }">{{ groupName }}</text>
					<view class="group-meta-row">
						<text class="group-member-count" :style="{ color: theme.textTertiary }">{{ memberCount }}人</text>
						<text class="role-badge" :class="roleBadgeClass">{{ roleLabel }}</text>
					</view>
				</view>
			</view>

			<!-- 群成员列表 -->
			<view class="section" :style="{ backgroundColor: theme.cardBg }">
				<view class="section-title" :style="{ color: theme.textPrimary }">群成员</view>
				<view class="member-grid">
					<view class="member-item" v-for="(member, index) in displayMembers" :key="member.id" @click="handleMemberClick(member)">
						<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
							<image
								v-if="shouldShowMemberAvatar(member)"
								class="member-avatar-image"
								:src="member.avatar"
								mode="aspectFill"
								@error="handleMemberAvatarError(member)"
							/>
							<text v-else class="member-avatar-text">{{ member.avatarText }}</text>
						</view>
						<text class="member-name" :style="{ color: theme.textSecondary }">{{ member.name }}</text>
					</view>
					<!-- 添加成员按钮 -->
					<view v-if="canAddMembers" class="member-item" @click="handleAddMember">
						<view class="member-avatar add-btn" :style="{ backgroundColor: theme.cardBgMuted, borderColor: theme.borderColor }">
							<text class="iconfont add-icon" :style="{ color: theme.textTertiary }">&#xe726;</text>
						</view>
						<text class="member-name" :style="{ color: theme.textSecondary }">添加</text>
					</view>
					<!-- 删除成员按钮 -->
					<view v-if="canRemoveMembers" class="member-item" @click="handleRemoveMember">
						<view class="member-avatar remove-btn" :style="{ backgroundColor: theme.cardBgMuted, borderColor: theme.borderColor }">
							<text class="iconfont remove-icon" :style="{ color: theme.textTertiary }">&#xe602;</text>
						</view>
						<text class="member-name" :style="{ color: theme.textSecondary }">删除</text>
					</view>
				</view>
				<view class="view-all-btn" :style="{ borderTopColor: theme.borderColor }" @click="handleViewAllMembers">
					<text class="view-all-text" :style="{ color: theme.brandPrimary }">查看全部群成员</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
			</view>

			<!-- 群聊名称 -->
			<view class="setting-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="setting-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleEditGroupName">
					<text class="setting-label" :style="{ color: theme.textPrimary }">群聊名称</text>
					<view class="setting-value-wrap">
						<text class="setting-value" :style="{ color: theme.textSecondary }">{{ groupName }}</text>
						<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					</view>
				</view>
			</view>

			<!-- 群聊设置 -->
			<view class="setting-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="setting-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleGroupQRCode">
					<text class="setting-label" :style="{ color: theme.textPrimary }">群二维码</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="setting-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleGroupNotice">
					<text class="setting-label" :style="{ color: theme.textPrimary }">群公告</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="setting-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleGroupFiles">
					<text class="setting-label" :style="{ color: theme.textPrimary }">群文件</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="setting-item" @click="handleChatHistory">
					<text class="setting-label" :style="{ color: theme.textPrimary }">聊天记录</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
			</view>

			<!-- 消息设置 -->
			<view class="setting-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="setting-item" :style="{ borderBottomColor: theme.borderColor }">
					<text class="setting-label" :style="{ color: theme.textPrimary }">消息免打扰</text>
					<switch class="setting-switch" :checked="noDisturb" @change="handleNoDisturbChange" />
				</view>
				<view class="setting-item">
					<text class="setting-label" :style="{ color: theme.textPrimary }">置顶聊天</text>
					<switch class="setting-switch" :checked="isPinned" @change="handlePinnedChange" />
				</view>
			</view>

			<!-- 群管理 -->
			<view class="setting-section" :style="{ backgroundColor: theme.cardBg }">
				<view v-if="canManageGroupMute" class="setting-item" :style="{ borderBottomColor: theme.borderColor }">
					<text class="setting-label" :style="{ color: theme.textPrimary }">全员禁言</text>
					<switch class="setting-switch" :checked="muteAllEnabled" :disabled="muteAllUpdating" @change="handleMuteAllChange" />
				</view>
				<view v-if="canManageJoinRequests" class="setting-item" :style="{ borderBottomColor: theme.borderColor }">
					<text class="setting-label" :style="{ color: theme.textPrimary }">允许成员邀请</text>
					<switch class="setting-switch" :checked="allowMemberInvite" :disabled="memberInviteUpdating" @change="handleMemberInviteChange" />
				</view>
				<view v-if="canManageJoinRequests" class="setting-item" :style="{ borderBottomColor: theme.borderColor }">
					<text class="setting-label" :style="{ color: theme.textPrimary }">群聊邀请确认</text>
					<switch class="setting-switch" :checked="needApproval" :disabled="approvalUpdating" @change="handleApprovalChange" />
				</view>
				<view v-if="canManageJoinRequests" class="setting-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleJoinRequests">
					<text class="setting-label" :style="{ color: theme.textPrimary }">入群申请</text>
					<view class="setting-value-wrap">
						<text class="setting-value" :style="{ color: pendingJoinRequestCount > 0 ? '#F54A45' : theme.textSecondary }">{{ pendingJoinRequestCount > 0 ? pendingJoinRequestCount + '条待处理' : '暂无待处理' }}</text>
						<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					</view>
				</view>
				<view class="setting-item" @click="handleMyNickname">
					<text class="setting-label" :style="{ color: theme.textPrimary }">我在本群的昵称</text>
					<view class="setting-value-wrap">
						<text class="setting-value" :style="{ color: theme.textSecondary }">{{ myNickname }}</text>
						<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					</view>
				</view>
			</view>

			<!-- 危险操作 -->
			<view class="setting-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="setting-item danger-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleClearHistory">
					<text class="setting-label danger-text">清空聊天记录</text>
				</view>
				<view v-if="isOwner" class="setting-item danger-item" :style="{ borderBottomColor: theme.borderColor }" @click="handleTransferOwner">
					<text class="setting-label danger-text">转让群主</text>
				</view>
				<view class="setting-item danger-item" @click="handleDeleteAndExit">
					<text class="setting-label danger-text">{{ isOwner ? '解散群聊' : '退出群聊' }}</text>
				</view>
			</view>

			<view class="bottom-space"></view>
		</scroll-view>
		
		<!-- 修改群名称弹窗 -->
		<view v-if="showEditNameDialog" class="dialog-mask" :style="{ backgroundColor: theme.overlayMask }" @click.stop="handleCancelEditName">
			<view class="dialog-container" :style="{ backgroundColor: theme.cardBg }" @click.stop="">
				<view class="dialog-header" :style="{ borderBottomColor: theme.borderColor }">
					<text class="dialog-title" :style="{ color: theme.textPrimary }">修改群名称</text>
				</view>
				<view class="dialog-content">
					<input 
						class="dialog-input" 
						:style="{ color: theme.inputText, backgroundColor: theme.inputBg, borderColor: theme.borderColor }"
						v-model="editingGroupName" 
						placeholder="请输入群名称（最多30字）"
						maxlength="30"
						:focus="showEditNameDialog"
					/>
					<text class="dialog-hint" :style="{ color: theme.textTertiary }">{{ editingGroupName.length }}/30</text>
				</view>
				<view class="dialog-footer" :style="{ borderTopColor: theme.borderColor }">
					<view class="dialog-btn dialog-btn-cancel" @click.stop="handleCancelEditName">
						<text class="dialog-btn-text" :style="{ color: theme.textSecondary }">取消</text>
					</view>
					<view class="dialog-btn dialog-btn-confirm" @click.stop="handleConfirmEditName">
						<text class="dialog-btn-text dialog-btn-text-primary" :style="{ color: theme.brandPrimary }">确定</text>
					</view>
				</view>
			</view>
		</view>
		
		<!-- 修改昵称弹窗 -->
		<view v-if="showEditNicknameDialog" class="dialog-mask" :style="{ backgroundColor: theme.overlayMask }" @click.stop="handleCancelEditNickname">
			<view class="dialog-container" :style="{ backgroundColor: theme.cardBg }" @click.stop="">
				<view class="dialog-header" :style="{ borderBottomColor: theme.borderColor }">
					<text class="dialog-title" :style="{ color: theme.textPrimary }">修改我的群昵称</text>
				</view>
				<view class="dialog-content">
					<input 
						class="dialog-input" 
						:style="{ color: theme.inputText, backgroundColor: theme.inputBg, borderColor: theme.borderColor }"
						v-model="editingNickname" 
						placeholder="请输入昵称（最多15字）"
						maxlength="15"
						:focus="showEditNicknameDialog"
					/>
					<text class="dialog-hint" :style="{ color: theme.textTertiary }">{{ editingNickname.length }}/15</text>
				</view>
				<view class="dialog-footer" :style="{ borderTopColor: theme.borderColor }">
					<view class="dialog-btn dialog-btn-cancel" @click.stop="handleCancelEditNickname">
						<text class="dialog-btn-text" :style="{ color: theme.textSecondary }">取消</text>
					</view>
					<view class="dialog-btn dialog-btn-confirm" @click.stop="handleConfirmEditNickname">
						<text class="dialog-btn-text dialog-btn-text-primary" :style="{ color: theme.brandPrimary }">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted } from 'vue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroup, getGroupMembers, updateGroup, getGroupJoinRequestPendingCount, setGroupMemberNickname } from '../../api/group.uts'
	import { getConversationByTarget } from '../../api/conversation.uts'
	import { conversationService } from '../../services/conversation-service.uts'
	import { MessageService, messageService } from '../../services/message-service.uts'
	import { groupService } from '../../services/group-service.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getUserIdStr } from '../../store/user.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { armGroupLifecycleErrorToastSuppression, clearConversationHistory, dissolveGroupAndDeleteConversation, finalizeGroupLifecycleExit, quitGroupAndDeleteConversation, resolveGroupLifecycleErrorNotice } from '../../utils/chat-setting-actions.uts'
	import { MessageType, wsManager } from '../../utils/websocket.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	// 页面参数
	const groupId = ref('')
	const chatId = ref('')
	
	// 当前用户
	const currentUserId = ref<string>('0')

	// 群聊信息
	const groupName = ref('')
	const memberCount = ref(0)
	const myNickname = ref('')
	const groupInfo = ref<any>(null)
	
	// 加载状态
	const loading = ref(false)
	const approvalUpdating = ref(false)
	const memberInviteUpdating = ref(false)
	const muteAllUpdating = ref(false)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	let lifecycleRedirecting = false
	let groupOwnerTransferredNotifyHandler: ((message : any) => void) | null = null
	let realtimeRefreshTask : Promise<void> | null = null
	let lastOwnerTransferToastAt = 0

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})
	
	// 编辑群名称弹窗
	const showEditNameDialog = ref(false)
	const editingGroupName = ref('')
	
	// 编辑昵称弹窗
	const showEditNicknameDialog = ref(false)
	const editingNickname = ref('')

	// 设置状态
	const noDisturb = ref(false)
	const isPinned = ref(false)
	const needApproval = ref(false)
	const allowMemberInvite = ref(true)
	const pendingJoinRequestCount = ref(0)
	const muteAllEnabled = ref(false)

	// 群成员数据
	const allMembers = ref<any[]>([])

	const displayMembers = computed(() : any[] => {
		return allMembers.value.slice(0, 8)
	})

	const canManageJoinRequests = computed(() : boolean => {
		const role = groupInfo.value != null && groupInfo.value.myRole != null ? Number(groupInfo.value.myRole) : 0
		return role === 1 || role === 2
	})

	const canManageGroupMute = computed(() : boolean => {
		return canManageJoinRequests.value
	})

	const canAddMembers = computed(() : boolean => {
		if (groupInfo.value == null) {
			return false
		}
		if (canManageJoinRequests.value) {
			return true
		}
		return allowMemberInvite.value === true
	})

	const canRemoveMembers = computed(() : boolean => {
		return canManageJoinRequests.value
	})

	const isOwner = computed(() : boolean => {
		const role = groupInfo.value != null && groupInfo.value.myRole != null ? Number(groupInfo.value.myRole) : 0
		return role === 2
	})

	const roleLabel = computed(() : string => {
		const role = groupInfo.value != null && groupInfo.value.myRole != null ? Number(groupInfo.value.myRole) : 0
		if (role === 2) {
			return '群主'
		}
		if (role === 1) {
			return '管理员'
		}
		return '成员'
	})

	const roleBadgeClass = computed(() : string => {
		const role = groupInfo.value != null && groupInfo.value.myRole != null ? Number(groupInfo.value.myRole) : 0
		if (role === 2) {
			return 'role-badge-owner'
		}
		if (role === 1) {
			return 'role-badge-admin'
		}
		return 'role-badge-member'
	})

	async function refreshGroupSettingsRealtime(showOwnerToast: boolean = false, oldOwnerId: string = '', newOwnerId: string = ''): Promise<void> {
		if (!groupId.value || lifecycleRedirecting) {
			return
		}
		if (realtimeRefreshTask != null) {
			await realtimeRefreshTask
			return
		}
		realtimeRefreshTask = Promise.resolve().then(async () => {
			await loadGroupInfo()
			if (lifecycleRedirecting) {
				return
			}
			await loadGroupMembers()
			if (lifecycleRedirecting) {
				return
			}
			await loadConversationSettings()
			if (!showOwnerToast) {
				return
			}
			const now = Date.now()
			if (now - lastOwnerTransferToastAt < 1500) {
				return
			}
			lastOwnerTransferToastAt = now
			if (newOwnerId !== '' && newOwnerId === currentUserId.value) {
				uni.showToast({
					title: '你已成为新群主',
					icon: 'none',
					duration: 2200
				})
				return
			}
			if (oldOwnerId !== '' && oldOwnerId === currentUserId.value) {
				uni.showToast({
					title: '你已转让群主身份',
					icon: 'none',
					duration: 2200
				})
				return
			}
			uni.showToast({
				title: '群主已更新',
				icon: 'none',
				duration: 1800
			})
		}).finally(() => {
			realtimeRefreshTask = null
		})
		await realtimeRefreshTask
	}

	let joinRequestCreatedHandler : ((payload : any) => void) | null = null
	let joinRequestAdminRefreshHandler : ((payload : any) => void) | null = null
	
	/**
	 * 加载群组信息
	 */
	async function loadGroupInfo() {
		if (!groupId.value || lifecycleRedirecting) return
		
		try {
			armGroupLifecycleErrorToastSuppression(3000)
			loading.value = true
			const result = await getGroup(groupId.value)
			if (result) {
				groupInfo.value = result
				groupName.value = result.name || ''
				memberCount.value = result.memberCount || 0
				needApproval.value = result.needApproval || false
				allowMemberInvite.value = result.allowMemberInvite !== false
				muteAllEnabled.value = result.muteAll === true
				await loadPendingJoinRequestCount()

				console.log('[GroupSettings] 加载群组信息成功:', result)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载群组信息失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, chatId.value, lifecycleNotice)
				return
			}
			uni.showToast({
				title: '加载群组信息失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 加载群成员列表
	 */
	async function loadGroupMembers() {
		if (!groupId.value || lifecycleRedirecting) return
		
		try {
			armGroupLifecycleErrorToastSuppression(3000)
			const members = await getGroupMembers(groupId.value)
			
			if (members && Array.isArray(members)) {
				allMembers.value = members.map(member => {
					// 查找当前用户的昵称
					if (String(member.userId) === currentUserId.value) {
						myNickname.value = member.nickname || member.userNickname || ''
					}
					
					return {
						id: String(member.userId),
						name: member.nickname || member.userNickname || '未知',
						avatar: normalizeAvatarUrl(member.avatar || member.userAvatar),
						avatarError: false,
						avatarText: getAvatarText(member.nickname || member.userNickname || ''),
						avatarBg: getUserAvatarColor(String(member.userId)),
						role: member.role
					}
				})
				
				console.log('[GroupSettings] 加载群成员成功, 数量:', allMembers.value.length)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载群成员失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, chatId.value, lifecycleNotice)
			}
		}
	}
	
	/**
	 * 加载会话设置
	 */
	async function loadConversationSettings() {
		if (!groupId.value || lifecycleRedirecting) return
		
		try {
			armGroupLifecycleErrorToastSuppression(3000)
			let conversation = chatId.value ? conversationService.getConversation(chatId.value) : null
			if (conversation == null) {
				await conversationService.loadConversations()
				conversation = chatId.value ? conversationService.getConversation(chatId.value) : null
			}
			if (conversation && conversation.chatId) {
				chatId.value = conversation.chatId.toString()
				noDisturb.value = conversation.noDisturb === true
				isPinned.value = conversation.isPinned === true
				return
			}
			// 通过 groupId 查询会话
			const remoteConversation = await getConversationByTarget(groupId.value, 2)

			if (remoteConversation && remoteConversation.chatId) {
				chatId.value = remoteConversation.chatId.toString()
				noDisturb.value = remoteConversation.noDisturb === true
				isPinned.value = remoteConversation.isPinned === true
				
				console.log('[GroupSettings] 加载会话设置成功, chatId:', chatId.value)
			}
		} catch (e) {
			console.error('[GroupSettings] 加载会话设置失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, chatId.value, lifecycleNotice)
			}
		}
	}

	function handleBack() {
		uni.navigateBack()
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowMemberAvatar(member: any): boolean {
		return normalizeAvatarUrl(member != null ? member.avatar : '') !== '' && member.avatarError !== true
	}

	function handleMemberAvatarError(member: any): void {
		if (member == null) {
			return
		}
		member.avatarError = true
	}

	function handleMemberClick(member : any) {
		const userIdParam = encodeIdParam(member.id != null ? String(member.id) : '')
		uni.navigateTo({
			url: '/pages/contacts/user-detail?userId=' + userIdParam
		})
	}

	function handleAddMember() {
		if (!canAddMembers.value) {
			uni.showToast({
				title: '当前群不允许普通成员邀请',
				icon: 'none'
			})
			return
		}
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/contacts/initiate-group?mode=add&groupId=' + groupIdParam
		})
	}

	function handleRemoveMember() {
		if (!canRemoveMembers.value) {
			uni.showToast({
				title: '仅群主或管理员可删除成员',
				icon: 'none'
			})
			return
		}
		// 跳转到成员列表页面，选择要删除的成员
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-members?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value) + '&mode=remove'
		})
	}

	function handleViewAllMembers() {
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-members?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleEditGroupName() {
		editingGroupName.value = groupName.value
		showEditNameDialog.value = true
	}
	
	function handleCancelEditName() {
		showEditNameDialog.value = false
		editingGroupName.value = ''
	}
	
	async function handleConfirmEditName() {
		const newName = editingGroupName.value.trim()
		
		// 验证群名称
		if (!newName) {
			uni.showToast({
				title: '群名称不能为空',
				icon: 'none'
			})
			return
		}
		
		if (newName.length > 30) {
			uni.showToast({
				title: '群名称不能超过30个字',
				icon: 'none'
			})
			return
		}
		
		// 如果名称没有变化，不调用接口
		if (newName === groupName.value) {
			showEditNameDialog.value = false
			return
		}
		
		try {
			await updateGroup({
				id: groupId.value,
				name: newName
			})
			groupName.value = newName
			showEditNameDialog.value = false
			uni.showToast({
				title: '修改成功',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 修改群名称失败:', e)
			uni.showToast({
				title: '修改失败',
				icon: 'none'
			})
		}
	}

	function handleGroupQRCode() {
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-qrcode?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleGroupNotice() {
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-notice?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleGroupFiles() {
		const groupIdParam = encodeIdParam(groupId.value)
		const chatIdParam = encodeIdParam(chatId.value)
		uni.navigateTo({
			url: '/pages/message/chat-files?groupId=' + groupIdParam + '&chatId=' + chatIdParam + '&scene=group'
		})
	}

	function handleChatHistory() {
		const groupIdParam = encodeIdParam(groupId.value)
		const chatIdParam = encodeIdParam(chatId.value)
		uni.navigateTo({
			url: `/pages/message/chat-history?chatId=${chatIdParam}&groupId=${groupIdParam}&groupName=${encodeURIComponent(groupName.value)}`
		})
	}

	async function loadPendingJoinRequestCount() {
		if (!groupId.value || !canManageJoinRequests.value) {
			pendingJoinRequestCount.value = 0
			return
		}
		try {
			const count = await getGroupJoinRequestPendingCount(groupId.value)
			pendingJoinRequestCount.value = count != null ? Number(count) : 0
		} catch (e) {
			console.error('[GroupSettings] 加载待处理入群申请失败:', e)
			pendingJoinRequestCount.value = 0
		}
	}

	function handleJoinRequests() {
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-join-requests?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value)
		})
	}

	function handleTransferOwner() {
		if (!isOwner.value) {
			uni.showToast({
				title: '仅群主可转让群主身份',
				icon: 'none'
			})
			return
		}
		const groupIdParam = encodeIdParam(groupId.value)
		uni.navigateTo({
			url: '/pages/message/group-members?groupId=' + groupIdParam + '&groupName=' + encodeURIComponent(groupName.value) + '&mode=transfer'
		})
	}

	async function handleMemberInviteChange(e : any) {
		const newValue = e.detail.value as boolean
		if (!groupId.value || memberInviteUpdating.value) {
			uni.showToast({
				title: '群信息未加载',
				icon: 'none'
			})
			return
		}
		if (newValue === allowMemberInvite.value) {
			return
		}
		const oldValue = allowMemberInvite.value
		allowMemberInvite.value = newValue
		try {
			memberInviteUpdating.value = true
			await updateGroup({
				id: groupId.value,
				allowMemberInvite: newValue
			})
			if (groupInfo.value != null) {
				groupInfo.value.allowMemberInvite = newValue
			}
			uni.showToast({
				title: newValue ? '已允许成员邀请' : '已关闭成员邀请',
				icon: 'success'
			})
		} catch (e) {
			allowMemberInvite.value = oldValue
			console.error('[GroupSettings] 更新成员邀请权限失败:', e)
			uni.showToast({
				title: '更新失败',
				icon: 'none'
			})
		} finally {
			memberInviteUpdating.value = false
		}
	}

	async function handleMuteAllChange(e : any) {
		const newValue = e.detail.value as boolean
		if (!groupId.value || muteAllUpdating.value) {
			uni.showToast({
				title: '群信息未加载',
				icon: 'none'
			})
			return
		}
		if (newValue === muteAllEnabled.value) {
			return
		}

		const oldValue = muteAllEnabled.value
		muteAllEnabled.value = newValue
		try {
			muteAllUpdating.value = true
			const success = await groupService.muteAll(groupId.value, newValue)
			if (!success) {
				throw new Error('set mute all failed')
			}
			if (groupInfo.value != null) {
				groupInfo.value.muteAll = newValue
			}
			uni.showToast({
				title: newValue ? '已开启全员禁言' : '已关闭全员禁言',
				icon: 'success'
			})
		} catch (e) {
			muteAllEnabled.value = oldValue
			console.error('[GroupSettings] 设置全员禁言失败:', e)
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		} finally {
			muteAllUpdating.value = false
		}
	}

	async function handleNoDisturbChange(e : any) {
		const newValue = e.detail.value as boolean
		
		if (!chatId.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		
		try {
			const success = await conversationService.setMute(chatId.value, newValue)
			if (!success) {
				throw new Error('set mute failed')
			}
			noDisturb.value = newValue
			uni.showToast({
				title: newValue ? '已开启免打扰' : '已关闭免打扰',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 设置免打扰失败:', e)
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		}
	}

	async function handlePinnedChange(e : any) {
		const newValue = e.detail.value as boolean
		
		if (!chatId.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		
		try {
			const success = await conversationService.pinConversation(chatId.value, newValue)
			if (!success) {
				throw new Error('pin failed')
			}
			isPinned.value = newValue
			uni.showToast({
				title: newValue ? '已置顶' : '已取消置顶',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 设置置顶失败:', e)
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		}
	}

	async function handleApprovalChange(e : any) {
		const newValue = e.detail.value as boolean
		if (!groupId.value || approvalUpdating.value) {
			uni.showToast({
				title: '群信息未加载',
				icon: 'none'
			})
			return
		}

		if (newValue === needApproval.value) {
			return
		}

		const oldValue = needApproval.value
		needApproval.value = newValue
		try {
			approvalUpdating.value = true
			await updateGroup({
				id: groupId.value,
				needApproval: newValue
			})
			if (groupInfo.value != null) {
				groupInfo.value.needApproval = newValue
			}
			uni.showToast({
				title: newValue ? '已开启邀请确认' : '已关闭邀请确认',
				icon: 'success'
			})
		} catch (e) {
			needApproval.value = oldValue
			console.error('[GroupSettings] 更新邀请确认失败:', e)
			uni.showToast({
				title: '更新失败',
				icon: 'none'
			})
		} finally {
			approvalUpdating.value = false
		}
	}

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	function handleMyNickname() {
		editingNickname.value = myNickname.value
		showEditNicknameDialog.value = true
	}
	
	function handleCancelEditNickname() {
		showEditNicknameDialog.value = false
		editingNickname.value = ''
	}
	
	async function handleConfirmEditNickname() {
		const newNickname = editingNickname.value.trim()
		
		// 验证昵称
		if (!newNickname) {
			uni.showToast({
				title: '昵称不能为空',
				icon: 'none'
			})
			return
		}
		
		if (newNickname.length > 15) {
			uni.showToast({
				title: '昵称不能超过15个字',
				icon: 'none'
			})
			return
		}
		
		// 如果昵称没有变化，不调用接口
		if (newNickname === myNickname.value) {
			showEditNicknameDialog.value = false
			return
		}

		try {
			await setGroupMemberNickname({
				groupId: groupId.value,
				nickname: newNickname
			})
			groupService.invalidateGroupMembers(groupId.value)
			messageService.invalidateGroupMemberDisplayNameCache(groupId.value)
			myNickname.value = newNickname
			showEditNicknameDialog.value = false
			await loadGroupMembers()
			uni.showToast({
				title: '修改成功',
				icon: 'success'
			})
		} catch (e) {
			console.error('[GroupSettings] 修改昵称失败:', e)
			uni.showToast({
				title: '修改失败',
				icon: 'none'
			})
		}
	}

	function handleClearHistory() {
		uni.showModal({
			title: '清空聊天记录',
			content: '确定要清空聊天记录吗？此操作不可恢复',
			success: (res) => {
				if (res.confirm) {
					clearConversationHistory(chatId.value).then(() => {
							uni.showToast({
								title: '已清空',
								icon: 'success'
							})
					}).catch((e) => {
						console.error('[GroupSettings] 清空聊天记录失败:', e)
						uni.showToast({
							title: '清空失败',
							icon: 'none'
						})
					})
				}
			}
		})
	}

	function handleDeleteAndExit() {
		uni.showModal({
			title: isOwner.value ? '解散群聊' : '退出群聊',
			content: isOwner.value ? '解散后所有成员都将无法继续查看此群，确定要解散吗？' : '退出后将不再接收此群消息，确定要退出吗？',
			success: async (res) => {
				if (res.confirm) {
					try {
						if (isOwner.value) {
							await dissolveGroupAndDeleteConversation(groupId.value, chatId.value)
						} else {
							await quitGroupAndDeleteConversation(groupId.value, chatId.value)
						}
					} catch (e) {
						console.error('[GroupSettings] 退出群聊失败:', e)
						const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, isOwner.value ? '群聊已解散' : '你已不在该群聊')
						if (lifecycleNotice !== '') {
							lifecycleRedirecting = true
							finalizeGroupLifecycleExit(groupId.value, chatId.value, lifecycleNotice)
							return
						}
						uni.showToast({
							title: isOwner.value ? '解散失败' : '退出失败',
							icon: 'none'
						})
					}
				}
			}
		})
	}

	onLoad((options : any) => {
		// 获取当前用户ID
		currentUserId.value = getUserIdStr()
		
		// 获取群组ID
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}
		
		// 获取群名称（临时显示）
		if (options['groupName']) {
			groupName.value = decodeURIComponent(options['groupName'])
		} else if (options['name']) {
			groupName.value = decodeURIComponent(options['name'])
		}
		
		console.log('[GroupSettings] 页面参数:', { groupId: groupId.value, groupName: groupName.value })
	})
	
	onMounted(async () => {
		joinRequestCreatedHandler = (payload : any) => {
			if (payload != null && payload.groupId != null && String(payload.groupId) === groupId.value) {
				void loadPendingJoinRequestCount()
			}
		}
		joinRequestAdminRefreshHandler = (payload : any) => {
			if (payload != null && payload.groupId != null && String(payload.groupId) === groupId.value) {
				void loadPendingJoinRequestCount()
			}
		}
		uni.$on(MessageService.GROUP_JOIN_REQUEST_CREATED_EVENT, joinRequestCreatedHandler)
		uni.$on(MessageService.GROUP_JOIN_REQUEST_ADMIN_REFRESH_EVENT, joinRequestAdminRefreshHandler)
		groupOwnerTransferredNotifyHandler = (message : any) => {
			try {
				const extraRaw: any = message != null && (message as any).header != null ? (message as any).header.extra : null
				if (extraRaw == null || extraRaw === '') {
					return
				}
				const extraObj = typeof extraRaw === 'string' ? JSON.parse(extraRaw) : extraRaw
				if (extraObj == null || String(extraObj.action || '') !== 'group_owner_transferred') {
					return
				}
				const notifyGroupId = extraObj.groupId != null ? String(extraObj.groupId) : ''
				if (notifyGroupId === '' || notifyGroupId !== groupId.value) {
					return
				}
				groupService.invalidateGroup(notifyGroupId)
				groupService.invalidateGroupMembers(notifyGroupId)
				const oldOwnerId = extraObj.oldOwnerId != null ? String(extraObj.oldOwnerId) : ''
				const newOwnerId = extraObj.newOwnerId != null ? String(extraObj.newOwnerId) : ''
				void refreshGroupSettingsRealtime(true, oldOwnerId, newOwnerId)
			} catch (e) {
				console.warn('[GroupSettings] 处理群主转让实时通知失败:', e)
			}
		}
		wsManager.addMessageListener(MessageType.SYSTEM_NOTIFY, groupOwnerTransferredNotifyHandler)

		// 加载数据
		await loadGroupInfo()
		if (lifecycleRedirecting) {
			return
		}
		await loadGroupMembers()
		if (lifecycleRedirecting) {
			return
		}
		await loadConversationSettings()
	})

	onUnmounted(() => {
		if (joinRequestCreatedHandler != null) {
			uni.$off(MessageService.GROUP_JOIN_REQUEST_CREATED_EVENT, joinRequestCreatedHandler)
			joinRequestCreatedHandler = null
		}
		if (joinRequestAdminRefreshHandler != null) {
			uni.$off(MessageService.GROUP_JOIN_REQUEST_ADMIN_REFRESH_EVENT, joinRequestAdminRefreshHandler)
			joinRequestAdminRefreshHandler = null
		}
		if (groupOwnerTransferredNotifyHandler != null) {
			wsManager.removeMessageListener(MessageType.SYSTEM_NOTIFY, groupOwnerTransferredNotifyHandler)
			groupOwnerTransferredNotifyHandler = null
		}
	})
	
	onShow(async () => {
		// 页面显示时刷新数据（从添加成员页面返回时）
		if (groupId.value && !lifecycleRedirecting) {
			console.log('[GroupSettings] 页面显示，刷新数据')
			await loadGroupInfo()
			if (lifecycleRedirecting) {
				return
			}
			await loadGroupMembers()
			if (lifecycleRedirecting) {
				return
			}
			await loadConversationSettings()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	/* 群信息卡片 */
	.group-info-card {
		padding: 20px 16px;
		flex-direction: row;
		align-items: center;
		margin-bottom: 10px;
	}

	.group-avatar {
		width: 60px;
		height: 60px;
		background-color: #10b981;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-right: 16px;
	}

	.group-icon {
		font-size: 32px;
		color: #FFFFFF;
	}

	.group-details {
		flex: 1;
	}

	.group-meta-row {
		flex-direction: row;
		align-items: center;
	}

	.group-name {
		font-size: 18px;
		font-weight: 600;
		margin-bottom: 6px;
	}

	.group-member-count {
		font-size: 14px;
	}

	.role-badge {
		margin-left: 8px;
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 11px;
		font-weight: 600;
	}

	.role-badge-owner {
		background-color: #FFF3E0;
		color: #F57C00;
	}

	.role-badge-admin {
		background-color: #E3F2FD;
		color: #1976D2;
