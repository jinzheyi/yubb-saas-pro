<template>
  <view class="chat-history-container" :style="{ backgroundColor: theme.pageBg }">
    <view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
    
    <!-- 顶部导航栏 -->
    <view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
      <view class="header-left" @click="handleBack">
        <text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
      </view>
      <text class="header-title" :style="{ color: theme.headerText }">聊天记录</text>
      <view class="header-right"></view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
      <view class="search-input-wrapper" :style="{ backgroundColor: theme.inputBg }">
        <text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
        <input
          class="search-input"
          :style="{ color: theme.inputText }"
          v-model="searchKeyword"
          placeholder="搜索聊天记录"
          confirm-type="search"
          @confirm="handleSearch"
        />
      </view>
      <view class="search-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleSearch">
        <text class="search-btn-text">搜索</text>
      </view>
    </view>

    <!-- 时间筛选 -->
    <view class="filter-bar" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
      <view class="filter-item">
        <picker
          mode="date"
          :value="startTime"
          :end="getStartTimeMax()"
          @change="handleStartTimeChange"
        >
          <view class="picker-content" :style="{ backgroundColor: theme.inputBg }">
            <text class="filter-label" :style="{ color: theme.textSecondary }">开始时间</text>
            <text class="filter-value" :style="{ color: theme.textPrimary }">{{ startTimeText || '不限' }}</text>
            <text class="iconfont filter-arrow" :style="{ color: theme.textTertiary }">&#xeb09;</text>
          </view>
        </picker>
      </view>
      <view class="filter-divider"></view>
      <view class="filter-item">
        <picker
          mode="date"
          :value="endTime"
          :start="startTime"
          :end="getTodayDate()"
          @change="handleEndTimeChange"
        >
          <view class="picker-content" :style="{ backgroundColor: theme.inputBg }">
            <text class="filter-label" :style="{ color: theme.textSecondary }">结束时间</text>
            <text class="filter-value" :style="{ color: theme.textPrimary }">{{ endTimeText || '不限' }}</text>
            <text class="iconfont filter-arrow" :style="{ color: theme.textTertiary }">&#xeb09;</text>
          </view>
        </picker>
      </view>
      <view class="reset-btn" :style="{ backgroundColor: theme.cardBgMuted }" @click="resetFilter">
        <text class="reset-btn-text" :style="{ color: theme.textSecondary }">重置</text>
      </view>
    </view>

    <!-- 搜索结果列表 -->
    <scroll-view
      class="result-list"
      scroll-y
      show-scrollbar="false"
      @scrolltolower="loadMore"
    >
      <view v-if="messageList.length === 0 && !loading" class="empty-state">
        <text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xea96;</text>
        <text class="empty-text" :style="{ color: theme.textTertiary }">{{ searched ? '未找到相关聊天记录' : '请输入关键词搜索' }}</text>
      </view>

      <view
        v-for="(message, index) in messageList"
        :key="message.id"
        class="message-item"
        :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }"
        @click="handleMessageClick(message)"
      >
        <view class="message-header">
          <view class="sender-avatar" :style="{ backgroundColor: message.avatarBg }">
            <image
              v-if="showAvatarImage(message)"
              class="sender-avatar-image"
              :src="message.senderAvatar"
              mode="aspectFill"
              @error="handleAvatarError(message)"
            />
            <text v-else class="sender-avatar-text">{{ message.avatarText }}</text>
          </view>
          <view class="message-info">
            <text class="sender-name" :style="{ color: theme.textPrimary }">{{ message.senderNickname }}</text>
            <text class="send-time" :style="{ color: theme.textTertiary }">{{ formatTime(message.sendTime) }}</text>
          </view>
        </view>
        <view class="message-content">
          <rich-text class="content-rich-text" :nodes="getHighlightedContent(message.content)"></rich-text>
        </view>
      </view>

      <view v-if="loading" class="loading-more">
        <text class="loading-text" :style="{ color: theme.textTertiary }">加载中...</text>
      </view>

      <view v-if="!hasMore && messageList.length > 0" class="no-more">
        <text class="no-more-text" :style="{ color: theme.textTertiary }">没有更多了</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { searchMessages } from '../../api/message.uts'
import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import type { ThemeTokens } from '../../config/theme.uts'

// 页面参数
const chatId = ref<string>('')
const groupName = ref<string>('')

// 搜索相关
const searchKeyword = ref<string>('')
const startTime = ref<string>('')
const endTime = ref<string>('')
const searched = ref<boolean>(false)

// 列表数据
const messageList = ref<any[]>([])
const loading = ref<boolean>(false)
const hasMore = ref<boolean>(true)
const pageNo = ref<number>(1)
const pageSize = ref<number>(20)
const theme = ref<ThemeTokens>(getThemeTokens())
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
  theme.value = tokens
})

// 格式化时间显示
const startTimeText = computed(() => {
  return startTime.value ? startTime.value : ''
})

const endTimeText = computed(() => {
  return endTime.value ? endTime.value : ''
})

// 返回上一页
const handleBack = () => {
  uni.navigateBack()
}

// 获取今天的日期（YYYY-MM-DD格式）
const getTodayDate = (): string => {
  const today = new Date()
  const year = today.getFullYear()
  const month = String(today.getMonth() + 1).padStart(2, '0')
  const day = String(today.getDate()).padStart(2, '0')
  return `${year}-${month}-${day}`
}

// 获取开始时间的最大值（结束时间或今天，取较小的）
const getStartTimeMax = (): string => {
  if (endTime.value) {
    return endTime.value
  }
  return getTodayDate()
}

// 页面加载
onLoad((options: any) => {
  if (options.chatId) {
    chatId.value = decodeIdParam(options.chatId)
  }
  if (options.groupName) {
    try {
      groupName.value = decodeURIComponent(String(options.groupName))
    } catch (e) {
      groupName.value = String(options.groupName)
    }
  }
})

const resolveSenderName = (message: any): string => {
  const nickname = message && message.senderNickname != null ? String(message.senderNickname).trim() : ''
  if (nickname !== '') {
    return nickname
  }
  const senderId = message && message.senderId != null ? String(message.senderId).trim() : ''
  if (senderId !== '') {
    return senderId
  }
  return '未知用户'
}

const normalizeAvatarUrl = (value: any): string => {
  const text = value != null ? String(value).trim() : ''
  if (text === '' || text === 'null' || text === 'undefined') {
    return ''
  }
  return text
}

const normalizeMessageItem = (m: any): any => {
  const senderId = m && m.senderId != null ? m.senderId.toString() : null
  const senderName = resolveSenderName(m)
  const senderAvatar = normalizeAvatarUrl(m != null ? m.senderAvatar : '')
  return {
    ...m,
    id: m && m.id != null ? m.id.toString() : '0',
    messageId: m && m.messageId != null ? m.messageId.toString() : null,
    sequence: m && m.sequence != null ? m.sequence.toString() : null,
    senderId: senderId,
    receiverId: m && m.receiverId != null ? m.receiverId.toString() : null,
    groupId: m && m.groupId != null ? m.groupId.toString() : null,
    senderNickname: senderName,
    senderAvatar: senderAvatar,
    avatarText: getAvatarText(senderName),
    avatarBg: getUserAvatarColor(senderId != null && senderId !== '' ? senderId : senderName),
    avatarError: false
  }
}

const showAvatarImage = (message: any): boolean => {
  const senderAvatar = normalizeAvatarUrl(message != null ? message.senderAvatar : '')
  const avatarError = !!(message && message.avatarError)
  return senderAvatar !== '' && !avatarError
}

const handleAvatarError = (message: any) => {
  if (message != null) {
    message.avatarError = true
  }
}

// 执行搜索
const handleSearch = () => {
  if (!chatId.value) {
    uni.showToast({
      title: '会话信息未加载',
      icon: 'none',
      duration: 2000
    })
    return
  }
  if (!searchKeyword.value.trim()) {
    uni.showToast({
      title: '请输入搜索关键词',
      icon: 'none',
      duration: 2000
    })
    return
  }

  // 重置列表
  resetSearchState()
  searched.value = true

  loadMessages()
}

// 加载消息列表
const loadMessages = async () => {
  if (loading.value || !hasMore.value) {
    return
  }

  loading.value = true

  try {
    console.log('[ChatHistory] 开始搜索, 参数:', {
      chatId: chatId.value,
      keyword: searchKeyword.value,
      startTime: startTime.value,
      endTime: endTime.value,
      pageNo: pageNo.value,
      pageSize: pageSize.value
    })
    
    const res = await searchMessages(
      chatId.value,
      searchKeyword.value,
      startTime.value ? `${startTime.value} 00:00:00` : null,
      endTime.value ? `${endTime.value} 23:59:59` : null,
      pageNo.value,
      pageSize.value
    )

    console.log('[ChatHistory] 搜索返回数据:', res)
    
    // 处理返回数据（ID 统一为 string，避免 H5 大整数精度丢失）
    const newMessages = (res.list || []).map((m: any) => normalizeMessageItem(m))
    messageList.value = [...messageList.value, ...newMessages]
    
    // 判断是否还有更多数据
    hasMore.value = newMessages.length >= pageSize.value
    
    console.log('[ChatHistory] 搜索成功, 页码:', pageNo.value, '数量:', newMessages.length, '总数:', messageList.value.length)
    
    // 如果是第一页且没有数据，不显示错误提示（显示空状态即可）
    if (pageNo.value === 1 && newMessages.length === 0) {
      console.log('[ChatHistory] 搜索结果为空')
    }
  } catch (error : any) {
    console.error('[ChatHistory] 搜索聊天记录失败:', error)
    
    // 根据错误类型显示不同的提示
    let errorMsg = '搜索失败，请稍后重试'
    
    if (error && error.msg) {
      errorMsg = error.msg
    } else if (error && error.message) {
      errorMsg = error.message
    } else if (typeof error === 'string') {
      errorMsg = error
    }
    
    // 只在第一页加载失败时显示错误提示
    if (pageNo.value === 1) {
      uni.showToast({
        title: errorMsg,
        icon: 'none',
        duration: 2000
      })
    } else {
      // 加载更多失败时，恢复页码
      pageNo.value--
    }
  } finally {
    loading.value = false
  }
}

// 加载更多
const loadMore = () => {
  if (!searched.value || !hasMore.value || loading.value) {
    return
  }
  pageNo.value++
  loadMessages()
}

const resetSearchState = () => {
  pageNo.value = 1
  messageList.value = []
  hasMore.value = true
}

// 重置筛选
const resetFilter = () => {
  startTime.value = ''
  endTime.value = ''
  resetSearchState()
  if (searchKeyword.value.trim()) {
    searched.value = true
    loadMessages()
    return
  }
  searched.value = false
}

// 开始时间选择
const handleStartTimeChange = (e: any) => {
  const selectedDate = e.detail.value
  const today = getTodayDate()
  
  // 验证：开始时间不能大于今天
  if (selectedDate > today) {
    uni.showToast({
      title: '开始时间不能大于当前日期',
      icon: 'none'
    })
    return
  }
  
  // 验证：开始时间不能大于结束时间
  if (endTime.value && selectedDate > endTime.value) {
    uni.showToast({
      title: '开始时间不能大于结束时间',
      icon: 'none'
    })
    return
  }
  
  startTime.value = selectedDate
  if (searched.value) {
    handleSearch()
  }
}

// 结束时间选择
const handleEndTimeChange = (e: any) => {
  const selectedDate = e.detail.value
  const today = getTodayDate()
  
  // 验证：结束时间不能大于今天
  if (selectedDate > today) {
    uni.showToast({
      title: '结束时间不能大于当前日期',
      icon: 'none'
    })
    return
  }
  
  // 验证：结束时间不能小于开始时间
  if (startTime.value && selectedDate < startTime.value) {
    uni.showToast({
      title: '结束时间不能小于开始时间',
      icon: 'none'
    })
    return
  }
  
  endTime.value = selectedDate
  if (searched.value) {
    handleSearch()
  }
}

// 格式化时间
const formatTime = (timeStr: string): string => {
  if (!timeStr) return ''
  
  const date = new Date(timeStr)
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
  const messageDate = new Date(date.getFullYear(), date.getMonth(), date.getDate())
  
  const diffDays = Math.floor((today.getTime() - messageDate.getTime()) / (1000 * 60 * 60 * 24))
  
  const timeFormat = `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
  
  if (diffDays === 0) {
    return `今天 ${timeFormat}`
  } else if (diffDays === 1) {
    return `昨天 ${timeFormat}`
  } else if (diffDays < 7) {
    return `${diffDays}天前 ${timeFormat}`
  } else {
    return `${date.getMonth() + 1}月${date.getDate()}日 ${timeFormat}`
  }
}

// 获取高亮显示的内容（使用rich-text组件）
const getHighlightedContent = (content: string): string => {
  if (!searchKeyword.value || !content) {
    return content
  }
  
  const keyword = searchKeyword.value.trim()
  if (!keyword) return content
  
  // 转义HTML特殊字符
  const escapeHtml = (text: string): string => {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;')
  }
  
  // 转义关键词中的正则特殊字符
  const escapeRegex = (text: string): string => {
    return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
  }
  
  // 先转义HTML
  const escapedContent = escapeHtml(content)
  const escapedKeyword = escapeRegex(keyword)
  
  // 使用正则表达式进行不区分大小写的匹配和替换
  const regex = new RegExp(`(${escapedKeyword})`, 'gi')
  const highlightedContent = escapedContent.replace(
    regex,
    `<span style="background-color: ${theme.value.brandPrimarySoft}; color: ${theme.value.brandPrimary}; padding: 2px 4px; border-radius: 3px; font-weight: 500;">$1</span>`
  )
  
  return highlightedContent
}

// 点击消息项 - 跳转到聊天页面并定位到该消息
const handleMessageClick = (message: any) => {
  if (!chatId.value) {
    uni.showToast({ title: '会话信息未加载', icon: 'none' })
    return
  }
  const chatIdParam = encodeIdParam(chatId.value)
  const mid = message && message.messageId != null ? String(message.messageId) : (message && message.id != null ? String(message.id) : '')
  const sequence = message && message.sequence != null ? String(message.sequence) : ''
  if (mid === '' || mid === '0') {
    uni.showToast({ title: '无法定位消息', icon: 'none' })
    return
  }
  const url = sequence !== ''
    ? `/pages/message/chat?chatId=${chatIdParam}&entryMode=anchor&anchorSequence=${encodeURIComponent(sequence)}&messageId=${encodeURIComponent(mid)}&highlight=true`
    : `/pages/message/chat?chatId=${chatIdParam}&entryMode=anchor&anchorMessageId=${encodeURIComponent(mid)}&messageId=${encodeURIComponent(mid)}&highlight=true`
  uni.navigateTo({
    url: url
  })
}

onUnload(() => {
  if (unsubscribeTheme != null) {
    unsubscribeTheme()
    unsubscribeTheme = null
  }
})
</script>

<style>
.chat-history-container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.status-bar {
  height: var(--status-bar-height);
}

.header {
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding: 0 12px;
  justify-content: space-between;
  border-bottom-width: 0.5px;
}

.header-left {
  flex-direction: row;
  align-items: center;
  width: 44px;
}

.back-icon {
  font-size: 20px;
}

.header-title {
  font-size: 17px;
  font-weight: 600;
}

.header-right {
  width: 44px;
}

.search-bar {
  flex-direction: row;
  align-items: center;
  padding: 12px 16px;
  border-bottom-width: 0.5px;
}

.search-input-wrapper {
  flex: 1;
  position: relative;
  flex-direction: row;
  align-items: center;
  border-radius: 8px;
  padding: 0 12px;
  margin-right: 12px;
}

.search-icon {
  font-size: 18px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  height: 36px;
  font-size: 15px;
}

.search-btn {
  padding: 8px 16px;
  background-color: #1677FF;
  border-radius: 6px;
  justify-content: center;
  align-items: center;
}

.search-btn-text {
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
}

.filter-bar {
  flex-direction: row;
  align-items: center;
  padding: 12px 16px;
  border-bottom-width: 0.5px;
}

.filter-item {
  flex: 1;
  flex-direction: row;
  align-items: center;
}

.picker-content {
  flex: 1;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  border-radius: 6px;
}

.filter-label {
  font-size: 14px;
  margin-right: 4px;
}

.filter-value {
  flex: 1;
  font-size: 14px;
  font-weight: 500;
}

.filter-arrow {
  font-size: 14px;
}

.filter-divider {
  width: 8px;
}

.reset-btn {
  padding: 8px 16px;
  border-radius: 6px;
  margin-left: 8px;
  justify-content: center;
  align-items: center;
}

.reset-btn-text {
  font-size: 14px;
}

.result-list {
  flex: 1;
  height: 0;
}

.empty-state {
  padding: 100px 16px;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 64px;
  color: #E5E5E5;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 15px;
}

.message-item {
  padding: 16px;
  margin-bottom: 8px;
  border-bottom-width: 0.5px;
  border-bottom-color: #EFF0F1;
}

.message-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.sender-avatar {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  margin-right: 12px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.sender-avatar-image {
  width: 40px;
  height: 40px;
  border-radius: 20px;
}

.sender-avatar-text {
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
}

.message-info {
  flex: 1;
  justify-content: center;
}

.sender-name {
  font-size: 15px;
  font-weight: 500;
  color: #F3F6FA;
  margin-bottom: 4px;
}

.send-time {
  font-size: 12px;
  color: #8893A2;
}

.message-content {
  padding-left: 52px;
}

.content-rich-text {
  font-size: 14px;
  color: #646A73;
  line-height: 1.6;
}

.loading-more,
.no-more {
  padding: 20px 16px;
  align-items: center;
  justify-content: center;
}

.loading-text,
.no-more-text {
  font-size: 13px;
  color: #8893A2;
}
</style>
