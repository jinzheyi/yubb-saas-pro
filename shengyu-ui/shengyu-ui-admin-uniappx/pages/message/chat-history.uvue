<template>
  <view class="chat-history-container">
    <view class="status-bar"></view>
    
    <!-- 顶部导航栏 -->
    <view class="header">
      <view class="header-left" @click="handleBack">
        <text class="iconfont back-icon">&#xeb04;</text>
      </view>
      <text class="header-title">聊天记录</text>
      <view class="header-right"></view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <view class="search-input-wrapper">
        <text class="iconfont search-icon">&#xea6e;</text>
        <input
          class="search-input"
          v-model="searchKeyword"
          placeholder="搜索聊天记录"
          confirm-type="search"
          @confirm="handleSearch"
        />
      </view>
      <view class="search-btn" @click="handleSearch">
        <text class="search-btn-text">搜索</text>
      </view>
    </view>

    <!-- 时间筛选 -->
    <view class="filter-bar">
      <view class="filter-item">
        <picker
          mode="date"
          :value="startTime"
          :end="getStartTimeMax()"
          @change="handleStartTimeChange"
        >
          <view class="picker-content">
            <text class="filter-label">开始时间</text>
            <text class="filter-value">{{ startTimeText || '不限' }}</text>
            <text class="iconfont filter-arrow">&#xeb09;</text>
          </view>
        </picker>
      </view>
      <view class="filter-divider"></view>
      <view class="filter-item">
        <picker
          mode="date"
          :value="endTime"
          :start="startTime"
          :end="getTodayDate()"
          @change="handleEndTimeChange"
        >
          <view class="picker-content">
            <text class="filter-label">结束时间</text>
            <text class="filter-value">{{ endTimeText || '不限' }}</text>
            <text class="iconfont filter-arrow">&#xeb09;</text>
          </view>
        </picker>
      </view>
      <view class="reset-btn" @click="resetFilter">
        <text class="reset-btn-text">重置</text>
      </view>
    </view>

    <!-- 搜索结果列表 -->
    <scroll-view
      class="result-list"
      scroll-y
      show-scrollbar="false"
      @scrolltolower="loadMore"
    >
      <view v-if="messageList.length === 0 && !loading" class="empty-state">
        <text class="iconfont empty-icon">&#xea96;</text>
        <text class="empty-text">{{ searched ? '未找到相关聊天记录' : '请输入关键词搜索' }}</text>
      </view>

      <view
        v-for="(message, index) in messageList"
        :key="message.id"
        class="message-item"
        @click="handleMessageClick(message)"
      >
        <view class="message-header">
          <image
            class="sender-avatar"
            :src="message.senderAvatar || '/static/avatar.jpg'"
            mode="aspectFill"
          />
          <view class="message-info">
            <text class="sender-name">{{ message.senderNickname }}</text>
            <text class="send-time">{{ formatTime(message.sendTime) }}</text>
          </view>
        </view>
        <view class="message-content">
          <rich-text class="content-rich-text" :nodes="getHighlightedContent(message.content)"></rich-text>
        </view>
      </view>

      <view v-if="loading" class="loading-more">
        <text class="loading-text">加载中...</text>
      </view>

      <view v-if="!hasMore && messageList.length > 0" class="no-more">
        <text class="no-more-text">没有更多了</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { searchMessages } from '../../api/message.uts'

// 页面参数
const conversationId = ref<string>('')
const groupName = ref<string>('')

// 搜索相关
const searchKeyword = ref<string>('')
const startTime = ref<string>('')
const endTime = ref<string>('')
const searched = ref<boolean>(false)

// 列表数据
const messageList = ref<any[]>([])
const loading = ref<boolean>(false)
const hasMore = ref<boolean>(true)
const pageNo = ref<number>(1)
const pageSize = ref<number>(20)

// 格式化时间显示
const startTimeText = computed(() => {
  return startTime.value ? startTime.value : ''
})

const endTimeText = computed(() => {
  return endTime.value ? endTime.value : ''
})

// 返回上一页
const handleBack = () => {
  uni.navigateBack()
}

// 获取今天的日期（YYYY-MM-DD格式）
const getTodayDate = (): string => {
  const today = new Date()
  const year = today.getFullYear()
  const month = String(today.getMonth() + 1).padStart(2, '0')
  const day = String(today.getDate()).padStart(2, '0')
  return `${year}-${month}-${day}`
}

// 获取开始时间的最大值（结束时间或今天，取较小的）
const getStartTimeMax = (): string => {
  if (endTime.value) {
    return endTime.value
  }
  return getTodayDate()
}

// 页面加载
onLoad((options: any) => {
  if (options.conversationId) {
    conversationId.value = options.conversationId
  }
  if (options.groupName) {
    groupName.value = options.groupName
  }
})

// 执行搜索
const handleSearch = () => {
  if (!searchKeyword.value.trim()) {
    uni.showToast({
      title: '请输入搜索关键词',
      icon: 'none',
      duration: 2000
    })
    return
  }

  // 重置列表
  pageNo.value = 1
  messageList.value = []
  hasMore.value = true
  searched.value = true

  loadMessages()
}

// 加载消息列表
const loadMessages = async () => {
  if (loading.value || !hasMore.value) {
    return
  }

  loading.value = true

  try {
    console.log('[ChatHistory] 开始搜索, 参数:', {
      conversationId: conversationId.value,
      keyword: searchKeyword.value,
      startTime: startTime.value,
      endTime: endTime.value,
      pageNo: pageNo.value,
      pageSize: pageSize.value
    })
    
    const res = await searchMessages(
      conversationId.value,
      searchKeyword.value,
      startTime.value ? `${startTime.value} 00:00:00` : undefined,
      endTime.value ? `${endTime.value} 23:59:59` : undefined,
      pageNo.value,
      pageSize.value
    )

    console.log('[ChatHistory] 搜索返回数据:', res)
    
    // 处理返回数据
    const newMessages = res.list || []
    messageList.value = [...messageList.value, ...newMessages]
    
    // 判断是否还有更多数据
    hasMore.value = newMessages.length >= pageSize.value
    
    console.log('[ChatHistory] 搜索成功, 页码:', pageNo.value, '数量:', newMessages.length, '总数:', messageList.value.length)
    
    // 如果是第一页且没有数据，不显示错误提示（显示空状态即可）
    if (pageNo.value === 1 && newMessages.length === 0) {
      console.log('[ChatHistory] 搜索结果为空')
    }
  } catch (error : any) {
    console.error('[ChatHistory] 搜索聊天记录失败:', error)
    
    // 根据错误类型显示不同的提示
    let errorMsg = '搜索失败，请稍后重试'
    
    if (error && error.msg) {
      errorMsg = error.msg
    } else if (error && error.message) {
      errorMsg = error.message
    } else if (typeof error === 'string') {
      errorMsg = error
    }
    
    // 只在第一页加载失败时显示错误提示
    if (pageNo.value === 1) {
      uni.showToast({
        title: errorMsg,
        icon: 'none',
        duration: 2000
      })
    } else {
      // 加载更多失败时，恢复页码
      pageNo.value--
    }
  } finally {
    loading.value = false
  }
}

// 加载更多
const loadMore = () => {
  if (!searched.value || !hasMore.value || loading.value) {
    return
  }
  pageNo.value++
  loadMessages()
}

// 重置筛选
const resetFilter = () => {
  startTime.value = ''
  endTime.value = ''
  if (searched.value) {
    handleSearch()
  }
}

// 开始时间选择
const handleStartTimeChange = (e: any) => {
  const selectedDate = e.detail.value
  const today = getTodayDate()
  
  // 验证：开始时间不能大于今天
  if (selectedDate > today) {
    uni.showToast({
      title: '开始时间不能大于当前日期',
      icon: 'none'
    })
    return
  }
  
  // 验证：开始时间不能大于结束时间
  if (endTime.value && selectedDate > endTime.value) {
    uni.showToast({
      title: '开始时间不能大于结束时间',
      icon: 'none'
    })
    return
  }
  
  startTime.value = selectedDate
  if (searched.value) {
    handleSearch()
  }
}

// 结束时间选择
const handleEndTimeChange = (e: any) => {
  const selectedDate = e.detail.value
  const today = getTodayDate()
  
  // 验证：结束时间不能大于今天
  if (selectedDate > today) {
    uni.showToast({
      title: '结束时间不能大于当前日期',
      icon: 'none'
    })
    return
  }
  
  // 验证：结束时间不能小于开始时间
  if (startTime.value && selectedDate < startTime.value) {
    uni.showToast({
      title: '结束时间不能小于开始时间',
      icon: 'none'
    })
    return
  }
  
  endTime.value = selectedDate
  if (searched.value) {
    handleSearch()
  }
}

// 格式化时间
const formatTime = (timeStr: string): string => {
  if (!timeStr) return ''
  
  const date = new Date(timeStr)
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
  const messageDate = new Date(date.getFullYear(), date.getMonth(), date.getDate())
  
  const diffDays = Math.floor((today.getTime() - messageDate.getTime()) / (1000 * 60 * 60 * 24))
  
  const timeFormat = `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`
  
  if (diffDays === 0) {
    return `今天 ${timeFormat}`
  } else if (diffDays === 1) {
    return `昨天 ${timeFormat}`
  } else if (diffDays < 7) {
    return `${diffDays}天前 ${timeFormat}`
  } else {
    return `${date.getMonth() + 1}月${date.getDate()}日 ${timeFormat}`
  }
}

// 获取高亮显示的内容（使用rich-text组件）
const getHighlightedContent = (content: string): string => {
  if (!searchKeyword.value || !content) {
    return content
  }
  
  const keyword = searchKeyword.value.trim()
  if (!keyword) return content
  
  // 转义HTML特殊字符
  const escapeHtml = (text: string): string => {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;')
  }
  
  // 转义关键词中的正则特殊字符
  const escapeRegex = (text: string): string => {
    return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
  }
  
  // 先转义HTML
  const escapedContent = escapeHtml(content)
  const escapedKeyword = escapeRegex(keyword)
  
  // 使用正则表达式进行不区分大小写的匹配和替换
  const regex = new RegExp(`(${escapedKeyword})`, 'gi')
  const highlightedContent = escapedContent.replace(
    regex,
    '<span style="background-color: #FFF3CD; color: #856404; padding: 2px 4px; border-radius: 3px; font-weight: 500;">$1</span>'
  )
  
  return highlightedContent
}

// 点击消息项 - 跳转到聊天页面并定位到该消息
const handleMessageClick = (message: any) => {
  // 跳转到聊天页面，传递消息ID用于定位
  uni.navigateTo({
    url: `/pages/message/chat?conversationId=${conversationId.value}&messageId=${message.id}&highlight=true`
  })
}
</script>

<style>
