  height: 100%;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
}

.status-bar {
  height: var(--status-bar-height);
  background-color: #FFFFFF;
}

.header {
  background-color: #FFFFFF;
  height: 44px;
  flex-direction: row;
  align-items: center;
  padding: 0 12px;
  justify-content: space-between;
  border-bottom-width: 0.5px;
  border-bottom-color: #EFF0F1;
}

.header-left {
  flex-direction: row;
  align-items: center;
  width: 44px;
}

.back-icon {
  color: #1F2329;
  font-size: 20px;
}

.header-title {
  color: #1F2329;
  font-size: 17px;
  font-weight: 600;
}

.header-right {
  width: 44px;
}

.search-bar {
  flex-direction: row;
  align-items: center;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-bottom-width: 0.5px;
  border-bottom-color: #EFF0F1;
}

.search-input-wrapper {
  flex: 1;
  position: relative;
  flex-direction: row;
  align-items: center;
  background-color: #F5F7FA;
  border-radius: 8px;
  padding: 0 12px;
  margin-right: 12px;
}

.search-icon {
  font-size: 18px;
  color: #8F959E;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  height: 36px;
  font-size: 15px;
  color: #1F2329;
}

.search-btn {
  padding: 8px 16px;
  background-color: #1677FF;
  border-radius: 6px;
  justify-content: center;
  align-items: center;
}

.search-btn-text {
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
}

.filter-bar {
  flex-direction: row;
  align-items: center;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-bottom-width: 0.5px;
  border-bottom-color: #EFF0F1;
}

.filter-item {
  flex: 1;
  flex-direction: row;
  align-items: center;
}

.picker-content {
  flex: 1;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  background-color: #F5F7FA;
  border-radius: 6px;
}

.filter-label {
  font-size: 14px;
  color: #646A73;
  margin-right: 4px;
}

.filter-value {
  flex: 1;
  font-size: 14px;
  color: #1F2329;
  font-weight: 500;
}

.filter-arrow {
  font-size: 14px;
  color: #8F959E;
}

.filter-divider {
  width: 8px;
}

.reset-btn {
  padding: 8px 16px;
  background-color: #F5F7FA;
  border-radius: 6px;
  margin-left: 8px;
  justify-content: center;
  align-items: center;
}

.reset-btn-text {
  font-size: 14px;
  color: #646A73;
}

.result-list {
  flex: 1;
  height: 0;
}

.empty-state {
  padding: 100px 16px;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 64px;
  color: #E5E5E5;
  margin-bottom: 16px;
}

.empty-text {
  color: #8F959E;
  font-size: 15px;
}

.message-item {
  background-color: #FFFFFF;
  padding: 16px;
  margin-bottom: 8px;
  border-bottom-width: 0.5px;
  border-bottom-color: #EFF0F1;
}

.message-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.sender-avatar {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  margin-right: 12px;
}

.message-info {
  flex: 1;
  justify-content: center;
}

.sender-name {
  font-size: 15px;
  font-weight: 500;
  color: #1F2329;
  margin-bottom: 4px;
}

.send-time {
  font-size: 12px;
  color: #8F959E;
}

.message-content {
  padding-left: 52px;
}

.content-rich-text {
  font-size: 14px;
  color: #646A73;
  line-height: 1.6;
}

.loading-more,
.no-more {
  padding: 20px 16px;
  align-items: center;
  justify-content: center;
}

.loading-text,
.no-more-text {
  font-size: 13px;
  color: #8F959E;
}
</style>
