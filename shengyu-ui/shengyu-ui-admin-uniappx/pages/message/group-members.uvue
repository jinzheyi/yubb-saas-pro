<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ mode === 'remove' ? '取消' : t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ mode === 'remove' ? '删除群成员' : '群成员(' + filteredMembers.length + ')' }}</text>
			<view class="header-right">
				<text v-if="mode === 'remove' && selectedMembers.length > 0" class="confirm-text" :style="{ color: theme.brandPrimary }" @click="handleConfirmRemove">
					确定({{ selectedMembers.length }})
				</text>
			</view>
		</view>

		<view class="search-wrap" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" v-model="searchKeyword" placeholder="搜索群成员" placeholder-class="placeholder" @input="handleSearch" />
			</view>
		</view>

		<scroll-view class="member-list" scroll-y="true" show-scrollbar="false" :scroll-into-view="scrollIntoView">
			<!-- 加载状态 -->
			<view v-if="loading" class="loading-wrap">
				<text class="loading-text" :style="{ color: theme.textTertiary }">加载中...</text>
			</view>
			
			<!-- 按字母分组 -->
			<view v-else class="letter-group" v-for="group in memberGroups" :key="group.letter" :id="'letter-' + group.letter">
				<text class="letter-title" :style="{ color: theme.textTertiary, backgroundColor: theme.pageBg }">{{ group.letter }}</text>
				
				<!-- 成员项 -->
				<view class="member-item" :style="{ borderBottomColor: theme.borderColor }" v-for="member in group.members" :key="member.id" @click="handleMemberClick(member)" @longpress="handleMemberLongPress(member)">
					<!-- 删除模式：显示复选框 -->
					<view v-if="mode === 'remove'" class="checkbox-wrap">
						<view class="checkbox" :style="{ backgroundColor: member.selected ? theme.brandPrimary : theme.cardBg, borderColor: member.selected ? theme.brandPrimary : theme.borderColor }" :class="{ checked: member.selected, disabled: member.cannotRemove }">
							<text v-if="member.selected" class="iconfont check-icon">&#xe60c;</text>
						</view>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<image
							v-if="shouldShowAvatar(member)"
							class="member-avatar-image"
							:src="member.avatar"
							mode="aspectFill"
							@error="handleAvatarError(member)"
						/>
						<text v-else class="member-avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
						<text class="member-role" :style="{ color: theme.textTertiary }" v-if="isMemberMuted(member)">{{ formatMuteEndTime(member.muteEndTime) }}</text>
						<text class="member-role" :style="{ color: theme.textTertiary }" v-else-if="member.deptName">{{ member.deptName }}</text>
					</view>
					<text v-if="member.isOwner" class="member-badge owner-badge">群主</text>
					<text v-else-if="member.isAdmin" class="member-badge admin-badge">管理员</text>
					<text v-if="isMemberMuted(member)" class="member-badge mute-badge">已禁言</text>
				</view>
			</view>
		</scroll-view>

		<!-- 字母索引 -->
		<view class="letter-index">
			<text class="index-letter" v-for="letter in letters" :key="letter" @click="scrollToLetter(letter)">
				{{ letter }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { getGroupMembers, removeGroupMember, setGroupMemberRole } from '../../api/group.uts'
	import { groupService } from '../../services/group-service.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getUserIdStr } from '../../store/user.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	const searchKeyword = ref('')
	const scrollIntoView = ref('')
	const loading = ref(false)
	
	// 页面参数
	const groupId = ref('')
	const groupName = ref('')
	const mode = ref('view') // view-查看模式, remove-删除模式
	const currentUserId = ref<string>('0')
	const currentUserRole = ref<number>(0)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})
	
	// 成员数据
	const allMembers = ref<any[]>([])
	const selectedMembers = computed(() : any[] => {
		return allMembers.value.filter(m => m.selected)
	})

	function normalizeMuteEndTime(raw: any): number {
		if (raw == null || raw === '') {
			return 0
		}
		try {
			const ts = new Date(String(raw)).getTime()
			if (!isNaN(ts) && ts > 0) {
				return ts
			}
		} catch (e) {
			// ignore
		}
		const numVal = Number(raw)
		return !isNaN(numVal) && numVal > 0 ? numVal : 0
	}

	function isMemberMuted(member: any): boolean {
		const muteEndTime = member != null && member.muteEndTime != null ? Number(member.muteEndTime) : 0
		return muteEndTime > Date.now()
	}

	function formatMuteEndTime(muteEndTime: number): string {
		if (muteEndTime <= 0) {
			return ''
		}
		try {
			const d = new Date(muteEndTime)
			const month = (d.getMonth() + 1).toString().padStart(2, '0')
			const day = d.getDate().toString().padStart(2, '0')
			const hour = d.getHours().toString().padStart(2, '0')
			const minute = d.getMinutes().toString().padStart(2, '0')
			return `禁言至 ${month}-${day} ${hour}:${minute}`
		} catch (e) {
			return '已禁言'
		}
	}
	
	/**
	 * 获取拼音首字母
	 */
	function getPinyinFirstLetter(name : string) : string {
		const code = name.charCodeAt(0)
		if (code >= 19968 && code <= 40869) {
			const index = (code - 19968) % 26
			return String.fromCharCode(65 + index)
		}
		return name.charAt(0).toUpperCase()
	}
	
	/**
	 * 加载群成员列表
	 */
	async function loadMembers() {
		if (!groupId.value) return
		
		loading.value = true
		try {
			const members = await getGroupMembers(groupId.value)
			
			if (members && Array.isArray(members)) {
				let myRole = 0
				try {
					for (let i = 0; i < (members as any[]).length; i++) {
						const m: any = (members as any[])[i]
						const uid = m != null && m.userId != null ? m.userId.toString() : ''
						if (uid !== '' && uid === currentUserId.value) {
							myRole = m != null && m.role != null ? Number(m.role) : 0
							break
						}
					}
				} catch (e) {
					myRole = 0
				}
				currentUserRole.value = myRole

				allMembers.value = members.map(member => {
					const displayName = member.nickname || member.userNickname || '未知'
					const pinyinLetter = getPinyinFirstLetter(displayName)
					const roleNum = member.role != null ? Number(member.role) : 0
					
					// 判断角色
					const isOwner = roleNum === 2
					const isAdmin = roleNum === 1
					
					// 判断是否可以删除（群主和当前用户自己不能删除）
					const uid = member.userId != null ? member.userId.toString() : ''
					const cannotRemove = isOwner || uid === currentUserId.value
					
					return {
						id: uid,
						name: displayName,
						deptName: member.deptName || '',
						avatar: member.avatar != null ? String(member.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(uid),
						pinyin: pinyinLetter,
						isOwner: isOwner,
						isAdmin: isAdmin,
						role: roleNum,
						muteEndTime: normalizeMuteEndTime(member.muteEndTime),
						selected: false,
						cannotRemove: cannotRemove
					}
				})
				
				console.log('[GroupMembers] 加载成员成功, 数量:', allMembers.value.length)
			}
		} catch (e) {
			console.error('[GroupMembers] 加载成员失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	// 过滤后的成员
	const filteredMembers = computed(() : any[] => {
		if (!searchKeyword.value) {
			return allMembers.value
		}
		return allMembers.value.filter(member => {
			return member.name.includes(searchKeyword.value)
		})
	})

	// 按字母分组
	const memberGroups = computed(() : any[] => {
		const groups : any = {}
		filteredMembers.value.forEach(member => {
			const letter = member.pinyin
			if (!groups[letter]) {
				groups[letter] = []
			}
			groups[letter].push(member)
		})
		
		return Object.keys(groups).sort().map(letter => ({
			letter,
			members: groups[letter]
		}))
	})

	// 字母列表
	const letters = computed(() : string[] => {
		return memberGroups.value.map(group => group.letter)
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleSearch() {
		// 搜索逻辑已在 computed 中实现
	}

	function handleMemberClick(member : any) {
		// 删除模式：切换选中状态
		if (mode.value === 'remove') {
			// 不能删除群主和自己
			if (member.cannotRemove) {
				uni.showToast({
					title: member.isOwner ? '不能删除群主' : '不能删除自己',
					icon: 'none'
				})
				return
			}
			member.selected = !member.selected
			return
		}
		
		// 查看模式：跳转到用户详情（传递 userId 参数）
		const userIdParam = encodeIdParam(member.id != null ? String(member.id) : '')
		uni.navigateTo({
			url: '/pages/contacts/user-detail?userId=' + userIdParam + '&name=' + encodeURIComponent(member.name)
		})
	}

	function handleMemberLongPress(member: any) {
		try {
			if (mode.value !== 'view') {
				return
			}
			if (groupId.value === '') {
				return
			}
			// 仅群主/管理员可进行成员管理
			if (currentUserRole.value !== 1 && currentUserRole.value !== 2) {
				return
			}
			if (member == null) {
				return
			}
			if (member.id == null || member.id === '' || member.id === '0') {
				return
			}
			// 不允许对群主本人操作
			if (member.isOwner === true) {
				return
			}
			// 不允许对自己操作
			if (member.id === currentUserId.value) {
				return
			}

			const itemList: string[] = []
			const actionKeys: string[] = []
			if (currentUserRole.value === 2) {
				const toAdmin = member.isAdmin !== true
				itemList.push(toAdmin ? '设为管理员' : '取消管理员')
				actionKeys.push(toAdmin ? 'set_admin' : 'remove_admin')
			}
			if (isMemberMuted(member)) {
				itemList.push('解除禁言')
				actionKeys.push('unmute')
			} else {
				itemList.push('禁言24小时')
				actionKeys.push('mute')
			}
			if (itemList.length === 0) {
				return
			}
			uni.showActionSheet({
				itemList: itemList,
				itemColor: theme.value.brandPrimary,
				success: async (res) => {
					if (res.tapIndex < 0 || res.tapIndex >= actionKeys.length) {
						return
					}
					const actionKey = actionKeys[res.tapIndex]
					uni.showLoading({ title: '处理中...' })
					try {
						if (actionKey === 'set_admin') {
							await setGroupMemberRole(groupId.value, member.id.toString(), 1)
						} else if (actionKey === 'remove_admin') {
							await setGroupMemberRole(groupId.value, member.id.toString(), 0)
						} else if (actionKey === 'mute') {
							const success = await groupService.muteMember(groupId.value, member.id.toString(), 24)
							if (!success) {
								throw new Error('mute member failed')
							}
						} else if (actionKey === 'unmute') {
							const success = await groupService.unmuteMember(groupId.value, member.id.toString())
							if (!success) {
								throw new Error('unmute member failed')
							}
						}
						uni.hideLoading()
						uni.showToast({ title: '操作成功', icon: 'success' })
						await loadMembers()
					} catch (e) {
						uni.hideLoading()
						uni.showToast({ title: '操作失败', icon: 'none' })
					}
				},
				fail: () => {
					// ignore
				}
			})
		} catch (e) {
			// ignore
		}
	}
	
	/**
	 * 确认删除成员
	 */
	function handleConfirmRemove() {
		const selected = selectedMembers.value
		if (selected.length === 0) {
			uni.showToast({
				title: '请选择要删除的成员',
				icon: 'none'
			})
			return
		}
		
		const memberNames = selected.map(m => m.name).join('、')
		uni.showModal({
			title: '删除群成员',
			content: `确定要删除 ${memberNames} 吗？`,
			success: async (res) => {
				if (res.confirm) {
					await performRemoveMembers(selected)
				}
			}
		})
	}
	
	/**
	 * 执行删除成员操作
	 */
	async function performRemoveMembers(members : any[]) {
		uni.showLoading({
			title: '删除中...'
		})
		
		try {
			// 逐个删除成员
			for (let i = 0; i < members.length; i++) {
				const member = members[i]
				await removeGroupMember(groupId.value, member.id.toString())
				console.log('[GroupMembers] 删除成员成功:', member.name)
			}
			
			uni.hideLoading()
			uni.showToast({
				title: '删除成功',
				icon: 'success'
			})
			
			// 延迟返回
			setTimeout(() => {
				uni.navigateBack()
			}, 1000)
			
		} catch (e) {
			uni.hideLoading()
			console.error('[GroupMembers] 删除成员失败:', e)
			uni.showToast({
				title: '删除失败',
				icon: 'none'
			})
		}
	}

	function scrollToLetter(letter : string) {
		scrollIntoView.value = 'letter-' + letter
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(member: any): boolean {
		return normalizeAvatarUrl(member != null ? member.avatar : '') !== '' && member.avatarError !== true
	}

	function handleAvatarError(member: any): void {
		if (member == null) {
			return
		}
		member.avatarError = true
	}
	
	onLoad((options : any) => {
		// 获取当前用户ID
		currentUserId.value = getUserIdStr()
		
		// 获取页面参数
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}
		if (options['groupName']) {
			groupName.value = decodeURIComponent(options['groupName'])
		}
		if (options['mode']) {
			mode.value = options['mode'] as string
		}
		
		console.log('[GroupMembers] 页面参数:', { groupId: groupId.value, mode: mode.value })
		
		// 加载成员列表
		loadMembers()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
		align-items: flex-end;
	}
	
	.confirm-text {
		color: #1677FF;
		font-size: 15px;
		font-weight: 500;
	}

	.search-wrap {
		padding: 10px 16px;
		border-bottom-width: 0.5px;
	}

	.search-bar {
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.placeholder {
	}

	.member-list {
		flex: 1;
		height: 0;
		padding-right: 30px;
	}

	.letter-group {
		padding: 0 16px;
	}

	.letter-title {
		font-size: 14px;
		font-weight: 600;
		padding: 8px 0;
		margin: 0 -16px;
		padding-left: 16px;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.member-item-last {
		border-bottom-width: 0;
	}
	
	.checkbox-wrap {
		margin-right: 12px;
	}
	
	.checkbox {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		border-width: 1.5px;
		border-color: #C4C6CC;
		border-style: solid;
		justify-content: center;
		align-items: center;
	}
	
	.checkbox.checked {
		background-color: #1677FF;
		border-color: #1677FF;
	}
	
	.checkbox.disabled {
		border-color: #E5E7EB;
		opacity: 0.6;
	}
	
	.check-icon {
		font-size: 12px;
		color: #FFFFFF;
	}

	.member-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.member-avatar-image {
		width: 44px;
		height: 44px;
		border-radius: 8px;
	}

	.member-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.member-info {
		flex: 1;
	}

	.member-name {
		font-size: 15px;
		margin-bottom: 4px;
	}

	.member-role {
		font-size: 12px;
	}

	.member-badge {
		font-size: 11px;
		padding: 2px 8px;
		border-radius: 4px;
		margin-left: 8px;
	}

	.owner-badge {
		background-color: #FFF3E0;
		color: #F57C00;
	}

	.admin-badge {
		background-color: #E3F2FD;
		color: #1976D2;
	}

	.mute-badge {
		background-color: #FDECEC;
		color: #D14343;
	}

	.letter-index {
		position: fixed;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		flex-direction: column;
		align-items: center;
		padding: 4px;
		z-index: 100;
	}

	.index-letter {
		font-size: 11px;
		color: #1677FF;
		padding: 2px 6px;
		font-weight: 600;
	}
	
	.loading-wrap {
		padding: 40px 0;
		justify-content: center;
		align-items: center;
	}
	
	.loading-text {
		font-size: 14px;
	}
</style>
