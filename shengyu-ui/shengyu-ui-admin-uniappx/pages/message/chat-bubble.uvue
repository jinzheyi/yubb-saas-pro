<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">聊天气泡</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 预览区域 -->
			<view class="preview-section">
				<text class="preview-title">预览效果</text>
				<view class="preview-chat">
					<!-- 对方消息 -->
					<view class="message-item message-other">
						<view class="message-avatar other-avatar">
							<text class="avatar-text">对方</text>
						</view>
						<view class="message-bubble other-bubble">
							<text class="message-text">这是对方的消息</text>
						</view>
					</view>

					<!-- 我的消息 -->
					<view class="message-item message-self">
						<view class="message-bubble self-bubble" :style="{ backgroundColor: selectedColor }">
							<text class="message-text" :style="{ color: getTextColor(selectedColor) }">这是我的消息</text>
						</view>
						<view class="message-avatar self-avatar">
							<text class="avatar-text">我</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 颜色选择 -->
			<view class="color-section">
				<text class="section-title">选择颜色</text>
				<view class="color-grid">
					<view class="color-item" v-for="color in colorList" :key="color.value" @click="selectColor(color.value)">
						<view class="color-block" :style="{ backgroundColor: color.value }">
							<text v-if="selectedColor === color.value" class="iconfont check-icon">&#xe65f;</text>
						</view>
						<text class="color-name">{{ color.name }}</text>
					</view>
				</view>
			</view>

			<!-- 自定义颜色 -->
			<view class="custom-section">
				<text class="section-title">自定义颜色</text>
				<view class="custom-color-row">
					<view class="custom-color-preview" :style="{ backgroundColor: customColor }"></view>
					<input class="custom-color-input" v-model="customColor" placeholder="#1677FF" />
					<button class="apply-btn" @click="applyCustomColor">
						<text class="apply-btn-text">应用</text>
					</button>
				</view>
				<text class="custom-tip">输入十六进制颜色代码，如：#1677FF</text>
			</view>
		</scroll-view>

		<!-- 底部按钮 -->
		<view class="footer">
			<button class="reset-btn" @click="resetColor">
				<text class="reset-btn-text">恢复默认</text>
			</button>
			<button class="confirm-btn" @click="confirmColor">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const selectedColor = ref('#D2E3FC')
	const customColor = ref('')

	const colorList = [
		{ name: '默认蓝', value: '#D2E3FC' },
		{ name: '清新绿', value: '#C8E6C9' },
		{ name: '温暖橙', value: '#FFE0B2' },
		{ name: '浪漫粉', value: '#F8BBD0' },
		{ name: '优雅紫', value: '#E1BEE7' },
		{ name: '天空蓝', value: '#B3E5FC' },
		{ name: '柠檬黄', value: '#FFF9C4' },
		{ name: '薄荷绿', value: '#B2DFDB' }
	]

	function handleBack() {
		uni.navigateBack()
	}

	function selectColor(color : string) {
		selectedColor.value = color
	}

	function applyCustomColor() {
		if (!customColor.value) {
			uni.showToast({
				title: '请输入颜色代码',
				icon: 'none'
			})
			return
		}

		// 验证颜色代码格式
		const colorRegex = /^#[0-9A-Fa-f]{6}$/
		if (!colorRegex.test(customColor.value)) {
			uni.showToast({
				title: '颜色代码格式错误',
				icon: 'none'
			})
			return
		}

		selectedColor.value = customColor.value
		uni.showToast({
			title: '已应用自定义颜色',
			icon: 'success'
		})
	}

	function resetColor() {
		selectedColor.value = '#D2E3FC'
		customColor.value = ''
		uni.showToast({
			title: '已恢复默认颜色',
			icon: 'success'
		})
	}

	function confirmColor() {
		// 保存颜色设置到本地存储
		// uni.setStorageSync('chatBubbleColor', selectedColor.value)
		
		uni.showToast({
			title: '设置成功',
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}

	function getTextColor(bgColor : string) : string {
		// 简单判断：浅色背景用深色文字，深色背景用浅色文字
		// 实际项目中可以使用更精确的算法
		const lightColors = ['#FFE0B2', '#FFF9C4', '#B3E5FC', '#C8E6C9', '#B2DFDB']
		return lightColors.includes(bgColor) ? '#1F2329' : '#1F2329'
	}

	onLoad(() => {
		// 从本地存储加载颜色设置
		// const savedColor = uni.getStorageSync('chatBubbleColor')
		// if (savedColor) {
		//   selectedColor.value = savedColor
		// }
	})
</script>

