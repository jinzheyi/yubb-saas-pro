<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg }">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.forwardCombineDetail.title') }}</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view v-if="comment !== ''" class="comment" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }">
				<text class="comment-text" :style="{ color: theme.textPrimary }">{{ comment }}</text>
			</view>

			<view v-for="(item, idx) in items" :key="idx" class="item" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }" @click="handleItemClick(item)">
				<view class="item-header">
					<text class="sender-name" :style="{ color: theme.textPrimary }">{{ item.senderName }}</text>
					<text class="send-time" :style="{ color: theme.textTertiary }">{{ item.sendTime }}</text>
				</view>
				<text class="item-content" :style="{ color: theme.textSecondary }" :numberOfLines="3">{{ item.preview }}</text>
			</view>

			<view v-if="items.length === 0" class="empty">
				<text class="empty-text" :style="{ color: theme.textTertiary }">{{ emptyText }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { useI18n } from '../../hooks/useI18n.uts'
import { getMessageDetail } from '../../api/message.uts'
import { encodeIdParam } from '../../utils/id-param.uts'
import { createNavState } from '../../utils/nav-state.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import type { ThemeTokens } from '../../config/theme.uts'

const { t } = useI18n()

type ForwardCombineItem = {
	messageId: string
	sourceChatId: string
	sourceSequence?: string
	senderName: string
	sendTime: string
	preview: string
	refMessageId: string
}

const items = ref<ForwardCombineItem[]>([])
const comment = ref('')
const emptyText = ref('')
const MAX_FORWARD_COMBINE_DEPTH = 20
const currentDepth = ref(0)
const visitedIds = ref<string[]>([])
const theme = ref<ThemeTokens>(getThemeTokens())
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
	theme.value = tokens
})

function handleBack(): void {
	uni.navigateBack()
}

async function handleItemClick(item: ForwardCombineItem): Promise<void> {
	try {
		if (item.refMessageId != null && item.refMessageId !== '' && item.refMessageId !== '0') {
			const nextDepth = currentDepth.value + 1
			if (nextDepth > MAX_FORWARD_COMBINE_DEPTH) {
				uni.showToast({ title: t('chat.forwardCombineDetail.quoteTooDeep'), icon: 'none' })
				return
			}
			const chain = visitedIds.value != null ? visitedIds.value : []
			if (chain.includes(item.refMessageId)) {
				uni.showToast({ title: t('chat.forwardCombineDetail.circularReference'), icon: 'none' })
				return
			}
			const nextTrace = chain.concat([item.refMessageId]).join(',')
			uni.navigateTo({
				url: `/pages/message/forward-combine-detail?messageId=${encodeURIComponent(item.refMessageId)}&depth=${encodeURIComponent(String(nextDepth))}&trace=${encodeURIComponent(nextTrace)}`
			})
			return
		}
		if (item.sourceChatId != null && item.sourceChatId !== '' && item.sourceChatId !== '0'
			&& item.messageId != null && item.messageId !== '' && item.messageId !== '0') {
			const chatIdParam = encodeIdParam(item.sourceChatId)
			const sourceSequence = item.sourceSequence != null ? String(item.sourceSequence) : ''
			let targetUrl = sourceSequence !== '' && sourceSequence !== '0'
				? `/pages/message/chat?chatId=${chatIdParam}&entryMode=anchor&anchorSequence=${encodeURIComponent(sourceSequence)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
				: `/pages/message/chat?chatId=${chatIdParam}&entryMode=anchor&anchorMessageId=${encodeURIComponent(item.messageId)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
			const payload: any = {
				chatId: item.sourceChatId,
				messageId: item.messageId,
				entryMode: 'anchor',
				highlight: 'true',
				fromMergeDetail: '1',
				mergeBackDelta: String(currentDepth.value + 2)
			}
			if (sourceSequence !== '' && sourceSequence !== '0') {
				payload.anchorSequence = sourceSequence
			} else {
				payload.anchorMessageId = item.messageId
			}
			try {
				const convServiceModule = await import('../../services/conversation-service.uts')
				const cs = (convServiceModule as any).conversationService
				let conv: any = cs != null ? cs.getConversation(item.sourceChatId) : null
				if (conv == null && cs != null) {
					await cs.loadConversations()
					conv = cs.getConversation(item.sourceChatId)
				}
				if (conv != null) {
					const type = Number((conv as any).conversationType) === 2 ? 'group' : 'single'
					const targetId = (conv as any).targetId != null ? String((conv as any).targetId) : ''
					const targetParam = encodeIdParam(targetId)
					const convName = (conv as any).targetName != null ? String((conv as any).targetName) : ''
					if (type === 'group') {
						const count = (conv as any).groupMemberCount != null ? String((conv as any).groupMemberCount) : '0'
						payload.type = 'group'
						payload.groupId = targetId
						payload.targetId = targetId
						payload.name = convName
						payload.memberCount = count
						targetUrl = sourceSequence !== '' && sourceSequence !== '0'
							? `/pages/message/chat?chatId=${chatIdParam}&type=group&groupId=${targetParam}&targetId=${targetParam}&name=${encodeURIComponent(convName)}&memberCount=${encodeURIComponent(count)}&entryMode=anchor&anchorSequence=${encodeURIComponent(sourceSequence)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
							: `/pages/message/chat?chatId=${chatIdParam}&type=group&groupId=${targetParam}&targetId=${targetParam}&name=${encodeURIComponent(convName)}&memberCount=${encodeURIComponent(count)}&entryMode=anchor&anchorMessageId=${encodeURIComponent(item.messageId)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
					} else {
						payload.type = 'single'
						payload.targetId = targetId
						payload.name = convName
						targetUrl = sourceSequence !== '' && sourceSequence !== '0'
							? `/pages/message/chat?chatId=${chatIdParam}&type=single&targetId=${targetParam}&name=${encodeURIComponent(convName)}&entryMode=anchor&anchorSequence=${encodeURIComponent(sourceSequence)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
							: `/pages/message/chat?chatId=${chatIdParam}&type=single&targetId=${targetParam}&name=${encodeURIComponent(convName)}&entryMode=anchor&anchorMessageId=${encodeURIComponent(item.messageId)}&messageId=${encodeURIComponent(item.messageId)}&highlight=true`
					}
				}
			} catch (e) {
			}
			try {
				const stateId = createNavState(payload)
				if (stateId != null && stateId !== '') {
					uni.navigateTo({ url: `/pages/message/chat?stateId=${encodeURIComponent(stateId)}` })
					return
				}
			} catch (e) {
			}
			uni.navigateTo({ url: targetUrl })
			return
		}
	} catch (e) {
		// ignore
	}
}

function safeParseJson(raw: any): any | null {
	try {
		if (raw == null) {
			return null
		}
		if (typeof raw === 'string') {
			const s = raw.trim()
			if (s === '') {
				return null
			}
			if (s === '[object Object]' || s === '[object UTSJSONObject]' || s === '[object Array]') {
				return null
			}
			const first = s.charAt(0)
			const last = s.charAt(s.length - 1)
			const couldBeJsonObject = first === '{' && last === '}'
			const couldBeJsonArray = first === '[' && last === ']'
			if (!couldBeJsonObject && !couldBeJsonArray) {
				return null
			}
			if (couldBeJsonArray) {
				const inner = s.substring(1, s.length - 1).trim()
				if (inner !== '') {
					const c0 = inner.charAt(0)
					const isLikelyJsonArray =
						c0 === '{' || c0 === '[' || c0 === '"' || c0 === '-' ||
						(c0 >= '0' && c0 <= '9') || c0 === 't' || c0 === 'f' || c0 === 'n'
					if (!isLikelyJsonArray) {
						return null
					}
				}
			}
			return JSON.parse(s)
		}
		if (typeof raw === 'object') {
			return raw
		}
		return null
	} catch (e) {
		return null
	}
}

function buildPreview(messageType: number, content: any): string {
	try {
		if (messageType === 1 || messageType === 100 || messageType === 205) {
			const parsed = safeParseJson(content)
			if (parsed != null && typeof parsed === 'object') {
				if ((parsed as any).replyContent != null && String((parsed as any).replyContent) !== '') {
					return String((parsed as any).replyContent)
				}
				if ((parsed as any).content != null && String((parsed as any).content) !== '') {
					return String((parsed as any).content)
				}
				return t('chat.preview.message')
			}
			return content != null ? String(content) : ''
		}
		if (messageType === 9 || messageType === 106) {
			const body = safeParseJson(content)
			if (body != null && body.type != null && String(body.type) === 'FORWARD_COMBINE') {
				return t('chat.label.forwardCombine')
			}
			if (body != null && body.type != null && String(body.type) === 'STICKER') {
				return t('chat.preview.sticker')
			}
			if (body != null && body.type != null && String(body.type) === 'CONTACT_CARD') {
				return t('chat.preview.contactCard')
			}
			return t('chat.preview.message')
		}
		if (messageType === 2 || messageType === 101) return t('chat.preview.image')
		if (messageType === 3 || messageType === 102) return t('chat.preview.voice')
		if (messageType === 4 || messageType === 103) return t('chat.preview.video')
		if (messageType === 5 || messageType === 104) return t('chat.preview.file')
		if (messageType === 6 || messageType === 105) return t('chat.preview.location')
		if (messageType === 7) return t('chat.preview.emoji')
		if (messageType === 8) return t('chat.preview.sticker')
		return t('chat.preview.message')
	} catch (e) {
		return t('chat.preview.message')
	}
}

function pad2(n: number): string {
	return n < 10 ? '0' + n.toString() : n.toString()
}

function formatEnterpriseTime(raw: string): string {
	try {
		if (raw == null || raw.trim() === '') {
			return ''
		}
		const d = new Date(raw)
		const ts = d.getTime()
		if (isNaN(ts) || ts <= 0) {
			return raw
		}
		const now = new Date()
		const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
		const thatStart = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime()
		const diffDays = Math.floor((todayStart - thatStart) / (24 * 60 * 60 * 1000))
		const hhmm = pad2(d.getHours()) + ':' + pad2(d.getMinutes())
		if (diffDays === 0) {
			return t('chat.forwardCombineDetail.todayAt', { time: hhmm })
		}
		if (diffDays === 1) {
			return t('chat.forwardCombineDetail.yesterdayAt', { time: hhmm })
		}
		const y = d.getFullYear()
		const m = pad2(d.getMonth() + 1)
		const dd = pad2(d.getDate())
		if (y === now.getFullYear()) {
			return `${m}-${dd} ${hhmm}`
		}
		return `${y}-${m}-${dd} ${hhmm}`
	} catch (e) {
		return raw
	}
}

onLoad((options: any) => {
	try {
		const mid = options != null ? (options['messageId'] as string | null) : null
		if (mid == null || mid === '' || mid === '0') {
			emptyText.value = t('chat.toast.invalidParams')
			items.value = []
			return
		}
		let depthVal = 0
		try {
			const depthRaw = options != null ? (options['depth'] as string | null) : null
			const parsed = depthRaw != null && depthRaw !== '' ? Number(depthRaw) : 0
			depthVal = !isNaN(parsed) && parsed > 0 ? parsed : 0
		} catch (e) {
			depthVal = 0
		}
		currentDepth.value = depthVal
		let traceList: string[] = [mid]
		try {
			const traceRaw = options != null ? (options['trace'] as string | null) : null
			if (traceRaw != null && traceRaw !== '') {
				const arr = String(traceRaw).split(',').map(s => s.trim()).filter(s => s !== '' && s !== '0')
				if (arr.length > 0) {
					traceList = arr
				}
			}
			if (!traceList.includes(mid)) {
				traceList.push(mid)
			}
		} catch (e) {
			traceList = [mid]
		}
		visitedIds.value = traceList
		if (currentDepth.value > MAX_FORWARD_COMBINE_DEPTH) {
			emptyText.value = t('chat.forwardCombineDetail.quoteTooDeep')
			items.value = []
			return
		}
		void loadByMessageId(mid)
	} catch (e) {
		items.value = []
	}
})

async function loadByMessageId(messageId: string): Promise<void> {
	try {
		uni.showLoading({ title: t('chat.forwardCombineDetail.loading') })
		const resp: any = await getMessageDetail(messageId)
		uni.hideLoading()
		const body = resp != null ? safeParseJson(resp.content) : null
		if (body == null || body.type == null || String(body.type) !== 'FORWARD_COMBINE') {
			emptyText.value = t('chat.forwardCombineDetail.contentUnavailable')
			items.value = []
			return
		}
		comment.value = body.comment != null ? String(body.comment) : ''
		const arr: any[] = body.messages != null ? (body.messages as any[]) : []
		const list: ForwardCombineItem[] = []
		for (let i = 0; i < arr.length; i++) {
			const it = arr[i]
			const messageId = it != null && it.messageId != null ? String(it.messageId) : ''
			const sourceChatId = it != null && it.sourceChatId != null ? String(it.sourceChatId) : ''
			const sourceSequence = it != null && it.sourceSequence != null ? String(it.sourceSequence) : ''
			const senderName = it != null && it.senderName != null ? String(it.senderName) : ''
			const sendTimeRaw = it != null && it.sendTime != null ? String(it.sendTime) : ''
			const sendTime = formatEnterpriseTime(sendTimeRaw)
			const mt = it != null && it.messageType != null ? Number(it.messageType) : 0
			const pv = buildPreview(mt, it != null ? it.content : '')
			const refId = it != null && it.refMessageId != null ? String(it.refMessageId) : ''
			list.push({ messageId: messageId, sourceChatId: sourceChatId, sourceSequence: sourceSequence, senderName: senderName, sendTime: sendTime, preview: pv, refMessageId: refId })
		}
		items.value = list
		emptyText.value = list.length === 0 ? t('chat.forwardCombineDetail.empty') : ''
	} catch (e) {
		try {
			uni.hideLoading()
		} catch (e2) {
			// ignore
		}
		emptyText.value = t('chat.forwardCombineDetail.loadFailed')
		items.value = []
		uni.showToast({ title: t('chat.forwardCombineDetail.loadFailed'), icon: 'none' })
	}
}

onUnload(() => {
	if (unsubscribeTheme != null) {
		unsubscribeTheme()
		unsubscribeTheme = null
	}
})
</script>

<style scoped>
.page {
	flex: 1;
	display: flex;
	flex-direction: column;
	background-color: #F7F8FA;
}

.status-bar {
	height: 0px;
}

.header {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 12px;
	padding-right: 12px;
}

.header-left {
	width: 40px;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.back-icon {
	font-size: 18px;
}

.header-title {
	flex: 1;
	text-align: center;
	font-size: 16px;
	font-weight: 600;
}

.header-right {
	width: 40px;
}

.content {
	flex: 1;
	padding: 12px;
}

.comment {
	border-radius: 12px;
	padding: 12px 12px;
	margin-bottom: 10px;
	border-width: 0.5px;
	border-color: #E5E6EB;
}

.comment-text {
	font-size: 14px;
	line-height: 20px;
}

.item {
	border-radius: 12px;
	padding: 12px 12px;
	margin-bottom: 10px;
	border-width: 0.5px;
	border-color: #E5E6EB;
}

.item-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	min-width: 0;
}

.sender-name {
	font-size: 14px;
	font-weight: 600;
	flex: 1;
	min-width: 0;
	lines: 1;
	text-overflow: ellipsis;
}

.send-time {
	font-size: 12px;
	margin-left: 10px;
	flex-shrink: 0;
}

.item-content {
	margin-top: 6px;
	font-size: 13px;
	color: #4E5969;
	line-height: 18px;
}

.empty {
	padding-top: 60px;
	align-items: center;
	justify-content: center;
}

.empty-text {
	font-size: 13px;
	color: #8c8c8c;
}
</style>
