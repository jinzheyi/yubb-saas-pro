<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.contactCardSelect.title') }}</text>
			<view class="header-right"></view>
		</view>

		<contact-selector
			v-if="!loading"
			:show-categories="true"
			:selectable="true"
			:contacts="contactList"
			@select="handleSelect"
			@category-click="handleCategory"
			@load-more="handleLoadMore"
		/>

		<view v-if="loading" class="state-wrap">
			<text class="state-text" :style="{ color: theme.textTertiary }">{{ t('chat.contactCardSelect.loading') }}</text>
		</view>
		<view v-if="!loading && contactList.length === 0" class="state-wrap">
			<text class="state-text" :style="{ color: theme.textTertiary }">{{ t('chat.contactCardSelect.empty') }}</text>
		</view>

		<view class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textSecondary }">{{ selectedDisplayText }}</text>
			<button class="confirm-btn" :disabled="selectedCount === 0 || submitting" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('chat.contactCardSelect.confirm') }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getUserInfo, getDeptId } from '../../store/user.uts'
	import { getContactList, getContactPageByDept } from '../../api/contact.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import ContactSelector from '../../components/contact-selector/contact-selector.uvue'
	import {
		startSelection,
		endSelection,
		toggleMember,
		isMemberSelected,
		getSelectedCount,
		getSelectedMembers
	} from '../../store/group-selection.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const CONTACT_CARD_SELECT_EVENT = 'imSelectContactCard'

	type ContactItem = {
		id: string
		name: string
		role: string
		avatarText: string
		avatarBg: string
		pinyin: string
		selected: boolean
		deptName: string
		postName: string
		avatar: string
	}

	const safeAreaBottom = ref(0)
	const loading = ref(false)
	const loadingMore = ref(false)
	const hasMore = ref(true)
	const submitting = ref(false)
	const pageNo = ref(1)
	const pageSize = ref(50)
	const deptId = ref('')
	const currentUserId = ref('0')
	const contactList = ref<ContactItem[]>([])
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	const selectedCount = computed(() : number => getSelectedCount())
	const selectedDisplayText = computed(() : string => {
		const selected = getSelectedMembers()
		if (selected == null || selected.length === 0) {
			return t('chat.contactCardSelect.placeholder')
		}
		const first = selected[0]
		const name = first != null && first.name != null ? String(first.name) : ''
		return name !== '' ? (t('chat.contactCardSelect.selectedPrefix') + name) : t('chat.contactCardSelect.selectedOne')
	})

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	onLoad(() => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		startSelection(1)
		const userInfo = getUserInfo()
		currentUserId.value = userInfo && userInfo.user && userInfo.user.id != null ? String(userInfo.user.id) : '0'
		const dept = getDeptId()
		deptId.value = dept != null ? String(dept) : ''
		void loadContacts(true)
	})

	onShow(() => {
		syncSelectionState()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
		endSelection()
	})

	function normalizePinyin(name: string, rawPinyin: string): string {
		let letter = rawPinyin != null ? String(rawPinyin) : ''
		if (letter.length > 1) {
			letter = letter.charAt(0)
		}
		if (letter === '' && name.length > 0) {
			const first = name.charAt(0)
			const code = first.charCodeAt(0)
			if (code >= 19968 && code <= 40869) {
				const index = (code - 19968) % 26
				letter = String.fromCharCode(65 + index)
			} else {
				letter = first
			}
		}
		letter = letter.toUpperCase()
		if (!/^[A-Z]$/.test(letter)) {
			letter = 'A'
		}
		return letter
	}

	function mapToContactItem(item: any): ContactItem | null {
		if (item == null || item.id == null) {
			return null
		}
		const userId = String(item.id)
		if (userId === '' || userId === '0' || userId === currentUserId.value) {
			return null
		}
		const displayName = item.remarkName != null && String(item.remarkName) !== ''
			? String(item.remarkName)
			: (item.nickname != null ? String(item.nickname) : '')
		if (displayName === '') {
			return null
		}
		const pinyin = normalizePinyin(displayName, item.pinyin != null ? String(item.pinyin) : '')
		return {
			id: userId,
			name: displayName,
			role: item.deptName != null ? String(item.deptName) : '',
			avatarText: getAvatarText(displayName),
			avatarBg: getUserAvatarColor(userId),
			pinyin: pinyin,
			selected: isMemberSelected(userId),
			deptName: item.deptName != null ? String(item.deptName) : '',
			postName: item.postName != null ? String(item.postName) : '',
			avatar: item.avatar != null ? String(item.avatar) : ''
		}
	}

	function syncSelectionState() {
		for (let i = 0; i < contactList.value.length; i++) {
			const item = contactList.value[i]
			item.selected = isMemberSelected(String(item.id))
		}
	}

	async function loadContacts(reset: boolean): Promise<void> {
		if (loading.value && reset) {
			return
		}
		if (reset) {
			loading.value = true
			pageNo.value = 1
			hasMore.value = true
			contactList.value = []
		}
		try {
			let rows: any[] = []
			if (deptId.value !== '') {
				const page = reset ? 1 : (pageNo.value + 1)
				const res = await getContactPageByDept(deptId.value, page, pageSize.value, '') as any
				rows = res != null && Array.isArray(res.list) ? res.list : []
				const total = res != null && res.total != null ? Number(res.total) : (contactList.value.length + rows.length)
				hasMore.value = (reset ? 0 : contactList.value.length) + rows.length < total
				pageNo.value = page
			} else {
				const raw = await getContactList() as any
				rows = Array.isArray(raw) ? raw : (raw != null && Array.isArray(raw.data) ? raw.data : [])
				hasMore.value = false
			}
			const mapped: ContactItem[] = []
			for (let i = 0; i < rows.length; i++) {
				const item = mapToContactItem(rows[i])
				if (item != null) {
					if (!contactList.value.some(c => c.id === item.id) && !mapped.some(c => c.id === item.id)) {
						mapped.push(item)
					}
				}
			}
			if (reset) {
				contactList.value = mapped
			} else {
				contactList.value = contactList.value.concat(mapped)
			}
			syncSelectionState()
		} catch (e) {
			console.error('[SelectContactCard] 加载联系人失败:', e)
			uni.showToast({ title: t('chat.contactCardSelect.loadFailed'), icon: 'none' })
		} finally {
			loading.value = false
			loadingMore.value = false
		}
	}

	async function handleLoadMore() {
		if (loadingMore.value || loading.value || !hasMore.value || deptId.value === '') {
			return
		}
		loadingMore.value = true
		await loadContacts(false)
	}

	function handleCategory(item : any) {
		if (item == null || item.nameKey == null) {
			return
		}
		const key = String(item.nameKey)
		if (key === 'contacts.groups') {
			uni.navigateTo({ url: '/pages/contacts/my-groups?mode=select' })
			return
		}
		if (key === 'contacts.following') {
			uni.navigateTo({ url: '/pages/contacts/my-following?mode=select' })
			return
		}
		if (key === 'contacts.org') {
			uni.navigateTo({ url: '/pages/contacts/organization?mode=select' })
			return
		}
		if (key === 'contacts.dept') {
			uni.navigateTo({ url: '/pages/contacts/my-department?mode=select' })
		}
	}

	function handleSelect(item: any) {
		if (item == null || item.id == null) {
			return
		}
		toggleMember(item)
		syncSelectionState()
	}

	function handleBack() {
		endSelection()
		uni.navigateBack()
	}

	function handleConfirm() {
		if (selectedCount.value === 0 || submitting.value) {
			return
		}
		const selected = getSelectedMembers()
		const first = selected != null && selected.length > 0 ? selected[0] : null
		if (first == null || first.id == null) {
			uni.showToast({ title: t('chat.contactCardSelect.chooseContact'), icon: 'none' })
			return
		}
		submitting.value = true
		const payload = {
			userId: String(first.id),
			displayName: first.name != null ? String(first.name) : '',
			deptName: first.deptName != null && String(first.deptName) !== '' ? String(first.deptName) : (first.role != null ? String(first.role) : ''),
			postName: first.postName != null ? String(first.postName) : '',
			avatar: first.avatar != null ? String(first.avatar) : ''
		}
		uni.$emit(CONTACT_CARD_SELECT_EVENT, payload)
		uni.navigateBack()
	}
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		width: 80px;
		flex-direction: row;
		align-items: center;
	}

	.back-icon {
		font-size: 16px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 2px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.state-wrap {
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.state-text {
		font-size: 14px;
	}

	.footer {
		padding: 12px 16px;
		border-top-width: 0.5px;
	}

	.selected-text {
		font-size: 13px;
		margin-bottom: 10px;
	}

	.confirm-btn {
		height: 44px;
		border-radius: 22px;
		background-color: #1677FF;
		justify-content: center;
		align-items: center;
		display: flex;
	}

	.confirm-btn[disabled] {
		opacity: 0.5;
	}

	.confirm-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 600;
	}
</style>
