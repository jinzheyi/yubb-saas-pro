<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="cancel-text" :style="{ color: theme.brandPrimary }">{{ t('chat.header.cancel') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.shareContact.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" v-model="searchKeyword" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" @input="handleSearch" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 最近聊天 -->
			<view class="section" :style="{ backgroundColor: theme.cardBg }" v-if="!searchKeyword && recentChats.length > 0">
				<text class="section-title" :style="{ color: theme.textSecondary, backgroundColor: theme.pageBg }">{{ t('chat.shareContact.recentChats') }}</text>
				<view class="chat-list">
					<view class="chat-item" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" v-for="chat in recentChats" :key="chat.id" @click="toggleSelect(chat)">
					<view class="chat-checkbox">
							<text v-if="isSelected(chat.id)" class="iconfont checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-unchecked" :style="{ borderColor: theme.borderColor, backgroundColor: theme.pageBg }"></view>
						</view>
						<view class="chat-avatar" :style="{ backgroundColor: chat.avatarBg }">
							<image v-if="chat.avatar" class="avatar-image" :src="chat.avatar" mode="aspectFill" />
							<text v-else-if="chat.isGroup" class="iconfont group-icon">&#xe616;</text>
							<text v-else class="chat-avatar-text">{{ chat.avatarText }}</text>
						</view>
						<view class="chat-info">
							<text class="chat-name" :style="{ color: theme.textPrimary }">{{ chat.name }}</text>
							<text class="chat-desc" :style="{ color: theme.textTertiary }" v-if="chat.isGroup">{{ t('chat.group.memberCount', { count: chat.memberCount }) }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view class="section" :style="{ backgroundColor: theme.cardBg }">
				<text class="section-title" :style="{ color: theme.textSecondary, backgroundColor: theme.pageBg }">{{ searchKeyword ? t('chat.shareContact.searchResult') : t('chat.shareContact.contacts') }}</text>
				<view class="contact-list">
					<view class="contact-item" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" v-for="contact in displayContacts" :key="contact.id" @click="toggleSelect(contact)">
					<view class="contact-checkbox">
							<text v-if="isSelected(contact.id)" class="iconfont checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-unchecked" :style="{ borderColor: theme.borderColor, backgroundColor: theme.pageBg }"></view>
						</view>
						<view class="contact-avatar" :style="{ backgroundColor: contact.avatarBg }">
							<image v-if="contact.avatar" class="avatar-image" :src="contact.avatar" mode="aspectFill" />
							<text v-else class="contact-avatar-text">{{ contact.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name" :style="{ color: theme.textPrimary }">{{ contact.name }}</text>
							<text class="contact-role" :style="{ color: theme.textTertiary }">{{ contact.role }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 空状态 -->
		<view class="empty-state" v-if="searchKeyword && displayContacts.length === 0">
			<text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xea6e;</text>
			<text class="empty-text" :style="{ color: theme.textTertiary }">{{ t('chat.shareContact.notFound', { keyword: searchKeyword }) }}</text>
		</view>
		</scroll-view>

		<!-- 底部确认按钮 -->
		<view class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textSecondary }">{{ t('chat.shareContact.selectedCount', { count: selectedItems.length }) }}</text>
			<button class="confirm-btn" :class="{ 'confirm-btn-disabled': selectedItems.length === 0 }" :style="{ backgroundColor: selectedItems.length === 0 ? theme.fillDisabled : theme.brandPrimary }" :disabled="selectedItems.length === 0" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('chat.shareContact.share') }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getAvatarText, getGroupAvatarColor, getUserAvatarColor } from '../../utils/avatar.uts'
	import { getContactList } from '../../api/contact.uts'
	import { getConversationByTarget } from '../../api/conversation.uts'
	import { conversationService } from '../../services/conversation-service.uts'
	import { messageService } from '../../services/message-service.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	const safeAreaBottom = ref(0)

	type ShareTargetItem = {
		id: string
		name: string
		role: string
		avatar: string
		avatarText: string
		avatarBg: string
		isGroup: boolean
		memberCount: number
		chatId: string
		targetId: string
		conversationType: number
		sourceType: string
	}

	const searchKeyword = ref('')
	const selectedItems = ref<ShareTargetItem[]>([])
	const loading = ref(false)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	const sourceUserId = ref('')
	const sourceDisplayName = ref('')
	const sourceAvatar = ref('')
	const sourceDeptName = ref('')
	const sourcePostName = ref('')

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const recentChats = ref<ShareTargetItem[]>([])
	const allContacts = ref<ShareTargetItem[]>([])

	// 过滤后的联系人
	const displayContacts = computed(() : ShareTargetItem[] => {
		const keyword = searchKeyword.value != null ? searchKeyword.value.trim().toLowerCase() : ''
		if (!keyword) {
			return allContacts.value
		}
		return allContacts.value.filter(contact => {
			const name = contact.name != null ? contact.name.toLowerCase() : ''
			const role = contact.role != null ? contact.role.toLowerCase() : ''
			return name.indexOf(keyword) >= 0 || role.indexOf(keyword) >= 0
		})
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleSearch() {
		// 搜索逻辑已在 computed 中实现
	}

	function isSelected(id : any) : boolean {
		return selectedItems.value.some(item => item.id === id)
	}

	function toggleSelect(item : ShareTargetItem) {
		const index = selectedItems.value.findIndex(i => i.id === item.id)
		if (index > -1) {
			selectedItems.value.splice(index, 1)
		} else {
			selectedItems.value.push(item)
		}
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return text !== '' && text !== 'null' && text !== 'undefined' ? text : ''
	}

	function mapConversationToShareItem(conv: any): ShareTargetItem | null {
		try {
			if (conv == null) {
				return null
			}
			const chatId = conv.chatId != null ? String(conv.chatId) : ''
			const targetId = conv.targetId != null ? String(conv.targetId) : ''
			const conversationType = conv.conversationType != null ? Number(conv.conversationType) : 1
			const isGroup = conversationType === 2
			if (chatId === '' || targetId === '') {
				return null
			}
			const name = conv.targetName != null && String(conv.targetName).trim() !== '' ? String(conv.targetName).trim() : t('chat.shareContact.unnamedConversation')
			return {
				id: 'chat_' + chatId,
				name: name,
				role: isGroup ? t('chat.shareContact.groupChat') : t('chat.shareContact.recentChatRole'),
				avatar: normalizeAvatarUrl(conv.targetAvatar),
				avatarText: conv.avatarText != null && String(conv.avatarText).trim() !== '' ? String(conv.avatarText) : getAvatarText(name),
				avatarBg: isGroup ? getGroupAvatarColor(targetId) : getUserAvatarColor(targetId),
				isGroup: isGroup,
				memberCount: conv.groupMemberCount != null ? Number(conv.groupMemberCount) : 0,
				chatId: chatId,
				targetId: targetId,
				conversationType: conversationType,
				sourceType: 'conversation'
			}
		} catch (e) {
			return null
		}
	}

	function mapContactToShareItem(contact: any): ShareTargetItem | null {
		try {
			if (contact == null || contact.id == null) {
				return null
			}
			const userId = String(contact.id)
			const displayName = contact.remarkName || contact.nickname || t('chat.shareContact.unknownContact')
			return {
				id: 'user_' + userId,
				name: displayName,
				role: contact.postName || contact.deptName || '',
				avatar: normalizeAvatarUrl(contact.avatar),
				avatarText: getAvatarText(displayName),
				avatarBg: getUserAvatarColor(userId),
				isGroup: false,
				memberCount: 0,
				chatId: '',
				targetId: userId,
				conversationType: 1,
				sourceType: 'contact'
			}
		} catch (e) {
			return null
		}
	}

	async function loadShareTargets(): Promise<void> {
		try {
			loading.value = true
			await conversationService.loadConversations()
			const cachedConversations: any[] = conversationService.getConversations() as any[]
			const nextChats: ShareTargetItem[] = []
			const seenChatIds: string[] = []
			for (let i = 0; i < cachedConversations.length; i++) {
				const mapped = mapConversationToShareItem(cachedConversations[i])
				if (mapped == null) {
					continue
				}
				if (seenChatIds.indexOf(mapped.chatId) >= 0) {
					continue
				}
				seenChatIds.push(mapped.chatId)
				nextChats.push(mapped)
				if (nextChats.length >= 12) {
					break
				}
			}
			recentChats.value = nextChats

			const contacts = await getContactList() as any[]
			const nextContacts: ShareTargetItem[] = []
			for (let i = 0; i < contacts.length; i++) {
				const mapped = mapContactToShareItem(contacts[i])
				if (mapped == null) {
					continue
				}
				if (mapped.targetId === sourceUserId.value) {
					continue
				}
				nextContacts.push(mapped)
			}
			allContacts.value = nextContacts
		} catch (e) {
			console.error('[ShareContact] loadShareTargets failed:', e)
			uni.showToast({
				title: t('chat.shareContact.loadFailed'),
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	async function resolveConversationForTarget(target: ShareTargetItem): Promise<{ chatId: string, receiverId: string, groupId: string } | null> {
		try {
			if (target.sourceType === 'conversation' && target.chatId !== '') {
				return {
					chatId: target.chatId,
					receiverId: target.conversationType === 1 ? target.targetId : '',
					groupId: target.conversationType === 2 ? target.targetId : ''
				}
			}
			const conversation: any = await getConversationByTarget(target.targetId, 1)
			const chatId = conversation != null && conversation.chatId != null ? String(conversation.chatId) : ''
			if (chatId === '') {
				return null
			}
			return {
				chatId: chatId,
				receiverId: target.targetId,
				groupId: ''
			}
		} catch (e) {
			console.error('[ShareContact] resolveConversationForTarget failed:', e)
			return null
		}
	}

	async function handleConfirm() {
		if (selectedItems.value.length === 0) {
			uni.showToast({
				title: t('chat.shareContact.selectTarget'),
				icon: 'none'
			})
			return
		}
		if (sourceUserId.value === '' || sourceDisplayName.value === '') {
			uni.showToast({
				title: t('chat.shareContact.invalidCard'),
				icon: 'none'
			})
			return
		}

		const payload: any = {
			type: 'CONTACT_CARD',
			userId: sourceUserId.value,
			displayName: sourceDisplayName.value,
			deptName: sourceDeptName.value,
			postName: sourcePostName.value,
			avatar: sourceAvatar.value
		}

		let successCount = 0
		for (let i = 0; i < selectedItems.value.length; i++) {
			const target = selectedItems.value[i]
			const resolved = await resolveConversationForTarget(target)
			if (resolved == null) {
				continue
			}
			try {
				await (messageService as any).sendContactCardMessageByRest(
					resolved.chatId,
					resolved.receiverId,
					resolved.groupId,
					payload
				)
				successCount++
			} catch (e) {
				console.error('[ShareContact] send contact card failed:', e)
			}
		}

		if (successCount <= 0) {
			uni.showToast({
				title: t('chat.shareContact.shareFailed'),
				icon: 'none'
			})
			return
		}

		uni.showToast({
			title: t('chat.shareContact.shareSuccess', { count: successCount }),
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1200)
	}

	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		sourceUserId.value = options != null && options['userId'] != null ? String(options['userId']) : ''
		sourceDisplayName.value = options != null && options['name'] != null ? decodeURIComponent(String(options['name'])) : ''
		sourceAvatar.value = options != null && options['avatar'] != null ? decodeURIComponent(String(options['avatar'])) : ''
		sourceDeptName.value = options != null && options['deptName'] != null ? decodeURIComponent(String(options['deptName'])) : ''
		sourcePostName.value = options != null && options['postName'] != null ? decodeURIComponent(String(options['postName'])) : ''
		void loadShareTargets()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		width: 80px;
	}

	.cancel-text {
		color: #1677FF;
		font-size: 16px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		padding: 10px 16px;
		border-bottom-width: 0.5px;
	}

	.search-bar {
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.placeholder {
	}

	.content {
		flex: 1;
		height: 0;
	}

	.section {
		margin-bottom: 10px;
	}

	.section-title {
		font-size: 13px;
		padding: 12px 16px 8px;
	}

	/* 聊天列表 */
	.chat-list {
	}

	.chat-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.chat-item-last {
		border-bottom-width: 0;
	}

	.chat-checkbox {
		width: 24px;
		height: 24px;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
	}

	.checkbox-checked {
		font-size: 24px;
		color: #1677FF;
	}

	.checkbox-unchecked {
		width: 20px;
		height: 20px;
		border-radius: 10px;
		border-width: 1.5px;
	}

	.chat-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.avatar-image {
		width: 44px;
		height: 44px;
		border-radius: 8px;
	}

	.group-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.chat-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.chat-info {
		flex: 1;
	}

	.chat-name {
		font-size: 15px;
		margin-bottom: 4px;
	}

	.chat-desc {
		font-size: 13px;
	}

	/* 联系人列表 */
	.contact-list {
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.contact-item-last {
		border-bottom-width: 0;
	}

	.contact-checkbox {
		width: 24px;
		height: 24px;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
	}

	.contact-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.contact-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 15px;
		margin-bottom: 4px;
	}

	.contact-role {
		font-size: 13px;
	}

	/* 空状态 */
	.empty-state {
		padding: 80px 16px;
		align-items: center;
	}

	.empty-icon {
		font-size: 64px;
		margin-bottom: 16px;
	}

	.empty-text {
		font-size: 15px;
	}

	/* 底部 */
	.footer {
		border-top-width: 0.5px;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
	}

	.selected-text {
		font-size: 15px;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 24px;
		height: 36px;
		border-radius: 18px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-disabled {
		background-color: #C1C4C9;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 15px;
		font-weight: 500;
	}
</style>
