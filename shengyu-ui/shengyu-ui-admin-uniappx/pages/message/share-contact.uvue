<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="cancel-text" :style="{ color: theme.brandPrimary }">取消</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">分享给</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" v-model="searchKeyword" placeholder="搜索" placeholder-class="placeholder" @input="handleSearch" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 最近聊天 -->
			<view class="section" :style="{ backgroundColor: theme.cardBg }" v-if="!searchKeyword && recentChats.length > 0">
				<text class="section-title" :style="{ color: theme.textSecondary, backgroundColor: theme.pageBg }">最近聊天</text>
				<view class="chat-list">
					<view class="chat-item" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" v-for="chat in recentChats" :key="chat.id" @click="toggleSelect(chat)">
						<view class="chat-checkbox">
							<text v-if="isSelected(chat.id)" class="iconfont checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-unchecked" :style="{ borderColor: theme.borderColor, backgroundColor: theme.pageBg }"></view>
						</view>
						<view class="chat-avatar" :style="{ backgroundColor: chat.avatarBg }">
							<text v-if="chat.isGroup" class="iconfont group-icon">&#xe616;</text>
							<text v-else class="chat-avatar-text">{{ chat.avatarText }}</text>
						</view>
						<view class="chat-info">
							<text class="chat-name" :style="{ color: theme.textPrimary }">{{ chat.name }}</text>
							<text class="chat-desc" :style="{ color: theme.textTertiary }" v-if="chat.isGroup">{{ chat.memberCount }}人</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view class="section" :style="{ backgroundColor: theme.cardBg }">
				<text class="section-title" :style="{ color: theme.textSecondary, backgroundColor: theme.pageBg }">{{ searchKeyword ? '搜索结果' : '联系人' }}</text>
				<view class="contact-list">
					<view class="contact-item" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" v-for="contact in displayContacts" :key="contact.id" @click="toggleSelect(contact)">
						<view class="contact-checkbox">
							<text v-if="isSelected(contact.id)" class="iconfont checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-unchecked" :style="{ borderColor: theme.borderColor, backgroundColor: theme.pageBg }"></view>
						</view>
						<view class="contact-avatar" :style="{ backgroundColor: contact.avatarBg }">
							<text class="contact-avatar-text">{{ contact.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name" :style="{ color: theme.textPrimary }">{{ contact.name }}</text>
							<text class="contact-role" :style="{ color: theme.textTertiary }">{{ contact.role }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 空状态 -->
		<view class="empty-state" v-if="searchKeyword && displayContacts.length === 0">
			<text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xea6e;</text>
			<text class="empty-text" :style="{ color: theme.textTertiary }">未找到"{{ searchKeyword }}"</text>
		</view>
		</scroll-view>

		<!-- 底部确认按钮 -->
		<view class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textSecondary }">已选择 {{ selectedItems.length }} 个</text>
			<button class="confirm-btn" :style="{ backgroundColor: selectedItems.length === 0 ? theme.fillDisabled : theme.brandPrimary }" :disabled="selectedItems.length === 0" @click="handleConfirm">
				<text class="confirm-btn-text">分享</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getAvatarText, getGroupAvatarColor, getUserAvatarColor } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	const safeAreaBottom = ref(0)

	const searchKeyword = ref('')
	const selectedItems = ref<any[]>([])
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	// 最近聊天
	const recentChats = ref([
		{ id: 'chat1', name: '张敏', avatarText: getAvatarText('张敏'), avatarBg: getUserAvatarColor('chat1'), isGroup: false },
		{ id: 'chat2', name: '产品研发团队', avatarBg: getGroupAvatarColor('chat2'), isGroup: true, memberCount: 12 },
		{ id: 'chat3', name: '李强', avatarText: getAvatarText('李强'), avatarBg: getUserAvatarColor('chat3'), isGroup: false }
	])

	// 联系人列表
	const allContacts = ref([
		{ id: '1', name: '张敏', role: '产品经理', avatarText: getAvatarText('张敏'), avatarBg: getUserAvatarColor('1') },
		{ id: '2', name: '李强', role: '开发工程师', avatarText: getAvatarText('李强'), avatarBg: getUserAvatarColor('2') },
		{ id: '3', name: '王静', role: '设计师', avatarText: getAvatarText('王静'), avatarBg: getUserAvatarColor('3') },
		{ id: '4', name: '刘洋', role: '测试工程师', avatarText: getAvatarText('刘洋'), avatarBg: getUserAvatarColor('4') },
		{ id: '5', name: '赵敏', role: '产品经理', avatarText: getAvatarText('赵敏'), avatarBg: getUserAvatarColor('5') },
		{ id: '6', name: '孙伟', role: '开发工程师', avatarText: getAvatarText('孙伟'), avatarBg: getUserAvatarColor('6') }
	])

	// 过滤后的联系人
	const displayContacts = computed(() : any[] => {
		if (!searchKeyword.value) {
			return allContacts.value
		}
		return allContacts.value.filter(contact => contact.name.includes(searchKeyword.value))
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleSearch() {
		// 搜索逻辑已在 computed 中实现
	}

	function isSelected(id : any) : boolean {
		return selectedItems.value.some(item => item.id === id)
	}

	function toggleSelect(item : any) {
		const index = selectedItems.value.findIndex(i => i.id === item.id)
		if (index > -1) {
			selectedItems.value.splice(index, 1)
		} else {
			selectedItems.value.push(item)
		}
	}

	function handleConfirm() {
		if (selectedItems.value.length === 0) {
			uni.showToast({
				title: '请选择分享对象',
				icon: 'none'
			})
			return
		}

		uni.showToast({
			title: `已分享给 ${selectedItems.value.length} 个联系人`,
			icon: 'success'
		})

		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}

	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		// 可以接收要分享的内容参数
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		width: 80px;
	}

	.cancel-text {
		color: #1677FF;
		font-size: 16px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		padding: 10px 16px;
		border-bottom-width: 0.5px;
	}

	.search-bar {
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.placeholder {
	}

	.content {
		flex: 1;
		height: 0;
	}

	.section {
		margin-bottom: 10px;
	}

	.section-title {
		font-size: 13px;
		padding: 12px 16px 8px;
	}

	/* 聊天列表 */
	.chat-list {
	}

	.chat-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.chat-item-last {
		border-bottom-width: 0;
	}

	.chat-checkbox {
		width: 24px;
		height: 24px;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
	}

	.checkbox-checked {
		font-size: 24px;
		color: #1677FF;
	}

	.checkbox-unchecked {
		width: 20px;
		height: 20px;
		border-radius: 10px;
		border-width: 1.5px;
	}

	.chat-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.group-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.chat-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.chat-info {
		flex: 1;
	}

	.chat-name {
		font-size: 15px;
		margin-bottom: 4px;
	}

	.chat-desc {
		font-size: 13px;
	}

	/* 联系人列表 */
	.contact-list {
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.contact-item-last {
		border-bottom-width: 0;
	}

	.contact-checkbox {
		width: 24px;
		height: 24px;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
	}

	.contact-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.contact-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 15px;
		margin-bottom: 4px;
	}

	.contact-role {
		font-size: 13px;
	}

	/* 空状态 */
	.empty-state {
		padding: 80px 16px;
		align-items: center;
	}

	.empty-icon {
		font-size: 64px;
		margin-bottom: 16px;
	}

	.empty-text {
		font-size: 15px;
	}

	/* 底部 */
	.footer {
		border-top-width: 0.5px;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
	}

	.selected-text {
		font-size: 15px;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 24px;
		height: 36px;
		border-radius: 18px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn[disabled] {
		background-color: #C1C4C9;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 15px;
		font-weight: 500;
	}
</style>
