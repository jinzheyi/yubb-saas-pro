			avatarBg: '#F197BC'
		},
		{
			id: '3',
			senderId: 'me',
			receiverId: 'user1',
			type: 'image',
			content: 'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/shuijiao.jpg',
			isSelf: true,
