	}

	.inline-emoji {
		width: 22px;
		height: 22px;
		margin: 0 2px;
	}

	.message-self .bubble-text {
		background-color: #D2E3FC;
		border-color: #B2CFFB;
	}

	/* 图片消息 */
	.bubble-image {
		padding: 0;
		overflow: hidden;
		background-color: transparent;
		border-width: 0;
		max-width: 100%;
	}

	.chat-image {
		width: 150px;
		border-radius: 8px;
		max-width: 100%;
	}

	/* 语音消息 */
	.bubble-voice {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		min-width: 60px;
		max-width: 220px;
		position: relative;
		overflow: visible;
	}

	.message-self .bubble-voice {
		background-color: #D2E3FC;
		flex-direction: row-reverse;
	}

	.voice-icon {
		font-size: 18px;
		color: #1F2329;
	}

	.voice-duration {
		font-size: 14px;
		color: #1F2329;
		margin: 0 8px;
	}

	/* 视频消息 */
	.bubble-video {
		padding: 0;
		overflow: hidden;
		background-color: #000000;
		width: 150px;
		height: 200px;
		border-radius: 8px;
		position: relative;
	}

	.chat-video {
		width: 150px;
		height: 200px;
	}

	.video-play-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		justify-content: center;
		align-items: center;
		background-color: rgba(0, 0, 0, 0.1);
	}

	.video-play-icon {
		font-size: 40px;
		color: #FFFFFF;
		opacity: 0.8;
	}

	.voice-unread-dot {
		position: absolute;
		right: -12px;
		top: 50%;
		transform: translateY(-50%);
		width: 8px;
		height: 8px;
		background-color: #F54A45;
		border-radius: 4px;
	}

	/* 文件消息 */
	.bubble-file {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		width: 220px;
		max-width: 100%;
		padding: 12px;
	}

