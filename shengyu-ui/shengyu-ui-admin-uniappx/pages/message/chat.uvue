<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back', '返回') }}</text>
			</view>
			<view class="header-title-wrap">
				<text class="header-title">{{ name }}</text>
				<text class="header-status">{{ t('chat.online', '手机在线') }}</text>
			</view>
			<view class="header-right">
				<text class="iconfont header-icon">&#xea74;</text>
				<text class="iconfont header-icon" @click="handleToSettings">&#xea8d;</text>
			</view>
		</view>

		<!-- 聊天内容区域 -->
		<scroll-view class="chat-content" scroll-y="true" :scroll-into-view="lastMessageId" show-scrollbar="false">
			<!-- 水印层 -->
			<view class="watermark-layer">
				<view v-for="i in 12" :key="i" class="watermark-item">
					<text class="watermark-text">{{ watermark }}</text>
				</view>
			</view>

			<view class="message-list">
				<view v-for="(msg, index) in messages" :key="index" :id="'msg-' + index" class="message-group">
					<view v-if="formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0)" class="time-stamp">
						<text class="time-text">{{ formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0) }}</text>
					</view>
					
					<view :class="['message-item', msg.isSelf ? 'message-self' : 'message-other']">
						<view class="avatar" :style="{ backgroundColor: msg.avatarBg }">
							<text class="avatar-text">{{ msg.avatarText }}</text>
						</view>
						<view class="message-bubble-wrap">
							<!-- 文字消息 -->
							<view v-if="msg.type === 'text'" class="message-bubble bubble-text">
								<text class="message-text">{{ msg.content }}</text>
							</view>
							
							<!-- 图片消息 -->
							<view v-else-if="msg.type === 'image'" class="message-bubble bubble-image" @click="handleImagePreview(msg.content)">
								<image class="chat-image" :src="msg.content" mode="widthFix" />
							</view>
							
							<!-- 语音消息 -->
							<view v-else-if="msg.type === 'voice'" class="message-bubble bubble-voice" :style="{ width: 60 + (msg.duration || 0) * 5 + 'px' }" @click="handleVoicePlay(msg)">
								<text class="iconfont voice-icon">{{ msg.isSelf ? '\uea89' : '\uea89' }}</text>
								<text class="voice-duration">{{ msg.duration }}"</text>
								<!-- 语音未读红点 -->
								<view v-if="!msg.isSelf && !msg.isRead" class="voice-unread-dot"></view>
							</view>
							
							<!-- 文件消息 -->
							<view v-else-if="msg.type === 'file'" class="message-bubble bubble-file">
								<view class="file-info">
									<text class="file-name">{{ msg.fileName }}</text>
									<text class="file-size">{{ msg.fileSize }}</text>
								</view>
								<view class="file-icon-wrap">
									<text class="iconfont file-icon">&#xea96;</text>
								</view>
							</view>
							
							<!-- 位置消息 -->
							<view v-else-if="msg.type === 'location'" class="message-bubble bubble-location">
								<view class="location-info">
									<text class="location-name">{{ msg.locationName }}</text>
									<text class="location-address">{{ msg.address }}</text>
								</view>
								<image class="location-map" src="/static/images/chat/map-placeholder.png" mode="aspectFill" />
							</view>
							
							<!-- 表情包/动图 -->
							<view v-else-if="msg.type === 'emoji'" class="bubble-emoji">
								<image class="emoji-img" :src="msg.content" mode="aspectFit" />
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入区域 -->
		<view class="footer">
			<view class="input-row">
				<text class="iconfont footer-icon">&#xea89;</text>
				<view class="input-box">
					<input 
						class="chat-input" 
						v-model="inputText" 
						:placeholder="t('chat.inputPlaceholder')"
						@confirm="handleSend"
					/>
				</view>
				<text class="iconfont footer-icon" :style="{ color: inputText ? '#1677FF' : '#999' }" @click="handleSend">&#xea73;</text>
			</view>
			<view class="action-row">
				<text class="iconfont action-icon">&#xea95;</text>
				<text class="iconfont action-icon">&#xea87;</text>
				<text class="iconfont action-icon">&#xea8f;</text>
				<text class="iconfont action-icon">&#xea9e;</text>
				<text class="iconfont action-icon add-icon" @click="toggleMenu">&#xea9d;</text>
			</view>
			
			<!-- 功能菜单 -->
			<view v-if="showMenu" class="features-menu">
				<view class="feature-item" v-for="(item, index) in featureList" :key="index" @click="handleFeature(item)">
					<view class="feature-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont feature-icon">{{ item.icon }}</text>
					</view>
					<text class="feature-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()
	const name = ref('张三')
	const watermark = ref('同事A 1234')
	const inputText = ref('')
	const showMenu = ref(false)
	const lastMessageId = ref('')

	const messages = ref([
		{
			type: 'text',
			content: '你今天上班表现不错，下个月绩效给优，再接再厉',
			isSelf: false,
			time: '2025-10-11 16:38',
			timestamp: 1728635880000,
			showTime: true,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'voice',
			duration: 5,
			isRead: false,
			isSelf: false,
			time: '2025-10-11 16:40',
			timestamp: 1728636000000,
			showTime: false,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'image',
			content: 'https://img.yzcdn.cn/vant/cat.jpeg',
			isSelf: false,
			time: '2025-10-11 16:42',
			timestamp: 1728636120000,
			showTime: false,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'file',
			fileName: '项目进度汇报.pdf',
			fileSize: '1.2MB',
			isSelf: true,
			time: '2025-11-10 16:33',
			timestamp: 1731227580000,
			showTime: true,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		},
		{
			type: 'location',
			locationName: '财信大厦',
			address: '长沙市天心区城南西路1号',
			isSelf: true,
			time: '2025-11-10 16:35',
			timestamp: 1731227700000,
			showTime: false,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		},
		{
			type: 'text',
			content: '收到，谢谢领导！',
			isSelf: true,
			time: '2025-11-10 16:36',
			timestamp: 1731227760000,
			showTime: false,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		}
	])

	/**
	 * 仿微信聊天时间线显示逻辑
	 */
	function formatChatTime(timestamp : number, lastTimestamp : number = 0) : string {
		// 如果两条消息间隔小于5分钟，不显示时间
		if (lastTimestamp > 0 && timestamp - lastTimestamp < 5 * 60 * 1000) {
			return ''
		}

		const date = new Date(timestamp)
		const now = new Date()
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')

		if (isToday) {
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return `昨天 ${hours}:${minutes}`
		}
		
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return `${weekDays[date.getDay()]} ${hours}:${minutes}`
		}
		
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}月${day}日 ${hours}:${minutes}`
		}
		return `${year}年${month}月${day}日 ${hours}:${minutes}`
	}

	const featureList = [
		{ icon: '\uea72', bg: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', bg: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\uea83', bg: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', bg: '#FFB347', nameKey: 'chat.features.fav' },
		{ icon: '\uea89', bg: '#5FB6F7', nameKey: 'chat.features.voice' },
		{ icon: '\uea84', bg: '#62D4A1', nameKey: 'chat.features.paint' }
	]

	function handleBack() {
		uni.navigateBack()
	}

	function handleToSettings() {
		uni.navigateTo({
			url: '/pages/message/chat-settings'
		})
	}

	function handleSend() {
		if (!inputText.value.trim()) return
		messages.value.push({
			type: 'text',
			content: inputText.value,
			isSelf: true,
			time: new Date().toLocaleString(),
			timestamp: Date.now(),
			showTime: false,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		})
		inputText.value = ''
		scrollToBottom()
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}

	function handleImagePreview(url : string) {
		uni.previewImage({
			urls: [url],
			current: url
		})
	}

	function handleVoicePlay(msg : any) {
		if (!msg.isSelf) {
			msg.isRead = true
		}
		uni.showToast({
			title: '正在播放语音...',
			icon: 'none'
		})
	}

	function scrollToBottom() {
		setTimeout(() => {
			lastMessageId.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title-wrap {
		flex: 1;
		align-items: center;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-status {
		color: #8F959E;
		font-size: 10px;
	}

	.header-right {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		width: 80px;
	}

	.header-icon {
		color: #1F2329;
		font-size: 22px;
		margin-left: 16px;
	}

	.chat-content {
		flex: 1;
		position: relative;
		height: 0;
		background-color: #F5F7FA;
	}

	.watermark-layer {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-around;
		align-content: space-around;
		opacity: 0.03;
		pointer-events: none;
		transform: rotate(-25deg);
	}

	.watermark-item {
		padding: 40px;
	}

	.watermark-text {
		font-size: 14px;
		color: #000000;
		font-weight: bold;
	}

	.message-list {
		padding: 16px;
	}

	.time-stamp {
		align-items: center;
		margin-bottom: 20px;
	}

	.time-text {
		font-size: 11px;
		color: #8F959E;
		background-color: rgba(31, 35, 41, 0.05);
		padding: 2px 8px;
		border-radius: 4px;
	}

	.message-item {
		flex-direction: row;
		margin-bottom: 24px;
	}

	.message-self {
		flex-direction: row-reverse;
	}

	.avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 12px;
		font-weight: 600;
	}

	.message-bubble-wrap {
		flex: 1;
		margin: 0 12px;
		align-items: flex-start;
	}

	.message-self .message-bubble-wrap {
		align-items: flex-end;
	}

	.message-bubble {
		padding: 10px 14px;
		border-radius: 10px;
		max-width: 85%;
		border-width: 0.5px;
		border-color: #EFF0F1;
	}

	.bubble-text {
		background-color: #FFFFFF;
	}

	.message-self .bubble-text {
		background-color: #D2E3FC;
		border-color: #B2CFFB;
	}

	/* 图片消息 */
	.bubble-image {
		padding: 0;
		overflow: hidden;
		background-color: transparent;
		border-width: 0;
	}

	.chat-image {
		width: 150px;
		border-radius: 8px;
	}

	/* 语音消息 */
	.bubble-voice {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		min-width: 60px;
		position: relative;
		overflow: visible;
	}

	.message-self .bubble-voice {
		background-color: #D2E3FC;
		flex-direction: row-reverse;
	}

	.voice-icon {
		font-size: 18px;
		color: #1F2329;
	}

	.voice-duration {
		font-size: 14px;
		color: #1F2329;
		margin: 0 8px;
	}

	.voice-unread-dot {
		position: absolute;
		right: -12px;
		top: 50%;
		transform: translateY(-50%);
		width: 8px;
		height: 8px;
		background-color: #F54A45;
		border-radius: 4px;
	}

	/* 文件消息 */
	.bubble-file {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		width: 220px;
		padding: 12px;
	}

	.file-info {
		flex: 1;
		margin-right: 12px;
	}

	.file-name {
		font-size: 15px;
		color: #1F2329;
		lines: 2;
		text-overflow: ellipsis;
	}

	.file-size {
		font-size: 12px;
		color: #8F959E;
		margin-top: 4px;
	}

	.file-icon-wrap {
		width: 44px;
		height: 44px;
		background-color: #F5F7FA;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
	}

	.file-icon {
		font-size: 24px;
		color: #3370FF;
	}

	/* 位置消息 */
	.bubble-location {
		padding: 0;
		overflow: hidden;
		background-color: #FFFFFF;
		width: 220px;
	}

	.location-info {
		padding: 10px 12px;
	}

	.location-name {
		font-size: 15px;
		color: #1F2329;
		lines: 1;
		text-overflow: ellipsis;
	}

	.location-address {
		font-size: 12px;
		color: #8F959E;
		margin-top: 2px;
		lines: 1;
		text-overflow: ellipsis;
	}

	.location-map {
		width: 100%;
		height: 100px;
		background-color: #F5F7FA;
	}

	/* 表情包 */
	.bubble-emoji {
		padding: 0;
		background-color: transparent;
		border-width: 0;
	}

	.emoji-img {
		width: 100px;
		height: 100px;
	}

	.message-text {
		font-size: 15px;
		color: #1F2329;
		line-height: 1.5;
	}

	.footer {
		background-color: #FFFFFF;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding-bottom: calc(env(safe-area-inset-bottom) + 8px);
	}

	.input-row {
		flex-direction: row;
		align-items: center;
		padding: 10px 12px;
	}

	.input-box {
		flex: 1;
		background-color: #F5F7FA;
		border-radius: 6px;
		margin: 0 10px;
		height: 38px;
		justify-content: center;
		padding: 0 12px;
	}

	.chat-input {
		font-size: 15px;
		color: #1F2329;
	}

	.footer-icon {
		font-size: 24px;
		color: #646A73;
	}

	.action-row {
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
		padding: 0 12px 4px 12px;
	}

	.action-icon {
		font-size: 24px;
		color: #646A73;
	}

	.add-icon {
		color: #3370FF;
	}

	.features-menu {
		background-color: #FFFFFF;
		padding: 24px 20px;
		flex-direction: row;
		flex-wrap: wrap;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
	}

	.feature-item {
		width: 25%;
		align-items: center;
		margin-bottom: 24px;
	}

	.feature-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-bottom: 8px;
	}

	.feature-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.feature-name {
		font-size: 12px;
		color: #646A73;
	}
</style>