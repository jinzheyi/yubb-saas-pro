							const uploadRes: any = await uploadFileAndReturnId(path, { directory: 'im/file' })
							const fileId = uploadRes.data.fileId?.toString() || '0'
							const fileUrl = uploadRes.data.url || ''
							const fileName = uploadRes.data.name || '文件'
							const fileSize = uploadRes.data.size || 0
