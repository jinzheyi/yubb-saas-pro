	})
	const composerEditorStyle = computed(() => {
		if (isFullExpanded.value) {
			return {}
		}
		const nextHeight = getComposerHeightByLineCount(composerLineCount.value)
		return {
			height: nextHeight + 'px',
			minHeight: COMPOSER_MIN_HEIGHT + 'px',
			maxHeight: COMPOSER_MAX_HEIGHT + 'px'
		}
	})

	type QuoteChainItem = {
