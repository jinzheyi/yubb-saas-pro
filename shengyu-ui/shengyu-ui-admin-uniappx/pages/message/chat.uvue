<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header" :class="{ 'header-multi-select': multiSelectMode }">
			<view v-if="!multiSelectMode" class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back', '返回') }}</text>
			</view>
			<view v-else class="header-left" @click="exitMultiSelectMode">
				<text class="cancel-text">取消</text>
			</view>
			<view class="header-title-wrap">
				<text v-if="!multiSelectMode" class="header-title">{{ name }}</text>
				<text v-else class="header-title">已选择 {{ selectedIds.length }} 条</text>
				<text v-if="!multiSelectMode && chatType === 'single'" class="header-status">{{ t('chat.online', '手机在线') }}</text>
				<text v-if="!multiSelectMode && chatType === 'group'" class="header-status">{{ memberCount }}人</text>
			</view>
			<view class="header-right">
				<text v-if="!multiSelectMode" class="iconfont header-icon">&#xea74;</text>
				<text v-if="!multiSelectMode" class="iconfont header-icon" @click="handleToSettings">&#xea8d;</text>
			</view>
		</view>

		<!-- 聊天内容区域 -->
		<scroll-view class="chat-content" :class="{ 'chat-content-multi-select': multiSelectMode }" scroll-y="true" :scroll-into-view="lastMessageId" show-scrollbar="false" @scroll="handleChatScroll" @scrolltolower="handleChatScrollToLower" lower-threshold="80">
			<!-- 水印层 -->
			<view class="watermark-layer">
				<view v-for="i in 12" :key="i" class="watermark-item">
					<text class="watermark-text">{{ watermark }}</text>
				</view>
			</view>

			<view class="message-list">
				<view v-for="(msg, index) in messages" :key="index" :id="'msg-' + index" class="message-group">
					<view v-if="formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0)" class="time-stamp">
						<text class="time-text">{{ formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0) }}</text>
					</view>
					
                    <view :class="['message-item', msg.isSelf ? 'message-self' : 'message-other', multiSelectMode && selectedIds.includes(msg.id) ? 'message-selected' : '', highlightedMessageId === msg.id ? 'message-highlighted' : '']">
						<!-- 多选模式下的复选框（统一在最左侧） -->
						<view v-if="multiSelectMode && msg.type !== 'voice' && msg.type !== 'location'" class="multi-select-checkbox" @click.stop="toggleSelect(msg)">
							<text v-if="selectedIds.includes(msg.id)" class="iconfont checkbox-icon checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-icon checkbox-unchecked"></view>
						</view>
						
						<view class="avatar" :style="{ backgroundColor: msg.avatarBg }">
							<text class="avatar-text">{{ msg.avatarText }}</text>
						</view>
                        <view class="message-bubble-wrap">
							<!-- 发送者名称 (仅在群聊中,仅对他人消息) -->
							<text v-if="chatType === 'group' && !msg.isSelf" class="sender-name">
								{{ msg.senderName }}
							</text>
							
							<!-- 文字消息 -->
							<view v-if="msg.type === 'text' || msg.type === 'quote'" class="message-bubble bubble-text" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
								<!-- 引用内容预览 -->
								<view v-if="hasQuote(msg)" class="quote-preview" @click.stop="scrollToQuotedMessage(msg.quoteMessageId)">
									<view v-for="(quote, qIdx) in buildQuoteChain(msg)" :key="quote.messageId + '-' + qIdx" class="quote-chain-item" :class="{ 'quote-chain-sub': qIdx > 0 }">
										<text class="quote-sender">{{ quote.senderName }}</text>
										<text class="quote-content" :numberOfLines="1">{{ quote.content }}</text>
									</view>
								</view>
								<view class="text-content-wrap">
									<template v-for="(token, tIdx) in parseMessageText(msg.content)" :key="tIdx">
										<text v-if="token.type === 'text'" class="message-text">{{ token.content }}</text>
										<image v-else class="inline-emoji" :src="token.content" mode="aspectFit" />
									</template>
								</view>
							</view>
							
							<!-- 图片消息 -->
							<view v-else-if="msg.type === 'image'" class="message-bubble bubble-image" @click="multiSelectMode ? handleBubbleClick(msg) : handleImagePreview(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
								<image class="chat-image" :src="msg.content" mode="widthFix" />
							</view>
							
							<!-- 视频消息 -->
							<view v-else-if="msg.type === 'video'" class="message-bubble bubble-video" @click="multiSelectMode ? handleBubbleClick(msg) : handleVideoPlay(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
								<image class="chat-video" :src="msg.poster || msg.content" mode="aspectFill" />
								<view class="video-play-overlay">
									<text class="iconfont video-play-icon">&#xe602;</text>
								</view>
							</view>
							
							<!-- 语音消息 -->
                            <view v-else-if="msg.type === 'voice'" class="message-bubble bubble-voice" :style="{ width: getVoiceBubbleWidth(msg.duration || 0) }" @click="handleVoicePlay(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
								<text class="iconfont voice-icon">{{ msg.isSelf ? '\ue601' : '\ue601' }}</text>
								<text class="voice-duration">{{ msg.duration }}"</text>
								<!-- 语音未读红点 -->
								<view v-if="!msg.isSelf && !msg.isRead" class="voice-unread-dot"></view>
							</view>
							
							<!-- 文件消息 -->
                            <view v-else-if="msg.type === 'file'" class="message-bubble bubble-file" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="multiSelectMode ? handleBubbleClick(msg) : handleFileOpen(msg)">
								<view class="file-info">
									<text class="file-name">{{ msg.fileName }}</text>
									<text class="file-size">{{ msg.fileSize }}</text>
								</view>
								<text class="iconfont file-icon" :style="{ color: getFileIconColor(msg) }">{{ getFileIconUnicode(msg) }}</text>
							</view>
							
							<!-- 位置消息 -->
                            <view v-else-if="msg.type === 'location'" class="message-bubble bubble-location" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
								<view class="location-info">
									<text class="location-name">{{ msg.locationName }}</text>
									<text class="location-address">{{ msg.address }}</text>
								</view>
								<image class="location-map" src="/static/images/chat/map-placeholder.png" mode="aspectFill" />
							</view>
							
							<!-- 表情包/动图 -->
                            <view v-else-if="msg.type === 'emoji'" class="bubble-emoji" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
								<image class="emoji-img" :src="msg.content" mode="aspectFit" />
							</view>
							
							<!-- 自定义收藏表情 (无气泡) -->
                            <view v-else-if="msg.type === 'sticker'" class="sticker-msg-wrap" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
								<image class="sticker-img" :src="msg.content" mode="widthFix" />
							</view>
							
							<view v-if="shouldShowReadReceiptEntry(msg)" class="read-receipt-entry" :class="{'read-receipt-entry-self': msg.isSelf}" @click.stop="handleReadReceiptEntryClick(msg)">
								<text class="read-receipt-entry-text">{{ buildReadReceiptEntryText(msg) }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入区域 -->
		<view v-if="!multiSelectMode" class="footer" :class="{ 'footer-full-expanded': isFullExpanded }">
			<!-- 全屏模式下的顶部操作栏 -->
			<view v-if="isFullExpanded" class="full-expand-header">
				<text class="iconfont collapse-icon" @click="toggleFullExpand">&#xe60e;</text>
			</view>
			
			<!-- 引用回复预览栏 -->
			<view v-if="quoteReplyMsg !== null" class="quote-reply-bar">
				<view class="quote-reply-content">
					<text class="quote-reply-sender">{{ quoteReplyMsg ? quoteReplyMsg.senderName : '' }}</text>
					<text class="quote-reply-text" :numberOfLines="1">{{ quoteReplyMsg ? (quoteReplyMsg.type === 'text' ? quoteReplyMsg.content : '[' + quoteReplyMsg.type + ']') : '' }}</text>
				</view>
				<text class="iconfont quote-reply-close" @click="clearQuoteReply">&#xeb08;</text>
			</view>

			<view class="input-row" :class="{ 'input-row-full': isFullExpanded }">
				<!-- 左侧图标栏 (仅在非全屏模式下显示) -->
				<view v-if="!isFullExpanded" class="input-left-actions">
					<!-- 语音/键盘切换 -->
					<text class="iconfont footer-icon" @click="toggleInputMode">{{ isVoiceMode ? '\ueac2' : '\ue601' }}</text>
					<!-- 展开按钮 -->
					<text v-if="!isVoiceMode && inputText" class="iconfont expand-icon-btn" @click="toggleFullExpand">&#xe7b0;</text>
				</view>

				<!-- 输入框/按住说话按钮 -->
				<view class="input-box" :class="{ 'input-box-full': isFullExpanded, 'input-box-multi': isMultiLine && !isFullExpanded }" v-if="!isVoiceMode">
					<editor 
						id="editor"
						class="chat-editor" 
						:class="{ 'chat-editor-full': isFullExpanded, 'chat-editor-multi': isMultiLine && !isFullExpanded }"
						:placeholder="t('chat.inputPlaceholder')"
						@ready="onEditorReady"
						@input="onEditorInput"
						:show-confirm-bar="false"
						:adjust-position="!isFullExpanded"
					/>
				</view>
				<view 
					v-else 
					class="voice-btn" 
					:class="{ 'voice-btn-active': isRecording }"
					@touchstart="handleVoiceStart"
					@touchmove="handleVoiceMove"
					@touchend="handleVoiceEnd"
					@touchcancel="handleVoiceEnd"
				>
					<text class="voice-btn-text">{{ isRecording ? (isCancelReady ? '松开 取消' : '松开 结束') : '按住 说话' }}</text>
				</view>
				
				<!-- 右侧/底部图标栏 -->
				<view class="input-right-actions" :class="{ 'input-right-actions-full': isFullExpanded }">
					<!-- 表情图标 -->
					<text class="iconfont footer-icon" @click="toggleEmojiMenu">&#xe604;</text>
					
					<!-- 更多/发送按钮 -->
					<view v-if="!inputText" class="plus-btn" @click="togglePlusMenu">
						<text class="iconfont footer-icon">&#xe726;</text>
					</view>
					<view v-else class="send-btn" @click="handleSend">
						<text class="send-btn-text">发送</text>
					</view>
				</view>
			</view>
			
			<!-- 表情包菜单 -->
			<view v-if="showEmojiMenu" class="emoji-menu">
				<scroll-view class="emoji-content" scroll-y="true">
					<!-- 系统表情页签 -->
					<view class="emoji-grid" v-if="currentEmojiTab === 'emoji'">
						<view 
							class="emoji-item" 
							v-for="(item, index) in emojiList" 
							:key="index"
							@click="handleEmojiClick(item)"
						>
							<image class="picker-emoji-img" :src="item.path" mode="aspectFit" />
						</view>
					</view>
					
					<!-- 收藏表情页签 -->
					<view class="sticker-grid" v-else-if="currentEmojiTab === 'sticker'">
						<!-- 添加按钮 -->
						<view class="sticker-item-add">
							<text class="iconfont sticker-add-icon">&#xe726;</text>
						</view>
						<!-- 表情列表 -->
						<view 
							class="sticker-item" 
							v-for="(item, index) in stickerList" 
							:key="item.id"
							@click="handleStickerClick(item)"
						>
							<image class="picker-sticker-img" :src="item.url" mode="aspectFill" />
						</view>
					</view>
				</scroll-view>
				
				<!-- 表情菜单 Tab 栏 -->
				<view class="emoji-tabs">
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'emoji' }" @click="currentEmojiTab = 'emoji'">
						<text class="iconfont emoji-tab-icon">&#xe604;</text>
					</view>
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'sticker' }" @click="currentEmojiTab = 'sticker'">
						<text class="iconfont emoji-tab-icon">&#xe83f;</text>
					</view>
				</view>
			</view>

			<!-- 功能菜单 (更多) -->
			<view v-if="showPlusMenu" class="features-menu">
				<view class="feature-item" v-for="(item, index) in featureList" :key="index" @click="handleFeature(item)">
					<view class="feature-icon-wrap">
						<text class="iconfont feature-icon" :style="{ color: item.color }">{{ item.icon }}</text>
					</view>
					<text class="feature-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>
		</view>

        <view v-if="showMsgMenu" class="menu-mask" @click="closeMsgMenu">
            <view class="menu-content" :style="{ top: menuY + 'px', left: menuX + 'px', opacity: menuOpacity }" @click.stop>
                <view class="menu-list">
                    <view class="menu-item-btn" v-for="item in currentMenuItems" :key="item.key" @click="handleMenuAction(item.key)">
                        <text class="iconfont menu-item-icon" :class="{ 'menu-danger': item.key === 'delete' }">{{ item.icon }}</text>
                        <text class="menu-item-text" :class="{ 'menu-danger': item.key === 'delete' }">{{ item.labelKey ? t(item.labelKey) : item.label }}</text>
                    </view>
                </view>
            </view>
        </view>

		<!-- 多选模式底部工具栏 -->
		<view v-if="multiSelectMode" class="multi-select-toolbar">
			<view class="toolbar-item" @click="handleMultiForward">
				<text class="iconfont toolbar-icon">&#xe63d;</text>
				<text class="toolbar-text">转发</text>
			</view>
			<view class="toolbar-item" @click="handleMultiDelete">
				<text class="iconfont toolbar-icon">&#xe602;</text>
				<text class="toolbar-text">删除</text>
			</view>
		</view>

		<!-- 录音状态浮层 -->
		<view v-if="isRecording" class="recording-overlay">
			<view class="recording-card" :class="{ 'recording-card-cancel': isCancelReady }">
				<text class="iconfont recording-icon">{{ isCancelReady ? '\uea76' : '\ue601' }}</text>
				<text class="recording-text">{{ isCancelReady ? '松开手指，取消发送' : '手指上滑，取消发送' }}</text>
			</view>
		</view>

		<!-- 转发确认对话框 -->
		<view v-if="showForwardConfirm" class="forward-dialog-overlay" @click="cancelForward">
			<view class="forward-dialog" @click.stop>
				<view class="forward-dialog-header">
					<text class="forward-dialog-title">发送给</text>
				</view>
				<view class="forward-dialog-content">
					<view class="forward-target">
						<text class="iconfont target-icon">&#xe624;</text>
						<text class="target-name">选择联系人/群组</text>
					</view>
					<view class="forward-preview">
						<text class="preview-text">[逐条转发] {{ selectedIds.length }} 条消息</text>
					</view>
				</view>
				<view class="forward-dialog-footer">
					<view class="dialog-btn cancel-btn" @click="cancelForward">
						<text class="btn-text">取消</text>
					</view>
					<view class="dialog-btn confirm-btn" @click="confirmForward">
						<text class="btn-text highlight">发送</text>
					</view>
				</view>
			</view>
		</view>

		<view v-if="showReadReceiptSheet" class="read-receipt-mask" @click="closeReadReceiptSheet">
			<view class="read-receipt-sheet" @click.stop>
				<view class="read-receipt-header">
					<text class="read-receipt-title">已读详情</text>
					<text class="read-receipt-close" @click="closeReadReceiptSheet">关闭</text>
				</view>
				<view class="read-receipt-summary">
					<view class="summary-item" @click="switchReadReceiptTab('read')">
						<text class="summary-num">{{ readReceiptSummary ? readReceiptSummary.readCount : 0 }}</text>
						<text class="summary-label" :class="{ 'summary-label-active': readReceiptTab === 'read' }">已读</text>
					</view>
					<view class="summary-divider"></view>
					<view class="summary-item" @click="switchReadReceiptTab('unread')">
						<text class="summary-num">{{ readReceiptSummary ? readReceiptSummary.unreadCount : 0 }}</text>
						<text class="summary-label" :class="{ 'summary-label-active': readReceiptTab === 'unread' }">未读</text>
					</view>
				</view>
				<scroll-view class="read-receipt-list" scroll-y="true" @scrolltolower="loadMoreReadReceipt">
					<view v-for="item in readReceiptList" :key="item.userId" class="read-receipt-row">
						<image v-if="item.avatar" class="read-receipt-avatar" :src="item.avatar" mode="aspectFill" />
						<view v-else class="read-receipt-avatar-fallback" :style="{ backgroundColor: getReadReceiptAvatarBg(item) }">
							<text class="read-receipt-avatar-text">{{ getReadReceiptAvatarText(item) }}</text>
						</view>
						<view class="read-receipt-info">
							<text class="read-receipt-name">{{ item.userName }}</text>
							<text v-if="readReceiptTab === 'read' && item.readTime" class="read-receipt-time">{{ formatReadReceiptTime(item.readTime) }}</text>
						</view>
					</view>
					<view v-if="readReceiptLoading" class="read-receipt-loading">
						<text class="read-receipt-loading-text">加载中...</text>
					</view>
					<view v-else-if="!readReceiptHasMore" class="read-receipt-loading">
						<text class="read-receipt-loading-text">没有更多了</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onHide, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { emojiList } from '../../utils/emojiData.uts'
	import { parseMessageText } from '../../utils/emojiParser.uts'
	import { getCustomStickers, StickerItem } from '../../utils/stickerManager.uts'
	import { messageService, MessageItem as ServiceMessageItem, ConversationItem } from '../../services/message-service.uts'
	import { badgeService } from '../../services/badge-service.uts'
	import { MessageType, wsManager } from '../../utils/websocket.uts'
	import { getMessageList, recallMessage, deleteMessage } from '../../api/message.uts'
	import { getConversationByTarget } from '../../api/conversation.uts'
	import { getUserIdStr, getTenantId, hasRole } from '../../store/user.uts'
	import { 
		chooseAndUploadFile,
		chooseAndUploadImage,
		chooseAndUploadVideo,
		uploadFile,
		uploadFileAndReturnId
	} from '../../utils/upload.uts'
	import { getUserAvatarColor, getAvatarText as getAvatarTextUtil } from '../../utils/avatar.uts'
	import { parseMessageContent } from '../../utils/message-utils.uts'
	import { uploadGroupFile, getFilePresignedGetUrl, getFileOpenStrategy } from '../../api/file.uts'
	import { downloadAndOpenDocumentWithRetry } from '../../utils/file.uts'
	import { readReceiptService } from '../../services/read-receipt-service.uts'
	import {
		BASE_URL as CONFIG_BASE_URL,
		IM_MEDIA_USE_FILE_ID,
		WS_URL
	} from '../../config/app.config.uts'

	const { t } = useI18n()
	
	// 聊天类型：single(单聊) 或 group(群聊)
	const chatType = ref('single')
	const groupId = ref<string>('')
	const memberCount = ref(0)
	
	// 会话信息（使用字符串避免精度丢失）
	const chatId = ref<string>('')
	const targetId = ref<string>('')
	const name = ref('张三')
	const watermark = ref('同事A 1234')
	
	// 消息定位相关（从搜索页面跳转过来时使用）
	const targetMessageId = ref<string>('')  // 要定位的消息ID
	const shouldHighlight = ref(false)  // 是否需要高亮显示
	const highlightedMessageId = ref<string>('')  // 当前高亮的消息ID
	
	// 当前用户信息（使用字符串避免精度丢失）
	const currentUserId = ref<string>('0')
	const currentTenantId = ref<string>('0')

	const PRESIGNED_DEFAULT_SECONDS = 600
	const PRESIGNED_REFRESH_GUARD_MS = 30 * 1000
	const presignedUrlCache = new Map<string, { url: string; expiresAt: number }>()
	let voiceAudioContext: any = null

	function getKkFileViewBaseUrl(): string {
		try {
			const base = (CONFIG_BASE_URL || '').toString()
			if (!base) return 'http://localhost:48090'
			if (base.indexOf('://') < 0) return 'http://localhost:48090'
			const u = new URL(base)
			u.port = '48090'
			return u.origin
		} catch (e) {
			return 'http://localhost:48090'
		}
	}

	function applyAutoReadEnabled(enabled: boolean): void {
		try {
			messageService.setActiveChatAutoReadEnabled(enabled)
		} catch (e) {
			// ignore
		}
	}

	function handleChatScroll(e: any): void {
		try {
			const now = Date.now()
			lastScrollAt = now
			const top = e && e.detail && e.detail.scrollTop != null ? Number(e.detail.scrollTop) : 0
			const delta = top - lastScrollTop
			lastScrollTop = top
			if (delta < -20) {
				if (isAtBottom.value) {
					isAtBottom.value = false
					applyAutoReadEnabled(false)
				}
			}
		} catch (err) {
			// ignore
		}
	}

	function handleChatScrollToLower(): void {
		try {
			if (!isAtBottom.value) {
				isAtBottom.value = true
				applyAutoReadEnabled(true)
			}
		} catch (e) {
			// ignore
		}
	}

	function getFileExtByNameOrUrl(fileName: string, url: string): string {
		try {
			const n = (fileName || '').toLowerCase()
			const pick = (s: string): string => {
				const idx = s.lastIndexOf('.')
				if (idx < 0) return ''
				return s.substring(idx + 1)
			}
			let ext = pick(n)
			if (ext) return ext
			if (url) {
				const u = new URL(url)
				ext = pick((u.pathname || '').toLowerCase())
				return ext
			}
			return ''
		} catch (e) {
			return ''
		}
	}

	function shouldUseKkFileView(ext: string): boolean {
		const e = (ext || '').toLowerCase()
		if (!e) return false
		return (
			e === 'pdf' ||
			e === 'doc' || e === 'docx' ||
			e === 'xls' || e === 'xlsx' ||
			e === 'ppt' || e === 'pptx' ||
			e === 'txt'
		)
	}

	function isUnstableKkPreviewExt(ext: string): boolean {
		const e = (ext || '').toLowerCase()
		return e === 'ppt' || e === 'pptx'
	}

	function normalizeSourceUrlForKkFileView(rawUrl: string): string {
		try {
			if (!rawUrl) return rawUrl
			const u = new URL(rawUrl)
			if ((u.hostname === '127.0.0.1' || u.hostname === 'localhost') && u.port === '48080') {
				u.hostname = 'host.docker.internal'
				return u.toString()
			}
			return rawUrl
		} catch (e) {
			return rawUrl
		}
	}

	function base64EncodeUtf8(raw: string): string {
		if (!raw) return ''
		// #ifdef H5
		try {
			return btoa(unescape(encodeURIComponent(raw)))
		} catch (e) {
			return ''
		}
		// #endif

		try {
			const bytes = raw.toByteArray('utf-8')
			const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
			let out = ''
			let i = 0
			while (i < bytes.length) {
				const c1 = bytes[i++]
				const c2 = i < bytes.length ? bytes[i++] : -1
				const c3 = i < bytes.length ? bytes[i++] : -1
				const e1 = (c1 >> 2) & 0x3f
				const e2 = ((c1 & 0x3) << 4) | ((c2 >= 0 ? c2 : 0) >> 4)
				let e3 = ((c2 >= 0 ? c2 : 0) & 0xf) << 2
				let e4 = 0
				if (c2 >= 0) {
					e3 |= ((c3 >= 0 ? c3 : 0) >> 6) & 0x3
					e4 = (c3 >= 0 ? c3 : 0) & 0x3f
				}
				out += chars.charAt(e1)
				out += chars.charAt(e2)
				out += c2 >= 0 ? chars.charAt(e3) : '='
				out += c3 >= 0 ? chars.charAt(e4) : '='
			}
			return out
		} catch (e) {
			return ''
		}
	}

	function buildKkFileViewPreviewUrl(sourceUrl: string): string {
		const kkBase = getKkFileViewBaseUrl()
		const normalized = normalizeSourceUrlForKkFileView(sourceUrl)
		const b64 = base64EncodeUtf8(normalized)
		if (!b64) return ''
		return `${kkBase}/onlinePreview?url=${encodeURIComponent(b64)}`
	}

	function openUrlInWebViewOrBrowser(url: string): void {
		if (!url) return
		// #ifdef H5
		try {
			window.open(url, '_blank')
			return
		} catch (e) {
			return
		}
		// #endif

		// #ifdef APP-ANDROID || APP-IOS
		try {
			;(plus as any).runtime.openURL(url)
			return
		} catch (e) {
			// ignore
		}
		// #endif

		try {
			uni.setClipboardData({ data: url })
			uni.showToast({ title: '已复制预览链接', icon: 'none' })
		} catch (e) {
			// ignore
		}
	}

	async function resolvePresignedUrl(fileId: string): Promise<string> {
		const id = (fileId || '').toString()
		if (!id || id === '0') {
			return ''
		}
		const now = Date.now()
		const cached = presignedUrlCache.get(id)
		if (cached && cached.url && cached.expiresAt && cached.expiresAt - now > PRESIGNED_REFRESH_GUARD_MS) {
			return cached.url
		}
		const resp: any = await getFilePresignedGetUrl(id, PRESIGNED_DEFAULT_SECONDS)
		if (!resp || !resp.url) {
			return ''
		}
		presignedUrlCache.set(id, { url: resp.url, expiresAt: resp.expiresAt || (now + PRESIGNED_DEFAULT_SECONDS * 1000) })
		return resp.url
	}

	function tryExtractFileId(raw: any): string {
		if (!raw) return ''
		try {
			if (typeof raw === 'string') {
				const parsed = parseRawContent(raw)
				if (parsed && typeof parsed === 'object' && parsed.fileId != null) {
					return parsed.fileId.toString()
				}
				return ''
			}
			if (typeof raw === 'object' && raw.fileId != null) {
				return raw.fileId.toString()
			}
			return ''
		} catch (e) {
			return ''
		}
	}
	
	function getReceiverIdForMessage(): string {
		return chatType.value === 'single' ? (targetId.value || '0') : '0'
	}
	
	function getGroupIdForMessage(): string {
		return chatType.value === 'group' ? (targetId.value || '0') : '0'
	}
	
	// UI 状态
	const inputText = ref('')
