<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back', '返回') }}</text>
			</view>
			<view class="header-title-wrap">
				<text class="header-title">{{ name }}</text>
				<text class="header-status">{{ t('chat.online', '手机在线') }}</text>
			</view>
			<view class="header-right">
				<text class="iconfont header-icon">&#xea74;</text>
				<text class="iconfont header-icon" @click="handleToSettings">&#xea8d;</text>
			</view>
		</view>

		<!-- 聊天内容区域 -->
		<scroll-view class="chat-content" scroll-y="true" :scroll-into-view="lastMessageId" show-scrollbar="false">
			<!-- 水印层 -->
			<view class="watermark-layer">
				<view v-for="i in 12" :key="i" class="watermark-item">
					<text class="watermark-text">{{ watermark }}</text>
				</view>
			</view>

			<view class="message-list">
				<view v-for="(msg, index) in messages" :key="index" :id="'msg-' + index" class="message-group">
					<view v-if="msg.showTime" class="time-stamp">
						<text class="time-text">{{ msg.time }}</text>
					</view>
					
					<view :class="['message-item', msg.isSelf ? 'message-self' : 'message-other']">
						<view class="avatar" :style="{ backgroundColor: msg.avatarBg }">
							<text class="avatar-text">{{ msg.avatarText }}</text>
						</view>
						<view class="message-bubble-wrap">
							<view class="message-bubble">
								<text class="message-text">{{ msg.content }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入区域 -->
		<view class="footer">
			<view class="input-row">
				<text class="iconfont footer-icon">&#xea89;</text>
				<view class="input-box">
					<input 
						class="chat-input" 
						v-model="inputText" 
						:placeholder="t('chat.inputPlaceholder')"
						@confirm="handleSend"
					/>
				</view>
				<text class="iconfont footer-icon" :style="{ color: inputText ? '#1677FF' : '#999' }" @click="handleSend">&#xea73;</text>
			</view>
			<view class="action-row">
				<text class="iconfont action-icon">&#xea95;</text>
				<text class="iconfont action-icon">&#xea87;</text>
				<text class="iconfont action-icon">&#xea8f;</text>
				<text class="iconfont action-icon">&#xea9e;</text>
				<text class="iconfont action-icon add-icon" @click="toggleMenu">&#xea9d;</text>
			</view>
			
			<!-- 功能菜单 -->
			<view v-if="showMenu" class="features-menu">
				<view class="feature-item" v-for="(item, index) in featureList" :key="index" @click="handleFeature(item)">
					<view class="feature-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont feature-icon">{{ item.icon }}</text>
					</view>
					<text class="feature-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()
	const name = ref('胡婷')
	const watermark = ref('朱述勇 5653')
	const inputText = ref('')
	const showMenu = ref(false)
	const lastMessageId = ref('')

	const messages = ref([
		{
			content: '你今天上班表现不错，下个月绩效给优，再接再厉',
			isSelf: false,
			time: '2025-10-11 16:38',
			showTime: true,
			avatarText: '小张',
			avatarBg: '#F197BC'
		},
		{
			content: '收到',
			isSelf: true,
			time: '2025-11-10 16:33',
			showTime: true,
			avatarText: '圣钰',
			avatarBg: '#5FB6F7'
		}
	])

	const featureList = [
		{ icon: '\uea72', bg: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', bg: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\uea83', bg: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', bg: '#FFB347', nameKey: 'chat.features.fav' },
		{ icon: '\uea89', bg: '#5FB6F7', nameKey: 'chat.features.voice' },
		{ icon: '\uea84', bg: '#62D4A1', nameKey: 'chat.features.paint' }
	]

	function handleBack() {
		uni.navigateBack()
	}

	function handleToSettings() {
		uni.navigateTo({
			url: '/pages/message/chat-settings'
		})
	}

	function handleSend() {
		if (!inputText.value.trim()) return
		messages.value.push({
			content: inputText.value,
			isSelf: true,
			time: new Date().toLocaleString(),
			showTime: false,
			avatarText: '述勇',
			avatarBg: '#5FB6F7'
		})
		inputText.value = ''
		scrollToBottom()
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}

	function scrollToBottom() {
		setTimeout(() => {
			lastMessageId.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title-wrap {
		flex: 1;
		align-items: center;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-status {
		color: #8F959E;
		font-size: 10px;
	}

	.header-right {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		width: 80px;
	}

	.header-icon {
		color: #1F2329;
		font-size: 22px;
		margin-left: 16px;
	}

	.chat-content {
		flex: 1;
		position: relative;
		height: 0;
		background-color: #F5F7FA;
	}

	.watermark-layer {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-around;
		align-content: space-around;
		opacity: 0.03;
		pointer-events: none;
		transform: rotate(-25deg);
	}

	.watermark-item {
		padding: 40px;
	}

	.watermark-text {
		font-size: 14px;
		color: #000000;
		font-weight: bold;
	}

	.message-list {
		padding: 16px;
	}

	.time-stamp {
		align-items: center;
		margin-bottom: 20px;
	}

	.time-text {
		font-size: 11px;
		color: #8F959E;
		background-color: rgba(31, 35, 41, 0.05);
		padding: 2px 8px;
		border-radius: 4px;
	}

	.message-item {
		flex-direction: row;
		margin-bottom: 24px;
	}

	.message-self {
		flex-direction: row-reverse;
	}

	.avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 12px;
		font-weight: 600;
	}

	.message-bubble-wrap {
		flex: 1;
		margin: 0 12px;
		align-items: flex-start;
	}

	.message-self .message-bubble-wrap {
		align-items: flex-end;
	}

	.message-bubble {
		background-color: #FFFFFF;
		padding: 10px 14px;
		border-radius: 10px;
		max-width: 85%;
		border-width: 0.5px;
		border-color: #EFF0F1;
	}

	.message-self .message-bubble {
		background-color: #D2E3FC;
		border-color: #B2CFFB;
	}

	.message-text {
		font-size: 15px;
		color: #1F2329;
		line-height: 1.5;
	}

	.footer {
		background-color: #FFFFFF;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding-bottom: calc(env(safe-area-inset-bottom) + 8px);
	}

	.input-row {
		flex-direction: row;
		align-items: center;
		padding: 10px 12px;
	}

	.input-box {
		flex: 1;
		background-color: #F5F7FA;
		border-radius: 6px;
		margin: 0 10px;
		height: 38px;
		justify-content: center;
		padding: 0 12px;
	}

	.chat-input {
		font-size: 15px;
		color: #1F2329;
	}

	.footer-icon {
		font-size: 24px;
		color: #646A73;
	}

	.action-row {
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
		padding: 0 12px 4px 12px;
	}

	.action-icon {
		font-size: 24px;
		color: #646A73;
	}

	.add-icon {
		color: #3370FF;
	}

	.features-menu {
		background-color: #FFFFFF;
		padding: 24px 20px;
		flex-direction: row;
		flex-wrap: wrap;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
	}

	.feature-item {
		width: 25%;
		align-items: center;
		margin-bottom: 24px;
	}

	.feature-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-bottom: 8px;
	}

	.feature-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.feature-name {
		font-size: 12px;
		color: #646A73;
	}
</style>