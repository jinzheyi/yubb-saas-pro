					console.log('[Chat] 发送消息参数:', {
						receiverId: getReceiverIdForMessage(),
						groupId: getGroupIdForMessage(),
						url: fullImageUrl,
						size: imageSize
					})
					
					// 使用消息服务发送图片消息（灰度：V2 双写 fileId + url）
					const message = IM_MEDIA_USE_FILE_ID === 'true'
						? messageService.sendImageMessageV2(
							getReceiverIdForMessage(),
							getGroupIdForMessage(),
							'0',
