		background-color: #F5F7FA;
		border-radius: 0;
		font-size: 44px;
		color: inherit;
	}

	/* 位置消息 */
	.bubble-location {
		padding: 0;
		overflow: hidden;
		background-color: #FFFFFF;
		width: 220px;
		max-width: 100%;
	}

	.location-info {
		padding: 10px 12px;
		word-break: break-all;
	}

	.location-name {
		font-size: 15px;
		color: #1F2329;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.location-address {
