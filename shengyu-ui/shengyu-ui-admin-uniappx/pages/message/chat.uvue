	const inputText = ref('')
	const lastInputText = ref('') // 用于退格逻辑
	const showEmojiMenu = ref(false)
	const showPlusMenu = ref(false)
	const isFullExpanded = ref(false)
	const isMultiLine = ref(false)
	const isVoiceMode = ref(false)
	const isRecording = ref(false)
	const isCancelReady = ref(false)
	const currentEmojiTab = ref('emoji') // 'emoji' | 'sticker'
	const lastMessageId = ref('')
	const recordStartY = ref(0)
	let editorCtx : EditorContext | null = null
    const showMsgMenu = ref(false)
    const menuX = ref(0)
    const menuY = ref(0)
    const selectedMsg = ref<MessageItem | null>(null)
    const currentMenuItems = ref<any[]>([])
    const multiSelectMode = ref(false)
    const selectedIds = ref<string[]>([])
    const touchStartX = ref(0)
    const touchStartY = ref(0)
    const menuOpacity = ref(0)

	const stickerList = ref<StickerItem[]>(getCustomStickers())

	type MessageItem = {
		id : string;
		senderId : string;
