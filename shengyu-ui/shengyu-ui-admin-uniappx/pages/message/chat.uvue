		type : string;
		content : string;
		isSelf : boolean;
		time : string;
		timestamp : number;
		showTime : boolean;
		avatarText : string;
		avatarBg : string;
		duration ?: number;
		poster ?: string;
		fileName ?: string;
		fileSize ?: string;
		address ?: string;
		isSticker ?: boolean;
		status ?: string; // 'sending' | 'success' | 'fail'
	}

	const messages = ref<MessageItem[]>([
		{
			id: '1',
			senderId: 'user1',
			receiverId: 'me',
			type: 'text',
			content: '你今天上班表现不错，下个月绩效给你评个A。',
			isSelf: false,
			time: '2025-10-11 16:38',
			timestamp: 1728635880000,
			showTime: true,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			id: '2',
