	const messages = ref<MessageItem[]>([])
	
	/**
	 * 初始化页面
	 */
	onMounted(async () => {
		registerH5VisibilityChangeListener()
		// 1. 获取当前用户信息
		currentUserId.value = getUserIdStr()
		currentTenantId.value = getTenantId() || '0'
		
		// 2. 设置消息服务的当前用户
		messageService.setCurrentUser(currentUserId.value, currentTenantId.value)
		try {
			stickerList.value = await refreshCustomStickers()
		} catch (e) {
			console.warn('[Chat] 加载自定义表情失败', e)
			stickerList.value = getCustomStickers()
		}
		
		// 3. 如果没有 chatId 但有 targetId，则查询会话（与 onLoad 共用同一并发锁）
		await ensureChatIdByTargetIfNeeded(false)
		
		// 4. 标记当前活跃会话（用于重连补偿只补活跃/未读会话）
		try {
			if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
				messageService.setActiveChatId(chatId.value)
			}
		} catch (e) {
			// ignore
		}

		await hydrateConversationMetaByChatId()
		await ensureInitialMessagesLoaded()
		
		// 5. 监听新消息
		messageService.addMessageListener(handleNewMessage)
		messageService.addMessageStatusListener(handleMessageStatusChange)
		messageService.addVoicePlayedListener(handleVoicePlayedSync)
		
		// 6. 清空未读数（本地 + 服务端：按 sequence 水位上报）
		if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
			const maxSeq = await computeMaxSeqForRead()
			// 调用 BadgeService 清空会话角标
			// BadgeService 会自动调用后端 API 并更新本地数据
			badgeService.clearConversationBadge(chatId.value, maxSeq)
			
			// 同时清空 MessageService 的本地未读数
			messageService.clearUnreadCount(chatId.value)
		}
		
		initVisibleReadObserver()
		startReeditTicker()
		startVoicePlayedCompensation()
		if (entryMode.value === 'latest' && targetAnchorSequence.value === '' && targetMessageId.value === '') {
			scrollToBottom()
		}
	})
	
	onUnmounted(async () => {
		unregisterH5VisibilityChangeListener()
		await flushReadOnLeave()
		await flushVoicePlayedSyncQueue(true)
		destroyVisibleReadObserver()
		stopReeditTicker()
		stopVoicePlayedCompensation()
		cancelActiveVoiceRecording()
		stopCurrentVoicePlayback()
		cleanupContactCardSelectListener()
		cleanupH5VoiceRecorderRuntime()
		// 移除消息监听器
		messageService.removeMessageListener(handleNewMessage)
		messageService.removeMessageStatusListener(handleMessageStatusChange)
		messageService.removeVoicePlayedListener(handleVoicePlayedSync)
		try {
			messageService.setActiveChatId(null)
		} catch (e) {
			// ignore
		}
	})

	let lastFlushedSeq: string = ''
	let lastFlushedAt: number = 0
	let flushInFlight: boolean = false

	const isAtBottom = ref(true)
	let lastScrollTop = 0
	let lastScrollAt = 0
	let lastHistoryLoadTriggerAt = 0
	let visibleObserver: UniIntersectionObserver | null = null
	let visibleObserverWatching: boolean = false
	let visibleReadMaxSeq: string = '0'
	let serverReadDebounceTimer: any = null
	let serverReadPendingSeq: string = '0'
	let serverReadLastSentSeq: string = '0'
	const SERVER_READ_DEBOUNCE_MS = 800
	let visibleObserveRetryTimer: any = null
	let visibleObserveRetryCount: number = 0
	const VISIBLE_OBSERVE_MAX_RETRY: number = 10
	let voicePlayedSyncTimer: any = null
	let voicePlayedSyncInFlight: boolean = false
	const voicePlayedPendingSync = new Map<string, boolean>()
	let voicePlayedCompensateTimer: any = null
	let voicePlayedCompensateInFlight: boolean = false

	function compareSeqLocal(a: string, b: string): number {
		const as = a != null && a !== '' ? a : '0'
		const bs = b != null && b !== '' ? b : '0'
		try {
			const ai = BigInt(as)
			const bi = BigInt(bs)
			if (ai === bi) return 0
			return ai > bi ? 1 : -1
		} catch (e) {
			if (as === bs) return 0
			return as > bs ? 1 : -1
		}
	}

	function scheduleServerReadAdvance(seq: string): void {
		try {
			const s = seq != null && seq !== '' ? seq.toString() : '0'
			if (compareSeqLocal(s, serverReadPendingSeq) > 0) {
				serverReadPendingSeq = s
			}
			if (serverReadDebounceTimer != null) {
				clearTimeout(serverReadDebounceTimer)
				serverReadDebounceTimer = null
			}
			serverReadDebounceTimer = setTimeout(() => {
				try {
					if (!chatId.value || chatId.value === '' || chatId.value === '0') {
						return
					}
					const pending = serverReadPendingSeq
					if (compareSeqLocal(pending, serverReadLastSentSeq) <= 0) {
						return
					}
					serverReadLastSentSeq = pending
					badgeService.clearConversationBadge(chatId.value, pending)
				} catch (e) {
					// ignore
				}
			}, SERVER_READ_DEBOUNCE_MS)
		} catch (e) {
			// ignore
		}
	}

	function applyVisibleReadAdvance(seq: string): void {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			const s = seq != null && seq !== '' ? seq.toString() : '0'
			if (s === '0') {
				return
			}
			if (compareSeqLocal(s, visibleReadMaxSeq) <= 0) {
				return
			}
			visibleReadMaxSeq = s
			try {
				import('../../services/conversation-service.uts').then((convServiceModule) => {
					try {
						const cs = (convServiceModule as any).conversationService
						if (cs == null) {
							return
						}
						cs.applyReadWatermark(chatId.value, s)
					} catch (e) {
						// ignore
					}
				}).catch((_e: any) => {
					// ignore
				})
			} catch (e) {
				// ignore
			}
			try {
				badgeService.clearConversationBadgeLocal(chatId.value)
			} catch (e) {
				// ignore
			}
			scheduleServerReadAdvance(s)
		} catch (e) {
			// ignore
		}
	}

	function initVisibleReadObserver(): void {
		try {
			if (visibleObserver != null) {
				return
			}
			const inst = getCurrentInstance()
			const ctx = inst != null ? (inst as any).proxy : null
			if (ctx == null) {
				return
			}
			visibleObserver = uni.createIntersectionObserver(ctx)
			visibleObserver!.relativeTo('.chat-content', { top: '0px', bottom: '0px' })
			startVisibleReadObserve(ctx)
		} catch (e) {
			visibleObserver = null
		}
	}

	function startVisibleReadObserve(ctx: any): void {
		try {
			if (visibleObserver == null) {
				return
			}
			if (visibleObserverWatching) {
				return
			}
			if (visibleObserveRetryTimer != null) {
				clearTimeout(visibleObserveRetryTimer)
				visibleObserveRetryTimer = null
			}
			uni.nextTick(() => {
				try {
					if (visibleObserver == null) {
						return
					}
					const query = uni.createSelectorQuery().in(ctx)
					query.selectAll('.read-observe-item').boundingClientRect((rects: any) => {
						try {
							const arr = rects as any[]
							if (arr == null || arr.length <= 0) {
								if (visibleObserveRetryCount < VISIBLE_OBSERVE_MAX_RETRY) {
									visibleObserveRetryCount = visibleObserveRetryCount + 1
									visibleObserveRetryTimer = setTimeout(() => {
										visibleObserveRetryTimer = null
										startVisibleReadObserve(ctx)
									}, 120)
								}
								return
							}
							visibleObserveRetryCount = 0
							visibleObserverWatching = true
							visibleObserver!.observe('.read-observe-item', (res) => {
								try {
									if (res == null || (res as any).intersectionRatio == null) {
										return
									}
									const ratio = Number((res as any).intersectionRatio)
									if (ratio < 0.5) {
										return
									}
									const now = Date.now()
									if (now - lastScrollAt < 120) {
										return
									}
									const dataset = (res as any).dataset as UTSJSONObject
									const selfFlag = dataset != null ? (dataset['self'] as any) : null
									if (selfFlag != null && selfFlag.toString() === '1') {
										return
									}
									const seq = dataset != null ? (dataset['seq'] as any) : null
									const s = seq != null ? seq.toString() : '0'
									applyVisibleReadAdvance(s)
								} catch (e) {
									// ignore
								}
							})
						} catch (e) {
							// ignore
						}
					}).exec()
				} catch (e) {
					// ignore
				}
			})
		} catch (e) {
			// ignore
		}
	}

	function destroyVisibleReadObserver(): void {
		try {
			if (visibleObserveRetryTimer != null) {
				clearTimeout(visibleObserveRetryTimer)
				visibleObserveRetryTimer = null
			}
			if (visibleObserver != null) {
				visibleObserver!.disconnect()
				visibleObserver = null
				visibleObserverWatching = false
			}
		} catch (e) {
			visibleObserver = null
			visibleObserverWatching = false
		}
	}

	async function computeMaxSeqForRead(): Promise<string> {
		let maxSeq = '0'
		// 优先使用会话服务里的权威 lastMessageSequence（通常来源于 sync/list）
		try {
			const convServiceModule = await import('../../services/conversation-service.uts')
			const cs = (convServiceModule as any).conversationService
			const conv = cs != null ? cs.getConversation(chatId.value) : null
			const seqFromConv = conv != null && (conv as any).lastMessageSequence != null
				? (conv as any).lastMessageSequence.toString()
				: '0'
			if (seqFromConv != null && seqFromConv !== '' && seqFromConv !== '0') {
				maxSeq = seqFromConv
			}
		} catch (e) {
			// ignore
		}
		// 兜底：使用当前页面已加载的消息列表的最大 sequence（比 messageService 缓存更可靠）
		try {
			for (let i = 0; i < messages.value.length; i++) {
				const s = (messages.value[i] as any).sequence
				if (s == null || s === '') {
					continue
				}
				try {
					if (BigInt(s) > BigInt(maxSeq)) {
						maxSeq = s
					}
				} catch (e) {
					if (s > maxSeq) {
						maxSeq = s
					}
				}
			}
		} catch (e) {
			// ignore
		}
		// 最后兜底：仍使用 messageService 缓存（可能为空）
		if (maxSeq === '0') {
			try {
				const localMsgs = messageService.getMessages(chatId.value)
				for (let i = 0; i < localMsgs.length; i++) {
					const s = (localMsgs[i] as any).sequence
					if (s == null || s === '') {
						continue
					}
					try {
						if (BigInt(s) > BigInt(maxSeq)) {
							maxSeq = s
						}
					} catch (e) {
						if (s > maxSeq) {
							maxSeq = s
						}
					}
				}
			} catch (e) {
				maxSeq = '0'
			}
		}
		return maxSeq
	}

	async function flushReadOnLeave(): Promise<void> {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			if (flushInFlight) {
				return
			}
			const maxSeq = await computeMaxSeqForRead()
			let localUnread = 0
			try {
				localUnread = badgeService.getConversationBadge(chatId.value)
			} catch (e) {
				localUnread = 0
			}
			const now = Date.now()
			if (localUnread <= 0 && maxSeq != null && maxSeq !== '' && maxSeq === lastFlushedSeq && (now - lastFlushedAt) < 1000) {
				return
			}
			flushInFlight = true
			lastFlushedSeq = maxSeq
			lastFlushedAt = now
			badgeService.clearConversationBadge(chatId.value, maxSeq)
			messageService.clearUnreadCount(chatId.value)
		} catch (e) {
			// ignore
		} finally {
			flushInFlight = false
		}
	}

	/**
	 * 仿微信聊天时间线显示逻辑
	 */
	function formatChatTime(timestamp : number, lastTimestamp : number = 0) : string {
		// 如果两条消息间隔小于5分钟，不显示时间
		if (lastTimestamp > 0 && timestamp - lastTimestamp < 5 * 60 * 1000) {
			return ''
		}

		const date = new Date(timestamp)
		const now = new Date()
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')

		if (isToday) {
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return `昨天 ${hours}:${minutes}`
		}
		
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return `${weekDays[date.getDay()]} ${hours}:${minutes}`
		}
		
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}-${day} ${hours}:${minutes}`
		}
		return `${year}-${month}-${day} ${hours}:${minutes}`
	}

	function getFileExt(name : string) : string {
		if (!name) {
			return ''
		}
		const idx = name.lastIndexOf('.')
		if (idx < 0) {
			return ''
		}
		return name.substring(idx + 1).toLowerCase()
	}

	function getFileExtFromUrl(url : string) : string {
		if (!url) {
			return ''
		}
		let cleanUrl = url
		const q = cleanUrl.indexOf('?')
		if (q >= 0) {
			cleanUrl = cleanUrl.substring(0, q)
		}
		const hash = cleanUrl.indexOf('#')
		if (hash >= 0) {
			cleanUrl = cleanUrl.substring(0, hash)
		}
		const slash = cleanUrl.lastIndexOf('/')
		if (slash >= 0) {
			cleanUrl = cleanUrl.substring(slash + 1)
		}
		return getFileExt(cleanUrl)
	}

	function isImageExt(ext : string) : boolean {
		return ['png', 'jpg', 'jpeg', 'gif', 'webp', 'bmp', 'svg'].includes(ext)
	}

	function isVideoExt(ext : string) : boolean {
		return ['mp4', 'mov', 'avi', 'mkv', 'webm', 'm4v', '3gp'].includes(ext)
	}

	function isAudioExt(ext : string) : boolean {
		return ['mp3', 'wav', 'aac', 'm4a', 'ogg', 'flac'].includes(ext)
	}

	function isZipExt(ext : string) : boolean {
		return ['zip', 'rar', '7z', 'tar', 'gz', 'bz2', 'xz'].includes(ext)
	}

	function isWordExt(ext : string) : boolean {
		return ['doc', 'docx', 'dot', 'dotx'].includes(ext)
	}

	function isExcelExt(ext : string) : boolean {
		return ['xls', 'xlsx', 'csv'].includes(ext)
	}

	function isPptExt(ext : string) : boolean {
		return ['ppt', 'pptx', 'pps', 'ppsx'].includes(ext)
	}

	function isTextExt(ext : string) : boolean {
		return ['txt', 'log', 'md', 'json', 'xml', 'yml', 'yaml', 'ini', 'conf'].includes(ext)
	}

	function getFileIconUnicode(msg : MessageItem) : string {
		// iconfont.json 对应的 unicode：
		// html=e609, sql=e69b, text=e603, excel=e6a4, ppt=e6a5, video=e6a6, image=e6a7,
		// unknown=e6a8, zip=e6a9, pdf=e6aa, word=e6ab, music=e6ac, folder=e6ad
		const name = msg.fileName || ''
		const mime = (msg as any).mimeType ? String((msg as any).mimeType) : ''
		let ext = getFileExt(name)

		// 开发阶段强约束：不再从 URL 推断 ext，FILE 消息必须携带 fileName/mimeType

		// 优先 mimeType 兜底（避免 ext 解析/混合 content 场景误判）
		if (mime) {
			const lowerMime = mime.toLowerCase()
			if (lowerMime.includes('ms-excel') || lowerMime.includes('spreadsheetml')) {
				return '\ue6a4'
			}
			if (lowerMime.includes('msword') || lowerMime.includes('wordprocessingml')) {
				return '\ue6ab'
			}
			if (lowerMime.includes('ms-powerpoint') || lowerMime.includes('presentationml')) {
				return '\ue6a5'
			}
			if (lowerMime === 'application/pdf') {
				return '\ue60c'
			}
		}

		if (mime.startsWith('image/')) {
			return '\ue606'
		}
		if (mime.startsWith('video/')) {
			return '\ue605'
		}
		if (mime.startsWith('audio/')) {
			return '\ue6ac'
		}

		if (ext === 'html' || ext === 'htm') {
			return '\ue609'
		}
		if (ext === 'sql') {
			return '\ue69b'
		}
		if (ext === 'pdf') {
			return '\ue60c'
		}
		if (isWordExt(ext)) {
			return '\ue6ab'
		}
		if (isExcelExt(ext)) {
			return '\ue6a4'
		}
		if (isPptExt(ext)) {
			return '\ue6a5'
		}
		if (isVideoExt(ext)) {
			return '\ue605'
		}
		if (isImageExt(ext)) {
			return '\ue606'
		}
		if (isAudioExt(ext)) {
			return '\ue6ac'
		}
		if (isZipExt(ext)) {
			return '\ue6d6'
		}
		if (isTextExt(ext)) {
			return '\ue854'
		}

		return '\ue603'
	}

	function getFileIconColor(msg : MessageItem) : string {
		const name = msg.fileName || ''
		const mime = (msg as any).mimeType ? String((msg as any).mimeType) : ''
		const ext = getFileExt(name)
		const lowerMime = mime ? mime.toLowerCase() : ''

		if (lowerMime.includes('ms-excel') || lowerMime.includes('spreadsheetml') || isExcelExt(ext)) {
			return '#34C759'
		}
		if (lowerMime.includes('msword') || lowerMime.includes('wordprocessingml') || isWordExt(ext)) {
			return '#3370FF'
		}
		if (lowerMime.includes('ms-powerpoint') || lowerMime.includes('presentationml') || isPptExt(ext)) {
			return '#FF9500'
		}
		if (lowerMime === 'application/pdf' || ext === 'pdf') {
			return '#F54A45'
		}
		if (mime.startsWith('image/') || isImageExt(ext)) {
			return '#FFB020'
		}
		if (mime.startsWith('video/') || isVideoExt(ext)) {
			return '#8A5CF6'
		}
		if (mime.startsWith('audio/') || isAudioExt(ext)) {
			return '#FF9500'
		}
		if (isZipExt(ext)) {
			return '#586c76'
		}
		if (ext === 'html' || ext === 'htm') {
			return '#FF6A00'
		}
		if (ext === 'sql') {
			return '#8F959E'
		}
		if (isTextExt(ext)) {
			return '#4A90E2'
		}
		return '#C7CBD1'
	}

	function getFileNameFromMixedContent(content : any) : string {
		if (content === null) {
			return ''
		}
		// REST 历史消息可能直接存字符串：
		// 1) "http://.../xxx.pdf"
		// 2) "http://.../ 何肖肖入职offfer.pdf"（中间有空格）
		const raw = String(content)
		const trimmed = raw.trim()
		if (!trimmed) {
			return ''
		}
		// 如果包含空格，优先取最后一段作为文件名
		const parts = trimmed.split(' ').filter(p => !!p)
		const lastPart = parts.length > 1 ? parts[parts.length - 1] : trimmed
		// 尝试从 URL 截取
		let urlPart = parts.length > 1 ? parts[0] : trimmed
		// 如果 lastPart 本身就是一个 URL（极端情况），则直接走 URL 解析
		if (lastPart.startsWith('http://') || lastPart.startsWith('https://')) {
			urlPart = lastPart
		}
		let candidate = lastPart
		if (candidate.startsWith('http://') || candidate.startsWith('https://')) {
			// url 里取最后 path segment
			let cleanUrl = candidate
			const q = cleanUrl.indexOf('?')
			if (q >= 0) cleanUrl = cleanUrl.substring(0, q)
			const hash = cleanUrl.indexOf('#')
			if (hash >= 0) cleanUrl = cleanUrl.substring(0, hash)
			const slash = cleanUrl.lastIndexOf('/')
			candidate = slash >= 0 ? cleanUrl.substring(slash + 1) : cleanUrl
		} else if (urlPart.startsWith('http://') || urlPart.startsWith('https://')) {
			// url + 文件名 混合场景，candidate 就是文件名
		}
		try {
			candidate = decodeURIComponent(candidate)
		} catch (e) {
			// ignore
		}
		return candidate
	}

	function getFileUrlFromMixedContent(content : any) : string {
		if (content === null) {
			return ''
		}
		const raw = String(content).trim()
		if (!raw) {
			return ''
		}
		// url + 文件名 混合场景：取第一个 token 作为 url
		const parts = raw.split(' ').filter(p => !!p)
		const candidate = parts.length > 1 ? parts[0] : raw
		if (candidate.startsWith('http://') || candidate.startsWith('https://')) {
			return candidate
		}
		return raw
	}

	function applyFileFields(uiMessage : MessageItem, rawContent : any) {
		if (uiMessage.type !== 'file') {
			return
		}
		// rawContent 可能是对象（ws/body 或后端存 json），也可能是字符串
		let fileName = ''
		let sizeNum : number | null = null
		let mimeType = ''
		if (rawContent && typeof rawContent === 'object') {
			fileName = rawContent.fileName || rawContent.name || ''
			// size 可能是 number 或 string
			if (rawContent.size !== null) {
				const n = Number(rawContent.size)
				sizeNum = isNaN(n) ? null : n
			}
			mimeType = rawContent.fileType || rawContent.mimeType || ''
		} else {
			console.error('[Chat] FILE 消息缺少结构化元数据(rawContent object)，请确保后端 extra 或 WS FileMessage body 携带 fileName/size/fileType')
		}

		// 开发阶段强约束：不再从 content/url 推断 fileName 或规范化 url
		if (fileName) {
			uiMessage.fileName = fileName
		}
		if (sizeNum !== null) {
			uiMessage.fileSize = formatFileSize(sizeNum)
		}
		if (mimeType) {
			;(uiMessage as any).mimeType = mimeType
		}
	}

	function applyVoiceFields(uiMessage : MessageItem, rawContent : any, extra ?: any) {
		if (uiMessage.type !== 'voice') {
			return
		}
		const parsedExtra = parseRawContent(extra)
		const parsedBody = parseRawContent(rawContent)
		const extraObj = parsedExtra != null && typeof parsedExtra === 'object' ? parsedExtra as any : null
		const bodyObj = parsedBody != null && typeof parsedBody === 'object' ? parsedBody as any : null
		let durationSec = extraObj != null && extraObj.duration != null ? Number(extraObj.duration) : 0
		let durationMs = extraObj != null && extraObj.durationMs != null ? Number(extraObj.durationMs) : 0
		let sizeNum = extraObj != null && extraObj.size != null ? Number(extraObj.size) : 0
		let formatStr = extraObj != null && extraObj.format != null ? String(extraObj.format) : ''
		const md5Str = extraObj != null && extraObj.md5 != null ? String(extraObj.md5) : ''
		let fileIdStr = extraObj != null && extraObj.fileId != null ? String(extraObj.fileId) : ''
		if (durationSec <= 0 && bodyObj != null && bodyObj.duration != null) {
			durationSec = Number(bodyObj.duration)
		}
		if (durationMs <= 0 && bodyObj != null && bodyObj.durationMs != null) {
			durationMs = Number(bodyObj.durationMs)
		}
		if (sizeNum <= 0 && bodyObj != null && bodyObj.size != null) {
			sizeNum = Number(bodyObj.size)
		}
		if (formatStr === '' && bodyObj != null && bodyObj.format != null) {
			formatStr = String(bodyObj.format)
		}
		if ((fileIdStr === '' || fileIdStr === '0') && bodyObj != null && bodyObj.fileId != null) {
			fileIdStr = String(bodyObj.fileId)
		}
		if (durationSec <= 0 && durationMs > 0) {
			durationSec = Math.max(1, Math.round(durationMs / 1000))
		}
		if (durationMs <= 0 && durationSec > 0) {
			durationMs = Math.max(1000, Math.round(durationSec * 1000))
		}
		const serverVoicePlayed = (uiMessage as any).voicePlayed === true
			|| (uiMessage as any).voicePlayed === 1
			|| (uiMessage as any).voicePlayed === '1'
			|| (uiMessage as any).voicePlayed === 'true'
		;(uiMessage as any).voicePlayed = uiMessage.isSelf ? true : (serverVoicePlayed || hasVoiceBeenPlayed(uiMessage.messageId))
		uiMessage.content = ''
		if (durationSec > 0) {
			uiMessage.duration = Math.max(1, Math.round(durationSec))
		}
		if (durationMs > 0) {
			;(uiMessage as any).durationMs = Math.max(1000, Math.round(durationMs))
		}
		if (sizeNum > 0) {
			;(uiMessage as any).size = sizeNum
			;(uiMessage as any).voiceSize = sizeNum
		}
		if (formatStr !== '') {
			;(uiMessage as any).format = formatStr
			;(uiMessage as any).voiceFormat = formatStr
		}
		if (fileIdStr !== '' && fileIdStr !== '0') {
			;(uiMessage as any).fileId = fileIdStr
		}
		if (md5Str !== '') {
			uiMessage.md5 = md5Str
		}
	}

	function applyStickerFields(uiMessage : MessageItem, rawContent : any, extra ?: any) : void {
		if (uiMessage.type !== 'sticker' && uiMessage.type !== 'emoji') {
			return
		}
		const payload = parseStickerPayload(rawContent, extra)
		if (payload == null || typeof payload !== 'object') {
			return
		}
		if ((payload as any).fileId != null && String((payload as any).fileId) !== '' && String((payload as any).fileId) !== '0') {
			;(uiMessage as any).fileId = String((payload as any).fileId)
		}
		if ((payload as any).md5 != null && String((payload as any).md5) !== '') {
			uiMessage.md5 = String((payload as any).md5)
		}
		if ((payload as any).mimeType != null && String((payload as any).mimeType) !== '') {
			;(uiMessage as any).mimeType = String((payload as any).mimeType)
		}
		if ((payload as any).thumbUrl != null && String((payload as any).thumbUrl) !== '') {
			;(uiMessage as any).thumbUrl = String((payload as any).thumbUrl)
		}
	}

	function applyLocationFields(uiMessage : MessageItem, rawContent : any) : void {
		if (uiMessage.type !== 'location') {
			return
		}
		const parsed = parseRawContent(rawContent)
		if (parsed != null && typeof parsed === 'object') {
			const address = (parsed as any).address != null ? String((parsed as any).address) : ''
			const locationName = (parsed as any).name != null
				? String((parsed as any).name)
				: ((parsed as any).locationName != null ? String((parsed as any).locationName) : address)
			let latitude : number | null = null
			let longitude : number | null = null
			if ((parsed as any).latitude != null) {
				const latVal = Number((parsed as any).latitude)
				latitude = isNaN(latVal) ? null : latVal
			}
			if ((parsed as any).longitude != null) {
				const lngVal = Number((parsed as any).longitude)
				longitude = isNaN(lngVal) ? null : lngVal
			}
			if (address !== '') {
				uiMessage.address = address
			}
			if (locationName !== '') {
				uiMessage.locationName = locationName
			} else if (address !== '') {
				uiMessage.locationName = address
			}
			if (latitude !== null) {
				uiMessage.latitude = latitude
			}
			if (longitude !== null) {
				uiMessage.longitude = longitude
			}
			return
		}
		const text = parsed != null ? String(parsed) : ''
		if (text !== '') {
			uiMessage.address = text
			uiMessage.locationName = text
		}
	}

	function applyContactCardFields(uiMessage : MessageItem, rawContent : any, extra ?: any) : void {
		if (uiMessage.type !== 'contact_card') {
			return
		}
		const payload = parseContactCardPayload(rawContent, extra)
		if (payload == null || typeof payload !== 'object') {
			return
		}
		const userId = (payload as any).userId != null ? String((payload as any).userId) : ''
		const displayName = (payload as any).displayName != null
			? String((payload as any).displayName)
			: (
				(payload as any).name != null ? String((payload as any).name) : (
					(payload as any).nickname != null ? String((payload as any).nickname) : (
						(payload as any).userNickname != null ? String((payload as any).userNickname) : (
							(payload as any).remarkName != null ? String((payload as any).remarkName) : ''
						)
					)
				)
			)
		const deptName = (payload as any).deptName != null ? String((payload as any).deptName) : ''
		const postName = (payload as any).postName != null ? String((payload as any).postName) : ''
		const avatar = (payload as any).avatar != null ? String((payload as any).avatar) : ''
		uiMessage.contactUserId = userId
		uiMessage.contactDisplayName = displayName !== '' ? displayName : '名片'
		if (deptName !== '') {
			uiMessage.contactDeptName = deptName
		}
		if (postName !== '') {
			uiMessage.contactPostName = postName
		}
		if (avatar !== '') {
			uiMessage.contactAvatar = avatar
		}
		uiMessage.content = displayName !== '' ? displayName : '名片'
	}
	
	/**
	 * 加载历史消息
	 */
	async function loadMessages() {
		if (loading.value) {
			return
		}
		
		// 如果没有 chatId，说明是新创建的群聊，暂时不加载消息
		if (!chatId.value || chatId.value === '' || chatId.value === '0') {
			console.log('[Chat] chatId 为空，跳过加载消息（新创建的群聊）')
			loading.value = false
			return
		}
		
		loading.value = true
		
		try {
			// 1. 先从缓存加载（立即显示）
			const cachedMessages = messageService.getMessages(chatId.value)
			if (cachedMessages.length > 0) {
				messages.value = convertServiceMessages(cachedMessages)
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				if (entryMode.value === 'latest' && targetAnchorSequence.value === '' && targetMessageId.value === '') {
					scrollToBottom()
				}
			}
			
			// 2. 从服务器加载窗口消息
			let windowResult: any = null
			if (targetAnchorSequence.value !== '') {
				windowResult = await getMessageWindow({
					chatId: chatId.value,
					anchorSequence: targetAnchorSequence.value,
					beforeLimit: 15,
					afterLimit: 10
				})
			} else if (targetMessageId.value !== '') {
				windowResult = await getMessageWindow({
					chatId: chatId.value,
					anchorMessageId: targetMessageId.value,
					beforeLimit: 15,
					afterLimit: 10
				})
			} else {
				windowResult = await getMessageWindow({
					chatId: chatId.value,
					mode: 'latest',
					limit: 30
				})
			}

			const serverMessages = windowResult
				? (Array.isArray((windowResult as any).items) ? (windowResult as any).items : [])
				: []
			if (serverMessages.length > 0) {
				try {
					await messageService.ingestRestHistoryPage(chatId.value, serverMessages)
				} catch (e) {
					// ignore
				}
				syncLoadedWindowState(windowResult)
				replaceVisibleWindowMessages(serverMessages.map(msg => convertServerMessage(msg)))
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				
				seedLastPulledSequenceFromView((windowResult as any).newestSequence)
				hasMore.value = !!((windowResult as any).hasOlder === true)

				const anchorFound = !windowResult || (windowResult as any).anchorFound !== false
				if ((windowResult as any).anchorSequence != null && String((windowResult as any).anchorSequence) !== '') {
					targetAnchorSequence.value = String((windowResult as any).anchorSequence)
				}
				if (entryMode.value === 'anchor' || entryMode.value === 'restore') {
					if (!anchorFound) {
						uni.showToast({ title: '原消息已不可定位，已为你打开最近消息', icon: 'none' })
						scrollToBottom()
					} else {
						setTimeout(() => {
							if (targetMessageId.value !== '') {
								void scrollToTargetMessage(targetMessageId.value)
							} else if (targetAnchorSequence.value !== '') {
								scrollToSequence(targetAnchorSequence.value)
							}
						}, 300)
					}
				} else {
					scrollToBottom()
				}
			} else {
				hasMore.value = !!(windowResult && (windowResult as any).hasOlder === true)
				if (entryMode.value !== 'anchor' && entryMode.value !== 'restore') {
					scrollToBottom()
				}
			}
			
		} catch (e) {
			console.error('[Chat] 加载消息失败:', e)
			// 显示网络错误提示,允许用户重试
			uni.showToast({
				title: '网络异常，加载消息失败',
				icon: 'none',
				duration: 2000
			})
		} finally {
			loading.value = false
		}
	}

	function replaceVisibleWindowMessages(windowMessages: MessageItem[]): void {
		const pendingLocal = messages.value.filter(msg => {
			const seq = msg && (msg as any).sequence != null ? String((msg as any).sequence) : ''
			const statusRaw: any = msg && (msg as any).status != null ? (msg as any).status : null
			const statusNum = statusRaw != null ? Number(statusRaw) : null
			return seq === '' || seq === '0' || statusNum === 1 || statusNum === 5
		})
		messages.value = mergeMessages(windowMessages, pendingLocal)
	}

	function seedLastPulledSequenceFromView(preferredNewest?: any): void {
		try {
			let maxSeq = preferredNewest != null && String(preferredNewest) !== '' ? String(preferredNewest) : '0'
			for (let i = 0; i < messages.value.length; i++) {
				const s = (messages.value[i] as any).sequence
				if (s == null || s === '') {
					continue
				}
				try {
					if (BigInt(String(s)) > BigInt(maxSeq)) {
						maxSeq = String(s)
					}
				} catch (e) {
					if (String(s) > maxSeq) {
						maxSeq = String(s)
					}
				}
			}
			if (maxSeq !== '0') {
				messageService.seedLastPulledSequence(chatId.value, maxSeq)
			}
		} catch (e) {
			// ignore
		}
	}

	function syncLoadedWindowState(resp: any): void {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			const oldest = resp != null && (resp as any).oldestSequence != null ? String((resp as any).oldestSequence) : null
			const newest = resp != null && (resp as any).newestSequence != null ? String((resp as any).newestSequence) : null
			messageService.updateLoadedWindowState(chatId.value, oldest, newest)
		} catch (e) {
			// ignore
		}
	}

	function findMessageIndexBySequence(sequence: string): number {
		return messages.value.findIndex(msg => {
			const seq = msg && (msg as any).sequence != null ? String((msg as any).sequence) : ''
			return seq === sequence
		})
	}

	function scrollToSequence(sequence: string): void {
		const idx = findMessageIndexBySequence(sequence)
		if (idx === -1) {
			return
		}
		lastMessageId.value = 'msg-' + idx
		if (shouldHighlight.value) {
			const targetMsg = messages.value[idx]
			highlightedMessageId.value = getSelectMessageId(targetMsg)
			setTimeout(() => {
				highlightedMessageId.value = ''
			}, 3000)
		}
	}

	async function loadAnchorWindow(anchorSequence: string | null = null, anchorMessageId: string | null = null): Promise<boolean> {
		if (!chatId.value || chatId.value === '' || chatId.value === '0') {
			return false
		}
		try {
			const resp: any = await getMessageWindow({
				chatId: chatId.value,
				anchorSequence: anchorSequence != null && anchorSequence !== '' ? anchorSequence : null,
				anchorMessageId: anchorMessageId != null && anchorMessageId !== '' ? anchorMessageId : null,
				beforeLimit: 15,
				afterLimit: 10
			})
			const items = resp != null && Array.isArray(resp.items) ? resp.items : []
			if (items.length > 0) {
				try {
					await messageService.ingestRestHistoryPage(chatId.value, items)
				} catch (e) {
					// ignore
				}
				syncLoadedWindowState(resp)
				replaceVisibleWindowMessages(items.map((msg: any) => convertServerMessage(msg)))
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				seedLastPulledSequenceFromView(resp != null ? (resp as any).newestSequence : null)
			}
			hasMore.value = !!(resp != null && (resp as any).hasOlder === true)
			if (resp != null && (resp as any).anchorSequence != null && String((resp as any).anchorSequence) !== '') {
				targetAnchorSequence.value = String((resp as any).anchorSequence)
			}
			if (resp != null && (resp as any).anchorFound === false) {
				uni.showToast({ title: '原消息已不可定位，已为你打开最近消息', icon: 'none' })
				return false
			}
			return true
		} catch (e) {
			console.error('[Chat] 加载锚点窗口失败:', e)
			return false
		}
	}

	async function loadOlderHistory(forceProbe: boolean = false): Promise<void> {
		if (historyLoading.value || loading.value || (!forceProbe && !hasMore.value)) {
			return
		}
		if (messages.value.length === 0) {
			return
		}
		const firstMsg = messages.value[0]
		let beforeSequence = firstMsg && (firstMsg as any).sequence != null ? String((firstMsg as any).sequence) : ''
		if (beforeSequence === '' || beforeSequence === '0') {
			try {
				const loaded = messageService.getLoadedWindowState(chatId.value)
				beforeSequence = loaded != null && loaded.oldestSequence != null ? String(loaded.oldestSequence) : ''
			} catch (e) {
				beforeSequence = ''
			}
		}
		if (beforeSequence === '' || beforeSequence === '0') {
			hasMore.value = false
			return
		}
		const preserveSequence = firstMsg && (firstMsg as any).sequence != null ? String((firstMsg as any).sequence) : ''
		const preserveMessageId = getSelectMessageId(firstMsg)
		historyLoading.value = true
		try {
			const historyResp: any = await getMessageHistory(chatId.value, beforeSequence, 30)
			const items = historyResp != null && Array.isArray(historyResp.items) ? historyResp.items : []
			if (items.length > 0) {
				try {
					await messageService.ingestRestHistoryPage(chatId.value, items)
				} catch (e) {
					// ignore
				}
				syncLoadedWindowState(historyResp)
				const olderMessages = items.map((msg: any) => convertServerMessage(msg))
				messages.value = mergeMessages(olderMessages, messages.value)
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				setTimeout(() => {
					let idx = -1
					if (preserveSequence !== '' && preserveSequence !== '0') {
						idx = findMessageIndexBySequence(preserveSequence)
					}
					if (idx === -1) {
						idx = findMessageIndexForTargetId(preserveMessageId)
					}
					if (idx !== -1) {
						lastMessageId.value = 'msg-' + idx
					}
				}, 60)
			}
			hasMore.value = !!(historyResp != null && (historyResp as any).hasOlder === true)
		} catch (e) {
			console.error('[Chat] 加载更早历史失败:', e)
		} finally {
			historyLoading.value = false
		}
	}
	
	/**
	 * 转换服务端消息为 UI 消息格式
	 */
	function convertServerMessage(msg : any) : MessageItem {
		// 安全地解析内容，防止 JSON 解析错误
		let rawContent : any
		let content : any
		let extraContent : any
		try {
			rawContent = parseRawContent(msg.content)
			content = parseMessageContent(rawContent)
		} catch (e) {
			console.error('[Chat] 解析消息内容失败:', e, msg.content)
			rawContent = msg.content
			content = msg.content
		}
		// extra 通常为 JSON 字符串（尤其是文件消息），用于补齐 fileName/size/mimeType
		try {
			extraContent = parseRawContent(msg.extra)
		} catch (e) {
			extraContent = msg.extra
		}
		
		const senderIdStr = msg && msg.senderId != null ? msg.senderId.toString() : '0'
	const receiverIdStr = msg && msg.receiverId != null ? msg.receiverId.toString() : ''
	const idStr = msg && msg.id != null ? msg.id.toString() : '0'
	const chatIdStr = msg && msg.chatId != null ? msg.chatId.toString() : (chatId.value != null ? chatId.value.toString() : '0')
	const groupIdStr = msg && msg.groupId != null ? msg.groupId.toString() : ''
	const sequenceStr = msg && msg.sequence != null ? msg.sequence.toString() : '0'
	// 后端 REST API 历史消息通常只有 id 字段，没有 messageId 字段
	const messageIdStr = msg && msg.messageId != null ? msg.messageId.toString() : idStr
	
	// 处理发送者信息缺失的后备方案
	const senderNickname = msg.senderNickname || ''
	const avatarText = senderNickname ? getAvatarTextUtil(senderNickname) : '?'
	const isSelfVal = resolveMessageIsSelf((msg as any).isSelf, senderIdStr)
		// 后端 status: 0-发送中 1-已发送 2-已读 3-失败 6-已撤回
		// 这里保留数值状态，避免把 status=2 误映射为 'sending' 导致气泡旁已读/未读入口不展示
		let statusVal: any = (msg as any).status
		try {
			if (statusVal === null || statusVal === '') {
				statusVal = 0
			}
		} catch (e) {
			statusVal = 0
		}
		let isRecalled = false
		try {
			isRecalled = statusVal === 6 || statusVal === '6'
		} catch (e) {
			isRecalled = false
		}
	
		const uiMessage = {
			id: idStr,
			messageId: messageIdStr,
			rev: (msg as any).rev != null ? String((msg as any).rev) : '1',
			chatId: chatIdStr,
			groupId: groupIdStr,
			sequence: sequenceStr,
			senderId: senderIdStr,
			receiverId: receiverIdStr,
			type: isRecalled ? 'text' : resolveUiMessageType(msg.messageType, content, extraContent),
			content: isRecalled ? (isSelfVal ? '你撤回了一条消息' : `${senderNickname} 撤回了一条消息`) : (resolveUiMessageType(msg.messageType, content, extraContent) === 'sticker' ? extractStickerUrl(content, extraContent) : getMessageContent(msg.messageType, content)),
			isSelf: isSelfVal,
			time: msg.sendTime || msg.createTime || '',
			timestamp: new Date(msg.sendTime || msg.createTime || Date.now()).getTime(),
			showTime: true,
			avatarText: avatarText,
			avatarBg: getUserAvatarColor(senderIdStr),
			senderName: senderNickname,
			status: statusVal,
			voicePlayed: (msg as any).voicePlayed === true
				|| (msg as any).voicePlayed === 1
				|| (msg as any).voicePlayed === '1'
				|| (msg as any).voicePlayed === 'true'
		} as MessageItem

		// enterprise: re-edit-after-recall rehydration for refresh/re-enter (REST history lacks original content)
		try {
			if (isRecalled && isSelfVal) {
				const hint = messageService.getReeditHint(chatIdStr, messageIdStr)
				if (hint != null && hint.content) {
					;(uiMessage as any).reeditContent = hint.content
					if (hint.deadlineTs) {
						;(uiMessage as any).reeditDeadlineTs = hint.deadlineTs
					}
				}
			}
		} catch (e) {
		}

		applyQuoteFields(uiMessage, rawContent, msg, extraContent)
		applyVoiceFields(uiMessage, content, extraContent)
		applyFileFields(uiMessage, extraContent && typeof extraContent === 'object' ? extraContent : content)
		applyLocationFields(uiMessage, content)
		applyContactCardFields(uiMessage, content, extraContent)
		applyStickerFields(uiMessage, content, extraContent)
		applyMediaFileId(uiMessage, extraContent && typeof extraContent === 'object' ? extraContent : content)
		maybePatchMediaDisplayUrl(uiMessage as any)
		return uiMessage
	}

/**
 * 转换消息服务的消息为 UI 消息格式
 */
function convertServiceMessages(serviceMessages : ServiceMessageItem[]) : MessageItem[] {
	return serviceMessages.map(msg => {
		const senderIdStr = msg && msg.senderId != null ? msg.senderId.toString() : '0'
		const receiverIdStr = msg && msg.receiverId != null ? msg.receiverId.toString() : '0'
		const messageIdStr = msg && msg.messageId != null ? msg.messageId.toString() : '0'
		const idStr = msg && msg.id != null ? msg.id.toString() : '0'
		const chatIdStr = (msg as any) && (msg as any).chatId != null ? (msg as any).chatId.toString() : (chatId.value != null ? chatId.value.toString() : '0')
		const groupIdStr = (msg as any) && (msg as any).groupId != null ? (msg as any).groupId.toString() : ''
		const sequenceStr = (msg as any) && (msg as any).sequence != null ? (msg as any).sequence.toString() : '0'
		
		const uiMessage = {
			id: idStr,
			messageId: messageIdStr,
			rev: (msg as any).rev != null ? String((msg as any).rev) : '1',
			chatId: chatIdStr,
			groupId: groupIdStr,
			sequence: sequenceStr,
			senderId: senderIdStr,
			receiverId: receiverIdStr,
			type: resolveUiMessageType(msg.type, msg.content, (msg as any).extra),
			content: getServiceMessageContent(msg),
			isSelf: resolveMessageIsSelf((msg as any).isSelf, senderIdStr),
			time: new Date(msg.timestamp).toLocaleString(),
			timestamp: msg.timestamp,
			showTime: true,
			avatarText: msg.avatarText,
			avatarBg: msg.avatarBg,
			senderName: msg.senderName,
			status: (msg as any).status,
			voicePlayed: (msg as any).voicePlayed === true
				|| (msg as any).voicePlayed === 1
				|| (msg as any).voicePlayed === '1'
				|| (msg as any).voicePlayed === 'true'
		} as MessageItem
		try {
			const ex: any = msg as any
			if (ex != null) {
				if (ex.reeditContent != null && String(ex.reeditContent) !== '') {
					;(uiMessage as any).reeditContent = String(ex.reeditContent)
				}
				if (ex.reeditDeadlineTs != null && String(ex.reeditDeadlineTs) !== '') {
					;(uiMessage as any).reeditDeadlineTs = String(ex.reeditDeadlineTs)
				}
			}
			if (((uiMessage as any).reeditContent == null || String((uiMessage as any).reeditContent) === '')
				&& (uiMessage as any).isSelf === true) {
				const hint = messageService.getReeditHintByCandidates(chatIdStr, [messageIdStr, idStr])
				if (hint != null && hint.content != null && hint.content !== '') {
					;(uiMessage as any).reeditContent = hint.content
					if (hint.deadlineTs != null && hint.deadlineTs !== '') {
						;(uiMessage as any).reeditDeadlineTs = hint.deadlineTs
					}
				}
			}
		} catch (e) {
		}

			const serviceExtra = (msg as any).extra != null
				? (msg as any).extra
				: ((msg as any).content != null && typeof (msg as any).content === 'object' ? (msg as any).content.extra : null)
			applyQuoteFields(uiMessage, msg.content, msg, serviceExtra)
			applyVoiceFields(uiMessage, msg.content, serviceExtra)
			applyFileFields(uiMessage, msg.content)
			applyLocationFields(uiMessage, msg.content)
			applyContactCardFields(uiMessage, msg.content, serviceExtra)
			applyStickerFields(uiMessage, msg.content, serviceExtra)
			applyMediaFileId(uiMessage, msg.content)
			maybePatchMediaDisplayUrl(uiMessage as any)
			return uiMessage
		})
	}

	function parseStickerPayload(raw : any, extra ?: any) : any {
		let body : any = safeParseJson(raw)
		if (body == null) {
			body = raw
		}
		if (body != null && typeof body === 'object') {
			if (body.extra != null) {
				let nestedExtra : any = safeParseJson(body.extra)
				if (nestedExtra == null) {
					nestedExtra = body.extra
				}
				if (nestedExtra != null && typeof nestedExtra === 'object') {
					if (nestedExtra.type != null && String(nestedExtra.type) === 'STICKER') {
						return nestedExtra
					}
					if (nestedExtra.stickerId != null || nestedExtra.fileId != null) {
						return nestedExtra
					}
				}
			}
			if (body.type != null && String(body.type) === 'STICKER') {
				return body
			}
			if (body.stickerId != null || body.fileId != null) {
				return body
			}
		}
		let extraObj : any = safeParseJson(extra)
		if (extraObj == null) {
			extraObj = extra
		}
		if (extraObj != null && typeof extraObj === 'object') {
			if (extraObj.type != null && String(extraObj.type) === 'STICKER') {
				return extraObj
			}
			if (extraObj.stickerId != null || extraObj.fileId != null) {
				return extraObj
			}
		}
		return null
	}

	function parseContactCardPayload(raw : any, extra ?: any) : any {
		let body : any = safeParseJson(raw)
		if (body == null) {
			body = raw
		}
		if (body != null && typeof body === 'object') {
			if (body.type != null && String(body.type) === 'CONTACT_CARD') {
				return body
			}
			if (body.extra != null) {
				let nestedExtra : any = safeParseJson(body.extra)
				if (nestedExtra == null) {
					nestedExtra = body.extra
				}
				if (nestedExtra != null && typeof nestedExtra === 'object'
					&& nestedExtra.type != null && String(nestedExtra.type) === 'CONTACT_CARD') {
					return nestedExtra
				}
			}
		}
		let extraObj : any = safeParseJson(extra)
		if (extraObj == null) {
			extraObj = extra
		}
		if (extraObj != null && typeof extraObj === 'object'
			&& extraObj.type != null && String(extraObj.type) === 'CONTACT_CARD') {
			return extraObj
		}
		return null
	}

	function resolveUiMessageType(messageType : any, rawContent : any, extra ?: any) : string {
		const baseType = getMessageTypeString(messageType)
		if (baseType === 'custom') {
			const contactPayload = parseContactCardPayload(rawContent, extra)
			if (contactPayload != null) {
				return 'contact_card'
			}
			const stickerPayload = parseStickerPayload(rawContent, extra)
			if (stickerPayload != null) {
				return 'sticker'
			}
		}
		return baseType
	}

	function extractStickerUrl(rawContent : any, extra ?: any) : string {
		const payload = parseStickerPayload(rawContent, extra)
		if (payload == null) {
			return ''
		}
		if (payload.url != null && String(payload.url) !== '') {
			return String(payload.url)
		}
		if (payload.thumbUrl != null && String(payload.thumbUrl) !== '') {
			return String(payload.thumbUrl)
		}
		return ''
	}
	
	/**
	 * 获取消息类型字符串
	 * 支持两种格式: REST API (1-6) / WebSocket (100-105)
	 */
	function getMessageTypeString(messageType : any) : string {
		if (typeof messageType === 'string') {
			return messageType
		}

		const typeMap = {
			// REST API 格式 (数据库存储)
			1: 'text',
			2: 'image',
			3: 'voice',
			4: 'video',
			5: 'file',
			6: 'location',
			7: 'emoji',
			8: 'sticker',
			9: 'custom',
			// WebSocket/Protobuf 格式
			100: 'text',
			101: 'image',
			102: 'voice',
			103: 'video',
			104: 'file',
			105: 'location',
			106: 'custom',
			205: 'quote'
		}
		return typeMap[messageType] || 'text'
	}
	
	/**
	 * 获取消息内容
	 * 使用字符串类型而非数字,统一处理 REST API (1-6) / WebSocket (100-105) 两种格式
	 */
	function getMessageContent(messageType : number, content : any) : string {
		// 先转换为字符串类型
		const typeStr = getMessageTypeString(messageType)
		
		if (typeStr === 'text' || typeStr === 'quote' || typeStr === 'emoji') {
			// 文本消息
			return content.content || content
		} else if (typeStr === 'image') {
			return extractMediaUrl(content)
		} else if (typeStr === 'voice') {
			return ''
		} else if (typeStr === 'video') {
			return extractMediaUrl(content)
		} else if (typeStr === 'file') {
			return extractMediaUrl(content, true)
		} else if (typeStr === 'location') {
			// 位置消息
			return content.address || content
		} else if (typeStr === 'contact_card') {
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'sticker') {
			return extractStickerUrl(content)
		} else if (typeStr === 'custom') {
			// 合并转发等自定义消息：保留原始 JSON 字符串，供 getForwardCombineBody 解析
			// 避免多次 parse/stringify 导致格式异常或显示为 [自定义消息]
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			// 如果已经是字符串（原始 JSON），直接返回
			return content != null ? String(content) : ''
		}
		return content != null ? String(content) : ''
	}

	function extractMediaUrl(content : any, fallbackMixedContent : boolean = false) : string {
		if (content == null) {
			return ''
		}
		if (typeof content === 'string') {
			return fallbackMixedContent ? getFileUrlFromMixedContent(content) : content
		}
		if (typeof content === 'object') {
			if (content.url != null && String(content.url) !== '') {
				return String(content.url)
			}
			const nested = content.content
			if (typeof nested === 'string' && nested !== '') {
				return fallbackMixedContent ? getFileUrlFromMixedContent(nested) : nested
			}
			if (nested != null && typeof nested === 'object' && nested.url != null && String(nested.url) !== '') {
				return String(nested.url)
			}
		}
		return ''
	}
	
	/**
	 * 获取服务消息的内容
	 */
	function getServiceMessageContent(msg : ServiceMessageItem) : string {
		const typeStr = resolveUiMessageType(msg.type, msg.content, (msg as any).extra)
		// 安全地解析内容
		let content : any
		try {
			content = parseMessageContent(msg.content)
		} catch (e) {
			console.warn('[Chat] getServiceMessageContent 解析失败:', e)
			content = msg.content
		}

		if (typeStr === 'text' || typeStr === 'quote' || typeStr === 'emoji') {
			return content?.content != null ? String(content.content) : (content != null ? String(content) : '')
		} else if (typeStr === 'image') {
			return extractMediaUrl(content)
		} else if (typeStr === 'voice') {
			return ''
		} else if (typeStr === 'video') {
			return extractMediaUrl(content)
		} else if (typeStr === 'file') {
			return extractMediaUrl(content, true)
		} else if (typeStr === 'location') {
			return content?.address != null ? String(content.address) : (content != null ? String(content) : '')
		} else if (typeStr === 'contact_card') {
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'sticker') {
			return extractStickerUrl(content, (msg as any).extra)
		} else if (typeStr === 'custom') {
			// 合并转发等自定义消息：保留原始 JSON 字符串，供 getForwardCombineBody 解析
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			return content != null ? String(content) : ''
		}
		return content?.toString ? content.toString() : ''
	}

	function isMsgConfirmedSent(msg: any): boolean {
		try {
			const s = (msg as any)?.status
			// 兼容：
			// - ?UI ? 'success'
			// - 新状态枚举: 2=SENT, 3=DELIVERED, 4=READ
			return s === 'success' || s === 1 || s === '1' || s === 2 || s === '2' || s === 3 || s === '3' || s === 4 || s === '4'
		} catch (e) {
			return false
		}
	}

	function safeToString(content: any): string {
		if (content == null) {
			return ''
		}
		return content?.toString ? content.toString() : ''
	}

	function parseBooleanLike(value: any): boolean | null {
		if (value === true) {
			return true
		}
		if (value === false) {
			return false
		}
		if (value === 1 || value === '1') {
			return true
		}
		if (value === 0 || value === '0') {
			return false
		}
		if (value == null) {
			return null
		}
		const text = String(value).trim().toLowerCase()
		if (text === '') {
			return null
		}
		if (text === 'true' || text === 'yes' || text === 'y') {
			return true
		}
		if (text === 'false' || text === 'no' || text === 'n') {
			return false
		}
		return null
	}

	function resolveMessageIsSelf(rawIsSelf: any, senderId: any): boolean {
		const senderIdStr = senderId != null ? String(senderId).trim() : ''
		const selfIdStr = currentUserId.value != null ? String(currentUserId.value).trim() : ''
		if (senderIdStr !== '' && senderIdStr !== '0' && selfIdStr !== '' && selfIdStr !== '0') {
			return senderIdStr === selfIdStr
		}
		const parsed = parseBooleanLike(rawIsSelf)
		return parsed === true
	}

	function pickMergedIsSelfFlag(prev: any, next: any, senderId: any): boolean {
		const nextRaw = next != null ? (next as any).isSelf : null
		if (parseBooleanLike(nextRaw) != null) {
			return resolveMessageIsSelf(nextRaw, senderId)
		}
		const prevRaw = prev != null ? (prev as any).isSelf : null
		if (parseBooleanLike(prevRaw) != null) {
			return resolveMessageIsSelf(prevRaw, senderId)
		}
		return resolveMessageIsSelf(null, senderId)
	}

	function parseRawContent(content : any) : any {
		// 处理 null
		if (content === null) {
			return content
		}

		// 如果不是字符串，直接返回
		if (typeof content !== 'string') {
			return content
		}

		// 空字符串直接返回
		const trimmed = content.trim()
		if (trimmed.length === 0) {
			return content
		}

		// 检查是否可能是 JSON（以 { 或 [ 开头）
		const firstChar = trimmed.charAt(0)
		const lastChar = trimmed.charAt(trimmed.length - 1)
		const isObjectJson = firstChar === '{' && lastChar === '}'
		const isArrayJson = firstChar === '[' && lastChar === ']'
		const couldBeJson = isObjectJson || isArrayJson
		
		if (!couldBeJson) {
			// 肯定不是 JSON，直接返回原字符串
			return content
		}
		if (isArrayJson) {
			const inner = trimmed.substring(1, trimmed.length - 1).trim()
			if (inner.length > 0) {
				const c0 = inner.charAt(0)
				const couldBeRealJsonArray =
					c0 === '{' || c0 === '[' || c0 === '"' || c0 === '-' ||
					(c0 >= '0' && c0 <= '9') || c0 === 't' || c0 === 'f' || c0 === 'n'
				if (!couldBeRealJsonArray) {
					return content
				}
			}
		}

		// 尝试解析 JSON，使用安全的方式
		try {
			return JSON.parse(trimmed)
		} catch (e) {
			// 解析失败，返回原字符串
			return content
		}
	}

	function extractQuoteIdFromRaw(raw: any): string {
		try {
			if (raw == null) {
				return ''
			}
			if (typeof raw === 'string') {
				const s = raw
				let m = s.match(/"quotedMessageId"\s*:\s*"?([0-9]+)"?/)
				if (m != null && m.length > 1 && m[1] != null && m[1] !== '' && m[1] !== '0') {
					return m[1]
				}
				m = s.match(/"quoteMessageId"\s*:\s*"?([0-9]+)"?/)
				if (m != null && m.length > 1 && m[1] != null && m[1] !== '' && m[1] !== '0') {
					return m[1]
				}
				return ''
			}
			const qid1 = (raw as any).quotedMessageId
			if (qid1 != null && String(qid1) !== '' && String(qid1) !== '0') {
				return String(qid1)
			}
			const qid2 = (raw as any).quoteMessageId
			if (qid2 != null && String(qid2) !== '' && String(qid2) !== '0') {
				return String(qid2)
			}
			return ''
		} catch (e) {
			return ''
		}
	}

	function applyQuoteFields(target : MessageItem, rawContent : any, rawMessage : any = null, rawExtra : any = null) : void {
		try {
			const fromRawMessage = rawMessage != null ? rawMessage : null
			if (fromRawMessage != null) {
				if ((fromRawMessage as any).quoteMessageId != null && String((fromRawMessage as any).quoteMessageId) !== '' && String((fromRawMessage as any).quoteMessageId) !== '0') {
					target.quoteMessageId = String((fromRawMessage as any).quoteMessageId)
				}
				if ((fromRawMessage as any).quoteContent != null && String((fromRawMessage as any).quoteContent) !== '') {
					target.quoteContent = String((fromRawMessage as any).quoteContent)
				}
				if ((fromRawMessage as any).quoteSenderName != null && String((fromRawMessage as any).quoteSenderName) !== '') {
					target.quoteSenderName = String((fromRawMessage as any).quoteSenderName)
				}
			}
			const parsed = parseRawContent(rawContent)
			if (parsed && typeof parsed === 'object') {
				if (parsed.quotedMessageId != null) {
					if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
						target.quoteMessageId = parsed.quotedMessageId.toString()
					}
					if ((target.quoteContent == null || String(target.quoteContent) === '') && parsed.quotedContent != null) {
						target.quoteContent = parsed.quotedContent
					}
					if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && parsed.quotedSenderName != null) {
						target.quoteSenderName = parsed.quotedSenderName
					}
				} else if (parsed.quoteMessageId != null) {
					if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
						target.quoteMessageId = parsed.quoteMessageId.toString()
					}
					if ((target.quoteContent == null || String(target.quoteContent) === '') && parsed.quoteContent != null) {
						target.quoteContent = parsed.quoteContent
					}
					if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && parsed.quoteSenderName != null) {
						target.quoteSenderName = parsed.quoteSenderName
					}
				}
			}
			if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
				const idFromRawContent = extractQuoteIdFromRaw(rawContent)
				if (idFromRawContent !== '') {
					target.quoteMessageId = idFromRawContent
				}
			}
			const parsedExtra = parseRawContent(rawExtra)
			if (parsedExtra && typeof parsedExtra === 'object') {
				const extraQuoteId = (parsedExtra as any).quoteMessageId
				if ((target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0')
					&& extraQuoteId != null && String(extraQuoteId) !== '' && String(extraQuoteId) !== '0') {
					target.quoteMessageId = String(extraQuoteId)
				}
				const extraQuoteContent = (parsedExtra as any).quoteContent
				if ((target.quoteContent == null || String(target.quoteContent) === '') && extraQuoteContent != null && String(extraQuoteContent) !== '') {
					target.quoteContent = String(extraQuoteContent)
				}
				const extraQuoteSenderName = (parsedExtra as any).quoteSenderName
				if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && extraQuoteSenderName != null && String(extraQuoteSenderName) !== '') {
					target.quoteSenderName = String(extraQuoteSenderName)
				}
			}
			if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
				const idFromRawExtra = extractQuoteIdFromRaw(rawExtra)
				if (idFromRawExtra !== '') {
					target.quoteMessageId = idFromRawExtra
				}
			}
			if (target.quoteMessageId != null && String(target.quoteMessageId) !== '' && String(target.quoteMessageId) !== '0') {
				if (target.quoteContent == null || String(target.quoteContent).trim() === '') {
					target.quoteContent = '[消息]'
				}
				if (target.quoteSenderName == null || String(target.quoteSenderName).trim() === '') {
					target.quoteSenderName = '未知'
				}
			}
		} catch (e) {
			// 解析引用字段失败，忽略错误
			console.warn('[Chat] 解析引用字段失败:', e)
		}
	}

	function applyMediaFileId(target : MessageItem, rawExtraOrBody : any) : void {
		if (target.type === 'voice') {
			return
		}
		const id = tryExtractFileId(rawExtraOrBody)
		if (id) {
			;(target as any).fileId = id
		}
	}

	function maybePatchMediaDisplayUrl(target: any) : void {
		try {
			if (IM_MEDIA_USE_FILE_ID !== 'true') {
				return
			}
			if (!target || !target.type || !target.fileId) {
				return
			}
			if (target.type !== 'image' && target.type !== 'video') {
				return
			}
			resolvePresignedUrl(String(target.fileId)).then((signed) => {
				if (!signed) {
					return
				}
				if (target.type === 'image') {
					target.content = signed
				} else if (target.type === 'video') {
					target.poster = signed
				}
			}).catch((e) => {
				console.error('[Chat] 获取预签名URL失败:', e)
			})
		} catch (e) {
			// ignore
		}
	}

	function hasQuote(msg : MessageItem) : boolean {
		try {
			const qid = msg != null ? (msg as any).quoteMessageId : null
			return qid != null && String(qid) !== '' && String(qid) !== '0'
		} catch (e) {
			return false
		}
	}

	function isRecallTip(content : string) : boolean {
		return content.indexOf('撤回') > -1 && content.indexOf('消息') > -1
	}

	function isRecalledFinalMsg(m: any): boolean {
		try {
			const s = m != null ? (m as any).status : null
			return s === 6 || s === '6'
		} catch (e) {
			return false
		}
	}

	function getMessagePreview(msg : MessageItem) : string {
		if (msg.type === 'text' || msg.type === 'quote') {
			const text = msg.content || ''
			return isRecallTip(text) ? '[消息已撤回]' : text
		}
		if (msg.type === 'image') return '[图片]'
		if (msg.type === 'emoji') return '[表情]'
		if (msg.type === 'sticker') return '[动画表情]'
		if (msg.type === 'voice') return '[语音]'
		if (msg.type === 'video') return '[视频]'
		if (msg.type === 'file') {
			return msg.fileName ? `[文件] ${msg.fileName}` : '[文件]'
		}
		if (msg.type === 'location') return '[位置]'
		if (msg.type === 'contact_card') return '[名片]'
		return '[消息]'
	}

	function buildQuoteChain(msg : MessageItem) : QuoteChainItem[] {
		if (!hasQuote(msg)) {
			return []
		}

		const chain : QuoteChainItem[] = []
		let currentId = msg.quoteMessageId as string
		let currentSender = msg.quoteSenderName || ''
		let currentContent = msg.quoteContent || ''
		let depth = 0
		const maxDepth = 5

		while (currentId && depth < maxDepth) {
			const referenced = messages.value.find(m => m.messageId === currentId)
			if (referenced != null) {
				chain.push({
					messageId: currentId,
					senderName: referenced.senderName || currentSender || '未知',
					content: getMessagePreview(referenced),
					missing: false
				})

				if (referenced.quoteMessageId == null || String(referenced.quoteMessageId) === '' || String(referenced.quoteMessageId) === '0') {
					break
				}

				currentId = referenced.quoteMessageId
				currentSender = referenced.quoteSenderName || ''
				currentContent = referenced.quoteContent || ''
			} else {
				chain.push({
					messageId: currentId,
					senderName: currentSender || '未知',
					content: currentContent || '原消息已删除',
					missing: true
				})
				break
			}
			depth++
		}

		return chain
	}
	
	/**
	 * 合并消息（去重）
	 */
	function mergeMessages(oldMessages : MessageItem[], newMessages : MessageItem[]) : MessageItem[] {
		const messageMap = new Map<string, MessageItem>()
		const pickNonEmpty = (a: any, b: any): any => {
			// prefer b if b is meaningful, else keep a
			if (b === null) return a
			if (typeof b === 'string') {
				if (b === '' || b === '0' || b === 'null') return a
			}
			return b
		}
		const isRecalledFinal = (m: any): boolean => {
			try {
				const s = m != null ? (m as any).status : null
				return s === 6 || s === '6'
			} catch (e) {
				return false
			}
		}
		const getRev = (m: any): string => {
			try {
				const r = m != null ? (m as any).rev : null
				return r != null && r !== '' ? r.toString() : '0'
			} catch (e) {
				return '0'
			}
		}
		const cmpRev = (a: string, b: string): number => {
			try {
				const diff = BigInt(a) - BigInt(b)
				if (diff === BigInt(0)) return 0
				return diff > BigInt(0) ? 1 : -1
			} catch (e) {
				if (a === b) return 0
				return a > b ? 1 : -1
			}
		}
		const mergeOne = (prev: any, next: any): any => {
			if (!prev) return next
			if (!next) return prev
			// enterprise: prefer higher rev as final state base
			const prevRev = getRev(prev)
			const nextRev = getRev(next)
			if (cmpRev(nextRev, prevRev) > 0) {
				const tmp = prev
				prev = next
				next = tmp
			}
			const prevRecalled = isRecalledFinal(prev)
			const nextRecalled = isRecalledFinal(next)
			// 最终态优先：撤回提示一旦成立，不允许被旧原文覆盖
			if (prevRecalled || nextRecalled) {
				const finalMsg: any = nextRecalled ? { ...prev, ...next } : { ...next, ...prev }
				finalMsg.sequence = pickNonEmpty(prev.sequence, next.sequence)
				finalMsg.groupId = pickNonEmpty(prev.groupId, next.groupId)
				finalMsg.chatId = pickNonEmpty(prev.chatId, next.chatId)
				finalMsg.rev = pickNonEmpty(prev.rev, next.rev)
				finalMsg.status = 6
				// type/content 保持撤回提示（以 recalled 那一方为准）
				if (nextRecalled) {
					finalMsg.type = pickNonEmpty(prev.type, next.type)
					finalMsg.content = pickNonEmpty(prev.content, next.content)
				} else {
					finalMsg.type = pickNonEmpty(next.type, prev.type)
					finalMsg.content = pickNonEmpty(next.content, prev.content)
				}
				finalMsg.timestamp = pickNonEmpty(prev.timestamp, next.timestamp)
				finalMsg.time = pickNonEmpty(prev.time, next.time)
				finalMsg.senderId = pickNonEmpty(prev.senderId, next.senderId)
				finalMsg.receiverId = pickNonEmpty(prev.receiverId, next.receiverId)
				finalMsg.isSelf = pickMergedIsSelfFlag(prev, next, finalMsg.senderId)
				finalMsg.reeditContent = pickNonEmpty(prev.reeditContent, next.reeditContent)
				finalMsg.reeditDeadlineTs = pickNonEmpty(prev.reeditDeadlineTs, next.reeditDeadlineTs)
				return finalMsg
			}
			const merged: any = { ...prev, ...next }
			// 补齐关键字段：HTTP 刷新回来的消息应当补齐缓存缺失的水位字段
			merged.sequence = pickNonEmpty(prev.sequence, next.sequence)
			merged.groupId = pickNonEmpty(prev.groupId, next.groupId)
			merged.chatId = pickNonEmpty(prev.chatId, next.chatId)
			merged.status = pickNonEmpty(prev.status, next.status)
			merged.senderId = pickNonEmpty(prev.senderId, next.senderId)
			merged.receiverId = pickNonEmpty(prev.receiverId, next.receiverId)
			merged.isSelf = pickMergedIsSelfFlag(prev, next, merged.senderId)
			merged.reeditContent = pickNonEmpty(prev.reeditContent, next.reeditContent)
			merged.reeditDeadlineTs = pickNonEmpty(prev.reeditDeadlineTs, next.reeditDeadlineTs)
			return merged
		}
		
		// 先添加旧消息
		oldMessages.forEach(msg => {
			const key = msg && (msg as any).messageId ? String((msg as any).messageId) : (msg && (msg as any).id ? String((msg as any).id) : '')
			if (!key) {
				return
			}
			const prev: any = messageMap.get(key)
			messageMap.set(key, mergeOne(prev, msg))
		})
		
		// 再添加新消息（补齐字段 + 覆盖重复的）
		newMessages.forEach(msg => {
			const key = msg && (msg as any).messageId ? String((msg as any).messageId) : (msg && (msg as any).id ? String((msg as any).id) : '')
			if (!key) {
				return
			}
			const prev: any = messageMap.get(key)
			messageMap.set(key, mergeOne(prev, msg))
		})
		
		// 转换为数组并按时间排序
		const result : MessageItem[] = []
		messageMap.forEach(msg => {
			result.push(msg)
		})
		
		result.sort((a, b) => a.timestamp - b.timestamp)
		
		return result
	}
	
	/**
	 * 处理新消息
	 */
	function handleNewMessage(message : ServiceMessageItem) {
		const incomingIsSelf = resolveMessageIsSelf((message as any).isSelf, (message as any).senderId)
		// 只处理当前会话的消息（优先按 chatId 精确匹配，兼容旧链路按 target 匹配）
		const incomingChatId = (message as any).chatId != null ? String((message as any).chatId) : ''
		const pageChatId = chatId.value != null ? String(chatId.value) : ''
		let inCurrentConversation = false
		if (incomingChatId !== '' && incomingChatId !== '0' && pageChatId !== '' && pageChatId !== '0') {
			inCurrentConversation = incomingChatId === pageChatId
		} else {
			const msgTargetId = (message.groupId !== '0' && message.groupId !== '')
				? message.groupId
				: (incomingIsSelf ? message.receiverId : message.senderId)
			const currentTargetId = chatType.value === 'group'
				? targetId.value
				: getReceiverIdForMessage()
			inCurrentConversation = msgTargetId === currentTargetId
		}
		
		if (!inCurrentConversation) {
			return
		}

		// 去重：sendMessage() 会先 notifyMessageListeners，本地发送路径也可能手动 push，导致重复展示
		// 但撤回属于“最终态变更”，必须覆盖已有消息（不能被去重丢弃）
		const existingIndex = message.messageId
			? messages.value.findIndex((m: any) => m && m.messageId === message.messageId)
			: -1
		let incomingIsRecalled = false
		try {
			const s: any = (message as any).status
			incomingIsRecalled = s === 6 || s === '6'
		} catch (e) {
			incomingIsRecalled = false
		}
		if (existingIndex > -1 && !incomingIsRecalled) {
			try {
				const prev: any = messages.value[existingIndex]
				const prevRev = prev && (prev as any).rev != null ? String((prev as any).rev) : '0'
				const nextRev = (message as any).rev != null ? String((message as any).rev) : '0'
				let newer = false
				try {
					newer = BigInt(nextRev) > BigInt(prevRev)
				} catch (e) {
					newer = nextRev > prevRev
				}
				if (!newer) {
					return
				}
			} catch (e) {
				return
			}
		}
		
		// 转换消息格式
		const uiMessage : MessageItem = {
			id: message.id.toString(),
			messageId: message.messageId,
			rev: (message as any).rev != null ? String((message as any).rev) : '1',
			senderId: message.senderId.toString(),
			receiverId: message.receiverId.toString(),
			type: resolveUiMessageType(message.type, message.content, (message as any).extra),
			content: getServiceMessageContent(message),
			sequence: (message as any).sequence != null ? String((message as any).sequence) : null,
			groupId: (message as any).groupId != null ? String((message as any).groupId) : null,
			isSelf: incomingIsSelf,
			time: new Date(message.timestamp).toLocaleString(),
			timestamp: message.timestamp,
			showTime: true,
			avatarText: message.avatarText,
			avatarBg: message.avatarBg,
			senderName: message.senderName,
			status: message.status,
			voicePlayed: (message as any).voicePlayed === true
				|| (message as any).voicePlayed === 1
				|| (message as any).voicePlayed === '1'
				|| (message as any).voicePlayed === 'true'
		} as MessageItem
		try {
			const ex: any = message as any
			if (ex != null) {
				if (ex.reeditContent != null && String(ex.reeditContent) !== '' && !isRecallTip(String(ex.reeditContent))) {
					;(uiMessage as any).reeditContent = String(ex.reeditContent)
				}
				if (ex.reeditDeadlineTs != null && String(ex.reeditDeadlineTs) !== '') {
					;(uiMessage as any).reeditDeadlineTs = String(ex.reeditDeadlineTs)
				}
			}
			if ((((uiMessage as any).reeditContent == null || String((uiMessage as any).reeditContent) === '')
				&& (uiMessage as any).isSelf === true)) {
				const reeditChatId = (uiMessage as any).chatId != null && String((uiMessage as any).chatId) !== ''
					? String((uiMessage as any).chatId)
					: chatId.value
				const hint = messageService.getReeditHintByCandidates(reeditChatId, [uiMessage.messageId, uiMessage.id])
				if (hint != null && hint.content != null && hint.content !== '' && !isRecallTip(String(hint.content))) {
					;(uiMessage as any).reeditContent = String(hint.content)
					if (hint.deadlineTs != null && hint.deadlineTs !== '') {
						;(uiMessage as any).reeditDeadlineTs = String(hint.deadlineTs)
					}
				}
			}
		} catch (e) {
		}

		applyQuoteFields(uiMessage, message.content, message, (message as any).extra)
		applyVoiceFields(uiMessage, message.content, (message as any).extra)
		applyFileFields(uiMessage, message.content)
		applyLocationFields(uiMessage, message.content)
		applyContactCardFields(uiMessage, message.content, (message as any).extra)
		applyStickerFields(uiMessage, message.content, (message as any).extra)
		applyMediaFileId(uiMessage, message.content)
		maybePatchMediaDisplayUrl(uiMessage as any)
		
		// 最终态覆盖：撤回到达时，替换掉列表中的原消息
		if (existingIndex > -1 && incomingIsRecalled) {
			const prev: any = messages.value[existingIndex]
			const next: any = uiMessage
			const merged: any = { ...prev, ...next }
			merged.status = 6
			// 撤回提示优先：type/content 以撤回提示为准
			merged.type = next.type
			merged.content = next.content
			merged.timestamp = prev.timestamp != null ? prev.timestamp : next.timestamp
			merged.time = prev.time != null ? prev.time : next.time
			merged.sequence = prev.sequence != null && prev.sequence !== '' ? prev.sequence : next.sequence
			merged.groupId = prev.groupId != null && prev.groupId !== '' ? prev.groupId : next.groupId
			merged.chatId = prev.chatId != null && prev.chatId !== '' ? prev.chatId : next.chatId
			merged.reeditContent = (next as any).reeditContent != null && String((next as any).reeditContent) !== ''
				? (next as any).reeditContent
				: (prev as any).reeditContent
			merged.reeditDeadlineTs = (next as any).reeditDeadlineTs != null && String((next as any).reeditDeadlineTs) !== ''
				? (next as any).reeditDeadlineTs
				: (prev as any).reeditDeadlineTs
			messages.value[existingIndex] = merged
		} else if (existingIndex > -1) {
			const prev: any = messages.value[existingIndex]
			const next: any = uiMessage
			const merged: any = { ...prev, ...next }
			merged.sequence = prev.sequence != null && prev.sequence !== '' ? prev.sequence : next.sequence
			merged.groupId = prev.groupId != null && prev.groupId !== '' ? prev.groupId : next.groupId
			merged.chatId = prev.chatId != null && prev.chatId !== '' ? prev.chatId : next.chatId
			merged.rev = next.rev != null && next.rev !== '' ? next.rev : prev.rev
			messages.value[existingIndex] = merged
		} else {
			messages.value.push(uiMessage)
		}
		
		// 滚动到底部
		scrollToBottom()
		
		// 发送已读回执（如果不是自己发送的）
		if (!incomingIsSelf) {
			// 群聊已读以服务端 readSequence 水位为准，禁用逐条回执，避免回执风暴
			if (chatType.value !== 'group') {
				messageService.sendReadReceipt(message.senderId, [message.messageId])
			}
		}
	}

	function getVoicePlayedStorageKey(messageId: string): string {
		const tenant = currentTenantId.value != null ? currentTenantId.value : '0'
		const user = currentUserId.value != null ? currentUserId.value : '0'
		const chat = chatId.value != null && chatId.value !== '' ? chatId.value : '0'
		return `IM_VOICE_PLAYED_${tenant}_${user}_${chat}_${messageId}`
	}

	function hasVoiceBeenPlayed(messageId: string): boolean {
		if (messageId == null || messageId === '' || messageId === '0') {
			return false
		}
		return getString(getVoicePlayedStorageKey(messageId), '') === '1'
	}

	function isVoicePlayedFlag(value: any): boolean {
		return value === true || value === 1 || value === '1' || value === 'true'
	}

	function markVoicePlayed(messageId: string): void {
		if (messageId == null || messageId === '' || messageId === '0') {
			return
		}
		setString(getVoicePlayedStorageKey(messageId), '1')
	}
	/*

				console.warn('[Chat] 同步语音已播放状态失败:', e)

	*/
	function syncVoicePlayedToServer(messageId: string): void {
		if (messageId == null || messageId === '' || messageId === '0') {
			return
		}
		if (!voicePlayedPendingSync.has(messageId)) {
			voicePlayedPendingSync.set(messageId, true)
		}
		scheduleVoicePlayedSyncFlush()
	}

	function hasPendingVoicePlayedSync(): boolean {
		let hasPending = false
		voicePlayedPendingSync.forEach(() => {
			hasPending = true
		})
		return hasPending
	}

	function takeVoicePlayedSyncBatch(maxSize: number): string[] {
		const keys: string[] = []
		voicePlayedPendingSync.forEach((_value, key) => {
			if (keys.length < maxSize) {
				keys.push(key)
			}
		})
		for (let i = 0; i < keys.length; i++) {
			voicePlayedPendingSync.delete(keys[i])
		}
		return keys
	}

	function scheduleVoicePlayedSyncFlush(): void {
		if (voicePlayedSyncTimer != null) {
			return
		}
		voicePlayedSyncTimer = setTimeout(() => {
			voicePlayedSyncTimer = null
			void flushVoicePlayedSyncQueue(false)
		}, VOICE_PLAY_SYNC_DEBOUNCE_MS)
	}

	async function flushVoicePlayedSyncQueue(force: boolean = false): Promise<void> {
		if (force && voicePlayedSyncTimer != null) {
			clearTimeout(voicePlayedSyncTimer)
			voicePlayedSyncTimer = null
		}
		if (voicePlayedSyncInFlight) {
			if (!force && hasPendingVoicePlayedSync()) {
				scheduleVoicePlayedSyncFlush()
			}
			return
		}
		if (!hasPendingVoicePlayedSync()) {
			return
		}
		voicePlayedSyncInFlight = true
		try {
			while (hasPendingVoicePlayedSync()) {
				const batchIds = takeVoicePlayedSyncBatch(VOICE_PLAY_SYNC_BATCH_SIZE)
				if (batchIds.length === 0) {
					break
				}
				try {
					if (batchIds.length === 1) {
						await markVoicePlayedApi(batchIds[0])
					} else {
						await markVoicePlayedBatch(batchIds)
					}
				} catch (e) {
					for (let i = 0; i < batchIds.length; i++) {
						const id = batchIds[i]
						if (!voicePlayedPendingSync.has(id)) {
							voicePlayedPendingSync.set(id, true)
						}
					}
					console.warn('[Chat] sync voice played failed:', e)
					break
				}
			}
		} finally {
			voicePlayedSyncInFlight = false
		}
		if (!force && hasPendingVoicePlayedSync()) {
			scheduleVoicePlayedSyncFlush()
		}
	}

	function collectUnplayedVoiceMessageIds(limit: number): string[] {
		const result: string[] = []
		const idSet = new Map<string, boolean>()
		for (let i = messages.value.length - 1; i >= 0; i--) {
			const item: any = messages.value[i]
			if (item == null || resolveMessageIsSelf((item as any).isSelf, (item as any).senderId)) {
				continue
			}
			const messageType = item.type != null ? String(item.type) : ''
			if (messageType !== 'voice') {
				continue
			}
			const mid = resolveVoiceMessageId(item)
			if (mid === '' || mid === '0') {
				continue
			}
			if (isVoicePlayedFlag(item.voicePlayed) || hasVoiceBeenPlayed(mid) || idSet.has(mid)) {
				continue
			}
			idSet.set(mid, true)
			result.push(mid)
			if (result.length >= limit) {
				break
			}
		}
		return result
	}

	function startVoicePlayedCompensation(): void {
		if (voicePlayedCompensateTimer != null) {
			return
		}
		void pullVoicePlayedCompensationOnce()
		voicePlayedCompensateTimer = setInterval(() => {
			void pullVoicePlayedCompensationOnce()
		}, VOICE_PLAY_COMPENSATE_INTERVAL_MS)
	}

	function stopVoicePlayedCompensation(): void {
		if (voicePlayedCompensateTimer != null) {
			clearInterval(voicePlayedCompensateTimer)
			voicePlayedCompensateTimer = null
		}
	}

	function normalizePlayedIdsPayload(payload: any): string[] {
		const result: string[] = []
		const idSet = new Map<string, boolean>()
		const append = (raw: any): void => {
			const id = raw != null ? String(raw) : ''
			if (id === '' || id === '0' || idSet.has(id)) {
				return
			}
			idSet.set(id, true)
			result.push(id)
		}
		if (Array.isArray(payload)) {
			for (let i = 0; i < payload.length; i++) {
				append(payload[i])
			}
			return result
		}
		if (payload != null && Array.isArray((payload as any).data)) {
			const list: any[] = (payload as any).data as any[]
			for (let i = 0; i < list.length; i++) {
				append(list[i])
			}
		}
		return result
	}

	async function pullVoicePlayedCompensationOnce(): Promise<void> {
		const currentChatId = chatId.value != null ? String(chatId.value) : ''
		if (currentChatId === '' || currentChatId === '0' || voicePlayedCompensateInFlight) {
			return
		}
		const pendingVoiceIds = collectUnplayedVoiceMessageIds(VOICE_PLAY_COMPENSATE_MAX_IDS)
		if (pendingVoiceIds.length === 0) {
			return
		}
		voicePlayedCompensateInFlight = true
		try {
			let offset = 0
			while (offset < pendingVoiceIds.length) {
				const batch = pendingVoiceIds.slice(offset, offset + VOICE_PLAY_COMPENSATE_BATCH_SIZE)
				offset += VOICE_PLAY_COMPENSATE_BATCH_SIZE
				if (batch.length === 0) {
					continue
				}
				try {
					const resp = await getVoicePlayedStatus(currentChatId, batch)
					const playedIds = normalizePlayedIdsPayload(resp)
					for (let i = 0; i < playedIds.length; i++) {
						const playedId = playedIds[i]
						markVoicePlayed(playedId)
						voicePlayedPendingSync.delete(playedId)
						patchMessageInList(playedId, { voicePlayed: true })
					}
				} catch (e) {
					console.warn('[Chat] compensate voice played failed:', e)
					break
				}
			}
		} finally {
			voicePlayedCompensateInFlight = false
		}
	}

	function markVoicePlayedOnClick(msg: any): void {
		if (msg == null || resolveMessageIsSelf((msg as any).isSelf, (msg as any).senderId)) {
			return
		}
		const messageId = resolveVoiceMessageId(msg)
		if (messageId === '') {
			return
		}
		if (isVoicePlayedFlag((msg as any).voicePlayed) || hasVoiceBeenPlayed(messageId)) {
			return
		}
		;(msg as any).voicePlayed = true
		markVoicePlayed(messageId)
		patchMessageInList(messageId, { voicePlayed: true })
		syncVoicePlayedToServer(messageId)
	}

	function handleVoicePlayedSync(incomingChatId: string, messageId: string): void {
		if (messageId == null || messageId === '' || messageId === '0') {
			return
		}
		const currentChatId = chatId.value != null ? String(chatId.value) : ''
		const incoming = incomingChatId != null ? String(incomingChatId) : ''
		if (incoming !== '' && incoming !== '0' && currentChatId !== '' && currentChatId !== '0' && incoming !== currentChatId) {
			return
		}
		voicePlayedPendingSync.delete(messageId)
		markVoicePlayed(messageId)
		patchMessageInList(messageId, { voicePlayed: true })
	}

	function handleMessageStatusChange(messageId: string, status: any, meta ?: any) {
		try {
			if (!messageId) return
			const previousMessageId = meta != null && meta.previousMessageId != null ? String(meta.previousMessageId) : ''
			const resolvedMessageId = meta != null && meta.resolvedMessageId != null ? String(meta.resolvedMessageId) : messageId
			const idx = messages.value.findIndex((m: any) => {
				if (m == null || m.messageId == null) {
					return false
				}
				const currentId = String(m.messageId)
				return currentId === messageId || (previousMessageId !== '' && currentId === previousMessageId) || (resolvedMessageId !== '' && currentId === resolvedMessageId)
			})
			if (idx < 0) return
			const uiMsg: any = messages.value[idx]
			const nextMsg: any = { ...uiMsg }

			// MessageService.MessageStatus: SENDING=0 SENT=1 READ=2 FAILED=3
			if (status === 1 || status === '1') {
				nextMsg.status = 'success'
				nextMsg.messageId = resolvedMessageId
				if (nextMsg.id == null || String(nextMsg.id) === '' || String(nextMsg.id) === '0' || String(nextMsg.id) === previousMessageId) {
					nextMsg.id = resolvedMessageId
				}
				if (meta != null && meta.rev != null && String(meta.rev) !== '') {
					nextMsg.rev = String(meta.rev)
				}
				if (meta != null && meta.sequence != null && String(meta.sequence) !== '') {
					nextMsg.sequence = String(meta.sequence)
				}
				// 补齐 sequence（服务端确认后才会有）
				try {
					const candidateChatIds: string[] = []
					if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
						candidateChatIds.push(chatId.value)
					}
					if (chatType.value === 'group' && targetId.value && targetId.value !== '' && targetId.value !== '0') {
						candidateChatIds.push(targetId.value)
					}
					const activeChatId = messageService.getActiveChatId()
					if (activeChatId && activeChatId !== '' && activeChatId !== '0') {
						candidateChatIds.push(activeChatId)
					}
					let hit: any = null
					for (let i = 0; i < candidateChatIds.length; i++) {
						const cached = messageService.getMessages(candidateChatIds[i]) as any[]
						hit = cached && cached.length > 0
							? cached.find((m: any) => m && (m.messageId === resolvedMessageId || (previousMessageId !== '' && m.messageId === previousMessageId)))
							: null
						if (hit != null) {
							break
						}
					}
					if (hit && hit.sequence != null && hit.sequence !== '') {
						nextMsg.sequence = String(hit.sequence)
					}
				} catch (e) {
					// ignore
				}
				messages.value.splice(idx, 1, nextMsg as MessageItem)
				// 群聊自发消息确认后，在数据层触发已读回执 summary 拉取（不在模板渲染中发网络请求）
				try {
					if (chatType.value === 'group' && nextMsg.isSelf === true) {
						ensureReadReceiptSummaryFetched(resolvedMessageId)
					}
				} catch (e) {
					// ignore
				}
				return
			}

			if (status === 0 || status === '0') {
				nextMsg.status = 'sending'
				messages.value.splice(idx, 1, nextMsg as MessageItem)
				return
			}
			if (status === 3 || status === '3' || status === 5 || status === '5') {
				nextMsg.status = 'failed'
				messages.value.splice(idx, 1, nextMsg as MessageItem)
				return
			}
		} catch (e) {
			// ignore
		}
	}


	const featureList = [
		{ icon: '\ue608', color: '#3370FF', nameKey: 'chat.features.album' },
		{ icon: '\uea87', color: '#3370FF', nameKey: 'chat.features.camera' },
		{ icon: '\uea72', color: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', color: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\ue624', color: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', color: '#FFB347', nameKey: 'chat.features.fav' }
	]

	function handleBack() {
		try {
			if (fromMergeDetail.value) {
				const delta = mergeBackDelta.value > 1 ? mergeBackDelta.value : 1
				uni.navigateBack({
					delta: delta,
					fail: () => {
						uni.switchTab({ url: '/pages/message/message' })
					}
				})
				return
			}
		} catch (e) {
		}
		uni.navigateBack({
			fail: () => {
				uni.switchTab({ url: '/pages/message/message' })
			}
		})
	}

	function toggleInputMode() {
		if (!ensureConversationWritable()) {
			return
		}
		if (isVoiceMode.value) {
			isVoiceMode.value = false
			return
		}
		const manager = ensureRecorderManagerReady(true)
		if (manager == null) {
			uni.showToast({ title: '当前平台暂不支持语音发送', icon: 'none' })
			return
		}
		isVoiceMode.value = true
		showEmojiMenu.value = false
		showPlusMenu.value = false
	}

	function toggleEmojiMenu() {
		if (!ensureConversationWritable()) {
			return
		}
		const nextVisible = !showEmojiMenu.value
		showEmojiMenu.value = nextVisible
		showPlusMenu.value = false
		isVoiceMode.value = false
	}

	function togglePlusMenu() {
		if (!ensureConversationWritable()) {
			return
		}
		showPlusMenu.value = !showPlusMenu.value
		showEmojiMenu.value = false
		isVoiceMode.value = false
	}

	function toggleFullExpand() {
		isFullExpanded.value = !isFullExpanded.value
		if (isFullExpanded.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function onEditorReady() {
		uni.createSelectorQuery().select('#editor').context((res) => {
			editorCtx = res.context as EditorContext
			if (editorCtx != null && composerText.value !== '') {
				applyContentToEditor(composerText.value)
			}
		}).exec()
	}

	function updatePlainSelection(start: number, end: number): void {
		const text = plainInputText.value != null ? plainInputText.value : ''
		let nextStart = start
		let nextEnd = end
		if (nextStart < 0) {
			nextStart = text.length
		}
		if (nextEnd < 0) {
			nextEnd = text.length
		}
		if (nextStart > text.length) {
			nextStart = text.length
		}
		if (nextEnd > text.length) {
			nextEnd = text.length
		}
		if (nextStart > nextEnd) {
			const temp = nextStart
			nextStart = nextEnd
			nextEnd = temp
		}
		plainSelectionStart.value = nextStart
		plainSelectionEnd.value = nextEnd
	}

	function rebuildRecentEmojiList(codes: string[]): void {
		const nextList: any[] = []
		for (let i = 0; i < codes.length; i++) {
			const code = codes[i]
			const path = emojiMap.get(code)
			if (path != null) {
				nextList.push({
					code,
					path
				})
			}
		}
		recentEmojiList.value = nextList
	}

	function loadRecentEmojiList(): void {
		try {
			const raw = getString(EMOJI_RECENT_STORAGE_KEY, '')
			if (raw === '') {
				recentEmojiList.value = []
				return
			}
			let stored: string[] = []
			try {
				const parsed = JSON.parse(raw)
				if (parsed != null && Array.isArray(parsed)) {
					stored = parsed as string[]
				} else {
					remove(EMOJI_RECENT_STORAGE_KEY)
				}
			} catch (e) {
				remove(EMOJI_RECENT_STORAGE_KEY)
				recentEmojiList.value = []
				return
			}
			const codes: string[] = []
			for (let i = 0; i < stored.length; i++) {
				const code = stored[i] != null ? String(stored[i]) : ''
				if (code !== '' && emojiMap.get(code) != null && codes.indexOf(code) === -1) {
					codes.push(code)
				}
				if (codes.length >= EMOJI_RECENT_LIMIT) {
					break
				}
			}
			rebuildRecentEmojiList(codes)
		} catch (e) {
			recentEmojiList.value = []
		}
	}

	function recordRecentEmoji(code: string): void {
		if (code === '') {
			return
		}
		const codes: string[] = []
		codes.push(code)
		for (let i = 0; i < recentEmojiList.value.length; i++) {
			const item = recentEmojiList.value[i]
			const itemCode = item != null && item.code != null ? String(item.code) : ''
			if (itemCode !== '' && itemCode !== code && codes.indexOf(itemCode) === -1) {
				codes.push(itemCode)
			}
			if (codes.length >= EMOJI_RECENT_LIMIT) {
				break
			}
		}
		rebuildRecentEmojiList(codes)
		try {
			setJsonObject<string[]>(EMOJI_RECENT_STORAGE_KEY, codes)
		} catch (e) {
		}
	}

	function markComposerHasRichContent(): void {
		const text = composerText.value != null ? composerText.value : ''
		updateComposerLineCount(estimateComposerLineCount(text, true))
		inputText.value = 'has_content'
	}

	function getComposerHeightByLineCount(lineCount: number): number {
		let normalized = lineCount
		if (normalized < 1) {
			normalized = 1
		}
		if (normalized > COMPOSER_MAX_LINES) {
			normalized = COMPOSER_MAX_LINES
		}
		const nextHeight = COMPOSER_VERTICAL_PADDING + normalized * COMPOSER_LINE_HEIGHT
		if (nextHeight < COMPOSER_MIN_HEIGHT) {
			return COMPOSER_MIN_HEIGHT
		}
		if (nextHeight > COMPOSER_MAX_HEIGHT) {
			return COMPOSER_MAX_HEIGHT
		}
		return nextHeight
	}

	function measureComposerTextUnits(text: string): number {
		let units = 0
		for (let i = 0; i < text.length; i++) {
			const charCode = text.charCodeAt(i)
			if (charCode <= 0x007f) {
				units += 0.55
				continue
			}
			if (charCode >= 0xd800 && charCode <= 0xdbff && i + 1 < text.length) {
				units += 1
				i += 1
				continue
			}
			units += 1
		}
		return units
	}

	function estimateComposerLineCount(text: string, hasRichContent: boolean = false): number {
		const normalizedText = text != null ? String(text).replace(/\r\n/g, '\n') : ''
		if (normalizedText === '') {
			return hasRichContent ? 1 : 1
		}
		const segments = normalizedText.split('\n')
		let lineCount = 0
		for (let i = 0; i < segments.length; i++) {
			const segment = segments[i] != null ? segments[i] : ''
			const units = measureComposerTextUnits(segment)
			const wrappedLines = units <= 0 ? 1 : Math.ceil(units / COMPOSER_WRAP_UNITS_PER_LINE)
			lineCount += wrappedLines
		}
		if (hasRichContent && lineCount < 1) {
			lineCount = 1
		}
		if (lineCount < 1) {
			lineCount = 1
		}
		return lineCount
	}

	function updateComposerLineCount(lineCount: number): void {
		let nextLineCount = lineCount
		if (nextLineCount < 1) {
			nextLineCount = 1
		}
		composerLineCount.value = nextLineCount
		isMultiLine.value = nextLineCount > 1
	}

	function findFirstDiffIndex(oldText: string, newText: string): number {
		const minLength = Math.min(oldText.length, newText.length)
		for (let i = 0; i < minLength; i++) {
			if (oldText.charAt(i) !== newText.charAt(i)) {
				return i
			}
		}
		return minLength
	}

	function findEmojiTokenRangeAt(text: string, index: number): PlainComposerMutation | null {
		const regex = /\[[\u4e00-\u9fa5\w]+\]/g
		let match: RegExpExecArray | null
		while ((match = regex.exec(text)) !== null) {
			const token = match[0]
			const start = match.index
			const end = start + token.length
			if (index >= start && index < end && emojiMap.get(token) != null) {
				return {
					text: text.substring(0, start) + text.substring(end),
					cursor: start
				}
			}
		}
		return null
	}

	function normalizePlainComposerMutation(nextText: string, cursor: number): PlainComposerMutation {
		const oldText = lastInputText.value != null ? lastInputText.value : ''
		if (oldText.length - nextText.length !== 1) {
			return {
				text: nextText,
				cursor: cursor >= 0 ? cursor : nextText.length
			}
		}
		const diffIndex = findFirstDiffIndex(oldText, nextText)
		const collapsedMutation = findEmojiTokenRangeAt(oldText, diffIndex)
		if (collapsedMutation != null) {
			return collapsedMutation
		}
		return {
			text: nextText,
			cursor: cursor >= 0 ? cursor : nextText.length
		}
	}

	function insertTextIntoPlainComposer(insertText: string): void {
		if (insertText === '') {
			return
		}
		const currentText = plainInputText.value != null ? plainInputText.value : ''
		let start = plainSelectionStart.value
		let end = plainSelectionEnd.value
		if (start < 0 || end < 0) {
			start = currentText.length
			end = currentText.length
		}
		if (start > end) {
			const temp = start
			start = end
			end = temp
		}
		if (start > currentText.length) {
			start = currentText.length
		}
		if (end > currentText.length) {
			end = currentText.length
		}
		const nextText = currentText.substring(0, start) + insertText + currentText.substring(end)
		const nextCursor = start + insertText.length
		plainInputText.value = nextText
		updatePlainSelection(nextCursor, nextCursor)
		applyComposerState(nextText)
	}

	function ensurePlainTextComposer(): void {
		const currentText = composerText.value != null ? composerText.value : ''
		if (!usePlainTextComposer.value) {
			usePlainTextComposer.value = true
		}
		plainInputText.value = currentText
		updatePlainSelection(currentText.length, currentText.length)
		applyComposerState(currentText)
	}

	function normalizeEditorHtmlToContent(html: string): string {
		if (!html || html === '<p><br></p>') {
			return ''
		}
		const imgReg = /<img [^>]*alt=['"]([^'"]+)['"][^>]*>/g
		let finalContent = html.replace(imgReg, '$1')
		finalContent = finalContent.replace(/<br\s*\/?>/g, '\n')
		finalContent = finalContent.replace(/<\/p>\s*<p>/g, '\n')
		finalContent = finalContent.replace(/<[^>]+>/g, '')
		finalContent = finalContent.replace(/&nbsp;/g, ' ')
		return finalContent
	}

	function insertEditorSegments(segments: EmojiToken[]): void {
		if (editorCtx == null) {
			return
		}
		for (let i = 0; i < segments.length; i++) {
			const segment = segments[i]
			if (segment.type === 'emoji') {
				try {
					editorCtx!.insertImage({
						src: segment.content,
						alt: segment.code != null ? segment.code : '',
						data: {
							code: segment.code != null ? segment.code : ''
						},
						width: COMPOSER_EMOJI_SIZE,
						height: COMPOSER_EMOJI_SIZE
					})
				} catch (e) {
				}
				continue
			}
			if (segment.content === '') {
				continue
			}
			try {
				editorCtx!.insertText({ text: segment.content })
			} catch (e) {
			}
		}
	}

	function applyContentToEditor(content: string): boolean {
		if (editorCtx == null) {
			return false
		}
		try {
			const segments = parseEmojiTokens(content)
			editorCtx!.clear({
				success: () => {
					insertEditorSegments(segments)
					applyComposerState(content, segments.some((segment: EmojiToken) => segment.type === 'emoji'))
				}
			})
			return true
		} catch (e) {
			return false
		}
	}

	function insertEmojiIntoComposer(item: any): void {
		const code = item != null && item.code != null ? String(item.code) : ''
		if (code === '') {
			return
		}
		recordRecentEmoji(code)
		if (editorCtx == null) {
			keepEmojiMenuOnNextFocus.value = true
			applyComposerState((composerText.value != null ? composerText.value : '') + code, true)
			return
		}
		try {
			keepEmojiMenuOnNextFocus.value = true
			editorCtx!.insertImage({
				src: item.path,
				alt: code,
				data: {
					code: code
				},
				width: COMPOSER_EMOJI_SIZE,
				height: COMPOSER_EMOJI_SIZE,
				success: () => {
					markComposerHasRichContent()
				}
			})
			return
		} catch (e) {
			keepEmojiMenuOnNextFocus.value = false
		}
		applyComposerState((composerText.value != null ? composerText.value : '') + code, true)
	}

	function removeLastComposerUnit(text: string): string {
		if (text === '') {
			return ''
		}
		const regex = /\[[\u4e00-\u9fa5\w]+\]$/
		const match = text.match(regex)
		if (match != null && match[0] != null && emojiMap.get(String(match[0])) != null) {
			return text.substring(0, text.length - String(match[0]).length)
		}
		return text.substring(0, text.length - 1)
	}

	function findEmojiDeleteMutation(): PlainComposerMutation {
		const currentText = plainInputText.value != null ? plainInputText.value : ''
		let start = plainSelectionStart.value
		let end = plainSelectionEnd.value
		if (start < 0 || end < 0) {
			start = currentText.length
			end = currentText.length
		}
		if (start > end) {
			const temp = start
			start = end
			end = temp
		}
		if (start > currentText.length) {
			start = currentText.length
		}
		if (end > currentText.length) {
			end = currentText.length
		}
		if (start !== end) {
			return {
				text: currentText.substring(0, start) + currentText.substring(end),
				cursor: start
			}
		}
		if (start <= 0) {
			return {
				text: currentText,
				cursor: 0
			}
		}
		const regex = /\[[\u4e00-\u9fa5\w]+\]/g
		let match: RegExpExecArray | null
		while ((match = regex.exec(currentText)) !== null) {
			const token = match[0]
			const tokenStart = match.index
			const tokenEnd = tokenStart + token.length
			if (emojiMap.get(token) != null && start > tokenStart && start <= tokenEnd) {
				return {
					text: currentText.substring(0, tokenStart) + currentText.substring(tokenEnd),
					cursor: tokenStart
				}
			}
		}
		return {
			text: currentText.substring(0, start - 1) + currentText.substring(start),
			cursor: start - 1
		}
	}

	function handleEmojiPanelItemTap(item : any): void {
		if (!ensureConversationWritable()) {
			return
		}
		insertEmojiIntoComposer(item)
	}

	async function handleStickerAddTap(): Promise<void> {
		if (!ensureConversationWritable()) {
			return
		}
		if (stickerList.value.length >= STICKER_LIMIT) {
			uni.showToast({ title: `最多添加${STICKER_LIMIT}张表情`, icon: 'none' })
			return
		}
		try {
			const paths = await chooseImage(1)
			if (paths == null || paths.length === 0) {
				return
			}
			const uploadResult = await uploadFileAndReturnId(paths[0], {
				directory: `im/sticker/${currentUserId.value}`,
				showToast: false
			})
			const data: any = uploadResult != null ? (uploadResult as any).data : null
			const uploaded = await uploadCustomSticker({
				fileId: data != null && data.fileId != null ? String(data.fileId) : '',
				url: data != null && data.url != null ? String(data.url) : '',
				name: data != null && data.name != null ? String(data.name) : ''
			})
			stickerList.value = getCustomStickers()
			uni.showToast({ title: '已添加到表情', icon: 'success' })
			await handleStickerPanelItemTap(uploaded)
		} catch (e) {
			console.error('[Chat] 上传自定义表情失败', e)
			uni.showToast({ title: '添加失败', icon: 'none' })
		}
	}

	function handleStickerManageTap(): void {
		navToStickerManage()
	}

	async function handleStickerPanelItemTap(item : StickerItem): Promise<void> {
		if (!ensureConversationWritable()) {
			return
		}
		try {
			await touchStickerRecent(item.stickerId)
		} catch (e) {
			console.warn('[Chat] 更新最近使用失败', e)
		}
		try {
			const payload: any = {
				type: 'STICKER',
				stickerId: item.stickerId,
				fileId: item.fileId || '',
				thumbFileId: item.thumbFileId || '',
				url: item.url,
				thumbUrl: item.thumbUrl || '',
				md5: item.md5 || '',
				width: item.width || 0,
				height: item.height || 0,
				mimeType: item.mimeType || ''
			}
			await (messageService as any).sendStickerMessageByRest(
				chatId.value,
				getReceiverIdForMessage(),
				getGroupIdForMessage(),
				payload
			)
			stickerList.value = getCustomStickers()
			scrollToBottom()
			showEmojiMenu.value = false
		} catch (e) {
			console.error('[Chat] 发送贴纸失败', e)
			uni.showToast({ title: '发送失败', icon: 'none' })
		}
	}

	function handleEmojiDeleteTap(): void {
		if (!ensureConversationWritable()) {
			return
		}
		// 保持表情面板打开，不因焦点变化而关闭
		keepEmojiMenuOnNextFocus.value = true
		if (editorCtx != null) {
			try {
				editorCtx!.getContents({
					success: (res) => {
						const content = normalizeEditorHtmlToContent(res != null && (res as any).html != null ? String((res as any).html) : '')
						const nextContent = removeLastComposerUnit(content)
						if (!applyContentToEditor(nextContent)) {
							applyComposerState(nextContent)
						}
					}
				})
				return
			} catch (e) {
			}
		}
		const nextContent = removeLastComposerUnit(composerText.value != null ? composerText.value : '')
		applyComposerState(nextContent)
	}

	function handleEmojiPanelScroll(e: any): void {
		// 不再根据滚动位置控制删除按钮的显示/隐藏
		// emojiDeleteButtonOpacity 已不再使用，保留函数避免报错
	}

	function applyComposerState(text: string, hasRichContent: boolean = false): void {
		composerText.value = text
		try {
			if (chatType.value === 'group') {
				syncMentionSelectorState(text)
			}
		} catch (e) {
		}
		const trimmed = text != null ? text.trim() : ''
		const hasText = trimmed.length > 0
		updateComposerLineCount(estimateComposerLineCount(text, hasRichContent))
		if (hasText || hasRichContent) {
			inputText.value = 'has_content'
		} else {
			inputText.value = ''
			updateComposerLineCount(1)
		}
		lastInputText.value = text
	}

	function syncMentionSelectorState(text: string): void {
		if (chatType.value !== 'group') {
			closeMentionSelector()
			return
		}
		const query = resolveMentionTailQuery(text)
		if (query == null) {
			if (showMentionPanel.value) {
				closeMentionSelector()
			}
			return
		}
		mentionKeyword.value = query
		if (!showMentionPanel.value && !mentionPicking) {
			openMentionSelector(query)
		}
	}

	function onEditorInput(e : any) {
		const text = e.detail.text
		const html = e.detail.html
		const normalizedHtml = html != null ? String(html) : ''
		let normalizedText = normalizedHtml !== ''
			? normalizeEditorHtmlToContent(normalizedHtml)
			: (text != null ? String(text) : '')
		normalizedText = normalizedText.replace(/\r\n/g, '\n').replace(/\n+$/g, '')
		applyComposerState(normalizedText, normalizedHtml.includes('<img'))
	}

	function onPlainInput(e : any) {
		try {
			const value = e != null && e.detail != null && e.detail.value != null ? String(e.detail.value) : ''
			const cursor = e != null && e.detail != null && e.detail.cursor != null ? Number(e.detail.cursor) : value.length
			const mutation = normalizePlainComposerMutation(value, cursor)
			plainInputText.value = mutation.text
			updatePlainSelection(mutation.cursor, mutation.cursor)
			applyComposerState(mutation.text)
		} catch (e) {
			updatePlainSelection(plainInputText.value.length, plainInputText.value.length)
			applyComposerState(plainInputText.value != null ? plainInputText.value : '')
		}
	}

	function onPlainLineChange(e: any): void {
		try {
			const detail = e != null && e.detail != null ? e.detail : null
			const lineCount = detail != null && detail.lineCount != null ? Number(detail.lineCount) : 1
			updateComposerLineCount(lineCount)
		} catch (e) {
			updateComposerLineCount(estimateComposerLineCount(plainInputText.value != null ? plainInputText.value : ''))
		}
	}

	function handlePlainBlur(e: any): void {
		try {
			const cursor = e != null && e.detail != null && e.detail.cursor != null ? Number(e.detail.cursor) : plainInputText.value.length
			updatePlainSelection(cursor, cursor)
		} catch (e) {
			updatePlainSelection(plainInputText.value.length, plainInputText.value.length)
		}
	}

	function resolveMentionTailQuery(text: string): string | null {
		try {
			if (text == null || text.length === 0) {
				return null
			}
			let tailStart = text.length - 1
			while (tailStart >= 0) {
				const ch = text.charAt(tailStart)
				if (ch === ' ' || ch === '\n' || ch === '\r' || ch === '\t') {
					break
				}
				tailStart--
			}
			const token = text.substring(tailStart + 1)
			if (token.length === 0 || token.charAt(0) !== '@') {
				return null
			}
			if (token.length === 1) {
				return ''
			}
			return token.substring(1)
		} catch (e) {
			return null
		}
	}

	function buildMentionDisplayName(member: GroupMember): string {
		try {
			const nick = member != null && member.nickname != null ? String(member.nickname) : ''
			if (nick !== '') {
				return nick
			}
			return member != null && member.userName != null ? String(member.userName) : ''
		} catch (e) {
			return ''
		}
	}

	function buildMentionAlias(displayName: string, userName: string, userId: string, duplicateCount: number): string {
		if (displayName === '') {
			return userName !== '' ? userName : userId
		}
		if (duplicateCount <= 1) {
			return displayName
		}
		const suffix = userName !== '' ? userName : userId
		if (suffix === '') {
			return displayName
		}
		return displayName + '(' + suffix + ')'
	}

	async function ensureMentionMembersLoaded(): Promise<void> {
		if (chatType.value !== 'group') {
			return
		}
		const gid = groupId.value != null ? String(groupId.value) : ''
		if (gid === '' || gid === '0') {
			return
		}
		if (mentionMembersLoaded.value && mentionMembers.value.length > 0) {
			return
		}
		mentionLoading.value = true
		try {
			const list = await groupService.getGroupMembers(gid)
			const nameCounter: Map<string, number> = new Map()
			for (let i = 0; i < list.length; i++) {
				const member = list[i]
				const displayName = buildMentionDisplayName(member)
				if (displayName === '') {
					continue
				}
				const count = nameCounter.get(displayName)
				nameCounter.set(displayName, count != null ? count + 1 : 1)
			}
			const arr: MentionMemberItem[] = []
			let myRole = 0
			for (let i = 0; i < list.length; i++) {
				const member = list[i]
				const uid = member != null && member.userId != null ? String(member.userId) : ''
				if (uid === '') {
					continue
				}
				if (uid === currentUserId.value) {
					myRole = member != null && member.role != null ? Number(member.role) : 0
				}
				const displayName = buildMentionDisplayName(member)
				if (displayName === '') {
					continue
				}
				const mentionName = buildMentionAlias(
					displayName,
					member != null && member.userName != null ? String(member.userName) : '',
					uid,
					nameCounter.get(displayName) != null ? Number(nameCounter.get(displayName)) : 1
				)
				arr.push({
					userId: uid,
					userName: member != null && member.userName != null ? String(member.userName) : '',
					displayName,
					mentionName,
					avatar: member != null && member.avatar != null ? String(member.avatar) : '',
					avatarText: member != null && member.avatarText != null ? String(member.avatarText) : '',
					avatarBg: member != null && member.avatarBg != null ? String(member.avatarBg) : '#8F959E',
					role: member != null && member.role != null ? Number(member.role) : 0
				})
			}
			mentionMembers.value = arr
			mentionMembersLoaded.value = true
			canMentionAll.value = myRole === 2 || myRole === 1
		} catch (e) {
			mentionMembers.value = []
			mentionMembersLoaded.value = false
			canMentionAll.value = false
		} finally {
			mentionLoading.value = false
		}
	}

	function openMentionSelector(initialKeyword: string = ''): void {
		try {
			if (mentionPicking) {
				return
			}
			if (chatType.value !== 'group') {
				return
			}
			const gid = groupId.value != null ? String(groupId.value) : ''
			if (gid === '' || gid === '0') {
				return
			}
			mentionPicking = true
			mentionKeyword.value = initialKeyword
			showEmojiMenu.value = false
			showPlusMenu.value = false
			showMentionPanel.value = true
			void ensureMentionMembersLoaded().finally(() => {
				mentionPicking = false
			})
		} catch (e) {
			mentionPicking = false
		}
	}

	function closeMentionSelector(): void {
		showMentionPanel.value = false
		mentionKeyword.value = ''
		mentionPicking = false
	}

	function replaceTrailingMention(text: string, mentionName: string): string {
		const query = resolveMentionTailQuery(text)
		if (query == null) {
			return text + '@' + mentionName + ' '
		}
		const startIndex = text.length - query.length - 1
		if (startIndex < 0) {
			return text + '@' + mentionName + ' '
		}
		return text.substring(0, startIndex) + '@' + mentionName + ' '
	}

	function applyMentionSelection(mentionName: string, userId: string): void {
		if (mentionName === '' || userId === '' || userId === '0') {
			return
		}
		mentionNameToUserId.set(mentionName, userId)
		const currentText = composerText.value != null ? composerText.value : ''
		if (editorCtx != null && currentText.length > 0 && currentText.charAt(currentText.length - 1) === '@') {
			try {
				editorCtx!.insertText({ text: mentionName + ' ' })
				applyComposerState(currentText + mentionName + ' ')
				closeMentionSelector()
				return
			} catch (e) {
			}
		}
		const nextText = replaceTrailingMention(currentText, mentionName)
		applyComposerState(nextText)
		if (editorCtx != null) {
			try {
				editorCtx!.clear({
					success: () => {
						try {
							editorCtx!.insertText({ text: nextText })
						} catch (e) {
						}
					}
				})
			} catch (e) {
			}
		}
		closeMentionSelector()
	}

	function handleMentionSelect(item: MentionMemberItem): void {
		try {
			if (!ensureConversationWritable()) {
				closeMentionSelector()
				return
			}
			const mentionName = item != null && item.mentionName != null ? String(item.mentionName) : ''
			const userId = item != null && item.userId != null ? String(item.userId) : ''
			applyMentionSelection(mentionName, userId)
		} catch (e) {
			closeMentionSelector()
		}
	}

	function handleMentionSelectAll(): void {
		if (!ensureConversationWritable()) {
			closeMentionSelector()
			return
		}
		applyMentionSelection('所有人', '-1')
	}

	function handleInputFocus() {
		if (!ensureConversationWritable()) {
			return
		}
		const shouldKeepEmojiMenu = keepEmojiMenuOnNextFocus.value
		keepEmojiMenuOnNextFocus.value = false
		if (!shouldKeepEmojiMenu) {
			showEmojiMenu.value = false
		}
		showPlusMenu.value = false
		if (chatType.value !== 'group') {
			closeMentionSelector()
		}
		scrollToBottom()
	}

	function getReeditDeadlineTs(msg: any): number {
		try {
			if (!msg) return 0
			const deadlineStr = (msg as any).reeditDeadlineTs != null ? String((msg as any).reeditDeadlineTs) : ''
			if (!deadlineStr) return 0
			const deadline = Number(deadlineStr)
			return !isNaN(deadline) && deadline > 0 ? deadline : 0
		} catch (e) {
			return 0
		}
	}

	function shouldRenderReeditEntry(msg: any): boolean {
		try {
			if (!msg) return false
			const s: any = (msg as any).status
			const isRecalled = s === 6 || s === '6' || s === 'recalled' || s === 'recalled_final'
			if (!isRecalled) return false
			if (!(msg as any).isSelf) return false
			const senderIdStr = (msg as any).senderId != null ? String((msg as any).senderId) : ''
			if (senderIdStr !== '' && senderIdStr !== '0' && senderIdStr !== currentUserId.value) return false
			const quoteId = (msg as any).quoteMessageId != null ? String((msg as any).quoteMessageId) : ''
			if (quoteId !== '' && quoteId !== '0') return false
			const forwardedFrom = (msg as any).forwardedFrom != null ? String((msg as any).forwardedFrom) : ''
			if (forwardedFrom.trim() !== '') return false
			const rawContent: any = (msg as any).content
			if (rawContent != null && typeof rawContent === 'object') {
				const innerQuoteId = (rawContent as any).quotedMessageId != null
					? String((rawContent as any).quotedMessageId)
					: ((rawContent as any).quoteMessageId != null ? String((rawContent as any).quoteMessageId) : '')
				if (innerQuoteId !== '' && innerQuoteId !== '0') return false
				const innerType = (rawContent as any).type != null ? String((rawContent as any).type) : ''
				if (innerType === 'FORWARD_COMBINE') return false
			}
			const content = (msg as any).reeditContent != null ? String((msg as any).reeditContent) : ''
			if (!content) return false
			return getReeditDeadlineTs(msg) > 0
		} catch (e) {
			return false
		}
	}

	function isReeditExpired(msg: any): boolean {
		const deadline = getReeditDeadlineTs(msg)
		if (deadline <= 0) return true
		return reeditNowTs.value > deadline
	}

	function getReeditRemainSeconds(msg: any): number {
		const deadline = getReeditDeadlineTs(msg)
		if (deadline <= 0) return 0
		const diff = deadline - reeditNowTs.value
		if (diff <= 0) return 0
		return Math.ceil(diff / 1000)
	}

	function formatReeditRemain(seconds: number): string {
		const s = seconds > 0 ? seconds : 0
		const mm = Math.floor(s / 60)
		const ss = s % 60
		const mStr = mm < 10 ? '0' + String(mm) : String(mm)
		const sStr = ss < 10 ? '0' + String(ss) : String(ss)
		return `${mStr}:${sStr}`
	}

	function startReeditTicker(): void {
		try {
			reeditNowTs.value = Date.now()
			if (reeditTickTimer != null) {
				return
			}
			reeditTickTimer = setInterval(() => {
				reeditNowTs.value = Date.now()
			}, 1000)
		} catch (e) {
		}
	}

	function stopReeditTicker(): void {
		try {
			if (reeditTickTimer != null) {
				clearInterval(reeditTickTimer)
				reeditTickTimer = null
			}
		} catch (e) {
		}
	}

	function getReeditActionText(msg: any): string {
		if (isReeditExpired(msg)) {
			return '重新编辑(已过期)'
		}
		const remain = getReeditRemainSeconds(msg)
		return `重新编辑(${formatReeditRemain(remain)})`
	}

	function shouldShowReeditEntry(msg: any): boolean {
		return shouldRenderReeditEntry(msg) && !isReeditExpired(msg)
	}

	function applyReeditContentToEditor(content: string): boolean {
		if (!applyContentToEditor(content)) {
			return false
		}
		scrollToBottom()
		return true
	}

	function ensureEditorReadyAndApply(content: string, attempt: number = 0) {
		if (applyReeditContentToEditor(content)) {
			return
		}
		try {
			uni.createSelectorQuery().select('#editor').context((res) => {
				try {
					const ctx = res != null ? (res as any).context : null
					if (ctx != null) {
						editorCtx = ctx as EditorContext
					}
				} catch (e) {
				}
				if (applyReeditContentToEditor(content)) {
					return
				}
				if (attempt >= 8) {
					uni.showToast({ title: '输入框暂不可用，请稍后重试', icon: 'none' })
					return
				}
				setTimeout(() => {
					ensureEditorReadyAndApply(content, attempt + 1)
				}, 80)
			}).exec()
		} catch (e) {
			if (attempt >= 8) {
				uni.showToast({ title: '输入框暂不可用，请稍后重试', icon: 'none' })
				return
			}
			setTimeout(() => {
				ensureEditorReadyAndApply(content, attempt + 1)
			}, 80)
		}
	}

	function handleReeditAfterRecall(msg: any) {
		try {
			if (!ensureConversationWritable()) {
				return
			}
			if (!shouldShowReeditEntry(msg)) {
				uni.showToast({ title: '重新编辑已过期', icon: 'none' })
				return
			}
			const quoteId = (msg as any).quoteMessageId != null ? String((msg as any).quoteMessageId) : ''
			if (quoteId !== '' && quoteId !== '0') {
				uni.showToast({ title: '该消息类型不支持重新编辑', icon: 'none' })
				return
			}
			const forwardedFrom = (msg as any).forwardedFrom != null ? String((msg as any).forwardedFrom) : ''
			if (forwardedFrom.trim() !== '') {
				uni.showToast({ title: '该消息类型不支持重新编辑', icon: 'none' })
				return
			}
			const rawContent: any = (msg as any).content
			if (rawContent != null && typeof rawContent === 'object') {
				const innerQuoteId = (rawContent as any).quotedMessageId != null
					? String((rawContent as any).quotedMessageId)
					: ((rawContent as any).quoteMessageId != null ? String((rawContent as any).quoteMessageId) : '')
				const innerType = (rawContent as any).type != null ? String((rawContent as any).type) : ''
				if ((innerQuoteId !== '' && innerQuoteId !== '0') || innerType === 'FORWARD_COMBINE') {
					uni.showToast({ title: '该消息类型不支持重新编辑', icon: 'none' })
					return
				}
			}
			let content = (msg as any).reeditContent != null ? String((msg as any).reeditContent) : ''
			try {
				if (content === '' || isRecallTip(content)) {
					const mid = (msg as any).messageId != null ? String((msg as any).messageId) : ''
					const mid2 = (msg as any).id != null ? String((msg as any).id) : ''
					const reeditChatId = (msg as any).chatId != null && String((msg as any).chatId) !== ''
						? String((msg as any).chatId)
						: chatId.value
					if (mid !== '' || mid2 !== '') {
						const hint = messageService.getReeditHintByCandidates(reeditChatId, [mid, mid2])
						if (hint != null && hint.content != null && hint.content !== '' && !isRecallTip(String(hint.content))) {
							content = String(hint.content)
						}
					}
				}
			} catch (e) {
			}
			if (!content) {
				uni.showToast({ title: '原内容为空', icon: 'none' })
				return
			}
			if (isRecallTip(content)) {
				uni.showToast({ title: '原内容不可恢复', icon: 'none' })
				return
			}
			// re-edit must send a NEW normal message (not quote-reply)
			try {
				quoteReplyMsg.value = null
			} catch (e) {
			}
			showEmojiMenu.value = false
			showPlusMenu.value = false
			isVoiceMode.value = false
			multiSelectMode.value = false
			isFullExpanded.value = false
			ensureEditorReadyAndApply(content)
		} catch (e) {
			console.error('[Chat] handleReeditAfterRecall failed:', e)
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}

	function clampRecordingElapsedMs(durationMs: number): number {
		const raw = Number(durationMs || 0)
		if (raw <= 0) {
			return 0
		}
		if (raw >= MAX_VOICE_DURATION_MS) {
			return MAX_VOICE_DURATION_MS
		}
		return Math.round(raw)
	}

	function formatRecordDurationClock(durationMs: number): string {
		const safeMs = clampRecordingElapsedMs(durationMs)
		const totalSeconds = Math.floor(safeMs / 1000)
		const minutes = Math.floor(totalSeconds / 60)
		const seconds = totalSeconds % 60
		const mm = minutes < 10 ? `0${minutes}` : `${minutes}`
		const ss = seconds < 10 ? `0${seconds}` : `${seconds}`
		return `${mm}:${ss}`
	}

	function buildRecordingDurationLabel(): string {
		const elapsed = clampRecordingElapsedMs(recordingElapsedMs.value)
		return `${formatRecordDurationClock(elapsed)} / ${formatRecordDurationClock(MAX_VOICE_DURATION_MS)}`
	}

	function buildRecordingHintText(): string {
		const remainMs = Math.max(0, MAX_VOICE_DURATION_MS - clampRecordingElapsedMs(recordingElapsedMs.value))
		if (remainMs <= 0) {
			return '已到最大时长，正在结束录音'
		}
		return `手指上滑，取消发送`
	}

	function isRecordingNearLimit(): boolean {
		if (!isRecording.value || isCancelReady.value) {
			return false
		}
		const remainMs = Math.max(0, MAX_VOICE_DURATION_MS - clampRecordingElapsedMs(recordingElapsedMs.value))
		return remainMs > 0 && remainMs <= RECORD_NEAR_LIMIT_MS
	}

	function stopRecordingDurationTimers(resetElapsed: boolean = false): void {
		if (recordingDurationTimer != null) {
			clearInterval(recordingDurationTimer)
			recordingDurationTimer = null
		}
		if (recordingAutoStopTimer != null) {
			clearTimeout(recordingAutoStopTimer)
			recordingAutoStopTimer = null
		}
		if (resetElapsed) {
			recordingElapsedMs.value = 0
		}
	}

	function forceStopRecordingByLimit(): void {
		if (!isRecording.value || recordingAutoStopped) {
			return
		}
		recordingAutoStopped = true
		pendingRecordCancel = false
		isCancelReady.value = false
		recordingElapsedMs.value = MAX_VOICE_DURATION_MS
		const manager = ensureRecorderManagerReady()
		if (manager == null) {
			resetVoiceRecordState()
			return
		}
		try {
			if (manager === H5_BROWSER_RECORDER_SENTINEL) {
				stopH5VoiceRecording()
				return
			}
			manager.stop()
		} catch (e) {
			console.error('[Chat] 达到录音上限后自动结束失败:', e)
			resetVoiceRecordState()
			uni.showToast({ title: '录音已到上限，请重试', icon: 'none' })
		}
	}

	function startRecordingDurationTracking(): void {
		stopRecordingDurationTimers()
		recordingAutoStopped = false
		recordingElapsedMs.value = 0
		recordingDurationTimer = setInterval(() => {
			if (!isRecording.value) {
				return
			}
			if (recordStartAt.value <= 0) {
				return
			}
			recordingElapsedMs.value = clampRecordingElapsedMs(Date.now() - recordStartAt.value)
			if (recordingElapsedMs.value >= MAX_VOICE_DURATION_MS) {
				forceStopRecordingByLimit()
			}
		}, RECORD_DURATION_TICK_MS)
		recordingAutoStopTimer = setTimeout(() => {
			forceStopRecordingByLimit()
		}, MAX_VOICE_DURATION_MS + 80)
	}

	function setVoiceRecordStateCancelling(): void {
		isRecording.value = false
		isCancelReady.value = false
		recordStartAt.value = 0
		recordingAutoStopped = false
		recordingInputLevel.value = 0
		stopRecordingDurationTimers(true)
		stopRecordingWaveAnimation()
	}

	function resetVoiceRecordState(): void {
		isRecording.value = false
		isCancelReady.value = false
		recordStartAt.value = 0
		recordingAutoStopped = false
		recordingInputLevel.value = 0
		stopRecordingDurationTimers(true)
		stopRecordingWaveAnimation()
		pendingRecordCancel = false
	}

	function promptVoiceRecordUnavailable(message: string): void {
		uni.showModal({
			title: '无法录音',
			content: message,
			confirmText: '去设置',
			success: (res) => {
				if (res.confirm) {
					try {
						uni.openSetting({})
					} catch (e) {
						uni.showToast({ title: message, icon: 'none' })
					}
				}
			}
		})
	}

	function showVoiceTooShortToast(): void {
		uni.showToast({
			title: '说话时间太短',
			icon: 'none',
			duration: 2000
		})
	}

	function buildVoiceTooLargeHint(sizeBytes: number = 0): string {
		const limitText = formatFileSize(MAX_VOICE_SIZE)
		if (sizeBytes > 0) {
			return `语音过大(${formatFileSize(sizeBytes)})，请控制在${limitText}内`
		}
		return `语音文件过大，请控制在${limitText}内`
	}

	function isVoiceTooLargeError(err: any): boolean {
		if (err == null) {
			return false
		}
		let text = ''
		try {
			text = err.message != null ? String(err.message) : String(err)
		} catch (e) {
			text = ''
		}
		if (text === '') {
			return false
		}
		const normalized = text.toLowerCase()
		return normalized.indexOf('文件过大') >= 0
			|| normalized.indexOf('too large') >= 0
			|| normalized.indexOf('payload too large') >= 0
			|| normalized.indexOf('413') >= 0
	}

	function resolveVoiceSourceSizeBytes(raw: any, blob: any = null): number {
		const blobSize = blob != null ? Number((blob as any).size || 0) : 0
		if (blobSize > 0) {
			return blobSize
		}
		if (raw == null) {
			return 0
		}
		const sizeCandidates = [
			(raw as any).fileSize,
			(raw as any).size,
			(raw as any).voiceSize
		]
		for (let i = 0; i < sizeCandidates.length; i++) {
			const candidate = Number(sizeCandidates[i] || 0)
			if (candidate > 0) {
				return candidate
			}
		}
		return 0
	}

	function buildVoiceRecordErrorText(err: any): string {
		try {
			if (err == null) {
				return ''
			}
			const code = err.code != null ? String(err.code) : ''
			const name = err.name != null ? String(err.name) : ''
			const message = err.errMsg != null
				? String(err.errMsg)
				: (err.message != null ? String(err.message) : String(err))
			return `${code}|${name}|${message}`.toLowerCase()
		} catch (e) {
			return ''
		}
	}

	function isVoiceRecordTooShortError(err: any): boolean {
		const text = buildVoiceRecordErrorText(err)
		if (text === '') {
			return false
		}
		return text.indexOf('too short') >= 0
			|| text.indexOf('recording time too short') >= 0
			|| text.indexOf('time too short') >= 0
			|| text.indexOf('empty voice samples') >= 0
			|| text.indexOf('empty voice blob') >= 0
			|| text.indexOf('说话时间太短') >= 0
			|| text.indexOf('录音时间太短') >= 0
	}

	function isBrowserVoiceRecorderAvailable(): boolean {
		// #ifdef H5
		try {
			const nav: any = typeof navigator !== 'undefined' ? navigator : null
			const win: any = typeof window !== 'undefined' ? window : null
			return nav != null
				&& nav.mediaDevices != null
				&& typeof nav.mediaDevices.getUserMedia === 'function'
				&& win != null
				&& (win.AudioContext != null || win.webkitAudioContext != null)
		} catch (e) {
			return false
		}
		// #endif
		return false
	}

	function revokeObjectUrl(url: string): void {
		if (!url || !url.startsWith('blob:')) {
			return
		}
		// #ifdef H5
		try {
			URL.revokeObjectURL(url)
		} catch (e) {
			// ignore
		}
		// #endif
	}

	function clearVoiceDraftUploadAssets(msg: any, clearLocalPath: boolean = false): void {
		try {
			if (msg == null) {
				return
			}
			const objectUrl = msg.uploadObjectUrl != null ? String(msg.uploadObjectUrl) : ''
			revokeObjectUrl(objectUrl)
			;(msg as any).uploadObjectUrl = ''
			if (clearLocalPath) {
				;(msg as any).localFilePath = ''
			}
		} catch (e) {
			// ignore
		}
	}

	function handleVoiceRecordStopResult(res: any): void {
		const tempFilePath = res != null && res.tempFilePath != null ? String(res.tempFilePath) : ''
		const rawDurationMs = res != null && res.duration != null ? Number(res.duration) : Math.max(0, Date.now() - recordStartAt.value)
		const durationMs = rawDurationMs > 0 ? rawDurationMs : Math.max(0, Date.now() - recordStartAt.value)
		const safeDurationMs = Math.max(0, Math.round(durationMs))
		const boundedDurationMs = clampRecordingElapsedMs(safeDurationMs)
		const durationSec = Math.max(1, Math.round(boundedDurationMs / 1000))
		const shouldCancel = pendingRecordCancel === true
		const autoStoppedByLimit = recordingAutoStopped === true
		const sourceBlob: any = res != null ? (res as any).blob : null
		const sourceSizeBytes = resolveVoiceSourceSizeBytes(res, sourceBlob)
		const sourceFormat = res != null && (res as any).format != null ? String((res as any).format) : VOICE_RECORD_FORMAT
		const uploadFileName = res != null && (res as any).fileName != null ? String((res as any).fileName) : ''
		resetVoiceRecordState()
		if (shouldCancel) {
			revokeObjectUrl(tempFilePath)
			return
		}
		if (safeDurationMs > MAX_VOICE_DURATION_MS + VOICE_DURATION_OVERFLOW_TOLERANCE_MS) {
			revokeObjectUrl(tempFilePath)
			uni.showToast({ title: '录音时长异常，请重新录制', icon: 'none' })
			return
		}
		if (sourceSizeBytes > 0 && sourceSizeBytes > MAX_VOICE_SIZE) {
			revokeObjectUrl(tempFilePath)
			uni.showToast({ title: buildVoiceTooLargeHint(sourceSizeBytes), icon: 'none' })
			return
		}
		if (autoStoppedByLimit) {
			uni.showToast({ title: '已到60秒，自动结束录音', icon: 'none' })
		}
		if (safeDurationMs < MIN_VOICE_DURATION_MS) {
			revokeObjectUrl(tempFilePath)
			showVoiceTooShortToast()
			return
		}
		if (tempFilePath === '' && sourceBlob == null) {
			uni.showToast({ title: '录音文件生成失败', icon: 'none' })
			return
		}
		const draft = createLocalVoiceDraft(tempFilePath, durationSec, boundedDurationMs, sourceBlob, sourceFormat, uploadFileName)
		;(draft as any).voiceSize = sourceSizeBytes > 0 ? sourceSizeBytes : 0
		messages.value.push(draft)
		scrollToBottom()
		void uploadVoiceDraft(draft)
	}

	function handleVoiceRecordError(err: any): void {
		console.error('[Chat] 录音失败:', err)
		resetVoiceRecordState()
		if (isVoiceRecordTooShortError(err)) {
			showVoiceTooShortToast()
			return
		}
		promptVoiceRecordUnavailable('录音失败，请检查麦克风权限')
	}

	function cleanupH5VoiceRecorderRuntime(): void {
		// #ifdef H5
		try {
			if (h5ProcessorNode != null) {
				h5ProcessorNode.onaudioprocess = null
				try { h5ProcessorNode.disconnect() } catch (e) {}
			}
			if (h5SourceNode != null) {
				try { h5SourceNode.disconnect() } catch (e) {}
			}
			if (h5SilenceNode != null) {
				try { h5SilenceNode.disconnect() } catch (e) {}
			}
			if (h5MediaStream != null && h5MediaStream.getTracks != null) {
				const tracks = h5MediaStream.getTracks()
				for (let i = 0; i < tracks.length; i++) {
					try { tracks[i].stop() } catch (e) {}
				}
			}
			if (h5AudioContext != null && h5AudioContext.close != null) {
				try { void h5AudioContext.close() } catch (e) {}
			}
		} catch (e) {
			// ignore
		} finally {
			h5ProcessorNode = null
			h5SourceNode = null
			h5SilenceNode = null
			h5MediaStream = null
			h5AudioContext = null
			h5RecordedBuffers = []
			h5InputSampleRate = 16000
		}
		// #endif
	}

	function mergeH5FloatBuffers(buffers: any[]): any {
		// #ifdef H5
		let totalLength = 0
		for (let i = 0; i < buffers.length; i++) {
			totalLength += buffers[i] != null ? Number(buffers[i].length || 0) : 0
		}
		const merged = new Float32Array(totalLength)
		let offset = 0
		for (let i = 0; i < buffers.length; i++) {
			const chunk = buffers[i]
			if (chunk == null) { continue }
			merged.set(chunk, offset)
			offset += Number(chunk.length || 0)
		}
		return merged
		// #endif
		return null
	}

	function resampleH5FloatBuffer(input: any, inputSampleRate: number, outputSampleRate: number): any {
		// #ifdef H5
		if (input == null) {
			return new Float32Array(0)
		}
		if (inputSampleRate <= 0 || inputSampleRate === outputSampleRate) {
			return input
		}
		const ratio = inputSampleRate / outputSampleRate
		const newLength = Math.max(1, Math.round(input.length / ratio))
		const output = new Float32Array(newLength)
		let offsetResult = 0
		let offsetBuffer = 0
		while (offsetResult < output.length) {
			const nextOffsetBuffer = Math.min(input.length, Math.round((offsetResult + 1) * ratio))
			let accum = 0
			let count = 0
			for (let i = offsetBuffer; i < nextOffsetBuffer; i++) {
				accum += input[i]
				count++
			}
			output[offsetResult] = count > 0 ? accum / count : 0
			offsetResult++
			offsetBuffer = nextOffsetBuffer
		}
		return output
		// #endif
		return input
	}

	function encodeH5WavBlob(samples: any, sampleRate: number): any {
		// #ifdef H5
		const buffer = new ArrayBuffer(44 + samples.length * 2)
		const view = new DataView(buffer)
		const writeString = (offset: number, text: string) => {
			for (let i = 0; i < text.length; i++) {
				view.setUint8(offset + i, text.charCodeAt(i))
			}
		}
		writeString(0, 'RIFF')
		view.setUint32(4, 36 + samples.length * 2, true)
		writeString(8, 'WAVE')
		writeString(12, 'fmt ')
		view.setUint32(16, 16, true)
		view.setUint16(20, 1, true)
		view.setUint16(22, 1, true)
		view.setUint32(24, sampleRate, true)
		view.setUint32(28, sampleRate * 2, true)
		view.setUint16(32, 2, true)
		view.setUint16(34, 16, true)
		writeString(36, 'data')
		view.setUint32(40, samples.length * 2, true)
		let offset = 44
		for (let i = 0; i < samples.length; i++, offset += 2) {
			const value = Math.max(-1, Math.min(1, Number(samples[i] || 0)))
			view.setInt16(offset, value < 0 ? value * 0x8000 : value * 0x7fff, true)
		}
		return new Blob([buffer], { type: 'audio/wav' })
		// #endif
		return null
	}

	async function startH5VoiceRecording(): Promise<boolean> {
		// #ifdef H5
		try {
			const nav: any = typeof navigator !== 'undefined' ? navigator : null
			const win: any = typeof window !== 'undefined' ? window : null
			if (nav == null || nav.mediaDevices == null || typeof nav.mediaDevices.getUserMedia !== 'function') {
				return false
			}
			const AudioContextCtor = win != null ? (win.AudioContext || win.webkitAudioContext) : null
			if (AudioContextCtor == null) {
				return false
			}
			const stream = await nav.mediaDevices.getUserMedia({
				audio: {
					echoCancellation: true,
					noiseSuppression: true,
					autoGainControl: true,
					channelCount: 1
				}
			})
			const audioContext = new AudioContextCtor()
			if (audioContext.resume != null) {
				await audioContext.resume()
			}
			const source = audioContext.createMediaStreamSource(stream)
			const processor = audioContext.createScriptProcessor(4096, 1, 1)
			const silence = audioContext.createGain()
			silence.gain.value = 0
			h5RecordedBuffers = []
			h5InputSampleRate = audioContext.sampleRate != null ? Number(audioContext.sampleRate) : 16000
			processor.onaudioprocess = (event: any) => {
				try {
					if (!isRecording.value) { return }
					const inputBuffer = event != null ? event.inputBuffer : null
					if (inputBuffer == null || inputBuffer.numberOfChannels <= 0) { return }
					const channelData = inputBuffer.getChannelData(0)
					if (channelData == null) { return }
					let energySum = 0
					let energyCount = 0
					for (let i = 0; i < channelData.length; i += 4) {
						const sample = Number(channelData[i] || 0)
						energySum += sample * sample
						energyCount++
					}
					if (energyCount > 0) {
						const rms = Math.sqrt(energySum / energyCount)
						const normalizedLevel = Math.max(0, Math.min(1, rms * 8))
						recordingInputLevel.value = recordingInputLevel.value * 0.72 + normalizedLevel * 0.28
					}
					const copy = new Float32Array(channelData.length)
					copy.set(channelData)
					h5RecordedBuffers.push(copy)
				} catch (e) {
					// ignore
				}
			}
			source.connect(processor)
			processor.connect(silence)
			silence.connect(audioContext.destination)
			h5MediaStream = stream
			h5AudioContext = audioContext
			h5SourceNode = source
			h5ProcessorNode = processor
			h5SilenceNode = silence
			supportsVoiceRecord.value = true
			return true
		} catch (err) {
			cleanupH5VoiceRecorderRuntime()
			handleVoiceRecordError(err)
			return false
		}
		// #endif
		return false
	}

	function stopH5VoiceRecording(): void {
		// #ifdef H5
		try {
			const recordedBuffers = h5RecordedBuffers.slice()
			const inputSampleRate = h5InputSampleRate
			cleanupH5VoiceRecorderRuntime()
			const merged = mergeH5FloatBuffers(recordedBuffers)
			const normalizedSampleRate = inputSampleRate > 0 ? inputSampleRate : 16000
			const totalSamples = merged != null ? Number((merged as any).length || 0) : 0
			if (totalSamples <= 0) {
				throw new Error('empty voice samples')
			}
			const durationMsFromSamples = Math.round((totalSamples / normalizedSampleRate) * 1000)
			const blob = encodeH5WavBlob(merged, normalizedSampleRate)
			if (blob == null || Number((blob as any).size || 0) <= 0) {
				throw new Error('empty voice blob')
			}
			const objectUrl = URL.createObjectURL(blob)
			handleVoiceRecordStopResult({
				tempFilePath: objectUrl,
				duration: Math.max(0, durationMsFromSamples),
				blob: blob,
				format: 'audio/wav',
				fileName: `voice-${Date.now()}.wav`
			})
		} catch (err) {
			cleanupH5VoiceRecorderRuntime()
			handleVoiceRecordError(err)
		}
		// #endif
	}

	function ensureRecorderManagerReady(forceProbe: boolean = false): any | null {
		if (!forceProbe && !supportsVoiceRecord.value && recorderManager == null) {
			return null
		}
		if (recorderManager == null) {
			// #ifndef H5
			try {
				recorderManager = uni.getRecorderManager()
			} catch (e) {
				recorderManager = null
			}
			// #endif
		}
		if (recorderManager != null) {
			supportsVoiceRecord.value = true
			if (!recorderListenersBound) {
				recorderManager.onStop((res: any) => { handleVoiceRecordStopResult(res) })
				recorderManager.onError((err: any) => { handleVoiceRecordError(err) })
				recorderListenersBound = true
			}
			return recorderManager
		}
		const browserSupported = isBrowserVoiceRecorderAvailable()
		supportsVoiceRecord.value = browserSupported
		if (browserSupported) {
			return H5_BROWSER_RECORDER_SENTINEL
		}
		return null
	}

	async function handleVoiceStart(e : TouchEvent) {
		if (!ensureConversationWritable()) { return }
		if (isRecording.value) { return }
		const scopeReady = await ensureVoiceUploadScopeReady(true)
		if (!scopeReady) { return }
		const manager = ensureRecorderManagerReady(true)
		if (manager == null) {
			uni.showToast({ title: '当前平台暂不支持语音发送', icon: 'none' })
			return
		}
		stopCurrentVoicePlayback()
		recordingInputLevel.value = 0
		const firstTouch = e != null && e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		recordStartY.value = firstTouch != null && firstTouch.pageY != null ? Number(firstTouch.pageY) : 0
		recordStartAt.value = Date.now()
		recordingElapsedMs.value = 0
		pendingRecordCancel = false
		isRecording.value = true
		isCancelReady.value = false
		startRecordingWaveAnimation()
		if (manager === H5_BROWSER_RECORDER_SENTINEL) {
			const started = await startH5VoiceRecording()
			if (!started) {
				resetVoiceRecordState()
			} else {
				recordStartAt.value = Date.now()
				recordingElapsedMs.value = 0
				startRecordingDurationTracking()
			}
			return
		}
		manager.start({
			duration: MAX_VOICE_DURATION_MS,
			sampleRate: 16000,
			numberOfChannels: 1,
			encodeBitRate: 48000,
			format: VOICE_RECORD_FORMAT,
			fail: (err: any) => {
				console.error('[Chat] 开始录音失败', err)
				handleVoiceRecordError(err)
			}
		})
		startRecordingDurationTracking()
	}

	function handleVoiceMove(e : TouchEvent) {
		if (!isRecording.value) { return }
		const firstTouch = e != null && e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (firstTouch == null || firstTouch.pageY == null) {
			return
		}
		const currentY = Number(firstTouch.pageY)
		isCancelReady.value = recordStartY.value - currentY >= VOICE_CANCEL_THRESHOLD_PX
	}

	function handleVoiceEnd() {
		if (!isRecording.value) { return }
		const manager = ensureRecorderManagerReady()
		if (manager == null) {
			resetVoiceRecordState()
			return
		}
		pendingRecordCancel = isCancelReady.value
		try {
			if (manager === H5_BROWSER_RECORDER_SENTINEL) {
				stopH5VoiceRecording()
				return
			}
			manager.stop()
		} catch (e) {
			console.error('[Chat] 停止录音失败:', e)
			resetVoiceRecordState()
			uni.showToast({ title: '录音结束失败', icon: 'none' })
		}
	}

	function cancelActiveVoiceRecording(): void {
		if (!isRecording.value) { return }
		const manager = ensureRecorderManagerReady()
		pendingRecordCancel = true
		recordingAutoStopped = false
		try {
			if (manager === H5_BROWSER_RECORDER_SENTINEL) {
				setVoiceRecordStateCancelling()
				stopH5VoiceRecording()
				return
			}
			if (manager != null) {
				setVoiceRecordStateCancelling()
				manager.stop()
				return
			}
		} catch (e) {
			// ignore
		}
		resetVoiceRecordState()
	}

	/**
	 * 处理输入，实现表情包整体退格
	 */
	function handleInput(e : InputEvent) {
		const newVal = e.detail.value
		const oldVal = lastInputText.value
		
		// 检查是否是退格删除操作 (新长度小于旧长度)
		if (newVal.length < oldVal.length) {
			const diffIndex = newVal.length
			// 如果删除的是 ']'，尝试向前寻找匹配的 '['
			if (oldVal[diffIndex] === ']') {
				const lastLeftBracket = oldVal.lastIndexOf('[', diffIndex)
				if (lastLeftBracket !== -1) {
					// 提取可能的表情代码 [xxx]
					const potentialCode = oldVal.substring(lastLeftBracket, diffIndex + 1)
					// 验证是否是合法的表情代码
					const regex = /^\[[\u4e00-\u9fa5\w]+\]$/
					if (regex.test(potentialCode)) {
						// 整体删除 [xxx]
						inputText.value = oldVal.substring(0, lastLeftBracket) + oldVal.substring(diffIndex + 1)
					}
				}
			}
		}
		
		lastInputText.value = inputText.value
	}

	function handleToSettings() {
		// 根据聊天类型跳转到不同的设置页面
		if (chatType.value === 'group') {
			// 群聊跳转到群聊设置页
			uni.navigateTo({
				url: `/pages/message/group-settings?groupId=${encodeIdParam(groupId.value)}&name=${encodeURIComponent(name.value)}`
			})
		} else {
			// 单聊跳转到聊天设置页
			uni.navigateTo({
				url: '/pages/message/chat-settings'
			})
		}
	}

	function sendByFinalContent(finalContent: string) {
		let atUserIds: string[] = []
		let mentions: any[] = []
		try {
			atUserIds = extractAtUserIds(finalContent, mentionNameToUserId)
			const parsedMentions = parseAtMentions(finalContent)
			mentions = parsedMentions.map(m => {
				const mentionUserName = m != null && m.userName != null ? String(m.userName) : ''
				let mentionUserId = mentionNameToUserId.get(mentionUserName) || ''
				if (mentionUserId === '') {
					mentionUserId = '0'
				}
				return {
					userId: mentionUserId,
					nickname: mentionUserName,
					startIndex: m.startIndex,
					endIndex: m.endIndex
				}
			}).filter(m => m.userId !== '0')
		} catch (e) {
			atUserIds = []
			mentions = []
		}
		const quoteMsg = quoteReplyMsg.value
		if (quoteMsg !== null) {
			const quoteContent = getMessagePreview(quoteMsg)
			messageService.sendQuoteReplyMessage(
				getReceiverIdForMessage(),
				getGroupIdForMessage(),
				finalContent,
				quoteMsg.messageId,
				quoteContent,
				quoteMsg.senderName,
				atUserIds,
				mentions
			)
			quoteReplyMsg.value = null
		} else {
			messageService.sendTextMessage(
				getReceiverIdForMessage(),
				getGroupIdForMessage(),
				finalContent,
				atUserIds,
				mentions
			)
		}
	}

	function resetComposerState(): void {
		plainInputText.value = ''
		applyComposerState('')
		updateComposerLineCount(1)
		isFullExpanded.value = false
		closeMentionSelector()
		try {
			mentionNameToUserId.clear()
		} catch (e) {
		}
		setTimeout(() => {
			scrollToBottom()
		}, 100)
	}

	function handleSend() {
		if (!ensureConversationWritable()) {
			return
		}
		if (editorCtx == null) {
			const finalContent = composerText.value != null ? composerText.value.trim() : ''
			if (!finalContent) {
				return
			}
			sendByFinalContent(finalContent)
			resetComposerState()
			return
		}

		editorCtx!.getContents({
			success: (res) => {
				let content = res.html
				if (!content || content === '<p><br></p>') return
				
				// 将 <img src="..." alt="[表情]" ...> 替换回 [表情]
				const imgReg = /<img [^>]*alt=['"]([^'"]+)['"][^>]*>/g
				let finalContent = content.replace(imgReg, '$1')
				
				// 去除 HTML 标签
				finalContent = finalContent.replace(/<[^>]+>/g, '')
				
				if (!finalContent.trim()) return
				sendByFinalContent(finalContent)
				
				// 清空编辑器
				editorCtx!.clear({
					success: () => {
						resetComposerState()
					}
				})
			}
		})
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		if (!ensureConversationWritable()) {
			return
		}
		if (item.nameKey === 'chat.features.album') {
			// 选择并上传图片
			if (IM_MEDIA_USE_FILE_ID === 'true') {
				uni.chooseImage({
					count: 9,
					sizeType: ['original', 'compressed'],
					sourceType: ['album', 'camera'],
					success: async (res) => {
						try {
							const uploadPromises: Promise<any>[] = []
							for (let i = 0; i < res.tempFilePaths.length; i++) {
								uploadPromises.push(uploadFileAndReturnId(res.tempFilePaths[i], {
									directory: 'im/image'
								}))
							}
							const results = await Promise.all(uploadPromises)
							console.log('[Chat] upload-and-return-id 上传成功，共', results.length, '张图片')
							results.forEach((result: any, index: number) => {
								const fileId = result.data.fileId?.toString() || '0'
								const imageUrl = result.data.url || ''
								const imageSize = result.data.size || 0
								if (!imageUrl) {
									return
								}
								let fullImageUrl = imageUrl
								if (imageUrl.startsWith('/')) {
									fullImageUrl = CONFIG_BASE_URL + imageUrl
								}
								const message = messageService.sendImageMessageV2(
									getReceiverIdForMessage(),
									getGroupIdForMessage(),
									fileId,
									fullImageUrl,
									fullImageUrl,
									0,
									0,
									imageSize
								)
								void message
							})
							showPlusMenu.value = false
							setTimeout(() => {
								scrollToBottom()
							}, 100)
						} catch (err) {
							console.error('[Chat] upload-and-return-id 上传图片失败:', err)
							uni.showToast({ title: '上传失败', icon: 'none' })
						}
					}
				})
				return
			}
			chooseAndUploadImage(9, {
				directory: 'im/image',
				onProgress: (progress) => {
					console.log('[Chat] 上传进度:', progress)
				}
			}).then((results) => {
				console.log('[Chat] 上传成功，共', results.length, '张图片')
				
				// 上传成功,发送图片消息
				results.forEach((result, index) => {
					console.log(`[Chat] 处理第 ${index + 1} 张图片:`, result)
					
					// 获取图片URL（后端返回的 data 字段直接是 URL 字符串）
					const imageUrl = typeof result.data === 'string' ? result.data : result.data.url
					const imageSize = result.data.size || 0
					
					if (!imageUrl) {
						console.error('[Chat] 图片URL为空:', result)
						uni.showToast({ title: '图片URL获取失败', icon: 'none' })
						return
					}
					
					// 构建完整URL
					let fullImageUrl = imageUrl
					if (imageUrl.startsWith('/')) {
						fullImageUrl = CONFIG_BASE_URL + imageUrl
					}
					
					console.log('[Chat] 图片完整URL:', fullImageUrl)
					console.log('[Chat] 发送消息参数', {
						receiverId: getReceiverIdForMessage(),
						groupId: getGroupIdForMessage(),
						url: fullImageUrl,
						size: imageSize
					})
					
					// 使用消息服务发送图片消息（灰度：V2 双写 fileId + url）
					const message = IM_MEDIA_USE_FILE_ID === 'true'
						? messageService.sendImageMessageV2(
							getReceiverIdForMessage(),
							getGroupIdForMessage(),
							'0',
							fullImageUrl,
							fullImageUrl,
							0,
							0,
							imageSize
						)
