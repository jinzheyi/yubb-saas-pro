	}

	.message-selected {
		background-color: rgba(7, 193, 96, 0.05);
		border-radius: 8px;
		padding: 4px 0;
	}
	
	/* 高亮显示的消息（从搜索跳转过来） */
	.message-highlighted {
		background-color: rgba(255, 193, 7, 0.15);
		border-radius: 8px;
		padding: 4px 0;
		animation: highlight-pulse 0.6s ease-in-out;
