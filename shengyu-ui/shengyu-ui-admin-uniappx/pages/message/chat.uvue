<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back', '返回') }}</text>
			</view>
			<view class="header-title-wrap">
				<text class="header-title">{{ name }}</text>
				<text class="header-status">{{ t('chat.online', '手机在线') }}</text>
			</view>
			<view class="header-right">
				<text class="iconfont header-icon">&#xea74;</text>
				<text class="iconfont header-icon" @click="handleToSettings">&#xea8d;</text>
			</view>
		</view>

		<!-- 聊天内容区域 -->
		<scroll-view class="chat-content" scroll-y="true" :scroll-into-view="lastMessageId" show-scrollbar="false">
			<!-- 水印层 -->
			<view class="watermark-layer">
				<view v-for="i in 12" :key="i" class="watermark-item">
					<text class="watermark-text">{{ watermark }}</text>
				</view>
			</view>

			<view class="message-list">
				<view v-for="(msg, index) in messages" :key="index" :id="'msg-' + index" class="message-group">
					<view v-if="formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0)" class="time-stamp">
						<text class="time-text">{{ formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0) }}</text>
					</view>
					
					<view :class="['message-item', msg.isSelf ? 'message-self' : 'message-other']">
						<view class="avatar" :style="{ backgroundColor: msg.avatarBg }">
							<text class="avatar-text">{{ msg.avatarText }}</text>
						</view>
						<view class="message-bubble-wrap">
							<!-- 文字消息 -->
							<view v-if="msg.type === 'text'" class="message-bubble bubble-text">
								<view class="text-content-wrap">
									<template v-for="(token, tIdx) in parseMessageText(msg.content)" :key="tIdx">
										<text v-if="token.type === 'text'" class="message-text">{{ token.content }}</text>
										<image v-else class="inline-emoji" :src="token.content" mode="aspectFit" />
									</template>
								</view>
							</view>
							
							<!-- 图片消息 -->
							<view v-else-if="msg.type === 'image'" class="message-bubble bubble-image" @click="handleImagePreview(msg.content)">
								<image class="chat-image" :src="msg.content" mode="widthFix" />
							</view>
							
							<!-- 语音消息 -->
							<view v-else-if="msg.type === 'voice'" class="message-bubble bubble-voice" :style="{ width: 60 + (msg.duration || 0) * 5 + 'px' }" @click="handleVoicePlay(msg)">
								<text class="iconfont voice-icon">{{ msg.isSelf ? '\ue601' : '\ue601' }}</text>
								<text class="voice-duration">{{ msg.duration }}"</text>
								<!-- 语音未读红点 -->
								<view v-if="!msg.isSelf && !msg.isRead" class="voice-unread-dot"></view>
							</view>
							
							<!-- 文件消息 -->
							<view v-else-if="msg.type === 'file'" class="message-bubble bubble-file">
								<view class="file-info">
									<text class="file-name">{{ msg.fileName }}</text>
									<text class="file-size">{{ msg.fileSize }}</text>
								</view>
								<view class="file-icon-wrap">
									<text class="iconfont file-icon">&#xea96;</text>
								</view>
							</view>
							
							<!-- 位置消息 -->
							<view v-else-if="msg.type === 'location'" class="message-bubble bubble-location">
								<view class="location-info">
									<text class="location-name">{{ msg.locationName }}</text>
									<text class="location-address">{{ msg.address }}</text>
								</view>
								<image class="location-map" src="/static/images/chat/map-placeholder.png" mode="aspectFill" />
							</view>
							
							<!-- 表情包/动图 -->
							<view v-else-if="msg.type === 'emoji'" class="bubble-emoji">
								<image class="emoji-img" :src="msg.content" mode="aspectFit" />
							</view>
							
							<!-- 自定义收藏表情 (无气泡) -->
							<view v-else-if="msg.type === 'sticker'" class="sticker-msg-wrap">
								<image class="sticker-img" :src="msg.content" mode="widthFix" />
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入区域 -->
		<view class="footer" :class="{ 'footer-full-expanded': isFullExpanded }">
			<!-- 全屏模式下的顶部操作栏 -->
			<view v-if="isFullExpanded" class="full-expand-header">
				<text class="iconfont collapse-icon" @click="toggleFullExpand">&#xe60e;</text>
			</view>

			<view class="input-row" :class="{ 'input-row-full': isFullExpanded }">
				<!-- 左侧图标栏 (仅在非全屏模式下显示) -->
				<view v-if="!isFullExpanded" class="input-left-actions">
					<!-- 语音/键盘切换 -->
					<text class="iconfont footer-icon" @click="toggleInputMode">{{ isVoiceMode ? '\ueac2' : '\ue601' }}</text>
					<!-- 展开按钮 -->
					<text v-if="!isVoiceMode && inputText" class="iconfont expand-icon-btn" @click="toggleFullExpand">&#xe7b0;</text>
				</view>

				<!-- 输入框/按住说话按钮 -->
				<view class="input-box" :class="{ 'input-box-full': isFullExpanded, 'input-box-multi': isMultiLine && !isFullExpanded }" v-if="!isVoiceMode">
					<editor 
						id="editor"
						class="chat-editor" 
						:class="{ 'chat-editor-full': isFullExpanded, 'chat-editor-multi': isMultiLine && !isFullExpanded }"
						:placeholder="t('chat.inputPlaceholder')"
						@ready="onEditorReady"
						@input="onEditorInput"
						:show-confirm-bar="false"
						:adjust-position="!isFullExpanded"
					/>
				</view>
				<view 
					v-else 
					class="voice-btn" 
					:class="{ 'voice-btn-active': isRecording }"
					@touchstart="handleVoiceStart"
					@touchmove="handleVoiceMove"
					@touchend="handleVoiceEnd"
					@touchcancel="handleVoiceEnd"
				>
					<text class="voice-btn-text">{{ isRecording ? (isCancelReady ? '松开 取消' : '松开 结束') : '按住 说话' }}</text>
				</view>
				
				<!-- 右侧/底部图标栏 -->
				<view class="input-right-actions" :class="{ 'input-right-actions-full': isFullExpanded }">
					<!-- 表情图标 -->
					<text class="iconfont footer-icon" @click="toggleEmojiMenu">&#xe604;</text>
					
					<!-- 更多/发送按钮 -->
					<view v-if="!inputText" class="plus-btn" @click="togglePlusMenu">
						<text class="iconfont footer-icon">&#xe726;</text>
					</view>
					<view v-else class="send-btn" @click="handleSend">
						<text class="send-btn-text">发送</text>
					</view>
				</view>
			</view>
			
			<!-- 表情包菜单 -->
			<view v-if="showEmojiMenu" class="emoji-menu">
				<scroll-view class="emoji-content" scroll-y="true">
					<!-- 系统表情页签 -->
					<view class="emoji-grid" v-if="currentEmojiTab === 'emoji'">
						<view 
							class="emoji-item" 
							v-for="(item, index) in emojiList" 
							:key="index"
							@click="handleEmojiClick(item)"
						>
							<image class="picker-emoji-img" :src="item.path" mode="aspectFit" />
						</view>
					</view>
					
					<!-- 收藏表情页签 -->
					<view class="sticker-grid" v-else-if="currentEmojiTab === 'sticker'">
						<!-- 添加按钮 -->
						<view class="sticker-item-add">
							<text class="iconfont sticker-add-icon">&#xe726;</text>
						</view>
						<!-- 表情列表 -->
						<view 
							class="sticker-item" 
							v-for="(item, index) in stickerList" 
							:key="item.id"
							@click="handleStickerClick(item)"
						>
							<image class="picker-sticker-img" :src="item.url" mode="aspectFill" />
						</view>
					</view>
				</scroll-view>
				
				<!-- 表情菜单 Tab 栏 -->
				<view class="emoji-tabs">
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'emoji' }" @click="currentEmojiTab = 'emoji'">
						<text class="iconfont emoji-tab-icon">&#xe604;</text>
					</view>
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'sticker' }" @click="currentEmojiTab = 'sticker'">
						<text class="iconfont emoji-tab-icon">&#xe83f;</text>
					</view>
				</view>
			</view>

			<!-- 功能菜单 (更多) -->
			<view v-if="showPlusMenu" class="features-menu">
				<view class="feature-item" v-for="(item, index) in featureList" :key="index" @click="handleFeature(item)">
					<view class="feature-icon-wrap">
						<text class="iconfont feature-icon" :style="{ color: item.color }">{{ item.icon }}</text>
					</view>
					<text class="feature-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>
		</view>

		<!-- 录音状态浮层 -->
		<view v-if="isRecording" class="recording-overlay">
			<view class="recording-card" :class="{ 'recording-card-cancel': isCancelReady }">
				<text class="iconfont recording-icon">{{ isCancelReady ? '\uea76' : '\ue601' }}</text>
				<text class="recording-text">{{ isCancelReady ? '松开手指，取消发送' : '手指上滑，取消发送' }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { emojiList } from '../../utils/emojiData.uts'
	import { parseMessageText } from '../../utils/emojiParser.uts'
	import { getCustomStickers, StickerItem } from '../../utils/stickerManager.uts'

	const { t } = useI18n()
	const name = ref('张三')
	const watermark = ref('同事A 1234')
	const inputText = ref('')
	const lastInputText = ref('') // 用于退格逻辑
	const showEmojiMenu = ref(false)
	const showPlusMenu = ref(false)
	const isFullExpanded = ref(false)
	const isMultiLine = ref(false)
	const isVoiceMode = ref(false)
	const isRecording = ref(false)
	const isCancelReady = ref(false)
	const currentEmojiTab = ref('emoji') // 'emoji' | 'sticker'
	const lastMessageId = ref('')
	const recordStartY = ref(0)
	let editorCtx : EditorContext | null = null

	const stickerList = ref<StickerItem[]>(getCustomStickers())

	const messages = ref([
		{
			type: 'text',
			content: '你今天上班表现不错，下个月绩效给优，再接再厉',
			isSelf: false,
			time: '2025-10-11 16:38',
			timestamp: 1728635880000,
			showTime: true,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'voice',
			duration: 5,
			isRead: false,
			isSelf: false,
			time: '2025-10-11 16:40',
			timestamp: 1728636000000,
			showTime: false,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'image',
			content: 'https://img.yzcdn.cn/vant/cat.jpeg',
			isSelf: false,
			time: '2025-10-11 16:42',
			timestamp: 1728636120000,
			showTime: false,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			type: 'file',
			fileName: '项目进度汇报.pdf',
			fileSize: '1.2MB',
			isSelf: true,
			time: '2025-11-10 16:33',
			timestamp: 1731227580000,
			showTime: true,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		},
		{
			type: 'location',
			locationName: '财信大厦',
			address: '长沙市天心区城南西路1号',
			isSelf: true,
			time: '2025-11-10 16:35',
			timestamp: 1731227700000,
			showTime: false,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		},
		{
			type: 'text',
			content: '收到，谢谢领导！',
			isSelf: true,
			time: '2025-11-10 16:36',
			timestamp: 1731227760000,
			showTime: false,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		}
	])

	/**
	 * 仿微信聊天时间线显示逻辑
	 */
	function formatChatTime(timestamp : number, lastTimestamp : number = 0) : string {
		// 如果两条消息间隔小于5分钟，不显示时间
		if (lastTimestamp > 0 && timestamp - lastTimestamp < 5 * 60 * 1000) {
			return ''
		}

		const date = new Date(timestamp)
		const now = new Date()
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')

		if (isToday) {
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return `昨天 ${hours}:${minutes}`
		}
		
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return `${weekDays[date.getDay()]} ${hours}:${minutes}`
		}
		
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}月${day}日 ${hours}:${minutes}`
		}
		return `${year}年${month}月${day}日 ${hours}:${minutes}`
	}


	const featureList = [
		{ icon: '\uea87', color: '#3370FF', nameKey: 'chat.features.camera' },
		{ icon: '\uea72', color: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', color: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\ue624', color: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', color: '#FFB347', nameKey: 'chat.features.fav' }
	]

	function handleBack() {
		uni.navigateBack()
	}

	function toggleInputMode() {
		isVoiceMode.value = !isVoiceMode.value
		if (isVoiceMode.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function toggleEmojiMenu() {
		showEmojiMenu.value = !showEmojiMenu.value
		showPlusMenu.value = false
		isVoiceMode.value = false
	}

	function togglePlusMenu() {
		showPlusMenu.value = !showPlusMenu.value
		showEmojiMenu.value = false
		isVoiceMode.value = false
	}

	function toggleFullExpand() {
		isFullExpanded.value = !isFullExpanded.value
		if (isFullExpanded.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function onEditorReady() {
		uni.createSelectorQuery().select('#editor').context((res) => {
			editorCtx = res.context as EditorContext
		}).exec()
	}

	function onEditorInput(e : any) {
		// e.detail.text 包含纯文本
		// e.detail.html 包含富文本
		const text = e.detail.text
		const html = e.detail.html
		
		// 启发式判断行数：
		// 1. 是否有物理换行符
		// 2. 文本长度是否超过一行（根据屏幕宽度，通常 22-25 个字符左右换行）
		// 3. HTML 中是否有多个段落标签
		const hasNewLine = text.includes('\n')
		const isLongText = text.trim().length > 22
		const hasMultipleParagraphs = (html.match(/<p>/g) || []).length > 1 || html.includes('<br>')
		
		isMultiLine.value = hasNewLine || isLongText || hasMultipleParagraphs

		if (text.trim().length > 0 || html.includes('<img')) {
			inputText.value = 'has_content'
		} else {
			inputText.value = ''
			isMultiLine.value = false // 清空时恢复单行
		}
	}

	function handleInputFocus() {
		showEmojiMenu.value = false
		showPlusMenu.value = false
		scrollToBottom()
	}

	function handleVoiceStart(e : TouchEvent) {
		recordStartY.value = e.touches[0].pageY
		isRecording.value = true
		isCancelReady.value = false
		// 模拟请求权限并开始录音
		console.log('开始录音，检查权限：RECORD_AUDIO')
	}

	function handleVoiceMove(e : TouchEvent) {
		const currentY = e.touches[0].pageY
		if (recordStartY.value - currentY > 60) {
			isCancelReady.value = true
		} else {
			isCancelReady.value = false
		}
	}

	function handleVoiceEnd() {
		if (isCancelReady.value) {
			console.log('取消录音')
		} else {
			console.log('录音结束，发送语音')
			messages.value.push({
				type: 'voice',
				duration: Math.floor(Math.random() * 10) + 1,
				isRead: true,
				isSelf: true,
				time: new Date().toLocaleTimeString(),
				timestamp: Date.now(),
				avatarText: '我',
				avatarBg: '#5FB6F7'
			})
			scrollToBottom()
		}
		isRecording.value = false
		isCancelReady.value = false
	}

	function handleEmojiClick(item : any) {
		if (editorCtx != null) {
			editorCtx!.insertImage({
				src: item.path,
				alt: item.code,
				data: {
					code: item.code
				},
				width: '24px',
				height: '24px',
				success: () => {
					console.log('插入表情成功:', item.code)
				}
			})
		}
	}

	/**
	 * 处理输入，实现表情包整体退格
	 */
	function handleInput(e : InputEvent) {
		const newVal = e.detail.value
		const oldVal = lastInputText.value
		
		// 检查是否是退格删除操作 (新长度小于旧长度)
		if (newVal.length < oldVal.length) {
			const diffIndex = newVal.length
			// 如果删除的是 ']'，尝试向前寻找匹配的 '['
			if (oldVal[diffIndex] === ']') {
				const lastLeftBracket = oldVal.lastIndexOf('[', diffIndex)
				if (lastLeftBracket !== -1) {
					// 提取可能的表情代码 [xxx]
					const potentialCode = oldVal.substring(lastLeftBracket, diffIndex + 1)
					// 验证是否是合法的表情代码
					const regex = /^\[[\u4e00-\u9fa5\w]+\]$/
					if (regex.test(potentialCode)) {
						// 整体删除 [xxx]
						inputText.value = oldVal.substring(0, lastLeftBracket) + oldVal.substring(diffIndex + 1)
					}
				}
			}
		}
		
		lastInputText.value = inputText.value
	}

	function handleStickerClick(item : StickerItem) {
		messages.value.push({
			type: 'sticker',
			content: item.url,
			isSelf: true,
			time: new Date().toLocaleTimeString(),
			timestamp: Date.now(),
			avatarText: '我',
			avatarBg: '#5FB6F7'
		})
		scrollToBottom()
		showEmojiMenu.value = false
	}

	function handleToSettings() {
		uni.navigateTo({
			url: '/pages/message/chat-settings'
		})
	}

	function handleSend() {
		if (editorCtx == null) return
		
		editorCtx!.getContents({
			success: (res) => {
				let content = res.html
				if (!content || content === '<p><br></p>') return
				
				// 将 <img src="..." alt="[表情]" ...> 替换回 [表情]
				// 匹配带有 alt 属性的 img 标签
				const imgReg = /<img [^>]*alt=['"]([^'"]+)['"][^>]*>/g
				let finalContent = content.replace(imgReg, '$1')
				
				// 去除 HTML 标签，只保留文本和已替换的表情代码
				finalContent = finalContent.replace(/<[^>]+>/g, '')
				
				if (!finalContent.trim()) return
				
				messages.value.push({
					type: 'text',
					content: finalContent,
					isSelf: true,
					time: new Date().toLocaleString(),
					timestamp: Date.now(),
					showTime: false,
					avatarText: '我',
					avatarBg: '#5FB6F7'
				})
				
				// 清空编辑器
				editorCtx!.clear({
					success: () => {
						inputText.value = ''
						isFullExpanded.value = false // 发送后收起
						scrollToBottom()
					}
				})
			}
		})
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}

	function handleImagePreview(url : string) {
		uni.previewImage({
			urls: [url],
			current: url
		})
	}

	function handleVoicePlay(msg : any) {
		if (!msg.isSelf) {
			msg.isRead = true
		}
		uni.showToast({
			title: '正在播放语音...',
			icon: 'none'
		})
	}

	function scrollToBottom() {
		setTimeout(() => {
			lastMessageId.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	onMounted(() => {
		scrollToBottom()
	})
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
