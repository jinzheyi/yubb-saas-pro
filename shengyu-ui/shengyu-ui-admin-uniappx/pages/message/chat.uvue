			receiverId: 'me',
			type: 'voice',
			content: 'voice_url_2',
			duration: 15,
			isSelf: false,
			time: '2025-10-11 16:41',
			timestamp: 1728636060000,
			showTime: false,
			avatarText: '三',
			avatarBg: '#F197BC'
		},
		{
			id: '5',
			senderId: 'me',
			receiverId: 'user1',
			type: 'file',
			content: '项目进度汇报.pdf',
			fileName: '项目进度汇报.pdf',
			fileSize: '1.2MB',
			isSelf: true,
			time: '2025-11-10 16:33',
			timestamp: 1731227580000,
			showTime: true,
			avatarText: '我',
			avatarBg: '#5FB6F7'
		},
		{
			id: '6',
