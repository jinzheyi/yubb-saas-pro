<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header" :class="{ 'header-multi-select': multiSelectMode }">
			<view v-if="!multiSelectMode" class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back', '返回') }}</text>
			</view>
			<view v-else class="header-left" @click="exitMultiSelectMode">
				<text class="cancel-text">取消</text>
			</view>
			<view class="header-title-wrap">
				<text v-if="!multiSelectMode" class="header-title" :numberOfLines="1">{{ name }}</text>
				<text v-else class="header-title" :numberOfLines="1">已选择 {{ selectedIds.length }} 条</text>
				<text v-if="!multiSelectMode && chatType === 'single'" class="header-status" :numberOfLines="1">{{ t('chat.online', '手机在线') }}</text>
				<text v-if="!multiSelectMode && chatType === 'group'" class="header-status" :numberOfLines="1">{{ memberCount }}人</text>
			</view>
			<view class="header-right">
				<text v-if="!multiSelectMode" class="iconfont header-icon">&#xea74;</text>
				<text v-if="!multiSelectMode" class="iconfont header-icon" @click="handleToSettings">&#xea8d;</text>
			</view>
		</view>

		<!-- 聊天内容区域 -->
		<scroll-view class="chat-content" :class="{ 'chat-content-multi-select': multiSelectMode }" scroll-y="true" direction="vertical" refresher-enabled="true" :refresher-triggered="historyRefresherTriggered" refresher-threshold="60" :scroll-into-view="lastMessageId" show-scrollbar="false" @refresherrefresh="handleHistoryRefresher" @scroll="handleChatScroll" @scrolltoupper="handleChatScrollToUpper" upper-threshold="80" @scrolltolower="handleChatScrollToLower" lower-threshold="80">
			<!-- 水印层 -->
			<view class="watermark-layer">
				<view v-for="i in 12" :key="i" class="watermark-item">
					<text class="watermark-text">{{ watermark }}</text>
				</view>
			</view>

			<view class="message-list">
				<view v-for="(msg, index) in messages" :key="getMessageRenderKey(msg, index)" :id="'msg-' + index" class="message-group read-observe-item" :data-seq="msg.sequence || ''" :data-self="msg.isSelf ? '1' : '0'">
					<view v-if="formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0)" class="time-stamp">
						<text class="time-text">{{ formatChatTime(msg.timestamp, index > 0 ? messages[index-1].timestamp : 0) }}</text>
					</view>
					
					<view :class="['message-item', msg.isSelf ? 'message-self' : 'message-other', multiSelectMode && selectedIds.includes(getSelectMessageId(msg)) ? 'message-selected' : '', highlightedMessageId === getSelectMessageId(msg) ? 'message-highlighted' : '']">
						<!-- 多选模式下的复选框（统一在最左侧） -->
						<view v-if="multiSelectMode && msg.type !== 'voice' && msg.type !== 'location'" class="multi-select-checkbox" @click.stop="toggleSelect(msg)">
							<text v-if="selectedIds.includes(getSelectMessageId(msg))" class="iconfont checkbox-icon checkbox-checked">&#xe65f;</text>
							<view v-else class="checkbox-icon checkbox-unchecked"></view>
						</view>
						
						<!-- 企业级撤回：对齐企微/钉钉，展示为居中系统提示条（不走左右气泡，不显示头像） -->
						<view v-if="isRecalledFinalMsg(msg)" class="recall-system-tip">
							<text class="recall-system-tip-text">{{ msg.content }}</text>
							<text v-if="shouldShowReeditEntry(msg)" class="recall-system-tip-action" @click.stop="handleReeditAfterRecall(msg)">重新编辑</text>
						</view>
						<template v-else>
							<view class="avatar" :style="{ backgroundColor: msg.avatarBg }">
								<text class="avatar-text">{{ msg.avatarText }}</text>
							</view>
							<view class="message-bubble-wrap">
								<!-- 发送者名称 (仅在群聊中,仅对他人消息) -->
								<text v-if="chatType === 'group' && !msg.isSelf" class="sender-name">
									{{ msg.senderName }}
								</text>
								
								<!-- 文字消息 -->
								<view v-if="msg.type === 'text' || msg.type === 'quote'" class="message-bubble bubble-text" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
									<!-- 引用内容预览 -->
									<view v-if="hasQuote(msg)" class="quote-preview" @click.stop="scrollToQuotedMessage(msg.quoteMessageId)">
										<view v-for="(quote, qIdx) in buildQuoteChain(msg)" :key="quote.messageId + '-' + qIdx" class="quote-chain-item" :class="{ 'quote-chain-sub': qIdx > 0 }">
											<text class="quote-sender">{{ quote.senderName }}</text>
											<text class="quote-content" :numberOfLines="1">{{ quote.content }}</text>
										</view>
									</view>
									<view class="text-content-wrap">
										<template v-for="(token, tIdx) in parseMessageTokens(msg)" :key="tIdx">
											<text v-if="token.type === 'text'" class="message-text">{{ token.content }}</text>
											<text v-else-if="token.type === 'mention'" class="mention-text" @click.stop="multiSelectMode ? null : handleMentionTokenClick(token)">{{ token.content }}</text>
											<image v-else class="inline-emoji" :src="token.content" mode="aspectFit" />
										</template>
									</view>
								</view>
								
								<!-- 图片消息 -->
								<view v-else-if="msg.type === 'image'" class="message-bubble bubble-image" @click="multiSelectMode ? handleBubbleClick(msg) : handleImagePreview(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
									<image class="chat-image" :src="msg.content" mode="widthFix" />
								</view>
								
								<!-- 视频消息 -->
								<view v-else-if="msg.type === 'video'" class="message-bubble bubble-video" @click="multiSelectMode ? handleBubbleClick(msg) : handleVideoPlay(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
									<image class="chat-video" :src="msg.poster || msg.content" mode="aspectFill" />
									<view class="video-play-overlay">
										<text class="iconfont video-play-icon">&#xe602;</text>
									</view>
								</view>
								
								<!-- 语音消息 -->
								<view v-else-if="msg.type === 'voice'" class="voice-bubble-row" :class="{ 'voice-bubble-row-self': msg.isSelf }">
									<view class="message-bubble bubble-voice" :class="{ 'bubble-voice-uploading': isVoiceUploading(msg), 'bubble-voice-failed': isVoiceUploadFailed(msg) || isVoiceSendFailed(msg), 'bubble-voice-playing': isVoicePlaying(msg), 'bubble-voice-paused': isVoicePaused(msg) }" :style="{ width: getVoiceBubbleWidth(resolveVoiceDurationSeconds(msg), buildVoiceStatusText(msg) !== '') }" @click="handleVoiceBubbleClick(msg)" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)">
										<view class="voice-wave" :class="{ 'voice-wave-playing': isVoicePlaying(msg) }">
											<view
												v-for="(barHeight, barIdx) in buildVoiceWaveBarHeights(msg)"
												:key="getSelectMessageId(msg) + '-voice-wave-' + barIdx"
												class="voice-wave-bar"
												:style="{ height: barHeight + 'px' }"
											></view>
										</view>
										<view class="voice-content">
											<text class="voice-duration">{{ buildVoiceDurationText(msg) }}</text>
											<view v-if="shouldShowVoiceProgressBar(msg)" class="voice-progress-track">
												<view class="voice-progress-fill" :style="{ width: buildVoiceProgressPercentText(msg) }"></view>
											</view>
											<text v-if="buildVoiceStatusText(msg) !== ''" class="voice-status">{{ buildVoiceStatusText(msg) }}</text>
										</view>
										<view v-if="shouldShowVoicePauseButton(msg)" class="voice-pause-action" @click.stop="handleVoicePauseClick(msg)">
											<text class="voice-pause-action-text">暂停</text>
										</view>
										<!-- 语音未读红点 -->
										<view v-if="shouldShowVoiceUnreadDot(msg)" class="voice-unread-dot"></view>
									</view>
									<view v-if="shouldShowVoiceResumeButton(msg)" class="voice-resume-action" @click.stop="handleVoiceResumeClick(msg)">
										<text class="voice-resume-action-text">继续播放</text>
									</view>
								</view>
								
								<!-- 文件消息 -->
                                <view v-else-if="msg.type === 'file'" class="message-bubble bubble-file" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="multiSelectMode ? handleBubbleClick(msg) : handleFileOpen(msg)">
									<view class="file-info">
										<text class="file-name">{{ msg.fileName }}</text>
										<text class="file-size">{{ msg.fileSize }}</text>
									</view>
									<text class="iconfont file-icon" :style="{ color: getFileIconColor(msg) }">{{ getFileIconUnicode(msg) }}</text>
								</view>
								
								<!-- 位置消息 -->
                                <view v-else-if="msg.type === 'location'" class="message-bubble bubble-location" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="multiSelectMode ? handleBubbleClick(msg) : handleLocationOpen(msg)">
									<view class="location-info">
										<text class="location-name">{{ msg.locationName }}</text>
										<text class="location-address">{{ msg.address }}</text>
									</view>
									<image class="location-map" src="/static/images/chat/map-placeholder.png" mode="aspectFill" />
								</view>

								<!-- 名片消息 -->
								<view v-else-if="msg.type === 'contact_card'" class="message-bubble bubble-contact-card" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="multiSelectMode ? handleBubbleClick(msg) : handleContactCardOpen(msg)">
									<view class="contact-card-left">
										<image v-if="msg.contactAvatar" class="contact-card-avatar" :src="msg.contactAvatar" mode="aspectFill" />
										<view v-else class="contact-card-avatar-fallback">
											<text class="contact-card-avatar-text">{{ getContactCardAvatarText(msg) }}</text>
										</view>
									</view>
									<view class="contact-card-right">
										<text class="contact-card-name">{{ msg.contactDisplayName || '名片' }}</text>
										<text v-if="msg.contactPostName" class="contact-card-meta">{{ msg.contactPostName }}</text>
										<text v-else-if="msg.contactDeptName" class="contact-card-meta">{{ msg.contactDeptName }}</text>
										<text class="contact-card-tag">个人名片</text>
									</view>
								</view>
								
								<!-- 表情包/动图 -->
                                <view v-else-if="msg.type === 'emoji'" class="bubble-emoji" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
									<image class="emoji-img" :src="msg.content" mode="aspectFit" />
								</view>
								
								<!-- 自定义收藏表情 (无气泡) -->
                                <view v-else-if="msg.type === 'sticker'" class="sticker-msg-wrap" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
									<image class="sticker-img" :src="msg.content" mode="widthFix" />
								</view>

								<!-- 合并转发（企业级：聊天记录卡片） -->
								<view v-else-if="msg.type === 'custom' && isForwardCombineMsg(msg)" class="message-bubble bubble-forward-combine" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleOpenForwardCombine(msg)">
									<view class="forward-combine-header">
										<view class="forward-combine-header-left">
											<text class="iconfont forward-combine-icon">&#xe600;</text>
											<text class="forward-combine-title">聊天记录</text>
										</view>
										<text v-if="getForwardCombineComment(msg) !== ''" class="forward-combine-comment" :numberOfLines="1">{{ getForwardCombineComment(msg) }}</text>
									</view>
									<view class="forward-combine-preview">
										<view v-for="(line, lIdx) in getForwardCombinePreviewLines(msg)" :key="getSelectMessageId(msg) + '-' + lIdx" class="forward-combine-line">
											<text class="forward-combine-line-text" :numberOfLines="1">{{ line }}</text>
										</view>
									</view>
									<view class="forward-combine-footer">
										<text class="forward-combine-footer-text">点击查看详情</text>
										<text class="iconfont forward-combine-footer-arrow">&#xeb06;</text>
									</view>
								</view>
								<view v-else-if="msg.type === 'custom'" class="message-bubble bubble-text" @longpress="openMsgMenu(msg, $event)" @touchstart="recordTouchStart($event)" @click="handleBubbleClick(msg)">
									<text class="message-content">[自定义消息]</text>
								</view>
								
								<view v-if="shouldShowReadReceiptEntry(msg)" class="read-receipt-entry" :class="{'read-receipt-entry-self': msg.isSelf}" @click.stop="handleReadReceiptEntryClick(msg)">
									<text class="read-receipt-entry-text">{{ buildReadReceiptEntryText(msg) }}</text>
								</view>
							</view>
						</template>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部输入区域 -->
		<view v-if="!multiSelectMode && !conversationReadOnly" class="footer" :class="{ 'footer-full-expanded': isFullExpanded }">
			<!-- 全屏模式下的顶部操作栏 -->
			<view v-if="isFullExpanded" class="full-expand-header">
				<text class="iconfont collapse-icon" @click="toggleFullExpand">&#xe60e;</text>
			</view>
			
			<!-- 引用回复预览栏 -->
			<view v-if="quoteReplyMsg !== null" class="quote-reply-bar">
				<view class="quote-reply-content">
					<text class="quote-reply-sender">{{ quoteReplyMsg ? quoteReplyMsg.senderName : '' }}</text>
					<text class="quote-reply-text" :numberOfLines="1">{{ quoteReplyMsg ? getMessagePreview(quoteReplyMsg) : '' }}</text>
				</view>
				<text class="iconfont quote-reply-close" @click="clearQuoteReply">&#xeb08;</text>
			</view>

			<view class="input-row" :class="{ 'input-row-full': isFullExpanded }">
				<!-- 左侧图标栏 (仅在非全屏模式下显示) -->
				<view v-if="!isFullExpanded" class="input-left-actions">
					<!-- 语音/键盘切换 -->
					<text class="iconfont footer-icon" @click="toggleInputMode">{{ isVoiceMode ? '\ueac2' : '\ue601' }}</text>
					<!-- 展开按钮 -->
					<text v-if="showExpandIcon" class="iconfont expand-icon-btn" @click="toggleFullExpand">&#xe7b0;</text>
				</view>

				<!-- 输入框/按住说话按钮 -->
				<view class="input-box" :class="{ 'input-box-full': isFullExpanded }" v-if="!isVoiceMode">
					<editor
						id="editor"
						class="chat-editor"
						:class="{ 'chat-editor-full': isFullExpanded }"
						:style="composerEditorStyle"
						placeholder=""
						@ready="onEditorReady"
						@input="onEditorInput"
						@focus="handleInputFocus"
						:show-confirm-bar="false"
						:adjust-position="!isFullExpanded"
					/>
				</view>
				<view 
					v-else 
					class="voice-btn" 
					:class="{ 'voice-btn-active': isRecording }"
					@touchstart="handleVoiceStart"
					@touchmove="handleVoiceMove"
					@touchend="handleVoiceEnd"
					@touchcancel="handleVoiceEnd"
				>
					<text class="voice-btn-text">{{ isRecording ? (isCancelReady ? '松开 取消' : '松开 结束') : '按住 说话' }}</text>
				</view>
				
				<!-- 右侧/底部图标栏 -->
				<view class="input-right-actions" :class="{ 'input-right-actions-full': isFullExpanded }">
					<!-- 表情图标 -->
					<text class="iconfont footer-icon" @click="toggleEmojiMenu">&#xe604;</text>
					
					<!-- 更多/发送按钮 -->
					<view v-if="!inputText" class="plus-btn" @click="togglePlusMenu">
						<text class="iconfont footer-icon">&#xe726;</text>
					</view>
					<view v-else class="send-btn" @click="handleSend">
						<text class="send-btn-text">发送</text>
					</view>
				</view>
			</view>
			<view v-if="showMentionPanel && !isVoiceMode" class="mention-panel">
				<view class="mention-panel-search">
					<text class="iconfont mention-panel-search-icon">&#xea6e;</text>
					<input class="mention-panel-search-input" v-model="mentionKeyword" placeholder="搜索群成员" placeholder-class="placeholder" />
					<text class="mention-panel-close" @click="closeMentionSelector">关闭</text>
				</view>
				<scroll-view class="mention-panel-list" scroll-y="true" show-scrollbar="false">
					<view v-if="mentionLoading" class="mention-panel-empty">
			<text class="mention-panel-empty-text">成员加载中...</text>
					</view>
					<template v-else>
						<view v-if="canMentionAll" class="mention-member-item" hover-class="mention-member-item-active" @click="handleMentionSelectAll">
							<view class="mention-member-avatar" :style="{ backgroundColor: '#3370FF' }">
								<text class="mention-member-avatar-text">@</text>
							</view>
							<view class="mention-member-body">
								<text class="mention-member-name">所有人</text>
								<text class="mention-member-desc">仅群主或管理员可用</text>
							</view>
						</view>
						<view
							v-for="item in filteredMentionMembers"
							:key="item.userId"
							class="mention-member-item"
							hover-class="mention-member-item-active"
							@click="handleMentionSelect(item)"
						>
							<view class="mention-member-avatar" :style="{ backgroundColor: item.avatarBg }">
								<image v-if="item.avatar != ''" class="mention-member-avatar-img" :src="item.avatar" mode="aspectFill" />
								<text v-else class="mention-member-avatar-text">{{ item.avatarText }}</text>
							</view>
							<view class="mention-member-body">
								<text class="mention-member-name">{{ item.displayName }}</text>
								<text v-if="item.userName != '' || item.mentionName != item.displayName" class="mention-member-desc">
									{{ item.userName != '' ? item.userName : item.mentionName }}
								</text>
							</view>
						</view>
						<view v-if="filteredMentionMembers.length === 0" class="mention-panel-empty">
							<text class="mention-panel-empty-text">暂无可选择成员</text>
						</view>
					</template>
				</scroll-view>
			</view>
			
			<!-- 表情包菜单 -->
			<view v-if="showEmojiMenu" class="emoji-menu">
				<scroll-view class="emoji-content" scroll-y="true" @scroll="handleEmojiPanelScroll">
					<view v-if="currentEmojiTab === 'emoji'" class="emoji-panel-body">
						<view v-if="recentEmojiList.length > 0" class="emoji-section">
							<text class="emoji-section-title emoji-section-title-recent">最近使用</text>
							<view class="emoji-grid emoji-grid-recent">
								<view 
									class="emoji-item" 
									v-for="(item, index) in recentEmojiList" 
									:key="'recent-' + index"
									@click="handleEmojiPanelItemTap(item)"
								>
									<image class="picker-emoji-img" :src="item.path" mode="aspectFit" />
								</view>
							</view>
						</view>
						<view class="emoji-section" :class="{ 'emoji-section-separate': recentEmojiList.length > 0 }">
							<text class="emoji-section-title emoji-section-title-all">所有表情</text>
							<view class="emoji-grid">
								<view 
									class="emoji-item" 
									v-for="(item, index) in emojiList" 
									:key="'all-' + index"
									@click="handleEmojiPanelItemTap(item)"
								>
									<image class="picker-emoji-img" :src="item.path" mode="aspectFit" />
								</view>
							</view>
						</view>
					</view>
					
					<!-- 收藏表情页签 -->
					<view class="sticker-grid" v-else-if="currentEmojiTab === 'sticker'">
						<!-- 添加按钮 -->
						<view class="sticker-item-add" @click="handleStickerAddTap">
							<text class="iconfont sticker-add-icon">&#xe726;</text>
						</view>
						<view class="sticker-item-manage" @click="handleStickerManageTap">
							<text class="sticker-manage-text">管理</text>
						</view>
						<!-- 表情列表 -->
						<view 
							class="sticker-item" 
							v-for="(item, index) in stickerList" 
							:key="item.id"
							@click="handleStickerPanelItemTap(item)"
						>
							<image class="picker-sticker-img" :src="item.url" mode="aspectFill" />
						</view>
					</view>
				</scroll-view>
				<view
					v-if="currentEmojiTab === 'emoji'"
					class="emoji-delete-float"
					@click="handleEmojiDeleteTap"
				>
					<view class="emoji-delete-shape">
						<view class="emoji-delete-notch"></view>
						<text class="emoji-delete-cross">×</text>
					</view>
				</view>
				
				<!-- 表情菜单 Tab 栏 -->
				<view class="emoji-tabs">
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'emoji' }" @click="currentEmojiTab = 'emoji'">
						<text class="iconfont emoji-tab-icon" :class="{ 'emoji-tab-icon-active': currentEmojiTab === 'emoji' }">&#xe604;</text>
					</view>
					<view class="emoji-tab-item" :class="{ 'emoji-tab-active': currentEmojiTab === 'sticker' }" @click="currentEmojiTab = 'sticker'">
						<text class="iconfont emoji-tab-icon" :class="{ 'emoji-tab-icon-active': currentEmojiTab === 'sticker' }">&#xe83f;</text>
					</view>
				</view>
			</view>

			<!-- 功能菜单 (更多) -->
			<view v-if="showPlusMenu" class="features-menu">
				<view class="feature-item" v-for="(item, index) in featureList" :key="index" @click="handleFeature(item)">
					<view class="feature-icon-wrap">
						<text class="iconfont feature-icon" :style="{ color: item.color }">{{ item.icon }}</text>
					</view>
					<text class="feature-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>
		</view>
		<view v-else-if="!multiSelectMode" class="footer footer-readonly">
			<text class="footer-readonly-text">{{ getReadOnlyHint() }}</text>
		</view>

        <view v-if="showMsgMenu" class="menu-mask" @click="closeMsgMenu">
            <view class="menu-content" :style="{ top: menuY + 'px', left: menuX + 'px', opacity: menuOpacity }" @click.stop>
                <view class="menu-list">
                    <view class="menu-item-btn" v-for="item in currentMenuItems" :key="item.key" hover-class="menu-item-btn-active" @click="handleMenuAction(item.key)">
                        <text class="iconfont menu-item-icon" :class="{ 'menu-danger': item.key === 'delete' }">{{ item.icon }}</text>
                        <text class="menu-item-text" :class="{ 'menu-danger': item.key === 'delete' }">{{ item.labelKey ? t(item.labelKey) : item.label }}</text>
                    </view>
                </view>
            </view>
        </view>

		<!-- 多选模式底部工具栏 -->
		<view v-if="multiSelectMode" class="multi-select-toolbar">
			<view class="toolbar-item" hover-class="toolbar-item-active" @click="handleMultiForward">
				<text class="iconfont toolbar-icon">&#xe63d;</text>
				<text class="toolbar-text">转发</text>
			</view>
			<view class="toolbar-item" hover-class="toolbar-item-active" @click="handleMultiDelete">
				<text class="iconfont toolbar-icon">&#xe602;</text>
				<text class="toolbar-text">删除</text>
			</view>
		</view>

		<!-- 录音状态浮层 -->
		<view v-if="isRecording" class="recording-overlay">
			<view class="recording-card" :class="{ 'recording-card-cancel': isCancelReady }">
				<text class="iconfont recording-icon">{{ isCancelReady ? '\uea76' : '\ue601' }}</text>
				<text
					class="recording-duration"
					:class="{ 'recording-duration-warning': !isCancelReady && isRecordingNearLimit() }"
				>
					{{ buildRecordingDurationLabel() }}
				</text>
				<view v-if="!isCancelReady" class="recording-wave">
					<view
						v-for="(barHeight, barIdx) in buildRecordingWaveHeights()"
						:key="'recording-wave-' + barIdx"
						class="recording-wave-bar"
						:style="{ height: barHeight + 'px' }"
					></view>
				</view>
				<text class="recording-text">{{ isCancelReady ? '松开手指，取消发送' : buildRecordingHintText() }}</text>
			</view>
		</view>

		<!-- 转发确认对话框 -->
		<view v-if="showForwardConfirm" class="forward-dialog-overlay" @click="cancelForward">
			<view class="forward-dialog" @click.stop>
				<view class="forward-dialog-header">
					<text class="forward-dialog-title">发送给</text>
				</view>
				<view class="forward-dialog-content">
					<view class="forward-target">
						<text class="iconfont target-icon">&#xe624;</text>
						<text class="target-name" @click.stop="openForwardTargetSelector">选择联系人/群组</text>
					</view>
					<view class="forward-preview">
						<text class="forward-preview-text">将发送给选中的联系人或群组</text>
					</view>
				</view>
				<view class="forward-dialog-footer">
					<view class="dialog-btn cancel-btn" @click="cancelForward">
						<text class="btn-text">取消</text>
					</view>
					<view class="dialog-btn confirm-btn" @click="confirmForward">
						<text class="btn-text highlight">发送</text>
					</view>
				</view>
			</view>
		</view>

		<view v-if="showReadReceiptSheet" class="read-receipt-mask" @click="closeReadReceiptSheet">
			<view class="read-receipt-sheet" @click.stop>
				<view class="read-receipt-header">
					<text class="read-receipt-title">已读详情</text>
					<text class="read-receipt-close" @click="closeReadReceiptSheet">关闭</text>
				</view>
				<view v-if="shouldShowVoiceReadReceiptHint()" class="read-receipt-hint-wrap">
					<text class="read-receipt-hint-text">语音消息“已读”按会话阅读水位统计，不代表已听语音</text>
				</view>
				<view class="read-receipt-summary">
					<view class="summary-item" @click="switchReadReceiptTab('read')">
						<text class="summary-num">{{ readReceiptSummary ? readReceiptSummary.readCount : 0 }}</text>
						<text class="summary-label" :class="{ 'summary-label-active': readReceiptTab === 'read' }">已读</text>
					</view>
					<view class="summary-divider"></view>
					<view class="summary-item" @click="switchReadReceiptTab('unread')">
						<text class="summary-num">{{ readReceiptSummary ? readReceiptSummary.unreadCount : 0 }}</text>
						<text class="summary-label" :class="{ 'summary-label-active': readReceiptTab === 'unread' }">未读</text>
					</view>
				</view>
				<scroll-view class="read-receipt-list" scroll-y="true" @scrolltolower="loadMoreReadReceipt">
					<view v-for="item in readReceiptList" :key="item.userId" class="read-receipt-row">
						<image v-if="item.avatar" class="read-receipt-avatar" :src="item.avatar" mode="aspectFill" />
						<view v-else class="read-receipt-avatar-fallback" :style="{ backgroundColor: getReadReceiptAvatarBg(item) }">
							<text class="read-receipt-avatar-text">{{ getReadReceiptAvatarText(item) }}</text>
						</view>
						<view class="read-receipt-info">
							<text class="read-receipt-name">{{ item.userName }}</text>
							<text v-if="readReceiptTab === 'read' && item.readTime" class="read-receipt-time">{{ formatReadReceiptTime(item.readTime) }}</text>
						</view>
					</view>
					<view v-if="readReceiptLoading" class="read-receipt-loading">
						<text class="read-receipt-loading-text">加载中...</text>
					</view>
					<view v-else-if="!readReceiptHasMore" class="read-receipt-loading">
						<text class="read-receipt-loading-text">没有更多了</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentInstance } from 'vue'
	import { onLoad, onShow, onHide, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { emojiList, emojiMap } from '../../utils/emojiData.uts'
	import { parseMessageText as parseEmojiTokens, type MessageToken as EmojiToken } from '../../utils/emojiParser.uts'
	import { getCustomStickers, StickerItem, refreshCustomStickers, uploadCustomSticker, collectMessageToSticker, touchStickerRecent, hasCollectedSticker } from '../../utils/stickerManager.uts'
	import { messageService, MessageItem as ServiceMessageItem, ConversationItem, MessageStatus } from '../../services/message-service.uts'
	import { badgeService } from '../../services/badge-service.uts'
	import { MessageType, wsManager } from '../../utils/websocket.uts'
	import { getMessageWindow, getMessageHistory, recallMessage, deleteMessage, getRecallConfig, markVoicePlayed as markVoicePlayedApi, markVoicePlayedBatch, getVoicePlayedStatus } from '../../api/message.uts'
	import { addFavorite as addMessageFavoriteApi } from '../../api/favorite.uts'
	import { getConversationByTarget } from '../../api/conversation.uts'
	import { getUserIdStr, getTenantId, hasRole } from '../../store/user.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { consumeNavState } from '../../utils/nav-state.uts'
	import { 
		chooseAndUploadFile,
		uploadFileAndReturnId,
		uploadBlobAndReturnId,
		uploadFile,
		uploadFileForMulti,
		chooseImage,
		chooseVideo,
		chooseFile,
		formatSeconds,
		uploadAudio
	} from '../../utils/upload.uts'
	import { getUserAvatarColor, getAvatarText as getAvatarTextUtil } from '../../utils/avatar.uts'
	import { parseMessageContent } from '../../utils/message-utils.uts'
	import { extractAtUserIds, parseAtMentions, highlightAtMentions } from '../../utils/at-mention.uts'
	import { groupService, type GroupMember } from '../../services/group-service.uts'

	import { uploadGroupFile, getFilePresignedGetUrl } from '../../api/file.uts'
	import { navToFilePreview, navToStickerManage } from '../../utils/nav.uts'
	import { readReceiptService } from '../../services/read-receipt-service.uts'
	import {
		BASE_URL as CONFIG_BASE_URL,
		IM_MEDIA_USE_FILE_ID,
		MAX_VOICE_SIZE
	} from '../../config/app.config.uts'
	import { getString, remove, setJsonObject, setString } from '../../utils/storage.uts'

	const { t } = useI18n()
	const STICKER_LIMIT = 150
	
	// 聊天类型：single(单聊) / group(群聊)
	const chatType = ref('single')
	const groupId = ref<string>('')
	const memberCount = ref(0)
	
	// 会话信息（使用字符串避免精度丢失）
	const chatId = ref<string>('')
	const targetId = ref<string>('')
	const name = ref('')
	const watermark = ref('同事A 1234')
	
	// 消息定位相关（从搜索页面跳转过来时使用）
	const entryMode = ref('latest')
	const targetAnchorSequence = ref<string>('')
	const targetMessageId = ref<string>('')  // 要定位的消息ID
	const shouldHighlight = ref(false)  // 是否需要高亮显示
	const highlightedMessageId = ref<string>('')  // 当前高亮的消息ID
	const fromMergeDetail = ref(false)
	const mergeBackDelta = ref(1)
	const conversationBizType = ref('')
	const bizSessionId = ref('')
	const serviceState = ref('')
	const conversationReadOnly = ref(false)
	const reeditNowTs = ref<number>(Date.now())
	let reeditTickTimer: any = null
	
	// 当前用户信息（使用字符串避免精度丢失）
	const currentUserId = ref<string>('0')
	const currentTenantId = ref<string>('0')
	const CHAT_VIEWPORT_TTL_MS = 15 * 60 * 1000
	const CONTACT_CARD_SELECT_EVENT = 'imSelectContactCard'

	const mentionNameToUserId: Map<string, string> = new Map()
	const recallWindowMs = ref(2 * 60 * 1000)
	let mentionPicking: boolean = false
	let contactCardSelectHandler: ((payload: any) => void) | null = null

	type MentionMemberItem = {
		userId: string
		userName: string
		displayName: string
		mentionName: string
		avatar: string
		avatarText: string
		avatarBg: string
		role: number
	}

	type ChatViewportState = {
		entryMode: string;
		atBottom: boolean;
		viewportAnchorSequence: string;
		topVisibleSequence: string;
		bottomVisibleSequence: string;
		savedAt: number;
	}

	type MessageRenderToken = {
		type: 'text' | 'emoji' | 'mention'
		content: string
		userId?: string
		startIndex?: number
		endIndex?: number
	}

	type PlainComposerMutation = {
		text: string
		cursor: number
	}

	function normalizeTextContent(raw: any): string {
		try {
			if (raw == null) return ''
			if (typeof raw === 'string') return raw
			if (typeof raw === 'object') {
				if ((raw as any).content != null) return (raw as any).content.toString()
				return raw.toString()
			}
			return String(raw)
		} catch (e) {
			return ''
		}
	}

	function parseMessageTokens(msg: any): MessageRenderToken[] {
		const out: MessageRenderToken[] = []
		const text = normalizeTextContent(msg != null ? msg.content : null)
		if (!text) return out
		let segments: any[] = []
		try {
			segments = highlightAtMentions(text) as any[]
		} catch (e) {
			segments = []
		}
		if (segments == null || segments.length === 0) {
			segments = [{ type: 'text', content: text }]
		}

		// structured mentions from WS/REST: [{userId,nickname,startIndex,endIndex}]
		let structuredMentions: any[] = []
		try {
			const c: any = msg != null ? (msg as any).content : null
			const fromContent = c != null ? (c as any).mentions : null
			const fromRoot = msg != null ? (msg as any).mentions : null
			structuredMentions = (fromContent != null ? fromContent : fromRoot) as any[]
			if (structuredMentions == null) {
				structuredMentions = []
			}
		} catch (e) {
			structuredMentions = []
		}

		const resolveMentionUserId = (startIdx: number, endIdx: number): string => {
			if (structuredMentions == null || structuredMentions.length === 0) {
				return ''
			}
			for (let i = 0; i < structuredMentions.length; i++) {
				const m: any = structuredMentions[i]
				if (m == null) continue
				const s = m.startIndex != null ? Number(m.startIndex) : -1
				const e = m.endIndex != null ? Number(m.endIndex) : -1
				if (s === startIdx && e === endIdx) {
					const uid = m.userId != null ? m.userId.toString() : ''
					return uid
				}
			}
			return ''
		}

		for (let i = 0; i < segments.length; i++) {
			const seg: any = segments[i]
			const segType = seg != null && seg.type != null ? seg.type.toString() : 'text'
			const segContent = seg != null && seg.content != null ? seg.content.toString() : ''
			if (!segContent) {
				continue
			}
			if (segType === 'mention') {
				const startIdx = seg != null && seg.startIndex != null ? Number(seg.startIndex) : -1
				const endIdx = seg != null && seg.endIndex != null ? Number(seg.endIndex) : -1
				const uid = (startIdx >= 0 && endIdx >= 0) ? resolveMentionUserId(startIdx, endIdx) : ''
				out.push({ type: 'mention', content: segContent, userId: uid, startIndex: startIdx, endIndex: endIdx })
				continue
			}
			let emojiTokens: EmojiToken[] = []
			try {
				emojiTokens = parseEmojiTokens(segContent)
			} catch (e) {
				emojiTokens = []
			}
			if (emojiTokens.length === 0) {
				out.push({ type: 'text', content: segContent })
				continue
			}
			for (let j = 0; j < emojiTokens.length; j++) {
				const t = emojiTokens[j]
				if (t == null) continue
				const tType = (t as any).type != null ? (t as any).type.toString() : 'text'
				const tContent = (t as any).content != null ? (t as any).content.toString() : ''
				if (!tContent) continue
				out.push({ type: (tType === 'emoji' ? 'emoji' : 'text') as any, content: tContent })
			}
		}
		return out
	}

	function handleMentionTokenClick(token: any): void {
		try {
			if (token == null) {
				return
			}
			const uid = token.userId != null ? token.userId.toString() : ''
			if (uid === '' || uid === '0') {
				return
			}
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${encodeURIComponent(uid)}`
			})
		} catch (e) {
			// ignore
		}
	}


	const PRESIGNED_DEFAULT_SECONDS = 600
	const PRESIGNED_REFRESH_GUARD_MS = 30 * 1000
	const MIN_VOICE_DURATION_MS = 1000
	const MAX_VOICE_DURATION_MS = 60000
	const VOICE_CANCEL_THRESHOLD_PX = 60
	const VOICE_RECORD_FORMAT = 'mp3'
	const RECORD_DURATION_TICK_MS = 100
	const RECORD_NEAR_LIMIT_MS = 10000
	const VOICE_DURATION_OVERFLOW_TOLERANCE_MS = 1500
	const VOICE_PROGRESS_MIN_FILL_PERCENT = 2
	const VOICE_PLAY_SYNC_DEBOUNCE_MS = 300
	const VOICE_PLAY_SYNC_BATCH_SIZE = 30
	const VOICE_PLAY_COMPENSATE_INTERVAL_MS = 12000
	const VOICE_PLAY_COMPENSATE_MAX_IDS = 80
	const VOICE_PLAY_COMPENSATE_BATCH_SIZE = 40
	const presignedUrlCache = new Map<string, { url: string; expiresAt: number }>()
	let voiceAudioContext: any = null
	let activeVoiceContextMessageId = ''
	let recorderManager: any = null
	let recorderListenersBound = false
	let pendingRecordCancel = false
	let h5VisibilityChangeHandler: (() => void) | null = null
	let voiceScopeResolvePromise: Promise<boolean> | null = null
	const H5_BROWSER_RECORDER_SENTINEL: any = { source: 'h5-browser-recorder' }
	let h5MediaStream: any = null
	let h5AudioContext: any = null
	let h5SourceNode: any = null
	let h5ProcessorNode: any = null
	let h5SilenceNode: any = null
	let h5RecordedBuffers: any[] = []
	let h5InputSampleRate = 16000
	const VOICE_PLAY_WAVE_FRAMES: number[][] = [
		[4, 8, 12],
		[8, 12, 6],
		[12, 7, 4]
	]
	const RECORDING_WAVE_BASE_HEIGHTS: number[] = [8, 12, 10, 14, 9]
	let playbackWaveTimer: any = null
	let recordingWaveTimer: any = null
	let recordingDurationTimer: any = null
	let recordingAutoStopTimer: any = null
	let recordingAutoStopped: boolean = false

	function getKkFileViewBaseUrl(): string {
		try {
			const base = (CONFIG_BASE_URL || '').toString()
			if (!base) return 'http://localhost:48090'
			if (base.indexOf('://') < 0) return 'http://localhost:48090'
			const u = new URL(base)
			u.port = '48090'
			return u.origin
		} catch (e) {
			return 'http://localhost:48090'
		}
	}

	function applyAutoReadEnabled(enabled: boolean): void {
		try {
			messageService.setActiveChatAutoReadEnabled(enabled)
		} catch (e) {
			// ignore
		}
	}

	function handleChatScroll(e: any): void {
		try {
			const now = Date.now()
			lastScrollAt = now
			const top = e && e.detail && e.detail.scrollTop != null ? Number(e.detail.scrollTop) : 0
			const delta = top - lastScrollTop
			lastScrollTop = top
			if (delta < -20) {
				if (isAtBottom.value) {
					isAtBottom.value = false
					applyAutoReadEnabled(false)
				}
			}
			maybeTriggerLoadOlderHistory(top, delta)
		} catch (err) {
			// ignore
		}
	}

	function handleChatScrollToLower(): void {
		try {
			if (!isAtBottom.value) {
				isAtBottom.value = true
				applyAutoReadEnabled(true)
			}
		} catch (e) {
			// ignore
		}
	}

	async function handleChatScrollToUpper(): Promise<void> {
		lastHistoryLoadTriggerAt = Date.now()
		await loadOlderHistory(true)
	}

	async function handleHistoryRefresher(): Promise<void> {
		if (historyRefresherTriggered.value) {
			return
		}
		historyRefresherTriggered.value = true
		const beforeCount = messages.value.length
		try {
			lastHistoryLoadTriggerAt = Date.now()
			await loadOlderHistory(true)
			if (beforeCount === messages.value.length && !hasMore.value) {
				uni.showToast({ title: '没有更多消息', icon: 'none' })
			}
		} finally {
			setTimeout(() => {
				historyRefresherTriggered.value = false
			}, 120)
		}
	}

	function maybeTriggerLoadOlderHistory(top: number, delta: number): void {
		try {
			if (top > 48 || delta > 0) {
				return
			}
			if (historyLoading.value || loading.value || !hasMore.value || messages.value.length === 0) {
				return
			}
			const now = Date.now()
			if (now - lastHistoryLoadTriggerAt < 500) {
				return
			}
			lastHistoryLoadTriggerAt = now
			void loadOlderHistory()
		} catch (e) {
			// ignore
		}
	}

	function getFileExtByNameOrUrl(fileName: string, url: string): string {
		try {
			const n = (fileName || '').toLowerCase()
			const pick = (s: string): string => {
				const idx = s.lastIndexOf('.')
				if (idx < 0) return ''
				return s.substring(idx + 1)
			}
			let ext = pick(n)
			if (ext) return ext
			if (url) {
				const u = new URL(url)
				ext = pick((u.pathname || '').toLowerCase())
				return ext
			}
			return ''
		} catch (e) {
			return ''
		}
	}

	function ensureConversationWritable(): boolean {
		if (!conversationReadOnly.value) {
			return true
		}
		uni.showToast({ title: getReadOnlyHint(), icon: 'none' })
		return false
	}

	function getReadOnlyHint(): string {
		try {
			const state = serviceState.value != null ? String(serviceState.value) : ''
			if (state === 'closed' || state === 'ended' || state === 'finished') {
				return '当前会话已关闭，仅可查看历史消息'
			}
			return '当前会话为只读模式'
		} catch (e) {
			return '当前会话为只读模式'
		}
	}

	function shouldUseKkFileView(ext: string): boolean {
		const e = (ext || '').toLowerCase()
		if (!e) return false
		return (
			e === 'pdf' ||
			e === 'doc' || e === 'docx' ||
			e === 'xls' || e === 'xlsx' ||
			e === 'ppt' || e === 'pptx' ||
			e === 'txt'
		)
	}

	function isUnstableKkPreviewExt(ext: string): boolean {
		const e = (ext || '').toLowerCase()
		return e === 'ppt' || e === 'pptx'
	}

	function normalizeSourceUrlForKkFileView(rawUrl: string): string {
		try {
			if (!rawUrl) return rawUrl
			const u = new URL(rawUrl)
			if ((u.hostname === '127.0.0.1' || u.hostname === 'localhost') && u.port === '48080') {
				u.hostname = 'host.docker.internal'
				return u.toString()
			}
			return rawUrl
		} catch (e) {
			return rawUrl
		}
	}

	function base64EncodeUtf8(raw: string): string {
		if (!raw) return ''
		// #ifdef H5
		try {
			return btoa(unescape(encodeURIComponent(raw)))
		} catch (e) {
			return ''
		}
		// #endif

		try {
			const bytes = raw.toByteArray('utf-8')
			const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
			let out = ''
			let i = 0
			while (i < bytes.length) {
				const c1 = bytes[i++]
				const c2 = i < bytes.length ? bytes[i++] : -1
				const c3 = i < bytes.length ? bytes[i++] : -1
				const e1 = (c1 >> 2) & 0x3f
				const e2 = ((c1 & 0x3) << 4) | ((c2 >= 0 ? c2 : 0) >> 4)
				let e3 = ((c2 >= 0 ? c2 : 0) & 0xf) << 2
				let e4 = 0
				if (c2 >= 0) {
					e3 |= ((c3 >= 0 ? c3 : 0) >> 6) & 0x3
					e4 = (c3 >= 0 ? c3 : 0) & 0x3f
				}
				out += chars.charAt(e1)
				out += chars.charAt(e2)
				out += c2 >= 0 ? chars.charAt(e3) : '='
				out += c3 >= 0 ? chars.charAt(e4) : '='
			}
			return out
		} catch (e) {
			return ''
		}
	}

	function buildKkFileViewPreviewUrl(sourceUrl: string): string {
		const kkBase = getKkFileViewBaseUrl()
		const normalized = normalizeSourceUrlForKkFileView(sourceUrl)
		const b64 = base64EncodeUtf8(normalized)
		if (!b64) return ''
		return `${kkBase}/onlinePreview?url=${encodeURIComponent(b64)}`
	}

	function openUrlInWebViewOrBrowser(url: string): void {
		if (!url) return
		// #ifdef H5
		try {
			window.open(url, '_blank')
			return
		} catch (e) {
			return
		}
		// #endif

		// #ifdef APP-ANDROID || APP-IOS
		try {
			;(plus as any).runtime.openURL(url)
			return
		} catch (e) {
			// ignore
		}
		// #endif

		try {
			uni.setClipboardData({ data: url })
			uni.showToast({ title: '已复制预览链接', icon: 'none' })
		} catch (e) {
			// ignore
		}
	}

	async function resolvePresignedUrl(fileId: string): Promise<string> {
		const id = (fileId || '').toString()
		if (!id || id === '0') {
			return ''
		}
		const now = Date.now()
		const cached = presignedUrlCache.get(id)
		if (cached && cached.url && cached.expiresAt && cached.expiresAt - now > PRESIGNED_REFRESH_GUARD_MS) {
			return cached.url
		}
		const resp: any = await getFilePresignedGetUrl(id, PRESIGNED_DEFAULT_SECONDS)
		if (!resp || !resp.url) {
			return ''
		}
		presignedUrlCache.set(id, { url: resp.url, expiresAt: resp.expiresAt || (now + PRESIGNED_DEFAULT_SECONDS * 1000) })
		return resp.url
	}

	function tryExtractFileId(raw: any): string {
		if (!raw) return ''
		try {
			if (typeof raw === 'string') {
				const parsed = parseRawContent(raw)
				if (parsed && typeof parsed === 'object' && parsed.fileId != null) {
					return parsed.fileId.toString()
				}
				return ''
			}
			if (typeof raw === 'object' && raw.fileId != null) {
				return raw.fileId.toString()
			}
			return ''
		} catch (e) {
			return ''
		}
	}
	
	function getReceiverIdForMessage(): string {
		return chatType.value === 'single' ? (targetId.value || '0') : '0'
	}
	
	function getGroupIdForMessage(): string {
		return chatType.value === 'group' ? (targetId.value || '0') : '0'
	}

	function applyConversationMeta(conv: any): void {
		try {
			if (conv == null) {
				return
			}
			const cTypeNum = Number((conv as any).conversationType)
			const isGroup = cTypeNum === 2
			chatType.value = isGroup ? 'group' : 'single'
			const tid = (conv as any).targetId != null ? String((conv as any).targetId) : ''
			if (tid !== '') {
				targetId.value = tid
				if (isGroup) {
					groupId.value = tid
				}
			}
			const convName = (conv as any).targetName != null ? String((conv as any).targetName) : ''
			if (convName !== '') {
				name.value = convName
			}
			if (isGroup) {
				const count = (conv as any).groupMemberCount != null ? Number((conv as any).groupMemberCount) : 0
				memberCount.value = !isNaN(count) && count > 0 ? count : memberCount.value
			}
		} catch (e) {
		}
	}

	async function hydrateConversationMetaByChatId(): Promise<void> {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			const convServiceModule = await import('../../services/conversation-service.uts')
			const cs = (convServiceModule as any).conversationService
			let conv: any = cs != null ? cs.getConversation(chatId.value) : null
			if (conv == null && cs != null) {
				await cs.loadConversations()
				conv = cs.getConversation(chatId.value)
			}
			applyConversationMeta(conv)
		} catch (e) {
		}
	}

	let resolveChatIdTask : Promise<void> | null = null

	async function ensureChatIdByTargetIfNeeded(showErrorToast: boolean = false): Promise<void> {
		if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
			return
		}
		if (!targetId.value || targetId.value === '') {
			return
		}
		if (resolveChatIdTask != null) {
			await resolveChatIdTask
			return
		}
		resolveChatIdTask = (async () => {
			try {
				console.log('[Chat] 没有 chatId，查询会话 targetId:', targetId.value, 'type:', chatType.value)
				const conversationType = chatType.value === 'group' ? 2 : 1
				const conversationResult = await getConversationByTarget(targetId.value, conversationType)
				const resolvedChatId = conversationResult && (conversationResult.chatId != null ? conversationResult.chatId : conversationResult.id)
				if (resolvedChatId != null) {
					chatId.value = resolvedChatId.toString()
					console.log('[Chat] 查询会话成功, chatId:', chatId.value)
				} else {
					console.error('[Chat] 查询会话失败：返回数据无效', conversationResult)
				}
			} catch (e) {
				console.error('[Chat] 查询会话失败:', e)
				if (showErrorToast) {
					uni.showToast({
						title: '获取会话失败',
						icon: 'none'
					})
				}
			}
		})()
		try {
			await resolveChatIdTask
		} finally {
			resolveChatIdTask = null
		}
	}

	async function ensureInitialMessagesLoaded(): Promise<void> {
		if (initialMessagesLoaded) {
			return
		}
		if (!chatId.value || chatId.value === '' || chatId.value === '0') {
			return
		}
		initialMessagesLoaded = true
		await loadMessages()
	}
	
