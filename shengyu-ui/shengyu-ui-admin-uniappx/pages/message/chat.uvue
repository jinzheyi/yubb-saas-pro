	.voice-pause-action {
		margin-left: 6px;
		padding: 2px 6px;
		border-radius: 9px;
		background-color: rgba(22, 119, 255, 0.12);
	}

	.message-self .voice-pause-action {
		margin-left: 0;
		margin-right: 6px;
		background-color: rgba(15, 74, 163, 0.15);
	}

	.voice-pause-action-text {
		font-size: 11px;
		color: #1677FF;
		white-space: nowrap;
	}

	.message-self .voice-pause-action-text {
		color: #0F4AA3;
	}

	.voice-resume-action {
		margin-left: 6px;
		padding: 4px 8px;
		border-radius: 12px;
		background-color: #FFFFFF;
		border-width: 0.5px;
		border-color: #CED3DC;
	}

	.voice-bubble-row-self .voice-resume-action {
		margin-left: 0;
		margin-right: 6px;
	}

	.voice-resume-action-text {
		font-size: 11px;
		color: #57606A;
		white-space: nowrap;
	}

	/* 视频消息 */
	.bubble-video {
		padding: 0;
		overflow: hidden;
		background-color: #000000;
		width: 150px;
		height: 200px;
		border-radius: 8px;
		position: relative;
	}

	.chat-video {
		width: 150px;
		height: 200px;
	}

	.video-play-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		justify-content: center;
		align-items: center;
		background-color: rgba(0, 0, 0, 0.1);
	}

	.video-play-icon {
		font-size: 40px;
		color: #FFFFFF;
		opacity: 0.8;
	}

	.voice-unread-dot {
		position: absolute;
		right: -8px;
		top: 50%;
		transform: translateY(-50%);
		width: 8px;
		height: 8px;
		background-color: #F54A45;
		border-radius: 4px;
		z-index: 2;
		border-width: 1px;
		border-color: #FFFFFF;
	}

	/* 文件消息 */
	.bubble-file {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		min-width: 180px;
		max-width: 260px;
		padding: 12px;
	}

	/* 合并转发（聊天记录卡片） */
	.bubble-forward-combine {
		background-color: #FFFFFF;
		min-width: 180px;
		max-width: 72vw;
		padding: 12px 12px;
		border-radius: 12px;
		border-width: 0.5px;
		border-color: rgba(229, 230, 235, 1);
		box-sizing: border-box;
	}

	.message-self .bubble-forward-combine {
		background-color: #D2E3FC;
		border-color: rgba(151, 185, 243, 1);
	}

	.forward-combine-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		min-width: 0;
	}

	.forward-combine-header-left {
		flex-direction: row;
		align-items: center;
		min-width: 0;
		flex: 1;
	}

	.forward-combine-icon {
		font-size: 18px;
		color: #646A73;
		margin-right: 6px;
	}

	.message-self .forward-combine-icon {
		color: #3B5CCC;
	}

	.forward-combine-title {
		font-size: 14px;
		font-weight: 600;
		color: #1F2329;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.forward-combine-comment {
		margin-left: 8px;
		font-size: 12px;
		color: #4E5969;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
		max-width: 45%;
	}

	.forward-combine-preview {
		margin-top: 10px;
		padding-top: 10px;
		border-top-width: 0.5px;
		border-top-color: #E5E6EB;
	}

	.message-self .forward-combine-preview {
		border-top-color: rgba(151, 185, 243, 1);
	}

	.forward-combine-line {
		margin-bottom: 6px;
		min-width: 0;
	}

	.forward-combine-line:last-child {
		margin-bottom: 0;
	}

	.forward-combine-line-text {
		font-size: 12px;
		color: #4E5969;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.forward-combine-footer {
		margin-top: 8px;
		padding-top: 8px;
		border-top-width: 0.5px;
		border-top-color: #E5E6EB;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.message-self .forward-combine-footer {
		border-top-color: rgba(151, 185, 243, 1);
	}

	.forward-combine-footer-text {
		font-size: 12px;
		color: #1677FF;
	}

	.forward-combine-footer-arrow {
		font-size: 14px;
		color: rgba(22, 119, 255, 0.9);
		margin-left: 8px;
	}

	.file-info {
		flex: 1;
		margin-right: 12px;
		min-width: 0;
	}

	.file-name {
		font-size: 15px;
		color: #1F2329;
		lines: 2;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.file-size {
		font-size: 12px;
		color: #8F959E;
		margin-top: 4px;
	}

	.file-icon {
		width: 44px;
		height: 44px;
		line-height: 44px;
		text-align: center;
		background-color: #F5F7FA;
		border-radius: 0;
		font-size: 44px;
	}

	/* 位置消息 */
	.bubble-location {
		padding: 0;
		overflow: hidden;
		background-color: #FFFFFF;
		width: 220px;
		max-width: 100%;
	}

	.location-info {
		padding: 10px 12px;
		word-break: break-all;
	}

	.location-name {
		font-size: 15px;
		color: #1F2329;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.location-address {
		font-size: 12px;
		color: #8F959E;
		margin-top: 2px;
		lines: 1;
		text-overflow: ellipsis;
		word-break: break-all;
	}

	.location-map {
		width: 100%;
		height: 100px;
		background-color: #F5F7FA;
	}

	/* 名片消息 */
	.bubble-contact-card {
		background-color: #FFFFFF;
		width: 220px;
		max-width: 100%;
		padding: 12px;
		flex-direction: row;
		align-items: center;
	}

	.contact-card-left {
		width: 40px;
		height: 40px;
		margin-right: 10px;
	}

	.contact-card-avatar {
		width: 40px;
		height: 40px;
		border-radius: 20px;
	}

	.contact-card-avatar-fallback {
		width: 40px;
		height: 40px;
		border-radius: 20px;
		background-color: #E6F0FF;
		justify-content: center;
		align-items: center;
	}

	.contact-card-avatar-text {
		font-size: 16px;
		color: #1677FF;
		font-weight: 600;
	}

	.contact-card-right {
		flex: 1;
	}

	.contact-card-name {
		font-size: 15px;
		color: #1F2329;
		lines: 1;
		text-overflow: ellipsis;
	}

	.contact-card-meta {
		font-size: 12px;
		color: #8F959E;
		margin-top: 2px;
		lines: 1;
		text-overflow: ellipsis;
	}

	.contact-card-tag {
		font-size: 11px;
		color: #57606A;
		margin-top: 4px;
	}

	/* 表情 */
	.bubble-emoji {
		padding: 0;
		background-color: transparent;
		border-width: 0;
	}

	.emoji-img {
		width: 100px;
		height: 100px;
	}

	/* 自定义表情 (Sticker) */
	.sticker-msg-wrap {
		padding: 0;
		background-color: transparent;
		border-width: 0;
	}

	.sticker-img {
		width: 120px;
		border-radius: 4px;
	}

	.message-text {
		font-size: 15px;
		color: #1F2329;
		line-height: 1.5;
		word-break: break-word;
		white-space: pre-wrap;
		overflow-wrap: break-word;
		max-width: 100%;
		display: flex;
		flex-direction: row;
	}

	.footer {
		background-color: #F7F7F7;
		border-top-width: 1px;
		border-top-color: #E5E5E5;
		border-top-style: solid;
		padding-bottom: 8px;
	}

	.footer-readonly {
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
		background-color: #FFFFFF;
	}

	.footer-readonly-text {
		font-size: 13px;
		color: #8F959E;
		text-align: center;
	}

	.footer-full-expanded {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		height: 100%;
		z-index: 1000;
		background-color: #FFFFFF;
		padding-bottom: env(safe-area-inset-bottom);
		border-top-width: 0;
	}

	.full-expand-header {
		height: 44px;
		padding: 0 16px;
		justify-content: center;
		background-color: #FFFFFF;
	}

	.collapse-icon {
		font-size: 24px;
		color: #1F2329;
	}

	.input-row {
		flex-direction: row;
		align-items: flex-end;
		padding: 7px 12px;
	}

	.input-row-full {
		flex: 1;
		flex-direction: column;
		align-items: stretch;
		padding: 0 16px 16px;
		background-color: #FFFFFF;
	}

	.input-left-actions {
		flex-direction: row;
		align-items: center;
		height: 40px;
	}

	.input-right-actions {
		flex-direction: row;
		align-items: center;
		height: 40px;
		padding-bottom: 1px;
	}

	.input-right-actions-full {
		justify-content: flex-end;
		height: 44px;
		padding-top: 0;
	}

	.input-box {
		flex: 1;
		background-color: #FFFFFF;
		border-radius: 4px;
		margin: 0 8px;
		min-height: 40px;
		max-height: 232px;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		overflow: hidden;
	}

	.input-box-full {
		flex: 1;
		height: 100%;
		max-height: 100%;
		margin: 0;
		justify-content: flex-start;
	}

	.expand-icon-btn {
		font-size: 20px;
		color: #646A73;
		margin-left: 8px;
	}

	.chat-editor {
		width: 100%;
		box-sizing: border-box;
		min-height: 40px;
		max-height: 232px;
		padding: 8px 12px;
		font-size: 16px;
		line-height: 24px;
		background-color: transparent;
	}

	.plain-chat-editor {
		width: calc(100% + 12px);
		margin-right: -12px;
		padding-right: 24px;
		scrollbar-width: none;
	}

	.plain-chat-editor::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}

	.chat-editor-full {
		flex: 1;
		height: 100%;
		padding: 12px 0;
	}

	.chat-input {
		font-size: 16px;
		color: #1F2329;
		line-height: 1.2;
	}

	.voice-btn {
		flex: 1;
		background-color: #FFFFFF;
		border-radius: 4px;
		margin: 0 10px;
		height: 38px;
		justify-content: center;
		align-items: center;
	}

	.voice-btn-active {
		background-color: #E5E5E5;
	}

	.voice-btn-text {
		font-size: 16px;
		color: #1F2329;
		font-weight: 600;
	}

	.footer-icon {
		font-size: 28px;
		color: #1F2329;
		margin-bottom: 4px;
	}

	.plus-btn {
		justify-content: center;
		align-items: center;
		margin-left: 10px;
	}

	.send-btn {
		background-color: #07C160;
		height: 32px;
		min-width: 56px;
		padding: 0 14px;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
		margin-left: 10px;
	}

	.send-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}

	.mention-panel {
		background-color: #FFFFFF;
		border-top-width: 1px;
		border-top-color: #F0F2F5;
		padding: 8px 12px 0;
		max-height: 280px;
	}

	.mention-panel-search {
		flex-direction: row;
		align-items: center;
		height: 36px;
		background-color: #F5F7FA;
		border-radius: 18px;
		padding: 0 12px;
	}

	.mention-panel-search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.mention-panel-search-input {
		flex: 1;
		height: 36px;
		margin-left: 8px;
		font-size: 14px;
		color: #1F2329;
	}

	.mention-panel-close {
		font-size: 13px;
		color: #3370FF;
		margin-left: 8px;
	}

	.mention-panel-list {
		max-height: 236px;
	}

	.mention-member-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 1px;
		border-bottom-color: #F5F7FA;
	}

	.mention-member-item-active {
		background-color: #F5F7FA;
	}

	.mention-member-avatar {
		width: 36px;
		height: 36px;
		border-radius: 18px;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.mention-member-avatar-img {
		width: 36px;
		height: 36px;
		border-radius: 18px;
	}

	.mention-member-avatar-text {
		font-size: 14px;
		color: #FFFFFF;
		font-weight: 600;
	}

	.mention-member-body {
		flex: 1;
		margin-left: 12px;
	}

	.mention-member-name {
		font-size: 15px;
		color: #1F2329;
		line-height: 20px;
	}

	.mention-member-desc {
		margin-top: 2px;
		font-size: 12px;
		color: #8F959E;
		line-height: 16px;
	}

	.mention-panel-empty {
		align-items: center;
		justify-content: center;
		padding: 24px 0;
	}

	.mention-panel-empty-text {
		font-size: 13px;
		color: #8F959E;
	}

	.features-menu {
		background-color: #F7F7F7;
		padding: 20px 10px;
		flex-direction: row;
		flex-wrap: wrap;
		border-top-width: 0.5px;
		border-top-color: #E5E5E5;
	}

	.feature-item {
		width: 25%;
		align-items: center;
		margin-bottom: 20px;
	}

	.feature-icon-wrap {
		width: 56px;
		height: 56px;
		background-color: #FFFFFF;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-bottom: 8px;
	}

	.feature-icon {
		font-size: 26px;
	}

	.feature-name {
		font-size: 12px;
		color: #646A73;
	}

	/* 表情包菜单 */
	.emoji-menu {
		position: relative;
		background-color: #F7F7F7;
		height: 260px;
		border-top-width: 0.5px;
		border-top-color: #E5E5E5;
	}

	.emoji-content {
		flex: 1;
		padding: 12px 14px 10px;
	}

	.emoji-panel-body {
		padding-bottom: 6px;
	}

	.emoji-grid {
		flex-direction: row;
		flex-wrap: wrap;
		margin: 0 -2px;
	}

	.emoji-section {
		padding-bottom: 10px;
	}

	.emoji-section-separate {
		padding-top: 6px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: rgba(31, 35, 41, 0.04);
	}

	.emoji-section-title {
		font-size: 13px;
		color: #A7AFB9;
		line-height: 18px;
		padding: 1px 2px 8px;
	}

	.emoji-section-title-recent {
		padding-bottom: 8px;
	}

	.emoji-section-title-all {
		padding-top: 0;
		padding-bottom: 8px;
	}

	.emoji-grid-recent {
		padding-bottom: 8px;
	}

	.emoji-item {
		width: 14.28%; /* 7?*/
		height: 48px;
		justify-content: center;
		align-items: center;
	}

	.picker-emoji-img {
		width: 30px;
		height: 30px;
	}

	.emoji-delete-float {
		position: absolute;
		right: 16px;
		bottom: 58px;
		width: 42px;
		height: 34px;
		border-radius: 11px;
		background-color: rgba(255, 255, 255, 0.98);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(31, 35, 41, 0.05);
		justify-content: center;
		align-items: center;
		box-shadow: 0 8px 18px rgba(31, 35, 41, 0.08);
	}

	.emoji-delete-shape {
		width: 18px;
		height: 13px;
		border-width: 1.5px;
		border-style: solid;
		border-color: #A7AFB9;
		border-radius: 3px;
		justify-content: center;
		align-items: center;
		position: relative;
	}

	.emoji-delete-notch {
		position: absolute;
		left: -6px;
		width: 0;
		height: 0;
		border-top-width: 6px;
		border-bottom-width: 6px;
		border-right-width: 6px;
		border-top-style: solid;
		border-bottom-style: solid;
		border-right-style: solid;
		border-top-color: transparent;
		border-bottom-color: transparent;
		border-right-color: #A7AFB9;
	}

	.emoji-delete-cross {
		font-size: 11px;
		line-height: 11px;
		color: #A7AFB9;
		font-weight: 600;
	}

	/* 收藏表情网格 */
	.sticker-grid {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.sticker-item-add {
		width: 25%;
		height: 85px;
		justify-content: center;
		align-items: center;
	}

	.sticker-item-manage {
		width: 25%;
		height: 85px;
		justify-content: center;
		align-items: center;
	}

	.sticker-add-icon {
		font-size: 30px;
		color: #8F959E;
		background-color: #FFFFFF;
		width: 65px;
		height: 65px;
		border-radius: 8px;
		text-align: center;
		line-height: 65px;
		border-width: 1px;
		border-color: #E5E5E5;
		border-style: dashed;
	}

	.sticker-manage-text {
		font-size: 14px;
		color: #8F959E;
		background-color: #FFFFFF;
		width: 65px;
		height: 65px;
		border-radius: 8px;
		text-align: center;
		line-height: 65px;
		border-width: 1px;
		border-color: #E5E5E5;
		border-style: solid;
	}

	.sticker-item {
		width: 25%;
		height: 85px;
		justify-content: center;
		align-items: center;
	}

	.picker-sticker-img {
		width: 65px;
		height: 65px;
		border-radius: 8px;
		background-color: #FFFFFF;
	}

	.emoji-icon {
		font-size: 28px;
	}

	.emoji-tabs {
		height: 44px;
		background-color: #FFFFFF;
		flex-direction: row;
		align-items: center;
		padding: 0 8px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: rgba(31, 35, 41, 0.04);
	}

	.emoji-tab-item {
		width: 44px;
		height: 32px;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
		margin-right: 6px;
		border-bottom-width: 2px;
		border-bottom-style: solid;
		border-bottom-color: transparent;
	}

	.emoji-tab-active {
		background-color: #F1F3F5;
		border-bottom-color: #07C160;
	}

	.emoji-tab-icon {
		font-size: 20px;
		color: #A7AFB9;
	}

	.emoji-tab-icon-active {
		color: #616A74;
	}

	/* 录音浮层 */
	.recording-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		justify-content: center;
		align-items: center;
		z-index: 999;
	}

	.recording-card {
		width: 164px;
		height: 172px;
		background-color: rgba(0, 0, 0, 0.7);
		border-radius: 12px;
		justify-content: center;
		align-items: center;
	}

	.recording-card-cancel {
		background-color: rgba(245, 74, 69, 0.8);
	}

	.recording-icon {
		font-size: 60px;
		color: #FFFFFF;
		margin-bottom: 6px;
	}

	.recording-duration {
		font-size: 16px;
		font-weight: 600;
		color: #FFFFFF;
		margin-bottom: 8px;
	}

	.recording-duration-warning {
		color: #FFE58F;
	}

	.recording-wave {
		height: 28px;
		flex-direction: row;
		align-items: flex-end;
		justify-content: center;
		margin-bottom: 10px;
	}

	.recording-wave-bar {
		width: 4px;
		min-height: 6px;
		margin: 0 2px;
		background-color: #FFFFFF;
		border-radius: 2px;
	}

	.recording-card-cancel .recording-wave-bar {
		background-color: #FFE9E8;
	}

	.recording-text {
		font-size: 14px;
		color: #FFFFFF;
		padding: 0 10px;
		text-align: center;
	}

	/* 多选模式底部工具栏 */
	.multi-select-toolbar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		height: 60px;
		background-color: #FFFFFF;
		border-top-width: 1px;
