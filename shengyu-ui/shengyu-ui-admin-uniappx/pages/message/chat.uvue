	/**
	 * 仿微信聊天时间线显示逻辑
	 */
	function formatChatTime(timestamp : number, lastTimestamp : number = 0) : string {
		// 如果两条消息间隔小于5分钟，不显示时间
		if (lastTimestamp > 0 && timestamp - lastTimestamp < 5 * 60 * 1000) {
			return ''
		}

		const date = new Date(timestamp)
		const now = new Date()
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')

		if (isToday) {
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return `昨天 ${hours}:${minutes}`
		}
		
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return `${weekDays[date.getDay()]} ${hours}:${minutes}`
		}
		
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}月${day}日 ${hours}:${minutes}`
		}
		return `${year}年${month}月${day}日 ${hours}:${minutes}`
	}


	const featureList = [
		{ icon: '\ue608', color: '#3370FF', nameKey: 'chat.features.album' },
		{ icon: '\uea87', color: '#3370FF', nameKey: 'chat.features.camera' },
		{ icon: '\uea72', color: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', color: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\ue624', color: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', color: '#FFB347', nameKey: 'chat.features.fav' }
	]

	function handleBack() {
		uni.navigateBack()
	}

	function toggleInputMode() {
		isVoiceMode.value = !isVoiceMode.value
		if (isVoiceMode.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function toggleEmojiMenu() {
		showEmojiMenu.value = !showEmojiMenu.value
		showPlusMenu.value = false
		isVoiceMode.value = false
	}

	function togglePlusMenu() {
		showPlusMenu.value = !showPlusMenu.value
		showEmojiMenu.value = false
		isVoiceMode.value = false
	}

	function toggleFullExpand() {
		isFullExpanded.value = !isFullExpanded.value
		if (isFullExpanded.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function onEditorReady() {
		uni.createSelectorQuery().select('#editor').context((res) => {
			editorCtx = res.context as EditorContext
		}).exec()
	}

	function onEditorInput(e : any) {
		// e.detail.text 包含纯文本
		// e.detail.html 包含富文本
		const text = e.detail.text
		const html = e.detail.html
		
		// 启发式判断行数：
		// 1. 是否有物理换行符
		// 2. 文本长度是否超过一行（根据屏幕宽度，通常 22-25 个字符左右换行）
		// 3. HTML 中是否有多个段落标签
		const hasNewLine = text.includes('\n')
		const isLongText = text.trim().length > 22
		const hasMultipleParagraphs = (html.match(/<p>/g) || []).length > 1 || html.includes('<br>')
		
		isMultiLine.value = hasNewLine || isLongText || hasMultipleParagraphs

		if (text.trim().length > 0 || html.includes('<img')) {
			inputText.value = 'has_content'
		} else {
			inputText.value = ''
			isMultiLine.value = false // 清空时恢复单行
		}
	}

	function handleInputFocus() {
		showEmojiMenu.value = false
		showPlusMenu.value = false
		scrollToBottom()
	}

	function handleVoiceStart(e : TouchEvent) {
		recordStartY.value = e.touches[0].pageY
		isRecording.value = true
		isCancelReady.value = false
		// 模拟请求权限并开始录音
		console.log('开始录音，检查权限：RECORD_AUDIO')
	}

	function handleVoiceMove(e : TouchEvent) {
		const currentY = e.touches[0].pageY
		if (recordStartY.value - currentY > 60) {
			isCancelReady.value = true
		} else {
			isCancelReady.value = false
		}
	}

	/**
	 * 创建消息对象 (适配后端接口对接)
	 */
	function createMessage(params : any) : MessageItem {
		return {
			id: Date.now().toString() + Math.random().toString(36).substring(2, 7),
			senderId: params.isSelf ? 'me' : 'user1',
			receiverId: params.isSelf ? 'user1' : 'me',
			type: params.type,
			content: params.content,
			isSelf: params.isSelf,
			time: new Date().toLocaleString(),
			timestamp: Date.now(),
			showTime: false,
			avatarText: params.isSelf ? '我' : '三',
			avatarBg: params.isSelf ? '#5FB6F7' : '#F197BC',
			duration: params.duration,
			poster: params.poster,
			fileName: params.fileName,
			fileSize: params.fileSize,
			address: params.address,
			isSticker: params.isSticker,
			status: 'success'
		} as MessageItem
	}

	function handleVoiceEnd() {
		if (isCancelReady.value) {
			console.log('取消录音')
		} else {
			console.log('录音结束，发送语音')
			messages.value.push(createMessage({
				type: 'voice',
				content: 'mock_voice_url',
				duration: Math.floor(Math.random() * 58) + 2,
				isSelf: true
			}))
			scrollToBottom()
		}
		isRecording.value = false
		isCancelReady.value = false
	}

	function handleEmojiClick(item : any) {
		if (editorCtx != null) {
			editorCtx!.insertImage({
				src: item.path,
				alt: item.code,
				data: {
					code: item.code
				},
				width: '24px',
				height: '24px',
				success: () => {
					console.log('插入表情成功:', item.code)
				}
			})
		}
	}

	/**
	 * 处理输入，实现表情包整体退格
	 */
	function handleInput(e : InputEvent) {
		const newVal = e.detail.value
		const oldVal = lastInputText.value
		
		// 检查是否是退格删除操作 (新长度小于旧长度)
		if (newVal.length < oldVal.length) {
			const diffIndex = newVal.length
			// 如果删除的是 ']'，尝试向前寻找匹配的 '['
			if (oldVal[diffIndex] === ']') {
				const lastLeftBracket = oldVal.lastIndexOf('[', diffIndex)
				if (lastLeftBracket !== -1) {
					// 提取可能的表情代码 [xxx]
					const potentialCode = oldVal.substring(lastLeftBracket, diffIndex + 1)
					// 验证是否是合法的表情代码
					const regex = /^\[[\u4e00-\u9fa5\w]+\]$/
					if (regex.test(potentialCode)) {
						// 整体删除 [xxx]
						inputText.value = oldVal.substring(0, lastLeftBracket) + oldVal.substring(diffIndex + 1)
					}
				}
			}
		}
		
		lastInputText.value = inputText.value
	}

	function handleStickerClick(item : StickerItem) {
		messages.value.push(createMessage({
			type: 'sticker',
			content: item.url,
			isSelf: true,
			isSticker: true
		}))
		scrollToBottom()
		showEmojiMenu.value = false
	}

	function handleToSettings() {
		uni.navigateTo({
			url: '/pages/message/chat-settings'
		})
	}

	function handleSend() {
		if (editorCtx == null) return
		
		editorCtx!.getContents({
			success: (res) => {
				let content = res.html
				if (!content || content === '<p><br></p>') return
				
				// 将 <img src="..." alt="[表情]" ...> 替换回 [表情]
				const imgReg = /<img [^>]*alt=['"]([^'"]+)['"][^>]*>/g
				let finalContent = content.replace(imgReg, '$1')
				
				// 去除 HTML 标签
				finalContent = finalContent.replace(/<[^>]+>/g, '')
				
				if (!finalContent.trim()) return
				
				messages.value.push(createMessage({
					type: 'text',
					content: finalContent,
					isSelf: true
				}))
				
				// 清空编辑器
				editorCtx!.clear({
					success: () => {
						inputText.value = ''
						isFullExpanded.value = false
						scrollToBottom()
					}
				})
			}
		})
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		if (item.nameKey === 'chat.features.album') {
			uni.chooseImage({
				count: 9,
				sourceType: ['album'],
				success: (res) => {
					const tempFilePaths = res.tempFilePaths
					tempFilePaths.forEach((path : string) => {
						messages.value.push(createMessage({
							type: 'image',
							content: path,
							isSelf: true
						}))
					})
					showPlusMenu.value = false
					scrollToBottom()
				},
				fail: (err) => {
					console.error('选择相册失败:', err)
				}
			})
			return
		}
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}

	function handleImagePreview(url : string) {
		uni.previewImage({
			urls: [url]
		})
	}

	function handleVideoPlay(url : string) {
		// 这里简单处理为全屏预览视频
		uni.showToast({
			title: '播放视频: ' + url,
			icon: 'none'
		})
	}

    function openMsgMenu(msg : MessageItem, e : TouchEvent) {
        selectedMsg.value = msg
        
        // 优先使用 touchstart 记录的坐标，如果没有则使用 longpress 事件的坐标
        const x = touchStartX.value || (e.touches.length > 0 ? e.touches[0].clientX : 0)
        const y = touchStartY.value || (e.touches.length > 0 ? e.touches[0].clientY : 0)
        
        const systemInfo = uni.getSystemInfoSync()
        const screenWidth = systemInfo.screenWidth
        const screenHeight = systemInfo.screenHeight
        const statusBarHeight = systemInfo.statusBarHeight || 0
        
        // 根据消息类型确定菜单项
        const isRestricted = msg.type === 'voice' || msg.type === 'location'
        currentMenuItems.value = isRestricted
            ? [
                { key: 'quote', labelKey: 'chat.menu.quote', icon: '\ue6f4' },
                { key: 'delete', labelKey: 'chat.menu.delete', icon: '\ue602' }
              ]
            : [
                { key: 'copy', labelKey: 'chat.menu.copy', icon: '\ue7cb' },
                { key: 'forward', labelKey: 'chat.menu.forward', icon: '\ue63d' },
                { key: 'delete', labelKey: 'chat.menu.delete', icon: '\ue602' },
                { key: 'favorite', labelKey: 'chat.menu.favorite', icon: '\ue83f' },
                { key: 'multi', labelKey: 'chat.menu.multi', icon: '\ue69d' },
                { key: 'quote', labelKey: 'chat.menu.quote', icon: '\ue6f4' }
              ]
        
        // 菜单尺寸（横向排列，支持换行）
        const menuItemWidth = 70 // 每个菜单项宽度
        const menuItemHeight = 70 // 每个菜单项高度（增加以容纳图标+文字）
        const maxMenuWidth = screenWidth - 20 // 最大宽度，左右各留10px边距
        const itemsPerRow = Math.floor(maxMenuWidth / menuItemWidth) // 每行最多显示的菜单项数
        const actualItemsPerRow = Math.min(itemsPerRow, currentMenuItems.value.length) // 实际每行显示数
        const menuWidth = actualItemsPerRow * menuItemWidth
        const rows = Math.ceil(currentMenuItems.value.length / actualItemsPerRow) // 总行数
        const menuHeight = rows * menuItemHeight
        
        // 头部高度：状态栏 + 导航栏(44px)
        const headerHeight = statusBarHeight + 44
        // 底部输入区域高度（估算）
        const footerHeight = 120
        
        // 可用区域
        const availableTop = headerHeight + 10 // 留10px边距
        const availableBottom = screenHeight - footerHeight - 10
        const availableLeft = 10
        const availableRight = screenWidth - menuWidth - 10
        
        // 水平定位：优先显示在触摸点附近，但不超出屏幕
        let finalX = x - menuWidth / 2 // 默认居中对齐触摸点
        if (finalX < availableLeft) {
            finalX = availableLeft
        } else if (finalX > availableRight) {
            finalX = availableRight
        }
        
        // 垂直定位：优先显示在触摸点上方，如果上方空间不足则显示在下方
        let finalY = y - menuHeight - 10 // 默认显示在上方，留10px间距
        
        if (finalY < availableTop) {
            // 上方空间不足，显示在下方
            finalY = y + 10
            
            // 如果下方也不够，则尽量显示在可用区域内
            if (finalY + menuHeight > availableBottom) {
                finalY = availableBottom - menuHeight
                // 如果还是不够，则显示在触摸点居中位置
                if (finalY < availableTop) {
                    finalY = y - menuHeight / 2
                    // 最后保底：确保不超出边界
                    if (finalY < availableTop) finalY = availableTop
                    if (finalY + menuHeight > availableBottom) finalY = availableBottom - menuHeight
                }
            }
        }
        
        menuX.value = finalX
        menuY.value = finalY
        showMsgMenu.value = true
        
        // 添加淡入动画
        menuOpacity.value = 0
        setTimeout(() => {
            menuOpacity.value = 1
        }, 10)
    }

    function recordTouchStart(e : TouchEvent) {
        if (e.touches.length > 0) {
            touchStartX.value = e.touches[0].clientX
            touchStartY.value = e.touches[0].clientY
        }
    }

    function closeMsgMenu() {
        menuOpacity.value = 0
        setTimeout(() => {
            showMsgMenu.value = false
        }, 150)
    }

    function handleMenuAction(action : string) {
        if (selectedMsg.value == null) return
        const msg = selectedMsg.value
        if (action === 'copy') {
            if (msg.type === 'text') {
                uni.setClipboardData({ data: msg.content })
            } else {
                uni.showToast({ title: t('chat.menu.copy'), icon: 'none' })
            }
        } else if (action === 'forward') {
            uni.showToast({ title: t('chat.menu.forward'), icon: 'none' })
        } else if (action === 'delete') {
            const idx = messages.value.findIndex(m => m.id === msg.id)
            if (idx > -1) messages.value.splice(idx, 1)
        } else if (action === 'favorite') {
            if (msg.type !== 'voice' && msg.type !== 'location') {
                stickerList.value.unshift({ id: Date.now().toString(), url: msg.content })
            }
            uni.showToast({ title: t('chat.menu.favorite'), icon: 'none' })
        } else if (action === 'multi') {
            multiSelectMode.value = true
            // 延迟滚动，等待布局更新
            setTimeout(() => {
                scrollToBottom()
            }, 100)
        } else if (action === 'quote') {
            if (editorCtx != null) {
                editorCtx!.insertText({ text: `"${msg.type === 'text' ? msg.content : t('chat.menu.quote')}" ` })
                inputText.value = 'has_content'
            }
        }
        closeMsgMenu()
    }

    function toggleSelect(msg : MessageItem) {
        const idx = selectedIds.value.indexOf(msg.id)
        if (idx > -1) {
            selectedIds.value.splice(idx, 1)
        } else {
            selectedIds.value.push(msg.id)
        }
    }

    function handleBubbleClick(msg : MessageItem) {
        if (multiSelectMode.value) {
            toggleSelect(msg)
        }
    }

    function exitMultiSelectMode() {
        multiSelectMode.value = false
        selectedIds.value = []
        // 延迟滚动，等待布局更新
        setTimeout(() => {
            scrollToBottom()
        }, 100)
    }

    function handleMultiForward() {
        if (selectedIds.value.length === 0) {
            uni.showToast({ title: '请选择要转发的消息', icon: 'none' })
            return
        }
        uni.showToast({ title: `转发 ${selectedIds.value.length} 条消息`, icon: 'none' })
        // TODO: 实现转发逻辑
    }

    function handleMultiDelete() {
        if (selectedIds.value.length === 0) {
            uni.showToast({ title: '请选择要删除的消息', icon: 'none' })
            return
        }
        uni.showModal({
            title: '提示',
            content: `确定删除选中的 ${selectedIds.value.length} 条消息吗？`,
            success: (res) => {
                if (res.confirm) {
                    // 删除选中的消息
                    messages.value = messages.value.filter(m => !selectedIds.value.includes(m.id))
                    exitMultiSelectMode()
                    uni.showToast({ title: '删除成功', icon: 'success' })
                }
            }
        })
    }

	/**
	 * 计算语音气泡宽度 (仿微信：最短 60px，最长 220px，线性增长)
	 */
	function getVoiceBubbleWidth(duration : number) : string {
		const minWidth = 60
		const maxWidth = 220
		const maxDuration = 60 // 假设最长语音为 60 秒
		
		// 基础宽度 + (时长比例 * 可增长空间)
		let width = minWidth + (duration / maxDuration) * (maxWidth - minWidth)
		
		// 边界限制
		if (width > maxWidth) width = maxWidth
		if (width < minWidth) width = minWidth
		
		return `${width}px`
	}

	function handleVoicePlay(msg : any) {
		if (!msg.isSelf) {
			msg.isRead = true
		}
		uni.showToast({
			title: '正在播放语音...',
			icon: 'none'
		})
	}

	function scrollToBottom() {
		setTimeout(() => {
			lastMessageId.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	onMounted(() => {
		scrollToBottom()
	})
</script>

<style>
	/* 页面基础样式 */
