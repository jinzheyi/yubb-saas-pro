	/**
	 * 初始化页面
	 */
	onMounted(async () => {
		// 1. 获取当前用户信息
		currentUserId.value = getUserIdStr()
		currentTenantId.value = getTenantId() || '0'
		
		// 2. 设置消息服务的当前用户
		messageService.setCurrentUser(currentUserId.value, currentTenantId.value)
		
		// 3. 如果没有 chatId 但有 groupId/targetId，则查询会话
		if ((!chatId.value || chatId.value === '' || chatId.value === '0') && 
		    targetId.value && targetId.value !== '') {
			try {
				console.log('[Chat] 没有 chatId，查询会话, targetId:', targetId.value, 'type:', chatType.value)
				const conversationType = chatType.value === 'group' ? 2 : 1
				const conversationResult = await getConversationByTarget(targetId.value, conversationType)
				
				const resolvedChatId = conversationResult && (conversationResult.chatId != null ? conversationResult.chatId : conversationResult.id)
				if (resolvedChatId != null) {
					chatId.value = resolvedChatId.toString()
					console.log('[Chat] 查询会话成功, chatId:', chatId.value)
				} else {
					console.error('[Chat] 查询会话失败：返回数据无效', conversationResult)
				}
			} catch (e) {
				console.error('[Chat] 查询会话失败:', e)
				uni.showToast({
					title: '获取会话失败',
					icon: 'none'
				})
			}
		}
		
		// 4. 标记当前活跃会话（用于重连补偿只补活跃/未读会话）
		try {
			if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
				messageService.setActiveChatId(chatId.value)
			}
		} catch (e) {
			// ignore
		}

		await hydrateConversationMetaByChatId()
		await ensureInitialMessagesLoaded()
		
		// 5. 监听新消息
		messageService.addMessageListener(handleNewMessage)
		messageService.addMessageStatusListener(handleMessageStatusChange)
		
		// 6. 清空未读数（本地 + 服务端：按 sequence 水位上报）
		if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
			const maxSeq = await computeMaxSeqForRead()
			// 调用 BadgeService 清空会话角标
			// BadgeService 会自动调用后端 API 并更新本地数据
			badgeService.clearConversationBadge(chatId.value, maxSeq)
			
			// 同时清空 MessageService 的本地未读数
			messageService.clearUnreadCount(chatId.value)
		}
		
		initVisibleReadObserver()
		startReeditTicker()
		scrollToBottom()
	})
	
	onUnmounted(async () => {
		await flushReadOnLeave()
		destroyVisibleReadObserver()
		stopReeditTicker()
		// 移除消息监听器
		messageService.removeMessageListener(handleNewMessage)
		try {
			messageService.setActiveChatId(null)
		} catch (e) {
			// ignore
		}
	})

	let lastFlushedSeq: string = ''
	let lastFlushedAt: number = 0
	let flushInFlight: boolean = false

	const isAtBottom = ref(true)
	let lastScrollTop = 0
	let lastScrollAt = 0
	let visibleObserver: UniIntersectionObserver | null = null
	let visibleObserverWatching: boolean = false
	let visibleReadMaxSeq: string = '0'
	let serverReadDebounceTimer: any = null
	let serverReadPendingSeq: string = '0'
	let serverReadLastSentSeq: string = '0'
	const SERVER_READ_DEBOUNCE_MS = 800
	let visibleObserveRetryTimer: any = null
	let visibleObserveRetryCount: number = 0
	const VISIBLE_OBSERVE_MAX_RETRY: number = 10

	function compareSeqLocal(a: string, b: string): number {
		const as = a != null && a !== '' ? a : '0'
		const bs = b != null && b !== '' ? b : '0'
		try {
			const ai = BigInt(as)
			const bi = BigInt(bs)
			if (ai === bi) return 0
			return ai > bi ? 1 : -1
		} catch (e) {
			if (as === bs) return 0
			return as > bs ? 1 : -1
		}
	}

	function scheduleServerReadAdvance(seq: string): void {
		try {
			const s = seq != null && seq !== '' ? seq.toString() : '0'
			if (compareSeqLocal(s, serverReadPendingSeq) > 0) {
				serverReadPendingSeq = s
			}
			if (serverReadDebounceTimer != null) {
				clearTimeout(serverReadDebounceTimer)
				serverReadDebounceTimer = null
			}
			serverReadDebounceTimer = setTimeout(() => {
				try {
					if (!chatId.value || chatId.value === '' || chatId.value === '0') {
						return
					}
					const pending = serverReadPendingSeq
					if (compareSeqLocal(pending, serverReadLastSentSeq) <= 0) {
						return
					}
					serverReadLastSentSeq = pending
					badgeService.clearConversationBadge(chatId.value, pending)
				} catch (e) {
					// ignore
				}
			}, SERVER_READ_DEBOUNCE_MS)
		} catch (e) {
			// ignore
		}
	}

	function applyVisibleReadAdvance(seq: string): void {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			const s = seq != null && seq !== '' ? seq.toString() : '0'
			if (s === '0') {
				return
			}
			if (compareSeqLocal(s, visibleReadMaxSeq) <= 0) {
				return
			}
			visibleReadMaxSeq = s
			try {
				import('../../services/conversation-service.uts').then((convServiceModule) => {
					try {
						const cs = (convServiceModule as any).conversationService
						if (cs == null) {
							return
						}
						cs.applyReadWatermark(chatId.value, s)
					} catch (e) {
						// ignore
					}
				}).catch((_e: any) => {
					// ignore
				})
			} catch (e) {
				// ignore
			}
			try {
				badgeService.clearConversationBadgeLocal(chatId.value)
			} catch (e) {
				// ignore
			}
			scheduleServerReadAdvance(s)
		} catch (e) {
			// ignore
		}
	}

	function initVisibleReadObserver(): void {
		try {
			if (visibleObserver != null) {
				return
			}
			const inst = getCurrentInstance()
			const ctx = inst != null ? (inst as any).proxy : null
			if (ctx == null) {
				return
			}
			visibleObserver = uni.createIntersectionObserver(ctx)
			visibleObserver!.relativeTo('.chat-content', { top: '0px', bottom: '0px' })
			startVisibleReadObserve(ctx)
		} catch (e) {
			visibleObserver = null
		}
	}

	function startVisibleReadObserve(ctx: any): void {
		try {
			if (visibleObserver == null) {
				return
			}
			if (visibleObserverWatching) {
				return
			}
			if (visibleObserveRetryTimer != null) {
				clearTimeout(visibleObserveRetryTimer)
				visibleObserveRetryTimer = null
			}
			uni.nextTick(() => {
				try {
					if (visibleObserver == null) {
						return
					}
					const query = uni.createSelectorQuery().in(ctx)
					query.selectAll('.read-observe-item').boundingClientRect((rects: any) => {
						try {
							const arr = rects as any[]
							if (arr == null || arr.length <= 0) {
								if (visibleObserveRetryCount < VISIBLE_OBSERVE_MAX_RETRY) {
									visibleObserveRetryCount = visibleObserveRetryCount + 1
									visibleObserveRetryTimer = setTimeout(() => {
										visibleObserveRetryTimer = null
										startVisibleReadObserve(ctx)
									}, 120)
								}
								return
							}
							visibleObserveRetryCount = 0
							visibleObserverWatching = true
							visibleObserver!.observe('.read-observe-item', (res) => {
								try {
									if (res == null || (res as any).intersectionRatio == null) {
										return
									}
									const ratio = Number((res as any).intersectionRatio)
									if (ratio < 0.5) {
										return
									}
									const now = Date.now()
									if (now - lastScrollAt < 120) {
										return
									}
									const dataset = (res as any).dataset as UTSJSONObject
									const selfFlag = dataset != null ? (dataset['self'] as any) : null
									if (selfFlag != null && selfFlag.toString() === '1') {
										return
									}
									const seq = dataset != null ? (dataset['seq'] as any) : null
									const s = seq != null ? seq.toString() : '0'
									applyVisibleReadAdvance(s)
								} catch (e) {
									// ignore
								}
							})
						} catch (e) {
							// ignore
						}
					}).exec()
				} catch (e) {
					// ignore
				}
			})
		} catch (e) {
			// ignore
		}
	}

	function destroyVisibleReadObserver(): void {
		try {
			if (visibleObserveRetryTimer != null) {
				clearTimeout(visibleObserveRetryTimer)
				visibleObserveRetryTimer = null
			}
			if (visibleObserver != null) {
				visibleObserver!.disconnect()
				visibleObserver = null
				visibleObserverWatching = false
			}
		} catch (e) {
			visibleObserver = null
			visibleObserverWatching = false
		}
	}

	async function computeMaxSeqForRead(): Promise<string> {
		let maxSeq = '0'
		// 优先使用会话服务里的权威 lastMessageSequence（通常来源于 sync/list）
		try {
			const convServiceModule = await import('../../services/conversation-service.uts')
			const cs = (convServiceModule as any).conversationService
			const conv = cs != null ? cs.getConversation(chatId.value) : null
			const seqFromConv = conv != null && (conv as any).lastMessageSequence != null
				? (conv as any).lastMessageSequence.toString()
				: '0'
			if (seqFromConv != null && seqFromConv !== '' && seqFromConv !== '0') {
				maxSeq = seqFromConv
			}
		} catch (e) {
			// ignore
		}
		// 兜底：使用当前页面已加载的消息列表的最大 sequence（比 messageService 缓存更可靠）
		try {
			for (let i = 0; i < messages.value.length; i++) {
				const s = (messages.value[i] as any).sequence
				if (s == null || s === '') {
					continue
				}
				try {
					if (BigInt(s) > BigInt(maxSeq)) {
						maxSeq = s
					}
				} catch (e) {
					if (s > maxSeq) {
						maxSeq = s
					}
				}
			}
		} catch (e) {
			// ignore
		}
		// 最后兜底：仍使用 messageService 缓存（可能为空）
		if (maxSeq === '0') {
			try {
				const localMsgs = messageService.getMessages(chatId.value)
				for (let i = 0; i < localMsgs.length; i++) {
					const s = (localMsgs[i] as any).sequence
					if (s == null || s === '') {
						continue
					}
					try {
						if (BigInt(s) > BigInt(maxSeq)) {
							maxSeq = s
						}
					} catch (e) {
						if (s > maxSeq) {
							maxSeq = s
						}
					}
				}
			} catch (e) {
				maxSeq = '0'
			}
		}
		return maxSeq
	}

	async function flushReadOnLeave(): Promise<void> {
		try {
			if (!chatId.value || chatId.value === '' || chatId.value === '0') {
				return
			}
			if (flushInFlight) {
				return
			}
			const maxSeq = await computeMaxSeqForRead()
			let localUnread = 0
			try {
				localUnread = badgeService.getConversationBadge(chatId.value)
			} catch (e) {
				localUnread = 0
			}
			const now = Date.now()
			if (localUnread <= 0 && maxSeq != null && maxSeq !== '' && maxSeq === lastFlushedSeq && (now - lastFlushedAt) < 1000) {
				return
			}
			flushInFlight = true
			lastFlushedSeq = maxSeq
			lastFlushedAt = now
			badgeService.clearConversationBadge(chatId.value, maxSeq)
			messageService.clearUnreadCount(chatId.value)
		} catch (e) {
			// ignore
		} finally {
			flushInFlight = false
		}
	}

	/**
	 * 仿微信聊天时间线显示逻辑
	 */
	function formatChatTime(timestamp : number, lastTimestamp : number = 0) : string {
		// 如果两条消息间隔小于5分钟，不显示时间
		if (lastTimestamp > 0 && timestamp - lastTimestamp < 5 * 60 * 1000) {
			return ''
		}

		const date = new Date(timestamp)
		const now = new Date()
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')

		if (isToday) {
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return `昨天 ${hours}:${minutes}`
		}
		
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return `${weekDays[date.getDay()]} ${hours}:${minutes}`
		}
		
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}月${day}日 ${hours}:${minutes}`
		}
		return `${year}年${month}月${day}日 ${hours}:${minutes}`
	}

	function getFileExt(name : string) : string {
		if (!name) {
			return ''
		}
		const idx = name.lastIndexOf('.')
		if (idx < 0) {
			return ''
		}
		return name.substring(idx + 1).toLowerCase()
	}

	function getFileExtFromUrl(url : string) : string {
		if (!url) {
			return ''
		}
		let cleanUrl = url
		const q = cleanUrl.indexOf('?')
		if (q >= 0) {
			cleanUrl = cleanUrl.substring(0, q)
		}
		const hash = cleanUrl.indexOf('#')
		if (hash >= 0) {
			cleanUrl = cleanUrl.substring(0, hash)
		}
		const slash = cleanUrl.lastIndexOf('/')
		if (slash >= 0) {
			cleanUrl = cleanUrl.substring(slash + 1)
		}
		return getFileExt(cleanUrl)
	}

	function isImageExt(ext : string) : boolean {
		return ['png', 'jpg', 'jpeg', 'gif', 'webp', 'bmp', 'svg'].includes(ext)
	}

	function isVideoExt(ext : string) : boolean {
		return ['mp4', 'mov', 'avi', 'mkv', 'webm', 'm4v', '3gp'].includes(ext)
	}

	function isAudioExt(ext : string) : boolean {
		return ['mp3', 'wav', 'aac', 'm4a', 'ogg', 'flac'].includes(ext)
	}

	function isZipExt(ext : string) : boolean {
		return ['zip', 'rar', '7z', 'tar', 'gz', 'bz2', 'xz'].includes(ext)
	}

	function isWordExt(ext : string) : boolean {
		return ['doc', 'docx', 'dot', 'dotx'].includes(ext)
	}

	function isExcelExt(ext : string) : boolean {
		return ['xls', 'xlsx', 'csv'].includes(ext)
	}

	function isPptExt(ext : string) : boolean {
		return ['ppt', 'pptx', 'pps', 'ppsx'].includes(ext)
	}

	function isTextExt(ext : string) : boolean {
		return ['txt', 'log', 'md', 'json', 'xml', 'yml', 'yaml', 'ini', 'conf'].includes(ext)
	}

	function getFileIconUnicode(msg : MessageItem) : string {
		// iconfont.json 对应的 unicode：
		// html=e609, sql=e69b, text=e603, excel=e6a4, ppt=e6a5, video=e6a6, image=e6a7,
		// unknown=e6a8, zip=e6a9, pdf=e6aa, word=e6ab, music=e6ac, folder=e6ad
		const name = msg.fileName || ''
		const mime = (msg as any).mimeType ? String((msg as any).mimeType) : ''
		let ext = getFileExt(name)

		// 开发阶段强约束：不再从 URL 推断 ext，FILE 消息必须携带 fileName/mimeType

		// 优先 mimeType 兜底（避免 ext 解析/混合 content 场景误判）
		if (mime) {
			const lowerMime = mime.toLowerCase()
			if (lowerMime.includes('ms-excel') || lowerMime.includes('spreadsheetml')) {
				return '\ue6a4'
			}
			if (lowerMime.includes('msword') || lowerMime.includes('wordprocessingml')) {
				return '\ue6ab'
			}
			if (lowerMime.includes('ms-powerpoint') || lowerMime.includes('presentationml')) {
				return '\ue6a5'
			}
			if (lowerMime === 'application/pdf') {
				return '\ue60c'
			}
		}

		if (mime.startsWith('image/')) {
			return '\ue606'
		}
		if (mime.startsWith('video/')) {
			return '\ue605'
		}
		if (mime.startsWith('audio/')) {
			return '\ue6ac'
		}

		if (ext === 'html' || ext === 'htm') {
			return '\ue609'
		}
		if (ext === 'sql') {
			return '\ue69b'
		}
		if (ext === 'pdf') {
			return '\ue60c'
		}
		if (isWordExt(ext)) {
			return '\ue6ab'
		}
		if (isExcelExt(ext)) {
			return '\ue6a4'
		}
		if (isPptExt(ext)) {
			return '\ue6a5'
		}
		if (isVideoExt(ext)) {
			return '\ue605'
		}
		if (isImageExt(ext)) {
			return '\ue606'
		}
		if (isAudioExt(ext)) {
			return '\ue6ac'
		}
		if (isZipExt(ext)) {
			return '\ue6d6'
		}
		if (isTextExt(ext)) {
			return '\ue854'
		}

		return '\ue603'
	}

	function getFileIconColor(msg : MessageItem) : string {
		const name = msg.fileName || ''
		const mime = (msg as any).mimeType ? String((msg as any).mimeType) : ''
		const ext = getFileExt(name)
		const lowerMime = mime ? mime.toLowerCase() : ''

		if (lowerMime.includes('ms-excel') || lowerMime.includes('spreadsheetml') || isExcelExt(ext)) {
			return '#34C759'
		}
		if (lowerMime.includes('msword') || lowerMime.includes('wordprocessingml') || isWordExt(ext)) {
			return '#3370FF'
		}
		if (lowerMime.includes('ms-powerpoint') || lowerMime.includes('presentationml') || isPptExt(ext)) {
			return '#FF9500'
		}
		if (lowerMime === 'application/pdf' || ext === 'pdf') {
			return '#F54A45'
		}
		if (mime.startsWith('image/') || isImageExt(ext)) {
			return '#FFB020'
		}
		if (mime.startsWith('video/') || isVideoExt(ext)) {
			return '#8A5CF6'
		}
		if (mime.startsWith('audio/') || isAudioExt(ext)) {
			return '#FF9500'
		}
		if (isZipExt(ext)) {
			return '#586c76'
		}
		if (ext === 'html' || ext === 'htm') {
			return '#FF6A00'
		}
		if (ext === 'sql') {
			return '#8F959E'
		}
		if (isTextExt(ext)) {
			return '#4A90E2'
		}
		return '#C7CBD1'
	}

	function getFileNameFromMixedContent(content : any) : string {
		if (content === null) {
			return ''
		}
		// REST 历史消息可能直接存字符串：
		// 1) "http://.../xxx.pdf"
		// 2) "http://.../ 何肖肖入职offfer.pdf"（中间有空格）
		const raw = String(content)
		const trimmed = raw.trim()
		if (!trimmed) {
			return ''
		}
		// 如果包含空格，优先取最后一段作为文件名
		const parts = trimmed.split(' ').filter(p => !!p)
		const lastPart = parts.length > 1 ? parts[parts.length - 1] : trimmed
		// 尝试从 URL 截取
		let urlPart = parts.length > 1 ? parts[0] : trimmed
		// 如果 lastPart 本身就是一个 URL（极端情况），则直接走 URL 解析
		if (lastPart.startsWith('http://') || lastPart.startsWith('https://')) {
			urlPart = lastPart
		}
		let candidate = lastPart
		if (candidate.startsWith('http://') || candidate.startsWith('https://')) {
			// url 里取最后 path segment
			let cleanUrl = candidate
			const q = cleanUrl.indexOf('?')
			if (q >= 0) cleanUrl = cleanUrl.substring(0, q)
			const hash = cleanUrl.indexOf('#')
			if (hash >= 0) cleanUrl = cleanUrl.substring(0, hash)
			const slash = cleanUrl.lastIndexOf('/')
			candidate = slash >= 0 ? cleanUrl.substring(slash + 1) : cleanUrl
		} else if (urlPart.startsWith('http://') || urlPart.startsWith('https://')) {
			// url + 文件名 混合场景，candidate 就是文件名
		}
		try {
			candidate = decodeURIComponent(candidate)
		} catch (e) {
			// ignore
		}
		return candidate
	}

	function getFileUrlFromMixedContent(content : any) : string {
		if (content === null) {
			return ''
		}
		const raw = String(content).trim()
		if (!raw) {
			return ''
		}
		// url + 文件名 混合场景：取第一个 token 作为 url
		const parts = raw.split(' ').filter(p => !!p)
		const candidate = parts.length > 1 ? parts[0] : raw
		if (candidate.startsWith('http://') || candidate.startsWith('https://')) {
			return candidate
		}
		return raw
	}

	function applyFileFields(uiMessage : MessageItem, rawContent : any) {
		if (uiMessage.type !== 'file') {
			return
		}
		// rawContent 可能是对象（ws/body 或后端存 json），也可能是字符串
		let fileName = ''
		let sizeNum : number | null = null
		let mimeType = ''
		if (rawContent && typeof rawContent === 'object') {
			fileName = rawContent.fileName || rawContent.name || ''
			// size 可能是 number 或 string
			if (rawContent.size !== null) {
				const n = Number(rawContent.size)
				sizeNum = isNaN(n) ? null : n
			}
			mimeType = rawContent.fileType || rawContent.mimeType || ''
		} else {
			console.error('[Chat] FILE 消息缺少结构化元数据(rawContent object)，请确保后端 extra 或 WS FileMessage body 携带 fileName/size/fileType')
		}

		// 开发阶段强约束：不再从 content/url 推断 fileName 或规范化 url
		if (fileName) {
			uiMessage.fileName = fileName
		}
		if (sizeNum !== null) {
			uiMessage.fileSize = formatFileSize(sizeNum)
		}
		if (mimeType) {
			;(uiMessage as any).mimeType = mimeType
		}
	}
	
	/**
	 * 加载历史消息
	 */
	async function loadMessages() {
		if (loading.value || !hasMore.value) {
			return
		}
		
		// 如果没有 chatId，说明是新创建的群聊，暂时不加载消息
		if (!chatId.value || chatId.value === '' || chatId.value === '0') {
			console.log('[Chat] chatId 为空，跳过加载消息（新创建的群聊）')
			loading.value = false
			return
		}
		
		loading.value = true
		
		try {
			// 1. 先从缓存加载（立即显示）
			const cachedMessages = messageService.getMessages(chatId.value)
			if (cachedMessages.length > 0) {
				messages.value = convertServiceMessages(cachedMessages)
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				scrollToBottom()
			}
			
			// 2. 从服务器加载最新消息
			const pageNo = 1  // 第一页
			
			// 注意：request 拦截器已经解包了 data.data，返回的是 PageResult 对象
			const pageResult = await getMessageList(chatId.value, pageNo, 20)
			
			const serverMessages = pageResult
				? (
					Array.isArray((pageResult as any).list) ? (pageResult as any).list :
					(Array.isArray((pageResult as any).records) ? (pageResult as any).records : [])
				)
				: []
			if (serverMessages.length > 0) {
				try {
					await messageService.ingestRestHistoryPage(chatId.value, serverMessages)
				} catch (e) {
					// ignore
				}
				
				// 转换为 MessageItem 格式
				const newMessages = serverMessages.map(msg => {
					return convertServerMessage(msg)
				})
				
				// 合并消息（去重）
				messages.value = mergeMessages(messages.value, newMessages)
				try {
					const cachedNow = messageService.getMessages(chatId.value)
					if (cachedNow && cachedNow.length > 0) {
						messages.value = convertServiceMessages(cachedNow)
					}
				} catch (e) {
					// ignore
				}
				prefetchVisibleGroupReadReceiptSummary(messages.value)
				
				// 断线补偿水位初始化：HTTP 拉到的最新消息也需要推进本地 lastPulledSequence
				try {
					let maxSeq = '0'
					for (let i = 0; i < messages.value.length; i++) {
						const s = (messages.value[i] as any).sequence
						if (s == null || s === '') {
							continue
						}
						try {
							if (BigInt(s) > BigInt(maxSeq)) {
								maxSeq = s
							}
						} catch (e) {
							if (s > maxSeq) {
								maxSeq = s
							}
						}
					}
					if (maxSeq !== '0') {
						messageService.seedLastPulledSequence(chatId.value, maxSeq)
					}
				} catch (e) {
					// ignore
				}
				
				// PageResult 可能没有 hasMore 字段，根据 list 长度判断
				hasMore.value = serverMessages.length >= 20
				scrollToBottom()
				
				// 3. 如果有目标消息ID，定位到该消息
				if (targetMessageId.value) {
					setTimeout(() => {
						void scrollToTargetMessage(targetMessageId.value)
					}, 300)
				}
			}
			
		} catch (e) {
			console.error('[Chat] 加载消息失败:', e)
			// 显示网络错误提示,允许用户重试
			uni.showToast({ 
				title: '网络异常，加载消息失败', 
				icon: 'none',
				duration: 2000
			})
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 转换服务端消息为 UI 消息格式
	 */
	function convertServerMessage(msg : any) : MessageItem {
		// 安全地解析内容，防止 JSON 解析错误
		let rawContent : any
		let content : any
		let extraContent : any
		try {
			rawContent = parseRawContent(msg.content)
			content = parseMessageContent(rawContent)
		} catch (e) {
			console.error('[Chat] 解析消息内容失败:', e, msg.content)
			rawContent = msg.content
			content = msg.content
		}
		// extra 通常为 JSON 字符串（尤其是文件消息），用于补齐 fileName/size/mimeType
		try {
			extraContent = parseRawContent(msg.extra)
		} catch (e) {
			extraContent = msg.extra
		}
		
		const senderIdStr = msg && msg.senderId != null ? msg.senderId.toString() : '0'
	const receiverIdStr = msg && msg.receiverId != null ? msg.receiverId.toString() : ''
	const idStr = msg && msg.id != null ? msg.id.toString() : '0'
	const chatIdStr = msg && msg.chatId != null ? msg.chatId.toString() : (chatId.value != null ? chatId.value.toString() : '0')
	const groupIdStr = msg && msg.groupId != null ? msg.groupId.toString() : ''
	const sequenceStr = msg && msg.sequence != null ? msg.sequence.toString() : '0'
	// 后端 REST API 历史消息通常只有 id 字段，没有 messageId 字段
	const messageIdStr = msg && msg.messageId != null ? msg.messageId.toString() : idStr
	
	// 处理发送者信息缺失的后备方案
	const senderNickname = msg.senderNickname || ''
	const avatarText = senderNickname ? getAvatarTextUtil(senderNickname) : '?'
	let isSelfVal = false
	try {
		if ((msg as any).isSelf != null) {
			isSelfVal = !!(msg as any).isSelf
		} else {
			isSelfVal = senderIdStr === currentUserId.value
		}
	} catch (e) {
		isSelfVal = senderIdStr === currentUserId.value
	}
		// 后端 status: 0-发送中 1-已发送 2-已读 3-失败 6-已撤回
		// 这里保留数值状态，避免把 status=2 误映射为 'sending' 导致气泡旁已读/未读入口不展示
		let statusVal: any = (msg as any).status
		try {
			if (statusVal === null || statusVal === '') {
				statusVal = 0
			}
		} catch (e) {
			statusVal = 0
		}
		let isRecalled = false
		try {
			isRecalled = statusVal === 6 || statusVal === '6'
		} catch (e) {
			isRecalled = false
		}
	
		const uiMessage = {
			id: idStr,
			messageId: messageIdStr,
			rev: (msg as any).rev != null ? String((msg as any).rev) : '1',
			chatId: chatIdStr,
			groupId: groupIdStr,
			sequence: sequenceStr,
			senderId: senderIdStr,
			receiverId: receiverIdStr,
			type: isRecalled ? 'text' : getMessageTypeString(msg.messageType),
			content: isRecalled ? (isSelfVal ? '你撤回了一条消息' : `${senderNickname} 撤回了一条消息`) : getMessageContent(msg.messageType, content),
			isSelf: isSelfVal,
			time: msg.sendTime || msg.createTime || '',
			timestamp: new Date(msg.sendTime || msg.createTime || Date.now()).getTime(),
			showTime: true,
			avatarText: avatarText,
			avatarBg: getUserAvatarColor(senderIdStr),
			senderName: senderNickname,
			status: statusVal
		} as MessageItem

		// enterprise: re-edit-after-recall rehydration for refresh/re-enter (REST history lacks original content)
		try {
			if (isRecalled && isSelfVal) {
				const hint = messageService.getReeditHint(chatIdStr, messageIdStr)
				if (hint != null && hint.content) {
					;(uiMessage as any).reeditContent = hint.content
					if (hint.deadlineTs) {
						;(uiMessage as any).reeditDeadlineTs = hint.deadlineTs
					}
				}
			}
		} catch (e) {
		}

		applyQuoteFields(uiMessage, rawContent, msg, extraContent)
		applyFileFields(uiMessage, extraContent && typeof extraContent === 'object' ? extraContent : content)
		applyMediaFileId(uiMessage, extraContent && typeof extraContent === 'object' ? extraContent : content)
		maybePatchMediaDisplayUrl(uiMessage as any)
		return uiMessage
	}

/**
 * 转换消息服务的消息为 UI 消息格式
 */
function convertServiceMessages(serviceMessages : ServiceMessageItem[]) : MessageItem[] {
	return serviceMessages.map(msg => {
		const senderIdStr = msg && msg.senderId != null ? msg.senderId.toString() : '0'
		const receiverIdStr = msg && msg.receiverId != null ? msg.receiverId.toString() : '0'
		const messageIdStr = msg && msg.messageId != null ? msg.messageId.toString() : '0'
		const idStr = msg && msg.id != null ? msg.id.toString() : '0'
		const chatIdStr = (msg as any) && (msg as any).chatId != null ? (msg as any).chatId.toString() : (chatId.value != null ? chatId.value.toString() : '0')
		const groupIdStr = (msg as any) && (msg as any).groupId != null ? (msg as any).groupId.toString() : ''
		const sequenceStr = (msg as any) && (msg as any).sequence != null ? (msg as any).sequence.toString() : '0'
		
		const uiMessage = {
			id: idStr,
			messageId: messageIdStr,
			rev: (msg as any).rev != null ? String((msg as any).rev) : '1',
			chatId: chatIdStr,
			groupId: groupIdStr,
			sequence: sequenceStr,
			senderId: senderIdStr,
			receiverId: receiverIdStr,
			type: getMessageTypeString(msg.type),
			content: getServiceMessageContent(msg),
			isSelf: msg.isSelf,
			time: new Date(msg.timestamp).toLocaleString(),
			timestamp: msg.timestamp,
			showTime: true,
			avatarText: msg.avatarText,
			avatarBg: msg.avatarBg,
			senderName: msg.senderName,
			status: (msg as any).status
		} as MessageItem
		try {
			const ex: any = msg as any
			if (ex != null) {
				if (ex.reeditContent != null && String(ex.reeditContent) !== '') {
					;(uiMessage as any).reeditContent = String(ex.reeditContent)
				}
				if (ex.reeditDeadlineTs != null && String(ex.reeditDeadlineTs) !== '') {
					;(uiMessage as any).reeditDeadlineTs = String(ex.reeditDeadlineTs)
				}
			}
			if (((uiMessage as any).reeditContent == null || String((uiMessage as any).reeditContent) === '')
				&& (uiMessage as any).isSelf === true) {
				const hint = messageService.getReeditHintByCandidates(chatIdStr, [messageIdStr, idStr])
				if (hint != null && hint.content != null && hint.content !== '') {
					;(uiMessage as any).reeditContent = hint.content
					if (hint.deadlineTs != null && hint.deadlineTs !== '') {
						;(uiMessage as any).reeditDeadlineTs = hint.deadlineTs
					}
				}
			}
		} catch (e) {
		}

			const serviceExtra = (msg as any).extra != null
				? (msg as any).extra
				: ((msg as any).content != null && typeof (msg as any).content === 'object' ? (msg as any).content.extra : null)
			applyQuoteFields(uiMessage, msg.content, msg, serviceExtra)
			applyFileFields(uiMessage, msg.content)
			applyMediaFileId(uiMessage, msg.content)
			maybePatchMediaDisplayUrl(uiMessage as any)
			return uiMessage
		})
	}
	
	/**
	 * 获取消息类型字符串
	 * 支持两种格式: REST API (1-6) 和 WebSocket (100-105)
	 */
	function getMessageTypeString(messageType : any) : string {
		if (typeof messageType === 'string') {
			return messageType
		}

		const typeMap = {
			// REST API 格式 (数据库存储)
			1: 'text',
			2: 'image',
			3: 'voice',
			4: 'video',
			5: 'file',
			6: 'location',
			9: 'custom',
			// WebSocket/Protobuf 格式
			100: 'text',
			101: 'image',
			102: 'voice',
			103: 'video',
			104: 'file',
			105: 'location',
			106: 'custom',
			205: 'quote'
		}
		return typeMap[messageType] || 'text'
	}
	
	/**
	 * 获取消息内容
	 * 使用字符串类型而非数字,统一处理 REST API (1-6) 和 WebSocket (100-105) 两种格式
	 */
	function getMessageContent(messageType : number, content : any) : string {
		// 先转换为字符串类型
		const typeStr = getMessageTypeString(messageType)
		
		if (typeStr === 'text' || typeStr === 'quote') {
			// 文本消息
			return content.content || content
		} else if (typeStr === 'image') {
			// 图片消息
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'voice') {
			// 语音消息
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'video') {
			// 视频消息
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'file') {
			// 文件消息
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			// 兼容历史数据：url 后面拼了文件名
			return getFileUrlFromMixedContent(content)
		} else if (typeStr === 'location') {
			// 位置消息
			return content.address || content
		} else if (typeStr === 'custom') {
			// 合并转发等自定义消息：保留原始 JSON 字符串，由 getForwardCombineBody 解析
			// 避免多次 parse/stringify 导致格式异常或显示为 [自定义消息]
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			// 如果已经是字符串（原始 JSON），直接返回
			return content != null ? String(content) : ''
		}
		return content != null ? String(content) : ''
	}
	
	/**
	 * 获取服务消息的内容
	 */
	function getServiceMessageContent(msg : ServiceMessageItem) : string {
		const typeStr = getMessageTypeString(msg.type)
		// 安全地解析内容
		let content : any
		try {
			content = parseMessageContent(msg.content)
		} catch (e) {
			console.warn('[Chat] getServiceMessageContent 解析失败:', e)
			content = msg.content
		}

		if (typeStr === 'text' || typeStr === 'quote') {
			return content?.content != null ? String(content.content) : (content != null ? String(content) : '')
		} else if (typeStr === 'image') {
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'voice') {
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'video') {
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'file') {
			if (content && typeof content === 'object') {
				return content.url != null ? String(content.url) : ''
			}
			return content != null ? String(content) : ''
		} else if (typeStr === 'location') {
			return content?.address != null ? String(content.address) : (content != null ? String(content) : '')
		} else if (typeStr === 'custom') {
			// 合并转发等自定义消息：保留原始 JSON 字符串，由 getForwardCombineBody 解析
			if (content && typeof content === 'object') {
				try {
					return JSON.stringify(content)
				} catch (e) {
					return ''
				}
			}
			return content != null ? String(content) : ''
		}
		return content?.toString ? content.toString() : ''
	}

	function isMsgConfirmedSent(msg: any): boolean {
		try {
			const s = (msg as any)?.status
			// 兼容：
			// - 旧 UI 层: 'success'
			// - 新状态枚举: 2=SENT, 3=DELIVERED, 4=READ
			return s === 'success' || s === 1 || s === '1' || s === 2 || s === '2' || s === 3 || s === '3' || s === 4 || s === '4'
		} catch (e) {
			return false
		}
	}

	function safeToString(content: any): string {
		if (content == null) {
			return ''
		}
		return content?.toString ? content.toString() : ''
	}

	function parseRawContent(content : any) : any {
		// 处理 null
		if (content === null) {
			return content
		}

		// 如果不是字符串，直接返回
		if (typeof content !== 'string') {
			return content
		}

		// 空字符串直接返回
		const trimmed = content.trim()
		if (trimmed.length === 0) {
			return content
		}

		// 检查是否可能是 JSON（以 { 或 [ 开头）
		const firstChar = trimmed.charAt(0)
		const lastChar = trimmed.charAt(trimmed.length - 1)
		const isObjectJson = firstChar === '{' && lastChar === '}'
		const isArrayJson = firstChar === '[' && lastChar === ']'
		const couldBeJson = isObjectJson || isArrayJson
		
		if (!couldBeJson) {
			// 肯定不是 JSON，直接返回原字符串
			return content
		}
		if (isArrayJson) {
			const inner = trimmed.substring(1, trimmed.length - 1).trim()
			if (inner.length > 0) {
				const c0 = inner.charAt(0)
				const couldBeRealJsonArray =
					c0 === '{' || c0 === '[' || c0 === '"' || c0 === '-' ||
					(c0 >= '0' && c0 <= '9') || c0 === 't' || c0 === 'f' || c0 === 'n'
				if (!couldBeRealJsonArray) {
					return content
				}
			}
		}

		// 尝试解析 JSON，使用安全的方式
		try {
			return JSON.parse(trimmed)
		} catch (e) {
			// 解析失败，返回原字符串
			return content
		}
	}

	function extractQuoteIdFromRaw(raw: any): string {
		try {
			if (raw == null) {
				return ''
			}
			if (typeof raw === 'string') {
				const s = raw
				let m = s.match(/"quotedMessageId"\s*:\s*"?([0-9]+)"?/)
				if (m != null && m.length > 1 && m[1] != null && m[1] !== '' && m[1] !== '0') {
					return m[1]
				}
				m = s.match(/"quoteMessageId"\s*:\s*"?([0-9]+)"?/)
				if (m != null && m.length > 1 && m[1] != null && m[1] !== '' && m[1] !== '0') {
					return m[1]
				}
				return ''
			}
			const qid1 = (raw as any).quotedMessageId
			if (qid1 != null && String(qid1) !== '' && String(qid1) !== '0') {
				return String(qid1)
			}
			const qid2 = (raw as any).quoteMessageId
			if (qid2 != null && String(qid2) !== '' && String(qid2) !== '0') {
				return String(qid2)
			}
			return ''
		} catch (e) {
			return ''
		}
	}

	function applyQuoteFields(target : MessageItem, rawContent : any, rawMessage : any = null, rawExtra : any = null) : void {
		try {
			const fromRawMessage = rawMessage != null ? rawMessage : null
			if (fromRawMessage != null) {
				if ((fromRawMessage as any).quoteMessageId != null && String((fromRawMessage as any).quoteMessageId) !== '' && String((fromRawMessage as any).quoteMessageId) !== '0') {
					target.quoteMessageId = String((fromRawMessage as any).quoteMessageId)
				}
				if ((fromRawMessage as any).quoteContent != null && String((fromRawMessage as any).quoteContent) !== '') {
					target.quoteContent = String((fromRawMessage as any).quoteContent)
				}
				if ((fromRawMessage as any).quoteSenderName != null && String((fromRawMessage as any).quoteSenderName) !== '') {
					target.quoteSenderName = String((fromRawMessage as any).quoteSenderName)
				}
			}
			const parsed = parseRawContent(rawContent)
			if (parsed && typeof parsed === 'object') {
				if (parsed.quotedMessageId != null) {
					if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
						target.quoteMessageId = parsed.quotedMessageId.toString()
					}
					if ((target.quoteContent == null || String(target.quoteContent) === '') && parsed.quotedContent != null) {
						target.quoteContent = parsed.quotedContent
					}
					if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && parsed.quotedSenderName != null) {
						target.quoteSenderName = parsed.quotedSenderName
					}
				} else if (parsed.quoteMessageId != null) {
					if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
						target.quoteMessageId = parsed.quoteMessageId.toString()
					}
					if ((target.quoteContent == null || String(target.quoteContent) === '') && parsed.quoteContent != null) {
						target.quoteContent = parsed.quoteContent
					}
					if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && parsed.quoteSenderName != null) {
						target.quoteSenderName = parsed.quoteSenderName
					}
				}
			}
			if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
				const idFromRawContent = extractQuoteIdFromRaw(rawContent)
				if (idFromRawContent !== '') {
					target.quoteMessageId = idFromRawContent
				}
			}
			const parsedExtra = parseRawContent(rawExtra)
			if (parsedExtra && typeof parsedExtra === 'object') {
				const extraQuoteId = (parsedExtra as any).quoteMessageId
				if ((target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0')
					&& extraQuoteId != null && String(extraQuoteId) !== '' && String(extraQuoteId) !== '0') {
					target.quoteMessageId = String(extraQuoteId)
				}
				const extraQuoteContent = (parsedExtra as any).quoteContent
				if ((target.quoteContent == null || String(target.quoteContent) === '') && extraQuoteContent != null && String(extraQuoteContent) !== '') {
					target.quoteContent = String(extraQuoteContent)
				}
				const extraQuoteSenderName = (parsedExtra as any).quoteSenderName
				if ((target.quoteSenderName == null || String(target.quoteSenderName) === '') && extraQuoteSenderName != null && String(extraQuoteSenderName) !== '') {
					target.quoteSenderName = String(extraQuoteSenderName)
				}
			}
			if (target.quoteMessageId == null || String(target.quoteMessageId) === '' || String(target.quoteMessageId) === '0') {
				const idFromRawExtra = extractQuoteIdFromRaw(rawExtra)
				if (idFromRawExtra !== '') {
					target.quoteMessageId = idFromRawExtra
				}
			}
			if (target.quoteMessageId != null && String(target.quoteMessageId) !== '' && String(target.quoteMessageId) !== '0') {
				if (target.quoteContent == null || String(target.quoteContent).trim() === '') {
					target.quoteContent = '[消息]'
				}
				if (target.quoteSenderName == null || String(target.quoteSenderName).trim() === '') {
					target.quoteSenderName = '未知'
				}
			}
		} catch (e) {
			// 解析引用字段失败，忽略错误
			console.warn('[Chat] 解析引用字段失败:', e)
		}
	}

	function applyMediaFileId(target : MessageItem, rawExtraOrBody : any) : void {
		const id = tryExtractFileId(rawExtraOrBody)
		if (id) {
			;(target as any).fileId = id
		}
	}

	function maybePatchMediaDisplayUrl(target: any) : void {
		try {
			if (IM_MEDIA_USE_FILE_ID !== 'true') {
				return
			}
			if (!target || !target.type || !target.fileId) {
				return
			}
			if (target.type !== 'image' && target.type !== 'video') {
				return
			}
			resolvePresignedUrl(String(target.fileId)).then((signed) => {
				if (!signed) {
					return
				}
				if (target.type === 'image') {
					target.content = signed
				} else if (target.type === 'video') {
					target.poster = signed
				}
			}).catch((e) => {
				console.error('[Chat] 获取预签名URL失败:', e)
			})
		} catch (e) {
			// ignore
		}
	}

	function hasQuote(msg : MessageItem) : boolean {
		try {
			const qid = msg != null ? (msg as any).quoteMessageId : null
			return qid != null && String(qid) !== '' && String(qid) !== '0'
		} catch (e) {
			return false
		}
	}

	function isRecallTip(content : string) : boolean {
		return content.indexOf('撤回') > -1 && content.indexOf('消息') > -1
	}

	function isRecalledFinalMsg(m: any): boolean {
		try {
			const s = m != null ? (m as any).status : null
			return s === 6 || s === '6'
		} catch (e) {
			return false
		}
	}

	function getMessagePreview(msg : MessageItem) : string {
		if (msg.type === 'text' || msg.type === 'quote') {
			const text = msg.content || ''
			return isRecallTip(text) ? '[消息已撤回]' : text
		}
		if (msg.type === 'image') return '[图片]'
		if (msg.type === 'voice') return '[语音]'
		if (msg.type === 'video') return '[视频]'
		if (msg.type === 'file') {
			return msg.fileName ? `[文件] ${msg.fileName}` : '[文件]'
		}
		if (msg.type === 'location') return '[位置]'
		return '[消息]'
	}

	function buildQuoteChain(msg : MessageItem) : QuoteChainItem[] {
		if (!hasQuote(msg)) {
			return []
		}

		const chain : QuoteChainItem[] = []
		let currentId = msg.quoteMessageId as string
		let currentSender = msg.quoteSenderName || ''
		let currentContent = msg.quoteContent || ''
		let depth = 0
		const maxDepth = 5

		while (currentId && depth < maxDepth) {
			const referenced = messages.value.find(m => m.messageId === currentId)
			if (referenced != null) {
				chain.push({
					messageId: currentId,
					senderName: referenced.senderName || currentSender || '未知',
					content: getMessagePreview(referenced),
					missing: false
				})

				if (referenced.quoteMessageId == null || String(referenced.quoteMessageId) === '' || String(referenced.quoteMessageId) === '0') {
					break
				}

				currentId = referenced.quoteMessageId
				currentSender = referenced.quoteSenderName || ''
				currentContent = referenced.quoteContent || ''
			} else {
				chain.push({
					messageId: currentId,
					senderName: currentSender || '未知',
					content: currentContent || '原消息已删除',
					missing: true
				})
				break
			}
			depth++
		}

		return chain
	}
	
	/**
	 * 合并消息（去重）
	 */
	function mergeMessages(oldMessages : MessageItem[], newMessages : MessageItem[]) : MessageItem[] {
		const messageMap = new Map<string, MessageItem>()
		const pickNonEmpty = (a: any, b: any): any => {
			// prefer b if b is meaningful, else keep a
			if (b === null) return a
			if (typeof b === 'string') {
				if (b === '' || b === '0' || b === 'null') return a
			}
			return b
		}
		const isRecalledFinal = (m: any): boolean => {
			try {
				const s = m != null ? (m as any).status : null
				return s === 6 || s === '6'
			} catch (e) {
				return false
			}
		}
		const getRev = (m: any): string => {
			try {
				const r = m != null ? (m as any).rev : null
				return r != null && r !== '' ? r.toString() : '0'
			} catch (e) {
				return '0'
			}
		}
		const cmpRev = (a: string, b: string): number => {
			try {
				const diff = BigInt(a) - BigInt(b)
				if (diff === BigInt(0)) return 0
				return diff > BigInt(0) ? 1 : -1
			} catch (e) {
				if (a === b) return 0
				return a > b ? 1 : -1
			}
		}
		const mergeOne = (prev: any, next: any): any => {
			if (!prev) return next
			if (!next) return prev
			// enterprise: prefer higher rev as final state base
			const prevRev = getRev(prev)
			const nextRev = getRev(next)
			if (cmpRev(nextRev, prevRev) > 0) {
				const tmp = prev
				prev = next
				next = tmp
			}
			const prevRecalled = isRecalledFinal(prev)
			const nextRecalled = isRecalledFinal(next)
			// 最终态优先：撤回提示一旦成立，不允许被旧原文覆盖
			if (prevRecalled || nextRecalled) {
				const finalMsg: any = nextRecalled ? { ...prev, ...next } : { ...next, ...prev }
				finalMsg.sequence = pickNonEmpty(prev.sequence, next.sequence)
				finalMsg.groupId = pickNonEmpty(prev.groupId, next.groupId)
				finalMsg.chatId = pickNonEmpty(prev.chatId, next.chatId)
				finalMsg.rev = pickNonEmpty(prev.rev, next.rev)
				finalMsg.status = 6
				// type/content 保持撤回提示（以 recalled 那一方为准）
				if (nextRecalled) {
					finalMsg.type = pickNonEmpty(prev.type, next.type)
					finalMsg.content = pickNonEmpty(prev.content, next.content)
				} else {
					finalMsg.type = pickNonEmpty(next.type, prev.type)
					finalMsg.content = pickNonEmpty(next.content, prev.content)
				}
				finalMsg.timestamp = pickNonEmpty(prev.timestamp, next.timestamp)
				finalMsg.time = pickNonEmpty(prev.time, next.time)
				finalMsg.senderId = pickNonEmpty(prev.senderId, next.senderId)
				finalMsg.receiverId = pickNonEmpty(prev.receiverId, next.receiverId)
				finalMsg.isSelf = (next.isSelf !== null) ? next.isSelf : prev.isSelf
				finalMsg.reeditContent = pickNonEmpty(prev.reeditContent, next.reeditContent)
				finalMsg.reeditDeadlineTs = pickNonEmpty(prev.reeditDeadlineTs, next.reeditDeadlineTs)
				return finalMsg
			}
			const merged: any = { ...prev, ...next }
			// 补齐关键字段：HTTP 刷新回来的消息应当补齐缓存缺失的水位字段
			merged.sequence = pickNonEmpty(prev.sequence, next.sequence)
			merged.groupId = pickNonEmpty(prev.groupId, next.groupId)
			merged.chatId = pickNonEmpty(prev.chatId, next.chatId)
			merged.status = pickNonEmpty(prev.status, next.status)
			merged.senderId = pickNonEmpty(prev.senderId, next.senderId)
			merged.receiverId = pickNonEmpty(prev.receiverId, next.receiverId)
			merged.isSelf = (next.isSelf !== null) ? next.isSelf : prev.isSelf
			merged.reeditContent = pickNonEmpty(prev.reeditContent, next.reeditContent)
			merged.reeditDeadlineTs = pickNonEmpty(prev.reeditDeadlineTs, next.reeditDeadlineTs)
			return merged
		}
		
		// 先添加旧消息
		oldMessages.forEach(msg => {
			const key = msg && (msg as any).messageId ? String((msg as any).messageId) : (msg && (msg as any).id ? String((msg as any).id) : '')
			if (!key) {
				return
			}
			const prev: any = messageMap.get(key)
			messageMap.set(key, mergeOne(prev, msg))
		})
		
		// 再添加新消息（补齐字段 + 覆盖重复的）
		newMessages.forEach(msg => {
			const key = msg && (msg as any).messageId ? String((msg as any).messageId) : (msg && (msg as any).id ? String((msg as any).id) : '')
			if (!key) {
				return
			}
			const prev: any = messageMap.get(key)
			messageMap.set(key, mergeOne(prev, msg))
		})
		
		// 转换为数组并按时间排序
		const result : MessageItem[] = []
		messageMap.forEach(msg => {
			result.push(msg)
		})
		
		result.sort((a, b) => a.timestamp - b.timestamp)
		
		return result
	}
	
	/**
	 * 处理新消息
	 */
	function handleNewMessage(message : ServiceMessageItem) {
		// 只处理当前会话的消息（优先按 chatId 精确匹配，兼容旧链路按 target 匹配）
		const incomingChatId = (message as any).chatId != null ? String((message as any).chatId) : ''
		const pageChatId = chatId.value != null ? String(chatId.value) : ''
		let inCurrentConversation = false
		if (incomingChatId !== '' && incomingChatId !== '0' && pageChatId !== '' && pageChatId !== '0') {
			inCurrentConversation = incomingChatId === pageChatId
		} else {
			const msgTargetId = (message.groupId !== '0' && message.groupId !== '')
				? message.groupId
				: (message.isSelf ? message.receiverId : message.senderId)
			const currentTargetId = chatType.value === 'group'
				? targetId.value
				: getReceiverIdForMessage()
			inCurrentConversation = msgTargetId === currentTargetId
		}
		
		if (!inCurrentConversation) {
			return
		}

		// 去重：sendMessage() 会先 notifyMessageListeners，本地发送路径也可能手动 push，导致重复展示
		// 但撤回属于“最终态变更”，必须覆盖已有消息（不能被去重丢弃）
		const existingIndex = message.messageId
			? messages.value.findIndex((m: any) => m && m.messageId === message.messageId)
			: -1
		let incomingIsRecalled = false
		try {
			const s: any = (message as any).status
			incomingIsRecalled = s === 6 || s === '6'
		} catch (e) {
			incomingIsRecalled = false
		}
		if (existingIndex > -1 && !incomingIsRecalled) {
			try {
				const prev: any = messages.value[existingIndex]
				const prevRev = prev && (prev as any).rev != null ? String((prev as any).rev) : '0'
				const nextRev = (message as any).rev != null ? String((message as any).rev) : '0'
				let newer = false
				try {
					newer = BigInt(nextRev) > BigInt(prevRev)
				} catch (e) {
					newer = nextRev > prevRev
				}
				if (!newer) {
					return
				}
			} catch (e) {
				return
			}
		}
		
		// 转换消息格式
		const uiMessage : MessageItem = {
			id: message.id.toString(),
			messageId: message.messageId,
			rev: (message as any).rev != null ? String((message as any).rev) : '1',
			senderId: message.senderId.toString(),
			receiverId: message.receiverId.toString(),
			type: getMessageTypeString(message.type),
			content: getServiceMessageContent(message),
			sequence: (message as any).sequence != null ? String((message as any).sequence) : null,
			groupId: (message as any).groupId != null ? String((message as any).groupId) : null,
			isSelf: message.isSelf,
			time: new Date(message.timestamp).toLocaleString(),
			timestamp: message.timestamp,
			showTime: true,
			avatarText: message.avatarText,
			avatarBg: message.avatarBg,
			senderName: message.senderName,
			status: message.status
		} as MessageItem
		try {
			const ex: any = message as any
			if (ex != null) {
				if (ex.reeditContent != null && String(ex.reeditContent) !== '' && !isRecallTip(String(ex.reeditContent))) {
					;(uiMessage as any).reeditContent = String(ex.reeditContent)
				}
				if (ex.reeditDeadlineTs != null && String(ex.reeditDeadlineTs) !== '') {
					;(uiMessage as any).reeditDeadlineTs = String(ex.reeditDeadlineTs)
				}
			}
			if ((((uiMessage as any).reeditContent == null || String((uiMessage as any).reeditContent) === '')
				&& (uiMessage as any).isSelf === true)) {
				const reeditChatId = (uiMessage as any).chatId != null && String((uiMessage as any).chatId) !== ''
					? String((uiMessage as any).chatId)
					: chatId.value
				const hint = messageService.getReeditHintByCandidates(reeditChatId, [uiMessage.messageId, uiMessage.id])
				if (hint != null && hint.content != null && hint.content !== '' && !isRecallTip(String(hint.content))) {
					;(uiMessage as any).reeditContent = String(hint.content)
					if (hint.deadlineTs != null && hint.deadlineTs !== '') {
						;(uiMessage as any).reeditDeadlineTs = String(hint.deadlineTs)
					}
				}
			}
		} catch (e) {
		}

		applyQuoteFields(uiMessage, message.content, message, (message as any).extra)
		applyFileFields(uiMessage, message.content)
		applyMediaFileId(uiMessage, message.content)
		maybePatchMediaDisplayUrl(uiMessage as any)
		
		// 最终态覆盖：撤回到达时，替换掉列表中的原消息
		if (existingIndex > -1 && incomingIsRecalled) {
			const prev: any = messages.value[existingIndex]
			const next: any = uiMessage
			const merged: any = { ...prev, ...next }
			merged.status = 6
			// 撤回提示优先：type/content 以撤回提示为准
			merged.type = next.type
			merged.content = next.content
			merged.timestamp = prev.timestamp != null ? prev.timestamp : next.timestamp
			merged.time = prev.time != null ? prev.time : next.time
			merged.sequence = prev.sequence != null && prev.sequence !== '' ? prev.sequence : next.sequence
			merged.groupId = prev.groupId != null && prev.groupId !== '' ? prev.groupId : next.groupId
			merged.chatId = prev.chatId != null && prev.chatId !== '' ? prev.chatId : next.chatId
			merged.reeditContent = (next as any).reeditContent != null && String((next as any).reeditContent) !== ''
				? (next as any).reeditContent
				: (prev as any).reeditContent
			merged.reeditDeadlineTs = (next as any).reeditDeadlineTs != null && String((next as any).reeditDeadlineTs) !== ''
				? (next as any).reeditDeadlineTs
				: (prev as any).reeditDeadlineTs
			messages.value[existingIndex] = merged
		} else if (existingIndex > -1) {
			const prev: any = messages.value[existingIndex]
			const next: any = uiMessage
			const merged: any = { ...prev, ...next }
			merged.sequence = prev.sequence != null && prev.sequence !== '' ? prev.sequence : next.sequence
			merged.groupId = prev.groupId != null && prev.groupId !== '' ? prev.groupId : next.groupId
			merged.chatId = prev.chatId != null && prev.chatId !== '' ? prev.chatId : next.chatId
			merged.rev = next.rev != null && next.rev !== '' ? next.rev : prev.rev
			messages.value[existingIndex] = merged
		} else {
			messages.value.push(uiMessage)
		}
		
		// 滚动到底部
		scrollToBottom()
		
		// 发送已读回执（如果不是自己发送的）
		if (!message.isSelf) {
			// 群聊已读以服务端 readSequence 水位为准，禁用逐条回执，避免回执风暴
			if (chatType.value !== 'group') {
				messageService.sendReadReceipt(message.senderId, [message.messageId])
			}
		}
	}

	function handleMessageStatusChange(messageId: string, status: any) {
		try {
			if (!messageId) return
			const idx = messages.value.findIndex((m: any) => m && m.messageId === messageId)
			if (idx < 0) return
			const uiMsg: any = messages.value[idx]

			// MessageService.MessageStatus: SENDING=0 SENT=1 READ=2 FAILED=3
			if (status === 1 || status === '1') {
				uiMsg.status = 'success'
				// 补齐 sequence（服务端确认后才会有）
				try {
					const candidateChatIds: string[] = []
					if (chatId.value && chatId.value !== '' && chatId.value !== '0') {
						candidateChatIds.push(chatId.value)
					}
					if (chatType.value === 'group' && targetId.value && targetId.value !== '' && targetId.value !== '0') {
						candidateChatIds.push(targetId.value)
					}
					const activeChatId = messageService.getActiveChatId()
					if (activeChatId && activeChatId !== '' && activeChatId !== '0') {
						candidateChatIds.push(activeChatId)
					}
					let hit: any = null
					for (let i = 0; i < candidateChatIds.length; i++) {
						const cached = messageService.getMessages(candidateChatIds[i]) as any[]
						hit = cached && cached.length > 0
							? cached.find((m: any) => m && m.messageId === messageId)
							: null
						if (hit != null) {
							break
						}
					}
					if (hit && hit.sequence != null && hit.sequence !== '') {
						uiMsg.sequence = String(hit.sequence)
					}
				} catch (e) {
					// ignore
				}
				// 群聊自发消息确认后，在数据层触发已读回执 summary 拉取（不在模板渲染中发网络请求）
				try {
					if (chatType.value === 'group' && uiMsg.isSelf === true) {
						ensureReadReceiptSummaryFetched(messageId)
					}
				} catch (e) {
					// ignore
				}
				return
			}

			if (status === 0 || status === '0') {
				uiMsg.status = 'sending'
				return
			}
			if (status === 3 || status === '3') {
				uiMsg.status = 'failed'
				return
			}
		} catch (e) {
			// ignore
		}
	}


	const featureList = [
		{ icon: '\ue608', color: '#3370FF', nameKey: 'chat.features.album' },
		{ icon: '\uea87', color: '#3370FF', nameKey: 'chat.features.camera' },
		{ icon: '\uea72', color: '#FFB347', nameKey: 'chat.features.location' },
		{ icon: '\uea96', color: '#62D4A1', nameKey: 'chat.features.file' },
		{ icon: '\ue624', color: '#F9C349', nameKey: 'chat.features.card' },
		{ icon: '\uea90', color: '#FFB347', nameKey: 'chat.features.fav' }
	]

	function handleBack() {
		try {
			if (fromMergeDetail.value) {
				const delta = mergeBackDelta.value > 1 ? mergeBackDelta.value : 1
				uni.navigateBack({
					delta: delta,
					fail: () => {
						uni.switchTab({ url: '/pages/message/message' })
					}
				})
				return
			}
		} catch (e) {
		}
		uni.navigateBack({
			fail: () => {
				uni.switchTab({ url: '/pages/message/message' })
			}
		})
	}

	function toggleInputMode() {
		isVoiceMode.value = !isVoiceMode.value
		if (isVoiceMode.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function toggleEmojiMenu() {
		showEmojiMenu.value = !showEmojiMenu.value
		showPlusMenu.value = false
		isVoiceMode.value = false
	}

	function togglePlusMenu() {
		showPlusMenu.value = !showPlusMenu.value
		showEmojiMenu.value = false
		isVoiceMode.value = false
	}

	function toggleFullExpand() {
		isFullExpanded.value = !isFullExpanded.value
		if (isFullExpanded.value) {
			showEmojiMenu.value = false
			showPlusMenu.value = false
		}
	}

	function onEditorReady() {
		uni.createSelectorQuery().select('#editor').context((res) => {
			editorCtx = res.context as EditorContext
		}).exec()
	}

	function onEditorInput(e : any) {
		// e.detail.text 包含纯文本
		// e.detail.html 包含富文本
		const text = e.detail.text
		const html = e.detail.html
		try {
			if (chatType.value === 'group') {
				const s = text != null ? String(text) : ''
				const now = Date.now()
				if (!mentionPicking && s.length > 0 && s.charAt(s.length - 1) === '@') {
					if (now - lastMentionTriggerAt > 500) {
						lastMentionTriggerAt = now
						openMentionSelector()
					}
				}
			}
		} catch (e) {
			// ignore
		}
		
		// 启发式判断行数：
		// 1. 是否有物理换行符
		// 2. 文本长度是否超过一行（根据屏幕宽度，通常 22-25 个字符左右换行）
		// 3. HTML 中是否有多个段落标签
		const hasNewLine = text.includes('\n')
		const isLongText = text.trim().length > 22
		const hasMultipleParagraphs = (html.match(/<p>/g) || []).length > 1 || html.includes('<br>')
		
		isMultiLine.value = hasNewLine || isLongText || hasMultipleParagraphs

		if (text.trim().length > 0 || html.includes('<img')) {
			inputText.value = 'has_content'
		} else {
			inputText.value = ''
			isMultiLine.value = false // 清空时恢复单行
		}
	}

	function openMentionSelector(): void {
		try {
			if (mentionPicking) {
				return
			}
			if (chatType.value !== 'group') {
				return
			}
			const gid = groupId.value != null ? String(groupId.value) : ''
			if (gid === '' || gid === '0') {
				return
			}
			mentionPicking = true
			uni.navigateTo({
				url: `/pages/message/mention-selector?groupId=${encodeURIComponent(gid)}`,
				events: {
					select: (payload: any) => {
						try {
							const uid = payload != null && payload.userId != null ? String(payload.userId) : ''
							const uname = payload != null && payload.userName != null ? String(payload.userName) : ''
							if (!uname || editorCtx == null) {
								return
							}
							if (uid === '-1') {
								mentionNameToUserId.clear()
								mentionNameToUserId.set('所有人', '-1')
							} else if (uid !== '' && uid !== '0') {
								mentionNameToUserId.set(uname, uid)
							}
							try {
								editorCtx!.insertText({ text: `@${uname} ` })
							} catch (e) {
								// ignore
							}
						} catch (e) {
							// ignore
						}
					}
				},
				complete: () => {
					mentionPicking = false
				}
			})
		} catch (e) {
			mentionPicking = false
		}
	}

	function handleInputFocus() {
		showEmojiMenu.value = false
		showPlusMenu.value = false
		scrollToBottom()
	}

	function getReeditDeadlineTs(msg: any): number {
		try {
			if (!msg) return 0
			const deadlineStr = (msg as any).reeditDeadlineTs != null ? String((msg as any).reeditDeadlineTs) : ''
			if (!deadlineStr) return 0
			const deadline = Number(deadlineStr)
			return !isNaN(deadline) && deadline > 0 ? deadline : 0
		} catch (e) {
			return 0
		}
	}

	function shouldRenderReeditEntry(msg: any): boolean {
		try {
			if (!msg) return false
			const s: any = (msg as any).status
			const isRecalled = s === 6 || s === '6' || s === 'recalled' || s === 'recalled_final'
			if (!isRecalled) return false
			if (!(msg as any).isSelf) return false
			const senderIdStr = (msg as any).senderId != null ? String((msg as any).senderId) : ''
			if (senderIdStr !== '' && senderIdStr !== '0' && senderIdStr !== currentUserId.value) return false
			const content = (msg as any).reeditContent != null ? String((msg as any).reeditContent) : ''
			if (!content) return false
			return getReeditDeadlineTs(msg) > 0
		} catch (e) {
			return false
		}
	}

	function isReeditExpired(msg: any): boolean {
		const deadline = getReeditDeadlineTs(msg)
		if (deadline <= 0) return true
		return reeditNowTs.value > deadline
	}

	function getReeditRemainSeconds(msg: any): number {
		const deadline = getReeditDeadlineTs(msg)
		if (deadline <= 0) return 0
		const diff = deadline - reeditNowTs.value
		if (diff <= 0) return 0
		return Math.ceil(diff / 1000)
	}

	function formatReeditRemain(seconds: number): string {
		const s = seconds > 0 ? seconds : 0
		const mm = Math.floor(s / 60)
		const ss = s % 60
		const mStr = mm < 10 ? '0' + String(mm) : String(mm)
		const sStr = ss < 10 ? '0' + String(ss) : String(ss)
		return `${mStr}:${sStr}`
	}

	function startReeditTicker(): void {
		try {
			reeditNowTs.value = Date.now()
			if (reeditTickTimer != null) {
				return
			}
			reeditTickTimer = setInterval(() => {
				reeditNowTs.value = Date.now()
			}, 1000)
		} catch (e) {
		}
	}

	function stopReeditTicker(): void {
		try {
			if (reeditTickTimer != null) {
				clearInterval(reeditTickTimer)
				reeditTickTimer = null
			}
		} catch (e) {
		}
	}

	function getReeditActionText(msg: any): string {
		if (isReeditExpired(msg)) {
			return '重新编辑(已过期)'
		}
		const remain = getReeditRemainSeconds(msg)
		return `重新编辑(${formatReeditRemain(remain)})`
	}

	function shouldShowReeditEntry(msg: any): boolean {
		return shouldRenderReeditEntry(msg) && !isReeditExpired(msg)
	}

	function handleReeditAfterRecall(msg: any) {
		try {
			if (!shouldShowReeditEntry(msg)) {
				uni.showToast({ title: '重新编辑已过期', icon: 'none' })
				return
			}
			if (editorCtx == null) {
				uni.showToast({ title: '编辑器未就绪', icon: 'none' })
				return
			}
			let content = (msg as any).reeditContent != null ? String((msg as any).reeditContent) : ''
			try {
				if (content === '' || isRecallTip(content)) {
					const mid = (msg as any).messageId != null ? String((msg as any).messageId) : ''
					const mid2 = (msg as any).id != null ? String((msg as any).id) : ''
					const reeditChatId = (msg as any).chatId != null && String((msg as any).chatId) !== ''
						? String((msg as any).chatId)
						: chatId.value
					if (mid !== '' || mid2 !== '') {
						const hint = messageService.getReeditHintByCandidates(reeditChatId, [mid, mid2])
						if (hint != null && hint.content != null && hint.content !== '' && !isRecallTip(String(hint.content))) {
							content = String(hint.content)
						}
					}
				}
			} catch (e) {
			}
			if (!content) {
				uni.showToast({ title: '原内容为空', icon: 'none' })
				return
			}
			if (isRecallTip(content)) {
				uni.showToast({ title: '原内容不可恢复', icon: 'none' })
				return
			}
			// re-edit must send a NEW normal message (not quote-reply)
			try {
				quoteReplyMsg.value = null
			} catch (e) {
			}
			showEmojiMenu.value = false
			showPlusMenu.value = false
			isVoiceMode.value = false
			isFullExpanded.value = false
			editorCtx!.clear({
				success: () => {
					try {
						editorCtx!.insertText({ text: content })
					} catch (e) {
						// ignore
					}
					inputText.value = 'has_content'
					scrollToBottom()
				}
			})
		} catch (e) {
			console.error('[Chat] handleReeditAfterRecall failed:', e)
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}

	function handleVoiceStart(e : TouchEvent) {
		recordStartY.value = e.touches[0].pageY
		isRecording.value = true
		isCancelReady.value = false
		
		// 开始录音
		uni.getRecorderManager().start({
			duration: 60000,  // 最长录音时间 60 秒
			sampleRate: 16000,
			numberOfChannels: 1,
			encodeBitRate: 48000,
			format: 'mp3',
			success: () => {
				console.log('[Chat] 开始录音')
			},
			fail: (err) => {
				console.error('[Chat] 录音失败:', err)
				uni.showToast({
					title: '录音失败，请检查麦克风权限',
					icon: 'none'
				})
				isRecording.value = false
			}
		})
	}

	function handleVoiceMove(e : TouchEvent) {
		const currentY = e.touches[0].pageY
		if (recordStartY.value - currentY > 60) {
			isCancelReady.value = true
		} else {
			isCancelReady.value = false
		}
	}

	/**
			status: 'success'
		} as MessageItem
	}

	function handleVoiceEnd() {
		if (isCancelReady.value) {
			console.log('[Chat] 取消录音')
			// 停止录音
			uni.getRecorderManager().stop()
		} else {
			console.log('[Chat] 录音结束，准备上传')
			
			// 停止录音并获取录音文件
			uni.getRecorderManager().stop()
			
			// 监听录音结束事件
			uni.getRecorderManager().onStop((res) => {
				const tempFilePath = res.tempFilePath
				const duration = Math.floor(res.duration / 1000)  // 转换为秒
				
				console.log('[Chat] 录音文件:', tempFilePath, '时长:', duration)
				
				// 上传语音文件
			const uploadPromise = IM_MEDIA_USE_FILE_ID === 'true'
				? uploadFileAndReturnId(tempFilePath, {
					directory: 'im/voice',
					onProgress: (progress) => {
						console.log('[Chat] 上传进度:', progress)
					}
				})
				: uploadFile(tempFilePath, {
					directory: 'im/voice',
					onProgress: (progress) => {
						console.log('[Chat] 上传进度:', progress)
					}
				})
			uploadPromise.then((result: any) => {
				const voiceUrl = result.data.url || ''
				const voiceSize = result.data.size || 0
				const voiceFileId = result.data.fileId?.toString() || '0'
					
					// 构建完整URL
					let fullVoiceUrl = voiceUrl
					if (voiceUrl.startsWith('/')) {
						fullVoiceUrl = CONFIG_BASE_URL + voiceUrl
					}
					
					console.log('[Chat] 语音URL:', fullVoiceUrl)
					
					// 使用消息服务发送语音消息（灰度：V2 双写 fileId + url）
				const message = IM_MEDIA_USE_FILE_ID === 'true'
					? messageService.sendVoiceMessageV2(
						getReceiverIdForMessage(),
						getGroupIdForMessage(),
						voiceFileId,
						fullVoiceUrl,
						duration,
						voiceSize
					)
					: messageService.sendVoiceMessage(
						getReceiverIdForMessage(),
						getGroupIdForMessage(),
						fullVoiceUrl,
						duration,
						voiceSize
					)
					
					// IM_MEDIA_USE_FILE_ID=true 时，消息入栈统一由 messageService listener 处理，避免重复展示
					scrollToBottom()
				}).catch((err) => {
					console.error('[Chat] 上传语音失败:', err)
					uni.showToast({ title: '上传失败', icon: 'none' })
				})
			})
		}
		
		isRecording.value = false
		isCancelReady.value = false
	}

	function handleEmojiClick(item : any) {
		if (editorCtx != null) {
			editorCtx!.insertImage({
				src: item.path,
				alt: item.code,
				data: {
					code: item.code
				},
				width: '24px',
				height: '24px',
				success: () => {
					console.log('插入表情成功:', item.code)
				}
			})
		}
	}

	/**
	 * 处理输入，实现表情包整体退格
	 */
	function handleInput(e : InputEvent) {
		const newVal = e.detail.value
		const oldVal = lastInputText.value
		
		// 检查是否是退格删除操作 (新长度小于旧长度)
		if (newVal.length < oldVal.length) {
			const diffIndex = newVal.length
			// 如果删除的是 ']'，尝试向前寻找匹配的 '['
			if (oldVal[diffIndex] === ']') {
				const lastLeftBracket = oldVal.lastIndexOf('[', diffIndex)
				if (lastLeftBracket !== -1) {
					// 提取可能的表情代码 [xxx]
					const potentialCode = oldVal.substring(lastLeftBracket, diffIndex + 1)
					// 验证是否是合法的表情代码
					const regex = /^\[[\u4e00-\u9fa5\w]+\]$/
					if (regex.test(potentialCode)) {
						// 整体删除 [xxx]
						inputText.value = oldVal.substring(0, lastLeftBracket) + oldVal.substring(diffIndex + 1)
					}
				}
			}
		}
		
		lastInputText.value = inputText.value
	}

	function handleStickerClick(item : StickerItem) {
		messages.value.push(createMessage({
			type: 'sticker',
			content: item.url,
			isSelf: true,
			isSticker: true
		}))
		scrollToBottom()
		showEmojiMenu.value = false
	}

	function handleToSettings() {
		// 根据聊天类型跳转到不同的设置页面
		if (chatType.value === 'group') {
			// 群聊跳转到群聊设置页
			uni.navigateTo({
				url: `/pages/message/group-settings?groupId=${encodeIdParam(groupId.value)}&name=${encodeURIComponent(name.value)}`
			})
		} else {
			// 单聊跳转到聊天设置页
			uni.navigateTo({
				url: '/pages/message/chat-settings'
			})
		}
	}

	function handleSend() {
		if (editorCtx == null) return
		
		editorCtx!.getContents({
			success: (res) => {
				let content = res.html
				if (!content || content === '<p><br></p>') return
				
				// 将 <img src="..." alt="[表情]" ...> 替换回 [表情]
				const imgReg = /<img [^>]*alt=['"]([^'"]+)['"][^>]*>/g
				let finalContent = content.replace(imgReg, '$1')
				
				// 去除 HTML 标签
				finalContent = finalContent.replace(/<[^>]+>/g, '')
				
				if (!finalContent.trim()) return
				
				let atUserIds: string[] = []
				let mentions: any[] = []
				try {
					atUserIds = extractAtUserIds(finalContent, mentionNameToUserId)
					const parsedMentions = parseAtMentions(finalContent)
					mentions = parsedMentions.map(m => {
						const mentionUserName = m != null && m.userName != null ? String(m.userName) : ''
						let mentionUserId = mentionUserName === '所有人' || mentionUserName === 'all'
							? '-1'
							: (mentionNameToUserId.get(mentionUserName) || '')
						if (mentionUserId === '') {
							mentionUserId = '0'
						}
						return {
							userId: mentionUserId,
							nickname: mentionUserName,
							startIndex: m.startIndex,
							endIndex: m.endIndex
						}
					}).filter(m => m.userId !== '0')
				} catch (e) {
					atUserIds = []
					mentions = []
				}

				// 检查是否有引用回复
				const quoteMsg = quoteReplyMsg.value
				
				let message: any
				if (quoteMsg !== null) {
				// 发送引用回复消息
				const quoteContent = getMessagePreview(quoteMsg)
					message = messageService.sendQuoteReplyMessage(
						getReceiverIdForMessage(),
						getGroupIdForMessage(),
						finalContent,
						quoteMsg.messageId,
						quoteContent,
						quoteMsg.senderName,
						atUserIds,
						mentions
					)
					// 清除引用回复状态
					quoteReplyMsg.value = null
				} else {
					// 发送普通文本消息
					message = messageService.sendTextMessage(
						getReceiverIdForMessage(),  // 单聊时传 receiverId
						getGroupIdForMessage(),     // 群聊时传 groupId
						finalContent,
						atUserIds,
						mentions
					)
				}
				
				// 清空编辑器
				editorCtx!.clear({
					success: () => {
						inputText.value = ''
						isFullExpanded.value = false
						try {
							mentionNameToUserId.clear()
						} catch (e) {
							// ignore
						}
						
						setTimeout(() => {
							scrollToBottom()
						}, 100)
					}
				})
			}
		})
	}

	function toggleMenu() {
		showMenu.value = !showMenu.value
	}

	function handleFeature(item : any) {
		if (item.nameKey === 'chat.features.album') {
			// 选择并上传图片
			if (IM_MEDIA_USE_FILE_ID === 'true') {
				uni.chooseImage({
					count: 9,
					sizeType: ['original', 'compressed'],
					sourceType: ['album', 'camera'],
					success: async (res) => {
						try {
							const uploadPromises: Promise<any>[] = []
							for (let i = 0; i < res.tempFilePaths.length; i++) {
								uploadPromises.push(uploadFileAndReturnId(res.tempFilePaths[i], {
									directory: 'im/image'
								}))
							}
							const results = await Promise.all(uploadPromises)
							console.log('[Chat] upload-and-return-id 上传成功，共', results.length, '张图片')
							results.forEach((result: any, index: number) => {
								const fileId = result.data.fileId?.toString() || '0'
								const imageUrl = result.data.url || ''
								const imageSize = result.data.size || 0
								if (!imageUrl) {
									return
								}
								let fullImageUrl = imageUrl
								if (imageUrl.startsWith('/')) {
									fullImageUrl = CONFIG_BASE_URL + imageUrl
								}
								const message = messageService.sendImageMessageV2(
									getReceiverIdForMessage(),
									getGroupIdForMessage(),
									fileId,
									fullImageUrl,
									fullImageUrl,
									0,
									0,
									imageSize
								)
								void message
							})
							showPlusMenu.value = false
							setTimeout(() => {
								scrollToBottom()
							}, 100)
						} catch (err) {
							console.error('[Chat] upload-and-return-id 上传图片失败:', err)
							uni.showToast({ title: '上传失败', icon: 'none' })
						}
					}
				})
				return
			}
			chooseAndUploadImage(9, {
				directory: 'im/image',
				onProgress: (progress) => {
					console.log('[Chat] 上传进度:', progress)
				}
			}).then((results) => {
				console.log('[Chat] 上传成功，共', results.length, '张图片')
				
				// 上传成功,发送图片消息
				results.forEach((result, index) => {
					console.log(`[Chat] 处理第 ${index + 1} 张图片:`, result)
					
					// 获取图片URL（后端返回的 data 字段直接是 URL 字符串）
					const imageUrl = typeof result.data === 'string' ? result.data : result.data.url
					const imageSize = result.data.size || 0
					
					if (!imageUrl) {
						console.error('[Chat] 图片URL为空:', result)
						uni.showToast({ title: '图片URL获取失败', icon: 'none' })
						return
					}
					
					// 构建完整URL
					let fullImageUrl = imageUrl
					if (imageUrl.startsWith('/')) {
						fullImageUrl = CONFIG_BASE_URL + imageUrl
					}
					
					console.log('[Chat] 图片完整URL:', fullImageUrl)
					console.log('[Chat] 发送消息参数:', {
						receiverId: getReceiverIdForMessage(),
						groupId: getGroupIdForMessage(),
						url: fullImageUrl,
						size: imageSize
					})
					
					// 使用消息服务发送图片消息（灰度：V2 双写 fileId + url）
					const message = IM_MEDIA_USE_FILE_ID === 'true'
						? messageService.sendImageMessageV2(
							getReceiverIdForMessage(),
							getGroupIdForMessage(),
							'0',
							fullImageUrl,
							fullImageUrl,
							0,
							0,
							imageSize
						)
						: messageService.sendImageMessage(
							getReceiverIdForMessage(),
							getGroupIdForMessage(),
							fullImageUrl,
							fullImageUrl,  // 缩略图使用同一个 URL
							0,  // 宽度(暂不获取)
							0,  // 高度(暂不获取)
							imageSize
						)
					
					console.log('[Chat] 消息服务返回:', message)
					
					// 如果是群聊，同时保存到群文件
					if (chatType.value === 'group' && result.tempFilePath) {
						uploadGroupFile(targetId.value, result.tempFilePath).then((res : any) => {
							console.log('[Chat] 图片已保存到群文件:', res)
						}).catch((err : any) => {
							console.error('[Chat] 保存图片到群文件失败:', err)
						})
					}
					
					// 转换并添加到消息列表
					const uiMessage = {
						id: message.id.toString(),
						messageId: message.messageId,
						senderId: message.senderId.toString(),
						receiverId: message.receiverId.toString(),
						type: 'image',
						content: fullImageUrl,
						isSelf: true,
						time: new Date(message.timestamp).toLocaleString(),
						timestamp: message.timestamp,
						showTime: true,
						avatarText: message.avatarText,
						avatarBg: message.avatarBg,
						status: message.status
					} as MessageItem
					
					console.log('[Chat] 添加消息到列表:', uiMessage)
					messages.value.push(uiMessage)
				})
				
				console.log('[Chat] 当前消息列表长度:', messages.value.length)
				showPlusMenu.value = false
				
				// 延迟滚动，确保DOM已更新
				setTimeout(() => {
					scrollToBottom()
				}, 100)
			}).catch((err) => {
				console.error('[Chat] 上传图片失败:', err)
				uni.showToast({ title: '上传失败', icon: 'none' })
			})
			return
		}
		
		if (item.nameKey === 'chat.features.camera') {
			// 拍照并上传
			uni.chooseImage({
				count: 1,
				sourceType: ['camera'],
				success: (res) => {
					const filePath = res.tempFilePaths[0]
					uploadFile(filePath, {
						directory: 'im/image',
						onProgress: (progress) => {
							console.log('[Chat] 上传进度:', progress)
						}
					}).then((result) => {
						// 后端返回的 data 字段直接是 URL 字符串
						const imageUrl = typeof result.data === 'string' ? result.data : result.data.url
						const imageSize = result.data.size || 0
						
						// 构建完整URL
						let fullImageUrl = imageUrl
						if (imageUrl.startsWith('/')) {
							fullImageUrl = CONFIG_BASE_URL + imageUrl
						}
						
						console.log('[Chat] 拍照图片URL:', fullImageUrl)
						
						// 使用消息服务发送图片消息
						const message = messageService.sendImageMessage(
							getReceiverIdForMessage(),
							getGroupIdForMessage(),
							fullImageUrl,
							fullImageUrl,  // 缩略图使用同一个 URL
							0,  // 宽度(暂不获取)
							0,  // 高度(暂不获取)
							imageSize
						)
						
						// 如果是群聊，同时保存到群文件
						if (chatType.value === 'group') {
							uploadGroupFile(targetId.value, filePath).then((res : any) => {
								console.log('[Chat] 图片已保存到群文件:', res)
							}).catch((err : any) => {
								console.error('[Chat] 保存图片到群文件失败:', err)
							})
						}
						
						// 转换并添加到消息列表
						const uiMessage = {
							id: message.id.toString(),
							messageId: message.messageId,
							senderId: message.senderId.toString(),
							receiverId: message.receiverId.toString(),
							type: 'image',
							content: fullImageUrl,
							isSelf: true,
							time: new Date(message.timestamp).toLocaleString(),
							timestamp: message.timestamp,
							showTime: true,
							avatarText: message.avatarText,
							avatarBg: message.avatarBg,
							status: message.status
