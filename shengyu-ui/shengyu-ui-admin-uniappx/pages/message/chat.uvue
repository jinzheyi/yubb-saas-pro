	const filteredMentionMembers = computed(() => {
		const kw = mentionKeyword.value != null ? mentionKeyword.value.trim().toLowerCase() : ''
		if (kw === '') {
			return mentionMembers.value
		}
		return mentionMembers.value.filter(item => {
			const displayName = item != null && item.displayName != null ? String(item.displayName).toLowerCase() : ''
			const mentionName = item != null && item.mentionName != null ? String(item.mentionName).toLowerCase() : ''
			const userName = item != null && item.userName != null ? String(item.userName).toLowerCase() : ''
			return displayName.indexOf(kw) > -1 || mentionName.indexOf(kw) > -1 || userName.indexOf(kw) > -1
		})
	})
