<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">聊天文件</text>
			<view class="header-right"></view>
		</view>

		<!-- 分类标签 -->
		<view class="file-tabs">
			<view class="tab-item" v-for="tab in tabs" :key="tab.type" :class="{ 'tab-active': currentTab === tab.type }" @click="switchTab(tab.type)">
				<text class="tab-text" :class="{ 'tab-text-active': currentTab === tab.type }">{{ tab.name }}</text>
			</view>
		</view>

		<!-- 文件列表 -->
		<scroll-view class="file-list" scroll-y="true" show-scrollbar="false">
			<!-- 按日期分组 -->
			<view class="date-group" v-for="group in displayFileGroups" :key="group.date">
				<text class="date-title">{{ group.date }}</text>

				<!-- 文件项 -->
				<view class="file-item" v-for="file in group.files" :key="file.id" @click="handleFileClick(file)" @longpress="handleFileLongPress(file)">
					<!-- 图片类型 -->
					<view v-if="file.type === 'image'" class="file-preview image-preview">
						<image class="preview-image" :src="file.url" mode="aspectFill" />
					</view>

					<!-- 视频类型 -->
					<view v-else-if="file.type === 'video'" class="file-preview video-preview">
						<image class="preview-image" :src="file.thumbnail" mode="aspectFill" />
						<view class="video-play-icon-wrap">
							<text class="iconfont video-play-icon">&#xe602;</text>
						</view>
					</view>

					<!-- 文件类型 -->
					<view v-else class="file-icon-wrap">
						<text class="iconfont file-icon" :style="{ color: getFileColor(file.name) }">{{ getFileIcon(file.name) }}</text>
					</view>

					<view class="file-info">
						<text class="file-name">{{ file.name }}</text>
						<text class="file-meta">{{ file.size }} · {{ file.sender }}</text>
					</view>

					<text class="iconfont more-icon" @click.stop="handleFileMenu(file)">&#xea8d;</text>
				</view>
			</view>

			<!-- 空状态 -->
			<view class="empty-state" v-if="displayFileGroups.length === 0">
				<text class="iconfont empty-icon">&#xea96;</text>
				<text class="empty-text">暂无{{ currentTabName }}文件</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroupFileList, deleteGroupFile, downloadGroupFile } from '../../api/file.uts'

	const { t } = useI18n()

	// 页面参数
	const groupId = ref('')
	const loading = ref(false)

	const currentTab = ref('all')

	const tabs = [
		{ type: 'all', name: '全部' },
		{ type: 'image', name: '图片' },
		{ type: 'video', name: '视频' },
		{ type: 'file', name: '文件' }
	]

	const currentTabName = computed(() : string => {
		const tab = tabs.find(t => t.type === currentTab.value)
		return tab ? tab.name : ''
	})

	// 文件数据
	const allFiles = ref<any[]>([])

	/**
	 * 加载文件列表
	 */
	async function loadFiles() {
		if (!groupId.value) return
		
		try {
			loading.value = true
			const result = await getGroupFileList({
				groupId: groupId.value,
				pageNo: 1,
				pageSize: 100
			})
			
			if (result && result.list) {
				// 转换数据格式
				allFiles.value = result.list.map((item: any) => {
					return {
						id: item.id,
						type: getFileTypeFromName(item.fileName),
						name: item.fileName,
						size: formatFileSize(item.fileSize),
						url: item.fileUrl,
						thumbnail: item.fileUrl,  // 视频缩略图可以后续优化
						createTime: new Date(item.createTime).getTime(),
						sender: item.uploaderName || '未知',
						uploaderId: item.uploaderId
					}
				})
				
				console.log('[ChatFiles] 加载文件列表成功, 数量:', allFiles.value.length)
			}
		} catch (e) {
			console.error('[ChatFiles] 加载文件列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	/**
	 * 根据文件名判断文件类型
	 */
	function getFileTypeFromName(fileName: string): string {
		const ext = fileName.substring(fileName.lastIndexOf('.') + 1).toLowerCase()
		
		const imageExts = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp']
		const videoExts = ['mp4', 'avi', 'mov', 'wmv', 'flv', 'mkv']
		
		if (imageExts.includes(ext)) return 'image'
		if (videoExts.includes(ext)) return 'video'
		
		return 'file'
	}

	/**
	 * 格式化文件大小
	 */
	function formatFileSize(bytes: number): string {
		if (bytes === 0) return '0 B'
		
		const k = 1024
		const sizes = ['B', 'KB', 'MB', 'GB']
		const i = Math.floor(Math.log(bytes) / Math.log(k))
		
		return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i]
	}
	// 过滤后的文件
	const filteredFiles = computed(() : any[] => {
		if (currentTab.value === 'all') {
			return allFiles.value
		}
		return allFiles.value.filter(file => file.type === currentTab.value)
	})

	// 按日期分组
	const displayFileGroups = computed(() : any[] => {
		const groups : any = {}

		filteredFiles.value.forEach(file => {
			const date = new Date(file.createTime)
			const today = new Date()
			const yesterday = new Date(today.getTime() - 24 * 60 * 60 * 1000)

			let dateKey = ''
			if (date.toDateString() === today.toDateString()) {
				dateKey = '今天'
			} else if (date.toDateString() === yesterday.toDateString()) {
				dateKey = '昨天'
			} else {
				const month = (date.getMonth() + 1).toString().padStart(2, '0')
				const day = date.getDate().toString().padStart(2, '0')
				dateKey = `${month}月${day}日`
			}

			if (!groups[dateKey]) {
				groups[dateKey] = []
			}
			groups[dateKey].push(file)
		})

		return Object.keys(groups).map(date => ({
			date,
			files: groups[date]
		}))
	})

	function handleBack() {
		uni.navigateBack()
	}

	function switchTab(type : string) {
		currentTab.value = type
	}

	function getFileIcon(fileName : string) : string {
		const ext = fileName.split('.').pop()?.toLowerCase() || ''
		const iconMap : any = {
			'doc': '\uea96',
			'docx': '\uea96',
			'xls': '\uea96',
			'xlsx': '\uea96',
			'ppt': '\uea96',
			'pptx': '\uea96',
			'pdf': '\uea96',
			'txt': '\uea96',
			'zip': '\uea96',
			'rar': '\uea96'
		}
		return iconMap[ext] || '\uea96'
	}

	function getFileColor(fileName : string) : string {
		const ext = fileName.split('.').pop()?.toLowerCase() || ''
		const colorMap : any = {
			'doc': '#1677FF',
			'docx': '#1677FF',
			'xls': '#10b981',
			'xlsx': '#10b981',
			'ppt': '#f59e0b',
			'pptx': '#f59e0b',
			'pdf': '#F54A45',
			'txt': '#8F959E',
			'zip': '#8b5cf6',
			'rar': '#8b5cf6'
		}
		return colorMap[ext] || '#646A73'
	}

	/**
	 * 点击文件
	 */
	async function handleFileClick(file : any) {
		// 记录下载次数
		try {
			await downloadGroupFile(file.id)
		} catch (e) {
			console.error('[ChatFiles] 记录下载失败:', e)
		}
		
		if (file.type === 'image') {
			// 预览图片
			uni.previewImage({
				urls: [file.url],
				current: file.url
			})
		} else if (file.type === 'video') {
			// 播放视频
			uni.showToast({
				title: '视频播放功能开发中',
				icon: 'none'
			})
		} else {
			// 下载文件
			uni.downloadFile({
				url: file.url,
				success: (res) => {
					if (res.statusCode === 200) {
						uni.showToast({
							title: '下载成功',
							icon: 'success'
						})
						// 可以打开文件预览
						uni.openDocument({
							filePath: res.tempFilePath,
							showMenu: true
						})
					}
				},
				fail: (err) => {
					console.error('[ChatFiles] 下载失败:', err)
					uni.showToast({
						title: '下载失败',
						icon: 'none'
					})
				}
			})
		}
	}

	function handleFileLongPress(file : any) {
		handleFileMenu(file)
	}

	/**
	 * 文件菜单
	 */
	function handleFileMenu(file : any) {
		uni.showActionSheet({
			itemList: ['下载', '转发', '删除'],
			success: async (res) => {
				if (res.tapIndex === 0) {
					// 下载
					handleFileClick(file)
				} else if (res.tapIndex === 1) {
					// 转发
					uni.showToast({
						title: '转发功能开发中',
						icon: 'none'
					})
				} else if (res.tapIndex === 2) {
					// 删除
					uni.showModal({
						title: '删除文件',
						content: '确定要删除这个文件吗？',
						success: async (modalRes) => {
							if (modalRes.confirm) {
								try {
									await deleteGroupFile(file.id)
									uni.showToast({
										title: '删除成功',
										icon: 'success'
									})
									// 刷新列表
									await loadFiles()
								} catch (e) {
									console.error('[ChatFiles] 删除失败:', e)
									uni.showToast({
										title: '删除失败',
										icon: 'none'
									})
								}
							}
						}
					})
				}
			}
		})
	}

	onLoad((options: any) => {
		if (options['groupId']) {
			groupId.value = options['groupId']
			console.log('[ChatFiles] 页面参数:', { groupId: groupId.value })
		}
	})

	onMounted(async () => {
		await loadFiles()
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	/* 分类标签 */
	.file-tabs {
		background-color: #FFFFFF;
		flex-direction: row;
		padding: 0 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.tab-item {
		padding: 12px 16px;
		margin-right: 8px;
		position: relative;
	}

	.tab-text {
		font-size: 15px;
		color: #646A73;
	}

	.tab-active {
		border-bottom-width: 2px;
		border-bottom-color: #1677FF;
	}

	.tab-text-active {
		color: #1677FF;
		font-weight: 600;
	}

	/* 文件列表 */
	.file-list {
		flex: 1;
		height: 0;
	}

	.date-group {
		background-color: #FFFFFF;
		margin-bottom: 10px;
	}

	.date-title {
		font-size: 13px;
		color: #8F959E;
		padding: 12px 16px 8px;
		background-color: #F5F7FA;
	}

	.file-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.file-item:last-child {
		border-bottom-width: 0;
	}

	/* 文件预览 */
	.file-preview {
		width: 50px;
		height: 50px;
		border-radius: 6px;
		overflow: hidden;
		margin-right: 12px;
		flex-shrink: 0;
	}

	.image-preview {
		background-color: #F5F7FA;
	}

	.video-preview {
		background-color: #000000;
		position: relative;
	}

	.preview-image {
		width: 50px;
		height: 50px;
	}

	.video-play-icon-wrap {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		justify-content: center;
		align-items: center;
		background-color: rgba(0, 0, 0, 0.3);
	}

	.video-play-icon {
		font-size: 20px;
		color: #FFFFFF;
	}

	/* 文件图标 */
	.file-icon-wrap {
		width: 50px;
		height: 50px;
		background-color: #F5F7FA;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		flex-shrink: 0;
	}

	.file-icon {
		font-size: 28px;
	}

	.file-info {
		flex: 1;
		min-width: 0;
	}

	.file-name {
		font-size: 15px;
		color: #1F2329;
		margin-bottom: 4px;
		lines: 1;
		text-overflow: ellipsis;
	}

	.file-meta {
		font-size: 12px;
		color: #8F959E;
	}

	.more-icon {
		font-size: 18px;
		color: #8F959E;
		padding: 8px;
		margin-right: -8px;
	}

	/* 空状态 */
	.empty-state {
		padding: 80px 16px;
		align-items: center;
	}

	.empty-icon {
		font-size: 64px;
		color: #E5E5E5;
		margin-bottom: 16px;
	}

	.empty-text {
		font-size: 15px;
		color: #8F959E;
	}
</style>
