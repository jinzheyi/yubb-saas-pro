<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ pageTitle }}</text>
			<view class="header-right"></view>
		</view>

		<!-- 分类标签 -->
		<view class="file-tabs" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<view class="tab-item" :style="{ backgroundColor: currentTab === tab.type ? theme.brandPrimarySoft : theme.cardBgMuted }" v-for="tab in tabs" :key="tab.type" :class="{ 'tab-active': currentTab === tab.type }" @click="switchTab(tab.type)">
				<text class="tab-text" :class="{ 'tab-text-active': currentTab === tab.type }" :style="{ color: currentTab === tab.type ? theme.brandPrimary : theme.textSecondary }">{{ tab.name }}</text>
			</view>
		</view>

		<!-- 文件列表 -->
		<scroll-view class="file-list" scroll-y="true" show-scrollbar="false" 
			@scrolltolower="handleLoadMore" 
			refresher-enabled="true" 
			:refresher-triggered="refreshing" 
			@refresherrefresh="handleRefresh">
			<!-- 按日期分组 -->
			<view class="date-group" v-for="group in displayFileGroups" :key="group.date">
				<text class="date-title" :style="{ color: theme.textTertiary }">{{ group.date }}</text>

				<!-- 文件项 -->
				<view class="file-item" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" v-for="file in group.files" :key="file.id" @click="handleFileClick(file)" @longpress="handleFileLongPress(file)" @mousedown="handleFileMouseDown(file)" @mouseup="handleFileMouseEnd" @mouseleave="handleFileMouseEnd">
					<!-- 图片类型 -->
					<view v-if="file.type === 'image'" class="file-preview image-preview" :style="{ backgroundColor: theme.cardBgMuted }">
						<image class="preview-image" :src="file.url" mode="aspectFill" />
					</view>

					<!-- 视频类型 -->
					<view v-else-if="file.type === 'video'" class="file-preview video-preview" :style="{ backgroundColor: theme.cardBgMuted }">
						<image class="preview-image" :src="file.thumbnail" mode="aspectFill" />
						<view class="video-play-icon-wrap">
							<text class="iconfont video-play-icon">&#xe602;</text>
						</view>
					</view>

					<!-- 文件类型 -->
					<text v-else class="iconfont file-icon" :style="{ color: getFileColor(file.name) }">{{ getFileIcon(file.name) }}</text>

					<view class="file-info">
						<text class="file-name" :style="{ color: theme.textPrimary }">{{ file.name }}</text>
						<text class="file-meta" :style="{ color: theme.textSecondary }">{{ file.size }} · {{ file.sender }}</text>
					</view>

					<text class="iconfont more-icon" :style="{ color: theme.textTertiary }" @click.stop="handleFileMenu(file)">&#xea8d;</text>
				</view>
			</view>

			<!-- 空状态 -->
			<view class="empty-state" v-if="displayFileGroups.length === 0 && !loading">
				<text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xea96;</text>
				<text class="empty-text" :style="{ color: theme.textTertiary }">{{ emptyText }}</text>
			</view>

			<!-- 加载更多提示 -->
			<view class="load-more" v-if="displayFileGroups.length > 0">
				<text class="load-more-text" :style="{ color: theme.textTertiary }" v-if="loadingMore">{{ t('chat.chatFiles.loadingMore') }}</text>
				<text class="load-more-text" :style="{ color: theme.textTertiary }" v-else-if="noMore">{{ t('chat.chatFiles.noMore') }}</text>
				<text class="load-more-text" :style="{ color: theme.textTertiary }" v-else>{{ t('chat.chatFiles.pullMore') }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted } from 'vue'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { getChatMediaList, getFileOpenStrategy } from '../../api/file.uts'
	import { isAuthorizeSettingDenied, readAlbumAuthorized } from '../../utils/app-authorize.uts'
	import { promptOpenAppSettings } from '../../utils/app-settings.uts'
	import { navToFilePreview } from '../../utils/nav.uts'
	import { decodeIdParam } from '../../utils/id-param.uts'
	import { downloadAndOpenDocumentWithRetry, downloadRemoteTempFile } from '../../utils/file.uts'
	import { previewImages } from '../../utils/media-preview.uts'
	import { saveImageToAlbum } from '../../utils/qrcode.uts'
	import { saveVideoFileToAlbum } from '../../utils/album.uts'
	import { armGroupLifecycleErrorToastSuppression, finalizeGroupLifecycleExit, resolveGroupLifecycleErrorNotice } from '../../utils/chat-setting-actions.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import { getHarmonyReadinessSnapshot } from '../../services/harmony-readiness-service.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	// 页面参数
	const chatId = ref('')
	const groupId = ref('')
	const scene = ref('group')
	const loading = ref(false)
	const refreshing = ref(false)
	const loadingMore = ref(false)
	const noMore = ref(false)
	const loadError = ref('')

	const currentTab = ref('all')
	const currentPage = ref(1)
	const pageSize = 20
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	let lifecycleRedirecting = false
	let fileLongPressTimer: any = null
	let suppressNextClickFileId = ''

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const tabs = computed(() => [
		{ type: 'all', name: t('chat.chatFiles.tabAll') },
		{ type: 'image', name: t('chat.chatFiles.tabImage') },
		{ type: 'video', name: t('chat.chatFiles.tabVideo') },
		{ type: 'file', name: t('chat.chatFiles.tabFile') }
	])

	const pageTitle = computed(() : string => {
		return scene.value === 'single' ? t('chat.chatFiles.titleSingle') : t('chat.chatFiles.titleGroup')
	})

	const currentTabName = computed(() : string => {
		const tab = tabs.value.find(t => t.type === currentTab.value)
		return tab ? tab.name : ''
	})

	const emptyText = computed(() : string => {
		if (loadError.value !== '') {
			return loadError.value
		}
		return t('chat.chatFiles.emptyPrefix') + currentTabName.value + t('chat.chatFiles.emptySuffix')
	})

	// 文件数据
	const allFiles = ref<any[]>([])

	/**
	 * 加载文件列表
	 */
	async function loadFiles(isLoadMore: boolean = false) {
		if (lifecycleRedirecting) {
			return
		}
		if (!chatId.value) {
			loadError.value = t('chat.chatFiles.conversationNotLoaded')
			return
		}
		
		// 防止重复加载
		if (isLoadMore && (loadingMore.value || noMore.value)) return
		if (!isLoadMore && loading.value) return
		
		try {
			if (!isLoadMore) {
				loadError.value = ''
			}
			if (isLoadMore) {
				loadingMore.value = true
			} else {
				loading.value = true
			}
			
			// 根据当前tab构建请求参数
			const params: any = {
				chatId: chatId.value,
				pageNo: currentPage.value,
				pageSize: pageSize
			}
			
			// 如果不是"全部"tab，传递fileType参数
			if (currentTab.value !== 'all') {
				params.fileType = currentTab.value
			}
			if (scene.value === 'group' && groupId.value) {
				armGroupLifecycleErrorToastSuppression(3000)
			}
			const result = await getChatMediaList(params)
			
			if (result && result.list) {
				// 转换数据格式
				const newFiles = result.list.map((item: any) => {
					const sendTime = item.sendTime ? new Date(item.sendTime).getTime() : Date.now()
					return {
						id: item.messageId != null ? item.messageId.toString() : '0',
						messageId: item.messageId != null ? item.messageId.toString() : '0',
						type: item.mediaType || getFileTypeFromName(item.fileName || ''),
						name: item.fileName || t('chat.chatFiles.titleSingle'),
						size: formatFileSize(item.fileSize || 0),
						url: item.fileUrl,
						thumbnail: item.fileUrl,  // 视频缩略图可以后续优化
						createTime: sendTime,
						sender: item.senderNickname || t('chat.chatFiles.unknownSender'),
						uploaderId: item.senderId != null ? item.senderId.toString() : '0',
						fileId: item.fileId != null ? item.fileId.toString() : ''
					}
				})
				
				if (isLoadMore) {
					// 加载更多：追加数据
					allFiles.value = allFiles.value.concat(newFiles)
				} else {
					// 首次加载或刷新：替换数据
					allFiles.value = newFiles
				}
				
				// 判断是否还有更多数据
				if (newFiles.length < pageSize) {
					noMore.value = true
				} else {
					noMore.value = false
				}
				
				console.log('[ChatFiles] 加载文件列表成功, 当前页:', currentPage.value, '数量:', newFiles.length, '总数:', allFiles.value.length)
			}
		} catch (e) {
			console.error('[ChatFiles] 加载文件列表失败:', e)
			if (scene.value === 'group' && groupId.value) {
				const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
				if (lifecycleNotice !== '') {
					lifecycleRedirecting = true
					finalizeGroupLifecycleExit(groupId.value, chatId.value, lifecycleNotice)
					return
				}
			}
			loadError.value = t('chat.chatFiles.loadFailed')
			if (!isLoadMore) {
				uni.showToast({
					title: t('chat.chatFiles.loadFailed'),
					icon: 'none'
				})
			}
		} finally {
			loading.value = false
			loadingMore.value = false
			refreshing.value = false
		}
	}

	/**
	 * 根据文件名判断文件类型
	 */
	function getFileTypeFromName(fileName: string): string {
		const ext = fileName.substring(fileName.lastIndexOf('.') + 1).toLowerCase()
		
		const imageExts = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp']
		const videoExts = ['mp4', 'avi', 'mov', 'wmv', 'flv', 'mkv']
		
		if (imageExts.includes(ext)) return 'image'
		if (videoExts.includes(ext)) return 'video'
		
		return 'file'
	}

	/**
	 * 格式化文件大小
	 */
	function formatFileSize(bytes: number): string {
		if (bytes === 0) return '0 B'
		
		const k = 1024
		const sizes = ['B', 'KB', 'MB', 'GB']
		const i = Math.floor(Math.log(bytes) / Math.log(k))
		
		return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i]
	}
	// 过滤后的文件（现在由后端过滤，前端直接使用）
	const filteredFiles = computed(() : any[] => {
		return allFiles.value
	})

	// 按日期分组
	const displayFileGroups = computed(() : any[] => {
		const groups : any = {}

		filteredFiles.value.forEach(file => {
			const date = new Date(file.createTime)
			const today = new Date()
			const yesterday = new Date(today.getTime() - 24 * 60 * 60 * 1000)

			let dateKey = ''
			if (date.toDateString() === today.toDateString()) {
				dateKey = t('chat.chatFiles.today')
			} else if (date.toDateString() === yesterday.toDateString()) {
				dateKey = t('chat.chatFiles.yesterday')
			} else {
				const month = (date.getMonth() + 1).toString().padStart(2, '0')
				const day = date.getDate().toString().padStart(2, '0')
				dateKey = t('chat.chatFiles.monthDay', { month, day })
			}

			if (!groups[dateKey]) {
				groups[dateKey] = []
			}
			groups[dateKey].push(file)
		})

		return Object.keys(groups).map(date => ({
			date,
			files: groups[date]
		}))
	})

	function handleBack() {
		uni.navigateBack()
	}

	function switchTab(type : string) {
		currentTab.value = type
		// 切换tab时重置分页并重新加载
		currentPage.value = 1
		noMore.value = false
		allFiles.value = []
		loadFiles()
	}

	/**
	 * 下拉刷新
	 */
	function handleRefresh() {
		refreshing.value = true
		currentPage.value = 1
		noMore.value = false
		loadFiles()
	}

	/**
	 * 上拉加载更多
	 */
	function handleLoadMore() {
		if (loadingMore.value || noMore.value) return
		currentPage.value++
		loadFiles(true)
	}

	function getFileIcon(fileName : string) : string {
		const ext = fileName.split('.').pop()?.toLowerCase() || ''
		if (ext === 'pdf') {
			return '\ue60c'
		}
		if (ext === 'txt' || ext === 'log' || ext === 'md' || ext === 'json' || ext === 'xml' || ext === 'yml' || ext === 'yaml') {
			return '\ue854'
		}
		if (ext === 'zip' || ext === 'rar' || ext === '7z' || ext === 'tar' || ext === 'gz' || ext === 'bz2' || ext === 'xz') {
			return '\ue6d6'
		}
		if (ext === 'doc' || ext === 'docx' || ext === 'dot' || ext === 'dotx') {
			return '\ue6ab'
		}
		if (ext === 'xls' || ext === 'xlsx' || ext === 'csv') {
			return '\ue6a4'
		}
		if (ext === 'ppt' || ext === 'pptx' || ext === 'pps' || ext === 'ppsx') {
			return '\ue6a5'
		}
		if (ext === 'html' || ext === 'htm') {
			return '\ue609'
		}
		if (ext === 'sql') {
			return '\ue69b'
		}
		return '\ue603'
	}

	function getFileColor(fileName : string) : string {
		const ext = fileName.split('.').pop()?.toLowerCase() || ''
		const colorMap : any = {
			'doc': '#1677FF',
			'docx': '#1677FF',
			'xls': '#10b981',
			'xlsx': '#10b981',
			'ppt': '#f59e0b',
			'pptx': '#f59e0b',
			'pdf': '#F54A45',
			'txt': '#4A90E2',
			'zip': '#586c76',
			'rar': '#586c76'
		}
		return colorMap[ext] || '#646A73'
	}

	/**
	 * 点击文件
	 */
	async function handleFileClick(file : any) {
		const fileId = file != null && file.id != null ? String(file.id) : ''
		if (fileId !== '' && fileId === suppressNextClickFileId) {
			suppressNextClickFileId = ''
			return
		}
		if (file.type === 'image') {
			const imageUrls = filteredFiles.value
				.filter((item : any) => item.type === 'image' && item.url)
				.map((item : any) => item.url)
			void previewImages(imageUrls.length > 0 ? imageUrls : [file.url], file.url).catch((_err) => {
				uni.showToast({ title: t('runtime.filePreview.openFailed'), icon: 'none' })
			})
		} else if (file.type === 'video') {
			// 播放视频
			uni.navigateTo({
				url: `/pages/message/video-player?url=${encodeURIComponent(file.url)}&title=${encodeURIComponent(file.name)}`
			})
		} else {
			const fid = file && file.fileId != null ? String(file.fileId) : null
			const url = file && file.url ? String(file.url) : null
			const name = file && file.name ? String(file.name) : null
			navToFilePreview({ fileId: fid, url: url, name: name })
		}
	}

	function handleFileLongPress(file : any) {
		handleFileMenu(file)
	}

	function clearFileLongPressTimer(): void {
		if (fileLongPressTimer != null) {
			clearTimeout(fileLongPressTimer)
			fileLongPressTimer = null
		}
	}

	function handleFileMouseDown(file : any): void {
		try {
			clearFileLongPressTimer()
			const fileId = file != null && file.id != null ? String(file.id) : ''
			if (fileId === '') {
				return
			}
			fileLongPressTimer = setTimeout(() => {
				fileLongPressTimer = null
				suppressNextClickFileId = fileId
				handleFileLongPress(file)
			}, 450)
		} catch (e) {
			clearFileLongPressTimer()
		}
	}

	function handleFileMouseEnd(): void {
		clearFileLongPressTimer()
	}

	function openUrlInBrowser(url : string) : boolean {
		try {
			const globalAny : any = globalThis as any
			if (globalAny != null && globalAny.window != null && globalAny.window.open != null) {
				globalAny.window.open(url, '_blank')
				return true
			}
		} catch (e) {
		}
		return false
	}

	function triggerBrowserDownload(url : string, fileName : string) : boolean {
		try {
			const globalAny : any = globalThis as any
			if (globalAny == null || globalAny.document == null) {
				return false
			}
			const doc = globalAny.document
			if (doc.createElement == null || doc.body == null) {
				return false
			}
			const link = doc.createElement('a')
			link.href = url
			link.target = '_blank'
			if (fileName && link.download != null) {
				link.download = fileName
			}
			if (doc.body.appendChild != null) {
				doc.body.appendChild(link)
			}
			if (link.click != null) {
				link.click()
			}
			if (doc.body.removeChild != null) {
				doc.body.removeChild(link)
			}
			return true
		} catch (e) {
		}
		return false
	}

	function promptAlbumPermissionDenied(): void {
		const message = t('chat.chatFiles.albumPermissionContent')
		promptOpenAppSettings(message, t('common.confirmTitle'), t('chat.recording.goSetting'))
	}

	async function handleDownloadFile(file : any) {
		const url = file && file.url != null ? String(file.url).trim() : ''
		const fileName = file && file.name != null ? String(file.name) : t('chat.chatFiles.titleSingle')
		const harmonySnapshot = getHarmonyReadinessSnapshot()
		if (url === '') {
			uni.showToast({
				title: t('chat.chatFiles.downloadAddressEmpty'),
				icon: 'none'
			})
			return
		}

		if (file.type === 'image') {
			if (harmonySnapshot.isHarmony && !harmonySnapshot.saveImageToAlbumReady) {
				uni.showToast({ title: t('chat.chatFiles.imageSaveUnsupported'), icon: 'none' })
				return
			}
			if (harmonySnapshot.isHarmony && isAuthorizeSettingDenied(readAlbumAuthorized())) {
				promptAlbumPermissionDenied()
				return
			}
			try {
				if (triggerBrowserDownload(url, fileName) || openUrlInBrowser(url)) {
					return
				}
				uni.showLoading({ title: t('chat.chatFiles.downloading') })
				const tempFilePath = await downloadRemoteTempFile(url)
				await saveImageToAlbum(tempFilePath)
				uni.showToast({ title: t('chat.chatFiles.savedToAlbum'), icon: 'success' })
			} catch (e) {
				uni.showToast({ title: t('chat.chatFiles.saveFailed'), icon: 'none' })
			} finally {
				uni.hideLoading()
			}
			return
		}

		if (file.type === 'video') {
			if (harmonySnapshot.isHarmony && !harmonySnapshot.saveVideoToAlbumReady) {
				uni.showToast({ title: t('chat.chatFiles.videoSaveUnsupported'), icon: 'none' })
				return
			}
			if (harmonySnapshot.isHarmony && isAuthorizeSettingDenied(readAlbumAuthorized())) {
				promptAlbumPermissionDenied()
				return
			}
			try {
				if (triggerBrowserDownload(url, fileName) || openUrlInBrowser(url)) {
					return
				}
				uni.showLoading({ title: t('chat.chatFiles.downloading') })
				const tempFilePath = await downloadRemoteTempFile(url)
				await saveVideoFileToAlbum(tempFilePath)
				uni.showToast({ title: t('chat.chatFiles.savedToAlbum'), icon: 'success' })
			} catch (e) {
				const errMsg = e != null && (e as any).message != null ? String((e as any).message) : ''
				if (harmonySnapshot.isHarmony && errMsg.indexOf('saveVideoToPhotosAlbum unavailable') > -1) {
					uni.showToast({ title: t('chat.chatFiles.videoSaveUnsupported'), icon: 'none' })
				} else {
					uni.showToast({ title: t('chat.chatFiles.saveFailed'), icon: 'none' })
				}
			} finally {
				uni.hideLoading()
			}
			return
		}

		try {
			const fid = file && file.fileId != null ? String(file.fileId).trim() : ''
			let downloadUrl = url
			if (fid !== '' && fid !== '0') {
				const strategy : any = await getFileOpenStrategy(fid, 600)
				if (strategy && strategy.downloadUrl) {
					downloadUrl = String(strategy.downloadUrl)
				}
			}
			if (triggerBrowserDownload(downloadUrl, fileName)) {
				return
			}
			await downloadAndOpenDocumentWithRetry(downloadUrl, t('chat.chatFiles.downloading'))
		} catch (e) {
			uni.showToast({ title: t('chat.chatFiles.downloadFailed'), icon: 'none' })
		}
	}

	function handleForwardFile(file : any) {
		const messageId = file && file.messageId != null ? String(file.messageId) : ''
		if (messageId === '' || messageId === '0') {
			uni.showToast({
				title: t('chat.chatFiles.forwardUnsupported'),
				icon: 'none'
			})
			return
		}
		uni.navigateTo({
			url: `/pages/message/forward-target?messageIds=${encodeURIComponent(messageId)}&forwardType=1`
		})
	}

	/**
	 * 文件菜单
	 */
	function handleFileMenu(file : any) {
		uni.showActionSheet({
			itemColor: theme.value.brandPrimary,
			itemList: [t('chat.chatFiles.actionDownload'), t('chat.chatFiles.actionForward')],
			success: async (res) => {
				if (res.tapIndex === 0) {
					await handleDownloadFile(file)
				} else if (res.tapIndex === 1) {
					handleForwardFile(file)
				}
			}
		})
	}

	onLoad((options: any) => {
		if (options['chatId']) {
			chatId.value = decodeIdParam(options['chatId'])
		}
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}
		if (options['scene']) {
			scene.value = String(options['scene'])
		}
		console.log('[ChatFiles] 页面参数:', { chatId: chatId.value, groupId: groupId.value, scene: scene.value })
	})

	onMounted(async () => {
		if (!chatId.value) {
			loadError.value = t('chat.chatFiles.conversationNotLoaded')
			uni.showToast({
				title: t('chat.chatFiles.conversationNotLoaded'),
				icon: 'none'
			})
			return
		}
		await loadFiles()
	})

	onUnload(() => {
		clearFileLongPressTimer()
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

