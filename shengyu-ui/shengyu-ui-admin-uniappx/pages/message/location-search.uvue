<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>

		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.locationSearch.title') }}</text>
			<view class="header-right" @click="confirmSend">
				<text class="iconfont confirm-icon" :style="{ color: theme.brandPrimary }">&#xe65f;</text>
			</view>
		</view>

		<view class="search-wrap" :style="{ backgroundColor: theme.headerBg }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input
					class="search-input"
					:style="{ color: theme.inputText }"
					v-model="keyword"
					:placeholder="t('chat.locationSearch.searchPlaceholder')"
					confirm-type="search"
					@confirm="handleSearch"
				/>
				<view v-if="keyword !== ''" class="clear-btn" @click="clearKeyword">
					<text class="iconfont clear-icon" :style="{ color: theme.textTertiary }">&#xe600;</text>
				</view>
			</view>
		</view>

		<!-- 地图区域 -->
		<view class="map-container" v-if="!mapLoadError">
			<map
				id="locationMap"
				class="map"
				:latitude="mapCenterLat"
				:longitude="mapCenterLng"
				:scale="mapScale"
				:show-location="true"
				:enable-scroll="true"
				:enable-zoom="true"
				@regionchange="onMapRegionChange"
				@error="onMapError"
			/>
			<!-- 中心点标记（固定居中，不随地图移动） -->
			<view class="center-marker">
				<view class="marker-pin"></view>
				<view class="marker-shadow"></view>
			</view>
			<!-- 地图加载中 -->
			<view v-if="mapLoading" class="map-loading-overlay" :style="{ backgroundColor: theme.overlayMask }">
				<text class="map-loading-text" :style="{ color: theme.textPrimary }">{{ t('chat.locationSearch.mapLoading') }}</text>
			</view>
		</view>

		<!-- 地图加载失败提示 -->
		<view v-else class="map-error-wrap" :style="{ backgroundColor: theme.cardBg }">
			<text class="iconfont map-error-icon">&#xe671;</text>
			<text class="map-error-text" :style="{ color: theme.textPrimary }">{{ t('chat.locationSearch.mapLoadFailed') }}</text>
			<text class="map-error-tip" :style="{ color: theme.textTertiary }">{{ t('chat.locationSearch.mapLoadFailedTip') }}</text>
		</view>

		<!-- 当前位置发送区域 -->
		<view class="current-location-section" :style="{ backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<view class="current-location-item" :style="{ borderBottomColor: theme.borderColor }" @click="sendCurrentLocation" hover-class="item-active">
				<view class="current-location-icon-wrap" :style="{ backgroundColor: theme.brandPrimarySoft }">
					<text class="iconfont current-location-icon" :style="{ color: theme.brandPrimary }">&#xea72;</text>
				</view>
				<view class="current-location-info">
					<text class="current-location-title" :style="{ color: theme.textPrimary }">{{ t('chat.locationSearch.sendCurrentLocation') }}</text>
					<text class="current-location-desc" :style="{ color: theme.textTertiary }" v-if="currentAddress !== ''">{{ currentAddress }}</text>
					<text class="current-location-desc" :style="{ color: theme.textTertiary }" v-else-if="locationLoading">{{ t('chat.locationSearch.locating') }}</text>
					<text class="current-location-desc" :style="{ color: theme.textTertiary }" v-else-if="locationError !== ''">{{ locationError }}</text>
					<text class="current-location-desc" :style="{ color: theme.textTertiary }" v-else>{{ t('chat.locationSearch.tapToLocate') }}</text>
				</view>
			</view>
			<!-- #ifdef WEB -->
			<view class="web-accuracy-tip" :style="{ backgroundColor: theme.brandPrimarySoft, borderTopColor: theme.borderColor }">
				<text class="iconfont web-tip-icon" :style="{ color: theme.brandPrimary }">&#xe671;</text>
				<text class="web-tip-text" :style="{ color: theme.textSecondary }">{{ t('chat.locationSearch.webAccuracyTip') }}</text>
			</view>
			<!-- #endif -->
		</view>

		<!-- 搜索结果/附近地点列表 -->
		<view class="list-header" :style="{ backgroundColor: theme.pageBg }">
			<text class="list-title" :style="{ color: theme.textTertiary }">{{ listTitle }}</text>
		</view>

		<scroll-view class="content" :style="{ backgroundColor: theme.cardBg }" scroll-y="true" show-scrollbar="false">
			<!-- 加载中 -->
			<view v-if="poiLoading" class="state-wrap">
				<text class="state-text" :style="{ color: theme.textTertiary }">{{ t('chat.locationSearch.locating') }}</text>
			</view>

			<!-- 额度耗尽状态 -->
			<view v-else-if="quotaExhausted" class="quota-exhausted">
				<text class="iconfont quota-icon">&#xe671;</text>
				<text class="quota-title" :style="{ color: theme.textPrimary }">{{ t('chat.locationSearch.quotaTitle') }}</text>
				<text class="quota-desc" :style="{ color: theme.textTertiary }">{{ t('chat.locationSearch.quotaDesc') }}</text>
				<text class="quota-tip" :style="{ color: theme.brandPrimary }">{{ t('chat.locationSearch.quotaTip') }}</text>
			</view>

			<!-- 服务未开启 -->
			<view v-else-if="serviceDisabled" class="service-disabled">
				<text class="iconfont disabled-icon">&#xe671;</text>
				<text class="disabled-title" :style="{ color: theme.textPrimary }">{{ t('chat.locationSearch.serviceDisabledTitle') }}</text>
				<text class="disabled-desc" :style="{ color: theme.textTertiary }">{{ t('chat.locationSearch.serviceDisabledDesc') }}</text>
			</view>

			<!-- 空列表 -->
			<view v-else-if="list.length === 0 && !poiLoading" class="state-wrap">
				<text class="state-text" :style="{ color: theme.textTertiary }">{{ keyword !== '' ? t('chat.locationSearch.noSearchResult') : t('chat.locationSearch.noNearbyResult') }}</text>
			</view>

			<!-- POI 列表 -->
			<view v-else class="poi-list">
				<view
					v-for="(item, index) in list"
					:key="item.poiId + '-' + index"
					:class="['poi-item', selectedPoiId === item.poiId ? 'poi-item-selected' : '']"
					:style="{ borderBottomColor: theme.borderColor }"
					hover-class="poi-item-active"
					@click="selectPoi(item)"
				>
					<view class="poi-main">
						<text class="poi-name" :style="{ color: theme.textPrimary }">{{ item.name }}</text>
						<text class="poi-address" :style="{ color: theme.textTertiary }">{{ item.address }}</text>
					</view>
					<text v-if="selectedPoiId === item.poiId" class="iconfont poi-check" :style="{ color: theme.brandPrimary }">&#xe65f;</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { onLoad, onUnload, onReady } from '@dcloudio/uni-app'
import { useI18n } from '../../hooks/useI18n.uts'
import { searchLocation } from '../../api/message.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import { getHarmonyReadinessSnapshot } from '../../services/harmony-readiness-service.uts'
import type { ThemeTokens } from '../../config/theme.uts'
const { t } = useI18n()

type PoiItem = {
	poiId: string
	name: string
	address: string
	latitude: number
	longitude: number
	provider: string
}

const keyword = ref('')
const poiLoading = ref(false)
const list = ref<PoiItem[]>([])
const listTitle = ref(t('chat.locationSearch.nearbyTitle'))
const quotaExhausted = ref(false)
const serviceDisabled = ref(false)
const theme = ref<ThemeTokens>(getThemeTokens())

// 地图相关状态
const mapCenterLat = ref(28.6837)
const mapCenterLng = ref(115.8579)
const mapScale = ref(16)
const mapLoading = ref(true)
const mapLoadError = ref(false)

// 当前定位
const currentLatitude = ref(0.0)
const currentLongitude = ref(0.0)
const currentAddress = ref('')
const locationLoading = ref(false)
const locationError = ref('')

// 选中的 POI
const selectedPoiId = ref('')
const selectedPoi = ref<PoiItem | null>(null)

let mapContext: any = null
let regionChangeTimer: number | null = null
let mapLoadTimeout: number | null = null
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
	theme.value = tokens
})

onLoad(() => {
	console.log('[LocationSearch] onLoad')
	void initLocation()

	// 设置地图加载超时检测（5秒）
	mapLoadTimeout = setTimeout(() => {
		if (mapLoading.value) {
			console.warn('[LocationSearch] Map load timeout, fallback to list mode')
			mapLoadError.value = true
			mapLoading.value = false
		}
	}, 5000)
})

onReady(() => {
	console.log('[LocationSearch] onReady')
	try {
		mapContext = uni.createMapContext('locationMap')
		mapLoading.value = false
		if (mapLoadTimeout != null) {
			clearTimeout(mapLoadTimeout)
			mapLoadTimeout = null
		}
		console.log('[LocationSearch] mapContext created')
	} catch (e) {
		console.error('[LocationSearch] createMapContext error:', e)
		mapLoadError.value = true
		mapLoading.value = false
		if (mapLoadTimeout != null) {
			clearTimeout(mapLoadTimeout)
			mapLoadTimeout = null
		}
	}
})

onUnload(() => {
	if (regionChangeTimer != null) {
		clearTimeout(regionChangeTimer)
		regionChangeTimer = null
	}
	if (mapLoadTimeout != null) {
		clearTimeout(mapLoadTimeout)
		mapLoadTimeout = null
	}
	if (unsubscribeTheme != null) {
		unsubscribeTheme()
		unsubscribeTheme = null
	}
})

function handleBack(): void {
	uni.navigateBack()
}

function clearKeyword(): void {
	keyword.value = ''
	listTitle.value = t('chat.locationSearch.nearbyTitle')
	selectedPoiId.value = ''
	selectedPoi.value = null
	void loadNearbyPoi(mapCenterLat.value, mapCenterLng.value)
}

async function initLocation(): Promise<void> {
	locationLoading.value = true
	locationError.value = ''

	try {
		const readinessNotice = resolveHarmonyLocationNotice()
		if (readinessNotice !== '') {
			locationError.value = readinessNotice
			await loadNearbyPoi(mapCenterLat.value, mapCenterLng.value)
			return
		}
		const loc = await getDeviceLocation()
		if (loc != null) {
			currentLatitude.value = loc.latitude
			currentLongitude.value = loc.longitude
			currentAddress.value = loc.address != null ? loc.address : ''

			// 初始化地图中心点为当前位置
			mapCenterLat.value = loc.latitude
			mapCenterLng.value = loc.longitude

			console.log('[LocationSearch] Location obtained:', currentLatitude.value, currentLongitude.value)
			await loadNearbyPoi(loc.latitude, loc.longitude)
		} else {
			locationError.value = t('chat.locationSearch.locationUnavailable')
			console.warn('[LocationSearch] Failed to get location')
			// 使用默认位置加载附近 POI
			await loadNearbyPoi(mapCenterLat.value, mapCenterLng.value)
		}
	} catch (e) {
		locationError.value = t('chat.locationSearch.locationFailed')
		console.error('[LocationSearch] initLocation error:', e)
	} finally {
		locationLoading.value = false
	}
}

function resolveHarmonyLocationNotice(): string {
	const snapshot = getHarmonyReadinessSnapshot()
	if (!snapshot.isHarmony) {
		return ''
	}
	if (!snapshot.locationPermissionBridgeReady) {
		return t('chat.locationSearch.harmonyBridgePending')
	}
	if (snapshot.locationEnabled === false) {
		return t('chat.locationSearch.harmonyLocationSwitchOff')
	}
	if (snapshot.locationAuthorized === 'denied') {
		return t('chat.locationSearch.harmonyPermissionDenied')
	}
	return ''
}

function getDeviceLocation(): Promise<{ latitude: number; longitude: number; address: string | null } | null> {
	return new Promise((resolve) => {
		// App 端：使用 uni.getLocation，开启高精度模式
		// H5 端：uni.getLocation 依赖腾讯地图 JS SDK 做坐标转换，失败时走浏览器备选
		// 不传 geocode:true，避免触发额外反地理编码（耗时且易失败）
		// #ifdef APP
		uni.getLocation({
			type: 'gcj02',
			isHighAccuracy: true,
			highAccuracyExpireTime: 5000,
			timeout: 8000,
			success: (res: UniNamespace.GetLocationSuccess) => {
				console.log('[LocationSearch] App getLocation success:', res.latitude, res.longitude)
				resolve({ latitude: res.latitude, longitude: res.longitude, address: null })
			},
			fail: (err: UniNamespace.GetLocationFail) => {
				console.warn('[LocationSearch] App getLocation fail:', err)
				resolve(null)
			}
		})
		// #endif
		// #ifdef WEB
		// H5 端：先用 uni.getLocation（有腾讯 JS SDK 时可完成 WGS84→GCJ02 转换）
		// 失败时立即用浏览器网络定位（不开高精度，避免 Mac 无 GPS 导致 CoreLocation 报错卡住）
		uni.getLocation({
			type: 'gcj02',
			timeout: 5000,
			success: (res: UniNamespace.GetLocationSuccess) => {
				console.log('[LocationSearch] Web uni.getLocation success:', res.latitude, res.longitude)
				resolve({ latitude: res.latitude, longitude: res.longitude, address: null })
			},
			fail: (err: UniNamespace.GetLocationFail) => {
				console.warn('[LocationSearch] Web uni.getLocation fail, fallback to browser:', err)
				tryBrowserGeolocation(resolve)
			}
		})
		// #endif
	})
}

// #ifdef WEB
function tryBrowserGeolocation(resolve: (value: { latitude: number; longitude: number; address: string | null } | null) => void): void {
	try {
		const nav = (globalThis as any).navigator
		if (nav == null || nav.geolocation == null) {
			console.warn('[LocationSearch] navigator.geolocation not available')
			resolve(null)
			return
		}
		nav.geolocation.getCurrentPosition(
			(position: any) => {
				const lat = position != null && position.coords != null ? Number(position.coords.latitude) : NaN
				const lng = position != null && position.coords != null ? Number(position.coords.longitude) : NaN
				if (!isNaN(lat) && !isNaN(lng)) {
					console.log('[LocationSearch] browser geolocation success:', lat, lng)
					resolve({ latitude: lat, longitude: lng, address: null })
				} else {
					resolve(null)
				}
			},
			(error: any) => {
				console.error('[LocationSearch] browser geolocation error:', error)
				resolve(null)
			},
			{
				// 不开高精度：Mac 无 GPS 硬件，开启后 CoreLocation 报错并长时间阻塞
				// 关闭后浏览器直接用 WiFi/IP 定位，秒级返回
				enableHighAccuracy: false,
				timeout: 5000,
				maximumAge: 0
			}
		)
	} catch (e) {
		console.error('[LocationSearch] tryBrowserGeolocation error:', e)
		resolve(null)
	}
}
// #endif

function onMapRegionChange(e: any): void {
	// 仅在拖动结束时处理
	const eventType = e != null && e.type != null ? String(e.type) : ''
	if (eventType !== 'end') {
		return
	}

	// 防抖处理
	if (regionChangeTimer != null) {
		clearTimeout(regionChangeTimer)
	}

	regionChangeTimer = setTimeout(() => {
		void handleMapCenterChange()
	}, 300)
}

async function handleMapCenterChange(): Promise<void> {
	if (mapContext == null) {
		console.warn('[LocationSearch] mapContext is null')
		return
	}

	try {
		// 获取地图中心点
		mapContext.getCenterLocation({
			success: (res: any) => {
				const lat = res != null && res.latitude != null ? Number(res.latitude) : NaN
				const lng = res != null && res.longitude != null ? Number(res.longitude) : NaN

				if (!isNaN(lat) && !isNaN(lng)) {
					console.log('[LocationSearch] Map center changed:', lat, lng)
					mapCenterLat.value = lat
					mapCenterLng.value = lng

					// 清除选中状态
					selectedPoiId.value = ''
					selectedPoi.value = null

					// 刷新附近 POI
					if (keyword.value.trim() === '') {
						listTitle.value = t('chat.locationSearch.nearbyTitle')
						void loadNearbyPoi(lat, lng)
					} else {
						void loadSearchPoi(keyword.value.trim(), lat, lng)
					}
				}
			},
			fail: (err: any) => {
				console.error('[LocationSearch] getCenterLocation fail:', err)
			}
		})
	} catch (e) {
		console.error('[LocationSearch] handleMapCenterChange error:', e)
	}
}

function onMapError(e: any): void {
	console.error('[LocationSearch] map error:', e)
	mapLoadError.value = true
	mapLoading.value = false
}

async function handleSearch(): Promise<void> {
	const kw = keyword.value.trim()
	selectedPoiId.value = ''
	selectedPoi.value = null

	if (kw === '') {
		listTitle.value = t('chat.locationSearch.nearbyTitle')
		await loadNearbyPoi(mapCenterLat.value, mapCenterLng.value)
		return
	}
	listTitle.value = t('chat.locationSearch.searchResultTitle')
	await loadSearchPoi(kw, mapCenterLat.value, mapCenterLng.value)
}

async function loadNearbyPoi(lat: number, lng: number): Promise<void> {
	if (lat === 0 && lng === 0) {
		list.value = []
		return
	}

	try {
		poiLoading.value = true
		quotaExhausted.value = false
		serviceDisabled.value = false

		const resp: any = await searchLocation('', lat, lng, 10)
		poiLoading.value = false
		applyResult(resp)
	} catch (e: any) {
		poiLoading.value = false
		console.error('[LocationSearch] loadNearbyPoi error:', e)
		uni.showToast({ title: t('chat.locationSearch.nearbyLoadFailed'), icon: 'none' })
	}
}

async function loadSearchPoi(kw: string, lat: number, lng: number): Promise<void> {
	try {
		poiLoading.value = true
		quotaExhausted.value = false
		serviceDisabled.value = false

		const resp: any = await searchLocation(kw, lat, lng, 20)
		poiLoading.value = false
		applyResult(resp)
	} catch (e: any) {
		poiLoading.value = false
		console.error('[LocationSearch] loadSearchPoi error:', e)
		uni.showToast({ title: t('chat.locationSearch.searchFailed'), icon: 'none' })
	}
}

function applyResult(resp: any): void {
	quotaExhausted.value = false
	serviceDisabled.value = false

	const enabled = resp != null && (resp as any).enabled !== false
	const msg = resp != null && (resp as any).message != null ? String((resp as any).message) : ''

	if (!enabled) {
		list.value = []
		if (msg.indexOf('额度') !== -1 || msg.indexOf('quota') !== -1) {
			quotaExhausted.value = true
		} else {
			serviceDisabled.value = true
		}
		return
	}

	if (msg !== '' && (msg.indexOf('额度') !== -1 || msg.indexOf('quota') !== -1)) {
		quotaExhausted.value = true
		list.value = []
		return
	}

	const poisRaw: any[] = resp != null && Array.isArray((resp as any).pois) ? (resp as any).pois : []
	list.value = poisRaw.map((item: any): PoiItem => {
		return {
			poiId: item != null && item.poiId != null ? String(item.poiId) : '',
			name: item != null && item.name != null ? String(item.name) : '',
			address: item != null && item.address != null ? String(item.address) : '',
			latitude: item != null && item.latitude != null ? Number(item.latitude) : NaN,
			longitude: item != null && item.longitude != null ? Number(item.longitude) : NaN,
			provider: item != null && item.provider != null ? String(item.provider) : 'tencent'
		}
	}).filter((item: PoiItem): boolean => item.name !== '' && !isNaN(item.latitude) && !isNaN(item.longitude))

	// 默认选中第一个
	if (list.value.length > 0) {
		const firstPoi = list.value[0]
		selectedPoiId.value = firstPoi.poiId
		selectedPoi.value = firstPoi
		// 如果当前位置地址未获取到，用第一个 POI 的地址补充
		if (currentAddress.value === '' && listTitle.value === t('chat.locationSearch.nearbyTitle')) {
			currentAddress.value = firstPoi.name !== '' ? firstPoi.name : firstPoi.address
		}
	}

	if (msg !== '' && msg.indexOf('额度') === -1) {
		uni.showToast({ title: msg, icon: 'none' })
	}
}

function selectPoi(item: PoiItem): void {
	selectedPoiId.value = item.poiId
	selectedPoi.value = item

	// 移动地图中心到选中的 POI
	if (mapContext != null && !isNaN(item.latitude) && !isNaN(item.longitude)) {
		mapCenterLat.value = item.latitude
		mapCenterLng.value = item.longitude
	}
}

function sendCurrentLocation(): void {
	if (locationLoading.value) {
		uni.showToast({ title: t('chat.locationSearch.locatingWait'), icon: 'none' })
		return
	}

	const readinessNotice = resolveHarmonyLocationNotice()
	if (readinessNotice !== '') {
		uni.showToast({ title: readinessNotice, icon: 'none' })
		return
	}

	if (currentLatitude.value === 0 && currentLongitude.value === 0) {
		uni.showModal({
			title: t('chat.locationSearch.locateFailedTitle'),
			content: t('chat.locationSearch.locateFailedContent'),
			confirmText: t('chat.locationSearch.relocate'),
			cancelText: t('common.cancel'),
			success: (res: UniNamespace.ShowModalRes) => {
				if (res.confirm === true) {
					void initLocation()
				}
			}
		})
		return
	}

	emitSelection({
		latitude: currentLatitude.value,
		longitude: currentLongitude.value,
		address: currentAddress.value,
		name: currentAddress.value !== '' ? currentAddress.value : t('chat.toast.currentLocationName'),
		provider: 'device',
		poiId: ''
	})
}

function confirmSend(): void {
	// 如果有选中的 POI，发送选中的位置
	if (selectedPoi.value != null) {
		const poi = selectedPoi.value as PoiItem
		emitSelection({
			latitude: poi.latitude,
			longitude: poi.longitude,
			address: poi.address,
			name: poi.name,
			provider: poi.provider,
			poiId: poi.poiId
		})
		return
	}

	// 否则发送地图中心点位置
	if (mapCenterLat.value !== 0 || mapCenterLng.value !== 0) {
		emitSelection({
			latitude: mapCenterLat.value,
			longitude: mapCenterLng.value,
			address: '',
			name: t('chat.locationSearch.mapPickName'),
			provider: 'tencent',
			poiId: ''
		})
		return
	}

	uni.showToast({ title: t('chat.locationSearch.chooseLocation'), icon: 'none' })
}

function emitSelection(payload: any): void {
	// 使用 eventbus 全平台通信，H5 端 getOpenerEventChannel 不可用
	uni.$emit('imSelectLocation', payload)
	uni.navigateBack()
}
