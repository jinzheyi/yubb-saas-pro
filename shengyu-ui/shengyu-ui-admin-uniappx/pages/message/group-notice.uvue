<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('chat.groupNotice.title') }}</text>
			<view class="header-right">
				<text v-if="canEdit" class="edit-btn" :style="{ color: theme.brandPrimary }" @click="handleEdit">{{ isEditing ? t('chat.groupNotice.done') : t('chat.groupNotice.edit') }}</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 查看模式 -->
			<view v-if="!isEditing" class="view-mode" :style="{ backgroundColor: theme.cardBg }">
				<view v-if="notice" class="notice-content">
					<view v-if="noticePinned" class="pinned-tag" :style="{ backgroundColor: theme.brandPrimarySoft }">
						<text class="pinned-tag-text">{{ t('chat.groupNotice.pinned') }}</text>
					</view>
					<text class="notice-text" :style="{ color: theme.textPrimary }">{{ notice }}</text>
				</view>
				<view v-else class="empty-notice">
					<text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xe60e;</text>
					<text class="empty-text" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.empty') }}</text>
					<text v-if="canEdit" class="empty-hint" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.emptyHint') }}</text>
				</view>
				
				<!-- 发布信息 -->
				<view v-if="notice && publishInfo" class="publish-info">
					<text class="publish-label" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.publisher') }}</text>
					<text class="publish-value" :style="{ color: theme.textSecondary }">{{ publishInfo.publisherName }}</text>
				</view>
				<view v-if="notice && publishInfo" class="publish-info">
					<text class="publish-label" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.publishTime') }}</text>
					<text class="publish-value" :style="{ color: theme.textSecondary }">{{ publishInfo.publishTime }}</text>
				</view>
			</view>
			
			<!-- 编辑模式 -->
			<view v-else class="edit-mode" :style="{ backgroundColor: theme.cardBg }">
				<textarea 
					class="notice-textarea" 
					:style="{ color: theme.inputText, backgroundColor: theme.inputBg, borderColor: theme.borderColor }"
					v-model="editingNotice" 
					:placeholder="t('chat.groupNotice.placeholder')"
					maxlength="500"
					:focus="isEditing"
					:auto-height="true"
				/>
				<view class="char-count">
					<text class="char-count-text" :style="{ color: theme.textTertiary }">{{ editingNotice.length }}/500</text>
				</view>
				
				<!-- 推送通知选项 -->
				<view class="option-item" :style="{ backgroundColor: theme.cardBgMuted }">
					<view class="option-left">
						<text class="iconfont option-icon" :style="{ color: theme.brandPrimary }">&#xe60a;</text>
						<text class="option-label" :style="{ color: theme.textPrimary }">{{ t('chat.groupNotice.notifyMembers') }}</text>
					</view>
					<switch class="option-switch" :checked="notifyMembers" @change="handleNotifyChange" />
				</view>
				<view v-if="notifyMembers" class="option-hint">
					<text class="hint-text" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.notifyMembersHint') }}</text>
				</view>
				
				<!-- 置顶公告选项 -->
				<view class="option-item" :style="{ backgroundColor: theme.cardBgMuted }">
					<view class="option-left">
						<text class="iconfont option-icon" :style="{ color: theme.brandPrimary }">&#xe726;</text>
						<text class="option-label" :style="{ color: theme.textPrimary }">{{ t('chat.groupNotice.pinNotice') }}</text>
					</view>
					<switch class="option-switch" :checked="pinNotice" @change="handlePinChange" />
				</view>
				<view v-if="pinNotice" class="option-hint">
					<text class="hint-text" :style="{ color: theme.textTertiary }">{{ t('chat.groupNotice.pinNoticeHint') }}</text>
				</view>
				
				<view class="btn-group">
					<view class="btn btn-cancel" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleCancelEdit">
						<text class="btn-text" :style="{ color: theme.textSecondary }">{{ t('chat.groupNotice.cancel') }}</text>
					</view>
					<view class="btn btn-publish" :style="{ backgroundColor: theme.brandPrimary }" @click="handlePublish">
						<text class="btn-text btn-text-primary">{{ t('chat.groupNotice.publish') }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted } from 'vue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroup, updateGroupNotice } from '../../api/group.uts'
	import { getUserIdStr } from '../../store/user.uts'
	import { formatDateTime } from '../../utils/date.uts'
	import { decodeIdParam } from '../../utils/id-param.uts'
	import { armGroupLifecycleErrorToastSuppression, finalizeGroupLifecycleExit, resolveGroupLifecycleErrorNotice } from '../../utils/chat-setting-actions.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'
	const { t } = useI18n()

	// 页面参数
	const groupId = ref('')
	const groupName = ref('')
	
	// 当前用户
	const currentUserId = ref<string>('0')
	
	// 群公告内容
	const notice = ref('')
	const editingNotice = ref('')
	
	// 编辑状态
	const isEditing = ref(false)
	const canEdit = ref(false) // 是否有编辑权限（群主或管理员）
	
	// 发布选项
	const notifyMembers = ref(true) // 是否推送通知，默认true
	const pinNotice = ref(false) // 是否置顶公告，默认false
	const noticePinned = ref(false) // 当前已生效的置顶状态
	
	// 发布信息
	const publishInfo = ref<any>(null)
	
	// 加载状态
	const loading = ref(false)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	let lifecycleRedirecting = false

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})
	
	/**
	 * 加载群组信息
	 */
	async function loadGroupInfo() {
		if (!groupId.value || lifecycleRedirecting) return
		
		try {
			armGroupLifecycleErrorToastSuppression(3000)
			loading.value = true
			const result = await getGroup(groupId.value)
			
			if (result) {
				notice.value = result.notice || ''
				noticePinned.value = result.noticePinned === true

				// 后端已返回当前用户在群中的角色：1-管理员 2-群主
				const myRole = result.myRole != null ? Number(result.myRole) : 0
				canEdit.value = myRole === 1 || myRole === 2 || result.ownerId === currentUserId.value

				// 发布信息
				if (result.notice) {
					publishInfo.value = {
						publisherName: result.ownerName || t('chat.groupNotice.owner'),
						publishTime: result.updateTime ? formatDateTime(result.updateTime) : ''
					}
				} else {
					publishInfo.value = null
				}

				console.log('[GroupNotice] 加载群组信息成功:', result)
			}
		} catch (e) {
			console.error('[GroupNotice] 加载群组信息失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, '', lifecycleNotice)
				return
			}
			uni.showToast({
				title: t('message.toast.loadFailed'),
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 返回
	 */
	function handleBack() {
		if (isEditing.value) {
			// 编辑模式下，提示是否放弃编辑
			const noticeChanged = editingNotice.value.trim() !== notice.value
			const pinChanged = pinNotice.value !== noticePinned.value
			if (noticeChanged || pinChanged) {
				uni.showModal({
					title: t('chat.groupNotice.confirmDiscardTitle'),
					content: t('chat.groupNotice.confirmDiscardContent'),
					cancelText: t('common.cancel'),
					confirmText: t('common.ok'),
					success: (res) => {
						if (res.confirm) {
							uni.navigateBack()
						}
					}
				})
			} else {
				uni.navigateBack()
			}
		} else {
			uni.navigateBack()
		}
	}
	
	/**
	 * 切换编辑模式
	 */
	function handleEdit() {
		if (isEditing.value) {
			// 完成编辑
			handlePublish()
		} else {
			// 进入编辑模式
			editingNotice.value = notice.value
			// 推送通知默认开启；置顶状态沿用当前生效值
			notifyMembers.value = true
			pinNotice.value = noticePinned.value
			isEditing.value = true
		}
	}
	
	/**
	 * 推送通知开关变化
	 */
	function handleNotifyChange(e : any) {
		notifyMembers.value = e.detail.value as boolean
	}
	
	/**
	 * 置顶公告开关变化
	 */
	function handlePinChange(e : any) {
		pinNotice.value = e.detail.value as boolean
	}
	
	/**
	 * 取消编辑
	 */
	function handleCancelEdit() {
		const noticeChanged = editingNotice.value.trim() !== notice.value
		const pinChanged = pinNotice.value !== noticePinned.value
		if (noticeChanged || pinChanged) {
			uni.showModal({
				title: t('chat.groupNotice.confirmDiscardTitle'),
				content: t('chat.groupNotice.confirmDiscardContent'),
				cancelText: t('common.cancel'),
				confirmText: t('common.ok'),
				success: (res) => {
					if (res.confirm) {
						editingNotice.value = notice.value
						notifyMembers.value = true
						pinNotice.value = noticePinned.value
						isEditing.value = false
					}
				}
			})
		} else {
			isEditing.value = false
		}
	}
	
	/**
	 * 发布群公告
	 */
	async function handlePublish() {
		const newNotice = editingNotice.value.trim()
		const newPinNotice = pinNotice.value
		
		// 验证
		if (newNotice.length > 500) {
			uni.showToast({
				title: t('chat.groupNotice.tooLong'),
				icon: 'none'
			})
			return
		}
		
		// 内容和置顶都没有变化，直接退出编辑模式
		if (newNotice === notice.value && newPinNotice === noticePinned.value) {
			isEditing.value = false
			return
		}
		
		try {
			loading.value = true
			armGroupLifecycleErrorToastSuppression(3000)
			await updateGroupNotice({
				groupId: groupId.value,
				notice: newNotice,
				notifyMembers: notifyMembers.value,
				pinNotice: newPinNotice
			})
			
			notice.value = newNotice
			noticePinned.value = newPinNotice
			isEditing.value = false
			
			// 更新发布信息
			publishInfo.value = {
				publisherName: t('chat.groupNotice.selfPublisher'),
				publishTime: formatDateTime(new Date())
			}
			
			// 根据选项显示不同的提示
			let toastTitle = newNotice ? t('chat.groupNotice.publishSuccess') : t('chat.groupNotice.cleared')
			if (newNotice && notifyMembers.value) {
				toastTitle += t('chat.groupNotice.notifiedMembersSuffix')
			}
			
			uni.showToast({
				title: toastTitle,
				icon: 'success',
				duration: 2000
			})
		} catch (e) {
			console.error('[GroupNotice] 发布群公告失败:', e)
			const lifecycleNotice = resolveGroupLifecycleErrorNotice(e, '')
			if (lifecycleNotice !== '') {
				lifecycleRedirecting = true
				finalizeGroupLifecycleExit(groupId.value, '', lifecycleNotice)
				return
			}
			uni.showToast({
				title: t('chat.groupNotice.publishFailed'),
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}
	
	onLoad((options : any) => {
		// 获取当前用户ID
		currentUserId.value = getUserIdStr()
		
		// 获取群组ID
		if (options['groupId']) {
			groupId.value = decodeIdParam(options['groupId'])
		}
		
		// 获取群名称
		if (options['groupName']) {
			groupName.value = decodeURIComponent(options['groupName'])
		}
		
		console.log('[GroupNotice] 页面参数:', { groupId: groupId.value, groupName: groupName.value })
	})
	
	onMounted(async () => {
		await loadGroupInfo()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
		align-items: flex-end;
	}
	
	.edit-btn {
		color: #1677FF;
		font-size: 15px;
	}

	.content {
		flex: 1;
		height: 0;
	}
	
	/* 查看模式 */
	.view-mode {
		padding: 20px 16px;
	}
	
	.notice-content {
		margin-bottom: 20px;
	}

	.pinned-tag {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		padding: 2px 8px;
		border-radius: 10px;
		background-color: #e8f3ff;
		margin-bottom: 8px;
	}

	.pinned-tag-text {
		font-size: 11px;
		color: #1677FF;
		font-weight: 600;
	}
	
	.notice-text {
		font-size: 15px;
		line-height: 24px;
	}
	
	.empty-notice {
		padding: 60px 0;
		align-items: center;
	}
	
	.empty-icon {
		font-size: 64px;
		color: #C9CDD4;
		margin-bottom: 16px;
	}
	
	.empty-text {
		font-size: 15px;
		margin-bottom: 8px;
	}

	.empty-hint {
		font-size: 13px;
	}
	
	.publish-info {
		flex-direction: row;
		align-items: center;
		margin-top: 12px;
	}
	
	.publish-label {
		font-size: 13px;
	}

	.publish-value {
		font-size: 13px;
	}
	
	/* 编辑模式 */
	.edit-mode {
		padding: 16px;
	}
	
	.notice-textarea {
		width: 100%;
		min-height: 200px;
		font-size: 15px;
		line-height: 24px;
		padding: 12px;
		border-radius: 8px;
		border-width: 1px;
	}
	
	.notice-textarea-focus {
		border-color: #1677FF;
	}
	
	.char-count {
		margin-top: 8px;
		align-items: flex-end;
	}
	
	.char-count-text {
		font-size: 12px;
	}
	
	/* 选项项 */
	.option-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 14px 12px;
		border-radius: 8px;
		margin-top: 16px;
	}
	
	.option-left {
		flex-direction: row;
		align-items: center;
		flex: 1;
	}
	
	.option-icon {
		font-size: 18px;
		color: #1677FF;
		margin-right: 10px;
	}
	
	.option-label {
		font-size: 15px;
		font-weight: 500;
	}
	
	.option-switch {
		transform: scale(0.9);
	}
	
	.option-hint {
		padding: 8px 12px;
		margin-top: 4px;
	}
	
	.hint-text {
		font-size: 12px;
		line-height: 18px;
	}
	
	.edit-tips {
		flex-direction: row;
		align-items: center;
		margin-top: 16px;
		padding: 12px;
		background-color: #FFF7E6;
		border-radius: 6px;
	}
	
	.tip-icon {
		font-size: 16px;
		color: #FA8C16;
		margin-right: 8px;
	}
	
	.tip-text {
		font-size: 13px;
		color: #D46B08;
		flex: 1;
	}
	
	.btn-group {
		flex-direction: row;
		margin-top: 24px;
	}
	
	.btn {
		flex: 1;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
	}
	
	.btn-cancel {
		margin-right: 12px;
		background-color: rgba(143, 149, 158, 0.12);
	}
	
	.btn-publish {
		background-color: #1677FF;
	}
	
	.btn-text {
		font-size: 15px;
	}
	
	.btn-text-primary {
		color: #FFFFFF;
		font-weight: 500;
	}
</style>
