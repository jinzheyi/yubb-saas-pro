							<text class="iconfont action-icon">&#xea6e;</text>
						</view>
						<text class="action-text">搜索</text>
					</view>
				</view>
			</view>

			<!-- 设置列表 -->
			<view class="settings-group">
				<view class="list-item" @click="handleAction('add')">
					<text class="item-label">{{ t('chatSettings.addMember') }}</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
			</view>

			<view class="settings-group">
				<view class="list-item">
					<text class="item-label">{{ t('chatSettings.bubble') }}</text>
