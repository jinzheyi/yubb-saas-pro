					<text class="avatar-text">胡婷</text>
				</view>
				<text class="name">胡婷</text>
				<text class="role">副部长 (主持工作)</text>
				
				<!-- 快捷功能 -->
				<view class="quick-actions">
					<view class="action-item">
						<view class="action-icon-wrap">
							<text class="iconfont action-icon">&#xea95;</text>
