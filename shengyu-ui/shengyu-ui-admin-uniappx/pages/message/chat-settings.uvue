<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">{{ t('chatSettings.title') }}</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 个人信息卡片 -->
			<view class="profile-card">
				<view class="avatar">
					<text class="avatar-text">三</text>
				</view>
				<text class="name">张三</text>
				<text class="role">职员</text>
				
			</view>

			<view class="settings-group">
				<view class="list-item">
					<text class="item-label">{{ t('chatSettings.top') }}</text>
					<switch color="#4cd964" :checked="isTop" @change="onTopChange" />
				</view>
				<view class="list-item">
					<text class="item-label">{{ t('chatSettings.notify') }}</text>
					<switch color="#4cd964" :checked="isNotify" @change="onNotifyChange" />
				</view>
			</view>

			<view class="settings-group">
				<view class="list-item" hover-class="list-item-active" @click="handleAction('file')">
					<text class="item-label">文件</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="list-item" hover-class="list-item-active" @click="handleAction('history')">
					<text class="item-label">聊天记录</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="list-item" hover-class="list-item-active" @click="handleAction('clear')">
					<text class="item-label">{{ t('chatSettings.clearHistory') }}</text>
				</view>
			</view>

			<view class="tip-area">
				<text class="tip-text">{{ t('chatSettings.subordinateTip') }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { messageService } from '../../services/message-service.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'

	const { t } = useI18n()
	const isTop = ref(false)
	const isNotify = ref(true)
	const chatId = ref('')

	onLoad((options : any) => {
		try {
			if (options && options.chatId) {
				chatId.value = decodeIdParam(options.chatId)
			}
		} catch (e) {
		}
	})

	function handleBack() {
		uni.navigateBack()
	}

	function onTopChange(e : UniSwitchChangeEvent) {
		isTop.value = e.detail.value
	}

	function onNotifyChange(e : UniSwitchChangeEvent) {
		isNotify.value = e.detail.value
	}

	function handleAction(type : string) {
		if (type === 'file' || type === 'history') {
			if (!chatId.value) {
				uni.showToast({
					title: '会话信息未加载',
					icon: 'none'
				})
				return
			}
			const chatIdParam = encodeIdParam(chatId.value)
			uni.navigateTo({
				url: type === 'file'
					? '/pages/message/chat-files?chatId=' + chatIdParam + '&scene=single'
					: '/pages/message/chat-history?chatId=' + chatIdParam
			})
			return
		}
		if (type === 'clear') {
			uni.showModal({
				title: t('chatSettings.clearHistory'),
				content: '确定要清空聊天记录吗？此操作不可恢复',
				success: (res) => {
					if (res.confirm) {
						import('@/api/message.uts').then(async (api: any) => {
							if (api && api.clearConversationMessages && chatId.value) {
								await api.clearConversationMessages(chatId.value)
							}
							try {
								messageService.clearUnreadCount(chatId.value)
								messageService.clearChatCache(chatId.value)
							} catch (e) {
							}
							uni.showToast({
								title: '已清空',
								icon: 'success'
							})
						}).catch(() => {
							uni.showToast({
								title: '清空失败',
								icon: 'none'
							})
						})
					}
				}
			})
			return
		}
		uni.showToast({
			title: type + ' 功能开发中',
			icon: 'none'
		})
	}
</script>

<style>
	.page {
		height: 100%;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.profile-card {
		background-color: #FFFFFF;
		padding: 24px 20px;
		align-items: center;
	}

	.avatar {
		width: 64px;
		height: 64px;
		border-radius: 12px;
		background-color: #F197BC;
		justify-content: center;
		align-items: center;
		margin-bottom: 12px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: 600;
	}

	.name {
		font-size: 18px;
		color: #1F2329;
		font-weight: 600;
		margin-bottom: 4px;
	}

	.role {
		font-size: 13px;
		color: #8F959E;
		margin-bottom: 24px;
	}

	.settings-group {
		background-color: #FFFFFF;
	}

	.list-item {
		height: 52px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.list-item-active {
		background-color: #F2F3F5;
	}

	.list-item-border {
		position: absolute;
		bottom: 0;
		left: 16px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.item-label {
		font-size: 16px;
		color: #1F2329;
	}

	.arrow-icon {
		color: #8F959E;
		font-size: 14px;
	}

	.tip-area {
		padding: 24px 16px;
		align-items: center;
	}

	.tip-text {
		font-size: 12px;
		color: #8F959E;
	}
</style>
