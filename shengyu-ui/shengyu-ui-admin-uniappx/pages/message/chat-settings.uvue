<template>
	<view class="page">
		<!-- 状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部导航 -->
		<view class="header">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">{{ t('chatSettings.title') }}</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 个人信息卡片 -->
			<view class="profile-card">
				<view class="avatar" :style="{ backgroundColor: profileAvatarBg }">
					<image
						v-if="shouldShowProfileAvatar()"
						class="avatar-image"
						:src="profileAvatarUrl"
						mode="aspectFill"
						@error="handleProfileAvatarError"
					/>
					<text v-else class="avatar-text">{{ profileAvatarText }}</text>
				</view>
				<text class="name">{{ profileName }}</text>
				<text class="role">{{ profileRole }}</text>
				
			</view>

			<view class="settings-group">
				<view class="list-item">
					<text class="item-label">{{ t('chatSettings.top') }}</text>
					<switch color="#4cd964" :checked="isPinned" @change="onPinnedChange" :disabled="toggleLoading" />
				</view>
				<view class="list-item">
					<text class="item-label">{{ t('chatSettings.notify') }}</text>
					<switch color="#4cd964" :checked="noDisturb" @change="onNoDisturbChange" :disabled="toggleLoading" />
				</view>
			</view>

			<view class="settings-group">
				<view class="list-item" hover-class="list-item-active" @click="handleAction('file')">
					<text class="item-label">文件</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="list-item" hover-class="list-item-active" @click="handleAction('history')">
					<text class="item-label">聊天记录</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
				<view class="list-item" hover-class="list-item-active" @click="handleAction('clear')">
					<text class="item-label">{{ t('chatSettings.clearHistory') }}</text>
				</view>
			</view>

			<view class="tip-area">
				<text class="tip-text">{{ t('chatSettings.subordinateTip') }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getUserDetail } from '../../api/user.uts'
	import { conversationService } from '../../services/conversation-service.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { encodeIdParam, decodeIdParam } from '../../utils/id-param.uts'
	import { clearConversationHistory } from '../../utils/chat-setting-actions.uts'

	const { t } = useI18n()
	const isPinned = ref(false)
	const noDisturb = ref(false)
	const chatId = ref('')
	const targetId = ref('')
	const profileName = ref('聊天设置')
	const profileRole = ref('暂无岗位信息')
	const profileAvatarText = ref('?')
	const profileAvatarUrl = ref('')
	const profileAvatarError = ref(false)
	const profileAvatarBg = ref('#5B8FF9')
	const toggleLoading = ref(false)

	function syncConversationSettings() {
		if (!chatId.value) {
			return
		}
		const conversation = conversationService.getConversation(chatId.value)
		if (conversation == null) {
			return
		}
		isPinned.value = conversation.isPinned === true
		noDisturb.value = conversation.noDisturb === true
		if (!targetId.value && conversation.targetId) {
			targetId.value = String(conversation.targetId)
		}
		const targetName = conversation.targetName != null && String(conversation.targetName).trim() !== ''
			? String(conversation.targetName).trim()
			: profileName.value
		profileName.value = targetName
		profileAvatarText.value = conversation.avatarText != null && String(conversation.avatarText).trim() !== ''
			? String(conversation.avatarText)
			: getAvatarText(targetName)
		profileAvatarUrl.value = normalizeAvatarUrl(conversation.targetAvatar)
		profileAvatarError.value = false
		if (targetId.value) {
			profileAvatarBg.value = getUserAvatarColor(targetId.value)
		}
	}

	async function loadProfile() {
		if (!targetId.value || targetId.value === '0') {
			return
		}
		try {
			const data = await getUserDetail(targetId.value)
			if (!data) {
				return
			}
			const nickname = data.nickname != null && String(data.nickname).trim() !== ''
				? String(data.nickname).trim()
				: profileName.value
			profileName.value = nickname
			profileRole.value = data.postName != null && String(data.postName).trim() !== ''
				? String(data.postName).trim()
				: (data.deptName != null && String(data.deptName).trim() !== '' ? String(data.deptName).trim() : '暂无岗位信息')
			profileAvatarText.value = getAvatarText(profileName.value)
			profileAvatarUrl.value = normalizeAvatarUrl(data.avatar)
			profileAvatarError.value = false
			profileAvatarBg.value = getUserAvatarColor(targetId.value)
		} catch (e) {
			console.error('[ChatSettings] 加载用户详情失败:', e)
		}
	}

	async function hydrateConversation() {
		if (!chatId.value) {
			return
		}
		syncConversationSettings()
		if (conversationService.getConversation(chatId.value) == null) {
			await conversationService.loadConversations()
			syncConversationSettings()
		}
		await loadProfile()
	}

	onLoad((options : any) => {
		try {
			if (options && options.chatId) {
				chatId.value = decodeIdParam(options.chatId)
			}
		} catch (e) {
		}
		void hydrateConversation()
	})

	onShow(() => {
		void hydrateConversation()
	})

	onMounted(() => {
		conversationService.addUpdateListener(syncConversationSettings)
	})

	onUnload(() => {
		conversationService.removeUpdateListener(syncConversationSettings)
	})

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowProfileAvatar(): boolean {
		return profileAvatarUrl.value !== '' && profileAvatarError.value !== true
	}

	function handleProfileAvatarError(): void {
		profileAvatarError.value = true
	}

	function handleBack() {
		uni.navigateBack()
	}

	async function onPinnedChange(e : UniSwitchChangeEvent) {
		const newValue = e.detail.value === true
		if (!chatId.value || toggleLoading.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		try {
			toggleLoading.value = true
			const success = await conversationService.pinConversation(chatId.value, newValue)
			if (!success) {
				throw new Error('pin failed')
			}
			isPinned.value = newValue
			uni.showToast({
				title: newValue ? '已置顶' : '已取消置顶',
				icon: 'success'
			})
		} catch (e) {
			console.error('[ChatSettings] 设置置顶失败:', e)
			isPinned.value = !newValue
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		} finally {
			toggleLoading.value = false
		}
	}

	async function onNoDisturbChange(e : UniSwitchChangeEvent) {
		const newValue = e.detail.value === true
		if (!chatId.value || toggleLoading.value) {
			uni.showToast({
				title: '会话信息未加载',
				icon: 'none'
			})
			return
		}
		try {
			toggleLoading.value = true
			const success = await conversationService.setMute(chatId.value, newValue)
			if (!success) {
				throw new Error('mute failed')
			}
			noDisturb.value = newValue
			uni.showToast({
				title: newValue ? '已开启免打扰' : '已关闭免打扰',
				icon: 'success'
			})
		} catch (e) {
			console.error('[ChatSettings] 设置免打扰失败:', e)
			noDisturb.value = !newValue
			uni.showToast({
				title: '设置失败',
				icon: 'none'
			})
		} finally {
			toggleLoading.value = false
		}
	}

	function handleAction(type : string) {
		if (type === 'file' || type === 'history') {
			if (!chatId.value) {
				uni.showToast({
					title: '会话信息未加载',
					icon: 'none'
				})
				return
			}
			const chatIdParam = encodeIdParam(chatId.value)
			uni.navigateTo({
				url: type === 'file'
					? '/pages/message/chat-files?chatId=' + chatIdParam + '&scene=single'
					: '/pages/message/chat-history?chatId=' + chatIdParam
			})
			return
		}
		if (type === 'clear') {
			uni.showModal({
				title: t('chatSettings.clearHistory'),
				content: '确定要清空聊天记录吗？此操作不可恢复',
				success: (res) => {
						if (res.confirm) {
							clearConversationHistory(chatId.value).then(() => {
								uni.showToast({
									title: '已清空',
									icon: 'success'
								})
							}).catch((e) => {
								console.error('[ChatSettings] 清空聊天记录失败:', e)
								uni.showToast({
									title: '清空失败',
									icon: 'none'
								})
							})
						}
				}
			})
			return
		}
		uni.showToast({
			title: type + ' 功能开发中',
			icon: 'none'
		})
	}
</script>

<style>
	.page {
		height: 100%;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 20px;
	}

	.back-text {
		color: #1F2329;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #1F2329;
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.profile-card {
		background-color: #FFFFFF;
		padding: 24px 20px;
		align-items: center;
	}

	.avatar {
		width: 64px;
		height: 64px;
		border-radius: 12px;
		background-color: #F197BC;
		justify-content: center;
		align-items: center;
		margin-bottom: 12px;
		overflow: hidden;
	}

	.avatar-image {
		width: 64px;
		height: 64px;
		border-radius: 12px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: 600;
	}

	.name {
		font-size: 18px;
		color: #1F2329;
		font-weight: 600;
		margin-bottom: 4px;
	}

	.role {
		font-size: 13px;
		color: #8F959E;
		margin-bottom: 24px;
	}

	.settings-group {
		background-color: #FFFFFF;
	}

	.list-item {
		height: 52px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.list-item-active {
		background-color: #F2F3F5;
	}

	.list-item-border {
		position: absolute;
		bottom: 0;
		left: 16px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.item-label {
		font-size: 16px;
		color: #1F2329;
	}

	.arrow-icon {
		color: #8F959E;
		font-size: 14px;
	}

	.tip-area {
		padding: 24px 16px;
		align-items: center;
	}

	.tip-text {
		font-size: 12px;
		color: #8F959E;
	}
</style>
