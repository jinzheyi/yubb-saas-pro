<template>
	<view class="page">
		<!-- 顶部状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部搜索区域 -->
		<view class="header">
			<view class="header-top">
				<text class="header-title">{{ t('message.title', '消息') }}</text>
				<view class="header-icons">
					<text class="iconfont header-icon" @click="handleScan">&#xea8b;</text>
					<text class="iconfont header-icon" @click="handleInitiateGroup">&#xea74;</text>
				</view>
			</view>
			<view class="search-container">
				<view class="search-bar" @click="handleSearch">
					<text class="iconfont search-icon">&#xea6e;</text>
					<input class="search-input" :placeholder="t('message.searchPlaceholder', '搜索')" placeholder-class="placeholder" disabled />
				</view>
			</view>
		</view>
		
		<!-- 分类图标栏 (置顶) -->
		<view class="category-bar">
			<view 
				class="category-item" 
				v-for="(item, index) in categories" 
				:key="index"
				@click="handleCategoryClick(item)"
			>
				<view class="category-icon-wrap" :class="{ 'category-active': selectedCategoryId === item.id }">
					<text class="iconfont category-icon" :style="{ color: selectedCategoryId === item.id ? '#3370FF' : item.color }">{{ item.icon }}</text>
				</view>
				<text class="category-text" :class="{ 'category-text-active': selectedCategoryId === item.id }">{{ t(item.nameKey) }}</text>
			</view>
		</view>

		<view class="section-divider"></view>

		<scroll-view class="content-scroll" scroll-y="true" show-scrollbar="false">
			<!-- 置顶消息列表 -->
			<view class="message-list" v-if="displayPinnedList.length > 0">
				<view 
					class="message-item pinned-item" 
					v-for="(item, index) in displayPinnedList" 
					:key="'pinned-' + item.id" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<text v-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name">{{ item.titleKey ? t(item.titleKey, item.title) : item.title }}</text>
								<text v-if="item.isGroup && item.memberCount" class="member-count">({{ item.memberCount }})</text>
							</view>
							<text class="message-time">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text class="message-desc">{{ item.desc }}</text>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayPinnedList.length - 1 || showFoldToggle" class="message-item-border"></view>
				</view>
				
				<!-- 折叠/展开按钮 -->
				<view v-if="showFoldToggle" class="fold-toggle" @click="isPinnedFolded = !isPinnedFolded">
					<text class="fold-text">{{ isPinnedFolded ? t('message.fold.showMore', '展开置顶聊天') : t('message.fold.hideMore', '收起置顶聊天') }}</text>
					<text class="iconfont fold-icon">{{ isPinnedFolded ? '\ue60e' : '\ue68d' }}</text>
				</view>
			</view>

			<!-- 普通消息列表 -->
			<view class="message-list">
				<view 
					class="message-item" 
					v-for="(item, index) in displayNormalList" 
					:key="'normal-' + item.id" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<text v-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name">{{ item.titleKey ? t(item.titleKey, item.title) : item.title }}</text>
								<text v-if="item.isGroup && item.memberCount" class="member-count">({{ item.memberCount }})</text>
							</view>
							<text class="message-time">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text class="message-desc">{{ item.desc }}</text>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayNormalList.length - 1" class="message-item-border"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 长按右键菜单弹窗 -->
		<view v-if="showContextMenu" class="menu-mask" @click="closeMenu">
			<view class="menu-content" :style="{ top: menuY + 'px', left: menuX + 'px' }" @click.stop>
				<view class="menu-header">
					<text class="menu-title">{{ t(selectedItem?.titleKey ?? '', selectedItem?.title ?? '') }}</text>
				</view>
				<view class="menu-list">
					<view class="menu-item-btn" @click="handleMenuAction('pin')">
						<text class="menu-item-text">{{ selectedItem?.isPinned ? t('message.menu.unpin') : t('message.menu.pin') }}</text>
					</view>
					<view class="menu-item-btn" @click="handleMenuAction('unread')">
						<text class="menu-item-text">{{ selectedItem?.unread ? t('message.menu.read') : t('message.menu.unread') }}</text>
					</view>
					<view class="menu-item-btn" @click="handleMenuAction('remove')">
						<text class="menu-item-text menu-danger">{{ t('message.menu.remove') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { messageService, ConversationItem } from '../../services/message-service.uts'
	import { getConversationList } from '../../api/conversation.uts'

	const { t } = useI18n()

	// 当前选中的分类 ID (空字符串表示显示全部，不选中任何特定分类)
	const selectedCategoryId = ref('')

	// 置顶折叠状态
	const isPinnedFolded = ref(true)

	// 菜单状态
	const showContextMenu = ref(false)
	const menuX = ref(0)
	const menuY = ref(0)
	const selectedItem = ref<any>(null)
	
	// 加载状态
	const loading = ref(false)
	const refreshing = ref(false)

	// 生成 100 条模拟消息数据
	const generateMessages = () : any[] => {
		const list : any[] = []
		const categoryIds = ['latest', 'user', 'group', 'business', 'at', 'nodisturb']
		const now = Date.now()
		
		// 先添加几条群聊消息（前5条）
		const groupChats = [
			{
				id: 1,
				categoryId: 'group',
				title: '产品研发团队',
				desc: '张敏: 今天下午3点开会，大家准时参加',
				lastMessageTime: now - 5 * 60 * 1000, // 5分钟前
				avatarBg: '#10b981',
				avatarText: '产品',
				avatarIcon: '\ue616', // 群聊图标
				unreadCount: 15,
				noDisturb: false,
				isPinned: true,
				pinnedTime: now - 1000,
				isGroup: true,
				memberCount: 12
			},
			{
				id: 2,
				categoryId: 'group',
				title: '张敏、李强、王静等4人',
				desc: '李强: [图片]',
				lastMessageTime: now - 15 * 60 * 1000, // 15分钟前
				avatarBg: '#f59e0b',
				avatarText: '群聊',
				avatarIcon: '\ue616',
				unreadCount: 3,
				noDisturb: false,
				isPinned: true,
				pinnedTime: now - 2000,
				isGroup: true,
				memberCount: 4
			},
			{
				id: 3,
				categoryId: 'group',
				title: '技术交流群',
				desc: '刘洋: 这个问题我来解答一下...',
				lastMessageTime: now - 30 * 60 * 1000, // 30分钟前
				avatarBg: '#8b5cf6',
				avatarText: '技术',
				avatarIcon: '\ue616',
				unreadCount: 99,
				noDisturb: false,
				isPinned: false,
				pinnedTime: 0,
				isGroup: true,
				memberCount: 50
			},
			{
				id: 4,
				categoryId: 'group',
				title: '周末聚会',
				desc: '王静: 大家周末有空吗？',
				lastMessageTime: now - 2 * 60 * 60 * 1000, // 2小时前
				avatarBg: '#ec4899',
				avatarText: '聚会',
				avatarIcon: '\ue616',
				unreadCount: 0,
				noDisturb: true, // 免打扰
				isPinned: false,
				pinnedTime: 0,
				isGroup: true,
				memberCount: 8
			},
			{
				id: 5,
				categoryId: 'group',
				title: '项目管理组',
				desc: '赵敏: @我 请查看最新的项目进度',
				lastMessageTime: now - 4 * 60 * 60 * 1000, // 4小时前
				avatarBg: '#3b82f6',
				avatarText: '项目',
				avatarIcon: '\ue616',
				unreadCount: 5,
				noDisturb: false,
				isPinned: false,
				pinnedTime: 0,
				isGroup: true,
				memberCount: 15,
				hasAt: true // 有@消息
			}
		]
		
		// 添加群聊消息到列表
		list.push(...groupChats)
		
		// 继续添加其他类型的消息
		for (let i = 6; i <= 100; i++) {
			const catId = categoryIds[i % categoryIds.length]
			
			// 模拟数据逻辑调整：
			let unreadCount = 0
			let noDisturb = false
			
			if (i === 6) {
				unreadCount = 125
				noDisturb = false
			} else if (i === 7) {
				unreadCount = 12
				noDisturb = false
			} else if (i === 8) {
				unreadCount = 5
				noDisturb = true
			} else if (i === 9) {
				unreadCount = 99
				noDisturb = true
			} else {
				unreadCount = 0
				noDisturb = i % 10 === 0
			}

			// 模拟不同时间段的时间戳
			let timeOffset = 0
			if (i <= 10) timeOffset = i * 10 * 60 * 1000 // 今天内
			else if (i <= 15) timeOffset = 24 * 60 * 60 * 1000 // 昨天
			else if (i <= 25) timeOffset = i * 24 * 60 * 60 * 1000 // 几天前
			else timeOffset = i * 30 * 24 * 60 * 60 * 1000 // 很久以前

			list.push({
				id: i,
				categoryId: catId,
				title: i <= 10 ? `置顶消息 ${i}` : `消息测试 ${i}`,
				desc: `这是第 ${i} 条测试消息的内容摘要...`,
				lastMessageTime: now - timeOffset,
				avatarBg: i % 2 === 0 ? '#3370FF' : '#F97316',
				avatarText: i <= 10 ? `顶${i}` : `测${i}`,
				unreadCount: unreadCount,
				noDisturb: noDisturb,
				isPinned: i <= 10, // 前10条设为置顶
				pinnedTime: i <= 10 ? Date.now() - i * 1000 : 0,
				isGroup: false
			})
		}
		return list
	}

	/**
	 * 仿微信时间格式化
	 */
	function formatWeChatTime(timestamp : number) : string {
		const date = new Date(timestamp)
		const now = new Date()
		
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		if (isToday) {
			const hours = date.getHours().toString().padStart(2, '0')
			const minutes = date.getMinutes().toString().padStart(2, '0')
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return '昨天'
		}
		
		// 判断是否在同一周 (简单判断：7天内且星期几小于等于今天)
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (timestamp > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return weekDays[date.getDay()]
		}
		
		// 超过一周显示日期
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}/${day}`
		}
		return `${year}/${month}/${day}`
	}

	// 分类数据
	const categories = [
		{ id: 'latest', icon: '\ue61e', color: '#666', nameKey: 'message.categories.latest' },
		{ id: 'user', icon: '\ue624', color: '#666', nameKey: 'message.categories.user' },
		{ id: 'group', icon: '\ue616', color: '#666', nameKey: 'message.categories.groupQuery' },
		{ id: 'business', icon: '\ue60a', color: '#666', nameKey: 'message.categories.business' },
		{ id: 'at', icon: '\ue7ab', color: '#666', nameKey: 'message.categories.at' },
		{ id: 'nodisturb', icon: '\ue63a', color: '#666', nameKey: 'message.categories.noDisturb' }
	]

	// 消息列表原始数据
	const messageList = ref(generateMessages())
	
	/**
	 * 初始化页面
	 */
	onMounted(() => {
		// 1. 加载会话列表
		loadConversations()
		
		// 2. 监听会话更新
		messageService.addConversationUpdateListener(handleConversationUpdate)
	})
	
	onUnmounted(() => {
		// 移除监听器
		messageService.removeConversationUpdateListener(handleConversationUpdate)
	})
	
	/**
	 * 加载会话列表
	 */
	async function loadConversations() {
		loading.value = true
		
		try {
			// 1. 先从缓存加载（立即显示）
			const cachedConversations = messageService.getConversations()
			if (cachedConversations.length > 0) {
				messageList.value = convertServiceConversations(cachedConversations)
			}
			
			// 2. 从服务器加载最新数据
			const res = await getConversationList()
			
			if (res.code === 0 && res.data) {
				const serverConversations = res.data as any[]
				
				// 转换为 UI 格式
				messageList.value = serverConversations.map(conv => {
					return {
						id: conv.id,
						categoryId: getCategoryId(conv),
						title: conv.targetName,
						desc: conv.lastMessageContent,
						lastMessageTime: new Date(conv.lastMessageTime).getTime(),
						avatarBg: getRandomColor(),
						avatarText: conv.targetName.substring(0, 1),
						avatarIcon: conv.conversationType === 2 ? '\ue616' : '',
						unreadCount: conv.unreadCount,
						noDisturb: conv.noDisturb,
						isPinned: conv.isPinned,
						pinnedTime: conv.isPinned ? new Date(conv.pinnedTime).getTime() : 0,
						isGroup: conv.conversationType === 2,
						memberCount: conv.groupMemberCount || 0
					}
				})
			}
			
		} catch (e) {
			console.error('[Message] 加载会话列表失败:', e)
			uni.showToast({ title: '加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 转换服务会话为 UI 格式
	 */
	function convertServiceConversations(serviceConversations : ConversationItem[]) : any[] {
		return serviceConversations.map(conv => {
			return {
				id: conv.id,
				categoryId: getCategoryId(conv),
				title: conv.name,
				desc: conv.lastMessage,
				lastMessageTime: conv.timestamp,
				avatarBg: conv.avatarBg,
				avatarText: conv.avatarText,
				avatarIcon: conv.type === 2 ? '\ue616' : '',
				unreadCount: conv.unreadCount,
				noDisturb: conv.noDisturb,
				isPinned: conv.isPinned,
				pinnedTime: conv.isPinned ? conv.timestamp : 0,
				isGroup: conv.type === 2,
				memberCount: conv.groupMemberCount || 0
			}
		})
	}
	
	/**
	 * 获取分类 ID
	 */
	function getCategoryId(conv : any) : string {
		if (conv.isPinned) return 'latest'
		if (conv.noDisturb) return 'nodisturb'
		if (conv.conversationType === 2 || conv.type === 2) return 'group'
		return 'user'
	}
	
	/**
	 * 获取随机颜色
	 */
	function getRandomColor() : string {
		const colors = ['#F197BC', '#5FB6F7', '#c084fc', '#10b981', '#f59e0b', '#ec4899', '#3b82f6', '#8b5cf6']
		return colors[Math.floor(Math.random() * colors.length)]
	}
	
	/**
	 * 处理会话更新
	 */
	function handleConversationUpdate(conversation : ConversationItem) {
		// 查找会话
		const index = messageList.value.findIndex(c => c.id === conversation.id)
		
		const uiConversation = {
			id: conversation.id,
			categoryId: getCategoryId(conversation),
			title: conversation.name,
			desc: conversation.lastMessage,
			lastMessageTime: conversation.timestamp,
			avatarBg: conversation.avatarBg,
			avatarText: conversation.avatarText,
			avatarIcon: conversation.type === 2 ? '\ue616' : '',
			unreadCount: conversation.unreadCount,
			noDisturb: conversation.noDisturb,
			isPinned: conversation.isPinned,
			pinnedTime: conversation.isPinned ? conversation.timestamp : 0,
			isGroup: conversation.type === 2,
			memberCount: conversation.groupMemberCount || 0
		}
		
		if (index !== -1) {
			// 更新现有会话
			messageList.value[index] = uiConversation
		} else {
			// 添加新会话
			messageList.value.unshift(uiConversation)
		}
		
		// 重新排序（按时间戳降序）
		messageList.value.sort((a, b) => b.lastMessageTime - a.lastMessageTime)
	}
	
	// 过滤后的基础列表
	const filteredBaseList = computed(() : any[] => {
		if (selectedCategoryId.value === '') {
			return messageList.value
		}
		return messageList.value.filter(item => item.categoryId === selectedCategoryId.value)
	})

	// 置顶消息列表
	const allPinnedList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => item.isPinned).sort((a, b) => b.pinnedTime - a.pinnedTime)
	})

	// 最终显示的置顶列表
	const displayPinnedList = computed(() : any[] => {
		if (isPinnedFolded.value && allPinnedList.value.length > 5) {
			return allPinnedList.value.slice(0, 5)
		}
		return allPinnedList.value
	})

	// 是否显示折叠切换按钮
	const showFoldToggle = computed(() : boolean => {
		return allPinnedList.value.length > 5
	})

	// 普通消息列表
	const displayNormalList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => !item.isPinned)
	})

	function handleCategoryClick(item : any) {
		if (selectedCategoryId.value === item.id) {
			// 如果点击的是当前已选中的，则重置为空，即显示“全部”原始列表
			selectedCategoryId.value = ''
		} else {
			selectedCategoryId.value = item.id
		}
	}

	function handleMessageClick(item : any) {
		// 判断是否是群聊
		if (item.isGroup) {
			// 跳转到群聊页面
			uni.navigateTo({
				url: `/pages/message/chat?conversationId=${item.id}&type=group&groupId=${item.id}&targetId=${item.id}&name=${encodeURIComponent(item.title)}&memberCount=${item.memberCount || 0}`
			})
		} else {
			// 跳转到单聊页面
			uni.navigateTo({
				url: `/pages/message/chat?conversationId=${item.id}&type=single&targetId=${item.id}&name=${encodeURIComponent(item.titleKey ? t(item.titleKey) : item.title)}`
			})
		}
	}

	function handleLongPress(item : any, e : TouchEvent) {
		selectedItem.value = item
		// 获取点击位置，简单处理弹窗位置
		const touch = e.touches[0]
		menuX.value = Math.min(touch.clientX, uni.getSystemInfoSync().screenWidth - 160)
		menuY.value = touch.clientY
		showContextMenu.value = true
	}

	function closeMenu() {
		showContextMenu.value = false
	}

	function handleMenuAction(action : string) {
		if (!selectedItem.value) return
		
		const targetItem = selectedItem.value
		switch (action) {
			case 'pin':
				targetItem.isPinned = !targetItem.isPinned
				if (targetItem.isPinned) {
					targetItem.pinnedTime = Date.now()
				} else {
					targetItem.pinnedTime = 0
				}
				break
			case 'unread':
				if (targetItem.unreadCount > 0) {
					targetItem.unreadCount = 0
				} else {
					targetItem.unreadCount = 1
				}
				break
			case 'remove':
				const index = messageList.value.findIndex(i => i.id === targetItem.id)
				if (index > -1) messageList.value.splice(index, 1)
				break
		}
		closeMenu()
	}

	/**
	 * 扫一扫
	 */
	function handleScan() {
		uni.showToast({
			title: '扫一扫功能开发中',
			icon: 'none'
		})
	}

	/**
	 * 发起群聊
	 */
	function handleInitiateGroup() {
		uni.navigateTo({
			url: '/pages/contacts/initiate-group'
		})
	}

	/**
	 * 搜索
	 */
	function handleSearch() {
		uni.navigateTo({
			url: '/pages/common/search'
		})
	}
</script>

