	}

	.message-bottom {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.message-desc {
		flex: 1;
		flex-direction: row;
		align-items: flex-start;
		min-height: 18px;
		overflow: hidden;
		white-space: nowrap;
	}

	.message-desc-text {
		font-size: 13px;
		color: #666;
		line-height: 18px;
		white-space: nowrap;
	}

	.message-desc-emoji {
		width: 14px;
		height: 14px;
		margin: 2px 1px 0;
		flex-shrink: 0;
	}

	.atme-label {
		font-size: 13px;
		color: #F97316;
		margin-right: 6px;
		flex-shrink: 0;
	}

	.nodisturb-icon {
		font-size: 14px;
		color: #C1C4C9;
		margin-left: 8px;
	}

	/* 菜单弹窗样式 */
	.menu-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: transparent;
		z-index: 999;
	}

	.menu-content {
		position: absolute;
		width: 160px;
		background-color: #ffffff;
		border-radius: 12px;
		box-shadow: 0 4px 16px rgba(0,0,0,0.15);
		overflow: hidden;
		border-width: 0.5px;
		border-color: #f0f0f0;
