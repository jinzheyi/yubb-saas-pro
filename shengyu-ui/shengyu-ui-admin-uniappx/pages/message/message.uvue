<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<!-- 顶部状态栏占位 -->
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		
		<!-- 头部搜索区域 -->
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-top">
				<text class="header-title" :style="{ color: theme.headerText }">{{ t('message.title') }}</text>
				<view class="header-icons">
					<text class="iconfont header-icon" :style="{ color: theme.headerText }" @click="handleSyncBadge">&#xea5f;</text>
					<text class="iconfont header-icon" :style="{ color: theme.headerText }" @click="handleScan">&#xea8b;</text>
					<text class="iconfont header-icon" :style="{ color: theme.headerText }" @click="handleInitiateGroup">&#xea74;</text>
				</view>
			</view>
			<view class="search-container">
				<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
					<text class="iconfont search-icon" :style="{ color: theme.textTertiary }" @click="handleSearch">&#xea6e;</text>
					<input class="search-input" :style="{ color: theme.inputText }" v-model="listSearchKeyword" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" confirm-type="search" @confirm="handleSearch" />
					<text v-if="listSearchKeyword !== ''" class="iconfont search-clear" :style="{ color: theme.textTertiary }" @click="clearConversationFilter">&#xea73;</text>
				</view>
			</view>
		</view>
		
		<!-- 分类图标栏 (置顶) -->
		<view class="category-bar" :style="{ backgroundColor: theme.cardBg }">
			<view 
				class="category-item" 
				v-for="(item, index) in categories" 
				:key="index"
				@click="handleCategoryClick(item)"
			>
				<view class="category-icon-wrap" :class="{ 'category-active': selectedCategoryId === item.id }" :style="{ backgroundColor: selectedCategoryId === item.id ? theme.brandPrimarySoft : theme.cardBgMuted }">
					<text class="iconfont category-icon" :style="{ color: selectedCategoryId === item.id ? '#3370FF' : item.color }">{{ item.icon }}</text>
				</view>
				<text class="category-text" :class="{ 'category-text-active': selectedCategoryId === item.id }" :style="{ color: selectedCategoryId === item.id ? theme.brandPrimary : theme.textSecondary }">{{ t(item.nameKey) }}</text>
			</view>
		</view>

		<view class="section-divider" :style="{ backgroundColor: theme.pageBg }"></view>

		<view
			v-if="inlineNoticeVisible"
			class="inline-notice"
			:style="{ backgroundColor: theme.brandPrimarySoft, borderBottomColor: theme.borderColor }"
		>
			<text class="inline-notice-text" :style="{ color: theme.brandPrimary }">{{ inlineNoticeText }}</text>
			<text class="iconfont inline-notice-close" :style="{ color: theme.textTertiary }" @click="hideInlineNotice">&#xeb08;</text>
		</view>

		<scroll-view
			class="content-scroll"
			scroll-y="true"
			show-scrollbar="false"
			refresher-enabled="true"
			:refresher-triggered="refreshing"
			@refresherrefresh="handleRefresh"
			@refresherrestore="handleRefreshRestore"
			@refresherabort="handleRefreshAbort"
		>
			<!-- 置顶消息列表 -->
			<view class="message-list" v-if="displayPinnedList.length > 0">
				<view 
					class="message-item pinned-item" 
					:style="{ backgroundColor: theme.cardBgMuted }"
					hover-class="pinned-item-active"
					v-for="(item, index) in displayPinnedList" 
					:key="'pinned-' + item.chatId" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
					@mousedown="handleMouseLongPressStart(item, $event)"
					@mouseup="handleMouseLongPressEnd"
					@mouseleave="handleMouseLongPressEnd"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<image v-if="item.targetAvatar" class="avatar-image" :src="item.targetAvatar" mode="aspectFill" @error="handleAvatarError(item)" />
						<text v-else-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name" :style="{ color: theme.textPrimary }">{{ item.targetName }}</text>
								<text v-if="item.conversationType === 2 && item.groupMemberCount" class="member-count" :style="{ color: theme.textTertiary }">{{ t('message.memberCount', { count: item.groupMemberCount }) }}</text>
							</view>
							<text class="message-time" :style="{ color: theme.textTertiary }">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text v-if="item.lastMessageHasAtMe" class="atme-label">{{ t('message.atMe') }}</text>
							<view class="message-desc">
								<template v-for="(token, tokenIndex) in item.lastMessagePreviewTokens" :key="'pinned-token-' + item.chatId + '-' + tokenIndex">
									<image v-if="token.type === 'emoji'" class="message-desc-emoji" :src="token.content" mode="aspectFit" />
									<text v-else :class="['message-desc-text', isNoticeUpdatePreviewToken(token.content) ? 'message-desc-text-alert' : '']" :style="{ color: isNoticeUpdatePreviewToken(token.content) ? '#F54A45' : theme.textSecondary }">{{ token.content }}</text>
								</template>
							</view>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayPinnedList.length - 1 || showFoldToggle" class="message-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
				
				<!-- 折叠/展开按钮 -->
				<view v-if="showFoldToggle" class="fold-toggle" :style="{ backgroundColor: theme.cardBgMuted }" @click="isPinnedFolded = !isPinnedFolded">
					<text class="fold-text" :style="{ color: theme.textSecondary }">{{ isPinnedFolded ? t('message.fold.showMore') : t('message.fold.hideMore') }}</text>
					<text class="iconfont fold-icon" :style="{ color: theme.textTertiary }">{{ isPinnedFolded ? '\ue60e' : '\ue68d' }}</text>
				</view>
			</view>

			<!-- 普通消息列表 -->
			<view class="message-list">
				<view 
					class="message-item" 
					:style="{ backgroundColor: theme.cardBg }"
					hover-class="message-item-active"
					v-for="(item, index) in displayNormalList" 
					:key="'normal-' + item.chatId" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
					@mousedown="handleMouseLongPressStart(item, $event)"
					@mouseup="handleMouseLongPressEnd"
					@mouseleave="handleMouseLongPressEnd"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<image v-if="item.targetAvatar" class="avatar-image" :src="item.targetAvatar" mode="aspectFill" @error="handleAvatarError(item)" />
						<text v-else-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name" :style="{ color: theme.textPrimary }">{{ item.targetName }}</text>
								<text v-if="item.conversationType === 2 && item.groupMemberCount" class="member-count" :style="{ color: theme.textTertiary }">{{ t('message.memberCount', { count: item.groupMemberCount }) }}</text>
							</view>
							<text class="message-time" :style="{ color: theme.textTertiary }">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text v-if="item.lastMessageHasAtMe" class="atme-label">{{ t('message.atMe') }}</text>
							<view class="message-desc">
								<template v-for="(token, tokenIndex) in item.lastMessagePreviewTokens" :key="'normal-token-' + item.chatId + '-' + tokenIndex">
									<image v-if="token.type === 'emoji'" class="message-desc-emoji" :src="token.content" mode="aspectFit" />
									<text v-else :class="['message-desc-text', isNoticeUpdatePreviewToken(token.content) ? 'message-desc-text-alert' : '']" :style="{ color: isNoticeUpdatePreviewToken(token.content) ? '#F54A45' : theme.textSecondary }">{{ token.content }}</text>
								</template>
							</view>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayNormalList.length - 1" class="message-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 长按右键菜单弹窗 -->
		<view v-if="showContextMenu" class="menu-mask" @click="closeMenu">
			<view class="menu-content" :style="{ top: menuY + 'px', left: menuX + 'px', backgroundColor: theme.cardBg, borderColor: theme.borderColor }" @click.stop>
				<view class="menu-header" :style="{ backgroundColor: theme.cardBgMuted, borderBottomColor: theme.borderColor }">
					<text class="menu-title" :style="{ color: theme.textSecondary }">{{ selectedItem?.targetName ?? '' }}</text>
				</view>
				<view class="menu-list">
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('pin')">
						<text class="menu-item-text" :style="{ color: theme.textPrimary }">{{ selectedItem?.isPinned ? t('message.menu.unpin') : t('message.menu.pin') }}</text>
					</view>
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('unread')">
						<text class="menu-item-text" :style="{ color: theme.textPrimary }">{{ (selectedItem?.unreadCount || 0) > 0 ? t('message.menu.read') : t('message.menu.unread') }}</text>
					</view>
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('remove')">
						<text class="menu-item-text menu-danger">{{ t('message.menu.remove') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { conversationService, ConversationItem } from '../../services/conversation-service.uts'
	import { badgeService, BadgeData } from '../../services/badge-service.uts'
	import { tabBarBadgeService } from '../../services/tab-bar-badge-service.uts'
	import { runtimeTabBarService } from '../../services/runtime-tab-bar-service.uts'
	import { getConversationAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { wsManager } from '../../utils/websocket.uts'
	import { encodeIdParam } from '../../utils/id-param.uts'
	import { parseMessageText as parseEmojiTokens, type MessageToken as EmojiToken } from '../../utils/emojiParser.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import { getString, remove } from '../../utils/storage.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	// 当前选中的分类 ID（默认最近更新）
	const selectedCategoryId = ref('latest')
	const listSearchKeyword = ref('')

	// 置顶折叠状态
	const isPinnedFolded = ref(true)

	// 菜单状态
	const showContextMenu = ref(false)
	const menuX = ref(0)
	const menuY = ref(0)
	const selectedItem = ref<any>(null)
	const theme = ref<ThemeTokens>(getThemeTokens())
	
	// 加载状态
	const loading = ref(false)
	const refreshing = ref(false)
	const lastConversationSyncAt = ref(0)
	const lastManualRefreshAt = ref(0)
	const manualRefreshBlockedUntil = ref(0)
	const refreshFailureCount = ref(0)
	const MANUAL_REFRESH_COOLDOWN_MS = 4000
	const MANUAL_REFRESH_FRESH_SKIP_MS = 10000
	const MANUAL_REFRESH_BACKOFF_BASE_MS = 1000
	const MANUAL_REFRESH_BACKOFF_MAX_MS = 30000
	const REFRESH_INDICATOR_WATCHDOG_MS = 2200
	// onShow 刷新节流，避免频繁请求会话列表
	let lastOnShowRefreshAt = 0
	let lastPageHideAt = 0
	let refreshReleaseTimer = 0
	let refreshWatchdogTimer = 0
	let unsubscribeTheme: (() => void) | null = null
	const inlineNoticeVisible = ref(false)
	const inlineNoticeText = ref('')
	let inlineNoticeTimer = 0
	let mouseLongPressTimer = 0
	let suppressNextClickChatId = ''

	const FOREGROUND_SYNC_COOLDOWN_MS = 1500
	const FOREGROUND_SYNC_STALE_MS = 5000
	const FOREGROUND_SYNC_AFTER_HIDE_MS = 1200
	const GROUP_REMOVAL_NOTICE_KEY = 'IM_GROUP_REMOVAL_NOTICE'

	// 角标监听器
	const badgeListener = {
		onBadgeUpdate: (badgeData: BadgeData) => {
			conversationService.applyBadgeSnapshot(badgeData.conversationBadges)
		}
	}

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	function getRetryAfterMsFromHeaders(headers: any): number {
		try {
			if (headers == null) {
				return 0
			}
			let retryAfterRaw = ''
			for (const key in headers) {
				if (key != null && String(key).toLowerCase() === 'retry-after') {
					retryAfterRaw = String((headers as any)[key])
					break
				}
			}
			if (retryAfterRaw === '') {
				return 0
			}
			const retryAfterNum = Number(retryAfterRaw)
			if (isFinite(retryAfterNum) && retryAfterNum > 0) {
				// Retry-After 数字语义为秒
				return Math.floor(retryAfterNum * 1000)
			}
			const retryAfterDate = new Date(retryAfterRaw).getTime()
			if (!isNaN(retryAfterDate) && retryAfterDate > Date.now()) {
				return retryAfterDate - Date.now()
			}
			return 0
		} catch (e) {
			return 0
		}
	}

	function resolveRetryAfterMs(error: any): number {
		try {
			if (error == null) {
				return 0
			}
			const retryAfterFromHeader = getRetryAfterMsFromHeaders((error as any).header)
			if (retryAfterFromHeader > 0) {
				return retryAfterFromHeader
			}
			const statusCode = Number((error as any).statusCode)
			const directCode = Number((error as any).code)
			const responseData = (error as any).data
			const dataCode = responseData != null ? Number((responseData as any).code) : 0
			if (statusCode !== 429 && directCode !== 429 && dataCode !== 429) {
				return 0
			}
			if (responseData != null) {
				const retryRaw = (responseData as any).retry_after != null
					? (responseData as any).retry_after
					: (responseData as any).retryAfter
				const retryNum = Number(retryRaw)
				if (isFinite(retryNum) && retryNum > 0) {
					return Math.floor(retryNum * 1000)
				}
			}
			return 5000
		} catch (e) {
			return 0
		}
	}

	function shouldSkipManualRefreshBecauseFresh(now: number): boolean {
		if (!wsManager.isConnected()) {
			return false
		}
		if (lastConversationSyncAt.value <= 0) {
			return false
		}
		return (now - lastConversationSyncAt.value) < MANUAL_REFRESH_FRESH_SKIP_MS
	}

	function mapConversationToView(conv: ConversationItem): any {
		const chatId = conv != null && conv.chatId != null ? conv.chatId.toString() : '0'
		const targetName = conv != null && conv.targetName != null ? String(conv.targetName).trim() : ''
		const targetId = conv != null && conv.targetId != null ? String(conv.targetId) : '0'
		const timestamp = conv != null && conv.timestamp != null ? normalizeTimestampMs(conv.timestamp) : 0
		const previewText = buildConversationPreview((conv as any).lastMessageType || 0, conv != null ? conv.lastMessageContent : '')
		const isGroup = conv != null && conv.conversationType === 2
		return {
			chatId: chatId,
			lastMessageSequence: conv != null && (conv as any).lastMessageSequence != null ? (conv as any).lastMessageSequence.toString() : '0',
			lastReadSequence: conv != null && (conv as any).lastReadSequence != null ? (conv as any).lastReadSequence.toString() : '0',
			targetName: targetName !== '' ? targetName : t('chat.preview.unknownSender'),
			lastMessageType: (conv as any).lastMessageType || 0,
			lastMessageContent: previewText,
			lastMessagePreviewTokens: buildConversationPreviewTokens(previewText),
			lastMessageTime: timestamp,
			targetAvatar: conv != null && conv.targetAvatar != null ? String(conv.targetAvatar) : '',
			avatarBg: conv != null && conv.avatarBg != null && String(conv.avatarBg).trim() !== ''
				? String(conv.avatarBg)
				: getConversationAvatarColor(conv != null ? conv.conversationType : 1, targetId),
			avatarText: resolveAvatarText(
				conv != null && conv.avatarText != null && String(conv.avatarText).trim() !== '' ? conv.avatarText : targetName,
				targetId
			),
			avatarIcon: isGroup ? '\ue616' : '',
			unreadCount: conv != null ? conv.unreadCount : 0,
			noDisturb: conv != null && conv.noDisturb === true,
			isPinned: conv != null && conv.isPinned === true,
			lastMessageHasAtMe: conv != null && conv.lastMessageHasAtMe === true,
			pinnedTime: conv != null && conv.isPinned === true ? timestamp : 0,
			conversationType: conv != null ? conv.conversationType : 1,
			groupMemberCount: conv != null && conv.groupMemberCount != null ? conv.groupMemberCount : 0,
			targetId: targetId
		}
	}

	function applyConversationList(conversations: ConversationItem[]): void {
		const list = conversations != null ? conversations : []
		messageList.value = list.map((conv: ConversationItem) => mapConversationToView(conv)).sort((a, b) => {
			if (a.isPinned && !b.isPinned) return -1
			if (!a.isPinned && b.isPinned) return 1
			return b.lastMessageTime - a.lastMessageTime
		})
	}

	function syncFromConversationCache(): void {
		applyConversationList(conversationService.getConversations())
	}

	function shouldSyncOnForeground(now: number): boolean {
		const hiddenDuration = lastPageHideAt > 0 ? now - lastPageHideAt : Number.MAX_SAFE_INTEGER
		if (messageList.value.length === 0) {
			return true
		}
		if (!wsManager.isConnected()) {
			return true
		}
		if (lastConversationSyncAt.value <= 0) {
			return true
		}
		if ((now - lastConversationSyncAt.value) >= FOREGROUND_SYNC_STALE_MS) {
			return true
		}
		if (hiddenDuration >= FOREGROUND_SYNC_AFTER_HIDE_MS) {
			return true
		}
		return false
	}
	
	onShow(() => {
		runtimeTabBarService.refresh()
		wsManager.setRealtimeBizActive(true)
		if (!wsManager.isConnected()) {
			wsManager.setProtocols(['im.pb.v1'])
			void wsManager.ensureConnected(4000)
		}
		const groupRemovalNotice = getString(GROUP_REMOVAL_NOTICE_KEY, '')
		if (groupRemovalNotice !== '') {
			remove(GROUP_REMOVAL_NOTICE_KEY)
			showInlineNotice(groupRemovalNotice)
			void conversationService.syncConversationsIncrementally(false)
		}
		tabBarBadgeService.refresh()
		syncFromConversationCache()
		const now = Date.now()
		if (now - lastOnShowRefreshAt > FOREGROUND_SYNC_COOLDOWN_MS) {
			lastOnShowRefreshAt = now
			if (shouldSyncOnForeground(now)) {
				void syncConversationList(false)
			}
		}
	})

	onHide(() => {
		wsManager.setRealtimeBizActive(false)
		lastPageHideAt = Date.now()
		forceStopRefreshIndicator()
		clearInlineNoticeTimer()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
		wsManager.setRealtimeBizActive(false)
		lastPageHideAt = Date.now()
		forceStopRefreshIndicator()
		clearInlineNoticeTimer()
		clearMouseLongPressTimer()
	})

	function clearInlineNoticeTimer(): void {
		if (inlineNoticeTimer !== 0) {
			clearTimeout(inlineNoticeTimer)
			inlineNoticeTimer = 0
		}
	}

	function hideInlineNotice(): void {
		clearInlineNoticeTimer()
		inlineNoticeVisible.value = false
	}

	function showInlineNotice(text: string): void {
		const nextText = text != null ? String(text).trim() : ''
		if (nextText === '') {
			hideInlineNotice()
			return
		}
		clearInlineNoticeTimer()
		inlineNoticeText.value = nextText
		inlineNoticeVisible.value = true
		inlineNoticeTimer = setTimeout(() => {
			inlineNoticeVisible.value = false
			inlineNoticeTimer = 0
		}, 5000)
	}

	function normalizeConversationType(value: any): number {
		return Number(value) === 2 ? 2 : 1
	}

	function matchCategory(item: any, categoryId: string): boolean {
		switch (categoryId) {
			case 'user':
				return normalizeConversationType(item.conversationType) === 1
			case 'group':
				return normalizeConversationType(item.conversationType) === 2
			case 'at':
				return item.lastMessageHasAtMe === true
			case 'nodisturb':
				return item.noDisturb === true
			case 'latest':
			default:
				return true
		}
	}

	function normalizeTimestampMs(raw: any): number {
		try {
			if (raw == null) {
				return 0
			}
			if (typeof raw === 'number') {
				if (!isFinite(raw) || raw <= 0) {
					return 0
				}
				const ms = raw < 100000000000 ? raw * 1000 : raw
				if (ms < 946684800000) {
					return 0
				}
				return Math.floor(ms)
			}
			const text = String(raw).trim()
			if (text === '') {
				return 0
			}
			if (/^[0-9]+$/.test(text)) {
				const numVal = Number(text)
				if (!isFinite(numVal) || numVal <= 0) {
					return 0
				}
				const ms = text.length <= 10 ? numVal * 1000 : numVal
				if (ms < 946684800000) {
					return 0
				}
				return Math.floor(ms)
			}
			const parsed = new Date(text).getTime()
			if (isNaN(parsed) || parsed <= 0 || parsed < 946684800000) {
				return 0
			}
			return parsed
		} catch (e) {
			return 0
		}
	}

	function resolveAvatarText(targetName: any, targetId: any): string {
		const name = targetName != null ? String(targetName).trim() : ''
		if (name !== '') {
			return getAvatarText(name)
		}
		const idText = targetId != null ? String(targetId).trim() : ''
		if (idText !== '' && idText !== '0') {
			return getAvatarText(idText)
		}
		return '?'
	}
	
	/**
	 * 仿微信时间格式化
	 */
	function formatWeChatTime(timestamp : number) : string {
		const normalizedTs = normalizeTimestampMs(timestamp)
		if (normalizedTs <= 0) {
			return ''
		}
		const date = new Date(normalizedTs)
		const now = new Date()
		
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		if (isToday) {
			const hours = date.getHours().toString().padStart(2, '0')
			const minutes = date.getMinutes().toString().padStart(2, '0')
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return t('message.time.yesterday')
		}
		
		// 判断是否在同一周 (简单判断：7天内且星期几小于等于今天)
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (normalizedTs > oneWeekAgo) {
			const weekDays = [
				t('message.weekdays.sunday'),
				t('message.weekdays.monday'),
				t('message.weekdays.tuesday'),
				t('message.weekdays.wednesday'),
				t('message.weekdays.thursday'),
				t('message.weekdays.friday'),
				t('message.weekdays.saturday')
			]
			return weekDays[date.getDay()]
		}
		
		// 超过一周显示日期
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}/${day}`
		}
		return `${year}/${month}/${day}`
	}

	function handleAvatarError(item : any): void {
		try {
			if (item == null) {
				return
			}
			item.targetAvatar = ''
		} catch (e) {
			// ignore
		}
	}

	// 分类数据
	const categories = [
		{ id: 'latest', icon: '\ue61e', color: '#666', nameKey: 'message.categories.latest' },
		{ id: 'user', icon: '\ue624', color: '#666', nameKey: 'message.categories.user' },
		{ id: 'group', icon: '\ue616', color: '#666', nameKey: 'message.categories.groupQuery' },
		{ id: 'at', icon: '\ue7ab', color: '#666', nameKey: 'message.categories.at' },
		{ id: 'nodisturb', icon: '\ue63a', color: '#666', nameKey: 'message.categories.noDisturb' }
	]

	function buildConversationPreview(messageType : any, raw : string) : string {
		const trimmed = raw != null ? raw.toString().trim().replace(/\r?\n+/g, ' ') : ''
		if (trimmed !== '') {
			if (trimmed.length > 100) {
				return trimmed.substring(0, 100) + '...'
			}
			return trimmed
		}
		if (messageType === 'sticker') return t('message.preview.sticker')
		if (messageType === 'custom') return t('message.preview.custom')
		if (messageType === 1) {
			return ''
		}
		if (messageType === 2) return t('message.preview.image')
		if (messageType === 3) return t('message.preview.voice')
		if (messageType === 4) return t('message.preview.video')
		if (messageType === 5) return t('message.preview.file')
		if (messageType === 6) return t('message.preview.location')
		if (messageType === 7) return t('message.preview.emoji')
		if (messageType === 8) return t('message.preview.sticker')
		if (messageType === 10) return t('message.preview.system')
		return ''
	}

	function buildConversationPreviewTokens(preview: string): EmojiToken[] {
		if (preview == null || preview === '') {
			return [] as EmojiToken[]
		}
		try {
			return parseEmojiTokens(preview)
		} catch (e) {
			return [{
				type: 'text',
				content: preview
			} as EmojiToken]
		}
	}

	function isNoticeUpdatePreviewToken(content: string): boolean {
		try {
			return content != null && String(content).trim() === t('message.preview.noticeUpdated')
		} catch (e) {
			return false
		}
	}

	// 消息列表原始数据
	const messageList = ref<any[]>([])
	
	/**
	 * 初始化页面
	 */
	onMounted(() => {
		// 1. 监听会话更新
		conversationService.addUpdateListener(handleConversationsUpdate)
		
		// 2. 首屏优先吃会话服务缓存，再做增量对齐
		syncFromConversationCache()
		void loadConversations()
		
		// 3. 监听角标更新
		badgeService.addListener(badgeListener)
	})
	
	onUnmounted(() => {
		// 移除监听器
		conversationService.removeUpdateListener(handleConversationsUpdate)
		badgeService.removeListener(badgeListener)
		forceStopRefreshIndicator()
	})
	
	/**
	 * 加载会话列表
	 */
	async function loadConversations() {
		loading.value = true
		
		try {
			syncFromConversationCache()
			// 加载会话列表（内部根据本地 cursor + 内存缓存决定是否 reset）
			await conversationService.loadConversations()
			lastConversationSyncAt.value = Date.now()
			
		} catch (e) {
			console.error('[Message] 加载会话列表失败:', e)
			uni.showToast({ title: t('message.toast.loadFailed'), icon: 'none' })
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 处理会话更新（来自 WebSocket 或其他页面）
	 */
	function handleConversationsUpdate(conversations : ConversationItem[]) {
		// 全量刷新（来源：ConversationService，服务端权威水位 + 本地实时更新）
		applyConversationList(conversations)
		lastConversationSyncAt.value = Date.now()
	}

	async function syncConversationList(showLoading: boolean = true): Promise<void> {
		if (showLoading) {
			loading.value = true
		}
		try {
			await conversationService.syncConversationsIncrementally(false)
			lastConversationSyncAt.value = Date.now()
		} catch (e) {
			console.error('[Message] 增量同步会话失败:', e)
			throw e
		} finally {
			if (showLoading) {
				loading.value = false
			}
		}
	}
	
	// 过滤后的基础列表
	const filteredBaseList = computed(() : any[] => {
		const categoryId = selectedCategoryId.value != null && selectedCategoryId.value !== '' ? selectedCategoryId.value : 'latest'
		const keyword = listSearchKeyword.value != null ? String(listSearchKeyword.value).trim().toLowerCase() : ''
		return messageList.value
			.filter(item => matchCategory(item, categoryId))
			.filter(item => {
				if (keyword === '') {
					return true
				}
				const name = item != null && item.targetName != null ? String(item.targetName).toLowerCase() : ''
				const preview = item != null && item.lastMessageContent != null ? String(item.lastMessageContent).toLowerCase() : ''
				return name.indexOf(keyword) >= 0 || preview.indexOf(keyword) >= 0
			})
	})

	// 置顶消息列表
	const allPinnedList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => item.isPinned).sort((a, b) => b.pinnedTime - a.pinnedTime)
	})

	// 最终显示的置顶列表
	const displayPinnedList = computed(() : any[] => {
		if (isPinnedFolded.value && allPinnedList.value.length > 5) {
			return allPinnedList.value.slice(0, 5)
		}
		return allPinnedList.value
	})

	// 是否显示折叠切换按钮
	const showFoldToggle = computed(() : boolean => {
		return allPinnedList.value.length > 5
	})

	// 普通消息列表
	const displayNormalList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => !item.isPinned)
	})

	function handleCategoryClick(item : any) {
		selectedCategoryId.value = item.id
	}

	function handleMessageClick(item : any) {
		const chatId = item != null && item.chatId != null ? String(item.chatId) : ''
		if (chatId !== '' && chatId === suppressNextClickChatId) {
			suppressNextClickChatId = ''
			return
		}
		conversationService.markConversationUnread(item.chatId, false)
		const chatIdParam = encodeIdParam(item.chatId != null ? String(item.chatId) : '')
		uni.navigateTo({
			url: `/pages/message/chat?chatId=${chatIdParam}&entryMode=latest`
		})
	}

	function extractMenuPointerPosition(e : any): { x: number, y: number } {
		if (e != null && e.touches != null && e.touches.length > 0) {
			return {
				x: Number(e.touches[0].clientX),
				y: Number(e.touches[0].clientY)
			}
		}
		if (e != null && e.changedTouches != null && e.changedTouches.length > 0) {
			return {
				x: Number(e.changedTouches[0].clientX),
				y: Number(e.changedTouches[0].clientY)
			}
		}
		return {
			x: e != null && e.clientX != null ? Number(e.clientX) : 0,
			y: e != null && e.clientY != null ? Number(e.clientY) : 0
		}
	}

	function openConversationContextMenu(item : any, e : any, suppressClick: boolean = false) {
		selectedItem.value = item
		const pointer = extractMenuPointerPosition(e)
		const chatId = item != null && item.chatId != null ? String(item.chatId) : ''
		if (suppressClick && chatId !== '') {
			suppressNextClickChatId = chatId
		}
		menuX.value = Math.min(pointer.x, uni.getSystemInfoSync().screenWidth - 160)
		menuY.value = pointer.y
		showContextMenu.value = true
	}

	function handleLongPress(item : any, e : any) {
		openConversationContextMenu(item, e)
	}

	function clearMouseLongPressTimer(): void {
		if (mouseLongPressTimer !== 0) {
			clearTimeout(mouseLongPressTimer)
			mouseLongPressTimer = 0
		}
	}

	function handleMouseLongPressStart(item : any, e : any) {
		clearMouseLongPressTimer()
		mouseLongPressTimer = setTimeout(() => {
			mouseLongPressTimer = 0
			openConversationContextMenu(item, e, true)
		}, 450)
	}

	function handleMouseLongPressEnd() {
		clearMouseLongPressTimer()
	}

	function closeMenu() {
		showContextMenu.value = false
		clearMouseLongPressTimer()
	}

	function showConfirmModal(title: string, content: string): Promise<boolean> {
		return new Promise((resolve) => {
			uni.showModal({
				title,
				content,
				cancelText: t('common.cancel'),
				confirmText: t('common.ok'),
				success: (res) => {
					resolve(res.confirm === true)
				},
				fail: () => {
					resolve(false)
				}
			})
		})
	}

	async function handleMenuAction(action : string) {
		if (!selectedItem.value) return
		
		const targetItem = selectedItem.value
		
		try {
			switch (action) {
				case 'pin':
					const newPinnedState = !targetItem.isPinned
					const pinSuccess = await conversationService.pinConversation(targetItem.chatId, newPinnedState)
					if (!pinSuccess) {
						throw new Error('pin failed')
					}
					uni.showToast({
						title: newPinnedState ? t('message.toast.pinned') : t('message.toast.unpinned'),
						icon: 'success'
					})
					break
					
					case 'unread':
						if (targetItem.unreadCount > 0) {
							const seq = (targetItem as any).lastMessageSequence != null ? (targetItem as any).lastMessageSequence.toString() : '0'
							badgeService.clearConversationBadge(targetItem.chatId, seq)
							uni.showToast({
								title: t('message.toast.markedRead'),
								icon: 'success'
							})
						} else {
							conversationService.markConversationUnread(targetItem.chatId, true)
							uni.showToast({
								title: t('message.toast.markedUnread'),
								icon: 'success'
							})
						}
						break
						
					case 'remove':
						const confirmed = await showConfirmModal(t('message.confirm.removeTitle'), t('message.confirm.removeContent'))
						if (!confirmed) {
							break
						}
						const removeSuccess = await conversationService.deleteConversation(targetItem.chatId)
						if (!removeSuccess) {
							throw new Error('remove failed')
						}
						uni.showToast({
							title: t('message.toast.removed'),
							icon: 'success'
						})
						break
			}
		} catch (e) {
			console.error('[Message] 操作失败:', e)
			uni.showToast({
				title: t('message.toast.actionFailed'),
				icon: 'none'
			})
		}
		
		closeMenu()
	}

	function clearRefreshTimers(): void {
		if (refreshReleaseTimer !== 0) {
			clearTimeout(refreshReleaseTimer)
			refreshReleaseTimer = 0
		}
		if (refreshWatchdogTimer !== 0) {
			clearTimeout(refreshWatchdogTimer)
			refreshWatchdogTimer = 0
		}
	}

	function forceStopRefreshIndicator(): void {
		clearRefreshTimers()
		refreshing.value = false
		setTimeout(() => {
			refreshing.value = false
		}, 40)
	}

	function beginRefreshIndicator(): void {
		clearRefreshTimers()
		refreshing.value = true
		refreshWatchdogTimer = setTimeout(() => {
			refreshWatchdogTimer = 0
			refreshing.value = false
		}, REFRESH_INDICATOR_WATCHDOG_MS)
	}

	function finishRefreshIndicator(): void {
		if (refreshWatchdogTimer !== 0) {
			clearTimeout(refreshWatchdogTimer)
			refreshWatchdogTimer = 0
		}
		if (refreshReleaseTimer !== 0) {
			clearTimeout(refreshReleaseTimer)
			refreshReleaseTimer = 0
		}
		refreshReleaseTimer = setTimeout(() => {
			refreshing.value = false
			refreshReleaseTimer = 0
			setTimeout(() => {
				refreshing.value = false
			}, 80)
		}, 40)
	}

	async function handleRefresh() {
		if (refreshing.value) {
			finishRefreshIndicator()
			return
		}
		beginRefreshIndicator()
		const now = Date.now()
		try {
			if (manualRefreshBlockedUntil.value > now) {
				return
			}
			if (now - lastManualRefreshAt.value < MANUAL_REFRESH_COOLDOWN_MS) {
				return
			}
			lastManualRefreshAt.value = now
			if (shouldSkipManualRefreshBecauseFresh(now)) {
				return
			}
			await syncConversationList(false)
			refreshFailureCount.value = 0
			manualRefreshBlockedUntil.value = 0
		} catch (e) {
			console.error('[Message] 下拉刷新失败:', e)
			const retryAfterMs = resolveRetryAfterMs(e)
			if (retryAfterMs > 0) {
				manualRefreshBlockedUntil.value = Date.now() + retryAfterMs
				return
			}
			refreshFailureCount.value = Math.min(refreshFailureCount.value + 1, 6)
			const backoffMs = Math.min(
				MANUAL_REFRESH_BACKOFF_MAX_MS,
				MANUAL_REFRESH_BACKOFF_BASE_MS * Math.pow(2, refreshFailureCount.value - 1)
			)
			manualRefreshBlockedUntil.value = Date.now() + backoffMs
		} finally {
			finishRefreshIndicator()
		}
	}

	function handleRefreshRestore() {
		forceStopRefreshIndicator()
	}

	function handleRefreshAbort() {
		forceStopRefreshIndicator()
	}

	/**
	 * 扫一扫
	 */
	function handleScan() {
		const platform = uni.getSystemInfoSync().platform
		if (platform === 'web') {
			uni.navigateTo({
				url: '/pages/message/join-group?manual=1'
			})
			return
		}
		uni.navigateTo({
			url: '/pages/common/scan'
		})
	}

	/**
	 * 同步角标
	 */
	function handleSyncBadge() {
		badgeService.forceSync()
	}

	/**
	 * 发起群聊
	 */
	function handleInitiateGroup() {
		uni.navigateTo({
			url: '/pages/contacts/initiate-group'
		})
	}

	/**
	 * 搜索
	 */
	function clearConversationFilter() {
		listSearchKeyword.value = ''
	}

	function handleSearch() {
		const kw = listSearchKeyword.value != null ? String(listSearchKeyword.value).trim() : ''
		const query = kw !== '' ? `?keyword=${encodeURIComponent(kw)}` : ''
		uni.navigateTo({
			url: '/pages/common/search' + query
		})
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	/* 头部区域 - 扁平化风格 */
	.header {
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-title {
		font-size: 20px;
		font-weight: 600;
	}

	.header-icons {
		flex-direction: row;
		align-items: center;
	}

	.header-icon {
		font-size: 22px;
		margin-left: 20px;
	}

	/* 搜索栏 - 浅灰色扁平风格 */
	.search-container {
		width: 100%;
		margin-top: 4px;
	}

	.search-bar {
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.search-clear {
		font-size: 16px;
		padding-left: 8px;
	}

	.placeholder {
	}

	/* 滚动内容区域 */
	.content-scroll {
		flex: 1;
		height: 0;
	}

	.inline-notice {
		min-height: 40px;
		padding: 10px 16px;
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1px;
	}

	.inline-notice-text {
		flex: 1;
		font-size: 13px;
		line-height: 18px;
		font-weight: 500;
	}

	.inline-notice-close {
		font-size: 14px;
		margin-left: 12px;
		padding: 4px;
	}

	/* 分类图标栏 - 更加简洁 */
	.category-bar {
		flex-direction: row;
		padding: 16px 16px 12px 16px;
		justify-content: space-between;
	}

	.category-item {
		align-items: center;
		width: 16%;
	}

	.category-icon-wrap {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
		margin-bottom: 6px;
	}

	.category-active {
		transform: scale(1.05);
	}

	.category-icon {
		font-size: 22px;
	}

	.category-text {
		font-size: 11px;
	}

	.category-text-active {
		font-weight: 600;
	}

	/* 消息列表 */
	.message-list {
		padding: 0;
	}

	.message-item {
		flex-direction: row;
		padding: 14px 16px;
		align-items: center;
		position: relative;
	}

	.pinned-item {
	}

	.message-item-active {
		background-color: rgba(143, 149, 158, 0.12);
	}

	.pinned-item-active {
		background-color: rgba(143, 149, 158, 0.16);
	}

	.fold-toggle {
		flex-direction: row;
		justify-content: center;
		align-items: center;
		padding: 12px 0;
	}

	.fold-text {
		font-size: 13px;
		margin-right: 4px;
	}

	.fold-icon {
		font-size: 12px;
	}

	.message-item-border {
		position: absolute;
		bottom: 0;
		left: 72px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.message-avatar {
		width: 48px;
		height: 48px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		position: relative;
		/* 确保角标不被裁剪 */
		overflow: visible;
	}

	.avatar-image {
		width: 48px;
		height: 48px;
		border-radius: 8px;
	}

	.unread-badge {
		position: absolute;
		/* 仿微信：向右上角偏移并突出 */
		top: -7px;
		right: -7px;
		background-color: #F54A45;
		border-radius: 10px;
		min-width: 18px;
		height: 18px;
		padding: 0 5px;
		justify-content: center;
		align-items: center;
		border-width: 2px;
		border-color: #FFFFFF;
		z-index: 10;
	}

	.unread-dot-only {
		min-width: 10px;
		height: 10px;
		padding: 0;
		top: -4px;
		right: -4px;
		border-radius: 5px;
	}
	
	.unread-count {
		color: #FFFFFF;
		font-size: 10px;
		font-weight: bold;
		line-height: 14px;
	}

	.avatar-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.message-content {
		flex: 1;
	}

	.message-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 4px;
	}

	.message-name-wrap {
		flex-direction: row;
		align-items: center;
		flex: 1;
		margin-right: 8px;
	}

	.message-name {
		font-size: 16px;
		font-weight: 500;
	}

	.member-count {
		font-size: 13px;
		margin-left: 4px;
	}

	.message-time {
		font-size: 12px;
	}

	.message-bottom {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.message-desc {
		flex: 1;
		flex-direction: row;
		align-items: flex-start;
		min-height: 18px;
		overflow: hidden;
		white-space: nowrap;
	}

	.message-desc-text {
		font-size: 13px;
		color: #666;
		line-height: 18px;
		white-space: nowrap;
	}

	.message-desc-text-alert {
		color: #F54A45;
	}

	.message-desc-emoji {
		width: 14px;
		height: 14px;
		margin: 2px 1px 0;
		flex-shrink: 0;
	}

	.atme-label {
		font-size: 13px;
		color: #F97316;
		margin-right: 6px;
		flex-shrink: 0;
	}

	.nodisturb-icon {
		font-size: 14px;
		color: #C1C4C9;
		margin-left: 8px;
	}

	/* 菜单弹窗样式 */
	.menu-mask {
		position: fixed;
		top: 0;
		left: 0;
