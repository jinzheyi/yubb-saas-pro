<template>
	<view class="page">
		<!-- 顶部状态栏占位 -->
		<view class="status-bar"></view>
		
		<!-- 头部搜索区域 -->
		<view class="header">
			<view class="header-top">
				<text class="header-title">{{ t('message.title', '消息') }}</text>
				<view class="header-icons">
					<text class="iconfont header-icon" @click="handleSyncBadge">&#xea5f;</text>
					<text class="iconfont header-icon" @click="handleScan">&#xea8b;</text>
					<text class="iconfont header-icon" @click="handleInitiateGroup">&#xea74;</text>
				</view>
			</view>
			<view class="search-container">
				<view class="search-bar" @click="handleSearch">
					<text class="iconfont search-icon">&#xea6e;</text>
					<input class="search-input" :placeholder="t('message.searchPlaceholder', '搜索')" placeholder-class="placeholder" disabled />
				</view>
			</view>
		</view>
		
		<!-- 分类图标栏 (置顶) -->
		<view class="category-bar">
			<view 
				class="category-item" 
				v-for="(item, index) in categories" 
				:key="index"
				@click="handleCategoryClick(item)"
			>
				<view class="category-icon-wrap" :class="{ 'category-active': selectedCategoryId === item.id }">
					<text class="iconfont category-icon" :style="{ color: selectedCategoryId === item.id ? '#3370FF' : item.color }">{{ item.icon }}</text>
				</view>
				<text class="category-text" :class="{ 'category-text-active': selectedCategoryId === item.id }">{{ t(item.nameKey) }}</text>
			</view>
		</view>

		<view class="section-divider"></view>

		<scroll-view class="content-scroll" scroll-y="true" show-scrollbar="false">
			<!-- 置顶消息列表 -->
			<view class="message-list" v-if="displayPinnedList.length > 0">
				<view 
					class="message-item pinned-item" 
					hover-class="pinned-item-active"
					v-for="(item, index) in displayPinnedList" 
					:key="'pinned-' + item.chatId" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<image v-if="item.targetAvatar" class="avatar-image" :src="item.targetAvatar" mode="aspectFill" @error="handleAvatarError(item)" />
						<text v-else-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name">{{ item.targetName }}</text>
								<text v-if="item.conversationType === 2 && item.groupMemberCount" class="member-count">({{ item.groupMemberCount }})</text>
							</view>
							<text class="message-time">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text v-if="item.lastMessageHasAtMe" class="atme-label">[有人@我]</text>
							<view class="message-desc">
								<template v-for="(token, tokenIndex) in item.lastMessagePreviewTokens" :key="'pinned-token-' + item.chatId + '-' + tokenIndex">
									<image v-if="token.type === 'emoji'" class="message-desc-emoji" :src="token.content" mode="aspectFit" />
									<text v-else class="message-desc-text">{{ token.content }}</text>
								</template>
							</view>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayPinnedList.length - 1 || showFoldToggle" class="message-item-border"></view>
				</view>
				
				<!-- 折叠/展开按钮 -->
				<view v-if="showFoldToggle" class="fold-toggle" @click="isPinnedFolded = !isPinnedFolded">
					<text class="fold-text">{{ isPinnedFolded ? t('message.fold.showMore', '展开置顶聊天') : t('message.fold.hideMore', '收起置顶聊天') }}</text>
					<text class="iconfont fold-icon">{{ isPinnedFolded ? '\ue60e' : '\ue68d' }}</text>
				</view>
			</view>

			<!-- 普通消息列表 -->
			<view class="message-list">
				<view 
					class="message-item" 
					hover-class="message-item-active"
					v-for="(item, index) in displayNormalList" 
					:key="'normal-' + item.chatId" 
					@click="handleMessageClick(item)"
					@longpress="handleLongPress(item, $event)"
				>
					<view class="message-avatar" :style="{ backgroundColor: item.avatarBg }">
						<image v-if="item.targetAvatar" class="avatar-image" :src="item.targetAvatar" mode="aspectFill" @error="handleAvatarError(item)" />
						<text v-else-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
						<text v-else class="avatar-text">{{ item.avatarText }}</text>
						<!-- 未读提醒 -->
						<view v-if="item.unreadCount > 0" :class="['unread-badge', item.noDisturb ? 'unread-dot-only' : '']">
							<text v-if="!item.noDisturb" class="unread-count">{{ item.unreadCount > 99 ? '99+' : item.unreadCount }}</text>
						</view>
					</view>
					<view class="message-content">
						<view class="message-top">
							<view class="message-name-wrap">
								<text class="message-name">{{ item.targetName }}</text>
								<text v-if="item.conversationType === 2 && item.groupMemberCount" class="member-count">({{ item.groupMemberCount }})</text>
							</view>
							<text class="message-time">{{ formatWeChatTime(item.lastMessageTime) }}</text>
						</view>
						<view class="message-bottom">
							<text v-if="item.lastMessageHasAtMe" class="atme-label">[有人@我]</text>
							<view class="message-desc">
								<template v-for="(token, tokenIndex) in item.lastMessagePreviewTokens" :key="'normal-token-' + item.chatId + '-' + tokenIndex">
									<image v-if="token.type === 'emoji'" class="message-desc-emoji" :src="token.content" mode="aspectFit" />
									<text v-else class="message-desc-text">{{ token.content }}</text>
								</template>
							</view>
							<text v-if="item.noDisturb" class="iconfont nodisturb-icon">&#xe63a;</text>
						</view>
					</view>
					<view v-if="index < displayNormalList.length - 1" class="message-item-border"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 长按右键菜单弹窗 -->
		<view v-if="showContextMenu" class="menu-mask" @click="closeMenu">
			<view class="menu-content" :style="{ top: menuY + 'px', left: menuX + 'px' }" @click.stop>
				<view class="menu-header">
					<text class="menu-title">{{ selectedItem?.targetName ?? '' }}</text>
				</view>
				<view class="menu-list">
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('pin')">
						<text class="menu-item-text">{{ selectedItem?.isPinned ? t('message.menu.unpin') : t('message.menu.pin') }}</text>
					</view>
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('unread')">
						<text class="menu-item-text">{{ selectedItem?.unread ? t('message.menu.read') : t('message.menu.unread') }}</text>
					</view>
					<view class="menu-item-btn" hover-class="menu-item-btn-active" @click="handleMenuAction('remove')">
						<text class="menu-item-text menu-danger">{{ t('message.menu.remove') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onShow, onHide, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { messageService } from '../../services/message-service.uts'
	import { conversationService, ConversationItem } from '../../services/conversation-service.uts'
	import { badgeService, BadgeData } from '../../services/badge-service.uts'
	import { deleteConversation, pinConversation, setNoDisturb } from '../../api/conversation.uts'
	import { getConversationAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { wsManager } from '../../utils/websocket.uts'
	import { encodeIdParam } from '../../utils/id-param.uts'
	import { parseMessageText as parseEmojiTokens, type MessageToken as EmojiToken } from '../../utils/emojiParser.uts'

	const { t } = useI18n()

	// 当前选中的分类 ID (空字符串表示显示全部，不选中任何特定分类)
	const selectedCategoryId = ref('')

	// 置顶折叠状态
	const isPinnedFolded = ref(true)

	// 菜单状态
	const showContextMenu = ref(false)
	const menuX = ref(0)
	const menuY = ref(0)
	const selectedItem = ref<any>(null)
	
	// 加载状态
	const loading = ref(false)
	const refreshing = ref(false)
	// onShow 刷新节流，避免频繁请求会话列表
	let lastOnShowRefreshAt = 0
	
	// 角标监听器
	const badgeListener = {
		onBadgeUpdate: (badgeData: BadgeData) => {
			// 更新会话列表的未读数
			messageList.value.forEach(conv => {
				conv.unreadCount = badgeData.conversationBadges.get(conv.chatId) || 0
			})
		}
	}

	onShow(() => {
		wsManager.setRealtimeBizActive(true)
		// 返回到会话列表时刷新一次，确保新创建的群聊/会话能立刻展示（不依赖推送时机）
		// 同时做节流，避免频繁触发 /conversation/list
		const now = Date.now()
		if (now - lastOnShowRefreshAt > 1500) {
			lastOnShowRefreshAt = now
			void loadConversations()
		}
	})

	onHide(() => {
		wsManager.setRealtimeBizActive(false)
	})

	onUnload(() => {
		wsManager.setRealtimeBizActive(false)
	})

	/**
	 * 获取分类 ID（根据会话属性自动分类）
	 */
	function getCategoryId(conv : any) : string {
		// 优先级：置顶 > @我 > 免打扰 > 群聊 > 单聊
		if (conv.isPinned) return 'latest'
		if (conv.lastMessageHasAtMe) return 'at'
		if (conv.noDisturb) return 'nodisturb'
		if (conv.conversationType === 2) return 'group'
		return 'user'
	}

	function normalizeTimestampMs(raw: any): number {
		try {
			if (raw == null) {
				return 0
			}
			if (typeof raw === 'number') {
				if (!isFinite(raw) || raw <= 0) {
					return 0
				}
				const ms = raw < 100000000000 ? raw * 1000 : raw
				if (ms < 946684800000) {
					return 0
				}
				return Math.floor(ms)
			}
			const text = String(raw).trim()
			if (text === '') {
				return 0
			}
			if (/^[0-9]+$/.test(text)) {
				const numVal = Number(text)
				if (!isFinite(numVal) || numVal <= 0) {
					return 0
				}
				const ms = text.length <= 10 ? numVal * 1000 : numVal
				if (ms < 946684800000) {
					return 0
				}
				return Math.floor(ms)
			}
			const parsed = new Date(text).getTime()
			if (isNaN(parsed) || parsed <= 0 || parsed < 946684800000) {
				return 0
			}
			return parsed
		} catch (e) {
			return 0
		}
	}

	function resolveAvatarText(targetName: any, targetId: any): string {
		const name = targetName != null ? String(targetName).trim() : ''
		if (name !== '') {
			return getAvatarText(name)
		}
		const idText = targetId != null ? String(targetId).trim() : ''
		if (idText !== '' && idText !== '0') {
			return getAvatarText(idText)
		}
		return '?'
	}
	
	/**
	 * 转换后端会话数据为 UI 格式
	 */
	function convertServerConversation(serverConv : any) : any {
		const lastMessageTime = normalizeTimestampMs(serverConv.lastMessageTime)
		const isGroup = serverConv.conversationType === 2
		const previewText = buildConversationPreview(serverConv.lastMessageType || 0, serverConv.lastMessageContent || '')
		const targetName = serverConv.targetName != null ? String(serverConv.targetName).trim() : ''
		const targetId = serverConv.targetId != null ? String(serverConv.targetId) : '0'
		
		return {
			chatId: serverConv.chatId != null ? serverConv.chatId.toString() : '0',
			lastMessageSequence: serverConv.lastMessageSequence != null ? serverConv.lastMessageSequence.toString() : '0',
			lastReadSequence: serverConv.lastReadSequence != null ? serverConv.lastReadSequence.toString() : '0',
			categoryId: getCategoryId(serverConv),
			targetName: targetName !== '' ? targetName : '未知',
			lastMessageType: serverConv.lastMessageType || 0,
			lastMessageContent: previewText,
			lastMessagePreviewTokens: buildConversationPreviewTokens(previewText),
			lastMessageTime: lastMessageTime,
			targetAvatar: serverConv.targetAvatar != null ? String(serverConv.targetAvatar) : '',
			avatarBg: getConversationAvatarColor(serverConv.conversationType, targetId),
			avatarText: resolveAvatarText(targetName, targetId),
			avatarIcon: isGroup ? '\ue616' : '', // 群聊显示群图标
			unreadCount: serverConv.unreadCount || 0,
			noDisturb: serverConv.noDisturb || false,
			isPinned: serverConv.isPinned || false,
			lastMessageHasAtMe: serverConv.lastMessageHasAtMe === true,
			pinnedTime: serverConv.isPinned ? lastMessageTime : 0,
			conversationType: serverConv.conversationType,
			groupMemberCount: serverConv.groupMemberCount || 0,
			targetId: targetId
		}
	}

	/**
	 * 仿微信时间格式化
	 */
	function formatWeChatTime(timestamp : number) : string {
		const normalizedTs = normalizeTimestampMs(timestamp)
		if (normalizedTs <= 0) {
			return ''
		}
		const date = new Date(normalizedTs)
		const now = new Date()
		
		const isToday = date.getFullYear() === now.getFullYear() && 
						date.getMonth() === now.getMonth() && 
						date.getDate() === now.getDate()
		
		if (isToday) {
			const hours = date.getHours().toString().padStart(2, '0')
			const minutes = date.getMinutes().toString().padStart(2, '0')
			return `${hours}:${minutes}`
		}
		
		const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = date.getFullYear() === yesterday.getFullYear() && 
							date.getMonth() === yesterday.getMonth() && 
							date.getDate() === yesterday.getDate()
		
		if (isYesterday) {
			return '昨天'
		}
		
		// 判断是否在同一周 (简单判断：7天内且星期几小于等于今天)
		const oneWeekAgo = now.getTime() - 7 * 24 * 60 * 60 * 1000
		if (normalizedTs > oneWeekAgo) {
			const weekDays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']
			return weekDays[date.getDay()]
		}
		
		// 超过一周显示日期
		const year = date.getFullYear()
		const month = (date.getMonth() + 1).toString().padStart(2, '0')
		const day = date.getDate().toString().padStart(2, '0')
		
		if (year === now.getFullYear()) {
			return `${month}/${day}`
		}
		return `${year}/${month}/${day}`
	}

	function handleAvatarError(item : any): void {
		try {
			if (item == null) {
				return
			}
			item.targetAvatar = ''
		} catch (e) {
			// ignore
		}
	}

	// 分类数据
	const categories = [
		{ id: 'latest', icon: '\ue61e', color: '#666', nameKey: 'message.categories.latest' },
		{ id: 'user', icon: '\ue624', color: '#666', nameKey: 'message.categories.user' },
		{ id: 'group', icon: '\ue616', color: '#666', nameKey: 'message.categories.groupQuery' },
		{ id: 'business', icon: '\ue60a', color: '#666', nameKey: 'message.categories.business' },
		{ id: 'at', icon: '\ue7ab', color: '#666', nameKey: 'message.categories.at' },
		{ id: 'nodisturb', icon: '\ue63a', color: '#666', nameKey: 'message.categories.noDisturb' }
	]

	function buildConversationPreview(messageType : any, raw : string) : string {
		const trimmed = raw != null ? raw.toString().trim().replace(/\r?\n+/g, ' ') : ''
		if (trimmed !== '') {
			if (trimmed.length > 100) {
				return trimmed.substring(0, 100) + '...'
			}
			return trimmed
		}
		if (messageType === 'sticker') return '[动画表情]'
		if (messageType === 'custom') return '[自定义消息]'
		if (messageType === 1) {
			return ''
		}
		if (messageType === 2) return '[图片]'
		if (messageType === 3) return '[语音]'
		if (messageType === 4) return '[视频]'
		if (messageType === 5) return '[文件]'
		if (messageType === 6) return '[位置]'
		if (messageType === 7) return '[表情]'
		if (messageType === 8) return '[动画表情]'
		if (messageType === 10) return '[系统消息]'
		return ''
	}

	function buildConversationPreviewTokens(preview: string): EmojiToken[] {
		if (preview == null || preview === '') {
			return [] as EmojiToken[]
		}
		try {
			return parseEmojiTokens(preview)
		} catch (e) {
			return [{
				type: 'text',
				content: preview
			} as EmojiToken]
		}
	}

	// 消息列表原始数据
	const messageList = ref<any[]>([])
	
	/**
	 * 初始化页面
	 */
	onMounted(() => {
		// 1. 监听会话更新
		conversationService.addUpdateListener(handleConversationsUpdate)
		
		// 2. 加载会话列表
		loadConversations()
		
		// 3. 监听角标更新
		badgeService.addListener(badgeListener)
	})
	
	onUnmounted(() => {
		// 移除监听器
		conversationService.removeUpdateListener(handleConversationsUpdate)
		badgeService.removeListener(badgeListener)
	})
	
	/**
	 * 加载会话列表
	 */
	async function loadConversations() {
		loading.value = true
		
		try {
			// 1. 先从缓存加载（立即显示）
			const cachedConversations = messageService.getConversations()
			if (cachedConversations.length > 0) {
				messageList.value = cachedConversations.map(conv => {
					const previewText = buildConversationPreview((conv as any).lastMessageType || 0, conv.lastMessageContent)
					return {
						chatId: conv.chatId,
						lastMessageSequence: (conv as any).lastMessageSequence != null ? (conv as any).lastMessageSequence.toString() : '0',
						lastReadSequence: (conv as any).lastReadSequence != null ? (conv as any).lastReadSequence.toString() : '0',
						categoryId: getCategoryId({ 
							isPinned: conv.isPinned, 
							noDisturb: conv.noDisturb, 
							conversationType: conv.conversationType 
						}),
						targetName: conv.targetName,
						lastMessageType: (conv as any).lastMessageType || 0,
						lastMessageContent: previewText,
						lastMessagePreviewTokens: buildConversationPreviewTokens(previewText),
						lastMessageTime: normalizeTimestampMs(conv.timestamp),
						targetAvatar: conv.targetAvatar,
						avatarBg: conv.avatarBg,
						avatarText: resolveAvatarText(conv.avatarText != null && String(conv.avatarText).trim() !== '' ? conv.avatarText : conv.targetName, conv.targetId),
						avatarIcon: conv.conversationType === 2 ? '\ue616' : '',
						unreadCount: conv.unreadCount,
						noDisturb: conv.noDisturb,
						isPinned: conv.isPinned,
						lastMessageHasAtMe: conv.lastMessageHasAtMe,
						pinnedTime: conv.isPinned ? conv.timestamp : 0,
						conversationType: conv.conversationType,
						groupMemberCount: conv.groupMemberCount || 0,
						targetId: conv.targetId
					}
				})
			}
			
			// 2. 加载会话列表（内部根据本地 cursor + 内存缓存决定是否 reset）
			await conversationService.loadConversations()
			
		} catch (e) {
			console.error('[Message] 加载会话列表失败:', e)
			uni.showToast({ title: '加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 处理会话更新（来自 WebSocket 或其他页面）
	 */
	function handleConversationsUpdate(conversations : ConversationItem[]) {
		// 全量刷新（来源：ConversationService，服务端权威水位 + 本地实时更新）
		messageList.value = conversations.map(conv => {
			const previewText = buildConversationPreview((conv as any).lastMessageType || 0, conv.lastMessageContent)
			return {
				chatId: conv.chatId,
				lastMessageSequence: (conv as any).lastMessageSequence != null ? (conv as any).lastMessageSequence.toString() : '0',
				lastReadSequence: (conv as any).lastReadSequence != null ? (conv as any).lastReadSequence.toString() : '0',
				categoryId: getCategoryId({
					isPinned: conv.isPinned,
					noDisturb: conv.noDisturb,
					conversationType: conv.conversationType
				}),
				targetName: conv.targetName,
				lastMessageType: (conv as any).lastMessageType || 0,
				lastMessageContent: previewText,
				lastMessagePreviewTokens: buildConversationPreviewTokens(previewText),
				lastMessageTime: normalizeTimestampMs(conv.timestamp),
				targetAvatar: conv.targetAvatar,
				avatarBg: conv.avatarBg,
				avatarText: resolveAvatarText(conv.avatarText != null && String(conv.avatarText).trim() !== '' ? conv.avatarText : conv.targetName, conv.targetId),
				avatarIcon: conv.conversationType === 2 ? '\ue616' : '',
				unreadCount: conv.unreadCount,
				noDisturb: conv.noDisturb,
				isPinned: conv.isPinned,
				lastMessageHasAtMe: conv.lastMessageHasAtMe,
				pinnedTime: conv.isPinned ? conv.timestamp : 0,
				conversationType: conv.conversationType,
				groupMemberCount: conv.groupMemberCount || 0,
				targetId: conv.targetId
			}
		}).sort((a, b) => {
			if (a.isPinned && !b.isPinned) return -1
			if (!a.isPinned && b.isPinned) return 1
			return b.lastMessageTime - a.lastMessageTime
		})
	}
	
	// 过滤后的基础列表
	const filteredBaseList = computed(() : any[] => {
		if (selectedCategoryId.value === '') {
			return messageList.value
		}
		if (selectedCategoryId.value === 'at') {
			return messageList.value.filter(item => item.lastMessageHasAtMe)
		}
		return messageList.value.filter(item => item.categoryId === selectedCategoryId.value)
	})

	// 置顶消息列表
	const allPinnedList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => item.isPinned).sort((a, b) => b.pinnedTime - a.pinnedTime)
	})

	// 最终显示的置顶列表
	const displayPinnedList = computed(() : any[] => {
		if (isPinnedFolded.value && allPinnedList.value.length > 5) {
			return allPinnedList.value.slice(0, 5)
		}
		return allPinnedList.value
	})

	// 是否显示折叠切换按钮
	const showFoldToggle = computed(() : boolean => {
		return allPinnedList.value.length > 5
	})

	// 普通消息列表
	const displayNormalList = computed(() : any[] => {
		return filteredBaseList.value.filter(item => !item.isPinned)
	})

	function handleCategoryClick(item : any) {
		if (selectedCategoryId.value === item.id) {
			// 如果点击的是当前已选中的，则重置为空，即显示“全部”原始列表
			selectedCategoryId.value = ''
		} else {
			selectedCategoryId.value = item.id
		}
	}

	function handleMessageClick(item : any) {
		const chatIdParam = encodeIdParam(item.chatId != null ? String(item.chatId) : '')
		uni.navigateTo({
			url: `/pages/message/chat?chatId=${chatIdParam}&entryMode=latest`
		})
	}

	function handleLongPress(item : any, e : TouchEvent) {
		selectedItem.value = item
		// 获取点击位置，简单处理弹窗位置
		const touch = e.touches[0]
		menuX.value = Math.min(touch.clientX, uni.getSystemInfoSync().screenWidth - 160)
		menuY.value = touch.clientY
		showContextMenu.value = true
	}

	function closeMenu() {
		showContextMenu.value = false
	}

	async function handleMenuAction(action : string) {
		if (!selectedItem.value) return
		
		const targetItem = selectedItem.value
		
		try {
			switch (action) {
				case 'pin':
					// 调用置顶 API
					const newPinnedState = !targetItem.isPinned
					await pinConversation(targetItem.chatId, newPinnedState)
					
					// 更新本地状态
					targetItem.isPinned = newPinnedState
					if (targetItem.isPinned) {
						targetItem.pinnedTime = Date.now()
						targetItem.categoryId = 'latest'
					} else {
						targetItem.pinnedTime = 0
						// 重新计算分类
						targetItem.categoryId = getCategoryId(targetItem)
					}
					
					// 重新排序
					messageList.value.sort((a, b) => {
						if (a.isPinned && !b.isPinned) return -1
						if (!a.isPinned && b.isPinned) return 1
						return b.lastMessageTime - a.lastMessageTime
					})
					
					uni.showToast({
						title: newPinnedState ? '已置顶' : '已取消置顶',
						icon: 'success'
					})
					break
					
				case 'unread':
					// 标记已读/未读
					if (targetItem.unreadCount > 0) {
						// 清空未读数（按 sequence 水位优先）
						const seq = (targetItem as any).lastMessageSequence != null ? (targetItem as any).lastMessageSequence.toString() : '0'
						badgeService.clearConversationBadge(targetItem.chatId, seq)
						targetItem.unreadCount = 0
						uni.showToast({
							title: '已标记为已读',
							icon: 'success'
						})
					} else {
						// 标记为未读（设置未读数为1）
						targetItem.unreadCount = 1
						uni.showToast({
							title: '已标记为未读',
							icon: 'success'
						})
					}
					break
					
				case 'remove':
					// 删除会话
					uni.showModal({
						title: '删除会话',
						content: '确定要删除该会话吗？',
						success: async (res) => {
							if (res.confirm) {
								await deleteConversation(targetItem.chatId)
								
								// 从列表中移除
								const index = messageList.value.findIndex(i => i.chatId === targetItem.chatId)
								if (index > -1) {
									messageList.value.splice(index, 1)
								}
								
								uni.showToast({
									title: '已删除',
									icon: 'success'
								})
							}
						}
					})
					break
			}
		} catch (e) {
			console.error('[Message] 操作失败:', e)
			uni.showToast({
				title: '操作失败',
				icon: 'none'
			})
		}
		
		closeMenu()
	}

	/**
	 * 扫一扫
	 */
	function handleScan() {
		uni.showToast({
			title: '扫一扫功能开发中',
			icon: 'none'
		})
	}

	/**
	 * 同步角标
	 */
	function handleSyncBadge() {
		badgeService.forceSync()
	}

	/**
	 * 发起群聊
	 */
	function handleInitiateGroup() {
		uni.navigateTo({
			url: '/pages/contacts/initiate-group'
		})
	}

	/**
	 * 搜索
	 */
	function handleSearch() {
		uni.navigateTo({
			url: '/pages/common/search'
		})
	}
</script>

<style>
