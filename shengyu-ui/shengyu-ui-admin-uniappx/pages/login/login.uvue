<template>
  <view class="login-container">
    <view class="login-header">
      <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
      <view class="title">企业即时通讯</view>
      <view class="subtitle">高效沟通，协同办公</view>
    </view>
    
    <view class="login-form">
      <view class="form-item">
        <view class="label">账号</view>
        <input 
          v-model="form.username" 
          class="input" 
          placeholder="请输入账号" 
          placeholder-style="color: #999"
          @input="onInput"
        />
      </view>
      
      <view class="form-item">
        <view class="label">密码</view>
        <input 
          v-model="form.password" 
          class="input" 
          placeholder="请输入密码" 
          placeholder-style="color: #999"
          password
          @input="onInput"
        />
      </view>

      <!-- 验证码组件，pop模式 -->
      <Verify
        mode="pop"
        :captchaType="captchaType"
        @success="handleCaptchaSuccess"
        @fail="handleCaptchaFail"
        ref="verify"
      ></Verify>

      <view class="form-actions">
        <view class="forget-password" @click="forgetPassword">忘记密码？</view>
      </view>

      <button
        class="login-btn"
        type="primary"
        :disabled="!canLogin"
        @click="login"
      >
        登录
      </button>
    </view>

    <view class="login-footer">
      <view class="copyright">© 2024 企业即时通讯系统</view>
    </view>
  </view>
</template>

<script lang="uts">
  import { ref, reactive, computed } from 'vue'
  import { login as loginApi, type LoginParams } from '@/api/auth.uts'
  import { setToken, setRefreshToken, setUserInfo, setTenantId, setExpiresTime, getToken, isLoggedIn } from '@/utils/auth.uts'
  import Verify from '@/components/verifition/Verify.uvue'

  export default {
    components: {
      Verify
    },
    setup() {
      const form = reactive({
        username: 'jin_zheyicn@qq.com',
        password: '123456'
      })

      const captchaType = ref('blockPuzzle') // 验证码类型：blockPuzzle（滑块）或 clickWord（点选）
      const captchaVerification = ref('') // 验证码验证结果
      const verify = ref<any>(null) // 验证码组件引用

      const canLogin = computed(() => {
        return form.username.trim() && form.password.trim()
      })

      const onInput = () => {
        // 输入事件处理
      }

      const forgetPassword = () => {
        uni.showToast({
          title: '忘记密码功能开发中',
          icon: 'none'
        })
      }

      // 处理验证码成功
      const handleCaptchaSuccess = (res) => {
        captchaVerification.value = res.captchaVerification
        console.log('验证码验证成功:', captchaVerification.value)
        // 验证码验证成功后，自动执行登录请求
        doLogin()
      }

      // 处理验证码失败
      const handleCaptchaFail = (res) => {
        console.log('验证码验证失败:', res)
        // 显示错误信息
        uni.showToast({
          title: res.repMsg || '验证码验证失败',
          icon: 'none'
        })
        // 清空验证码验证结果
        captchaVerification.value = ''
      }

      // 执行登录请求
      const doLogin = async () => {
        try {
          uni.showLoading({
            title: '登录中...'
          })
          
          // 将验证码信息添加到登录请求中
          const loginData = {
            ...form,
            captchaVerification: captchaVerification.value
          } as LoginParams
          
          const res = await loginApi(loginData)

          // 调试：打印完整的响应数据
          console.log('完整响应数据:', res)

          // 保存token和用户信息
          setToken(res.data.accessToken)
          setRefreshToken(res.data.refreshToken)

          // 保存token过期时间
          if (res.data.expiresTime) {
            setExpiresTime(res.data.expiresTime)
            console.log('保存的过期时间:', res.data.expiresTime)
          }

          // 保存租户ID
          if (res.data.tenantId) {
            setTenantId(res.data.tenantId)
            console.log('保存的租户ID:', res.data.tenantId)
          }

          // 后端返回的用户信息可能不包含nickname和avatar，使用username作为昵称
          setUserInfo({
            nickName: res.data.username || '用户',
            avatarUrl: ''
          })

          // 调试：检查token是否被正确保存
          console.log('保存的token:', getToken())
          console.log('登录状态:', isLoggedIn() ? '已登录' : '未登录')

          uni.showToast({
            title: '登录成功',
            icon: 'success',
            duration: 1000
          })

          // 直接跳转，不等待showToast完成
          setTimeout(() => {
            try {
              // 尝试使用navigateTo
              uni.navigateTo({
                url: '/pages/index/index',
                success: () => {
                  console.log('navigateTo跳转成功')
                },
                fail: (err) => {
                  console.error('navigateTo跳转失败', err)
                  // 如果navigateTo失败，尝试使用redirectTo
                  uni.redirectTo({
                    url: '/pages/index/index',
                    success: () => {
                      console.log('redirectTo跳转成功')
                    },
                    fail: (err2) => {
                      console.error('redirectTo跳转失败', err2)
                      // 如果redirectTo也失败，尝试使用reLaunch
                      uni.reLaunch({
                        url: '/pages/index/index',
                        success: () => {
                          console.log('reLaunch跳转成功')
                        },
                        fail: (err3) => {
                          console.error('reLaunch跳转失败', err3)
                        }
                      })
                    }
                  })
                }
              })
            } catch (error) {
              console.error('跳转异常', error)
            }
          }, 1000)
        } catch (error) {
          const err = error as Error
          uni.showToast({
            title: err.message || '登录失败',
            icon: 'none'
          })

          // 登录失败时刷新验证码
          if (verify.value && verify.value.refresh) {
            verify.value.refresh()
          }

          // 清空验证码验证结果
          captchaVerification.value = ''
        } finally {
          // 确保无论如何都会隐藏loading
          uni.hideLoading()
        }
      }

      // 登录入口
      const login = async () => {
        // 如果没有验证码验证结果，显示验证码弹窗
        if (!captchaVerification.value) {
          verify.value.show()
        } else {
          // 已有验证码结果，直接登录
          await doLogin()
        }
      }

      return {
        form,
        captchaType,
        captchaVerification,
        verify,
        canLogin,
        onInput,
        forgetPassword,
        handleCaptchaSuccess,
        handleCaptchaFail,
        login
      }
    }
  }
</script>

<style scoped>
  .login-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 60rpx 40rpx;
    background-color: #f5f5f5;
  }

  .login-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 80rpx;
  }

  .logo {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 40rpx;
  }

  .title {
    font-size: 48rpx;
    font-weight: bold;
    color: #1a1a1a;
    margin-bottom: 16rpx;
  }

  .subtitle {
    font-size: 28rpx;
    color: #666;
  }

  .login-form {
    flex: 1;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 48rpx 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  }

  .form-item {
    margin-bottom: 40rpx;
  }

  .label {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
  }

  .input {
    width: 100%;
    height: 88rpx;
    border: 2rpx solid #e5e5e5;
    border-radius: 8rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    color: #333;
    background-color: #fafafa;
  }

  .input:focus {
    border-color: #007aff;
    background-color: #fff;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 48rpx;
  }

  .forget-password {
    font-size: 24rpx;
    color: #007aff;
  }

  .login-btn {
    width: 100%;
    height: 96rpx;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    background-color: #007aff;
    color: #fff;
  }

  .login-btn:disabled {
    background-color: #c0c0c0;
    color: #fff;
}

  /* 验证码容器样式 */
  .captcha-container {
    margin-top: 10px;
  }

  .login-footer {
    display: flex;
    justify-content: center;
    margin-top: 60rpx;
  }
  
  .copyright {
    font-size: 24rpx;
    color: #999;
  }
</style>