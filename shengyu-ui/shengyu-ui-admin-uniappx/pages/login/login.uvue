		background-color: #3370FF;
		border-radius: 1px;
	}

	.form-body {
		display: flex;
		flex-direction: column;
	}

	.input-item {
		flex-direction: row;
		align-items: center;
		height: 48px;
		background-color: #F5F7FA;
