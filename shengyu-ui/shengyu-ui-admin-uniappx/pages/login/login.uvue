<template>
	<view class="login-container">
		<!-- 背景装饰 -->
		<view class="bg-decoration">
			<view class="circle circle-1"></view>
			<view class="circle circle-2"></view>
		</view>

		<view class="top-actions">
			<view class="locale-entry" hover-class="locale-entry-active" @click="showLanguagePanel = true">
				<text class="iconfont locale-entry-icon">&#xe998;</text>
				<text class="locale-entry-text">{{ currentLanguageLabel }}</text>
				<text class="iconfont locale-entry-arrow">&#xeb03;</text>
			</view>
		</view>

		<!-- 头部区域 -->
		<view class="header">
			<view class="logo-wrap">
				<image class="logo" src="/static/logo.jpg" mode="aspectFit"></image>
			</view>
			<text class="title">{{ t('login.welcome') }}</text>
			<text class="subtitle">{{ t('login.subtitle') }}</text>
		</view>
		
		<!-- 登录卡片 -->
		<view class="login-card">
			<!-- 登录方式切换 -->
			<view class="tabs">
				<view 
					:class="['tab-item', { active: loginType === 'account' }]" 
					@click="loginType = 'account'"
				>
					<text :class="['tab-text', { active: loginType === 'account' }]">{{ t('login.btnAccount') }}</text>
					<view v-if="loginType === 'account'" class="active-line"></view>
				</view>
				<view 
					:class="['tab-item', { active: loginType === 'mobile' }]" 
					@click="loginType = 'mobile'"
				>
					<text :class="['tab-text', { active: loginType === 'mobile' }]">{{ t('login.btnMobile') }}</text>
					<view v-if="loginType === 'mobile'" class="active-line"></view>
				</view>
			</view>

			<!-- 表单区域 -->
			<view class="form-body">
				<!-- 账号登录 -->
				<view v-if="loginType === 'account'">
					<view class="input-item">
						<text class="iconfont input-icon">&#xea97;</text>
						<input 
							class="input" 
							v-model="username" 
							:placeholder="t('login.usernamePlaceholder')"
							placeholder-class="placeholder"
						/>
					</view>
					<picker class="debug-account-picker" mode="selector" :range="debugAccountOptions" @change="handleDebugAccountSelect">
						<view class="debug-account-picker-inner">
							<text class="debug-account-picker-label">调试账号快速选择（临时）</text>
							<text class="debug-account-picker-value">{{ currentDebugAccountLabel }}</text>
						</view>
					</picker>
					
					<view class="input-item">
						<text class="iconfont input-icon">&#xea8d;</text>
						<input 
							class="input" 
							v-model="password" 
							type="password"
							:placeholder="t('login.passwordPlaceholder')"
							placeholder-class="placeholder"
							@confirm="handleLogin"
						/>
					</view>
					
					<view class="action-row">
						<checkbox-group @change="handleRememberChange">
							<label class="remember-label">
								<checkbox :checked="rememberMe" color="#1677FF" style="transform:scale(0.7)" />
								<text class="remember-text">{{ t('login.remember') }}</text>
							</label>
						</checkbox-group>
						<text class="forgot-text">{{ t('login.forgetPassword') }}</text>
					</view>
				</view>
				
				<!-- 手机号登录 -->
				<view v-else>
					<view class="input-item">
						<text class="iconfont input-icon">&#xea94;</text>
						<input 
							class="input" 
							v-model="mobile" 
							type="number"
							:placeholder="t('login.mobileNumberPlaceholder')"
							placeholder-class="placeholder"
						/>
					</view>
					
					<view class="input-item">
						<text class="iconfont input-icon">&#xea8b;</text>
						<input 
							class="input" 
							v-model="smsCode" 
							type="number"
							:placeholder="t('login.codePlaceholder')"
							placeholder-class="placeholder"
							@confirm="handleLogin"
						/>
						<view class="code-btn-wrap" @click="handleSendCode">
							<text :class="['code-btn-text', { disabled: codeCountdown > 0 }]">
								{{ codeCountdown > 0 ? codeCountdown + 's' : t('login.getSmsCode') }}
							</text>
						</view>
					</view>
				</view>
				
				<!-- 登录按钮 -->
				<button 
					class="login-btn"
							hover-class="login-btn-active"
					:loading="loading"
					@click="handleLogin"
				>
					<text class="login-btn-text">{{ t('common.login') }}</text>
				</button>
			</view>
		</view>

		<view class="footer">
			<view class="copyright">
				<text class="copyright-text">Copyright © 2026 Shengyu Tech. All Rights Reserved.</text>
			</view>
		</view>

		<view v-if="showHarmonyCapabilityHint" class="harmony-hint">
			<text class="harmony-hint-title">{{ t('login.harmonyCapabilityTitle') }}</text>
			<text class="harmony-hint-text">{{ t('login.harmonyCapabilityDesc') }}</text>
		</view>

		<view v-if="showLanguagePanel" class="panel-mask" @click="showLanguagePanel = false">
			<view class="panel-sheet" @click.stop>
				<view class="panel-handle"></view>
				<view class="panel-header">
					<text class="panel-title">{{ t('profile.languageSettings.title') }}</text>
					<text class="iconfont panel-close" @click="showLanguagePanel = false">&#xeb08;</text>
				</view>
				<language-settings-panel @change="handleLanguageChanged" />
			</view>
		</view>
		
		<!-- 滑块验证码组件 -->
		<slider-captcha 
			ref="captchaRef" 
			captchaType="blockPuzzle"
			@success="handleCaptchaSuccess"
			@fail="handleCaptchaFail"
		/>
	</view>
</template>

<script setup lang="uts">
	import { login, smsLogin, sendSmsCode, getPermissionInfo } from '../../api/login.uts'
	import { setToken, setUserInfo, setDeviceInfo, isLoggedIn } from '../../store/user.uts'
	import { getDeviceInfo } from '../../utils/device.uts'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getLanguageMode, type LanguageMode } from '../../store/locale.uts'
	import { badgeService } from '../../services/badge-service.uts'
	import { tabBarBadgeService } from '../../services/tab-bar-badge-service.uts'
	import { canUseHarmonySliderCaptcha, getHarmonyReadinessSnapshot } from '../../services/harmony-readiness-service.uts'
	import { syncUserPreferencesFromServer } from '../../services/user-preference-service.uts'
	import { wsManager } from '../../utils/websocket.uts'
	import SliderCaptcha from '../../components/captcha/slider-captcha.uvue'
	import LanguageSettingsPanel from '../../components/settings/language-settings-panel.uvue'
	import { CAPTCHA_ENABLE, SMS_CODE_COUNTDOWN } from '../../config/app.config.uts'
	
	// 国际化
	const { t } = useI18n()
	const currentLanguageMode = ref<LanguageMode>(getLanguageMode())

	const currentLanguageLabel = computed((): string => {
		if (currentLanguageMode.value === 'zh-CN') {
			return t('profile.settingsPage.languageZhCn')
		}
		if (currentLanguageMode.value === 'en') {
			return t('profile.settingsPage.languageEn')
		}
		return t('profile.settingsPage.languageFollowSystem')
	})
	
	// 登录类型
	const loginType = ref<string>('account')
	const debugAccountOptions = ['jin_zheyicn@qq.com', '136870475@qq.com']
	
	// 表单数据
	const username = ref<string>('jin_zheyicn@qq.com')
	const password = ref<string>('123456')
	const mobile = ref<string>('')
	const smsCode = ref<string>('')
	const rememberMe = ref<boolean>(false)
	
	// 状态
	const loading = ref<boolean>(false)
	const showLanguagePanel = ref<boolean>(false)
	const codeCountdown = ref<number>(0)
	const captchaRef = ref<any>(null)
	const captchaEnable = ref<string>(CAPTCHA_ENABLE) 

	const showHarmonyCapabilityHint = computed((): boolean => {
		const snapshot = getHarmonyReadinessSnapshot()
		return snapshot.isHarmony && !snapshot.sliderCaptchaReady
	})

	const currentDebugAccountLabel = computed((): string => {
		if (username.value == null || String(username.value).trim() === '') {
			return '请选择'
		}
		return String(username.value)
	})

	function handleDebugAccountSelect(e: any): void {
		const idx = e != null && e.detail != null && e.detail.value != null ? Number(e.detail.value) : -1
		if (isNaN(idx) || idx < 0 || idx >= debugAccountOptions.length) {
			return
		}
		username.value = debugAccountOptions[idx]
	}
	
	// 记住我
	function handleRememberChange(e: any) {
		rememberMe.value = e.detail.value.length > 0
	}
	
	// 发送验证码
	async function handleSendCode() {
		if (codeCountdown.value > 0) return
		if (!/^1[3-9]\d{9}$/.test(mobile.value)) {
			uni.showToast({ title: t('login.mobileNumberPlaceholder'), icon: 'none' })
			return
		}
		
		try {
			await sendSmsCode({ mobile: mobile.value, scene: 21 })
			uni.showToast({ title: t('login.SmsSendMsg'), icon: 'success' })
			codeCountdown.value = SMS_CODE_COUNTDOWN
			const timer = setInterval(() => {
				codeCountdown.value--
				if (codeCountdown.value <= 0) clearInterval(timer)
			}, 1000)
		} catch (e) {}
	}
	
	// 登录逻辑
	async function handleLogin() {
		if (loginType.value === 'account') {
			if (!username.value || !password.value) {
				uni.showToast({ title: t('login.toastAccountRequired'), icon: 'none' })
				return
			}
			if (captchaEnable.value === 'false') {
				await doLogin('')
			} else {
				if (!canUseHarmonySliderCaptcha()) {
					uni.showModal({
						title: t('login.harmonyCapabilityTitle'),
						content: t('login.harmonyCapabilityDesc'),
						showCancel: false,
						confirmText: t('common.ok')
					})
					return
				}
				captchaRef.value?.show()
			}
		} else {
			if (!mobile.value || !smsCode.value) {
				uni.showToast({ title: t('login.toastMobileRequired'), icon: 'none' })
				return
			}
			await doLogin('')
		}
	}
	
	function handleCaptchaSuccess(data: any) {
		doLogin(data.captchaVerification)
	}
	
	function handleCaptchaFail(payload: any = null) {
		if (payload != null && payload.code === 'HARMONY_AES_REQUIRED') {
			uni.showToast({ title: String(payload.message || t('captcha.harmonyAesRequired')), icon: 'none' })
			return
		}
		const msg = payload != null && payload.message ? String(payload.message) : t('captcha.fail')
		uni.showToast({ title: msg, icon: 'none' })
	}
	
	function handleLanguageChanged(languageMode: LanguageMode) {
		currentLanguageMode.value = languageMode
		showLanguagePanel.value = false
		uni.showToast({
			title: t('common.switchSuccess'),
			icon: 'success'
		})
	}
	
	async function doLogin(verification: string) {
		loading.value = true
		try {
			let tokenData: any
			if (loginType.value === 'account') {
				tokenData = await login({
					username: username.value,
					password: password.value,
					captchaVerification: verification
				})
			} else {
				tokenData = await smsLogin({
					mobile: mobile.value,
					code: smsCode.value
				})
			}
			
			// 保存 Token
			setToken(tokenData)
			
			// 保存设备信息（登录接口已自动携带设备信息）
			const deviceInfo = getDeviceInfo()
			if (deviceInfo != null) {
				setDeviceInfo(deviceInfo)
			}
			
			// 获取用户权限信息
			const userInfo = await getPermissionInfo()
			if (userInfo) setUserInfo(userInfo)
			void syncUserPreferencesFromServer(true)

			// 登录成功后立即初始化角标服务，确保首个 tab 页直接拿到统一角标
			badgeService.init()
			tabBarBadgeService.init()
			try {
				wsManager.setProtocols(['im.pb.v1'])
				const wsReady = await wsManager.ensureConnected(4000)
				console.log('[Login] WebSocket ready after login:', wsReady)
			} catch (e) {
				console.warn('[Login] ensure WebSocket connected failed:', e)
			}
			
			// 记住密码
			if (loginType.value === 'account' && rememberMe.value) {
				uni.setStorageSync('REMEMBER_ME', JSON.stringify({ username: username.value }))
			} else if (loginType.value === 'account') {
				uni.removeStorageSync('REMEMBER_ME')
			}
			
			uni.showToast({ title: t('sys.login.loginSuccessTitle'), icon: 'success' })
			setTimeout(() => {
				uni.switchTab({ url: '/pages/message/message' })
			}, 1500)
		} catch (e) {
		} finally {
			loading.value = false
		}
	}
	
	onMounted(() => {
		currentLanguageMode.value = getLanguageMode()
		// 检查是否已登录，如果已登录则跳转到消息列表
		if (isLoggedIn()) {
			console.log('[Login] 用户已登录，跳转到消息列表')
			uni.switchTab({ url: '/pages/message/message' })
			return
		}
		
		// 读取记住的账号
		const rememberData = uni.getStorageSync('REMEMBER_ME')
		if (rememberData) {
			try {
				const data = JSON.parse(rememberData)
				username.value = data.username || ''
				rememberMe.value = true
			} catch (e) {}
		}
	})
</script>

<style>
