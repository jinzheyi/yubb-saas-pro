<template>
	<view class="login-container">
		<!-- Logo 和标题 -->
		<view class="header">
			<image class="logo" src="/static/logo.png"></image>
			<text class="title">{{ t('login.welcome') }}</text>
			<text class="subtitle">{{ t('login.message') }}</text>
		</view>
		
		<!-- 语言切换 -->
		<view class="locale-switch">
			<text 
				v-for="item in availableLocales" 
				:key="item.lang"
				@click="handleSwitchLocale(item.lang)"
				:class="['locale-item', { active: locale === item.lang }]"
			>
				{{ item.name }}
			</text>
		</view>
		
		<!-- 登录表单 -->
		<view class="form-container">
			<!-- 账号登录 -->
			<view v-if="loginType === 'account'">
				
				<view class="form-item">
					<text class="label">{{ t('login.username') }}</text>
					<input 
						class="input" 
						v-model="username" 
						:placeholder="t('login.usernamePlaceholder')"
					/>
				</view>
				
				<view class="form-item">
					<text class="label">{{ t('login.password') }}</text>
					<input 
						class="input" 
						v-model="password" 
						type="password"
						:placeholder="t('login.passwordPlaceholder')"
						@confirm="handleLogin"
					/>
				</view>
				
				<!-- 记住我 - 仅账号登录显示 -->
				<view class="remember-row">
					<checkbox-group @change="handleRememberChange">
						<label>
							<checkbox :checked="rememberMe" />
							<text class="remember-text">{{ t('login.remember') }}</text>
						</label>
					</checkbox-group>
				</view>
			</view>
			
			<!-- 手机号登录 - 不显示租户名称 -->
			<view v-else>
				<view class="form-item">
					<text class="label">{{ t('login.mobileNumber') }}</text>
					<input 
						class="input" 
						v-model="mobile" 
						type="number"
						:placeholder="t('login.mobileNumberPlaceholder')"
					/>
				</view>
				
				<view class="form-item">
					<text class="label">{{ t('login.code') }}</text>
					<view class="code-input-wrapper">
						<input 
							class="input code-input" 
							v-model="smsCode" 
							type="number"
							:placeholder="t('login.codePlaceholder')"
							@confirm="handleLogin"
						/>
						<button 
							class="code-btn" 
							:disabled="codeCountdown > 0"
							@click="handleSendCode"
						>
							{{ codeCountdown > 0 ? codeCountdown + 's' : t('login.getSmsCode') }}
						</button>
					</view>
				</view>
			</view>
			
			<!-- 登录按钮 -->
			<button 
				class="login-btn" 
				:loading="loading"
				@click="handleLogin"
			>
				{{ t('common.login') }}
			</button>
			
			<!-- 切换登录方式 -->
			<view class="switch-row">
				<text 
					class="switch-text" 
					@click="switchLoginType"
				>
					{{ loginType === 'account' ? t('login.btnMobile') : t('login.btnAccount') }}
				</text>
			</view>
		</view>
		
		<!-- 滑块验证码组件 -->
		<slider-captcha 
			ref="captchaRef" 
			captchaType="blockPuzzle"
			@success="handleCaptchaSuccess"
			@fail="handleCaptchaFail"
		/>
	</view>
</template>

<script setup lang="uts">
	import { login, smsLogin, sendSmsCode, getPermissionInfo } from '../../api/login.uts'
	import { setToken, setUserInfo } from '../../store/user.uts'
	import { useI18n } from '../../hooks/useI18n.uts'
	import type { LocaleType } from '../../store/locale.uts'
	import SliderCaptcha from '../../components/captcha/slider-captcha.uvue'
	import { CAPTCHA_ENABLE, DEFAULT_TENANT_NAME, SMS_CODE_COUNTDOWN } from '../../config/app.config.uts'
	
	// 国际化
	const { t, locale, availableLocales, switchLocale } = useI18n()
	
	// 登录类型
	const loginType = ref<string>('account')
	
	// 表单数据
	const tenantName = ref<string>(DEFAULT_TENANT_NAME)
	const username = ref<string>('jin_zheyicn@qq.com')
	const password = ref<string>('123456')
	const mobile = ref<string>('')
	const smsCode = ref<string>('')
	const rememberMe = ref<boolean>(false)
	
	// 状态
	const loading = ref<boolean>(false)
	const codeCountdown = ref<number>(0)
	const captchaVerification = ref<string>('') // 验证码验证结果
	
	// 验证码组件引用
	const captchaRef = ref<any>(null)
	
	// 验证码配置（严格参考 PC 端）
	// PC 端：captchaEnable: import.meta.env.VITE_APP_CAPTCHA_ENABLE
	// 判断逻辑：if (loginData.captchaEnable === 'false') 则直接登录
	const captchaEnable = ref<string>(CAPTCHA_ENABLE) // 'true' 启用，'false' 禁用
	
	// 切换登录方式
	function switchLoginType() {
		loginType.value = loginType.value === 'account' ? 'mobile' : 'account'
		// 切换时清空验证码倒计时
		if (loginType.value === 'account') {
			codeCountdown.value = 0
		}
	}
	
	// 记住我
	function handleRememberChange(e: any) {
		rememberMe.value = e.detail.value.length > 0
	}
	
	// 发送验证码
	async function handleSendCode() {
		// 验证手机号
		if (mobile.value === '') {
			uni.showToast({
				title: t('login.mobileNumberPlaceholder'),
				icon: 'none'
			})
			return
		}
		
		// 简单的手机号格式验证
		const phoneReg = /^1[3-9]\d{9}$/
		if (!phoneReg.test(mobile.value)) {
			uni.showToast({
				title: t('login.mobileNumberPlaceholder'),
				icon: 'none'
			})
			return
		}
		
		try {
			await sendSmsCode({
				mobile: mobile.value,
				scene: 21 // 登录场景
			})
			
			uni.showToast({
				title: t('login.SmsSendMsg'),
				icon: 'success'
			})
			
			// 开始倒计时（使用配置的倒计时时间）
			codeCountdown.value = SMS_CODE_COUNTDOWN
			const timer = setInterval(() => {
				codeCountdown.value--
				if (codeCountdown.value <= 0) {
					clearInterval(timer)
				}
			}, 1000)
		} catch (e) {
			console.error('发送验证码失败', e)
		}
	}
	
	// 获取租户ID（仅账号登录需要）
	async function fetchTenantId() {
		try {
			const tenantId = await getTenantIdByName(tenantName.value)
			setTenantId(tenantId)
		} catch (e) {
			console.error('获取租户ID失败', e)
			uni.showToast({
				title: '租户名称不存在',
				icon: 'none'
			})
			throw e
		}
	}
	
	// 登录按钮点击（严格参考 PC 端 getCode 方法）
	async function handleLogin() {
		// 验证表单
		if (loginType.value === 'account') {
			// 账号登录验证
			if (username.value === '') {
				uni.showToast({
					title: t('login.usernamePlaceholder'),
					icon: 'none'
				})
				return
			}
			if (password.value === '') {
				uni.showToast({
					title: t('login.passwordPlaceholder'),
					icon: 'none'
				})
				return
			}
			
			// 严格参考 PC 端验证码逻辑
			// PC 端代码：
			// const getCode = async () => {
			//   if (loginData.captchaEnable === 'false') {
			//     await handleLogin({})
			//   } else {
			//     verify.value.show()
			//   }
			// }
			
			// 情况一，未开启：则直接登录
			if (captchaEnable.value === 'false') {
				await doLogin('')
			} else {
				// 情况二，已开启：则展示验证码；只有完成验证码的情况，才进行登录
				if (captchaRef.value) {
					captchaRef.value.show()
				}
			}
		} else {
			// 手机号登录验证
			if (mobile.value === '') {
				uni.showToast({
					title: t('login.mobileNumberPlaceholder'),
					icon: 'none'
				})
				return
			}
			if (smsCode.value === '') {
				uni.showToast({
					title: t('login.codePlaceholder'),
					icon: 'none'
				})
				return
			}
			
			// 手机号登录不需要验证码，直接登录
			await doLogin('')
		}
	}
	
	// 验证码验证成功
	function handleCaptchaSuccess(data: any) {
		captchaVerification.value = data.captchaVerification
		doLogin(data.captchaVerification)
	}
	
	// 验证码验证失败
	function handleCaptchaFail() {
		console.log('验证码验证失败')
		uni.showToast({
			title: t('captcha.fail'),
			icon: 'none'
		})
	}
	
	// 切换语言
	function handleSwitchLocale(newLocale: LocaleType) {
		switchLocale(newLocale)
	}
	
	// 执行登录
	async function doLogin(verification: string) {
		loading.value = true
		
		try {
			// 登录（后端已做用户兼容多租户处理，不需要前端获取租户ID）
			let tokenData: any
			if (loginType.value === 'account') {
				tokenData = await login({
					username: username.value,
					password: password.value,
					captchaVerification: verification
				})
			} else {
				tokenData = await smsLogin({
					mobile: mobile.value,
					code: smsCode.value
				})
			}
			
			// 保存 token（包含 tenantId 和 deptId）
			setToken(tokenData)
			
			// 加载用户信息（从后端获取）
			await loadUserInfo()
			
			// 记住我（仅账号登录）
			if (loginType.value === 'account' && rememberMe.value) {
				uni.setStorageSync('REMEMBER_ME', JSON.stringify({
					username: username.value
				}))
			} else if (loginType.value === 'account' && !rememberMe.value) {
				uni.removeStorageSync('REMEMBER_ME')
			}
			
			// 登录成功提示
			uni.showToast({
				title: t('sys.login.loginSuccessTitle'),
				icon: 'success',
				duration: 1500
			})
			
			// 延迟跳转，让用户看到成功提示
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/message/message'
				})
			}, 1500)
		} catch (e) {
			console.error('登录失败', e)
			// 错误已在 request.uts 中处理，这里不需要再次提示
		} finally {
			loading.value = false
		}
	}
	
	// 加载用户信息
	async function loadUserInfo() {
		try {
			// 调用获取用户信息接口
			const userInfo = await getPermissionInfo()
			if (userInfo) {
				// 保存用户信息、权限、角色
				setUserInfo(userInfo)
			}
		} catch (e) {
			console.error('加载用户信息失败', e)
		}
	}
	
	// 页面加载时恢复记住的信息
	onMounted(() => {
		const rememberData = uni.getStorageSync('REMEMBER_ME')
		if (rememberData != null && rememberData != '') {
			try {
				const data = JSON.parse(rememberData)
				tenantName.value = data.tenantName || DEFAULT_TENANT_NAME
				username.value = data.username || ''
				rememberMe.value = true
			} catch (e) {
				console.error('解析记住的登录信息失败', e)
			}
		}
	})
</script>

<style>
	.login-container {
		min-height: 100vh;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		padding: 40px 30px;
	}
	
	.header {
		text-align: center;
		margin-bottom: 60px;
	}
	
	.logo {
		width: 100px;
		height: 100px;
		margin-bottom: 20px;
	}
	
	.title {
		font-size: 28px;
		color: #ffffff;
		font-weight: bold;
		margin-bottom: 10px;
	}
	
	.subtitle {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.8);
	}
	
	.locale-switch {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 30px;
		gap: 20px;
	}
	
	.locale-item {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.7);
		padding: 5px 15px;
		border-radius: 15px;
		transition: all 0.3s;
	}
	
	.locale-item.active {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.2);
		font-weight: bold;
	}
	
	.form-container {
		background: #ffffff;
		border-radius: 20px;
		padding: 30px;
	}
	
	.form-item {
		margin-bottom: 20px;
	}
	
	.label {
		display: block;
		font-size: 14px;
		color: #333333;
		margin-bottom: 8px;
	}
	
	.input {
		width: 100%;
		height: 45px;
		border: 1px solid #e0e0e0;
		border-radius: 8px;
		padding: 0 15px;
		font-size: 14px;
	}
	
	.code-input-wrapper {
		display: flex;
		align-items: center;
	}
	
	.code-input {
		flex: 1;
		margin-right: 10px;
	}
	
	.code-btn {
		width: 110px;
		height: 45px;
		background: #667eea;
		color: #ffffff;
		border: none;
		border-radius: 8px;
		font-size: 13px;
	}
	
	.code-btn[disabled] {
		background: #cccccc;
	}
	
	.remember-row {
		margin-bottom: 20px;
	}
	
	.remember-text {
		font-size: 14px;
		color: #666666;
		margin-left: 5px;
	}
	
	.login-btn {
		width: 100%;
		height: 50px;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		color: #ffffff;
		border: none;
		border-radius: 25px;
		font-size: 16px;
		font-weight: bold;
		margin-bottom: 15px;
	}
	
	.switch-row {
		text-align: center;
	}
	
	.switch-text {
		font-size: 14px;
		color: #667eea;
	}
</style>
