<template>
  <view class="login-container">
    <view class="login-header">
      <image class="logo" src="/static/logo.png" mode="aspectFit"></image>
      <view class="title">企业即时通讯</view>
      <view class="subtitle">高效沟通，协同办公</view>
    </view>
    
    <view class="login-form">
      <view class="form-item">
        <view class="label">账号</view>
        <input 
          v-model="form.username" 
          class="input" 
          placeholder="请输入账号" 
          placeholder-style="color: #999"
          @input="onInput"
        />
      </view>
      
      <view class="form-item">
        <view class="label">密码</view>
        <input 
          v-model="form.password" 
          class="input" 
          placeholder="请输入密码" 
          placeholder-style="color: #999"
          password
          @input="onInput"
        />
      </view>
      
      <view class="form-actions">
        <view class="forget-password" @click="forgetPassword">忘记密码？</view>
      </view>
      
      <button 
        class="login-btn" 
        type="primary" 
        :disabled="!canLogin" 
        @click="login"
      >
        登录
      </button>
    </view>
    
    <view class="login-footer">
      <view class="copyright">© 2024 企业即时通讯系统</view>
    </view>
  </view>
</template>

<script lang="uts">
  import { ref, reactive, computed } from 'vue'
  import { login as loginApi } from '@/api/auth.uts'
  import { setToken, setRefreshToken, setUserInfo, setTenantId, setExpiresTime, getToken, isLoggedIn } from '@/utils/auth.uts'
  
  export default {
    data() {
      return {
        form: {
          username: '',
          password: ''
        }
      }
    },
    computed: {
      canLogin() {
        return this.form.username.trim() && this.form.password.trim()
      }
    },
    methods: {
      onInput() {
        // 输入事件处理
      },
      
      forgetPassword() {
        uni.showToast({
          title: '忘记密码功能开发中',
          icon: 'none'
        })
      },
      
      async login() {
        try {
          uni.showLoading({
            title: '登录中...'
          })
          
          const res = await loginApi(this.form)
          
          // 调试：打印完整的响应数据
          console.log('完整响应数据:', res)
          
          // 保存token和用户信息
          setToken(res.data.accessToken)
          setRefreshToken(res.data.refreshToken)
          
          // 保存token过期时间
          if (res.data.expiresTime) {
            setExpiresTime(res.data.expiresTime)
            console.log('保存的过期时间:', res.data.expiresTime)
          }
          
          // 保存租户ID
          if (res.data.tenantId) {
            setTenantId(res.data.tenantId)
            console.log('保存的租户ID:', res.data.tenantId)
          }
          
          // 后端返回的用户信息可能不包含nickname和avatar，使用username作为昵称
          setUserInfo({
            nickName: res.data.username || '用户',
            avatarUrl: ''
          })
          
          // 调试：检查token是否被正确保存
          console.log('保存的token:', getToken())
          console.log('登录状态:', isLoggedIn() ? '已登录' : '未登录')
          
          uni.showToast({
            title: '登录成功',
            icon: 'success',
            duration: 1000
          })
          
          // 直接跳转，不等待showToast完成
          setTimeout(() => {
            try {
              // 尝试使用navigateTo
              uni.navigateTo({
                url: '/pages/index/index',
                success: () => {
                  console.log('navigateTo跳转成功')
                },
                fail: (err) => {
                  console.error('navigateTo跳转失败', err)
                  // 如果navigateTo失败，尝试使用redirectTo
                  uni.redirectTo({
                    url: '/pages/index/index',
                    success: () => {
                      console.log('redirectTo跳转成功')
                    },
                    fail: (err2) => {
                      console.error('redirectTo跳转失败', err2)
                      // 如果redirectTo也失败，尝试使用reLaunch
                      uni.reLaunch({
                        url: '/pages/index/index',
                        success: () => {
                          console.log('reLaunch跳转成功')
                        },
                        fail: (err3) => {
                          console.error('reLaunch跳转失败', err3)
                        }
                      })
                    }
                  })
                }
              })
            } catch (error) {
              console.error('跳转异常', error)
            }
          }, 1000)
        } catch (error: any) {
          uni.showToast({
            title: error.message || '登录失败',
            icon: 'none'
          })
        } finally {
          // 确保无论如何都会隐藏loading
          uni.hideLoading()
        }
      }
    }
  }
</script>

<style scoped>
  .login-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 60rpx 40rpx;
    background-color: #f5f5f5;
  }
  
  .login-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 80rpx;
  }
  
  .logo {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 40rpx;
  }
  
  .title {
    font-size: 48rpx;
    font-weight: bold;
    color: #1a1a1a;
    margin-bottom: 16rpx;
  }
  
  .subtitle {
    font-size: 28rpx;
    color: #666;
  }
  
  .login-form {
    flex: 1;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 48rpx 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  }
  
  .form-item {
    margin-bottom: 40rpx;
  }
  
  .label {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
  }
  
  .input {
    width: 100%;
    height: 88rpx;
    border: 2rpx solid #e5e5e5;
    border-radius: 8rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
    color: #333;
    background-color: #fafafa;
  }
  
  .input:focus {
    border-color: #007aff;
    background-color: #fff;
  }
  
  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 48rpx;
  }
  
  .forget-password {
    font-size: 24rpx;
    color: #007aff;
  }
  
  .login-btn {
    width: 100%;
    height: 96rpx;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    background-color: #007aff;
    color: #fff;
  }
  
  .login-btn:disabled {
    background-color: #c0c0c0;
    color: #fff;
  }
  
  .login-footer {
    display: flex;
    justify-content: center;
    margin-top: 60rpx;
  }
  
  .copyright {
    font-size: 24rpx;
    color: #999;
  }
</style>