<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('profile.settingsPage.title') }}</text>
			<view class="header-right"></view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="settings-group" :style="{ backgroundColor: theme.cardBg }">
				<view class="list-item" hover-class="list-item-active" @click="handleAction('theme')">
					<text class="item-label" :style="{ color: theme.textPrimary }">{{ t('profile.settingsPage.themeTitle') }}</text>
					<text class="item-desc" :style="{ color: theme.textTertiary }">{{ t('profile.settingsPage.themeDesc') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="list-item item-border" hover-class="list-item-active" @click="handleAction('chatBubble')" :style="{ borderTopColor: theme.borderColor }">
					<text class="item-label" :style="{ color: theme.textPrimary }">{{ t('profile.settingsPage.chatBubbleTitle') }}</text>
					<text class="item-desc" :style="{ color: theme.textTertiary }">{{ t('profile.settingsPage.chatBubbleDesc') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="list-item item-border" hover-class="list-item-active" @click="handleAction('language')" :style="{ borderTopColor: theme.borderColor }">
					<text class="item-label" :style="{ color: theme.textPrimary }">{{ t('profile.settingsPage.languageTitle') }}</text>
					<text class="item-desc" :style="{ color: theme.textTertiary }">{{ languageDesc }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
				<view class="list-item item-border" hover-class="list-item-active" @click="handleAction('checkUpdate')" :style="{ borderTopColor: theme.borderColor }">
					<text class="item-label" :style="{ color: theme.textPrimary }">{{ t('profile.settingsPage.checkUpdateTitle') }}</text>
					<text class="item-desc" :style="{ color: theme.textTertiary }">{{ t('profile.settingsPage.versionDesc', { version: appVersion }) }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
			</view>

			<view class="settings-group harmony-group" :style="{ backgroundColor: theme.cardBg }" v-if="isHarmonyClient">
				<view class="group-header">
					<text class="group-title" :style="{ color: theme.textPrimary }">{{ t('profile.settingsPage.harmonyStatusTitle') }}</text>
					<text class="group-badge" :style="{ color: harmonyReadyColor }">{{ harmonyReadyText }}</text>
				</view>
				<view class="status-row" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyPlatformLabel') }}</text>
					<text class="status-value" :style="{ color: theme.textPrimary }">{{ harmonyPlatformText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyApiLabel') }}</text>
					<text class="status-value" :style="{ color: theme.textPrimary }">{{ harmonyApiText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyAesLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyAesColor }">{{ harmonyAesText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyAesSourceLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyAesSourceColor }">{{ harmonyAesSourceText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyAesImplLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyAesImplColor }">{{ harmonyAesImplText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyUpgradeLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyUpgradeColor }">{{ harmonyUpgradeText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyScanLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyScanColor }">{{ harmonyScanText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyCameraBridgeLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyCameraBridgeColor }">{{ harmonyCameraBridgeText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyCameraPermissionLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyCameraPermissionColor }">{{ harmonyCameraPermissionText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyMicrophonePermissionLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyMicrophonePermissionColor }">{{ harmonyMicrophonePermissionText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyMicrophoneBridgeLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyMicrophoneBridgeColor }">{{ harmonyMicrophoneBridgeText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyVoiceRecordLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyVoiceRecordColor }">{{ harmonyVoiceRecordText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyVoicePlaybackLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyVoicePlaybackColor }">{{ harmonyVoicePlaybackText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyShareLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyShareColor }">{{ harmonyShareText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyImagePreviewLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyImagePreviewColor }">{{ harmonyImagePreviewText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyDocumentOpenLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyDocumentOpenColor }">{{ harmonyDocumentOpenText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyLocationLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyLocationColor }">{{ harmonyLocationText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyLocationBridgeLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyLocationBridgeColor }">{{ harmonyLocationBridgeText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyLocationPermissionLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyLocationPermissionColor }">{{ harmonyLocationPermissionText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyLocationSwitchLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyLocationSwitchColor }">{{ harmonyLocationSwitchText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyAlbumLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyAlbumColor }">{{ harmonyAlbumText }}</text>
				</view>
				<view class="status-row item-border" :style="{ borderTopColor: theme.borderColor }">
					<text class="status-label" :style="{ color: theme.textSecondary }">{{ t('profile.settingsPage.harmonyAlbumPermissionLabel') }}</text>
					<text class="status-value" :style="{ color: harmonyAlbumPermissionColor }">{{ harmonyAlbumPermissionText }}</text>
				</view>
				<text class="status-hint" :style="{ color: theme.textTertiary }">{{ t('profile.settingsPage.harmonyStatusHint') }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { appUpgradeService, UpgradeResultCode } from '../../services/app-upgrade-service.uts'
	import { getAppVersion, getCurrentClientPlatform, ClientPlatformCode } from '../../utils/device.uts'
	import { getHarmonyReadinessSnapshot } from '../../services/harmony-readiness-service.uts'
	import { getLanguageMode, getResolvedLocale, subscribeLocaleChange, type LanguageMode } from '../../store/locale.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const appVersion = ref(getAppVersion())
	const theme = ref<ThemeTokens>(getThemeTokens())
	const { t } = useI18n()
	const currentLanguageMode = ref<LanguageMode>(getLanguageMode())
	const currentResolvedLocale = ref(getResolvedLocale())
	const harmonySnapshot = ref(getHarmonyReadinessSnapshot())
	const checkingUpdate = ref(false)
	let unsubscribeTheme: (() => void) | null = null
	let unsubscribeLocale: (() => void) | null = null

	const isHarmonyClient = computed((): boolean => {
		return harmonySnapshot.value.isHarmony
	})

	const harmonyPlatformText = computed((): string => {
		const osVersion = harmonySnapshot.value.osVersion
		return osVersion !== ''
			? `HarmonyOS ${osVersion}`
			: 'HarmonyOS'
	})

	const harmonyApiText = computed((): string => {
		return harmonySnapshot.value.harmonyApiVersion != null
			? `API ${harmonySnapshot.value.harmonyApiVersion}`
			: t('profile.settingsPage.harmonyApiUnknown')
	})

	const harmonyAesReady = computed((): boolean => {
		return harmonySnapshot.value.aesRuntimeReady
	})

	const harmonyAesText = computed((): string => {
		return harmonyAesReady.value
			? t('profile.settingsPage.harmonyAesReady')
			: t('profile.settingsPage.harmonyAesPending')
	})

	const harmonyAesColor = computed((): string => {
		return harmonyAesReady.value ? '#2BA471' : '#D9534F'
	})

	const harmonyAesSourceText = computed((): string => {
		const source = harmonySnapshot.value.aesRuntimeSource
		if (source === 'NATIVE_UTS_PLUGIN') {
			return t('profile.settingsPage.harmonyAesSourcePlugin')
		}
		if (source === 'EXTERNAL_RUNTIME') {
			return t('profile.settingsPage.harmonyAesSourceExternal')
		}
		return t('profile.settingsPage.harmonyAesSourcePending')
	})

	const harmonyAesSourceColor = computed((): string => {
		const source = harmonySnapshot.value.aesRuntimeSource
		if (source === 'NATIVE_UTS_PLUGIN' || source === 'EXTERNAL_RUNTIME') {
			return '#2BA471'
		}
		return '#D48806'
	})

	const harmonyAesImplText = computed((): string => {
		const name = harmonySnapshot.value.nativeAesPluginImplementation
		return name !== '' ? name : t('profile.settingsPage.harmonyAesImplUnknown')
	})

	const harmonyAesImplColor = computed((): string => {
		return harmonySnapshot.value.nativeAesPluginImplementation !== '' ? '#2BA471' : '#D48806'
	})

	const harmonyUpgradeText = computed((): string => {
		return harmonySnapshot.value.upgradeEntryReady
			? t('profile.settingsPage.harmonyUpgradeAppGallery')
			: t('profile.settingsPage.harmonyUpgradePending')
	})

	const harmonyUpgradeColor = computed((): string => {
		return harmonySnapshot.value.upgradeEntryReady ? '#2BA471' : '#D48806'
	})

	const harmonyShareText = computed((): string => {
		return harmonySnapshot.value.systemShareReady
			? t('profile.settingsPage.harmonyShareReady')
			: t('profile.settingsPage.harmonyShareFallback')
	})

	const harmonyScanText = computed((): string => {
		return harmonySnapshot.value.systemScanReady
			? t('profile.settingsPage.harmonyStatusReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyScanColor = computed((): string => {
		return harmonySnapshot.value.systemScanReady ? '#2BA471' : '#D48806'
	})

	const harmonyCameraBridgeText = computed((): string => {
		return harmonySnapshot.value.cameraPermissionBridgeReady
			? t('profile.settingsPage.harmonyLocationBridgeReady')
			: t('profile.settingsPage.harmonyLocationBridgePending')
	})

	const harmonyCameraBridgeColor = computed((): string => {
		return harmonySnapshot.value.cameraPermissionBridgeReady ? '#2BA471' : '#D48806'
	})

	function getHarmonyAuthorizeText(status: string): string {
		if (status === 'authorized') {
			return t('profile.settingsPage.harmonyLocationPermissionReady')
		}
		if (status === 'denied') {
			return t('profile.settingsPage.harmonyLocationPermissionDenied')
		}
		return t('profile.settingsPage.harmonyLocationPermissionUnknown')
	}

	function getHarmonyAuthorizeColor(status: string): string {
		if (status === 'authorized') {
			return '#2BA471'
		}
		if (status === 'denied') {
			return '#D9534F'
		}
		return '#D48806'
	}

	const harmonyCameraPermissionText = computed((): string => {
		return getHarmonyAuthorizeText(harmonySnapshot.value.cameraAuthorized)
	})

	const harmonyCameraPermissionColor = computed((): string => {
		return getHarmonyAuthorizeColor(harmonySnapshot.value.cameraAuthorized)
	})

	const harmonyMicrophonePermissionText = computed((): string => {
		return getHarmonyAuthorizeText(harmonySnapshot.value.microphoneAuthorized)
	})

	const harmonyMicrophonePermissionColor = computed((): string => {
		return getHarmonyAuthorizeColor(harmonySnapshot.value.microphoneAuthorized)
	})

	const harmonyMicrophoneBridgeText = computed((): string => {
		return harmonySnapshot.value.microphonePermissionBridgeReady
			? t('profile.settingsPage.harmonyLocationBridgeReady')
			: t('profile.settingsPage.harmonyLocationBridgePending')
	})

	const harmonyMicrophoneBridgeColor = computed((): string => {
		return harmonySnapshot.value.microphonePermissionBridgeReady ? '#2BA471' : '#D48806'
	})

	const harmonyVoiceRecordText = computed((): string => {
		return harmonySnapshot.value.voiceRecordReady
			? t('profile.settingsPage.harmonyStatusReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyVoiceRecordColor = computed((): string => {
		return harmonySnapshot.value.voiceRecordReady ? '#2BA471' : '#D48806'
	})

	const harmonyVoicePlaybackText = computed((): string => {
		return harmonySnapshot.value.voicePlaybackReady
			? t('profile.settingsPage.harmonyStatusReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyVoicePlaybackColor = computed((): string => {
		return harmonySnapshot.value.voicePlaybackReady ? '#2BA471' : '#D48806'
	})

	const harmonyShareColor = computed((): string => {
		return harmonySnapshot.value.systemShareReady ? '#2BA471' : '#D48806'
	})

	const harmonyImagePreviewText = computed((): string => {
		return harmonySnapshot.value.imagePreviewReady
			? t('profile.settingsPage.harmonyShareReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyImagePreviewColor = computed((): string => {
		return harmonySnapshot.value.imagePreviewReady ? '#2BA471' : '#D48806'
	})

	const harmonyDocumentOpenText = computed((): string => {
		return harmonySnapshot.value.documentOpenReady
			? t('profile.settingsPage.harmonyShareReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyDocumentOpenColor = computed((): string => {
		return harmonySnapshot.value.documentOpenReady ? '#2BA471' : '#D48806'
	})

	const harmonyLocationText = computed((): string => {
		return harmonySnapshot.value.openLocationReady
			? t('profile.settingsPage.harmonyLocationReady')
			: t('profile.settingsPage.harmonyLocationPending')
	})

	const harmonyLocationColor = computed((): string => {
		return harmonySnapshot.value.openLocationReady ? '#2BA471' : '#D48806'
	})

	const harmonyLocationBridgeText = computed((): string => {
		return harmonySnapshot.value.locationPermissionBridgeReady
			? t('profile.settingsPage.harmonyLocationBridgeReady')
			: t('profile.settingsPage.harmonyLocationBridgePending')
	})

	const harmonyLocationBridgeColor = computed((): string => {
		return harmonySnapshot.value.locationPermissionBridgeReady ? '#2BA471' : '#D48806'
	})

	const harmonyLocationPermissionText = computed((): string => {
		const auth = harmonySnapshot.value.locationAuthorized
		if (auth === 'authorized') {
			return t('profile.settingsPage.harmonyLocationPermissionReady')
		}
		if (auth === 'denied') {
			return t('profile.settingsPage.harmonyLocationPermissionDenied')
		}
		if (auth === 'not determined') {
			return t('profile.settingsPage.harmonyLocationPermissionUnknown')
		}
		return t('profile.settingsPage.harmonyLocationPermissionUnknown')
	})

	const harmonyLocationPermissionColor = computed((): string => {
		return harmonySnapshot.value.locationAuthorized === 'authorized' ? '#2BA471' : '#D48806'
	})

	const harmonyLocationSwitchText = computed((): string => {
		if (harmonySnapshot.value.locationEnabled === true) {
			return t('profile.settingsPage.harmonyLocationSwitchOn')
		}
		if (harmonySnapshot.value.locationEnabled === false) {
			return t('profile.settingsPage.harmonyLocationSwitchOff')
		}
		return t('profile.settingsPage.harmonyLocationSwitchUnknown')
	})

	const harmonyLocationSwitchColor = computed((): string => {
		return harmonySnapshot.value.locationEnabled === true ? '#2BA471' : '#D48806'
	})

	const harmonyAlbumReady = computed((): boolean => {
		return harmonySnapshot.value.saveImageToAlbumReady && harmonySnapshot.value.saveVideoToAlbumReady
	})

	const harmonyAlbumText = computed((): string => {
		return harmonyAlbumReady.value
			? t('profile.settingsPage.harmonyAlbumReady')
			: t('profile.settingsPage.harmonyAlbumPending')
	})

	const harmonyAlbumColor = computed((): string => {
		return harmonyAlbumReady.value ? '#2BA471' : '#D48806'
	})

	const harmonyAlbumPermissionText = computed((): string => {
		return getHarmonyAuthorizeText(harmonySnapshot.value.albumAuthorized)
	})

	const harmonyAlbumPermissionColor = computed((): string => {
		return getHarmonyAuthorizeColor(harmonySnapshot.value.albumAuthorized)
	})

	const harmonyReadyText = computed((): string => {
		return harmonyAesReady.value
			? t('profile.settingsPage.harmonyStatusReady')
			: t('profile.settingsPage.harmonyStatusPending')
	})

	const harmonyReadyColor = computed((): string => {
		return harmonyAesReady.value ? '#2BA471' : '#D9534F'
	})

	const languageDesc = computed((): string => {
		if (currentLanguageMode.value === 'system') {
			return currentResolvedLocale.value === 'en' ? t('profile.settingsPage.languageFollowSystemEn') : t('profile.settingsPage.languageFollowSystem')
		}
		return currentLanguageMode.value === 'en' ? t('profile.settingsPage.languageEn') : t('profile.settingsPage.languageZhCn')
	})

	function handleBack() {
		uni.navigateBack()
	}

	function getUpgradeActionText(): string {
		return getCurrentClientPlatform() === ClientPlatformCode.HARMONY
			? t('profile.settingsPage.goToAppGallery')
			: t('profile.settingsPage.updateNow')
	}

	async function handleCheckUpdate() {
		if (checkingUpdate.value) {
			return
		}
		checkingUpdate.value = true
		uni.showLoading({
			title: t('profile.settingsPage.checkingUpdate')
		})
		try {
			const info = await appUpgradeService.check('manual')
			if (info.resultCode === UpgradeResultCode.NO_UPDATE) {
				uni.showToast({
					title: t('profile.settingsPage.latestVersionToast'),
					icon: 'none'
				})
				return
			}
			const modalTitle = info.title !== '' ? info.title : t('profile.settingsPage.updateFoundTitle', { version: info.latestVersion })
			const modalContent = info.content !== ''
				? info.content
				: t('profile.settingsPage.updateFoundContent', { version: info.latestVersion })
			void appUpgradeService.reportEvent('SHOW_DIALOG', {
				resultCode: info.resultCode,
				latestVersion: info.latestVersion
			})
			if (info.resultCode === UpgradeResultCode.BLOCKED) {
				uni.showModal({
					title: modalTitle,
					content: modalContent,
					showCancel: false,
					confirmText: t('common.ok')
				})
				return
			}
			uni.showModal({
				title: modalTitle,
				content: modalContent,
				showCancel: !info.forceUpdate,
				cancelText: t('common.cancel'),
				confirmText: getUpgradeActionText(),
				success: async (res) => {
					if (!res.confirm) {
						await appUpgradeService.reportEvent('CLICK_CANCEL', {
							trigger: 'manual',
							resultCode: info.resultCode,
							latestVersion: info.latestVersion
						})
						if (info.resultCode === UpgradeResultCode.OPTIONAL_UPDATE) {
							appUpgradeService.ignoreOptionalVersion(info)
						}
						return
					}
					appUpgradeService.clearIgnoredOptionalVersion()
					await appUpgradeService.reportEvent('CLICK_UPDATE', {
						trigger: 'manual',
						resultCode: info.resultCode,
						latestVersion: info.latestVersion
					})
					try {
						await appUpgradeService.performUpgrade(info)
					} catch (e) {
						console.error('[Settings] performUpgrade failed:', e)
						uni.showToast({
							title: t('profile.settingsPage.openUpgradeFailed'),
							icon: 'none'
						})
					}
				}
			})
		} catch (e) {
			console.error('[Settings] check update failed:', e)
			uni.showToast({
				title: t('profile.settingsPage.checkUpdateFailed'),
				icon: 'none'
			})
		} finally {
			uni.hideLoading()
			checkingUpdate.value = false
		}
	}

	function handleAction(type : string) {
		if (type === 'chatBubble') {
			uni.navigateTo({
				url: '/pages/message/chat-bubble'
			})
			return
		}
		if (type === 'theme') {
			uni.navigateTo({
				url: '/pages/profile/theme-settings'
			})
			return
		}
		if (type === 'language') {
			uni.navigateTo({
				url: '/pages/profile/language-settings'
			})
			return
		}
		if (type === 'checkUpdate') {
			void handleCheckUpdate()
			return
		}
	}

	onShow(() => {
		harmonySnapshot.value = getHarmonyReadinessSnapshot()
	})

	unsubscribeTheme = subscribeThemeChange((_, __, tokens) => {
		theme.value = tokens
	})
	unsubscribeLocale = subscribeLocaleChange((resolvedLocale, languageMode) => {
		currentResolvedLocale.value = resolvedLocale
		currentLanguageMode.value = languageMode
		harmonySnapshot.value = getHarmonyReadinessSnapshot()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
		if (unsubscribeLocale != null) {
			unsubscribeLocale()
			unsubscribeLocale = null
		}
	})
</script>

