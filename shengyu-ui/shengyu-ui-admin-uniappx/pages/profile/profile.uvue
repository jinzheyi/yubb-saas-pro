<template>
	<view class="page">
		<view class="status-bar"></view>
		
		<!-- 个人信息头部 -->
		<view class="user-header">
			<view class="user-info-row">
				<image v-if="userInfo.avatar" class="avatar" :src="userInfo.avatar"></image>
				<view v-else class="avatar" :style="{ backgroundColor: userAvatarBg }">
					<text class="avatar-text">{{ userAvatarText }}</text>
				</view>
				<view class="user-detail">
					<view class="name-row">
						<text class="name">{{ userInfo.nickname || '-' }}</text>
						<text class="iconfont qr-icon">&#xeaf1;</text>
					</view>
				</view>
			</view>
			<view class="dept-row">
				<text class="dept-text">{{ deptPostText }}</text>
			</view>
			<view class="status-row" @click="handleAction('status')">
				<text class="status-text">{{ t('profile.user.status') }}</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="menu-group">
				<view class="menu-item" hover-class="menu-item-active" @click="handleAction('theme')">
					<view class="menu-icon-wrap" style="background-color: #06b6d4;">
						<text class="iconfont menu-icon">&#xe984;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.theme') }}</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
					<view class="menu-item-border"></view>
				</view>
				<view class="menu-item" hover-class="menu-item-active" @click="handleAction('fav')">
					<view class="menu-icon-wrap" style="background-color: #fb923c;">
						<text class="iconfont menu-icon">&#xea90;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.fav') }}</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
					<view class="menu-item-border"></view>
				</view>
				<view class="menu-item" hover-class="menu-item-active" @click="handleAction('scan')">
					<view class="menu-icon-wrap" style="background-color: #f97316;">
						<text class="iconfont menu-icon">&#xea8b;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.scan') }}</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
					<view class="menu-item-border"></view>
				</view>
				<view class="menu-item" hover-class="menu-item-active" @click="handleAction('settings')">
					<view class="menu-icon-wrap" style="background-color: #fdba74;">
						<text class="iconfont menu-icon">&#xea8d;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.settings') }}</text>
					<text class="iconfont arrow-icon">&#xeb03;</text>
				</view>
			</view>

			<!-- 退出登录 -->
			<view class="logout-wrap">
				<button class="logout-btn" hover-class="logout-btn-active" @click="handleLogout">
					<text class="logout-btn-text">退出登录</text>
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { clearUserCache } from '../../store/user.uts'
	import { logout } from '../../api/login.uts'
	import { getCurrentUserDetail } from '../../api/user.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'

	const { t } = useI18n()

	const loading = ref(false)
	const userInfo = ref({
		id: '' as string,
		nickname: '' as string,
		avatar: '' as string,
		deptName: '' as string,
		postName: '' as string
	})

	const userAvatarText = computed(() : string => {
		return getAvatarText(userInfo.value.nickname)
	})
	const userAvatarBg = computed(() : string => {
		return getUserAvatarColor(userInfo.value.id || '0')
	})
	const deptPostText = computed(() : string => {
		const dept = userInfo.value.deptName || ''
		const post = userInfo.value.postName || ''
		if (dept && post) return dept + ' | ' + post
		if (dept) return dept
		if (post) return post
		return '-'
	})

	async function loadProfile() {
		if (loading.value) return
		try {
			loading.value = true
			const data = await getCurrentUserDetail()
			userInfo.value = {
				id: data && data.id != null ? data.id.toString() : '',
				nickname: data && data.nickname ? data.nickname : '',
				avatar: data && data.avatar ? data.avatar : '',
				deptName: data && data.deptName ? data.deptName : '',
				postName: data && data.postName ? data.postName : ''
			}
		} catch (e) {
			console.error('[Profile] 加载当前用户信息失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	function handleAction(type : string) {
		if (type === 'fav') {
			uni.navigateTo({
				url: '/pages/common/favorite'
			})
			return
		}
		if (type === 'scan') {
			const platform = uni.getSystemInfoSync().platform
			if (platform === 'web') {
				uni.navigateTo({
					url: '/pages/message/join-group?manual=1'
				})
				return
			}
			uni.navigateTo({
				url: '/pages/common/scan'
			})
			return
		}
		if (type === 'settings') {
			uni.navigateTo({
				url: '/pages/profile/settings'
			})
			return
		}
		uni.showToast({
			title: type + ' 功能开发中',
			icon: 'none'
		})
	}

	function handleLogout() {
		uni.showActionSheet({
			itemList: ['退出登录'],
			itemColor: '#F54A45',
			success: async (res) => {
				if (res.tapIndex === 0) {
					try {
						await logout()
					} catch (e) {
						console.warn('[Profile] logout api failed, fallback to local clear', e)
					}
					clearUserCache()
				}
			}
		})
	}

	onLoad(async () => {
		await loadProfile()
	})

	onShow(async () => {
		await loadProfile()
	})
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #F5F7FA;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #3370FF;
	}

	.user-header {
		background-color: #3370FF;
		padding: 24px 20px 40px 20px;
	}

	.user-info-row {
		flex-direction: row;
		align-items: center;
	}

	.avatar {
		width: 60px;
		height: 60px;
		border-radius: 12px;
		background-color: #FFFFFF;
		border-width: 2px;
		border-color: rgba(255, 255, 255, 0.3);
		justify-content: center;
		align-items: center;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: 600;
	}

	.user-detail {
		flex: 1;
		margin-left: 16px;
	}

	.name-row {
		flex-direction: row;
		align-items: center;
	}

	.name {
		color: #FFFFFF;
		font-size: 20px;
		font-weight: 600;
	}

	.qr-icon {
		color: rgba(255, 255, 255, 0.7);
		font-size: 18px;
		margin-left: 8px;
	}

	.dept-row {
		margin-top: 12px;
	}

	.dept-text {
		color: rgba(255, 255, 255, 0.8);
		font-size: 13px;
	}

	.status-row {
		margin-top: 16px;
		background-color: rgba(255, 255, 255, 0.15);
		padding: 6px 12px;
		border-radius: 6px;
		align-self: flex-start;
	}

	.status-text {
		color: #FFFFFF;
		font-size: 12px;
	}

	.content {
		flex: 1;
		margin-top: -16px;
		height: 0;
		background-color: #F5F7FA;
	}

	.menu-group {
		background-color: #FFFFFF;
		border-radius: 16px 16px 0 0;
		padding: 8px 0;
	}

	.menu-item {
		flex-direction: row;
		align-items: center;
		padding: 14px 20px;
		background-color: #FFFFFF;
		position: relative;
	}

	.menu-item-active {
		background-color: #F2F3F5;
	}

	.menu-item-border {
		position: absolute;
		bottom: 0;
		left: 60px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.menu-icon-wrap {
		width: 28px;
		height: 28px;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.menu-icon {
		color: #FFFFFF;
		font-size: 18px;
	}

	.menu-label {
		flex: 1;
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
	}

	.arrow-icon {
		color: #8F959E;
		font-size: 14px;
	}

	.logout-wrap {
		padding: 24px 20px;
	}

	.logout-btn {
		background-color: #FFFFFF;
		height: 48px;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
		border-width: 0.5px;
		border-color: #EFF0F1;
	}

	.logout-btn-active {
		background-color: #FEEEEE;
	}

	.logout-btn-text {
		color: #F54A45;
		font-size: 16px;
		font-weight: 500;
	}
</style>
