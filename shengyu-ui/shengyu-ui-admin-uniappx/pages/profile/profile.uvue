<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.brandPrimary }"></view>
		
		<!-- 个人信息头部 -->
		<view class="user-header" :style="{ backgroundColor: theme.brandPrimary }">
			<view class="user-info-row">
				<view class="avatar-editor" hover-class="avatar-editor-active" @click="handleAvatarEdit">
					<image v-if="userInfo.avatar" class="avatar" :src="userInfo.avatar" mode="aspectFill"></image>
					<view v-else class="avatar avatar-fallback" :style="{ backgroundColor: userAvatarBg }">
						<text class="avatar-text">{{ userAvatarText }}</text>
					</view>
					<view class="avatar-edit-badge" :style="{ backgroundColor: theme.cardBg, borderColor: theme.brandPrimarySoft }">
						<text class="iconfont avatar-edit-icon" :style="{ color: theme.brandPrimary }">&#xea8d;</text>
					</view>
					<view v-if="avatarUploading" class="avatar-upload-mask">
						<text class="avatar-upload-percent">{{ avatarUploadProgress }}%</text>
						<text class="avatar-upload-label">上传中</text>
					</view>
				</view>
				<view class="user-detail">
					<view class="name-row">
						<text class="name">{{ userInfo.nickname || '-' }}</text>
					</view>
					<text class="avatar-hint">{{ avatarHintText }}</text>
				</view>
			</view>
			<view class="dept-row">
				<text class="dept-text">{{ deptPostText }}</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="menu-group" :style="{ backgroundColor: theme.cardBg }">
				<view class="menu-item" :style="{ backgroundColor: theme.cardBg }" hover-class="menu-item-active" @click="handleAction('theme')">
					<view class="menu-icon-wrap" style="background-color: #06b6d4;">
						<text class="iconfont menu-icon">&#xe984;</text>
					</view>
					<text class="menu-label" :style="{ color: theme.textPrimary }">{{ t('profile.menu.theme') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					<view class="menu-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
				<view class="menu-item" :style="{ backgroundColor: theme.cardBg }" hover-class="menu-item-active" @click="handleAction('fav')">
					<view class="menu-icon-wrap" style="background-color: #fb923c;">
						<text class="iconfont menu-icon">&#xea90;</text>
					</view>
					<text class="menu-label" :style="{ color: theme.textPrimary }">{{ t('profile.menu.fav') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					<view class="menu-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
				<view class="menu-item" :style="{ backgroundColor: theme.cardBg }" hover-class="menu-item-active" @click="handleAction('scan')">
					<view class="menu-icon-wrap" style="background-color: #f97316;">
						<text class="iconfont menu-icon">&#xea8b;</text>
					</view>
					<text class="menu-label" :style="{ color: theme.textPrimary }">{{ t('profile.menu.scan') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
					<view class="menu-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
				<view class="menu-item" :style="{ backgroundColor: theme.cardBg }" hover-class="menu-item-active" @click="handleAction('settings')">
					<view class="menu-icon-wrap" style="background-color: #fdba74;">
						<text class="iconfont menu-icon">&#xea8d;</text>
					</view>
					<text class="menu-label" :style="{ color: theme.textPrimary }">{{ t('profile.menu.settings') }}</text>
					<text class="iconfont arrow-icon" :style="{ color: theme.textTertiary }">&#xeb03;</text>
				</view>
			</view>

			<!-- 退出登录 -->
			<view class="logout-wrap">
				<button class="logout-btn" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }" hover-class="logout-btn-active" @click="handleLogout">
					<text class="logout-btn-text">退出登录</text>
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { clearUserCache, updateUserAvatar } from '../../store/user.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import { logout } from '../../api/login.uts'
	import { clearCurrentUserAvatar, getCurrentUserDetail, updateCurrentUserAvatar } from '../../api/user.uts'
	import { tabBarBadgeService } from '../../services/tab-bar-badge-service.uts'
	import { messageService } from '../../services/message-service.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { chooseImage } from '../../utils/upload.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	const loading = ref(false)
	const avatarUploading = ref(false)
	const avatarUploadProgress = ref(0)
	const userInfo = ref({
		id: '' as string,
		nickname: '' as string,
		avatar: '' as string,
		deptName: '' as string,
		postName: '' as string
	})

	const userAvatarText = computed(() : string => {
		return getAvatarText(userInfo.value.nickname)
	})
	const userAvatarBg = computed(() : string => {
		return getUserAvatarColor(userInfo.value.id || '0')
	})
	const deptPostText = computed(() : string => {
		const dept = userInfo.value.deptName || ''
		const post = userInfo.value.postName || ''
		if (dept && post) return dept + ' | ' + post
		if (dept) return dept
		if (post) return post
		return '-'
	})
	const avatarHintText = computed(() : string => {
		if (avatarUploading.value) {
			return '头像上传中 ' + avatarUploadProgress.value + '%'
		}
		return userInfo.value.avatar ? '点击更换或删除头像' : '点击上传头像'
	})

	async function loadProfile() {
		if (loading.value || avatarUploading.value) return
		try {
			loading.value = true
			const data = await getCurrentUserDetail()
			userInfo.value = {
				id: data && data.id != null ? data.id.toString() : '',
				nickname: data && data.nickname ? data.nickname : '',
				avatar: data && data.avatar ? data.avatar : '',
				deptName: data && data.deptName ? data.deptName : '',
				postName: data && data.postName ? data.postName : ''
			}
			messageService.refreshCurrentUserAvatar(userInfo.value.avatar)
		} catch (e) {
			console.error('[Profile] 加载当前用户信息失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	function isCancelError(err : any) : boolean {
		if (err == null) return false
		const msg = String((err as any).errMsg || (err as any).message || err).toLowerCase()
		return msg.indexOf('cancel') !== -1 || msg.indexOf('canceled') !== -1
	}

	async function handleAvatarEdit() {
		if (avatarUploading.value) {
			return
		}
		const itemList = userInfo.value.avatar !== '' ? ['重新上传头像', '删除自定义头像'] : ['上传头像']
		uni.showActionSheet({
			itemList: itemList,
			itemColor: theme.value.brandPrimary,
			success: async (res) => {
				if (res.tapIndex === 0) {
					await handleAvatarUpload()
					return
				}
				if (userInfo.value.avatar !== '' && res.tapIndex === 1) {
					await handleAvatarClear()
				}
			}
		})
	}

	async function handleAvatarUpload() {
		try {
			const paths = await chooseImage(1)
			if (!paths || paths.length === 0) {
				return
			}
			const filePath = paths[0]
			avatarUploading.value = true
			avatarUploadProgress.value = 0
			const avatar = await updateCurrentUserAvatar(filePath, (progress : number) => {
				avatarUploadProgress.value = progress
			})
			userInfo.value.avatar = avatar
			updateUserAvatar(avatar)
			messageService.refreshCurrentUserAvatar(avatar)
			avatarUploadProgress.value = 100
			uni.showToast({
				title: '头像更新成功',
				icon: 'success'
			})
		} catch (e) {
			if (!isCancelError(e)) {
				console.error('[Profile] 更新头像失败:', e)
			}
		} finally {
			avatarUploading.value = false
			avatarUploadProgress.value = 0
		}
	}

	async function handleAvatarClear() {
		if (avatarUploading.value) {
			return
		}
		try {
			avatarUploading.value = true
			avatarUploadProgress.value = 0
			await clearCurrentUserAvatar()
			userInfo.value.avatar = ''
			updateUserAvatar('')
			messageService.refreshCurrentUserAvatar('')
			uni.showToast({
				title: '已恢复默认头像',
				icon: 'success'
			})
		} catch (e) {
			console.error('[Profile] 清除头像失败:', e)
		} finally {
			avatarUploading.value = false
			avatarUploadProgress.value = 0
		}
	}

	function handleAction(type : string) {
		if (type === 'fav') {
			uni.navigateTo({
				url: '/pages/common/favorite'
			})
			return
		}
		if (type === 'theme') {
			uni.navigateTo({
				url: '/pages/profile/theme-settings'
			})
			return
		}
		if (type === 'scan') {
			const platform = uni.getSystemInfoSync().platform
			if (platform === 'web') {
				uni.navigateTo({
					url: '/pages/message/join-group?manual=1'
				})
				return
			}
			uni.navigateTo({
				url: '/pages/common/scan'
			})
			return
		}
		if (type === 'settings') {
			uni.navigateTo({
				url: '/pages/profile/settings'
			})
			return
		}
		uni.showToast({
			title: type + ' 功能开发中',
			icon: 'none'
		})
	}

	function handleLogout() {
		uni.showActionSheet({
			itemList: ['退出登录'],
			itemColor: '#F54A45',
			success: async (res) => {
				if (res.tapIndex === 0) {
					try {
						await logout()
					} catch (e) {
						console.warn('[Profile] logout api failed, fallback to local clear', e)
					}
					clearUserCache()
				}
			}
		})
	}

	onLoad(async () => {
		await loadProfile()
	})

	onShow(async () => {
		tabBarBadgeService.refresh()
		await loadProfile()
	})

	unsubscribeTheme = subscribeThemeChange((_, __, tokens) => {
		theme.value = tokens
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.user-header {
		padding: 24px 20px 40px 20px;
	}

	.user-info-row {
		flex-direction: row;
		align-items: center;
	}

	.avatar {
		width: 60px;
		height: 60px;
		border-radius: 12px;
		border-width: 2px;
		border-color: rgba(255, 255, 255, 0.3);
		justify-content: center;
		align-items: center;
	}

	.avatar-editor {
		position: relative;
		width: 60px;
		height: 60px;
	}

	.avatar-editor-active {
		opacity: 0.9;
	}

	.avatar-fallback {
		overflow: hidden;
	}

	.avatar-edit-badge {
		position: absolute;
		right: -4px;
		bottom: -4px;
		width: 24px;
		height: 24px;
		border-radius: 12px;
		border-width: 1px;
		border-color: rgba(51, 112, 255, 0.18);
		justify-content: center;
		align-items: center;
	}

	.avatar-edit-icon {
		font-size: 13px;
	}

	.avatar-upload-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		border-radius: 12px;
		background-color: rgba(15, 23, 42, 0.62);
		justify-content: center;
		align-items: center;
	}

	.avatar-upload-percent {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.avatar-upload-label {
		color: rgba(255, 255, 255, 0.88);
		font-size: 11px;
		margin-top: 2px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: 600;
	}

	.user-detail {
		flex: 1;
		margin-left: 16px;
	}

	.name-row {
		flex-direction: row;
		align-items: center;
	}

	.name {
		color: #FFFFFF;
		font-size: 20px;
		font-weight: 600;
	}

	.avatar-hint {
		margin-top: 6px;
		color: rgba(255, 255, 255, 0.76);
		font-size: 12px;
	}

	.dept-row {
		margin-top: 12px;
	}

	.dept-text {
		color: rgba(255, 255, 255, 0.8);
		font-size: 13px;
	}

	.content {
		flex: 1;
		margin-top: -16px;
		height: 0;
	}

	.menu-group {
		border-radius: 16px 16px 0 0;
		padding: 8px 0;
	}

	.menu-item {
		flex-direction: row;
		align-items: center;
		padding: 14px 20px;
		position: relative;
	}

	.menu-item-active {
		background-color: rgba(143, 149, 158, 0.08);
	}

	.menu-item-border {
		position: absolute;
		bottom: 0;
		left: 60px;
		right: 0;
		height: 0.5px;
	}

	.menu-icon-wrap {
		width: 28px;
		height: 28px;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.menu-icon {
		color: #FFFFFF;
		font-size: 18px;
	}

	.menu-label {
		flex: 1;
		font-size: 16px;
		font-weight: 400;
	}

	.arrow-icon {
		font-size: 14px;
	}

	.logout-wrap {
		padding: 24px 20px;
	}

	.logout-btn {
		height: 48px;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
		border-width: 0.5px;
	}

	.logout-btn-active {
		background-color: rgba(245, 74, 69, 0.08);
	}

	.logout-btn-text {
		color: #F54A45;
		font-size: 16px;
		font-weight: 500;
	}
</style>
