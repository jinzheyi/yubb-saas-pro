<template>
	<view class="page">
		<view class="status-bar"></view>
		
		<!-- 个人信息头部 -->
		<view class="user-header">
			<view class="user-info-row">
				<image class="avatar" src="/static/avatar.jpg"></image>
				<view class="user-detail">
					<view class="name-row">
						<text class="name">朱述勇</text>
						<text class="iconfont qr-icon">&#xea8b;</text>
					</view>
				</view>
			</view>
			<view class="dept-row">
				<text class="dept-text">软件研发事业部 | 开发工程师</text>
			</view>
			<view class="status-row" @click="handleAction('status')">
				<text class="status-text">{{ t('profile.user.status') }}</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<view class="menu-group">
				<view class="menu-item" @click="handleAction('theme')">
					<view class="menu-icon-wrap" style="background-color: #06b6d4;">
						<text class="iconfont menu-icon">&#xea84;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.theme') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
				<view class="menu-item" @click="handleAction('fav')">
					<view class="menu-icon-wrap" style="background-color: #fb923c;">
						<text class="iconfont menu-icon">&#xea90;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.fav') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
				<view class="menu-item" @click="handleAction('scan')">
					<view class="menu-icon-wrap" style="background-color: #f97316;">
						<text class="iconfont menu-icon">&#xea8b;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.scan') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
				<view class="menu-item" @click="handleAction('settings')">
					<view class="menu-icon-wrap" style="background-color: #fdba74;">
						<text class="iconfont menu-icon">&#xea8d;</text>
					</view>
					<text class="menu-label">{{ t('profile.menu.settings') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
			</view>

			<!-- 退出登录 -->
			<view class="logout-wrap">
				<button class="logout-btn" @click="handleLogout">
					<text class="logout-btn-text">退出登录</text>
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { clearUserCache } from '../../store/user.uts'

	const { t } = useI18n()

	function handleAction(type : string) {
		uni.showToast({
			title: type + ' 功能开发中',
			icon: 'none'
		})
	}

	function handleLogout() {
		uni.showModal({
			title: '提示',
			content: '确定要退出登录吗？',
			success: (res) => {
				if (res.confirm) {
					clearUserCache()
					uni.reLaunch({
						url: '/pages/login/login'
					})
				}
			}
		})
	}
</script>

