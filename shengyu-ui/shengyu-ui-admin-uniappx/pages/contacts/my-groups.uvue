<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的群组</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" placeholder="搜索群组" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="group-list">
				<view v-for="(group, index) in groupList" :key="group.id" 
					class="group-item" 
					@click="handleGroupClick(group)">
					<view class="group-avatar">
						<view class="avatar-grid">
							<view v-for="(member, mIndex) in group.avatars" :key="mIndex" class="avatar-cell">
								<text class="avatar-cell-text">{{ member }}</text>
							</view>
						</view>
					</view>
					<view class="group-info">
						<text class="group-name">{{ group.name }}</text>
						<text class="group-count">{{ group.memberCount }} 人</text>
					</view>
					<view v-if="index < groupList.length - 1" class="group-item-border"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroupList } from '../../api/group.uts'

	const { t } = useI18n()

	// 是否为选择模式
	const isSelectMode = ref(false)
	const loading = ref(false)

	// 群组列表数据
	const groupList = ref<any[]>([])
	
	/**
	 * 加载群组列表
	 */
	async function loadGroups() {
		loading.value = true
		
		try {
			// 注意：request 拦截器已经解包了 data.data
			const groups = await getGroupList()
			
			if (groups && Array.isArray(groups)) {
				// 转换为 UI 格式
				groupList.value = groups.map(group => {
					// 生成头像网格（取群名前4个字）
					const name = group.name || '未命名群组'
					const avatars : string[] = []
					for (let i = 0; i < Math.min(4, name.length); i++) {
						avatars.push(name.charAt(i))
					}
					// 如果不足4个，用空格填充
					while (avatars.length < 4) {
						avatars.push('')
					}
					
					return {
						id: group.id,
						name: name,
						memberCount: group.memberCount || 0,
						avatars: avatars
					}
				})
			}
			
		} catch (e) {
			console.error('[MyGroups] 加载群组列表失败:', e)
			uni.showToast({ title: '加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 页面加载时获取群组列表
	 */
	onMounted(() => {
		loadGroups()
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleGroupClick(group : any) {
		if (isSelectMode.value) {
			// 选择模式下跳转到群组成员列表
			uni.navigateTo({
				url: '/pages/contacts/group-members?groupId=' + group.id + '&groupName=' + encodeURIComponent(group.name)
			})
		} else {
			// 普通模式下跳转到聊天页面
			uni.navigateTo({
				url: '/pages/message/chat?conversationId=' + group.id + '&type=group&groupId=' + group.id + '&targetId=' + group.id + '&name=' + encodeURIComponent(group.name) + '&memberCount=' + group.memberCount
			})
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

