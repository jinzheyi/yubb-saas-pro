	}

	.group-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.group-item:active {
		background-color: #F2F3F5;
	}

	.group-item-border {
		position: absolute;
		bottom: 0;
		left: 76px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.group-avatar {
		width: 48px;
		height: 48px;
		margin-right: 12px;
	}

