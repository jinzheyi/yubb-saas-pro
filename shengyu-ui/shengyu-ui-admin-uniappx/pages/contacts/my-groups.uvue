		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.group-list {
		background-color: #FFFFFF;
	}

	.group-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.group-item:active {
		background-color: #F2F3F5;
	}

	.group-item-border {
		position: absolute;
		bottom: 0;
		left: 76px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.group-avatar {
		width: 48px;
		height: 48px;
		margin-right: 12px;
	}

	.avatar-grid {
		width: 48px;
		height: 48px;
		border-radius: 8px;
		overflow: hidden;
		background-color: #0ea5e9;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.avatar-cell {
		width: 24px;
		height: 24px;
		justify-content: center;
		align-items: center;
		border-width: 0.5px;
		border-color: rgba(255,255,255,0.2);
	}

	.avatar-cell-text {
		color: #ffffff;
		font-size: 10px;
