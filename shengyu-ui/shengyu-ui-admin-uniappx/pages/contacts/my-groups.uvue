<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的群组</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input 
					class="search-input" 
					v-model="searchKeyword"
					placeholder="搜索群组" 
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 加载状态 -->
			<view v-if="loading && groupList.length === 0" class="loading-state">
				<text class="loading-text">加载中...</text>
			</view>
			
			<!-- 群组列表 -->
			<view v-else-if="groupList.length > 0" class="group-list">
				<view v-for="(group, index) in groupList" :key="group.id" 
				class="group-item" 
				hover-class="group-item-active"
						@click="handleGroupClick(group)">
					<view class="group-avatar">
						<view class="avatar-grid">
							<view v-for="(member, mIndex) in group.avatars" :key="mIndex" class="avatar-cell">
								<text class="avatar-cell-text">{{ member }}</text>
							</view>
						</view>
					</view>
					<view class="group-info">
						<text class="group-name">{{ group.name }}</text>
						<text class="group-count">{{ group.memberCount }} 人</text>
					</view>
					<view v-if="index < groupList.length - 1" class="group-item-border"></view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-else-if="!loading" class="empty-state">
				<text class="empty-text">{{ searchKeyword ? '未找到相关群组' : '暂无群组' }}</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getGroupList } from '../../api/group.uts'

	const { t } = useI18n()

	// 是否为选择模式
	const isSelectMode = ref(false)
	const loading = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0

	// 群组列表数据
	const groupList = ref<any[]>([])
	
	// 原始群组列表（用于搜索后恢复）
	const originalGroupList = ref<any[]>([])
	
	/**
	 * 加载群组列表
	 */
	async function loadGroups() {
		try {
			loading.value = true
			const groups = await getGroupList()
			
			if (groups && Array.isArray(groups)) {
				// 转换为 UI 格式
				const formattedGroups = groups.map(group => {
					// 生成头像网格（取群名前4个字）
					const name = group.name || '未命名群组'
					const avatars : string[] = []
					for (let i = 0; i < Math.min(4, name.length); i++) {
						avatars.push(name.charAt(i))
					}
					// 如果不足4个，用空格填充
					while (avatars.length < 4) {
						avatars.push('')
					}
					
					return {
						id: group.id,
						name: name,
						memberCount: group.memberCount || 0,
						avatars: avatars
					}
				})
				
				groupList.value = formattedGroups
				// 保存原始数据（深拷贝）
				originalGroupList.value = JSON.parse(JSON.stringify(formattedGroups))
			} else {
				groupList.value = []
				originalGroupList.value = []
			}
		} catch (e) {
			console.error('[MyGroups] 加载群组列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
			groupList.value = []
			originalGroupList.value = []
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer !== 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟300ms执行搜索
		searchTimer = setTimeout(() => {
			if (searchKeyword.value && searchKeyword.value.length > 0) {
				// 执行本地搜索
				performLocalSearch()
			} else {
				// 清空搜索时，恢复原始数据
				restoreOriginalData()
			}
		}, 300)
	}
	
	/**
	 * 执行本地搜索
	 */
	function performLocalSearch() {
		const keyword = searchKeyword.value.toLowerCase()
		groupList.value = originalGroupList.value.filter(group => {
			return group.name.toLowerCase().indexOf(keyword) > -1
		})
	}
	
	/**
	 * 恢复原始数据
	 */
	function restoreOriginalData() {
		groupList.value = JSON.parse(JSON.stringify(originalGroupList.value))
	}

	function handleBack() {
		uni.navigateBack()
	}

	function handleGroupClick(group : any) {
		if (isSelectMode.value) {
			// 选择模式下跳转到群组成员列表
			uni.navigateTo({
				url: '/pages/contacts/group-members?groupId=' + group.id + '&groupName=' + encodeURIComponent(group.name)
			})
		} else {
			// 普通模式下跳转到聊天页面
			// 注意：不传 chatId，让聊天页面自动创建或获取会话
			uni.navigateTo({
				url: '/pages/message/chat?type=group&groupId=' + group.id + '&targetId=' + group.id + '&name=' + encodeURIComponent(group.name) + '&memberCount=' + group.memberCount
			})
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载群组列表
		loadGroups()
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.group-list {
		background-color: #FFFFFF;
	}
	
	.loading-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.loading-text {
		font-size: 14px;
		color: #8F959E;
	}
	
	.empty-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 14px;
		color: #8F959E;
	}

	.group-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.group-item-active {
		background-color: #F2F3F5;
	}

	.group-item-border {
		position: absolute;
		bottom: 0;
		left: 76px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.group-avatar {
		width: 48px;
		height: 48px;
		margin-right: 12px;
	}

	.avatar-grid {
		width: 48px;
		height: 48px;
		border-radius: 8px;
		overflow: hidden;
		background-color: #0ea5e9;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.avatar-cell {
		width: 24px;
		height: 24px;
		justify-content: center;
		align-items: center;
		border-width: 0.5px;
		border-color: rgba(255,255,255,0.2);
	}

	.avatar-cell-text {
		color: #ffffff;
		font-size: 10px;
		font-weight: 500;
	}

	.group-info {
		flex: 1;
	}

	.group-name {
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.group-count {
		font-size: 12px;
		color: #8F959E;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
	}

	.selected-text {
		font-size: 15px;
		color: #1F2329;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
