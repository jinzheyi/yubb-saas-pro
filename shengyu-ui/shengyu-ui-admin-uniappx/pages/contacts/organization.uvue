		align-items: center;
		padding: 8px 0;
	}

	.dept-row-active {
		opacity: 0.6;
	}

	.dept-icon {
		font-size: 20px;
		color: #0ea5e9;
		margin-right: 12px;
	}

	.dept-name {
		font-size: 15px;
		color: #646A73;
		font-weight: 400;
	}

	.dept-name-bold {
		font-weight: 500;
		color: #F3F6FA;
	}

	.member-list {
		padding-left: 8px;
		margin-top: 8px;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 10px 0;
		position: relative;
	}

	.member-item-active {
		opacity: 0.6;
	}

	.member-item-border {
		position: absolute;
		bottom: 0;
		left: 54px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.member-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.member-avatar-image {
		width: 40px;
		height: 40px;
		border-radius: 8px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.member-name {
		flex: 1;
		font-size: 16px;
		font-weight: 400;
	}

	.member-role {
		font-size: 12px;
