<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg }">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				</view>
				<text class="header-title" :style="{ color: theme.headerText }">{{ t('contactsOrg.title') }}</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input 
					class="search-input" 
					:style="{ color: theme.inputText }"
					v-model="searchKeyword"
					:placeholder="t('contactsOrg.searchPlaceholder')"
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 根节点 -->
			<view class="root-node">
				<view class="node-header" :style="{ backgroundColor: theme.cardBg }" @click="toggleNode('root')">
					<text class="node-title" :style="{ color: theme.textPrimary }">{{ rootOrg.name }}({{ rootOrg.count }})</text>
					<text class="iconfont expand-icon">{{ expandedNodes.includes('root') ? '\ueaf5' : '\ueaf3' }}</text>
				</view>
			</view>

			<!-- 根节点展开后的内容 -->
			<view v-if="expandedNodes.includes('root')">
				<!-- 子组织列表 -->
				<view class="org-list">
					<view v-for="(org, orgIndex) in organizations" :key="org.id" class="org-item">
						<view class="org-row" :style="{ backgroundColor: theme.cardBg }" hover-class="org-row-active" @click="toggleNode(org.id)">
							<!-- 选择模式下显示复选框 -->
							<view v-if="isSelectMode && !isSingleSelectMode" :class="['checkbox', org.selected ? 'checkbox-active' : '']" @click.stop="toggleOrgSelect(org)">
								<text v-if="org.selected" class="iconfont check-icon">&#xea73;</text>
							</view>
							
							<!-- 展开/收起图标（选择模式和非选择模式都显示） -->
							<text class="iconfont node-icon" :style="{ color: '#0ea5e9' }">
								{{ org.expanded ? '\ueaf5' : '\ueaf3' }}
							</text>
							<text class="org-name" :class="{ 'org-name-bold': org.expanded }" :style="{ color: theme.textPrimary }">{{ org.name }}({{ org.count }})</text>
						</view>
						<view v-if="orgIndex < organizations.length - 1" class="org-item-border" :style="{ backgroundColor: theme.borderColor }"></view>

						<!-- 部门列表 -->
						<view v-if="org.expanded" class="dept-list">
							<!-- 显示部门的成员 -->
							<view v-if="org.members && org.members.length > 0" class="member-list">
								<view v-for="(member, mIndex) in org.members" :key="member.id" 
									class="member-item"
									:style="{ backgroundColor: theme.cardBg }"
									@click="handleMemberClick(member)">
									<!-- 选择模式下显示复选框 -->
									<view v-if="isSelectMode" :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', member.selected ? 'checkbox-active' : '', (isSingleSelectMode && member.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleMemberSelect(member)">
										<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
									</view>
									
									<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
										<image
											v-if="shouldShowAvatar(member)"
											class="member-avatar-image"
											:src="member.avatar"
											mode="aspectFill"
											@error="handleAvatarError(member)"
										/>
										<text v-else class="avatar-text">{{ member.avatarText }}</text>
									</view>
									<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
									<text class="member-role" :style="{ color: theme.textSecondary }">{{ member.role }}</text>
									<view v-if="mIndex < org.members.length - 1" class="member-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
								</view>
							</view>
							
							<!-- 子部门 -->
							<view v-if="org.departments && org.departments.length > 0">
								<view v-for="(dept, deptIndex) in org.departments" :key="dept.id" class="dept-item">
									<view class="dept-row" :style="{ backgroundColor: theme.cardBg }" hover-class="dept-row-active" @click="toggleDept(dept.id)">
										<!-- 选择模式下显示复选框 -->
										<view v-if="isSelectMode && !isSingleSelectMode" :class="['checkbox', dept.selected ? 'checkbox-active' : '']" @click.stop="toggleDeptSelect(org, dept)">
											<text v-if="dept.selected" class="iconfont check-icon">&#xea73;</text>
										</view>
										
										<!-- 展开/收起图标（选择模式和非选择模式都显示） -->
										<text class="iconfont dept-icon" @click.stop="toggleDept(dept.id)">{{ dept.expanded ? '\ueaf5' : '\ueaf3' }}</text>
										<text class="dept-name" :class="{ 'dept-name-bold': dept.expanded }" :style="{ color: theme.textPrimary }">{{ dept.name }}({{ dept.count }})</text>
									</view>

									<!-- 成员列表 -->
									<view v-if="dept.expanded" class="member-list">
										<view v-for="(member, mIndex) in dept.members" :key="member.id" 
											class="member-item"
											:style="{ backgroundColor: theme.cardBg }"
										hover-class="member-item-active"
											@click="handleMemberClick(member)">
											<!-- 选择模式下显示复选框 -->
											<view v-if="isSelectMode" :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', member.selected ? 'checkbox-active' : '', (isSingleSelectMode && member.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleMemberSelect(member)">
												<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
											</view>
											
											<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
												<image
													v-if="shouldShowAvatar(member)"
													class="member-avatar-image"
													:src="member.avatar"
													mode="aspectFill"
													@error="handleAvatarError(member)"
												/>
												<text v-else class="avatar-text">{{ member.avatarText }}</text>
											</view>
											<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
											<text class="member-role" :style="{ color: theme.textSecondary }">{{ member.role }}</text>
											<view v-if="mIndex < dept.members.length - 1" class="member-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
										</view>
										<view v-if="dept.hasMore" class="load-more" @click.stop="loadMoreDeptMembers(dept.id, dept)">
											<text class="load-more-text" :style="{ color: theme.brandPrimary }">{{ t('contactsOrg.loadMore') }}</text>
										</view>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
				
				<!-- 根部门的直接成员（显示在所有子部门之后） -->
				<view v-if="rootOrg.members && rootOrg.members.length > 0" class="root-members">
					<view v-for="(member, mIndex) in rootOrg.members" :key="member.id" 
						class="member-item"
						:style="{ backgroundColor: theme.cardBg }"
						@click="handleMemberClick(member)">
						<!-- 选择模式下显示复选框 -->
						<view v-if="isSelectMode" :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', member.selected ? 'checkbox-active' : '', (isSingleSelectMode && member.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleMemberSelect(member)">
							<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
						</view>
						
						<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
							<image
								v-if="shouldShowAvatar(member)"
								class="member-avatar-image"
								:src="member.avatar"
								mode="aspectFill"
								@error="handleAvatarError(member)"
							/>
							<text v-else class="avatar-text">{{ member.avatarText }}</text>
						</view>
						<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
						<text class="member-role" :style="{ color: theme.textSecondary }">{{ member.role }}</text>
						<view v-if="mIndex < rootOrg.members.length - 1" class="member-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textPrimary }">{{ t('contactsOrg.selectedCount', { count: selectedCount }) }}</text>
			<button class="confirm-btn" :style="{ backgroundColor: selectedCount === 0 ? theme.cardBgMuted : theme.brandPrimary }" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('contactsOrg.confirm') }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		addMembers,
		removeMembers,
		getSelectedCount,
		getSelectionLimit
	} from '../../store/group-selection.uts'
	import { getOrgTree } from '../../api/dept.uts'
	import { getContactPageByDept } from '../../api/contact.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const safeAreaBottom = ref(0)

	// 是否为选择模式
	const isSelectMode = ref(false)
	
	// 加载状态
	const loading = ref(false)
	
	// 成员加载状态
	const loadingMembers = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0
	
	// 已加载成员的部门缓存 Map<deptId, members[]>
	const deptMembersCache = new Map<string, any>()
	
	// 原始组织数据（用于搜索后恢复）
	const originalOrganizations = ref<any[]>([])
	const originalRootOrg = ref<any>({
		id: '',
		name: t('contactsOrg.defaultCompany'),
		count: 0,
		selected: false,
		members: [] as any[],
		pageNo: 0,
		hasMore: false,
		loadingMore: false
	})

	// 根组织
	const rootOrg = ref({
		id: '',
		name: t('contactsOrg.defaultCompany'),
		count: 0,
		selected: false,
		members: [] as any[],
		pageNo: 0,
		hasMore: false,
		loadingMore: false
	})

	// 展开的节点ID列表
	const expandedNodes = ref<string[]>(['root'])

	// 组织数据（实际上是部门树）
	const organizations = ref<any[]>([])

	// 计算选中的总人数（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})
	const isSingleSelectMode = computed(() : boolean => {
		return getSelectionLimit() === 1
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	function handleBack() {
		uni.navigateBack()
	}

	function normalizeDeptId(value: any): string {
		if (value == null) {
			return ''
		}
		const id = String(value)
		return id !== '' ? id : ''
	}

	function normalizeParentId(value: any): string {
		if (value == null) {
			return '0'
		}
		const id = String(value)
		return id !== '' ? id : '0'
	}

	/**
	 * 组织结构接口兼容：既支持扁平列表，也支持嵌套 children/departments
	 */
	function normalizeDeptList(raw: any[]): any[] {
		if (!Array.isArray(raw) || raw.length === 0) {
			return []
		}
		const result: any[] = []
		const visited = new Set<string>()

		function walk(nodes: any[], parentIdOverride?: string) {
			for (let i = 0; i < nodes.length; i++) {
				const dept = nodes[i]
				if (dept == null) {
					continue
				}
				const id = normalizeDeptId(dept.id)
				if (id === '' || id === '0' || visited.has(id)) {
					continue
				}
				const parentId = parentIdOverride != null
					? parentIdOverride
					: normalizeParentId(dept.parentId)
				result.push({
					...dept,
					id: id,
					parentId: parentId
				})
				visited.add(id)

				const children = Array.isArray(dept.children)
					? dept.children
					: (Array.isArray(dept.departments) ? dept.departments : [])
				if (children.length > 0) {
					walk(children, id)
				}
			}
		}

		walk(raw)
		return result
	}
	
	/**
	 * 加载组织结构树
	 */
	async function loadOrgTree() {
		try {
			loading.value = true
			const data = await getOrgTree()
			const normalizedData = normalizeDeptList(data)

			if (data && data.length > 0) {
				const idSet: string[] = normalizedData
					.map((dept: any) => normalizeDeptId(dept != null ? dept.id : null))
					.filter((id: string) => id !== '' && id !== '0')
				const rootCandidates = normalizedData.filter((dept: any) => {
					if (dept == null || dept.id == null) {
						return false
					}
					const pid = normalizeParentId(dept.parentId)
					return pid === '0' || !idSet.includes(pid)
				})

				if (rootCandidates.length === 1) {
					const rootDept = rootCandidates[0]
					rootOrg.value.id = normalizeDeptId(rootDept.id)
					rootOrg.value.name = rootDept.name != null ? String(rootDept.name) : t('contactsOrg.defaultCompany')
					rootOrg.value.count = extractDeptCount(rootDept)
					rootOrg.value.members = []
					rootOrg.value.pageNo = 0
					rootOrg.value.hasMore = false
					rootOrg.value.loadingMore = false

					originalRootOrg.value = {
						id: rootOrg.value.id,
						name: rootOrg.value.name,
						count: rootOrg.value.count,
						selected: false,
						members: [],
						pageNo: 0,
						hasMore: false,
						loadingMore: false
					}
				} else {
					const total = rootCandidates.reduce((sum: number, dept: any) => sum + extractDeptCount(dept), 0)
					rootOrg.value.id = ''
					rootOrg.value.name = t('contactsOrg.defaultOrgTitle')
					rootOrg.value.count = total
					rootOrg.value.members = []
					rootOrg.value.pageNo = 0
					rootOrg.value.hasMore = false
					rootOrg.value.loadingMore = false

					originalRootOrg.value = {
						id: '',
						name: t('contactsOrg.defaultOrgTitle'),
						count: total,
						selected: false,
						members: [],
						pageNo: 0,
						hasMore: false,
						loadingMore: false
					}
				}

				const tree = buildOrgTree(normalizedData)
				organizations.value = tree
				originalOrganizations.value = JSON.parse(JSON.stringify(tree))
				deptMembersCache.clear()

				if (rootCandidates.length === 1 && rootOrg.value.id !== '' && rootOrg.value.id !== '0' && rootOrg.value.count > 0) {
					await loadDeptMembers(rootOrg.value.id, rootOrg.value)
					originalRootOrg.value.members = JSON.parse(JSON.stringify(rootOrg.value.members))
				}
			} else {
				organizations.value = []
				originalOrganizations.value = []
				rootOrg.value.members = []
				rootOrg.value.count = 0
				originalRootOrg.value.members = []
				originalRootOrg.value.count = 0
				deptMembersCache.clear()
			}
		} catch (e) {
			console.error('[Organization] 加载组织结构失败:', e)
			uni.showToast({
				title: t('contactsOrg.loadFailed'),
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	/**
	 * 提取部门人数，兼容 selectableMemberCount/memberCount/userCount/count
	 * 选择模式下优先展示可选人数，避免“有人数但不可选”的歧义
	 */
	function extractDeptCount(dept: any): number {
		if (dept == null) {
			return 0
		}
		if (isSelectMode.value) {
			const selectableCount = dept.selectableMemberCount != null ? Number(dept.selectableMemberCount) : NaN
			if (!isNaN(selectableCount)) {
				return selectableCount
			}
		}
		const memberCount = dept.memberCount != null ? Number(dept.memberCount) : NaN
		if (!isNaN(memberCount)) {
			return memberCount
		}
		const userCount = dept.userCount != null ? Number(dept.userCount) : NaN
		if (!isNaN(userCount)) {
			return userCount
		}
		const count = dept.count != null ? Number(dept.count) : NaN
		return !isNaN(count) ? count : 0
	}

	/**
	 * 从扁平列表构建组织树
	 */
	function buildOrgTree(flatList: any[]): any[] {
		if (flatList.length === 0) {
			return []
		}

		const deptMap = new Map<string, any>()

		for (let i = 0; i < flatList.length; i++) {
			const dept = flatList[i]
			if (dept == null || dept.id == null) {
				continue
			}
			const id = normalizeDeptId(dept.id)
			if (id === '' || id === '0') {
				continue
			}
			const parentId = normalizeParentId(dept.parentId)
			const node = {
				id: id,
				name: dept.name,
				parentId: parentId,
				sort: dept.sort || 0,
				count: extractDeptCount(dept),
				expanded: false,
				selected: false,
				departments: [] as any[],
				members: [] as any[],
				pageNo: 0,
				hasMore: false,
				loadingMore: false
			}
			deptMap.set(id, node)
		}

		const rootIds: string[] = []
		for (const [id, node] of deptMap) {
			if (node.parentId === '0' || !deptMap.has(node.parentId)) {
				rootIds.push(id)
			}
		}
		if (rootIds.length === 0) {
			return []
		}

		const rootNodes: any[] = []
		if (rootIds.length === 1) {
			const rootDeptId = rootIds[0]
			for (const [id, node] of deptMap) {
				if (node.parentId === rootDeptId) {
					node.departments = buildSubDepts(node.id, deptMap)
					rootNodes.push(node)
				}
			}
			if (rootNodes.length === 0) {
				const selfNode = deptMap.get(rootDeptId)
				if (selfNode != null) {
					selfNode.departments = buildSubDepts(selfNode.id, deptMap)
					rootNodes.push(selfNode)
				}
			}
		} else {
			for (let i = 0; i < rootIds.length; i++) {
				const node = deptMap.get(rootIds[i])
				if (node != null) {
					node.departments = buildSubDepts(node.id, deptMap)
					rootNodes.push(node)
				}
			}
		}

		rootNodes.sort((a: any, b: any) => (a.sort || 0) - (b.sort || 0))
		return rootNodes
	}

	/**
	 * 递归构建子部门
	 */
	function buildSubDepts(parentId: string, deptMap: Map<string, any>): any[] {
		const children: any[] = []
		
		for (const [id, node] of deptMap) {
			if (node.parentId === parentId) {
				// 递归查找子部门
				const subDepts = buildSubDepts(node.id, deptMap)
				
				const dept = {
					id: node.id,
					name: node.name,
					count: node.count, // 使用已设置的成员数量
					expanded: false,
					selected: false,
					members: [] as any[], // 初始为空，点击时才加载
					pageNo: 0,
					hasMore: false,
					loadingMore: false,
					departments: subDepts
				}
				
				children.push(dept)
			}
		}
		
		// 按sort排序
		children.sort((a: any, b: any) => {
			const aNode = deptMap.get(a.id)
			const bNode = deptMap.get(b.id)
			return (aNode?.sort || 0) - (bNode?.sort || 0)
		})
		
		return children
	}
	
	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer !== 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟500ms执行搜索
		searchTimer = setTimeout(() => {
			if (searchKeyword.value && searchKeyword.value.length > 0) {
				// 执行搜索：只显示包含搜索结果的部门和成员
				performSearch()
			} else {
				// 清空搜索时，恢复原始数据
				restoreOriginalData()
			}
		}, 500)
	}
	
	/**
	 * 执行搜索：只显示包含搜索结果的部门和成员
	 */
	async function performSearch() {
		try {
			loadingMembers.value = true
			
			// 1. 搜索根部门成员
			let rootMembers: any[] = []
			if (originalRootOrg.value.id) {
				const res = await getContactPageByDept(String(originalRootOrg.value.id), 1, 200, searchKeyword.value) as any
				const data = res && Array.isArray(res.list) ? res.list : []
				if (data && data.length > 0) {
					rootMembers = data.map((user: any) => {
						const displayName = user.remarkName || user.nickname || t('contactsOrg.unknownUser')
						return {
							id: String(user.id),
							name: displayName,
							role: user.deptName || '',
							avatar: user.avatar != null ? String(user.avatar) : '',
							avatarError: false,
							avatarText: getAvatarText(displayName),
							avatarBg: getUserAvatarColor(String(user.id)),
							selected: isMemberSelected(String(user.id))
						}
					})
				}
			}
			
			// 2. 递归搜索所有部门
			const filteredOrgs = await searchAndFilterDepts(originalOrganizations.value, searchKeyword.value)
			
			// 3. 更新显示数据
			rootOrg.value.members = rootMembers
			rootOrg.value.count = rootMembers.length
			organizations.value = filteredOrgs
			
			// 4. 自动展开所有节点
			expandedNodes.value = ['root']
			expandAllFilteredNodes(filteredOrgs)
			
		} catch (e) {
			console.error('[Organization] 搜索失败:', e)
		} finally {
			loadingMembers.value = false
		}
	}
	
	/**
	 * 递归搜索并过滤部门
	 * 只返回包含搜索结果的部门
	 */
	async function searchAndFilterDepts(depts: any[], keyword: string): Promise<any[]> {
		const result: any[] = []
		
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			
			// 搜索当前部门的成员
			const res = await getContactPageByDept(String(dept.id), 1, 200, keyword) as any
			const data = res && Array.isArray(res.list) ? res.list : []
			let members: any[] = []
			if (data && data.length > 0) {
				members = data.map((user: any) => {
					const displayName = user.remarkName || user.nickname || t('contactsOrg.unknownUser')
					return {
						id: String(user.id),
						name: displayName,
						role: user.deptName || '',
						avatar: user.avatar != null ? String(user.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(String(user.id)),
						selected: isMemberSelected(String(user.id))
					}
				})
			}
			
			// 递归搜索子部门
			let filteredSubDepts: any[] = []
			if (dept.departments && dept.departments.length > 0) {
				filteredSubDepts = await searchAndFilterDepts(dept.departments, keyword)
			}
			
			// 如果当前部门有匹配的成员或子部门有结果，则保留该部门
			if (members.length > 0 || filteredSubDepts.length > 0) {
				result.push({
					id: dept.id,
					name: dept.name,
					count: members.length,
					expanded: true, // 搜索结果默认展开
					selected: false,
					members: members,
					pageNo: 1,
					hasMore: false,
					loadingMore: false,
					departments: filteredSubDepts
				})
			}
		}
		
		return result
	}
	
	/**
	 * 展开所有过滤后的节点
	 */
	function expandAllFilteredNodes(depts: any[]) {
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			expandedNodes.value.push(String(dept.id))
			if (dept.departments && dept.departments.length > 0) {
				expandAllFilteredNodes(dept.departments)
			}
		}
	}
	
	/**
	 * 恢复原始数据
	 */
	function restoreOriginalData() {
		// 恢复根组织
		rootOrg.value = JSON.parse(JSON.stringify(originalRootOrg.value))
		
		// 恢复组织树
		organizations.value = JSON.parse(JSON.stringify(originalOrganizations.value))
		
		// 重置展开状态为默认（只展开根节点）
		expandedNodes.value = ['root']
	}

	function toggleNode(nodeId : string | number) {
		const nodeIdStr = String(nodeId)
		const index = expandedNodes.value.indexOf(nodeIdStr)
		if (index > -1) {
			expandedNodes.value.splice(index, 1)
		} else {
			expandedNodes.value.push(nodeIdStr)
		}

		// 如果是根节点
		if (nodeIdStr === 'root') {
			// 如果展开根节点且根部门有成员但未加载，则加载
			if (expandedNodes.value.includes('root') && rootOrg.value.count > 0) {
				if (rootOrg.value.members.length === 0 && !deptMembersCache.has(rootOrg.value.id)) {
					loadDeptMembers(rootOrg.value.id, rootOrg.value)
				}
			}
			return
		}

		// 切换组织展开状态
		const org = organizations.value.find(o => String(o.id) === nodeIdStr)
		if (org) {
			org.expanded = !org.expanded
			// 如果展开且没有加载过成员，加载成员
			if (org.expanded && org.members.length === 0 && !deptMembersCache.has(org.id)) {
				loadDeptMembers(org.id, org)
			}
		}
	}

	function toggleDept(deptId : string | number) {
		const deptIdStr = String(deptId)
		
		// 递归查找并切换部门展开状态
		function findAndToggle(depts: any[]): any | null {
			for (let i = 0; i < depts.length; i++) {
				const dept = depts[i]
				if (String(dept.id) === deptIdStr) {
					dept.expanded = !dept.expanded
					return dept
				}
				if (dept.departments && dept.departments.length > 0) {
					const found = findAndToggle(dept.departments)
					if (found !== null) {
						return found
					}
				}
			}
			return null
		}
		
		// 在所有组织中查找
		for (let i = 0; i < organizations.value.length; i++) {
			const org = organizations.value[i]
			// 先检查是否是组织本身
			if (String(org.id) === deptIdStr) {
				org.expanded = !org.expanded
				// 如果展开且没有加载过成员，加载成员
				if (org.expanded && org.members.length === 0 && !deptMembersCache.has(org.id)) {
					loadDeptMembers(org.id, org)
				}
				return
			}
			// 再检查子部门
			const dept = findAndToggle(org.departments)
			if (dept !== null) {
				// 如果展开且没有加载过成员，加载成员
				if (dept.expanded && dept.members.length === 0 && !deptMembersCache.has(dept.id)) {
					loadDeptMembers(dept.id, dept)
				}
				break
			}
		}
	}
	
	/**
	 * 加载部门成员
	 */
	async function loadDeptMembers(deptId: string, deptNode: any, keyword?: string) {
		// 如果有缓存且没有搜索关键词，直接使用缓存
		if (!keyword && deptMembersCache.has(deptId)) {
			const cache = deptMembersCache.get(deptId) as any
			deptNode.members = cache && Array.isArray(cache.members) ? cache.members : []
			deptNode.pageNo = cache && cache.pageNo != null ? cache.pageNo : 1
			deptNode.hasMore = cache && cache.hasMore === true
			return
		}
		
		try {
			// 搜索时不显示全局loading，避免影响用户体验
			if (!keyword) {
				loadingMembers.value = true
			}
			
			deptNode.pageNo = 0
			deptNode.hasMore = false
			const kw = keyword != null ? String(keyword) : ''
			const res = await getContactPageByDept(String(deptId), 1, 20, kw) as any
			const data = res && Array.isArray(res.list) ? res.list : []
			const total = res && res.total != null ? Number(res.total) : data.length
			
			if (data && data.length > 0) {
				const members = data.map((user: any) => {
					const displayName = user.remarkName || user.nickname || t('contactsOrg.unknownUser')
					return {
						id: String(user.id),
						name: displayName,
						role: user.deptName || '',
						avatar: user.avatar != null ? String(user.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(String(user.id)),
						selected: isMemberSelected(String(user.id))
					}
				})
				
				deptNode.members = members
				deptNode.pageNo = 1
				deptNode.hasMore = members.length < total
				
				// 如果没有搜索关键词，缓存结果并更新count
				if (!keyword) {
					deptMembersCache.set(deptId, {
						members: members,
						pageNo: deptNode.pageNo,
						hasMore: deptNode.hasMore
					})
					deptNode.count = total
				}
			} else {
				deptNode.members = []
				deptNode.pageNo = 1
				deptNode.hasMore = false
				if (!keyword) {
					deptMembersCache.set(deptId, {
						members: [],
						pageNo: deptNode.pageNo,
						hasMore: deptNode.hasMore
					})
					deptNode.count = 0
				}
			}
		} catch (e) {
			console.error('[Organization] 加载部门成员失败:', e)
			// 搜索时不显示错误提示，避免频繁弹窗
			if (!keyword) {
				uni.showToast({
					title: t('contactsOrg.loadMembersFailed'),
					icon: 'none'
				})
			}
			deptNode.members = []
			deptNode.pageNo = 1
			deptNode.hasMore = false
		} finally {
			if (!keyword) {
				loadingMembers.value = false
			}
		}
	}

	async function loadMoreDeptMembers(deptId: string, deptNode: any) {
		if (deptNode.loadingMore) return
		if (!deptNode.hasMore) return
		deptNode.loadingMore = true
		try {
			const nextPage = (deptNode.pageNo != null ? Number(deptNode.pageNo) : 1) + 1
			const res = await getContactPageByDept(String(deptId), nextPage, 20, '') as any
			const data = res && Array.isArray(res.list) ? res.list : []
			const total = res && res.total != null ? Number(res.total) : (deptNode.members.length + data.length)
			if (data && data.length > 0) {
				const appended = data.map((user: any) => {
					const displayName = user.remarkName || user.nickname || t('contactsOrg.unknownUser')
					return {
						id: String(user.id),
						name: displayName,
						role: user.deptName || '',
						avatar: user.avatar != null ? String(user.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(String(user.id)),
						selected: isMemberSelected(String(user.id))
					}
				})
				deptNode.members = deptNode.members.concat(appended)
				deptNode.pageNo = nextPage
			}
			deptNode.hasMore = deptNode.members.length < total
			if (deptMembersCache.has(deptId)) {
				deptMembersCache.set(deptId, {
					members: deptNode.members,
					pageNo: deptNode.pageNo,
					hasMore: deptNode.hasMore
				})
			}
		} catch (e) {
			// ignore
		} finally {
			deptNode.loadingMore = false
		}
	}

	// 切换组织选中状态（选中组织会选中所有部门和成员）
	function toggleOrgSelect(org : any) {
		if (!isSelectMode.value) return
		
		org.selected = !org.selected
		
		// 收集所有成员
		const allMembers : any[] = []
		
		function collectMembers(depts: any[]) {
			for (let i = 0; i < depts.length; i++) {
				const dept = depts[i]
				dept.selected = org.selected
				for (let j = 0; j < dept.members.length; j++) {
					allMembers.push(dept.members[j])
					dept.members[j].selected = org.selected
				}
				if (dept.departments && dept.departments.length > 0) {
					collectMembers(dept.departments)
				}
			}
		}
		
		collectMembers(org.departments)
		
		// 批量更新全局状态
		if (org.selected) {
			addMembers(allMembers)
		} else {
			const memberIds = allMembers.map(m => String(m.id))
			removeMembers(memberIds)
		}
	}

	// 切换部门选中状态（选中部门会选中所有成员）
	function toggleDeptSelect(org : any, dept : any) {
		if (!isSelectMode.value) return
		
		dept.selected = !dept.selected
		
		// 收集所有成员（包括子部门）
		const allMembers : any[] = []
		
		function collectMembers(d: any) {
			for (let i = 0; i < d.members.length; i++) {
				allMembers.push(d.members[i])
				d.members[i].selected = dept.selected
			}
			if (d.departments && d.departments.length > 0) {
				for (let j = 0; j < d.departments.length; j++) {
					collectMembers(d.departments[j])
				}
			}
		}
		
		collectMembers(dept)
		
		// 批量更新全局状态
		if (dept.selected) {
			addMembers(allMembers)
		} else {
			const memberIds = allMembers.map(m => String(m.id))
			removeMembers(memberIds)
		}
		
		// 检查是否需要更新组织的选中状态
		updateOrgSelectState(org)
	}

	// 切换成员选中状态
	function toggleMemberSelect(member : any) {
		if (!isSelectMode.value) return
		
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(String(member.id))
		if (isSingleSelectMode.value) {
			syncSelectionState()
			return
		}
		
		// 查找成员所属的部门和组织，更新它们的选中状态
		for (let i = 0; i < organizations.value.length; i++) {
			const org = organizations.value[i]
			if (updateMemberInDepts(org.departments, member.id)) {
				updateOrgSelectState(org)
				break
			}
		}
	}
	
	/**
	 * 在部门树中更新成员状态
	 */
	function updateMemberInDepts(depts: any[], memberId: string): boolean {
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			const member = dept.members.find((m: any) => String(m.id) === String(memberId))
			if (member) {
				updateDeptSelectState(dept)
				return true
			}
			if (dept.departments && dept.departments.length > 0) {
				if (updateMemberInDepts(dept.departments, memberId)) {
					updateDeptSelectState(dept)
					return true
				}
			}
		}
		return false
	}

	// 更新部门的选中状态（如果所有成员都选中，则部门也选中）
	function updateDeptSelectState(dept : any) {
		if (dept.members.length === 0 && (!dept.departments || dept.departments.length === 0)) {
			dept.selected = false
			return
		}
		
		// 检查所有成员是否都选中
		const allMembersSelected = dept.members.length > 0 && dept.members.every((m: any) => m.selected)
		
		// 检查所有子部门是否都选中
		let allSubDeptsSelected = true
		if (dept.departments && dept.departments.length > 0) {
			allSubDeptsSelected = dept.departments.every((d: any) => d.selected)
		}
		
		dept.selected = allMembersSelected && allSubDeptsSelected
	}

	// 更新组织的选中状态（如果所有部门都选中，则组织也选中）
	function updateOrgSelectState(org : any) {
		if (org.departments.length === 0) {
			org.selected = false
			return
		}
		org.selected = org.departments.every((d: any) => d.selected)
	}

	function handleMemberClick(member : any) {
		if (isSelectMode.value) {
			// 选择模式下切换选中状态
			toggleMemberSelect(member)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${member.id}&name=${encodeURIComponent(member.name)}`
			})
		}
	}

	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(member: any): boolean {
		return normalizeAvatarUrl(member != null ? member.avatar : '') !== '' && member.avatarError !== true
	}

	function handleAvatarError(member: any): void {
		if (member == null) {
			return
		}
		member.avatarError = true
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < rootOrg.value.members.length; i++) {
			rootOrg.value.members[i].selected = isMemberSelected(String(rootOrg.value.members[i].id))
		}

		function syncDepts(depts: any[]) {
			for (let i = 0; i < depts.length; i++) {
				const dept = depts[i]
				for (let j = 0; j < dept.members.length; j++) {
					dept.members[j].selected = isMemberSelected(String(dept.members[j].id))
				}
				// 更新部门选中状态
				updateDeptSelectState(dept)
				
				// 递归处理子部门
				if (dept.departments && dept.departments.length > 0) {
					syncDepts(dept.departments)
				}
			}
		}
		
		for (let i = 0; i < organizations.value.length; i++) {
			const org = organizations.value[i]
			for (let j = 0; j < org.members.length; j++) {
				org.members[j].selected = isMemberSelected(String(org.members[j].id))
			}
			syncDepts(org.departments)
			// 更新组织选中状态
			updateOrgSelectState(org)
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载组织结构
		loadOrgTree()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

