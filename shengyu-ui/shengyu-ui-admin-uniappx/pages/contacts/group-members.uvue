<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg }">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				</view>
				<text class="header-title" :style="{ color: theme.headerText }">{{ groupName }}</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" :placeholder="t('contactGroupMembers.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item"
					:style="{ backgroundColor: theme.cardBg }"
							hover-class="member-item-active"
					@click="handleMemberClick(member)">
					<!-- 显示复选框 -->
					<view :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', member.selected ? 'checkbox-active' : '', (isSingleSelectMode && member.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<image
							v-if="shouldShowAvatar(member)"
							class="member-avatar-image"
							:src="member.avatar"
							mode="aspectFill"
							@error="handleAvatarError(member)"
						/>
						<text v-else class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
						<text class="member-role" :style="{ color: theme.textSecondary }">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部操作栏 -->
		<view class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textPrimary }">{{ t('contactGroupMembers.selectedCount', { count: selectedCount }) }}</text>
			<button class="confirm-btn" :style="{ backgroundColor: selectedCount === 0 ? theme.cardBgMuted : theme.brandPrimary }" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('contactGroupMembers.confirm') }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount,
		getSelectionLimit
	} from '../../store/group-selection.uts'
	import { getGroupMembers } from '../../api/group.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { decodeIdParam } from '../../utils/id-param.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const safeAreaBottom = ref(0)
	const groupName = ref(t('contactGroupMembers.defaultGroupName'))
	const groupId = ref<string>('')

	// 成员列表数据（从后端加载）
	const memberList = ref<any[]>([])
	const loading = ref(false)

	/**
	 * 加载群成员列表
	 */
	async function loadGroupMembers() {
		if (!groupId.value) return
		
		loading.value = true
		try {
			const members = await getGroupMembers(groupId.value) as any[]
			if (members && Array.isArray(members)) {
				memberList.value = members.map((m: any) => {
					const userIdStr = m.userId != null ? String(m.userId) : '0'
					const displayName = m != null
						? (m.nickname != null && String(m.nickname) !== ''
							? String(m.nickname)
							: (m.userNickname != null && String(m.userNickname) !== ''
								? String(m.userNickname)
								: (m.name != null && String(m.name) !== '' ? String(m.name) : t('contactGroupMembers.unknownUser'))))
						: t('contactGroupMembers.unknownUser')
					return {
						id: userIdStr,
						name: displayName,
						role: m != null && m.deptName != null && String(m.deptName) !== '' ? String(m.deptName) : (m.roleName != null ? String(m.roleName) : ''),
						avatar: normalizeAvatarUrl(m != null ? (m.avatar || m.userAvatar) : ''),
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(userIdStr),
						selected: isMemberSelected(userIdStr)
					}
				})
			} else {
				memberList.value = []
			}
		} catch (e) {
			console.error('[GroupMembers] 加载群成员失败:', e)
			uni.showToast({ title: t('contactGroupMembers.loadFailed'), icon: 'none' })
			memberList.value = []
		} finally {
			loading.value = false
		}
	}

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})
	const isSingleSelectMode = computed(() : boolean => {
		return getSelectionLimit() === 1
	})

	function handleBack() {
		uni.navigateBack()
	}

	function toggleMemberSelect(member : any) {
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(String(member.id))
		syncSelectionState()
	}

	function handleMemberClick(member : any) {
		toggleMemberSelect(member)
	}

	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(String(memberList.value[i].id))
		}
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(member: any): boolean {
		return normalizeAvatarUrl(member != null ? member.avatar : '') !== '' && member.avatarError !== true
	}

	function handleAvatarError(member: any): void {
		if (member == null) {
			return
		}
		member.avatarError = true
	}

	// 页面加载时获取群组信息
	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		if (options != null) {
			if (options['groupId']) {
				groupId.value = decodeIdParam(options['groupId'])
			}
			if (options['groupName']) {
				groupName.value = options['groupName']
			}
		}
		// 加载群成员列表
		loadGroupMembers()
		// 同步选中状态
		syncSelectionState()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		syncSelectionState()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		font-size: 24px;
	}

	.header-title {
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.placeholder {
		color: #A7AFB9;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		position: relative;
	}

	.member-item-active {
		background-color: rgba(143, 149, 158, 0.12);
	}

	.member-item-border {
		position: absolute;
		bottom: 0;
		left: 82px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.member-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.member-avatar-image {
		width: 42px;
		height: 42px;
		border-radius: 8px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.member-info {
		flex: 1;
	}

	.member-name {
		font-size: 16px;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.member-role {
		font-size: 12px;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8893A2;
		background-color: #1A212A;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.checkbox-single {
		border-radius: 11px;
	}

	.checkbox-single-active {
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		border-top-width: 0.5px;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
	}

	.selected-text {
		font-size: 15px;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
