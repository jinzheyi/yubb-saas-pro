<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">{{ groupName }}</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" placeholder="搜索成员" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item" 
					@click="handleMemberClick(member)">
					<!-- 显示复选框 -->
					<view :class="['checkbox', member.selected ? 'checkbox-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<text class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name">{{ member.name }}</text>
						<text class="member-role">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部操作栏 -->
		<view class="footer">
			<text class="selected-text">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount
	} from '../../store/group-selection.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'

	const { t } = useI18n()

	const groupName = ref('数字科技工作群')
	const groupId = ref<string>('')

	// 生成群组成员数据（ID范围：5000+，避免与其他页面冲突）
	const generateMembers = (groupId : string) : any[] => {
		const firstNames = ['张', '李', '王', '刘', '陈', '杨', '赵', '黄', '周', '吴', '徐', '孙', '胡', '朱', '高', '林', '何', '郭', '马', '罗']
		const lastNames = ['伟', '芳', '娜', '秀英', '敏', '静', '丽', '强', '磊', '军', '洋', '勇', '艳', '杰', '娟', '涛', '明', '超', '秀兰', '霞']
		const roles = ['高级经理', '部门经理', '项目经理', '开发工程师', '测试工程师', '产品经理', '设计师', '运营专员', '市场专员', '行政专员']

		const list : any[] = []
		const memberCount = groupId === 1 ? 84 : (groupId === 2 ? 17 : (groupId === 3 ? 10 : 18))
		const baseId = 5000 + (groupId * 1000)  // 每个群组使用不同的ID范围
		
		for (let i = 0; i < memberCount; i++) {
			const firstName = firstNames[i % firstNames.length]
			const lastName = lastNames[i % lastNames.length]
			const name = firstName + lastName
			const memberId = baseId + i + 1
			
			list.push({
				id: memberId,
				name: name,
				role: roles[i % roles.length],
				avatarText: getAvatarText(name),
				avatarBg: getUserAvatarColor(memberId.toString()),
				selected: false
			})
		}
		return list
	}

	const memberList = ref<any[]>([])

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	function handleBack() {
		uni.navigateBack()
	}

	function toggleMemberSelect(member : any) {
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(member.id)
	}

	function handleMemberClick(member : any) {
		toggleMemberSelect(member)
	}

	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(memberList.value[i].id)
		}
	}

	// 页面加载时获取群组信息
	onLoad((options : any) => {
		if (options != null) {
			if (options['groupId']) {
				groupId.value = options['groupId'] as string
			}
			if (options['groupName']) {
				groupName.value = options['groupName']
			}
		}
		// 生成成员列表
		memberList.value = generateMembers(groupId.value)
		// 同步选中状态
		syncSelectionState()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		syncSelectionState()
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.member-list {
		background-color: #FFFFFF;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.member-item:active {
		background-color: #F2F3F5;
	}

	.member-item-border {
		position: absolute;
		bottom: 0;
		left: 82px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.member-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.member-info {
		flex: 1;
	}

	.member-name {
		font-size: 16px;
		font-weight: 400;
		color: #1F2329;
		margin-bottom: 2px;
	}

	.member-role {
		font-size: 12px;
		color: #8F959E;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8F959E;
		background-color: #FFFFFF;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

	.selected-text {
		font-size: 15px;
		color: #1F2329;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
