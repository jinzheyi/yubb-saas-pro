		height: 100%;
		background-color: #F2F2F7;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #1677FF;
	}

	.header {
		background-color: #1677FF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #ffffff;
		font-size: 20px;
	}

	.back-text {
		color: #ffffff;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #ffffff;
		font-size: 18px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		background-color: #ffffff;
		padding: 12px 16px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 12px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 18px;
		color: #9CA3AF;
		margin-right: 8px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		color: #333333;
	}

	.clear-icon {
		font-size: 18px;
		color: #9CA3AF;
		margin-left: 8px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.recent-section {
		padding: 16px;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: 14px;
		font-weight: 500;
		color: #6B7280;
	}

	.delete-icon {
		font-size: 18px;
		color: #9CA3AF;
	}

	.tag-list {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.tag-item {
		background-color: #E5E7EB;
		padding: 8px 16px;
		border-radius: 20px;
		margin-right: 8px;
		margin-bottom: 8px;
	}

	.tag-text {
		font-size: 14px;
		color: #1F2937;
	}

	.result-section {
		margin-top: 8px;
	}

	.result-header {
		background-color: #F9FAFB;
		padding: 8px 16px;
		border-top-width: 0.5px;
		border-top-color: #E5E7EB;
		border-bottom-width: 0.5px;
		border-bottom-color: #E5E7EB;
	}

	.result-title {
		font-size: 12px;
		font-weight: 600;
		color: #6B7280;
		text-transform: uppercase;
	}

	.result-list {
		background-color: #ffffff;
	}

	.result-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #F5F7FA;
	}

	.result-item:active {
		background-color: #F9FAFB;
	}

	.result-avatar {
		width: 48px;
