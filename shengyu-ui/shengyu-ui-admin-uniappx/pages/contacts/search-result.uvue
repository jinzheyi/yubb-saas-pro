<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('contactsSearchResult.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap" :style="{ backgroundColor: theme.headerBg }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input class="search-input" 
					:style="{ color: theme.inputText }"
					v-model="searchKeyword"
					:placeholder="t('contactsSearchResult.searchPlaceholder')"
					placeholder-class="placeholder"
					@input="handleSearch" />
				<text v-if="searchKeyword" class="iconfont clear-icon" :style="{ color: theme.textTertiary }" @click="clearSearch">&#xea73;</text>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 最近搜索 -->
			<view v-if="!searchKeyword && recentSearches.length > 0" class="recent-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="section-header" :style="{ borderBottomColor: theme.borderColor }">
					<text class="section-title" :style="{ color: theme.textPrimary }">{{ t('contactsSearchResult.recentSearches') }}</text>
					<text class="iconfont delete-icon" :style="{ color: theme.textTertiary }" @click="clearRecentSearches">&#xea76;</text>
				</view>
				<view class="tag-list">
					<view v-for="(tag, index) in recentSearches" :key="index" 
						class="tag-item"
						:style="{ backgroundColor: theme.cardBgMuted }"
						@click="searchKeyword = tag">
						<text class="tag-text" :style="{ color: theme.textSecondary }">{{ tag }}</text>
					</view>
				</view>
			</view>

			<!-- 搜索结果 -->
			<view v-if="searchKeyword">
				<!-- 联系人结果 -->
				<view v-if="contactResults.length > 0" class="result-section">
					<view class="result-header" :style="{ backgroundColor: theme.pageBg }">
						<text class="result-title" :style="{ color: theme.textPrimary }">{{ t('contactsSearchResult.contacts') }}</text>
					</view>
					<view class="result-list" :style="{ backgroundColor: theme.cardBg }">
						<view v-for="contact in contactResults" :key="contact.id" 
							class="result-item" 
							:style="{ borderBottomColor: theme.borderColor }"
									hover-class="result-item-active"
							@click="handleContactClick(contact)">
							<view class="result-avatar" :style="{ backgroundColor: contact.avatarBg }">
								<text class="avatar-text">{{ contact.avatarText }}</text>
							</view>
							<view class="result-info">
								<text class="result-name">
									<text v-for="(part, index) in highlightText(contact.name)" :key="index" 
										:class="{ 'highlight': part.highlight }">{{ part.text }}</text>
								</text>
								<text class="result-desc" :style="{ color: theme.textSecondary }">{{ contact.role }}</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 群组结果 -->
				<view v-if="groupResults.length > 0" class="result-section">
					<view class="result-header" :style="{ backgroundColor: theme.pageBg }">
						<text class="result-title" :style="{ color: theme.textPrimary }">{{ t('contactsSearchResult.relatedGroups') }}</text>
					</view>
					<view class="result-list" :style="{ backgroundColor: theme.cardBg }">
						<view v-for="group in groupResults" :key="group.id" 
							class="result-item" 
							:style="{ borderBottomColor: theme.borderColor }"
							hover-class="result-item-active"
							@click="handleGroupClick(group)">
							<view class="group-icon-wrap">
								<text class="iconfont group-icon">&#xea94;</text>
							</view>
							<view class="result-info">
								<text class="result-name">
									<text v-for="(part, index) in highlightText(group.name)" :key="index" 
										:class="{ 'highlight': part.highlight }">{{ part.text }}</text>
								</text>
								<text class="result-desc" :style="{ color: theme.textSecondary }">{{ t('contactsSearchResult.groupMemberCount', { count: group.memberCount }) }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { encodeIdParam } from '../../utils/id-param.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const searchKeyword = ref('')
	const recentSearches = ref(['产品部', '市场推广群', '张三', '架构设计'])

	// 所有联系人数据
	const allContacts = [
		{ id: 1, name: '张敏', role: '开发工程师', avatarText: getAvatarText('张敏'), avatarBg: getUserAvatarColor('1') },
		{ id: 2, name: '张强', role: '高级产品经理', avatarText: getAvatarText('张强'), avatarBg: getUserAvatarColor('2') },
		{ id: 3, name: '张晴', role: '人力资源主管', avatarText: getAvatarText('张晴'), avatarBg: getUserAvatarColor('3') },
		{ id: 4, name: '李伟', role: '技术总监', avatarText: getAvatarText('李伟'), avatarBg: getUserAvatarColor('4') },
		{ id: 5, name: '王丽', role: 'UI设计师', avatarText: getAvatarText('王丽'), avatarBg: getUserAvatarColor('5') }
	]

	// 所有群组数据
	const allGroups = [
		{ id: 1, name: '研发中心 - 许可认证组', memberCount: 12 },
		{ id: 2, name: '产品设计讨论组', memberCount: 25 },
		{ id: 3, name: '技术交流群', memberCount: 42 }
	]

	// 搜索结果
	const contactResults = computed(() : any[] => {
		if (!searchKeyword.value) return []
		return allContacts.filter(c => c.name.includes(searchKeyword.value))
	})

	const groupResults = computed(() : any[] => {
		if (!searchKeyword.value) return []
		return allGroups.filter(g => g.name.includes(searchKeyword.value))
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleSearch() {
		// 搜索逻辑
	}

	function clearSearch() {
		searchKeyword.value = ''
	}

	function clearRecentSearches() {
		recentSearches.value = []
	}

	function highlightText(text : string) : any[] {
		if (!searchKeyword.value) {
			return [{ text: text, highlight: false }]
		}
		
		const keyword = searchKeyword.value
		const index = text.indexOf(keyword)
		
		if (index === -1) {
			return [{ text: text, highlight: false }]
		}
		
		const result : any[] = []
		if (index > 0) {
			result.push({ text: text.substring(0, index), highlight: false })
		}
		result.push({ text: keyword, highlight: true })
		if (index + keyword.length < text.length) {
			result.push({ text: text.substring(index + keyword.length), highlight: false })
		}
		
		return result
	}

	function handleContactClick(contact : any) {
		const userIdParam = encodeIdParam(contact.id != null ? String(contact.id) : '')
	uni.navigateTo({
		url: `/pages/contacts/user-detail?userId=${userIdParam}&name=${encodeURIComponent(contact.name)}`
	})
	}

	function handleGroupClick(group : any) {
		const groupIdParam = encodeIdParam(group.id != null ? String(group.id) : '')
		uni.navigateTo({
			url: `/pages/message/chat?type=group&groupId=${groupIdParam}&targetId=${groupIdParam}&name=${encodeURIComponent(group.name)}&memberCount=${group.memberCount || 0}&entryMode=latest`
		})
	}

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #F2F2F7;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #1677FF;
	}

	.header {
		background-color: #1677FF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #ffffff;
		font-size: 20px;
	}

	.back-text {
		color: #ffffff;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #ffffff;
		font-size: 18px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		padding: 12px 16px;
	}

	.search-bar {
		border-radius: 12px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 18px;
		color: #9CA3AF;
		margin-right: 8px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
	}

	.clear-icon {
		font-size: 18px;
		color: #9CA3AF;
		margin-left: 8px;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.recent-section {
		padding: 16px;
	}

	.section-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.section-title {
		font-size: 14px;
		font-weight: 500;
		color: #6B7280;
	}

	.delete-icon {
		font-size: 18px;
		color: #9CA3AF;
	}

	.tag-list {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.tag-item {
		background-color: #E5E7EB;
		padding: 8px 16px;
		border-radius: 20px;
		margin-right: 8px;
		margin-bottom: 8px;
	}

	.tag-text {
		font-size: 14px;
		color: #1F2937;
	}

	.result-section {
		margin-top: 8px;
	}

	.result-header {
		background-color: #F9FAFB;
		padding: 8px 16px;
		border-top-width: 0.5px;
		border-top-color: #E5E7EB;
		border-bottom-width: 0.5px;
		border-bottom-color: #E5E7EB;
	}

	.result-title {
		font-size: 12px;
		font-weight: 600;
		color: #6B7280;
	}

	.result-list {
	}

	.result-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #F5F7FA;
	}

	.result-item-active {
		background-color: #F9FAFB;
	}

	.result-avatar {
		width: 48px;
		height: 48px;
		border-radius: 24px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 14px;
		font-weight: 600;
	}

	.group-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background-color: #E5E7EB;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.group-icon {
		font-size: 24px;
		color: #6B7280;
	}

	.result-info {
		flex: 1;
	}

	.result-name {
		font-size: 16px;
		font-weight: 500;
		color: #1F2937;
		margin-bottom: 4px;
	}

	.highlight {
		color: #1677FF;
		font-weight: 600;
	}

	.result-desc {
		font-size: 14px;
		color: #6B7280;
	}
</style>
