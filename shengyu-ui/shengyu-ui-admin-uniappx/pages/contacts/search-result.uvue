	}

	.group-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background-color: #E5E7EB;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.group-icon {
		font-size: 24px;
		color: #6B7280;
	}

	.result-info {
		flex: 1;
	}

	.result-name {
		font-size: 16px;
		font-weight: 500;
		color: #1F2937;
		margin-bottom: 4px;
	}

	.highlight {
		color: #1677FF;
		font-weight: 600;
	}

	.result-desc {
		font-size: 14px;
		color: #6B7280;
	}
</style>
