		flex: 1;
		height: 0;
		background-color: #ffffff;
	}

	.section-label {
		padding: 12px 16px 8px 16px;
	}

	.section-text {
		font-size: 13px;
		color: #999999;
	}

	.category-group {
		background-color: #ffffff;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #f0f0f0;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #ffffff;
		font-size: 18px;
	}

	.category-name {
		font-size: 15px;
		color: #333333;
	}

	.contact-list {
