	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 20px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 12px;
		font-weight: bold;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 15px;
		color: #333333;
		font-weight: 500;
	}

	.contact-role {
		font-size: 12px;
		color: #999999;
	}

	.checkbox {
		width: 20px;
		height: 20px;
		border-width: 1px;
		border-color: #d1d5db;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
	}

	.check-icon {
		color: #ffffff;
		font-size: 12px;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
