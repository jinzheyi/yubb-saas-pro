<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">{{ t('initiateGroup.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap">
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<!-- 使用联系人选择组件 -->
		<contact-selector 
			:show-categories="true"
			:selectable="true"
			:contacts="contactList"
			@select="handleSelect"
			@category-click="handleCategory"
		/>

		<view class="footer">
			<text class="selected-text">{{ t('initiateGroup.selectedCount', { count: selectedCount.toString() }) }}</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('initiateGroup.confirm', { count: selectedCount.toString(), max: '500' }) }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getUserInfo } from '../../store/user.uts'
	import { 
		startSelection, 
		endSelection, 
		getSelectedMembers, 
		getSelectedCount,
		addMember,
		toggleMember,
		isMemberSelected
	} from '../../store/group-selection.uts'
	import ContactSelector from '../../components/contact-selector/contact-selector.uvue'

	const { t } = useI18n()

	// 生成联系人数据（使用假名）
	const generateContacts = () : any[] => {
		const firstNames = ['张', '李', '王', '刘', '陈', '杨', '赵', '黄', '周', '吴', '徐', '孙', '胡', '朱', '高', '林', '何', '郭', '马', '罗']
		const lastNames = ['伟', '芳', '娜', '秀英', '敏', '静', '丽', '强', '磊', '军', '洋', '勇', '艳', '杰', '娟', '涛', '明', '超', '秀兰', '霞']
		const roles = ['高级经理', '部门经理', '项目经理', '开发工程师', '测试工程师', '产品经理', '设计师', '运营专员', '市场专员', '行政专员']
		const colors = ['#0ea5e9', '#f472b6', '#c084fc', '#fb7185', '#10b981', '#f59e0b', '#ec4899', '#ef4444', '#3b82f6', '#8b5cf6']
		const pinyins = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')

		// 获取当前登录用户信息
		const userInfo = getUserInfo()
		const currentUserId = userInfo?.user?.id ?? 0
		const currentUserName = userInfo?.user?.nickname ?? '我'

		const list : any[] = []
		
		// 第一个添加当前登录用户，默认选中
		list.push({
			id: currentUserId,
			name: currentUserName,
			role: '当前用户',
			avatarText: currentUserName.substring(0, 2),
			avatarBg: '#1677FF',
			pinyin: 'W',
			selected: true,
			isCurrentUser: true
		})

		// 生成其他联系人
		for (let i = 0; i < 49; i++) {
			const firstName = firstNames[i % firstNames.length]
			const lastName = lastNames[i % lastNames.length]
			const name = firstName + lastName
			const pinyin = pinyins[i % pinyins.length]
			
			list.push({
				id: i + 1000,
				name: name,
				role: roles[i % roles.length],
				avatarText: name.substring(0, 2),
				avatarBg: colors[i % colors.length],
				pinyin: pinyin,
				selected: false,
				isCurrentUser: false
			})
		}
		return list
	}

	const contactList = ref(generateContacts())

	// 使用全局状态的选中数量
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	function handleBack() {
		// 返回时清空选择状态
		endSelection()
		uni.navigateBack()
	}

	function handleCategory(item : any) {
		// 跳转到对应的分组选择页面
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/my-groups?mode=select'
			})
		} else if (item.nameKey === 'contacts.following') {
			uni.navigateTo({
				url: '/pages/contacts/my-following?mode=select'
			})
		} else if (item.nameKey === 'contacts.org') {
			uni.navigateTo({
				url: '/pages/contacts/organization?mode=select'
			})
		} else if (item.nameKey === 'contacts.dept') {
			uni.navigateTo({
				url: '/pages/contacts/my-department?mode=select'
			})
		}
	}

	function handleSelect(item : any) {
		// 当前用户不能取消选中
		if (item.isCurrentUser && !item.selected) {
			uni.showToast({
				title: '不能取消选择自己',
				icon: 'none'
			})
			// 强制保持选中状态
			item.selected = true
			return
		}
		
		// 同步到全局状态
		toggleMember(item)
		// 确保本地状态与全局状态一致
		item.selected = isMemberSelected(item.id)
		
		console.log('选择联系人:', item.name, '选中状态:', item.selected)
	}

	function handleConfirm() {
		const selectedMembers = getSelectedMembers()
		console.log('已选择的联系人:', selectedMembers)
		
		if (selectedMembers.length < 2) {
			uni.showToast({
				title: '至少选择2人才能创建群聊',
				icon: 'none'
			})
			return
		}
		
		// 创建群聊数据结构（兼容后端 API 对接）
		const groupData = {
			// 群聊基本信息
			groupId: Date.now(), // 临时 ID，实际应由后端生成
			groupName: generateGroupName(selectedMembers),
			groupType: 'normal', // normal: 普通群聊, work: 工作群
			memberCount: selectedMembers.length,
			
			// 成员列表（用于后端 API）
			memberIds: selectedMembers.map(m => m.id),
			members: selectedMembers,
			
			// 创建时间
			createTime: Date.now(),
			
			// 群聊设置
			settings: {
				allowMemberInvite: true, // 允许成员邀请
				needApproval: false, // 加群是否需要审批
				muteAll: false // 全员禁言
			}
		}
		
		console.log('创建群聊数据:', groupData)
		
		uni.showToast({
			title: '创建群聊中...',
			icon: 'loading',
			duration: 1000
		})
		
		// TODO: 调用后端创建群聊 API
		// 示例：
		// createGroupChat(groupData).then(res => {
		//   const groupId = res.data.groupId
		//   navigateToGroupChat(groupId, groupData.groupName)
		// })
		
		// 模拟 API 调用延迟
		setTimeout(() => {
			// 创建成功后跳转到群聊页面
			uni.showToast({
				title: '创建成功',
				icon: 'success',
				duration: 1000
			})
			
			// 跳转到群聊页面
			setTimeout(() => {
				uni.redirectTo({
					url: `/pages/message/chat?type=group&groupId=${groupData.groupId}&name=${encodeURIComponent(groupData.groupName)}&memberCount=${groupData.memberCount}`
				})
				
				// 清空选择状态
				endSelection()
			}, 1000)
		}, 1000)
	}
	
	/**
	 * 生成群聊名称
	 * 规则：取前3个成员名字，用逗号分隔，超过3个显示"等N人"
	 */
	function generateGroupName(members : any[]) : string {
		if (members.length === 0) return '群聊'
		if (members.length <= 3) {
			return members.map(m => m.name).join('、')
		}
		const firstThree = members.slice(0, 3).map(m => m.name).join('、')
		return `${firstThree}等${members.length}人`
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < contactList.value.length; i++) {
			contactList.value[i].selected = isMemberSelected(contactList.value[i].id)
		}
	}

	// 页面加载时初始化选择模式
	onLoad(() => {
		startSelection()
		// 默认添加当前用户
		const currentUser = contactList.value.find(c => c.isCurrentUser)
		if (currentUser) {
			addMember(currentUser)
		}
		// 同步选中状态
		syncSelectionState()
	})

	// 页面显示时同步选中状态（从子页面返回时）
	onShow(() => {
		syncSelectionState()
	})

	// 页面卸载时清空选择状态（如果没有确认）
	onUnload(() => {
		endSelection()
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #1677FF;
	}

	.header {
		background-color: #1677FF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #ffffff;
		font-size: 20px;
	}

	.back-text {
		color: #ffffff;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #ffffff;
		font-size: 17px;
		font-weight: bold;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		background-color: #ffffff;
		padding: 10px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #e5e5e5;
	}

	.search-bar {
		background-color: #F3F4F6;
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
		color: #999999;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #333333;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #e5e5e5;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

	.selected-text {
		font-size: 15px;
		color: #333333;
	}

	.confirm-btn {
		background-color: rgba(22, 119, 255, 0.1);
		padding: 0 20px;
		height: 36px;
		border-radius: 4px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #1677FF;
		font-size: 14px;
		font-weight: 500;
	}
</style>