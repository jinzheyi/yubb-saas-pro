<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">{{ t('initiateGroup.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap">
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<!-- 使用联系人选择组件 -->
		<contact-selector 
			v-if="!loading"
			:show-categories="true"
			:selectable="true"
			:contacts="contactList"
			@select="handleSelect"
			@category-click="handleCategory"
		/>
		
		<!-- 加载状态 -->
		<view v-if="loading" class="loading-wrap">
			<text class="loading-text">加载中...</text>
		</view>
		
		<!-- 空状态 -->
		<view v-if="!loading && contactList.length === 0" class="empty-wrap">
			<text class="empty-text">暂无联系人</text>
		</view>

		<view class="footer">
			<text class="selected-text">{{ t('initiateGroup.selectedCount', { count: selectedCount.toString() }) }}</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">{{ t('initiateGroup.confirm', { count: selectedCount.toString(), max: '500' }) }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getUserInfo } from '../../store/user.uts'
	import { 
		startSelection, 
		endSelection, 
		getSelectedMembers, 
		getSelectedCount,
		addMember,
		toggleMember,
		isMemberSelected
	} from '../../store/group-selection.uts'
	import { createGroup } from '../../api/group.uts'
	import { getContactList } from '../../api/contact.uts'
	import { createConversation } from '../../api/conversation.uts'
	import ContactSelector from '../../components/contact-selector/contact-selector.uvue'

	const { t } = useI18n()

	const contactList = ref<any[]>([])
	const loading = ref(false)
	const colors = ['#0ea5e9', '#f472b6', '#c084fc', '#fb7185', '#10b981', '#f59e0b', '#ec4899', '#ef4444', '#3b82f6', '#8b5cf6']
	
	/**
	 * 获取拼音首字母
	 */
	function getPinyinFirstLetter(name : string) : string {
		// 简单实现：取第一个字符的 Unicode 编码判断
		const code = name.charCodeAt(0)
		if (code >= 19968 && code <= 40869) {
			// 中文字符，简单映射到 A-Z
			const index = (code - 19968) % 26
			return String.fromCharCode(65 + index)
		}
		// 非中文字符，取首字母大写
		return name.charAt(0).toUpperCase()
	}
	
	/**
	 * 加载联系人列表
	 */
	async function loadContacts() {
		console.log('[InitiateGroup] 开始加载联系人列表')
		loading.value = true
		
		try {
			// 获取当前登录用户信息
			const userInfo = getUserInfo()
			const currentUserId = userInfo?.user?.id ?? 0
			const currentUserName = userInfo?.user?.nickname ?? '我'
			
			// 获取联系人列表
			const contacts = await getContactList() as any[]
			console.log('[InitiateGroup] 联系人数量:', contacts.length)
			
			if (contacts.length === 0) {
				console.warn('[InitiateGroup] 联系人列表为空')
				uni.showToast({ title: '暂无联系人', icon: 'none' })
				return
			}
			
			// 转换为 UI 格式
			const list : any[] = []
			
			// 第一个添加当前登录用户，默认选中
			list.push({
				id: currentUserId,
				name: currentUserName,
				role: '当前用户',
				avatarText: currentUserName.substring(0, 2),
				avatarBg: '#1677FF',
				pinyin: 'W',
				selected: true,
				isCurrentUser: true
			})
			
			// 添加其他联系人（排除当前用户）
			contacts.forEach((contact, index) => {
				// 跳过当前用户
				if (contact.id === currentUserId) {
					return
				}
				
				// 优先使用 remarkName（备注名），其次使用 nickname（昵称）
				const displayName = contact.remarkName || contact.nickname || '未知'
				// 使用后端返回的拼音首字母（取第一个字符）
				let pinyinLetter = contact.pinyin || getPinyinFirstLetter(displayName)
				// 如果后端返回的是多字符拼音（如 "SY"），只取第一个字符
				if (pinyinLetter.length > 1) {
					pinyinLetter = pinyinLetter.charAt(0)
				}
				
				list.push({
					id: contact.id,
					name: displayName,
					role: contact.deptName || '',
					avatarText: displayName.substring(0, 2),
					avatarBg: colors[index % colors.length],
					pinyin: pinyinLetter,
					selected: false,
					isCurrentUser: false
				})
			})
			
			contactList.value = list
			console.log('[InitiateGroup] 处理后的联系人数量:', contactList.value.length)
			
		} catch (e) {
			console.error('[InitiateGroup] 加载联系人列表异常:', e)
			const errorMsg = (e as any).msg || '加载失败'
			uni.showToast({ title: errorMsg, icon: 'none' })
		} finally {
			loading.value = false
			console.log('[InitiateGroup] 加载完成')
		}
	}

	// 使用全局状态的选中数量
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	function handleBack() {
		// 返回时清空选择状态
		endSelection()
		uni.navigateBack()
	}

	function handleCategory(item : any) {
		// 跳转到对应的分组选择页面
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/my-groups?mode=select'
			})
		} else if (item.nameKey === 'contacts.following') {
			uni.navigateTo({
				url: '/pages/contacts/my-following?mode=select'
			})
		} else if (item.nameKey === 'contacts.org') {
			uni.navigateTo({
				url: '/pages/contacts/organization?mode=select'
			})
		} else if (item.nameKey === 'contacts.dept') {
			uni.navigateTo({
				url: '/pages/contacts/my-department?mode=select'
			})
		}
	}

	function handleSelect(item : any) {
		// 当前用户不能取消选中
		if (item.isCurrentUser && !item.selected) {
			uni.showToast({
				title: '不能取消选择自己',
				icon: 'none'
			})
			// 强制保持选中状态
			item.selected = true
			return
		}
		
		// 同步到全局状态
		toggleMember(item)
		// 确保本地状态与全局状态一致
		item.selected = isMemberSelected(item.id)
		
		console.log('选择联系人:', item.name, '选中状态:', item.selected)
	}

	async function handleConfirm() {
		const selectedMembers = getSelectedMembers()
		console.log('已选择的联系人:', selectedMembers)
		
		if (selectedMembers.length < 2) {
			uni.showToast({
				title: '至少选择2人才能创建群聊',
				icon: 'none'
			})
			return
		}
		
		// 生成群名称
		const groupName = generateGroupName(selectedMembers)
		
		// 构建创建群聊请求数据（匹配后端 VO 字段）
		const createData = {
			name: groupName,                    // 群名称（必填）
			groupType: 1,                       // 群类型：1-普通群 2-工作群（必填）
			memberIds: selectedMembers.map(m => m.id),  // 群成员ID列表（必填，List<Long>）
			introduction: ''                    // 群简介（可选）
		}
		
		console.log('[InitiateGroup] 创建群聊请求数据:', createData)
		console.log('[InitiateGroup] memberIds:', createData.memberIds)
		console.log('[InitiateGroup] memberIds 类型:', typeof createData.memberIds)
		console.log('[InitiateGroup] memberIds 长度:', createData.memberIds.length)
		
		uni.showToast({
			title: '创建群聊中...',
			icon: 'loading',
			duration: 2000
		})
		
		try {
			// 调用后端创建群聊 API
			const result = await createGroup(createData)
			
			console.log('[InitiateGroup] 创建群聊成功:', result)
			
			// 获取返回的群 ID
			const groupId = result.id || result.data?.id || result
			
			if (!groupId) {
				throw new Error('创建群聊失败：未返回群ID')
			}
			
			// 创建或获取会话
			const conversationData = {
				targetId: groupId,
				conversationType: 2  // 2-群聊
			}
			
			const conversationResult = await createConversation(conversationData)
			console.log('[InitiateGroup] 创建会话成功:', conversationResult)
			
			// 获取会话ID
			const conversationId = conversationResult.id || conversationResult.data?.id || conversationResult
			
			uni.showToast({
				title: '创建成功',
				icon: 'success',
				duration: 1000
			})
			
			// 跳转到群聊页面（包含 conversationId）
			setTimeout(() => {
				uni.redirectTo({
					url: `/pages/message/chat?type=group&groupId=${groupId}&conversationId=${conversationId}&name=${encodeURIComponent(groupName)}&memberCount=${selectedMembers.length}`
				})
				
				// 清空选择状态
				endSelection()
			}, 1000)
			
		} catch (e) {
			console.error('[InitiateGroup] 创建群聊失败:', e)
			const errorMsg = (e as any).msg || (e as any).message || '创建失败，请重试'
			uni.showToast({
				title: errorMsg,
				icon: 'none',
				duration: 2000
			})
		}
	}
	
	/**
	 * 生成群聊名称
	 * 规则：取前3个成员名字，用逗号分隔，超过3个显示"等N人"
	 */
	function generateGroupName(members : any[]) : string {
		if (members.length === 0) return '群聊'
		if (members.length <= 3) {
			return members.map(m => m.name).join('、')
		}
		const firstThree = members.slice(0, 3).map(m => m.name).join('、')
		return `${firstThree}等${members.length}人`
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < contactList.value.length; i++) {
			contactList.value[i].selected = isMemberSelected(contactList.value[i].id)
		}
	}

	// 页面加载时初始化选择模式
	onLoad(() => {
		startSelection()
		// 加载联系人列表
		loadContacts().then(() => {
			// 默认添加当前用户
			const currentUser = contactList.value.find(c => c.isCurrentUser)
			if (currentUser) {
				addMember(currentUser)
			}
			// 同步选中状态
			syncSelectionState()
		})
	})

	// 页面显示时同步选中状态（从子页面返回时）
	onShow(() => {
		syncSelectionState()
	})

	// 页面卸载时清空选择状态（如果没有确认）
	onUnload(() => {
		endSelection()
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #1677FF;
	}

	.header {
		background-color: #1677FF;
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		color: #ffffff;
		font-size: 20px;
	}

	.back-text {
		color: #ffffff;
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		color: #ffffff;
		font-size: 17px;
		font-weight: bold;
	}

	.header-right {
		width: 80px;
	}

	.search-wrap {
		background-color: #ffffff;
		padding: 10px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #e5e5e5;
	}

	.search-bar {
		background-color: #F3F4F6;
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
	}

	.search-icon {
		font-size: 16px;
		color: #999999;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #333333;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #e5e5e5;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

	.selected-text {
		font-size: 15px;
		color: #333333;
	}

	.confirm-btn {
		background-color: rgba(22, 119, 255, 0.1);
		padding: 0 20px;
		height: 36px;
		border-radius: 4px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #1677FF;
		font-size: 14px;
		font-weight: 500;
	}
	
	.loading-wrap {
		flex: 1;
		justify-content: center;
		align-items: center;
		padding: 40px 0;
	}
	
	.loading-text {
		font-size: 14px;
		color: #8F959E;
	}
	
	.empty-wrap {
		flex: 1;
		justify-content: center;
		align-items: center;
		padding: 40px 0;
	}
	
	.empty-text {
		font-size: 14px;
		color: #8F959E;
	}
</style>