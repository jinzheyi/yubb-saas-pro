<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon">&#xeb04;</text>
				<text class="back-text">{{ t('common.back') }}</text>
			</view>
			<text class="header-title">{{ t('initiateGroup.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="search-wrap">
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="section-label">
				<text class="section-text">{{ t('initiateGroup.selectExisting') }}</text>
			</view>
			<view class="category-group">
				<view class="category-item" v-for="(item, index) in categories" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>

			<view class="section-label">
				<text class="section-text">{{ t('contacts.commonContacts') }}</text>
			</view>
			<view class="contact-list">
				<view class="contact-item" v-for="(item, index) in commonContacts" :key="index" @click="toggleSelect(item)">
					<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
						<text class="avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="contact-info">
						<text class="contact-name">{{ item.name }}</text>
						<text class="contact-role">{{ item.role }}</text>
					</view>
					<view :class="['checkbox', item.selected ? 'checkbox-active' : '']">
						<text v-if="item.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="footer">
			<text class="selected-text">{{ t('initiateGroup.selectedCount', { count: selectedCount.toString() }) }}</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定({{ selectedCount }}/500)</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const categories = [
		{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' },
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	const commonContacts = ref([
		{ id: 1, name: '陶戈', role: '高级经理', avatarText: '陶戈', avatarBg: '#0ea5e9', selected: false },
		{ id: 2, name: '陈子蒙', role: '部门副总经理 (主持工作)', avatarText: '子蒙', avatarBg: '#f472b6', selected: false },
		{ id: 3, name: '刘丹丹', role: '行政经理', avatarText: '丹丹', avatarBg: '#c084fc', selected: false },
		{ id: 4, name: '胡婷', role: '副部长 (主持工作)', avatarText: '胡婷', avatarBg: '#fb7185', selected: true },
		{ id: 5, name: '朱述勇', role: '开发工程师', avatarText: '述勇', avatarBg: '#10b981', selected: false }
	])

	const selectedCount = computed(() => {
		return commonContacts.value.filter(item => item.selected).length
	})

	function handleBack() {
		uni.navigateBack()
	}

	function handleCategory(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}

	function toggleSelect(item : any) {
		item.selected = !item.selected
	}

	function handleConfirm() {
		uni.showToast({
			title: '创建群聊中...',
			icon: 'loading'
		})
	}
</script>

<style>
