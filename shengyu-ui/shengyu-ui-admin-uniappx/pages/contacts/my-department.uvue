<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的部门</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input 
					class="search-input" 
					v-model="searchKeyword"
					placeholder="搜索" 
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 部门层级 -->
			<view class="dept-hierarchy">
				<view 
					v-for="dept in deptTree" 
					:key="dept.id"
					class="dept-node-wrapper"
				>
					<!-- 一级部门 -->
					<view class="dept-node" @click="toggleDeptExpand(dept)">
						<view class="dept-node-content">
							<text v-if="dept.children && dept.children.length > 0" class="iconfont expand-icon-left">
								{{ dept.expanded ? '\ueaf5' : '\ueaf3' }}
							</text>
							<text class="dept-node-text">{{ dept.name }}({{ dept.userCount || 0 }})</text>
						</view>
					</view>
					
					<!-- 子部门（递归渲染） -->
					<view v-if="dept.expanded && dept.children && dept.children.length > 0" class="dept-children">
						<view 
							v-for="child in dept.children" 
							:key="child.id"
							class="dept-child-wrapper"
						>
							<view 
								:class="['dept-child', currentDeptId === child.id ? 'dept-child-active' : '']" 
								@click="selectDept(child)"
							>
								<text v-if="child.children && child.children.length > 0" class="iconfont child-icon">
									{{ child.expanded ? '\ueaf5' : '\ueaf3' }}
								</text>
								<text v-else class="child-icon-placeholder"></text>
								<text :class="['dept-child-text', currentDeptId === child.id ? 'dept-child-text-active' : '']">
									{{ child.name }}({{ child.userCount || 0 }})
								</text>
							</view>
							
							<!-- 三级部门 -->
							<view v-if="child.expanded && child.children && child.children.length > 0" class="dept-grandchildren">
								<view 
									v-for="grandchild in child.children" 
									:key="grandchild.id"
									:class="['dept-child', currentDeptId === grandchild.id ? 'dept-child-active' : '']" 
									@click="selectDept(grandchild)"
								>
									<text v-if="grandchild.children && grandchild.children.length > 0" class="iconfont child-icon">
										{{ grandchild.expanded ? '\ueaf5' : '\ueaf3' }}
									</text>
									<text v-else class="child-icon-placeholder"></text>
									<text :class="['dept-child-text', currentDeptId === grandchild.id ? 'dept-child-text-active' : '']">
										{{ grandchild.name }}({{ grandchild.userCount || 0 }})
									</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 成员列表 -->
			<view v-if="memberList.length > 0" class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item" 
					@click="handleMemberClick(member)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', member.selected ? 'checkbox-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<text class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name">{{ member.name }}</text>
						<text class="member-role">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border"></view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-if="!loading && memberList.length === 0 && currentDeptId !== null" class="empty-state">
				<text class="empty-text">暂无成员</text>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer">
			<text class="selected-text">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount
	} from '../../store/group-selection.uts'
	import { getMyDeptTree } from '../../api/dept.uts'
	import { getUserList } from '../../api/user.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'

	const { t } = useI18n()

	// 部门树数据
	const deptTree = ref<any[]>([])
	
	// 当前选中的部门ID（默认为用户所在部门）
	const currentDeptId = ref<number | null>(null)
	
	// 是否为选择模式
	const isSelectMode = ref(false)
	
	// 加载状态
	const loading = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0

	// 成员列表数据
	const memberList = ref<any[]>([])

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	/**
	 * 返回上一页
	 */
	function handleBack() {
		uni.navigateBack()
	}

	/**
	 * 加载我的部门树
	 */
	async function loadDeptList() {
		try {
			loading.value = true
			const data = await getMyDeptTree()
			
			if (data && data.length > 0) {
				// 后端返回的是已排序的扁平列表，包含所有相关部门
				// 构建树形结构
				deptTree.value = buildDeptTreeFromPath(data)
				
				// 查找第一个有用户数据的部门作为默认选中
				let firstUserDept = null
				for (let i = 0; i < data.length; i++) {
					if (data[i].users && data[i].users.length > 0) {
						firstUserDept = data[i]
						break
					}
				}
				
				if (firstUserDept !== null) {
					currentDeptId.value = firstUserDept.id
					// 显示该部门的成员
					showDeptMembers(firstUserDept)
				}
			}
		} catch (e) {
			console.error('[MyDepartment] 加载部门列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	/**
	 * 从扁平列表构建部门树
	 * 后端返回的是已排序的扁平列表，包含所有相关部门
	 */
	function buildDeptTreeFromPath(pathList: any[]): any[] {
		if (pathList.length === 0) {
			return []
		}
		
		// 创建部门映射表
		const deptMap = new Map<number, any>()
		const userDeptIds = new Set<number>()
		
		// 第一遍：创建所有节点，并标记用户所属部门
		for (let i = 0; i < pathList.length; i++) {
			const dept = pathList[i]
			const node = {
				id: dept.id,
				name: dept.name,
				parentId: dept.parentId,
				sort: dept.sort || 0,
				expanded: false, // 默认收起
				userCount: dept.users ? dept.users.length : 0,
				children: [] as any[]
			}
			deptMap.set(dept.id, node)
			
			// 如果部门有用户数据，说明是用户所属部门
			if (dept.users && dept.users.length > 0) {
				userDeptIds.add(dept.id)
			}
		}
		
		// 第二遍：建立父子关系
		const rootNodes: any[] = []
		for (const [id, node] of deptMap) {
			if (node.parentId === null || node.parentId === 0) {
				// 根节点
				rootNodes.push(node)
			} else {
				// 子节点，添加到父节点的children中
				const parent = deptMap.get(node.parentId)
				if (parent !== null) {
					parent.children.push(node)
				}
			}
		}
		
		// 对每个节点的children按sort排序
		function sortChildren(nodes: any[]) {
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				if (node.children.length > 0) {
					node.children.sort((a: any, b: any) => {
						return a.sort - b.sort
					})
					sortChildren(node.children)
				}
			}
		}
		
		// 对根节点排序
		rootNodes.sort((a: any, b: any) => {
			return a.sort - b.sort
		})
		sortChildren(rootNodes)
		
		// 展开到用户所属部门的路径
		function expandToUserDepts(nodes: any[]): boolean {
			let hasUserDept = false
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				// 检查当前节点或其子节点是否包含用户部门
				const childHasUserDept = expandToUserDepts(node.children)
				const isUserDept = userDeptIds.has(node.id)
				
				if (isUserDept || childHasUserDept) {
					node.expanded = true
					hasUserDept = true
				}
			}
			return hasUserDept
		}
		
		expandToUserDepts(rootNodes)
		
		return rootNodes
	}

	/**
	 * 切换部门展开状态
	 */
	function toggleDeptExpand(dept: any) {
		// 如果有子部门，切换展开状态
		if (dept.children && dept.children.length > 0) {
			dept.expanded = !dept.expanded
		}
		
		// 如果点击的是用户所属部门，也选中它
		if (dept.userCount > 0) {
			currentDeptId.value = dept.id
			loadMemberList(dept.id)
		}
	}

	/**
	 * 选择部门
	 */
	function selectDept(dept: any) {
		// 如果有子部门，切换展开状态
		if (dept.children && dept.children.length > 0) {
			dept.expanded = !dept.expanded
		}
		
		// 设置当前选中的部门
		currentDeptId.value = dept.id
		
		// 如果部门有用户数据（用户所属部门），直接显示
		// 否则从后端加载
		if (dept.userCount > 0) {
			// 从后端数据中查找该部门的用户
			loadMemberList(dept.id)
		} else {
			// 清空成员列表
			memberList.value = []
		}
	}

	/**
	 * 加载成员列表
	 */
	async function loadMemberList(deptId: number) {
		try {
			loading.value = true
			
			const params: UTSJSONObject = {
				deptId: deptId,
				status: 0 // 只查询正常状态的用户
			}
			
			// 如果有搜索关键词，添加到查询参数
			if (searchKeyword.value !== '') {
				params['keyword'] = searchKeyword.value
			}
			
			const data = await getUserList(params)
			
			if (data && data.length > 0) {
				// 转换为页面需要的格式
				memberList.value = data.map((user: any) => {
					return {
						id: user.id,
						name: user.nickname,
						role: user.postName || '未设置岗位',
						avatarText: getAvatarText(user.nickname),
						avatarBg: getUserAvatarColor(user.id),
						selected: isMemberSelected(user.id)
					}
				})
				
				// 更新部门的用户数量
				updateDeptUserCount(deptId, data.length)
			} else {
				memberList.value = []
				updateDeptUserCount(deptId, 0)
			}
		} catch (e) {
			console.error('[MyDepartment] 加载成员列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
			memberList.value = []
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 从后端返回的数据中显示部门成员
	 */
	function showDeptMembers(dept: any) {
		if (dept.users && dept.users.length > 0) {
			memberList.value = dept.users.map((user: any) => {
				return {
					id: user.id,
					name: user.nickname,
					role: user.postName || '未设置岗位',
					avatarText: getAvatarText(user.nickname),
					avatarBg: getUserAvatarColor(user.id),
					selected: isMemberSelected(user.id)
				}
			})
		} else {
			memberList.value = []
		}
	}

	/**
	 * 更新部门的用户数量
	 */
	function updateDeptUserCount(deptId: number, count: number) {
		// 递归查找并更新部门的用户数量
		function updateCount(depts: any[]): boolean {
			for (let i = 0; i < depts.length; i++) {
				const dept = depts[i]
				if (dept.id === deptId) {
					dept.userCount = count
					return true
				}
				if (dept.children && dept.children.length > 0) {
					if (updateCount(dept.children)) {
						return true
					}
				}
			}
			return false
		}
		
		updateCount(deptTree.value)
	}

	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer !== 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟500ms执行搜索
		searchTimer = setTimeout(() => {
			if (currentDeptId.value !== null) {
				loadMemberList(currentDeptId.value)
			}
		}, 500)
	}

	/**
	 * 切换成员选中状态
	 */
	function toggleMemberSelect(member : any) {
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(member.id)
	}

	/**
	 * 处理成员点击
	 */
	function handleMemberClick(member : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleMemberSelect(member)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${member.id}&name=${encodeURIComponent(member.name)}`
			})
		}
	}

	/**
	 * 确认选择
	 */
	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	/**
	 * 同步本地选中状态与全局状态
	 */
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(memberList.value[i].id)
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载我的部门树
		loadDeptList()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.dept-hierarchy {
		background-color: #FFFFFF;
		padding: 12px 16px;
		border-bottom-width: 8px;
		border-bottom-color: #F5F7FA;
	}

	.dept-node {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 4px 0;
	}
	
	.dept-node-content {
		flex-direction: row;
		align-items: center;
	}
	
	.expand-icon-left {
		font-size: 16px;
		color: #8F959E;
		margin-right: 8px;
		width: 20px;
	}

	.dept-node-text {
		font-size: 16px;
		font-weight: 500;
		color: #1F2329;
	}

	.expand-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.dept-children {
		margin-top: 12px;
		margin-left: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.2);
	}

	.dept-child {
		flex-direction: row;
		align-items: center;
		margin-bottom: 12px;
		cursor: pointer;
		padding: 4px 0;
	}

	.dept-child:active {
		opacity: 0.6;
	}

	.dept-child:last-child {
		margin-bottom: 0;
	}

	.child-icon {
		font-size: 14px;
		color: #0ea5e9;
		margin-right: 8px;
		width: 20px;
	}
	
	.child-icon-placeholder {
		width: 20px;
		margin-right: 8px;
	}

	.dept-child-text {
		font-size: 15px;
		color: #646A73;
	}

	.dept-child-active {
		background-color: rgba(14,165,233,0.08);
		border-radius: 4px;
		padding: 6px 8px;
		margin-left: -8px;
	}
	
	.dept-child-active .dept-child-text {
		color: #0ea5e9;
		font-weight: 500;
	}

	.dept-grandchildren {
		margin-left: 20px;
		margin-top: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.15);
	}
	
	.dept-node-wrapper {
		margin-bottom: 0;
	}
	
	.dept-child-wrapper {
		margin-bottom: 0;
	}

	.member-list {
		background-color: #FFFFFF;
	}
	
	.empty-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 14px;
		color: #8F959E;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.member-item:active {
		background-color: #F2F3F5;
	}

	.member-item-border {
		position: absolute;
		bottom: 0;
		left: 70px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.member-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.member-info {
		flex: 1;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.member-name {
		font-size: 16px;
		font-weight: 400;
		color: #1F2329;
	}

	.member-role {
		font-size: 12px;
		color: #8F959E;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8F959E;
		background-color: #FFFFFF;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

