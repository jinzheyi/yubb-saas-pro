<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的部门</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input 
					class="search-input" 
					v-model="searchKeyword"
					placeholder="搜索" 
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 部门层级 -->
			<view class="dept-hierarchy">
				<view 
					v-for="dept in deptTree" 
					:key="dept.id"
					class="dept-node-wrapper"
				>
					<!-- 一级部门 -->
					<view class="dept-node" @click="toggleDeptExpand(dept)">
						<view class="dept-node-content">
							<text v-if="dept.children && dept.children.length > 0" class="iconfont expand-icon-left">
								{{ dept.expanded ? '\ueaf5' : '\ueaf3' }}
							</text>
							<text class="dept-node-text">{{ dept.name }}({{ dept.userCount || 0 }})</text>
						</view>
					</view>
					
					<!-- 子部门（递归渲染） -->
					<view v-if="dept.expanded && dept.children && dept.children.length > 0" class="dept-children">
						<view 
							v-for="child in dept.children" 
							:key="child.id"
							class="dept-child-wrapper"
						>
							<view 
								:class="['dept-child', currentDeptId === child.id ? 'dept-child-active' : '']" 
								@click="selectDept(child)"
							>
								<text v-if="child.children && child.children.length > 0" class="iconfont child-icon">
									{{ child.expanded ? '\ueaf5' : '\ueaf3' }}
								</text>
								<text v-else class="child-icon-placeholder"></text>
								<text :class="['dept-child-text', currentDeptId === child.id ? 'dept-child-text-active' : '']">
									{{ child.name }}({{ child.userCount || 0 }})
								</text>
							</view>
							
							<!-- 三级部门 -->
							<view v-if="child.expanded && child.children && child.children.length > 0" class="dept-grandchildren">
								<view 
									v-for="grandchild in child.children" 
									:key="grandchild.id"
									:class="['dept-child', currentDeptId === grandchild.id ? 'dept-child-active' : '']" 
									@click="selectDept(grandchild)"
								>
									<text v-if="grandchild.children && grandchild.children.length > 0" class="iconfont child-icon">
										{{ grandchild.expanded ? '\ueaf5' : '\ueaf3' }}
									</text>
									<text v-else class="child-icon-placeholder"></text>
									<text :class="['dept-child-text', currentDeptId === grandchild.id ? 'dept-child-text-active' : '']">
										{{ grandchild.name }}({{ grandchild.userCount || 0 }})
									</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 成员列表 -->
			<view v-if="memberList.length > 0" class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item" 
					@click="handleMemberClick(member)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', member.selected ? 'checkbox-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<text class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name">{{ member.name }}</text>
						<text class="member-role">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border"></view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-if="!loading && memberList.length === 0 && currentDeptId !== null" class="empty-state">
				<text class="empty-text">暂无成员</text>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer">
			<text class="selected-text">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount
	} from '../../store/group-selection.uts'
	import { getMyDeptTree, getDeptMembers } from '../../api/dept.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'

	const { t } = useI18n()

	// 部门树数据
	const deptTree = ref<any[]>([])
	
	// 原始部门树数据（用于搜索后恢复）
	const originalDeptTree = ref<any[]>([])
	
	// 当前选中的部门ID
	const currentDeptId = ref<number | null>(null)
	
	// 是否为选择模式
	const isSelectMode = ref(false)
	
	// 加载状态
	const loading = ref(false)
	
	// 成员加载状态
	const loadingMembers = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0
	
	// 已加载成员的部门缓存 Map<deptId, members[]>
	const deptMembersCache = new Map<number, any[]>()

	// 成员列表数据（当前选中部门的成员）
	const memberList = ref<any[]>([])

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	/**
	 * 返回上一页
	 */
	function handleBack() {
		uni.navigateBack()
	}

	/**
	 * 加载我的部门树
	 */
	async function loadDeptList() {
		try {
			loading.value = true
			const data = await getMyDeptTree()
			
			if (data && data.length > 0) {
				// 构建树形结构（不包含用户数据）
				const tree = buildDeptTreeFromPath(data)
				deptTree.value = tree
				
				// 保存原始部门树数据（深拷贝）
				originalDeptTree.value = JSON.parse(JSON.stringify(tree))
				
				// 清空成员列表和缓存
				memberList.value = []
				deptMembersCache.clear()
				currentDeptId.value = null
			} else {
				// 没有数据时清空
				deptTree.value = []
				originalDeptTree.value = []
				memberList.value = []
				deptMembersCache.clear()
			}
		} catch (e) {
			console.error('[MyDepartment] 加载部门列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	/**
	 * 从扁平列表构建部门树
	 * 后端返回的是已排序的扁平列表，包含所有相关部门
	 */
	function buildDeptTreeFromPath(pathList: any[]): any[] {
		if (pathList.length === 0) {
			return []
		}
		
		// 创建部门映射表
		const deptMap = new Map<number, any>()
		
		// 第一遍：创建所有节点
		for (let i = 0; i < pathList.length; i++) {
			const dept = pathList[i]
			const node = {
				id: dept.id,
				name: dept.name,
				parentId: dept.parentId,
				sort: dept.sort || 0,
				expanded: false, // 默认收起
				userCount: dept.memberCount || 0, // 使用后端返回的成员数量
				children: [] as any[]
			}
			deptMap.set(dept.id, node)
		}
		
		// 第二遍：建立父子关系
		const rootNodes: any[] = []
		for (const [id, node] of deptMap) {
			if (node.parentId === null || node.parentId === 0) {
				// 根节点
				rootNodes.push(node)
			} else {
				// 子节点，添加到父节点的children中
				const parent = deptMap.get(node.parentId)
				if (parent !== null) {
					parent.children.push(node)
				}
			}
		}
		
		// 对每个节点的children按sort排序
		function sortChildren(nodes: any[]) {
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				if (node.children.length > 0) {
					node.children.sort((a: any, b: any) => {
						return a.sort - b.sort
					})
					sortChildren(node.children)
				}
			}
		}
		
		// 对根节点排序
		rootNodes.sort((a: any, b: any) => {
			return a.sort - b.sort
		})
		sortChildren(rootNodes)
		
		// 默认展开第一层
		for (let i = 0; i < rootNodes.length; i++) {
			rootNodes[i].expanded = true
		}
		
		return rootNodes
	}

	/**
	 * 切换部门展开状态
	 */
	function toggleDeptExpand(dept: any) {
		// 如果有子部门，切换展开状态
		if (dept.children && dept.children.length > 0) {
			dept.expanded = !dept.expanded
		}
	}

	/**
	 * 选择部门（点击加载成员）
	 */
	async function selectDept(dept: any) {
		// 如果有子部门，切换展开状态
		if (dept.children && dept.children.length > 0) {
			dept.expanded = !dept.expanded
		}
		
		// 设置当前选中的部门
		currentDeptId.value = dept.id
		
		// 加载该部门的成员
		await loadDeptMembers(dept.id)
	}
	
	/**
	 * 加载部门成员
	 */
	async function loadDeptMembers(deptId: number, keyword?: string) {
		// 如果有缓存且没有搜索关键词，直接使用缓存
		if (!keyword && deptMembersCache.has(deptId)) {
			memberList.value = deptMembersCache.get(deptId) || []
			return
		}
		
		try {
			loadingMembers.value = true
			const data = await getDeptMembers(String(deptId), keyword)
			
			if (data && data.length > 0) {
				const members = data.map((user: any) => {
					return {
						id: user.id,
						name: user.nickname,
						role: user.postName || '未设置岗位',
						avatarText: getAvatarText(user.nickname),
						avatarBg: getUserAvatarColor(user.id),
						selected: isMemberSelected(user.id)
					}
				})
				
				memberList.value = members
				
				// 如果没有搜索关键词，缓存结果
				if (!keyword) {
					deptMembersCache.set(deptId, members)
					// 更新部门的userCount
					updateDeptUserCount(deptId, members.length)
				}
			} else {
				memberList.value = []
				if (!keyword) {
					deptMembersCache.set(deptId, [])
					updateDeptUserCount(deptId, 0)
				}
			}
		} catch (e) {
			console.error('[MyDepartment] 加载部门成员失败:', e)
			uni.showToast({
				title: '加载成员失败',
				icon: 'none'
			})
			memberList.value = []
		} finally {
			loadingMembers.value = false
		}
	}
	
	/**
	 * 更新部门的用户数量
	 */
	function updateDeptUserCount(deptId: number, count: number) {
		function updateInTree(nodes: any[]): boolean {
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				if (node.id === deptId) {
					node.userCount = count
					return true
				}
				if (node.children && node.children.length > 0) {
					if (updateInTree(node.children)) {
						return true
					}
				}
			}
			return false
		}
		
		updateInTree(deptTree.value)
	}
	
	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer !== 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟500ms执行搜索
		searchTimer = setTimeout(() => {
			if (searchKeyword.value && searchKeyword.value.length > 0) {
				// 执行搜索：只显示包含搜索结果的部门和成员
				performSearch()
			} else {
				// 清空搜索时，恢复原始数据
				restoreOriginalData()
			}
		}, 500)
	}
	
	/**
	 * 执行搜索：只显示包含搜索结果的部门和成员
	 */
	async function performSearch() {
		try {
			loadingMembers.value = true
			
			// 递归搜索所有部门
			const filteredTree = await searchAndFilterDepts(originalDeptTree.value, searchKeyword.value)
			
			// 更新显示数据
			deptTree.value = filteredTree
			
			// 如果有搜索结果，自动选中第一个有成员的部门
			const firstDeptWithMembers = findFirstDeptWithMembers(filteredTree)
			if (firstDeptWithMembers !== null) {
				currentDeptId.value = firstDeptWithMembers.id
				memberList.value = firstDeptWithMembers.members || []
			} else {
				currentDeptId.value = null
				memberList.value = []
			}
			
		} catch (e) {
			console.error('[MyDepartment] 搜索失败:', e)
		} finally {
			loadingMembers.value = false
		}
	}
	
	/**
	 * 递归搜索并过滤部门
	 * 只返回包含搜索结果的部门
	 */
	async function searchAndFilterDepts(depts: any[], keyword: string): Promise<any[]> {
		const result: any[] = []
		
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			
			// 搜索当前部门的成员
			const data = await getDeptMembers(String(dept.id), keyword)
			let members: any[] = []
			if (data && data.length > 0) {
				members = data.map((user: any) => {
					return {
						id: user.id,
						name: user.nickname,
						role: user.postName || '未设置岗位',
						avatarText: getAvatarText(user.nickname),
						avatarBg: getUserAvatarColor(user.id),
						selected: isMemberSelected(user.id)
					}
				})
			}
			
			// 递归搜索子部门
			let filteredChildren: any[] = []
			if (dept.children && dept.children.length > 0) {
				filteredChildren = await searchAndFilterDepts(dept.children, keyword)
			}
			
			// 如果当前部门有匹配的成员或子部门有结果，则保留该部门
			if (members.length > 0 || filteredChildren.length > 0) {
				result.push({
					id: dept.id,
					name: dept.name,
					parentId: dept.parentId,
					sort: dept.sort,
					expanded: true, // 搜索结果默认展开
					userCount: members.length,
					children: filteredChildren,
					members: members // 临时保存成员数据用于显示
				})
			}
		}
		
		return result
	}
	
	/**
	 * 查找第一个有成员的部门
	 */
	function findFirstDeptWithMembers(depts: any[]): any | null {
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			if (dept.members && dept.members.length > 0) {
				return dept
			}
			if (dept.children && dept.children.length > 0) {
				const found = findFirstDeptWithMembers(dept.children)
				if (found !== null) {
					return found
				}
			}
		}
		return null
	}
	
	/**
	 * 恢复原始数据
	 */
	function restoreOriginalData() {
		// 恢复部门树
		deptTree.value = JSON.parse(JSON.stringify(originalDeptTree.value))
		
		// 清空选中和成员列表
		currentDeptId.value = null
		memberList.value = []
	}

	/**
	 * 切换成员选中状态
	 */
	function toggleMemberSelect(member : any) {
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(member.id)
	}

	/**
	 * 处理成员点击
	 */
	function handleMemberClick(member : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleMemberSelect(member)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${member.id}&name=${encodeURIComponent(member.name)}`
			})
		}
	}

	/**
	 * 确认选择
	 */
	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	/**
	 * 同步本地选中状态与全局状态
	 */
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(memberList.value[i].id)
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载我的部门树
		loadDeptList()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.dept-hierarchy {
		background-color: #FFFFFF;
		padding: 12px 16px;
		border-bottom-width: 8px;
		border-bottom-color: #F5F7FA;
	}

	.dept-node {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 4px 0;
	}
	
	.dept-node-content {
		flex-direction: row;
		align-items: center;
	}
	
	.expand-icon-left {
		font-size: 16px;
		color: #8F959E;
		margin-right: 8px;
		width: 20px;
	}

	.dept-node-text {
		font-size: 16px;
		font-weight: 500;
		color: #1F2329;
	}

	.expand-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.dept-children {
		margin-top: 12px;
		margin-left: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.2);
	}

	.dept-child {
		flex-direction: row;
		align-items: center;
		margin-bottom: 12px;
		cursor: pointer;
		padding: 4px 0;
	}

	.dept-child:active {
		opacity: 0.6;
	}

	.dept-child:last-child {
		margin-bottom: 0;
	}

	.child-icon {
		font-size: 14px;
		color: #0ea5e9;
		margin-right: 8px;
		width: 20px;
	}
	
	.child-icon-placeholder {
		width: 20px;
		margin-right: 8px;
	}

	.dept-child-text {
		font-size: 15px;
		color: #646A73;
	}

	.dept-child-active {
		background-color: rgba(14,165,233,0.08);
		border-radius: 4px;
		padding: 6px 8px;
		margin-left: -8px;
	}
	
	.dept-child-active .dept-child-text {
		color: #0ea5e9;
		font-weight: 500;
	}

	.dept-grandchildren {
		margin-left: 20px;
		margin-top: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.15);
	}
	
	.dept-node-wrapper {
		margin-bottom: 0;
	}
	
	.dept-child-wrapper {
		margin-bottom: 0;
	}

	.member-list {
		background-color: #FFFFFF;
	}
	
	.empty-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 14px;
