<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的部门</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" placeholder="搜索" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 部门层级 -->
			<view class="dept-hierarchy">
				<view class="dept-node" @click="toggleDeptExpand">
					<text class="dept-node-text">科技创新集团有限公司(30)</text>
					<text class="iconfont expand-icon">{{ deptExpanded ? '\ueaf5' : '\ueaf3' }}</text>
				</view>
				<view v-if="deptExpanded" class="dept-children">
					<!-- 二级部门1 -->
					<view class="dept-child" @click="toggleSubDept1">
						<text class="iconfont child-icon">{{ subDept1Expanded ? '\ueaf5' : '\ueaf3' }}</text>
						<text class="dept-child-text">数字科技有限公司(30)</text>
					</view>
					<!-- 三级部门（软件研发事业部）- 只在二级部门1展开时显示 -->
					<view v-if="subDept1Expanded" class="dept-grandchildren">
						<view class="dept-child dept-child-active" @click="toggleSubDept2">
							<text class="iconfont child-icon">{{ subDept2Expanded ? '\ueaf5' : '\ueaf3' }}</text>
							<text class="dept-child-text dept-child-text-active">软件研发事业部(30)</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 成员列表 - 只在三级部门展开时显示 -->
			<view v-if="deptExpanded && subDept1Expanded && subDept2Expanded" class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item" 
					@click="handleMemberClick(member)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', member.selected ? 'checkbox-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<text class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name">{{ member.name }}</text>
						<text class="member-role">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer">
			<text class="selected-text">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount
	} from '../../store/group-selection.uts'

	const { t } = useI18n()

	// 部门层级展开状态
	const deptExpanded = ref(true)
	const subDept1Expanded = ref(true)  // 数字科技有限公司
	const subDept2Expanded = ref(true)  // 软件研发事业部
	
	// 是否为选择模式
	const isSelectMode = ref(false)

	// 成员列表数据（ID范围：4001-4010，避免与其他页面冲突）
	const memberList = ref([
		{
			id: 4001,
			name: '朱付生',
			role: '副部长（主持工作）',
			avatarText: '付生',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4002,
			name: '王尹',
			role: '副部长',
			avatarText: '王尹',
			avatarBg: '#fb7185',
			selected: false
		},
		{
			id: 4003,
			name: '喻泽鹏',
			role: 'UI设计师',
			avatarText: '泽鹏',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4004,
			name: '徐碧',
			role: '售前经理',
			avatarText: '徐碧',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4005,
			name: '万剑波',
			role: '产品经理',
			avatarText: '剑波',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4006,
			name: '刘建弋',
			role: '软件项目经理',
			avatarText: '建弋',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4007,
			name: '曾丁丁',
			role: '软件项目经理',
			avatarText: '丁丁',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4008,
			name: '胡耀华',
			role: '软件项目经理',
			avatarText: '耀华',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4009,
			name: '方竞凯',
			role: '开发工程师',
			avatarText: '竞凯',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 4010,
			name: '张敏',
			role: '开发工程师',
			avatarText: '张敏',
			avatarBg: '#10b981',
			selected: false
		}
	])

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	function handleBack() {
		uni.navigateBack()
	}

	function toggleDeptExpand() {
		deptExpanded.value = !deptExpanded.value
	}

	function toggleSubDept1() {
		subDept1Expanded.value = !subDept1Expanded.value
	}

	function toggleSubDept2() {
		subDept2Expanded.value = !subDept2Expanded.value
	}

	function toggleMemberSelect(member : any) {
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(member.id)
	}

	function handleMemberClick(member : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleMemberSelect(member)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${member.id}&name=${encodeURIComponent(member.name)}`
			})
		}
	}

	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(memberList.value[i].id)
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		// 同步选中状态
		syncSelectionState()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.dept-hierarchy {
		background-color: #FFFFFF;
		padding: 12px 16px;
		border-bottom-width: 8px;
		border-bottom-color: #F5F7FA;
	}

	.dept-node {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.dept-node-text {
		font-size: 16px;
		font-weight: 500;
		color: #1F2329;
	}

	.expand-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.dept-children {
		margin-top: 16px;
		margin-left: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.2);
	}

	.dept-child {
		flex-direction: row;
		align-items: center;
		margin-bottom: 16px;
		cursor: pointer;
	}

	.dept-child:active {
		opacity: 0.6;
	}

	.dept-child:last-child {
		margin-bottom: 0;
	}

	.child-icon {
		font-size: 16px;
		color: #0ea5e9;
		margin-right: 8px;
	}

	.dept-child-text {
		font-size: 15px;
		color: #646A73;
	}

	.dept-child-active .dept-child-text {
		color: #1F2329;
		font-weight: 500;
	}

	.dept-grandchildren {
		margin-left: 24px;
		margin-top: 8px;
		padding-left: 16px;
		border-left-width: 2px;
		border-left-color: rgba(14,165,233,0.15);
	}

	.member-list {
		background-color: #FFFFFF;
	}

	.member-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.member-item:active {
		background-color: #F2F3F5;
	}

	.member-item-border {
		position: absolute;
		bottom: 0;
		left: 70px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.member-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.member-info {
		flex: 1;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.member-name {
		font-size: 16px;
		font-weight: 400;
		color: #1F2329;
	}

	.member-role {
		font-size: 12px;
		color: #8F959E;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8F959E;
		background-color: #FFFFFF;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

	.selected-text {
		font-size: 15px;
		color: #1F2329;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
