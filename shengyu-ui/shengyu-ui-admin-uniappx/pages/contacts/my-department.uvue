<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg }">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				</view>
				<text class="header-title" :style="{ color: theme.headerText }">我的部门</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input 
					class="search-input" 
					:style="{ color: theme.inputText }"
					v-model="searchKeyword"
					placeholder="搜索" 
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false" @scrolltolower="handleLoadMoreMembers">
			<!-- 部门层级 -->
			<view class="dept-hierarchy">
				<view 
					v-for="dept in deptTree" 
					:key="dept.id"
					class="dept-node-wrapper"
				>
					<!-- 一级部门 -->
					<view class="dept-node" :style="{ backgroundColor: theme.cardBg }" @click="handleDeptNodeClick(dept)">
						<view class="dept-node-content">
							<text v-if="dept.children && dept.children.length > 0" class="iconfont expand-icon-left">
								{{ dept.expanded ? '\ueaf5' : '\ueaf3' }}
							</text>
							<text class="dept-node-text" :style="{ color: theme.textPrimary }">{{ dept.name }}({{ dept.userCount || 0 }})</text>
						</view>
					</view>
					
					<!-- 子部门（递归渲染） -->
					<view v-if="dept.expanded && dept.children && dept.children.length > 0" class="dept-children">
						<view 
							v-for="child in dept.children" 
							:key="child.id"
							class="dept-child-wrapper"
						>
							<view 
								:class="['dept-child', currentDeptId === child.id ? 'dept-child-active' : '']" 
								:style="{ backgroundColor: currentDeptId === child.id ? theme.brandPrimarySoft : theme.cardBg }"
								hover-class="dept-child-hover"
								@click="handleDeptNodeClick(child)"
							>
								<text v-if="child.children && child.children.length > 0" class="iconfont child-icon">
									{{ child.expanded ? '\ueaf5' : '\ueaf3' }}
								</text>
								<text v-else class="child-icon-placeholder"></text>
								<text :class="['dept-child-text', currentDeptId === child.id ? 'dept-child-text-active' : '']" :style="{ color: currentDeptId === child.id ? theme.brandPrimary : theme.textPrimary }">
									{{ child.name }}({{ child.userCount || 0 }})
								</text>
							</view>
							
							<!-- 三级部门 -->
							<view v-if="child.expanded && child.children && child.children.length > 0" class="dept-grandchildren">
								<view 
									v-for="grandchild in child.children" 
									:key="grandchild.id"
									:class="['dept-child', currentDeptId === grandchild.id ? 'dept-child-active' : '']" 
									:style="{ backgroundColor: currentDeptId === grandchild.id ? theme.brandPrimarySoft : theme.cardBg }"
									hover-class="dept-child-hover"
								@click="handleDeptNodeClick(grandchild)"
								>
									<text v-if="grandchild.children && grandchild.children.length > 0" class="iconfont child-icon">
										{{ grandchild.expanded ? '\ueaf5' : '\ueaf3' }}
									</text>
									<text v-else class="child-icon-placeholder"></text>
									<text :class="['dept-child-text', currentDeptId === grandchild.id ? 'dept-child-text-active' : '']" :style="{ color: currentDeptId === grandchild.id ? theme.brandPrimary : theme.textPrimary }">
										{{ grandchild.name }}({{ grandchild.userCount || 0 }})
									</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 成员列表 -->
			<view v-if="memberList.length > 0" class="member-list">
				<view v-for="(member, index) in memberList" :key="member.id" 
					class="member-item"
					:style="{ backgroundColor: theme.cardBg }"
						hover-class="member-item-active"
					@click="handleMemberClick(member)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', member.selected ? 'checkbox-active' : '', (isSingleSelectMode && member.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleMemberSelect(member)">
						<text v-if="member.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
						<image
							v-if="shouldShowAvatar(member)"
							class="member-avatar-image"
							:src="member.avatar"
							mode="aspectFill"
							@error="handleAvatarError(member)"
						/>
						<text v-else class="avatar-text">{{ member.avatarText }}</text>
					</view>
					<view class="member-info">
						<text class="member-name" :style="{ color: theme.textPrimary }">{{ member.name }}</text>
						<text class="member-role" :style="{ color: theme.textSecondary }">{{ member.role }}</text>
					</view>
					<view v-if="index < memberList.length - 1" class="member-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-if="!loading && memberList.length === 0 && currentDeptId !== null" class="empty-state">
				<text class="empty-text" :style="{ color: theme.textTertiary }">暂无成员</text>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textPrimary }">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :style="{ backgroundColor: selectedCount === 0 ? theme.cardBgMuted : theme.brandPrimary }" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount,
		getSelectionLimit
	} from '../../store/group-selection.uts'
	import { getMyDeptTree } from '../../api/dept.uts'
	import { getContactPageByDept } from '../../api/contact.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const safeAreaBottom = ref(0)

	// 部门树数据
	const deptTree = ref<any[]>([])
	
	// 原始部门树数据（用于搜索后恢复）
	const originalDeptTree = ref<any[]>([])
	
	// 当前选中的部门ID
	const currentDeptId = ref<number | null>(null)
	
	// 是否为选择模式
	const isSelectMode = ref(false)
	
	// 加载状态
	const loading = ref(false)
	
	// 成员加载状态
	const loadingMembers = ref(false)
	const memberPageNo = ref(1)
	const memberHasMore = ref(true)
	const memberLoadingMore = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0
	
	// 已加载成员的部门缓存 Map<deptId, members[]>
	const deptMembersCache = new Map<number, any[]>()

	// 成员列表数据（当前选中部门的成员）
	const memberList = ref<any[]>([])
	const lastMemberKeyword = ref('')

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	// 选中的成员数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})
	const isSingleSelectMode = computed(() : boolean => {
		return getSelectionLimit() === 1
	})

	/**
	 * 返回上一页
	 */
	function handleBack() {
		uni.navigateBack()
	}

	/**
	 * 加载我的部门树
	 */
	async function loadDeptList() {
		try {
			loading.value = true
			const data = await getMyDeptTree()
			
			if (data && data.length > 0) {
				// 构建树形结构（不包含用户数据）
				const tree = buildDeptTreeFromPath(data)
				deptTree.value = tree
				
				// 保存原始部门树数据（深拷贝）
				originalDeptTree.value = JSON.parse(JSON.stringify(tree))
				
				// 清空成员列表和缓存
				memberList.value = []
				deptMembersCache.clear()
				currentDeptId.value = null
				memberPageNo.value = 1
				memberHasMore.value = true
				lastMemberKeyword.value = ''
			} else {
				// 没有数据时清空
				deptTree.value = []
				originalDeptTree.value = []
				memberList.value = []
				deptMembersCache.clear()
				memberPageNo.value = 1
				memberHasMore.value = true
				lastMemberKeyword.value = ''
			}
		} catch (e) {
			console.error('[MyDepartment] 加载部门列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
		}
	}

	function extractDeptUserCount(dept: any): number {
		if (dept == null) {
			return 0
		}
		if (isSelectMode.value) {
			const selectable = dept.selectableMemberCount != null ? Number(dept.selectableMemberCount) : NaN
			if (!isNaN(selectable)) {
				return selectable
			}
		}
		const memberCount = dept.memberCount != null ? Number(dept.memberCount) : NaN
		if (!isNaN(memberCount)) {
			return memberCount
		}
		const userCount = dept.userCount != null ? Number(dept.userCount) : NaN
		return !isNaN(userCount) ? userCount : 0
	}

	/**
	 * 从扁平列表构建部门树
	 * 后端返回的是已排序的扁平列表，包含所有相关部门
	 */
	function buildDeptTreeFromPath(pathList: any[]): any[] {
		if (pathList.length === 0) {
			return []
		}
		
		// 创建部门映射表
		const deptMap = new Map<number, any>()
		
		// 第一遍：创建所有节点
		for (let i = 0; i < pathList.length; i++) {
			const dept = pathList[i]
			const node = {
				id: dept.id,
				name: dept.name,
				parentId: dept.parentId,
				sort: dept.sort || 0,
				expanded: false, // 默认收起
				userCount: extractDeptUserCount(dept), // 名片场景优先使用可选人数口径
				children: [] as any[]
			}
			deptMap.set(dept.id, node)
		}
		
		// 第二遍：建立父子关系
		const rootNodes: any[] = []
		for (const [id, node] of deptMap) {
			if (node.parentId === null || node.parentId === 0) {
				// 根节点
				rootNodes.push(node)
			} else {
				// 子节点，添加到父节点的children中
				const parent = deptMap.get(node.parentId)
				if (parent !== null) {
					parent.children.push(node)
				}
			}
		}
		
		// 对每个节点的children按sort排序
		function sortChildren(nodes: any[]) {
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				if (node.children.length > 0) {
					node.children.sort((a: any, b: any) => {
						return a.sort - b.sort
					})
					sortChildren(node.children)
				}
			}
		}
		
		// 对根节点排序
		rootNodes.sort((a: any, b: any) => {
			return a.sort - b.sort
		})
		sortChildren(rootNodes)
		
		// 默认展开第一层
		for (let i = 0; i < rootNodes.length; i++) {
			rootNodes[i].expanded = true
		}
		
		return rootNodes
	}

	/**
	 * 切换部门展开状态
	 */
	function handleDeptNodeClick(dept: any) {
		// 有子部门时允许展开/收起
		if (dept.children && dept.children.length > 0) {
			dept.expanded = !dept.expanded
		}
		// 同时切换当前部门并加载成员
		selectDept(dept)
	}
	function updateDeptCountById(depts: any[], deptId: number, count: number): boolean {
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			if (Number(dept.id) === deptId) {
				dept.userCount = count
				return true
			}
			if (dept.children && dept.children.length > 0) {
				if (updateDeptCountById(dept.children, deptId, count)) {
					return true
				}
			}
		}
		return false
	}

	/**
	 * 选择部门（点击加载成员）
	 */
	async function selectDept(dept: any) {
		currentDeptId.value = dept.id
		loadDeptMembers(dept.id, true)
	}

	/**
	 * 加载部门成员
	 */
	async function loadDeptMembers(deptId: number, reset: boolean, keyword?: string) {
		// 如果缓存中有数据且不是搜索，直接使用缓存
		if (deptMembersCache.has(deptId) && !keyword && !reset) {
			memberList.value = deptMembersCache.get(deptId) || []
			return
		}
		
		try {
			loadingMembers.value = true
			if (reset) {
				memberPageNo.value = 1
				memberHasMore.value = true
			}
			lastMemberKeyword.value = keyword != null ? String(keyword) : ''
			const res = await getContactPageByDept(String(deptId), 1, 20, lastMemberKeyword.value) as any
			const data = res && Array.isArray(res.list) ? res.list : []
			const total = res && res.total != null ? Number(res.total) : data.length
			
			if (data && data.length > 0) {
				const members = data.map((user: any) => {
					const displayName = user.remarkName || user.nickname || '未知'
					return {
						id: String(user.id),
						name: displayName,
						role: user.deptName || '',
						avatar: user.avatar != null ? String(user.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(String(user.id)),
						selected: isMemberSelected(String(user.id))
					}
				})
				
				memberList.value = members
				
				// 缓存非搜索结果
				if (!keyword) {
					deptMembersCache.set(deptId, members)
				}
				memberHasMore.value = memberList.value.length < total
			} else {
				memberList.value = []
				memberHasMore.value = false
			}
			if (!keyword) {
				updateDeptCountById(deptTree.value, deptId, total)
				updateDeptCountById(originalDeptTree.value, deptId, total)
			}
		} catch (e) {
			console.error('[MyDepartment] 加载部门成员失败:', e)
			memberList.value = []
			memberHasMore.value = false
			uni.showToast({
				title: '加载成员失败',
				icon: 'none'
			})
		} finally {
			loadingMembers.value = false
		}
	}
	function handleLoadMoreMembers() {
		try {
			if (memberLoadingMore.value) return
			if (!memberHasMore.value) return
			if (currentDeptId.value == null) return
			memberLoadingMore.value = true
			const nextPage = memberPageNo.value + 1
			Promise.resolve().then(async () => {
				try {
					const res = await getContactPageByDept(String(currentDeptId.value), nextPage, 20, lastMemberKeyword.value) as any
					const data = res && Array.isArray(res.list) ? res.list : []
					const total = res && res.total != null ? Number(res.total) : (memberList.value.length + data.length)
					if (data && data.length > 0) {
						const appended = data.map((user: any) => {
							return {
								id: String(user.id),
								name: user.remarkName || user.nickname || '未知',
								role: user.deptName || '',
								avatar: user.avatar != null ? String(user.avatar) : '',
								avatarError: false,
								avatarText: getAvatarText(user.remarkName || user.nickname || '未知'),
								avatarBg: getUserAvatarColor(String(user.id)),
								selected: isMemberSelected(String(user.id))
							}
						})
						memberList.value = memberList.value.concat(appended)
						memberPageNo.value = nextPage
					}
					memberHasMore.value = memberList.value.length < total
				} catch (e) {
					// ignore
				} finally {
					memberLoadingMore.value = false
				}
			})
		} catch (e) {
			memberLoadingMore.value = false
		}
	}

	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer > 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟500ms执行搜索
		searchTimer = setTimeout(() => {
			if (searchKeyword.value && searchKeyword.value.length > 0) {
				performSearch()
			} else {
				restoreOriginalData()
				if (currentDeptId.value != null) {
					loadDeptMembers(currentDeptId.value, true, '')
				}
			}
		}, 500)
	}
	
	/**
	 * 执行搜索：只显示包含搜索结果的部门和成员
	 */
	async function performSearch() {
		try {
			loadingMembers.value = true
			
			// 递归搜索所有部门
			const filteredTree = await searchAndFilterDepts(originalDeptTree.value, searchKeyword.value)
			
			// 更新显示数据
			deptTree.value = filteredTree
			
			// 如果有搜索结果，自动选中第一个有成员的部门
			const firstDeptWithMembers = findFirstDeptWithMembers(filteredTree)
			if (firstDeptWithMembers !== null) {
				currentDeptId.value = firstDeptWithMembers.id
				memberList.value = firstDeptWithMembers.members || []
			} else {
				currentDeptId.value = null
				memberList.value = []
			}
			
		} catch (e) {
			console.error('[MyDepartment] 搜索失败:', e)
		} finally {
			loadingMembers.value = false
		}
	}
	
	/**
	 * 递归搜索并过滤部门
	 * 只返回包含搜索结果的部门
	 */
	async function searchAndFilterDepts(depts: any[], keyword: string): Promise<any[]> {
		const result: any[] = []
		
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			
			// 搜索当前部门的成员
			const res = await getContactPageByDept(String(dept.id), 1, 200, keyword) as any
			const data = res && Array.isArray(res.list) ? res.list : []
			let members: any[] = []
			if (data && data.length > 0) {
				members = data.map((user: any) => {
					const displayName = user.remarkName || user.nickname || '未知'
					return {
						id: String(user.id),
						name: displayName,
						role: user.deptName || '',
						avatar: user.avatar != null ? String(user.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(displayName),
						avatarBg: getUserAvatarColor(String(user.id)),
						selected: isMemberSelected(String(user.id))
					}
				})
			}
			
			// 递归搜索子部门
			let filteredChildren: any[] = []
			if (dept.children && dept.children.length > 0) {
				filteredChildren = await searchAndFilterDepts(dept.children, keyword)
			}
			
			// 如果当前部门有匹配的成员或子部门有结果，则保留该部门
			if (members.length > 0 || filteredChildren.length > 0) {
				result.push({
					id: dept.id,
					name: dept.name,
					parentId: dept.parentId,
					sort: dept.sort,
					expanded: true, // 搜索结果默认展开
					userCount: members.length,
					children: filteredChildren,
					members: members // 临时保存成员数据用于显示
				})
			}
		}
		
		return result
	}
	/**
	 * 查找第一个有成员的部门
	 */
	function findFirstDeptWithMembers(depts: any[]): any | null {
		for (let i = 0; i < depts.length; i++) {
			const dept = depts[i]
			if (dept.members && dept.members.length > 0) {
				return dept
			}
			if (dept.children && dept.children.length > 0) {
				const found = findFirstDeptWithMembers(dept.children)
				if (found !== null) {
					return found
				}
			}
		}
		return null
	}
	
	/**
	 * 恢复原始数据
	 */
	function restoreOriginalData() {
		// 恢复部门树
		deptTree.value = JSON.parse(JSON.stringify(originalDeptTree.value))
		
		// 清空选中和成员列表
		currentDeptId.value = null
		memberList.value = []
	}

	/**
	 * 切换成员选中状态
	 */
	function toggleMemberSelect(member : any) {
		if (!isSelectMode.value) return
		// 使用全局状态管理
		toggleMember(member)
		// 同步本地状态
		member.selected = isMemberSelected(String(member.id))
		syncSelectionState()
	}

	/**
	 * 处理成员点击
	 */
	function handleMemberClick(member : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleMemberSelect(member)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${member.id}&name=${encodeURIComponent(member.name)}`
			})
		}
	}

	/**
	 * 确认选择
	 */
	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	/**
	 * 同步本地选中状态与全局状态
	 */
	function syncSelectionState() {
		for (let i = 0; i < memberList.value.length; i++) {
			memberList.value[i].selected = isMemberSelected(String(memberList.value[i].id))
		}
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(member: any): boolean {
		return normalizeAvatarUrl(member != null ? member.avatar : '') !== '' && member.avatarError !== true
	}

	function handleAvatarError(member: any): void {
		if (member == null) {
			return
		}
		member.avatarError = true
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载我的部门树
		loadDeptList()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

