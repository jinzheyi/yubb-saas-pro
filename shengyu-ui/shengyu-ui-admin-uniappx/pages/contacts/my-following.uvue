<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				</view>
				<text class="header-title" :style="{ color: theme.headerText }">我的关注</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input 
					class="search-input" 
					:style="{ color: theme.inputText }"
					v-model="searchKeyword"
					placeholder="搜索" 
					placeholder-class="placeholder"
					@input="handleSearch"
				/>
			</view>
		</view>

		<scroll-view 
			class="content" 
			scroll-y="true" 
			show-scrollbar="false"
			@scrolltolower="handleLoadMore"
		>
			<!-- 加载状态 -->
			<view v-if="loading && followingList.length === 0" class="loading-state">
				<text class="loading-text" :style="{ color: theme.textTertiary }">加载中...</text>
			</view>
			
			<!-- 联系人列表 -->
			<view v-else-if="followingList.length > 0" class="contact-list">
				<view v-for="(contact, index) in followingList" :key="contact.id" 
					class="contact-item"
					:style="{ backgroundColor: theme.cardBg }"
					hover-class="contact-item-active" 
					@click="handleContactClick(contact)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', isSingleSelectMode ? 'checkbox-single' : '', contact.selected ? 'checkbox-active' : '', (isSingleSelectMode && contact.selected) ? 'checkbox-single-active' : '']" @click.stop="toggleContactSelect(contact)">
						<text v-if="contact.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="contact-avatar" :style="{ backgroundColor: contact.avatarBg }">
						<image
							v-if="shouldShowAvatar(contact)"
							class="contact-avatar-image"
							:src="contact.avatar"
							mode="aspectFill"
							@error="handleAvatarError(contact)"
						/>
						<text v-else class="avatar-text">{{ contact.avatarText }}</text>
					</view>
					<view class="contact-info">
						<text class="contact-name" :style="{ color: theme.textPrimary }">{{ contact.displayName }}</text>
						<text class="contact-role" :style="{ color: theme.textSecondary }">{{ contact.role }}</text>
					</view>
					<text v-if="!isSelectMode" class="iconfont star-icon" :style="{ color: theme.brandPrimary }">&#xea90;</text>
					<view v-if="index < followingList.length - 1" class="contact-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-else-if="!loading" class="empty-state">
				<text class="empty-text" :style="{ color: theme.textTertiary }">暂无关注的联系人</text>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer" :style="{ paddingBottom: (12 + safeAreaBottom) + 'px', backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
			<text class="selected-text" :style="{ color: theme.textPrimary }">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :style="{ backgroundColor: selectedCount === 0 ? theme.cardBgMuted : theme.brandPrimary }" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount,
		getSelectionLimit
	} from '../../store/group-selection.uts'
	import { getStarContactList, searchContact } from '../../api/contact.uts'
	import { getUserAvatarColor, getAvatarText } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null
	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const safeAreaBottom = ref(0)

	// 是否为选择模式
	const isSelectMode = ref(false)
	
	// 加载状态
	const loading = ref(false)
	
	// 搜索关键词
	const searchKeyword = ref('')
	
	// 搜索定时器
	let searchTimer: number = 0
	
	// 原始关注列表（用于搜索后恢复）
	const originalFollowingList = ref<any[]>([])

	// 关注列表数据
	const followingList = ref<any[]>([])

	// 选中的联系人数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})
	const isSingleSelectMode = computed(() : boolean => {
		return getSelectionLimit() === 1
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})

	/**
	 * 返回上一页
	 */
	function handleBack() {
		uni.navigateBack()
	}
	
	/**
	 * 加载关注列表
	 */
	async function loadFollowingList() {
		try {
			loading.value = true
			const data = await getStarContactList()
			
			if (data && data.length > 0) {
				const contacts = data.map((contact: any) => {
					return {
						id: contact.id,
						nickname: contact.nickname,
						displayName: contact.nickname, // 直接使用昵称
						role: contact.postName || '未设置岗位',
						deptName: contact.deptName || '',
						avatar: contact.avatar != null ? String(contact.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(contact.nickname),
						avatarBg: getUserAvatarColor(contact.id),
						star: contact.star,
						selected: isMemberSelected(String(contact.id))
					}
				})
				
				followingList.value = contacts
				// 保存原始数据（深拷贝）
				originalFollowingList.value = JSON.parse(JSON.stringify(contacts))
			} else {
				followingList.value = []
				originalFollowingList.value = []
			}
		} catch (e) {
			console.error('[MyFollowing] 加载关注列表失败:', e)
			uni.showToast({
				title: '加载失败',
				icon: 'none'
			})
			followingList.value = []
			originalFollowingList.value = []
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 处理搜索
	 */
	function handleSearch() {
		// 清除之前的定时器
		if (searchTimer !== 0) {
			clearTimeout(searchTimer)
		}
		
		// 延迟500ms执行搜索
		searchTimer = setTimeout(() => {
			if (searchKeyword.value && searchKeyword.value.length > 0) {
				// 执行搜索
				performSearch()
			} else {
				// 清空搜索时，恢复原始数据
				restoreOriginalData()
			}
		}, 500)
	}
	
	/**
	 * 执行搜索
	 */
	async function performSearch() {
		try {
			loading.value = true
			const data = await searchContact(searchKeyword.value)

			const list = Array.isArray(data) ? data : (data && Array.isArray(data.list) ? data.list : [])
			if (list.length > 0) {
				// 只显示星标联系人
				const starContacts = list.filter((contact: any) => contact.star === true)
				
				const contacts = starContacts.map((contact: any) => {
					return {
						id: contact.id,
						nickname: contact.nickname,
						displayName: contact.nickname, // 直接使用昵称
						role: contact.postName || '未设置岗位',
						deptName: contact.deptName || '',
						avatar: contact.avatar != null ? String(contact.avatar) : '',
						avatarError: false,
						avatarText: getAvatarText(contact.nickname),
						avatarBg: getUserAvatarColor(contact.id),
						star: contact.star,
						selected: isMemberSelected(String(contact.id))
					}
				})
				
				followingList.value = contacts
			} else {
				followingList.value = []
			}
		} catch (e) {
			console.error('[MyFollowing] 搜索失败:', e)
			uni.showToast({
				title: '搜索失败',
				icon: 'none'
			})
			followingList.value = []
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 恢复原始数据
	 */
	function restoreOriginalData() {
		followingList.value = JSON.parse(JSON.stringify(originalFollowingList.value))
	}
	
	/**
	 * 加载更多（预留接口，当前使用星标联系人API，无分页）
	 */
	function handleLoadMore() {
		// 星标联系人通常数量不多，暂不实现分页
		// 如果后续需要分页，可以在这里实现
	}

	/**
	 * 切换联系人选中状态
	 */
	function toggleContactSelect(contact : any) {
		// 使用全局状态管理
		toggleMember(contact)
		// 同步本地状态
		contact.selected = isMemberSelected(String(contact.id))
		syncSelectionState()
	}

	/**
	 * 处理联系人点击
	 */
	function handleContactClick(contact : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleContactSelect(contact)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${contact.id}&name=${encodeURIComponent(contact.displayName)}`
			})
		}
	}

	/**
	 * 确认选择
	 */
	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	/**
	 * 同步本地选中状态与全局状态
	 */
	function syncSelectionState() {
		for (let i = 0; i < followingList.value.length; i++) {
			followingList.value[i].selected = isMemberSelected(String(followingList.value[i].id))
		}
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(item: any): boolean {
		return normalizeAvatarUrl(item != null ? item.avatar : '') !== '' && item.avatarError !== true
	}

	function handleAvatarError(item: any): void {
		if (item == null) {
			return
		}
		item.avatarError = true
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		safeAreaBottom.value = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		
		// 加载关注列表
		loadFollowingList()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		} else {
			// 非选择模式下，每次显示都重新加载列表（以防用户在详情页取消关注）
			loadFollowingList()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		font-size: 24px;
	}

	.header-title {
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.placeholder {
		color: #A7AFB9;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.loading-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.loading-text {
		font-size: 14px;
	}
	
	.empty-state {
		padding: 60px 0;
		justify-content: center;
		align-items: center;
	}
	
	.empty-text {
		font-size: 14px;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		position: relative;
	}

	.contact-item-active {
		background-color: rgba(143, 149, 158, 0.12);
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 70px;
		right: 0;
		height: 1px;
	}

	.contact-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.contact-avatar-image {
		width: 42px;
		height: 42px;
		border-radius: 8px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 16px;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.contact-role {
		font-size: 12px;
	}

	.star-icon {
		color: #1677FF;
		font-size: 20px;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8893A2;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.checkbox-single {
		border-radius: 11px;
	}

	.checkbox-single-active {
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		border-top-width: 0.5px;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 12px;
	}

	.selected-text {
		font-size: 15px;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
