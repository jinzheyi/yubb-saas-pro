<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon">&#xeb04;</text>
				</view>
				<text class="header-title">我的关注</text>
				<view class="header-right"></view>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" placeholder="搜索" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<view class="contact-list">
				<view v-for="(contact, index) in followingList" :key="contact.id" 
					class="contact-item" 
					@click="handleContactClick(contact)">
					<!-- 选择模式下显示复选框 -->
					<view v-if="isSelectMode" :class="['checkbox', contact.selected ? 'checkbox-active' : '']" @click.stop="toggleContactSelect(contact)">
						<text v-if="contact.selected" class="iconfont check-icon">&#xea73;</text>
					</view>
					
					<view class="contact-avatar" :style="{ backgroundColor: contact.avatarBg }">
						<text class="avatar-text">{{ contact.avatarText }}</text>
					</view>
					<view class="contact-info">
						<text class="contact-name">{{ contact.name }}</text>
						<text class="contact-role">{{ contact.role }}</text>
					</view>
					<text v-if="!isSelectMode" class="iconfont star-icon">&#xea90;</text>
					<view v-if="index < followingList.length - 1" class="contact-item-border"></view>
				</view>
			</view>
		</scroll-view>

		<!-- 选择模式下显示底部操作栏 -->
		<view v-if="isSelectMode" class="footer">
			<text class="selected-text">已选择 {{ selectedCount }} 人</text>
			<button class="confirm-btn" :disabled="selectedCount === 0" @click="handleConfirm">
				<text class="confirm-btn-text">确定</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { 
		isMemberSelected, 
		toggleMember,
		getSelectedCount
	} from '../../store/group-selection.uts'

	const { t } = useI18n()

	// 是否为选择模式
	const isSelectMode = ref(false)

	// 关注列表数据（ID范围：2001-2007，避免与其他页面冲突）
	const followingList = ref([
		{
			id: 2001,
			name: '张敏',
			role: '开发工程师',
			avatarText: '张敏',
			avatarBg: '#0ea5e9',
			selected: false
		},
		{
			id: 2002,
			name: '李强',
			role: '产品经理',
			avatarText: '李强',
			avatarBg: '#f97316',
			selected: false
		},
		{
			id: 2003,
			name: '王静',
			role: '高级UI设计师',
			avatarText: '王静',
			avatarBg: '#10b981',
			selected: false
		},
		{
			id: 2004,
			name: '刘伟',
			role: '技术总监',
			avatarText: '刘伟',
			avatarBg: '#6366f1',
			selected: false
		},
		{
			id: 2005,
			name: '陈佳',
			role: '人力资源主管',
			avatarText: '陈佳',
			avatarBg: '#fb7185',
			selected: false
		},
		{
			id: 2006,
			name: '赵军',
			role: '架构师',
			avatarText: '赵军',
			avatarBg: '#8b5cf6',
			selected: false
		},
		{
			id: 2007,
			name: '孙丽',
			role: '测试经理',
			avatarText: '孙丽',
			avatarBg: '#ec4899',
			selected: false
		}
	])

	// 选中的联系人数量（使用全局状态）
	const selectedCount = computed(() : number => {
		return getSelectedCount()
	})

	function handleBack() {
		uni.navigateBack()
	}

	function toggleContactSelect(contact : any) {
		// 使用全局状态管理
		toggleMember(contact)
		// 同步本地状态
		contact.selected = isMemberSelected(contact.id)
	}

	function handleContactClick(contact : any) {
		if (isSelectMode.value) {
			// 选择模式下点击整行也可以切换选中状态
			toggleContactSelect(contact)
		} else {
			// 普通模式下跳转到用户详情页面
			uni.navigateTo({
				url: `/pages/contacts/user-detail?userId=${contact.id}&name=${encodeURIComponent(contact.name)}`
			})
		}
	}

	function handleConfirm() {
		// 返回上一页，选中的数据保留在全局状态中
		uni.navigateBack()
	}

	// 同步本地选中状态与全局状态
	function syncSelectionState() {
		for (let i = 0; i < followingList.value.length; i++) {
			followingList.value[i].selected = isMemberSelected(followingList.value[i].id)
		}
	}

	// 页面加载时检查是否为选择模式
	onLoad((options : any) => {
		if (options != null && options['mode'] === 'select') {
			isSelectMode.value = true
		}
		// 同步选中状态
		syncSelectionState()
	})

	// 页面显示时同步选中状态（从其他页面返回时）
	onShow(() => {
		if (isSelectMode.value) {
			syncSelectionState()
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 60px;
	}

	.back-icon {
		color: #1F2329;
		font-size: 24px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	.header-right {
		width: 60px;
	}

	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.contact-list {
		background-color: #FFFFFF;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.contact-item:active {
		background-color: #F2F3F5;
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 70px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.contact-avatar {
		width: 42px;
		height: 42px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 16px;
		font-weight: 400;
		color: #1F2329;
		margin-bottom: 2px;
	}

	.contact-role {
		font-size: 12px;
		color: #8F959E;
	}

	.star-icon {
		color: #1677FF;
		font-size: 20px;
	}

	.checkbox {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		border-width: 2px;
		border-color: #8F959E;
		background-color: #FFFFFF;
		margin-right: 12px;
		justify-content: center;
		align-items: center;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
		box-shadow: 0 0 0 1px rgba(22, 119, 255, 0.2);
	}

	.check-icon {
		color: #ffffff;
		font-size: 16px;
	}

	.footer {
		background-color: #ffffff;
		border-top-width: 0.5px;
		border-top-color: #EFF0F1;
		padding: 12px 16px;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
	}

	.selected-text {
		font-size: 15px;
		color: #1F2329;
	}

	.confirm-btn {
		background-color: #1677FF;
		padding: 0 20px;
		height: 36px;
		border-radius: 6px;
		justify-content: center;
		border-width: 0;
	}

	.confirm-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 500;
	}
</style>
