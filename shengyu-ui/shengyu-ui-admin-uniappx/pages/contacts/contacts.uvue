<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<text class="header-title">{{ t('contacts.title') }}</text>
			</view>
			<view class="search-bar" @click="handleSearch">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" disabled />
			</view>
		</view>

		<scroll-view 
			class="content" 
			scroll-y="true" 
			show-scrollbar="false"
			:scroll-into-view="scrollTarget"
			scroll-with-animation="true"
		>
			<!-- 分类列表 -->
			<view class="category-group">
				<view class="category-item" v-for="(item, index) in categories1" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories1.length - 1" class="category-item-border"></view>
				</view>
			</view>

			<view class="section-divider"></view>

			<view class="category-group">
				<view class="category-item" v-for="(item, index) in categories2" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories2.length - 1" class="category-item-border"></view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view v-for="(group, groupIndex) in groupedContacts" :key="groupIndex">
				<view class="section-header" :id="'group-' + group.letter">
					<text class="section-title">{{ group.letter }}</text>
				</view>
				<view class="contact-list">
					<view class="contact-item" v-for="(item, index) in group.contacts" :key="index" @click="handleContact(item)">
						<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
							<text class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name">{{ item.name }}</text>
							<text class="contact-role">{{ item.role }}</text>
						</view>
						<view v-if="index < group.contacts.length - 1" class="contact-item-border"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 右侧字母索引 -->
		<view class="index-bar">
			<text 
				v-for="letter in indexList" 
				:key="letter" 
				class="index-item"
				@click="scrollToGroup(letter)"
			>
				{{ letter }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getContactList } from '../../api/contact.uts'

	const { t } = useI18n()

	const scrollTarget = ref('')
	const loading = ref(false)
	const rawContacts = ref<any[]>([])

	const categories1 = [
		{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' }
	]

	const categories2 = [
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	const colors = ['#0ea5e9', '#f472b6', '#c084fc', '#fb7185', '#10b981', '#f59e0b', '#ec4899', '#ef4444', '#3b82f6', '#8b5cf6']
	
	/**
	 * 获取拼音首字母
	 */
	function getPinyinFirstLetter(name : string) : string {
		// 简单实现：取第一个字符的 Unicode 编码判断
		// 实际项目中应使用专业的拼音库
		const code = name.charCodeAt(0)
		if (code >= 19968 && code <= 40869) {
			// 中文字符，简单映射到 A-Z
			const index = (code - 19968) % 26
			return String.fromCharCode(65 + index)
		}
		// 非中文字符，取首字母大写
		return name.charAt(0).toUpperCase()
	}
	
	/**
	 * 加载联系人列表
	 */
	async function loadContacts() {
		loading.value = true
		
		try {
			const res = await getContactList()
			
			if (res.code === 0 && res.data) {
				const contacts = res.data as any[]
				
				// 转换为 UI 格式
				rawContacts.value = contacts.map((contact, index) => {
					const userName = contact.userName || contact.nickname || '未知'
					return {
						id: contact.id,
						userId: contact.userId,
						name: userName,
						role: contact.deptName || contact.postNames || '',
						avatarText: userName.substring(0, 2),
						avatarBg: colors[index % colors.length],
						pinyin: getPinyinFirstLetter(userName)
					}
				})
			}
			
		} catch (e) {
			console.error('[Contacts] 加载联系人列表失败:', e)
			uni.showToast({ title: '加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}
	
	/**
	 * 页面加载时获取联系人列表
	 */
	onMounted(() => {
		loadContacts()
	})

	// 按字母分组
	type ContactGroup = {
		letter: string,
		contacts: any[]
	}

	const groupedContacts = computed(() : ContactGroup[] => {
		const groups : ContactGroup[] = []
		const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
		
		letters.forEach(letter => {
			const filtered = rawContacts.value.filter(c => c.pinyin === letter)
			if (filtered.length > 0) {
				groups.push({
					letter: letter,
					contacts: filtered.sort((a, b) => a.name.localeCompare(b.name))
				})
			}
		})
		return groups
	})

	const indexList = computed(() : string[] => {
		return groupedContacts.value.map((g : ContactGroup) : string => g.letter)
	})

	function scrollToGroup(letter : string) {
		scrollTarget.value = 'group-' + letter
		// 重置 scrollTarget 以允许重复点击同一字母
		setTimeout(() => {
			scrollTarget.value = ''
		}, 100)
	}

	function handleCategory(item : any) {
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/my-groups'
			})
		} else if (item.nameKey === 'contacts.following') {
			uni.navigateTo({
				url: '/pages/contacts/my-following'
			})
		} else if (item.nameKey === 'contacts.org') {
			uni.navigateTo({
				url: '/pages/contacts/organization'
			})
		} else if (item.nameKey === 'contacts.dept') {
			uni.navigateTo({
				url: '/pages/contacts/my-department'
			})
		} else {
			uni.showToast({
				title: t(item.nameKey) + '功能开发中',
				icon: 'none'
			})
		}
	}

	function handleContact(item : any) {
		uni.navigateTo({
			url: '/pages/message/chat?name=' + item.name
		})
	}

	/**
	 * 搜索
	 */
	function handleSearch() {
		uni.navigateTo({
			url: '/pages/common/search'
		})
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	/* 头部区域 - 扁平化风格 */
	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	/* 搜索栏 - 浅灰色扁平风格 */
	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.category-group {
		background-color: #FFFFFF;
		padding-top: 4px;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.category-item:active {
		background-color: #F2F3F5;
	}

	.category-item-border {
		position: absolute;
		bottom: 0;
		left: 64px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #FFFFFF;
		font-size: 20px;
	}

	.category-name {
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
	}

	.mt-2 {
		margin-top: 8px;
	}

	.section-divider {
		height: 8px;
		background-color: #F5F7FA;
	}

	/* 分组标题 */
	.section-header {
		padding: 8px 16px;
		background-color: #F5F7FA;
	}

	.section-title {
		font-size: 12px;
		color: #8F959E;
		font-weight: 600;
	}

	.contact-list {
		background-color: #FFFFFF;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.contact-item:active {
		background-color: #F2F3F5;
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 68px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.contact-role {
		font-size: 12px;
		color: #8F959E;
	}

	/* 右侧索引栏 */
	.index-bar {
		position: absolute;
		right: 4px;
		top: 50%;
		transform: translateY(-40%);
		z-index: 10;
		align-items: center;
	}

	.index-item {
		font-size: 10px;
		color: #1F2329;
		padding: 2px 4px;
		font-weight: 600;
	}
</style>