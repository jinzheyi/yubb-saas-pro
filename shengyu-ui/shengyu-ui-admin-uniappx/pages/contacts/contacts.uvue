		color: #ffffff;
		font-size: 20px;
		font-weight: bold;
	}

	.search-bar {
		background-color: #ffffff;
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 8px;
	}

	.search-icon {
		font-size: 16px;
		color: #999999;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #333333;
	}

	.placeholder {
		color: #999999;
	}

	.content {
		flex: 1;
	}

	.category-group {
		background-color: #ffffff;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #f0f0f0;
	}

	.category-icon-wrap {
		width: 40px;
		height: 40px;
		border-radius: 20px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #ffffff;
		font-size: 20px;
	}

	.category-name {
		font-size: 16px;
		color: #333333;
		font-weight: 500;
	}

	.mt-2 {
		margin-top: 8px;
	}

	.section-header {
		padding: 12px 16px;
	}

	.section-title {
		font-size: 12px;
		color: #999999;
		text-transform: uppercase;
	}

	.contact-list {
		background-color: #ffffff;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 0.5px;
		border-bottom-color: #f0f0f0;
	}

	.contact-avatar {
		width: 48px;
		height: 48px;
		border-radius: 24px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #ffffff;
		font-size: 14px;
		font-weight: bold;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
