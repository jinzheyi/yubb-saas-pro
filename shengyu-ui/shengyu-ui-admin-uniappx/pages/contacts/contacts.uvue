<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-top">
				<text class="header-title" :style="{ color: theme.headerText }">{{ t('contacts.title') }}</text>
			</view>
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }" @click="handleSearch">&#xea6e;</text>
				<input class="search-input" :style="{ color: theme.inputText }" v-model="listSearchKeyword" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" confirm-type="search" @confirm="handleSearch" />
				<text v-if="listSearchKeyword !== ''" class="iconfont search-clear" :style="{ color: theme.textTertiary }" @click="clearLocalSearch">&#xea73;</text>
			</view>
		</view>

		<scroll-view 
			class="content"
			:style="{ backgroundColor: theme.pageBg }"
			scroll-y="true" 
			show-scrollbar="false"
			:scroll-into-view="scrollTarget"
			scroll-with-animation="true"
		>
			<!-- 分类列表 -->
			<view class="category-group" :style="{ backgroundColor: theme.cardBg }">
				<view class="category-item" :style="{ backgroundColor: theme.cardBg }" hover-class="category-item-active" v-for="(item, index) in categories1" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
						<view v-if="item.badgeCount > 0" class="category-dot"></view>
					</view>
					<text class="category-name" :style="{ color: theme.textPrimary }">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories1.length - 1" class="category-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>

			<view class="section-divider" :style="{ backgroundColor: theme.pageBg }"></view>

			<view class="category-group" :style="{ backgroundColor: theme.cardBg }">
				<view class="category-item" :style="{ backgroundColor: theme.cardBg }" hover-class="category-item-active" v-for="(item, index) in categories2" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name" :style="{ color: theme.textPrimary }">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories2.length - 1" class="category-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view v-for="(group, groupIndex) in groupedContacts" :key="groupIndex">
				<view class="section-header" :id="'group-' + group.letter" :style="{ backgroundColor: theme.pageBg }">
					<text class="section-title" :style="{ color: theme.textTertiary }">{{ group.letter }}</text>
				</view>
				<view class="contact-list" :style="{ backgroundColor: theme.cardBg }">
					<view class="contact-item" :style="{ backgroundColor: theme.cardBg }" hover-class="contact-item-active" v-for="(item, index) in group.contacts" :key="index" @click="handleContact(item)">
						<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
							<image
								v-if="shouldShowAvatar(item)"
								class="contact-avatar-image"
								:src="item.avatar"
								mode="aspectFill"
								@error="handleAvatarError(item)"
							/>
							<text v-else class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name" :style="{ color: theme.textPrimary }">{{ item.name }}</text>
							<text class="contact-role" :style="{ color: theme.textSecondary }">{{ item.role }}</text>
						</view>
						<view v-if="index < group.contacts.length - 1" class="contact-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 右侧字母索引 -->
		<view class="index-bar">
			<text 
				v-for="letter in indexList" 
				:key="letter" 
				class="index-item"
				:style="{ color: theme.textPrimary }"
				@click="scrollToGroup(letter)"
			>
				{{ letter }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getContactList } from '../../api/contact.uts'
	import { badgeService, type BadgeData, type BadgeListener } from '../../services/badge-service.uts'
	import { tabBarBadgeService } from '../../services/tab-bar-badge-service.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const CONTACTS_GROUP_JOIN_REQUEST_MENU_ID = 'contactsGroupJoinRequest'

	const { t } = useI18n()

	const scrollTarget = ref('')
	const loading = ref(false)
	const rawContacts = ref<any[]>([])
	const listSearchKeyword = ref('')
	const contactsPendingCount = ref(0)
	const theme = ref<ThemeTokens>(getThemeTokens())

	const categories1 = computed(() : any[] => {
		return [
			{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups', badgeCount: contactsPendingCount.value },
			{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following', badgeCount: 0 }
		]
	})

	const categories2 = [
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	const colors = ['#0ea5e9', '#f472b6', '#c084fc', '#fb7185', '#10b981', '#f59e0b', '#ec4899', '#ef4444', '#3b82f6', '#8b5cf6']

	let badgeListener: BadgeListener | null = null
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	function applyBadgeData(badgeData: BadgeData | null): void {
		if (badgeData == null) {
			contactsPendingCount.value = 0
			return
		}
		contactsPendingCount.value = badgeData.menuBadges.get(CONTACTS_GROUP_JOIN_REQUEST_MENU_ID) || 0
	}
	
	/**
	 * 获取拼音首字母
	 */
	function getPinyinFirstLetter(name : string) : string {
		// 简单实现：取第一个字符的 Unicode 编码判断
		// 实际项目中应使用专业的拼音库
		const code = name.charCodeAt(0)
		if (code >= 19968 && code <= 40869) {
			// 中文字符，简单映射到 A-Z
			const index = (code - 19968) % 26
			return String.fromCharCode(65 + index)
		}
		// 非中文字符，取首字母大写
		return name.charAt(0).toUpperCase()
	}
	
	/**
	 * 加载联系人列表
	 */
	async function loadContacts() {
		console.log('[Contacts] 开始加载联系人列表')
		loading.value = true
		
		try {
			// request 函数在成功时直接返回 data.data，失败时 reject
			const contacts = await getContactList() as any[]
			console.log('[Contacts] 联系人数量:', contacts.length)
			
			if (contacts.length === 0) {
				console.warn('[Contacts] 联系人列表为空')
				uni.showToast({ title: t('contactsHome.empty'), icon: 'none' })
				return
			}
			
			// 打印第一个联系人的数据结构
			if (contacts.length > 0) {
				const firstContact = contacts[0]
				console.log('[Contacts] 第一个联系人数据:')
				console.log('  - id:', firstContact.id)
				console.log('  - nickname:', firstContact.nickname)
				console.log('  - remarkName:', firstContact.remarkName)
				console.log('  - deptName:', firstContact.deptName)
				console.log('  - pinyin:', firstContact.pinyin)
			}
			
			// 转换为 UI 格式
			rawContacts.value = contacts.map((contact, index) => {
				// 优先使用 remarkName（备注名），其次使用 nickname（昵称）
				const displayName = contact.remarkName || contact.nickname || t('contactsHome.unknownUser')
				const userIdStr = contact.id != null ? contact.id.toString() : '0'
				// 使用后端返回的拼音首字母（取第一个字符）
				let pinyinLetter = contact.pinyin || getPinyinFirstLetter(displayName)
				// 如果后端返回的是多字符拼音（如 "SY"），只取第一个字符
				if (pinyinLetter.length > 1) {
					pinyinLetter = pinyinLetter.charAt(0)
				}
				
				return {
					id: userIdStr,
					userId: userIdStr,
					name: displayName,
					role: contact.deptName || '',
					avatar: contact.avatar != null ? String(contact.avatar) : '',
					avatarError: false,
					avatarText: getAvatarText(displayName),
					avatarBg: getUserAvatarColor(userIdStr),
					pinyin: pinyinLetter
				}
			})
			
			console.log('[Contacts] 处理后的联系人数量:', rawContacts.value.length)
			if (rawContacts.value.length > 0) {
				console.log('[Contacts] 第一个处理后的联系人:', JSON.stringify(rawContacts.value[0]))
			}
			console.log('[Contacts] 分组后的联系人数量:', groupedContacts.value.length)
			if (groupedContacts.value.length > 0) {
				console.log('[Contacts] 第一个分组:', JSON.stringify(groupedContacts.value[0]))
			}
			
		} catch (e) {
			console.error('[Contacts] 加载联系人列表异常:', e)
			// e 可能是包含 msg 的错误对象
			const errorMsg = (e as any).msg || t('contactsHome.loadFailed')
			uni.showToast({ title: errorMsg, icon: 'none' })
		} finally {
			loading.value = false
			console.log('[Contacts] 加载完成')
		}
	}
	
	/**
	 * 页面加载时获取联系人列表
	 */
	onMounted(() => {
		contactsPendingCount.value = badgeService.getMenuBadge(CONTACTS_GROUP_JOIN_REQUEST_MENU_ID)
		badgeListener = {
			onBadgeUpdate: (badgeData: BadgeData): void => {
				applyBadgeData(badgeData)
			}
		}
		badgeService.addListener(badgeListener)
		loadContacts()
	})

	onShow(() => {
		tabBarBadgeService.refresh()
		badgeService.ensureFresh(2000)
		contactsPendingCount.value = badgeService.getMenuBadge(CONTACTS_GROUP_JOIN_REQUEST_MENU_ID)
	})

	onUnmounted(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
		if (badgeListener != null) {
			badgeService.removeListener(badgeListener)
			badgeListener = null
		}
	})

	// 按字母分组
	type ContactGroup = {
		letter: string,
		contacts: any[]
	}

	const groupedContacts = computed(() : ContactGroup[] => {
		const groups : ContactGroup[] = []
		const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
		const keyword = listSearchKeyword.value != null ? String(listSearchKeyword.value).trim().toLowerCase() : ''
		const sourceList = keyword === ''
			? rawContacts.value
			: rawContacts.value.filter(c => {
				const name = c != null && c.name != null ? String(c.name).toLowerCase() : ''
				const role = c != null && c.role != null ? String(c.role).toLowerCase() : ''
				return name.indexOf(keyword) >= 0 || role.indexOf(keyword) >= 0
			})
		
		letters.forEach(letter => {
			const filtered = sourceList.filter(c => c.pinyin === letter)
			if (filtered.length > 0) {
				groups.push({
					letter: letter,
					contacts: filtered.sort((a, b) => a.name.localeCompare(b.name))
				})
			}
		})
		return groups
	})

	const indexList = computed(() : string[] => {
		return groupedContacts.value.map((g : ContactGroup) : string => g.letter)
	})

	function scrollToGroup(letter : string) {
		scrollTarget.value = 'group-' + letter
		// 重置 scrollTarget 以允许重复点击同一字母
		setTimeout(() => {
			scrollTarget.value = ''
		}, 100)
	}

	function handleCategory(item : any) {
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/my-groups'
			})
		} else if (item.nameKey === 'contacts.following') {
			uni.navigateTo({
				url: '/pages/contacts/my-following'
			})
		} else if (item.nameKey === 'contacts.org') {
			uni.navigateTo({
				url: '/pages/contacts/organization'
			})
		} else if (item.nameKey === 'contacts.dept') {
			uni.navigateTo({
				url: '/pages/contacts/my-department'
			})
		} else {
			uni.showToast({
				title: t('contactsHome.inDevelopment', { name: t(item.nameKey) }),
				icon: 'none'
			})
		}
	}

	function handleContact(item : any) {
		// 跳转到联系人详情页面
		uni.navigateTo({
			url: `/pages/contacts/user-detail?userId=${item.id}&name=${encodeURIComponent(item.name)}`
		})
	}

	/**
	 * 搜索
	 */
	function clearLocalSearch() {
		listSearchKeyword.value = ''
	}

	function handleSearch() {
		const kw = listSearchKeyword.value != null ? String(listSearchKeyword.value).trim() : ''
		const query = kw !== '' ? `?keyword=${encodeURIComponent(kw)}` : ''
		uni.navigateTo({
			url: '/pages/common/search' + query
		})
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(item: any): boolean {
		return normalizeAvatarUrl(item != null ? item.avatar : '') !== '' && item.avatarError !== true
	}

	function handleAvatarError(item: any): void {
		if (item == null) {
			return
		}
		item.avatarError = true
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	/* 头部区域 - 扁平化风格 */
	.header {
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-title {
		font-size: 20px;
		font-weight: 600;
	}

	/* 搜索栏 - 浅灰色扁平风格 */
	.search-bar {
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
	}

	.search-clear {
		font-size: 16px;
		padding-left: 8px;
	}

	.placeholder {
		color: #A7AFB9;
	}

	.content {
		flex: 1;
		height: 0;
	}

	.category-group {
		padding-top: 4px;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		position: relative;
	}

	.category-item-active {
		background-color: rgba(143, 149, 158, 0.12);
	}

	.category-item-border {
		position: absolute;
		bottom: 0;
		left: 64px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		position: relative;
	}

	.category-dot {
		position: absolute;
		top: -2px;
		right: -2px;
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background-color: #F04438;
		border-width: 1.5px;
		border-color: #FFFFFF;
	}

	.category-icon {
		color: #FFFFFF;
		font-size: 20px;
	}

	.category-name {
		font-size: 16px;
		font-weight: 400;
	}

	.mt-2 {
		margin-top: 8px;
	}

	.section-divider {
		height: 8px;
	}

	/* 分组标题 */
	.section-header {
		padding: 8px 16px;
	}

	.section-title {
		font-size: 12px;
		font-weight: 600;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		position: relative;
	}

	.contact-item-active {
		background-color: rgba(143, 149, 158, 0.12);
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 68px;
		right: 0;
		height: 1px;
		background-color: #F0F0F0;
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.contact-avatar-image {
		width: 40px;
		height: 40px;
		border-radius: 8px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 16px;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.contact-role {
		font-size: 12px;
	}

	/* 右侧索引栏 */
	.index-bar {
		position: absolute;
		right: 4px;
		top: 50%;
		transform: translateY(-40%);
		z-index: 10;
		align-items: center;
	}

	.index-item {
		font-size: 10px;
		color: #F3F6FA;
		padding: 2px 4px;
		font-weight: 600;
	}
</style>
