<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<text class="header-title">{{ t('contacts.title') }}</text>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true">
			<!-- 分类列表 -->
			<view class="category-group">
				<view class="category-item" v-for="(item, index) in categories1" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>

			<view class="category-group mt-2">
				<view class="category-item" v-for="(item, index) in categories2" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
				</view>
			</view>

			<!-- 常用联系人 -->
			<view class="section-header">
				<text class="section-title">{{ t('contacts.commonContacts') }}</text>
			</view>
			<view class="contact-list">
				<view class="contact-item" v-for="(item, index) in commonContacts" :key="index" @click="handleContact(item)">
					<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
						<text class="avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="contact-info">
						<text class="contact-name">{{ item.name }}</text>
						<text class="contact-role">{{ item.role }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const categories1 = [
		{ icon: '\uea94', bg: '#f97316', nameKey: 'contacts.mobile' },
		{ icon: '\uea94', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' }
	]

	const categories2 = [
		{ icon: '\uea8c', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\uea84', bg: '#06b6d4', nameKey: 'contacts.dept' },
		{ icon: '\uea96', bg: '#3b82f6', nameKey: 'contacts.commonGroups' },
		{ icon: '\uea97', bg: '#6366f1', nameKey: 'contacts.subordinates' }
	]

	const commonContacts = [
		{ name: '陶戈', role: '高级经理', avatarText: '陶戈', avatarBg: '#0ea5e9' },
		{ name: '陈子蒙', role: '部门副总经理 (主持工作)', avatarText: '子蒙', avatarBg: '#f472b6' },
		{ name: '刘丹丹', role: '行政经理', avatarText: '丹丹', avatarBg: '#c084fc' },
		{ name: '胡婷', role: '副部长 (主持工作)', avatarText: '胡婷', avatarBg: '#fb7185' },
		{ name: '朱述勇', role: '开发工程师', avatarText: '述勇', avatarBg: '#10b981' }
	]

	function handleCategory(item : any) {
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/initiate-group'
			})
		} else {
			uni.showToast({
				title: t(item.nameKey) + '功能开发中',
				icon: 'none'
			})
		}
	}

	function handleContact(item : any) {
		uni.navigateTo({
			url: '/pages/message/chat?name=' + item.name
		})
	}
</script>

<style>
	.page {
		flex: 1;
		background-color: #F7F7F7;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #1677FF;
	}

