<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<view class="header-top">
				<text class="header-title">{{ t('contacts.title') }}</text>
			</view>
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" :placeholder="t('message.searchPlaceholder')" placeholder-class="placeholder" />
			</view>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 分类列表 -->
			<view class="category-group">
				<view class="category-item" v-for="(item, index) in categories1" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories1.length - 1" class="category-item-border"></view>
				</view>
			</view>

			<view class="category-group mt-2">
				<view class="category-item" v-for="(item, index) in categories2" :key="index" @click="handleCategory(item)">
					<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
						<text class="iconfont category-icon">{{ item.icon }}</text>
					</view>
					<text class="category-name">{{ t(item.nameKey) }}</text>
					<view v-if="index < categories2.length - 1" class="category-item-border"></view>
				</view>
			</view>

			<!-- 联系人 -->
			<view class="section-header">
				<text class="section-title">{{ t('contacts.commonContacts') }}</text>
			</view>
			<view class="contact-list">
				<view class="contact-item" v-for="(item, index) in commonContacts" :key="index" @click="handleContact(item)">
					<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
						<text class="avatar-text">{{ item.avatarText }}</text>
					</view>
					<view class="contact-info">
						<text class="contact-name">{{ item.name }}</text>
						<text class="contact-role">{{ item.role }}</text>
					</view>
					<view v-if="index < commonContacts.length - 1" class="contact-item-border"></view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const categories1 = [
		{ icon: '\ue692', bg: '#f97316', nameKey: 'contacts.mobile' },
		{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' }
	]

	const categories2 = [
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	const commonContacts = [
		{ name: '陶戈', role: '高级经理', avatarText: '陶戈', avatarBg: '#0ea5e9' },
		{ name: '陈子蒙', role: '部门副总经理 (主持工作)', avatarText: '子蒙', avatarBg: '#f472b6' },
		{ name: '刘丹丹', role: '行政经理', avatarText: '丹丹', avatarBg: '#c084fc' },
		{ name: '胡婷', role: '副部长 (主持工作)', avatarText: '胡婷', avatarBg: '#fb7185' },
		{ name: '朱述勇', role: '开发工程师', avatarText: '述勇', avatarBg: '#10b981' }
	]

	function handleCategory(item : any) {
		if (item.nameKey === 'contacts.groups') {
			uni.navigateTo({
				url: '/pages/contacts/initiate-group'
			})
		} else {
			uni.showToast({
				title: t(item.nameKey) + '功能开发中',
				icon: 'none'
			})
		}
	}

	function handleContact(item : any) {
		uni.navigateTo({
			url: '/pages/message/chat?name=' + item.name
		})
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	/* 头部区域 - 扁平化风格 */
	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
	}

	.header-top {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		height: 44px;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
	}

	/* 搜索栏 - 浅灰色扁平风格 */
	.search-bar {
		background-color: #F2F3F5;
		border-radius: 6px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-top: 4px;
	}

	.search-icon {
		font-size: 16px;
		color: #8F959E;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #1F2329;
	}

	.placeholder {
		color: #8F959E;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.category-group {
		background-color: #FFFFFF;
		padding-top: 4px;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.category-item:active {
		background-color: #F2F3F5;
	}

	.category-item-border {
		position: absolute;
		bottom: 0;
		left: 64px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #FFFFFF;
		font-size: 20px;
	}

	.category-name {
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
	}

	.mt-2 {
		margin-top: 8px;
	}

	/* 分组标题 */
	.section-header {
		padding: 16px 16px 8px 16px;
		background-color: #FFFFFF;
	}

	.section-title {
		font-size: 12px;
		color: #8F959E;
		font-weight: 500;
	}

	.contact-list {
		background-color: #FFFFFF;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.contact-item:active {
		background-color: #F2F3F5;
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 68px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 16px;
		color: #1F2329;
		font-weight: 400;
		margin-bottom: 2px;
	}

	.contact-role {
		font-size: 12px;
		color: #8F959E;
	}
</style>