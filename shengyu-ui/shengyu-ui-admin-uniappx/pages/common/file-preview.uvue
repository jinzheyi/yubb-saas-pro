<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('runtime.filePreview.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="content">
			<view v-if="loading" class="loading">
				<text class="loading-text" :style="{ color: theme.textSecondary }">{{ t('runtime.filePreview.loading') }}</text>
			</view>

			<view v-else-if="errorMsg" class="error">
				<text class="error-text" :style="{ color: theme.textSecondary }">{{ errorMsg }}</text>
				<view class="btn-row">
					<view class="btn" :style="{ backgroundColor: theme.brandPrimary }" @click="loadStrategy"><text class="btn-text">{{ t('runtime.filePreview.retry') }}</text></view>
					<view class="btn" :style="{ backgroundColor: theme.brandPrimary }" v-if="downloadUrl" @click="handleDownload"><text class="btn-text">{{ t('runtime.filePreview.downloadOpen') }}</text></view>
				</view>
			</view>

			<view v-else>
				<web-view v-if="previewUrl" :src="previewUrl" class="webview"></web-view>

				<view v-else class="fallback">
					<text class="fallback-title" :style="{ color: theme.textPrimary }">{{ t('runtime.filePreview.unsupportedOnlinePreview') }}</text>
					<text class="fallback-sub" :style="{ color: theme.textSecondary }" v-if="tip">{{ tip }}</text>
					<view class="btn-row">
						<view class="btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleDownload"><text class="btn-text">{{ t('runtime.filePreview.downloadOpen') }}</text></view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getFileOpenStrategy } from '../../api/file.uts'
	import { downloadAndOpenDocumentWithRetry } from '../../utils/file.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	const fileId = ref<string>('')
	const rawUrl = ref<string>('')
	const fileName = ref<string>('')

	const loading = ref<boolean>(false)
	const errorMsg = ref<string>('')
	const tip = ref<string>('')

	const previewUrl = ref<string>('')
	const downloadUrl = ref<string>('')
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	function handleBack() {
		uni.navigateBack()
	}

	function safeDecode(s : string) : string {
		try {
			return decodeURIComponent(s)
		} catch (e) {
			return s
		}
	}

	async function loadStrategy() {
		loading.value = true
		errorMsg.value = ''
		tip.value = ''
		previewUrl.value = ''
		downloadUrl.value = ''
		try {
			const fid = (fileId.value || '').trim()
			if (fid) {
				const strategy : any = await getFileOpenStrategy(fid, 600)
				if (strategy && strategy.downloadUrl) {
					downloadUrl.value = String(strategy.downloadUrl)
				}
				if (strategy && strategy.message) {
					tip.value = String(strategy.message)
				}
				if (strategy && strategy.action === 'PREVIEW' && strategy.previewUrl) {
					previewUrl.value = String(strategy.previewUrl)
					return
				}
				return
			}

			const u = (rawUrl.value || '').trim()
			if (!u) {
				errorMsg.value = t('runtime.filePreview.fileUrlEmpty')
				return
			}
			downloadUrl.value = u
		} catch (e) {
			errorMsg.value = t('runtime.filePreview.loadFailedRetry')
		} finally {
			loading.value = false
		}
	}

	async function handleDownload() {
		try {
			const url = (downloadUrl.value || '').trim()
			if (!url) {
				uni.showToast({ title: t('runtime.filePreview.downloadUrlEmpty'), icon: 'none' })
				return
			}
			await downloadAndOpenDocumentWithRetry(url, t('runtime.file.downloadLoading'))
		} catch (e) {
			uni.showToast({ title: t('runtime.filePreview.openFailed'), icon: 'none' })
		}
	}

	onLoad((options : any) => {
		try {
			if (options && options.fileId) {
				fileId.value = String(options.fileId)
			}
			if (options && options.url) {
				rawUrl.value = safeDecode(String(options.url))
			}
			if (options && options.name) {
				fileName.value = safeDecode(String(options.name))
			}
		} catch (e) {
			// ignore
		}
		loadStrategy()
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 90px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 16px;
		font-weight: 500;
	}

	.header-right {
		width: 90px;
	}

	.content {
		flex: 1;
	}

	.webview {
		flex: 1;
	}

	.loading {
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.loading-text {
		font-size: 14px;
	}

	.error {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	.error-text {
		font-size: 14px;
		text-align: center;
	}

	.fallback {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	.fallback-title {
		font-size: 15px;
		font-weight: 500;
	}

	.fallback-sub {
		font-size: 13px;
		margin-top: 8px;
		text-align: center;
	}

	.btn-row {
		flex-direction: row;
		margin-top: 16px;
	}

	.btn {
		background-color: #1677FF;
		padding: 10px 14px;
		border-radius: 8px;
		margin: 0 6px;
	}

	.btn-text {
		color: #FFFFFF;
		font-size: 14px;
	}
</style>
