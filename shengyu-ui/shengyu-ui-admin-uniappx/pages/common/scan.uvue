<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<!-- #ifdef APP-PLUS -->
		<view class="scan-overlay">
			<view class="status-spacer"></view>
			<view class="scan-header">
				<view class="scan-back" @click="handleBack">
					<text class="iconfont scan-back-icon">&#xeb04;</text>
					<text class="scan-back-text">返回</text>
				</view>
				<text class="scan-title">扫一扫</text>
				<view class="scan-header-right"></view>
			</view>

			<view class="scan-guide">
				<text class="scan-guide-text">优先识别企业 IM 群二维码，第三方链接会进入受控浏览页</text>
			</view>

			<view class="scan-frame-wrap">
				<view class="scan-frame" :style="{ width: frameSizePx, height: frameSizePx }">
					<view class="corner corner-left-top"></view>
					<view class="corner corner-right-top"></view>
					<view class="corner corner-left-bottom"></view>
					<view class="corner corner-right-bottom"></view>
				</view>
			</view>

				<view class="scan-actions">
					<view class="scan-action-btn" @click="toggleFlashlight">
					<text class="iconfont scan-action-icon">{{ flashlightEnabled ? '\ue86e' : '\uea88' }}</text>
						<text class="scan-action-text">{{ flashlightEnabled ? '关闭手电筒' : '打开手电筒' }}</text>
					</view>
				<view class="scan-action-btn scan-action-btn-secondary" @click="openManualJoin">
					<text class="iconfont scan-action-icon">&#xea8b;</text>
					<text class="scan-action-text">手动输入邀请码</text>
				</view>
			</view>
		</view>
		<!-- #endif -->

		<!-- #ifndef APP-PLUS -->
		<view class="fallback-page" :style="{ backgroundColor: theme.pageBg }">
			<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
			<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
				<view class="header-left" @click.stop="handleBack">
					<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
					<text class="back-text" :style="{ color: theme.headerText }">返回</text>
				</view>
				<text class="header-title" :style="{ color: theme.headerText }">扫一扫</text>
				<view class="header-right"></view>
			</view>
			<view class="fallback-content">
				<text class="fallback-title" :style="{ color: theme.textPrimary }">当前端不支持原生扫码</text>
				<text class="fallback-desc" :style="{ color: theme.textSecondary }">请改用手工输入邀请码或邀请链接。</text>
				<view class="fallback-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="openManualJoin">
					<text class="fallback-btn-text">前往输入邀请码</text>
				</view>
			</view>
		</view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onReady, onUnload } from '@dcloudio/uni-app'
	import { routeScanResult } from '../../utils/scan-router.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	let barcodeView : any = null
	const flashlightEnabled = ref(false)
	const scanHandled = ref(false)
	const frameSize = ref(275)
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const frameSizePx = computed(() : string => {
		return frameSize.value + 'px'
	})

	function getCurrentAppWebview() : any {
		try {
			const pages : any[] = getCurrentPages() as any[]
			if (pages.length === 0) {
				return null
			}
			const page : any = pages[pages.length - 1]
			if (page != null && page.$getAppWebview != null) {
				return page.$getAppWebview()
			}
		} catch (e) {
			console.error('[ScanPage] 获取当前 webview 失败:', e)
		}
		return null
	}

	function stopScanner() {
		// #ifdef APP-PLUS
		try {
			if (barcodeView != null) {
				barcodeView.cancel()
				barcodeView.close()
				barcodeView = null
			}
		} catch (e) {
			console.error('[ScanPage] 停止扫码失败:', e)
		}
		// #endif
	}

	function startScanner() {
		// #ifdef APP-PLUS
		try {
			stopScanner()
			const currentWebview = getCurrentAppWebview()
			if (currentWebview == null) {
				uni.showToast({
					title: '扫码环境初始化失败',
					icon: 'none'
				})
				return
			}
			const plusAny = plus as any
			const windowInfo = uni.getWindowInfo()
			frameSize.value = Math.min(Math.max(windowInfo.windowWidth - 100, 220), 320)
			const frameLeft = Math.max((windowInfo.windowWidth - frameSize.value) / 2, 24)
			const frameTop = Math.max((windowInfo.windowHeight - frameSize.value) / 2 - 40, 120)
			barcodeView = plusAny.barcode.create('im-secure-scanner', [plusAny.barcode.QR], {
				top: frameTop + 'px',
				left: frameLeft + 'px',
				width: frameSize.value + 'px',
				height: frameSize.value + 'px',
				position: 'absolute',
				frameColor: '#1677FF',
				scanbarColor: '#1677FF',
				background: 'transparent'
			})
			barcodeView.onmarked = (type : any, result : any, file : any) => {
				if (scanHandled.value) {
					return
				}
				scanHandled.value = true
				const scanText = result != null ? String(result) : ''
				stopScanner()
				routeScanResult(scanText, true)
			}
			currentWebview.append(barcodeView)
			barcodeView.start({
				conserve: false,
				filename: '_doc/barcode/'
			})
		} catch (e) {
			console.error('[ScanPage] 启动扫码失败:', e)
			uni.showToast({
				title: '启动扫码失败',
				icon: 'none'
			})
		}
		// #endif
	}

	function toggleFlashlight() {
		// #ifdef APP-PLUS
		try {
			if (barcodeView == null || barcodeView.setFlash == null) {
				uni.showToast({
					title: '当前设备不支持手电筒控制',
					icon: 'none'
				})
				return
			}
			const nextState = !flashlightEnabled.value
			barcodeView.setFlash(nextState)
			flashlightEnabled.value = nextState
		} catch (e) {
			console.error('[ScanPage] 切换手电筒失败:', e)
			uni.showToast({
				title: '手电筒切换失败',
				icon: 'none'
			})
		}
		// #endif
	}

	function openManualJoin() {
		stopScanner()
		uni.redirectTo({
			url: '/pages/message/join-group?manual=1'
		})
	}

	function handleBack() {
		stopScanner()
		uni.navigateBack()
	}

	onLoad(() => {
		scanHandled.value = false
		flashlightEnabled.value = false
	})

	onReady(() => {
		startScanner()
	})

	onUnload(() => {
		stopScanner()
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		background-color: #0B1220;
	}

	.scan-overlay {
		height: 100%;
		background-color: rgba(11, 18, 32, 0.58);
		display: flex;
		flex-direction: column;
	}

	.status-spacer {
		height: var(--status-bar-height);
	}

	.scan-header {
		height: 44px;
		padding: 0 14px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.scan-back {
		width: 90px;
		flex-direction: row;
		align-items: center;
	}

	.scan-back-icon {
		font-size: 20px;
		color: #FFFFFF;
	}

	.scan-back-text {
		margin-left: 4px;
		font-size: 16px;
		color: #FFFFFF;
	}

	.scan-title {
		font-size: 17px;
		color: #FFFFFF;
		font-weight: 600;
	}

	.scan-header-right {
		width: 90px;
	}

	.scan-guide {
		margin-top: 18px;
		padding: 0 28px;
	}

	.scan-guide-text {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.82);
		text-align: center;
		line-height: 22px;
	}

	.scan-frame-wrap {
		flex: 1;
		justify-content: center;
		align-items: center;
	}

	.scan-frame {
		width: 275px;
		height: 275px;
		position: relative;
		border-radius: 24px;
	}

	.corner {
		position: absolute;
		width: 34px;
		height: 34px;
		border-color: #FFFFFF;
	}

	.corner-left-top {
		left: 0;
		top: 0;
		border-left-width: 4px;
		border-top-width: 4px;
		border-top-left-radius: 18px;
	}

	.corner-right-top {
		right: 0;
		top: 0;
		border-right-width: 4px;
		border-top-width: 4px;
		border-top-right-radius: 18px;
	}

	.corner-left-bottom {
		left: 0;
		bottom: 0;
		border-left-width: 4px;
		border-bottom-width: 4px;
		border-bottom-left-radius: 18px;
	}

	.corner-right-bottom {
		right: 0;
		bottom: 0;
		border-right-width: 4px;
		border-bottom-width: 4px;
		border-bottom-right-radius: 18px;
	}

	.scan-actions {
		padding: 0 20px 34px;
	}

	.scan-action-btn {
		height: 48px;
		border-radius: 24px;
		background-color: rgba(255, 255, 255, 0.14);
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-top: 12px;
	}

	.scan-action-btn-secondary {
		background-color: rgba(22, 119, 255, 0.88);
	}

	.scan-action-icon {
		font-size: 18px;
		color: #FFFFFF;
	}

	.scan-action-text {
		margin-left: 8px;
		font-size: 15px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.fallback-page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 80px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 17px;
		font-weight: 600;
	}

	.header-right {
		width: 80px;
	}

	.fallback-content {
		flex: 1;
		padding: 32px 20px;
		align-items: center;
		justify-content: center;
	}

	.fallback-title {
		font-size: 20px;
		font-weight: 600;
	}

	.fallback-desc {
		margin-top: 10px;
		font-size: 14px;
		color: #646A73;
		text-align: center;
	}

	.fallback-btn {
		margin-top: 22px;
		width: 100%;
		height: 46px;
		border-radius: 23px;
		background-color: #1677FF;
		justify-content: center;
		align-items: center;
	}

	.fallback-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}
</style>
