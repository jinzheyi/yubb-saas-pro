<template>
	<view class="page">
		<view class="status-bar"></view>
		
		<!-- 搜索头部 -->
		<view class="search-header">
			<view class="search-bar">
				<text class="iconfont search-icon">&#xea6e;</text>
				<input class="search-input" v-model="keyword" placeholder="搜索联系人、群聊、消息" placeholder-class="placeholder" @input="handleSearch" @confirm="handleSearchConfirm" focus />
			</view>
			<text class="cancel-btn" @click.stop="handleBack">取消</text>
		</view>

		<!-- 搜索历史 -->
		<view class="search-history" v-if="!keyword && historyList.length > 0">
			<view class="history-header">
				<text class="history-title">搜索历史</text>
				<text class="clear-btn" @click="clearHistory">
					<text class="iconfont">&#xe602;</text>
				</text>
			</view>
			<view class="history-tags">
				<view class="history-tag" v-for="(item, index) in historyList" :key="index" @click="searchHistory(item)" @longpress="handleHistoryLongPress(item)">
					<text class="history-text">{{ item }}</text>
				</view>
			</view>
		</view>

		<!-- 热门搜索 -->
		<view class="hot-search" v-if="!keyword && hotList.length > 0">
			<text class="hot-title">热门搜索</text>
			<view class="hot-tags">
				<view class="hot-tag" v-for="(item, index) in hotList" :key="index" @click="searchHot(item)">
					<text class="hot-text">{{ item }}</text>
				</view>
			</view>
		</view>

		<!-- 搜索结果 -->
		<scroll-view class="search-results" scroll-y="true" show-scrollbar="false" v-if="keyword">
			<!-- 详细搜索 -->
			<view class="result-section">
				<text class="result-title">详细搜索</text>
				<view class="result-list">
					<view class="result-item" @click="handleSearchChatHistory">
						<view class="result-avatar" :style="{ backgroundColor: '#1677FF' }">
							<text class="iconfont group-icon">&#xea6e;</text>
						</view>
						<view class="result-info">
							<text class="result-name">搜聊天记录:{{ keyword }}</text>
							<text class="result-desc">查找聊天记录</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 联系人结果 -->
			<view class="result-section" v-if="contactResults.length > 0">
				<text class="result-title">联系人</text>
				<view class="result-list">
					<view class="result-item" v-for="contact in contactResults" :key="contact.id" @click="handleContactClick(contact)">
						<view class="result-avatar" :style="{ backgroundColor: contact.avatarBg }">
							<text class="result-avatar-text">{{ contact.avatarText }}</text>
						</view>
						<view class="result-info">
							<rich-text class="result-name" :nodes="highlightKeyword(contact.name)"></rich-text>
							<text class="result-desc">{{ contact.role }}</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 群聊结果 -->
			<view class="result-section" v-if="groupResults.length > 0">
				<text class="result-title">群聊</text>
				<view class="result-list">
					<view class="result-item" v-for="group in groupResults" :key="group.id" @click="handleGroupClick(group)">
						<view class="result-avatar" :style="{ backgroundColor: group.avatarBg }">
							<text class="iconfont group-icon">&#xe616;</text>
						</view>
						<view class="result-info">
							<rich-text class="result-name" :nodes="highlightKeyword(group.name)"></rich-text>
							<text class="result-desc">{{ group.memberCount }}人</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 消息结果 -->
			<view class="result-section" v-if="messageResults.length > 0">
				<text class="result-title">聊天记录</text>
				<view class="result-list">
					<view class="result-item" v-for="message in messageResults" :key="message.id" @click="handleMessageClick(message)">
						<view class="result-avatar" :style="{ backgroundColor: '#1677FF' }">
							<text class="iconfont group-icon">&#xe616;</text>
						</view>
						<view class="result-info">
							<text class="result-name">{{ message.conversationName }}</text>
							<rich-text class="result-desc" :nodes="message.highlightedContent || message.content"></rich-text>
						</view>
						<text class="result-time">{{ formatMessageTime(message.timestamp) }}</text>
					</view>
				</view>
			</view>

			<!-- 空状态 -->
			<view class="empty-result" v-if="noResults">
				<text class="iconfont empty-icon">&#xea6e;</text>
				<text class="empty-text">未找到"{{ keyword }}"的相关结果</text>
				<text class="empty-tip">换个关键词试试</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getAvatarText, getGroupAvatarColor, getUserAvatarColor } from '../../utils/avatar.uts'
	import { messageSearchService, type SearchResultItem } from '../../services/message-search-service.uts'
	import { searchContact } from '../../api/contact.uts'
	import { getConversationList, searchConversations } from '../../api/conversation.uts'
	import { getHotSearch } from '../../api/search.uts'
	import { getJsonObject, setJsonObject, remove } from '../../utils/storage.uts'
	import { encodeIdParam } from '../../utils/id-param.uts'

	const { t } = useI18n()
	const SEARCH_HISTORY_KEY = 'IM_SEARCH_HISTORY'
	const HOT_SEARCH_KEY = 'IM_SEARCH_HOT'
	const HOT_SEARCH_TTL_MS = 6 * 60 * 60 * 1000

	const keyword = ref('')
	const historyList = ref<string[]>([])
	const hotList = ref<string[]>([])

	// 搜索结果
	const contactResults = ref<any[]>([])
	const groupResults = ref<any[]>([])
	const messageResults = ref<SearchResultItem[]>([])

	const allMessages: any[] = []
	const conversationsCache = ref<any[] | null>(null)
	let contactSearchSeq = 0
	let groupSearchSeq = 0
	let hotSearchSeq = 0

	const noResults = computed(() : boolean => {
		return keyword.value && contactResults.value.length === 0 && groupResults.value.length === 0 && messageResults.value.length === 0
	})

	function handleBack() {
		uni.navigateBack()
	}

	function loadHistoryFromStorage(): void {
		try {
			const list = getJsonObject<string[]>(SEARCH_HISTORY_KEY, [])
			historyList.value = Array.isArray(list) ? list : []
		} catch (e) {
			historyList.value = []
		}
	}

	function persistHistory(): void {
		try {
			setJsonObject<string[]>(SEARCH_HISTORY_KEY, historyList.value)
		} catch (e) {
			// ignore
		}
	}

	type HotSearchCache = {
		list: string[]
		fetchedAt: number
	}

	function loadHotFromStorage(): void {
		try {
			const cached = getJsonObject<HotSearchCache | null>(HOT_SEARCH_KEY, null)
			if (cached == null || cached.list == null || !Array.isArray(cached.list)) {
				hotList.value = []
				triggerFetchHotIfNeeded()
				return
			}
			const fetchedAt = cached.fetchedAt != null ? Number(cached.fetchedAt) : 0
			const age = Date.now() - fetchedAt
			if (fetchedAt > 0 && age >= 0 && age <= HOT_SEARCH_TTL_MS) {
				hotList.value = cached.list.filter(it => it != null && String(it).trim() !== '').map(it => String(it))
				if (hotList.value.length === 0) hotList.value = []
				return
			}
			hotList.value = []
			triggerFetchHotIfNeeded()
		} catch (e) {
			hotList.value = []
			triggerFetchHotIfNeeded()
		}
	}

	function triggerFetchHotIfNeeded(): void {
		try {
			const seq = ++hotSearchSeq
			Promise.resolve().then(async () => {
				try {
					const res = await getHotSearch(10) as any
					if (seq !== hotSearchSeq) return
					const list = Array.isArray(res) ? res : (res && Array.isArray(res.list) ? res.list : [])
					const normalized = (list as any[])
						.filter(it => it != null && String(it).trim() !== '')
						.map(it => String(it))
					if (normalized.length === 0) {
						return
					}
					hotList.value = normalized
					persistHotToStorage(normalized)
				} catch (e) {
					// ignore
				}
			})
		} catch (e) {
			// ignore
		}
	}

	function persistHotToStorage(list: string[]): void {
		try {
			const payload: HotSearchCache = {
				list: list,
				fetchedAt: Date.now()
			}
			setJsonObject<HotSearchCache>(HOT_SEARCH_KEY, payload)
		} catch (e) {
			// ignore
		}
	}

	async function ensureConversationsLoaded(): Promise<any[]> {
		if (conversationsCache.value != null) {
			return conversationsCache.value as any[]
		}
		try {
			const list = await getConversationList() as any[]
			conversationsCache.value = Array.isArray(list) ? list : []
			return conversationsCache.value as any[]
		} catch (e) {
			conversationsCache.value = []
			return []
		}
	}

	function normalizeContactToUi(contact: any): any {
		const userIdStr = contact && contact.id != null ? String(contact.id) : (contact && contact.userId != null ? String(contact.userId) : '0')
		const displayName = (contact && (contact.remarkName || contact.nickname)) ? String(contact.remarkName || contact.nickname) : (contact && contact.name ? String(contact.name) : '未知')
		const role = contact && contact.deptName != null ? String(contact.deptName) : (contact && contact.role != null ? String(contact.role) : '')
		return {
			id: userIdStr,
			userId: userIdStr,
			name: displayName,
			role: role,
			avatarText: getAvatarText(displayName),
			avatarBg: getUserAvatarColor(userIdStr)
		}
	}

	function normalizeGroupToUi(conv: any): any {
		const chatId = conv && conv.chatId != null ? String(conv.chatId) : '0'
		const name = conv && conv.targetName != null ? String(conv.targetName) : ''
		const memberCount = conv && conv.groupMemberCount != null ? Number(conv.groupMemberCount) : 0
		return {
			id: chatId,
			chatId: chatId,
			name: name,
			memberCount: memberCount,
			avatarBg: getGroupAvatarColor(chatId)
		}
	}

	function handleSearch() {
		if (!keyword.value) {
			contactResults.value = []
			groupResults.value = []
			messageResults.value = []
			try {
				messageSearchService.cancelSearch()
			} catch (e) {
				// ignore
			}
			return
		}

		// 搜索联系人（真实接口）
		try {
			const kw = String(keyword.value).trim()
			const seq = ++contactSearchSeq
			Promise.resolve().then(async () => {
				try {
					const res = await searchContact(kw) as any
					if (seq !== contactSearchSeq) return
					const list = Array.isArray(res) ? res : (res && Array.isArray(res.list) ? res.list : [])
					contactResults.value = (list as any[]).map(it => normalizeContactToUi(it))
				} catch (e) {
					if (seq !== contactSearchSeq) return
					contactResults.value = []
				}
			})
		} catch (e) {
			contactResults.value = []
		}

		// 搜索群聊（服务端优先，失败回退本地过滤）
		try {
			const kw = String(keyword.value).trim()
			const seq = ++groupSearchSeq
			Promise.resolve().then(async () => {
				try {
					try {
						const res = await searchConversations(kw, 2, 1, 20) as any
						if (seq !== groupSearchSeq) return
						const list = res && Array.isArray(res.list) ? res.list : (Array.isArray(res) ? res : [])
						groupResults.value = (list as any[]).map(it => normalizeGroupToUi(it))
						return
					} catch (e) {
						// fallback
					}

					const list = await ensureConversationsLoaded()
					if (seq !== groupSearchSeq) return
					const filtered = (list as any[])
						.filter(it => it && it.conversationType === 2)
						.filter(it => {
							const n = it && it.targetName != null ? String(it.targetName) : ''
							return n.indexOf(kw) >= 0
						})
					groupResults.value = filtered.map(it => normalizeGroupToUi(it))
				} catch (e) {
					if (seq !== groupSearchSeq) return
					groupResults.value = []
				}
			})
		} catch (e) {
			groupResults.value = []
		}

		// 搜索消息（真实接口 + 防抖）
		try {
			const kw = String(keyword.value).trim()
			messageSearchService.searchMessages(
				{ keyword: kw, pageNo: 1, pageSize: 20 },
				(results: SearchResultItem[]) => {
					// 仅当 keyword 未变化时才更新（避免异步回调覆盖）
					if (String(keyword.value).trim() !== kw) return
					messageResults.value = results
				}
			)
		} catch (e) {
			messageResults.value = []
		}
	}

	function handleSearchConfirm() {
		try {
			const kw = keyword.value != null ? String(keyword.value).trim() : ''
			if (kw === '') return
			const next = historyList.value.filter(it => it != null && String(it).trim() !== '' && String(it) !== kw)
			next.unshift(kw)
			historyList.value = next.slice(0, 10)
			persistHistory()
		} catch (e) {
			// ignore
		}
	}

	function clearHistory() {
		uni.showModal({
			title: '清空搜索历史',
			content: '确定要清空搜索历史吗？',
			success: (res) => {
				if (res.confirm) {
					historyList.value = []
					try {
						remove(SEARCH_HISTORY_KEY)
					} catch (e) {
						// ignore
					}
				}
			}
		})
	}

	function searchHistory(item : string) {
		keyword.value = item
		handleSearch()
	}

	function handleHistoryLongPress(item: string): void {
		try {
			const kw = item != null ? String(item).trim() : ''
			if (kw === '') return
			uni.showModal({
				title: '删除历史记录',
				content: `确定删除“${kw}”吗？`,
				success: (res) => {
					if (res.confirm) {
						historyList.value = historyList.value.filter(it => it != null && String(it) !== kw)
						persistHistory()
					}
				}
			})
		} catch (e) {
			// ignore
		}
	}

	function searchHot(item : string) {
		keyword.value = item
		try {
			handleSearchConfirm()
		} catch (e) {
			// ignore
		}
		handleSearch()
	}

	function highlightKeyword(text : string) : string {
		try {
			const kw = keyword.value != null ? String(keyword.value).trim() : ''
			if (!kw || kw.length === 0) return text
			return messageSearchService.highlightKeyword(text, kw)
		} catch (e) {
			return text
		}
	}

	function formatMessageTime(ts: number): string {
		try {
			if (!ts) return ''
			const d = new Date(ts)
			const mm = String(d.getMonth() + 1).padStart(2, '0')
			const dd = String(d.getDate()).padStart(2, '0')
			const hh = String(d.getHours()).padStart(2, '0')
			const mi = String(d.getMinutes()).padStart(2, '0')
			return `${mm}-${dd} ${hh}:${mi}`
		} catch (e) {
			return ''
		}
	}

	function handleContactClick(contact : any) {
		const userIdRaw = contact && (contact.userId || contact.id) ? String(contact.userId || contact.id) : ''
		const userIdParam = encodeIdParam(userIdRaw)
		uni.navigateTo({
			url: '/pages/contacts/user-detail?userId=' + userIdParam
		})
	}

	function handleGroupClick(group : any) {
		const chatIdParam = encodeIdParam(group && (group.chatId || group.id) ? String(group.chatId || group.id) : '')
		uni.navigateTo({
			url: `/pages/message/chat?chatId=${chatIdParam}&name=${encodeURIComponent(group && group.name ? String(group.name) : '')}`
		})
	}

	function handleMessageClick(message: SearchResultItem) {
		const chatId = message && message.chatId ? String(message.chatId) : ''
		const mid = message && message.messageId ? String(message.messageId) : ''
		if (!chatId || chatId === '0' || !mid || mid === '0') {
			uni.showToast({ title: '无法定位消息', icon: 'none' })
			return
		}
		uni.navigateTo({
			url: `/pages/message/chat?chatId=${encodeIdParam(chatId)}&messageId=${encodeURIComponent(mid)}&highlight=true`
		})
	}

	function handleSearchChatHistory() {
		const kw = keyword.value != null ? String(keyword.value).trim() : ''
		if (kw === '') {
			uni.showToast({ title: '请输入关键词', icon: 'none' })
			return
		}
		uni.navigateTo({
			url: `/pages/common/search-chat-history?keyword=${encodeURIComponent(kw)}`
		})
	}

	loadHistoryFromStorage()
	loadHotFromStorage()
</script>

<style>
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.search-header {
		background-color: #FFFFFF;
		padding: 8px 16px;
		flex-direction: row;
		align-items: center;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.search-bar {
		flex: 1;
		background-color: #F3F4F6;
		border-radius: 8px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		margin-right: 12px;
	}

	.search-icon {
		font-size: 16px;
		color: #999999;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		margin-left: 8px;
		color: #333333;
	}

	.placeholder {
		color: #999999;
	}

	.cancel-btn {
		font-size: 15px;
		color: #1677FF;
	}

	/* 搜索历史 */
	.search-history {
		padding: 16px;
		border-bottom-width: 8px;
		border-bottom-color: #F5F7FA;
	}

	.history-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12px;
	}

	.history-title {
		font-size: 14px;
		color: #8F959E;
		font-weight: 600;
	}

	.clear-btn {
		font-size: 14px;
		color: #8F959E;
	}

	.history-tags {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.history-tag {
		background-color: #F5F7FA;
		padding: 6px 12px;
		border-radius: 4px;
		margin-right: 8px;
		margin-bottom: 8px;
	}

	.history-text {
		font-size: 13px;
		color: #646A73;
	}

	/* 热门搜索 */
	.hot-search {
		padding: 16px;
	}

	.hot-title {
		font-size: 14px;
		color: #8F959E;
		font-weight: 600;
		margin-bottom: 12px;
	}

	.hot-tags {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.hot-tag {
		background-color: #F5F7FA;
		padding: 6px 12px;
		border-radius: 4px;
		margin-right: 8px;
		margin-bottom: 8px;
	}

	.hot-text {
		font-size: 13px;
		color: #646A73;
	}

	/* 搜索结果 */
	.search-results {
		flex: 1;
		height: 0;
	}

	.result-section {
		padding: 16px;
		border-bottom-width: 8px;
		border-bottom-color: #F5F7FA;
	}

	.result-title {
		font-size: 14px;
		color: #8F959E;
		font-weight: 600;
		margin-bottom: 12px;
	}

	.result-list {
	}

	.result-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 0.5px;
		border-bottom-color: #EFF0F1;
	}

	.result-item-last {
		border-bottom-width: 0;
	}

	.result-avatar {
		width: 44px;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.result-avatar-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 600;
	}

	.group-icon {
		font-size: 24px;
		color: #FFFFFF;
	}

	.result-info {
		flex: 1;
	}

	.result-name {
		font-size: 15px;
		color: #1F2329;
		margin-bottom: 4px;
	}

	.result-desc {
		font-size: 13px;
		color: #8F959E;
	}

	.result-time {
		font-size: 12px;
		color: #8F959E;
	}

	/* 空状态 */
	.empty-result {
		padding: 80px 16px;
		align-items: center;
	}

	.empty-icon {
		font-size: 64px;
		color: #E5E5E5;
		margin-bottom: 16px;
	}

	.empty-text {
		font-size: 15px;
		color: #646A73;
		margin-bottom: 8px;
	}

	.empty-tip {
		font-size: 13px;
		color: #999999;
		margin-top: 8px;
	}

	.highlight {
		background-color: #FFF3CD;
		color: #856404;
		padding: 2px 4px;
		border-radius: 3px;
		font-weight: 500;
	}
</style>
