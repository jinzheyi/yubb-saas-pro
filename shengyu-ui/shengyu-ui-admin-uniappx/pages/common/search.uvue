<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>

		<view class="search-header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="search-bar" :style="{ backgroundColor: theme.inputBg }">
				<text class="iconfont search-icon" :style="{ color: theme.textTertiary }">&#xea6e;</text>
				<input
					class="search-input"
					:style="{ color: theme.inputText }"
					v-model="keyword"
					placeholder="搜索联系人、群聊、消息"
					placeholder-class="placeholder"
					confirm-type="search"
					@input="handleSearchInput"
					@confirm="handleSearchConfirm"
					focus
				/>
			</view>
			<text class="cancel-btn" :style="{ color: theme.brandPrimary }" @click.stop="handleBack">取消</text>
		</view>

		<view class="search-history" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.pageBg }" v-if="!showResultPanel && historyList.length > 0">
			<view class="history-header">
				<text class="history-title" :style="{ color: theme.textTertiary }">搜索历史</text>
				<text class="clear-btn" :style="{ color: theme.textTertiary }" @click="clearHistory">
					<text class="iconfont">&#xe602;</text>
				</text>
			</view>
			<view class="history-tags">
				<view class="history-tag" :style="{ backgroundColor: theme.cardBgMuted }" v-for="(item, index) in historyList" :key="index" @click="searchHistory(item)" @longpress="handleHistoryLongPress(item)">
					<text class="history-text" :style="{ color: theme.textSecondary }">{{ item }}</text>
				</view>
			</view>
		</view>

		<view class="hot-search" :style="{ backgroundColor: theme.cardBg }" v-if="!showResultPanel && hotList.length > 0">
			<text class="hot-title" :style="{ color: theme.textTertiary }">热门搜索</text>
			<view class="hot-tags">
				<view class="hot-tag" :style="{ backgroundColor: theme.cardBgMuted }" v-for="(item, index) in hotList" :key="index" @click="searchHot(item)">
					<text class="hot-text" :style="{ color: theme.textSecondary }">{{ item }}</text>
				</view>
			</view>
		</view>

		<view class="tip-panel" v-if="showTipPanel">
			<text class="tip-text" :style="{ color: theme.textTertiary }">输入至少 2 个字开始搜索</text>
		</view>

		<view class="result-panel" v-if="showResultPanel">
			<scroll-view class="tab-scroll" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }" scroll-x="true" show-scrollbar="false">
				<view class="tab-list">
					<view
						v-for="tab in tabs"
						:key="tab.key"
						class="tab-item"
						:style="{ backgroundColor: activeTab === tab.key ? theme.brandPrimarySoft : theme.cardBgMuted }"
						:class="activeTab === tab.key ? 'tab-item-active' : ''"
						@click="switchTab(tab.key)">
						<text class="tab-text" :class="activeTab === tab.key ? 'tab-text-active' : ''" :style="{ color: activeTab === tab.key ? theme.brandPrimary : theme.textSecondary }">{{ buildTabLabel(tab.key, tab.label) }}</text>
					</view>
				</view>
			</scroll-view>

			<scroll-view class="search-results" :style="{ backgroundColor: theme.cardBg }" scroll-y="true" show-scrollbar="false" @scrolltolower="loadMore">
				<view class="result-list" v-if="resultList.length > 0">
					<view class="result-item" v-for="item in resultList" :key="item.uniqueId" @click="handleResultClick(item)">
						<view class="result-avatar" :style="{ backgroundColor: item.avatarBg }">
							<image v-if="item.avatarUrl" class="avatar-image" :src="item.avatarUrl" mode="aspectFill" @error="handleResultAvatarError(item)" />
							<text v-else-if="item.avatarIcon" class="iconfont avatar-icon">{{ item.avatarIcon }}</text>
							<text v-else class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view class="result-main">
							<view class="result-top">
								<text class="result-type-tag" :style="{ backgroundColor: theme.cardBgMuted, color: theme.textSecondary }">{{ item.typeLabel }}</text>
								<rich-text class="result-title" :nodes="highlightKeyword(item.title)"></rich-text>
								<text class="result-time" :style="{ color: theme.textTertiary }">{{ formatResultTime(item.time) }}</text>
							</view>
							<rich-text class="result-sub" :nodes="highlightKeyword(item.subTitle)"></rich-text>
							<rich-text class="result-snippet" :nodes="highlightKeyword(item.snippet)"></rich-text>
						</view>
					</view>
				</view>

				<view class="loading" v-if="isLoading && resultList.length === 0">
					<text class="loading-text" :style="{ color: theme.textTertiary }">搜索中...</text>
				</view>

				<view class="loading" v-if="isLoadingMore && resultList.length > 0">
					<text class="loading-text" :style="{ color: theme.textTertiary }">加载更多...</text>
				</view>

				<view class="empty-result" v-if="!isLoading && resultList.length === 0">
					<text class="iconfont empty-icon" :style="{ color: theme.borderColor }">&#xea6e;</text>
					<text class="empty-text" :style="{ color: theme.textSecondary }">未找到“{{ keyword }}”相关结果</text>
				</view>

				<view class="no-more" v-if="!isLoading && !hasMore && resultList.length > 0">
					<text class="no-more-text" :style="{ color: theme.textTertiary }">没有更多了</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { getAvatarText, getConversationAvatarColor, getGroupAvatarColor, getUserAvatarColor } from '../../utils/avatar.uts'
	import { messageSearchService } from '../../services/message-search-service.uts'
	import { getHotSearch, searchGlobal } from '../../api/search.uts'
	import { getJsonObject, setJsonObject, remove } from '../../utils/storage.uts'
	import { encodeIdParam } from '../../utils/id-param.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const SEARCH_HISTORY_KEY = 'IM_SEARCH_HISTORY'
	const HOT_SEARCH_KEY = 'IM_SEARCH_HOT'
	const HOT_SEARCH_TTL_MS = 6 * 60 * 60 * 1000
	const MIN_SEARCH_KEYWORD_LENGTH = 2
	const SEARCH_DEBOUNCE_MS = 300
	const SEARCH_SAME_QUERY_DEDUP_MS = 1200
	const PAGE_SIZE = 20
	const theme = ref<ThemeTokens>(getThemeTokens())

	type SearchTab = {
		key: string
		label: string
	}

	type FacetsState = {
		all: number
		message: number
		contact: number
		group: number
		media: number
	}

	type ResultUiItem = {
		uniqueId: string
		id: string
		type: string
		typeLabel: string
		title: string
		subTitle: string
		snippet: string
		time: number
		chatId: string
		messageId: string
		sequence: string
		avatarUrl: string
		avatarText: string
		avatarBg: string
		avatarIcon: string
		meta: any
	}

	type SearchResponse = {
		list: ResultUiItem[]
		total: number
		hasMore: boolean
		facets: FacetsState
		costMs?: number
	}

	type HotSearchCache = {
		list: string[]
		fetchedAt: number
	}

	const tabs = ref<SearchTab[]>([
		{ key: 'all', label: '综合' },
		{ key: 'message', label: '消息' },
		{ key: 'contact', label: '联系人' },
		{ key: 'group', label: '群聊' },
		{ key: 'media', label: '文件与媒体' }
	])

	const keyword = ref('')
	const activeTab = ref('all')
	const historyList = ref<string[]>([])
	const hotList = ref<string[]>([])
	const resultList = ref<ResultUiItem[]>([])
	const facets = ref<FacetsState>({
		all: 0,
		message: 0,
		contact: 0,
		group: 0,
		media: 0
	})

	const isLoading = ref(false)
	const isLoadingMore = ref(false)
	const hasMore = ref(false)
	const total = ref(0)

	const showResultPanel = computed((): boolean => {
		return normalizedKeyword().length >= MIN_SEARCH_KEYWORD_LENGTH
	})

	const showTipPanel = computed((): boolean => {
		const len = normalizedKeyword().length
		return len > 0 && len < MIN_SEARCH_KEYWORD_LENGTH
	})

	let requestSeq = 0
	let searchTimer = 0
	let hotSearchSeq = 0
	let currentPageNo = 1
	let lastFirstPageKey = ''
	let lastFirstPageAt = 0
	let lastFirstPageResp: SearchResponse | null = null
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	function normalizedKeyword(): string {
		return keyword.value != null ? String(keyword.value).trim() : ''
	}

	function resetResultState(clearList: boolean): void {
		if (clearList) {
			resultList.value = []
		}
		facets.value = {
			all: 0,
			message: 0,
			contact: 0,
			group: 0,
			media: 0
		}
		total.value = 0
		hasMore.value = false
		currentPageNo = 1
	}

	function clearSearchTimer(): void {
		if (searchTimer > 0) {
			clearTimeout(searchTimer)
			searchTimer = 0
		}
	}

	function buildFirstPageKey(kw: string, tab: string): string {
		return `${tab}|${kw}`
	}

	function applySearchResponse(response: SearchResponse, pageNo: number, reset: boolean): void {
		facets.value = response.facets
		total.value = response.total
		hasMore.value = response.hasMore
		currentPageNo = response.hasMore ? pageNo + 1 : pageNo
		if (reset) {
			resultList.value = response.list
		} else {
			resultList.value = mergeResultItems(resultList.value, response.list)
		}
	}

	function handleBack() {
		uni.navigateBack()
	}

	function loadHistoryFromStorage(): void {
		try {
			const list = getJsonObject<string[]>(SEARCH_HISTORY_KEY, [])
			historyList.value = Array.isArray(list) ? list : []
		} catch (e) {
			historyList.value = []
		}
	}

	function persistHistory(): void {
		try {
			setJsonObject<string[]>(SEARCH_HISTORY_KEY, historyList.value)
		} catch (e) {
			// ignore
		}
	}

	function loadHotFromStorage(): void {
		try {
			const cached = getJsonObject<HotSearchCache | null>(HOT_SEARCH_KEY, null)
			if (cached == null || cached.list == null || !Array.isArray(cached.list)) {
				hotList.value = []
				triggerFetchHotIfNeeded()
				return
			}
			const fetchedAt = cached.fetchedAt != null ? Number(cached.fetchedAt) : 0
			const age = Date.now() - fetchedAt
			if (fetchedAt > 0 && age >= 0 && age <= HOT_SEARCH_TTL_MS) {
				hotList.value = cached.list.filter(it => it != null && String(it).trim() !== '').map(it => String(it))
				return
			}
			hotList.value = []
			triggerFetchHotIfNeeded()
		} catch (e) {
			hotList.value = []
			triggerFetchHotIfNeeded()
		}
	}

	function triggerFetchHotIfNeeded(): void {
		const seq = ++hotSearchSeq
		Promise.resolve().then(async () => {
			try {
				const res = await getHotSearch(10) as any
				if (seq !== hotSearchSeq) {
					return
				}
				const list = Array.isArray(res) ? res : (res && Array.isArray(res.list) ? res.list : [])
				const normalized = (list as any[])
					.filter(it => it != null && String(it).trim() !== '')
					.map(it => String(it))
				if (normalized.length === 0) {
					return
				}
				hotList.value = normalized
				persistHotToStorage(normalized)
			} catch (e) {
				// ignore
			}
		})
	}

	function persistHotToStorage(list: string[]): void {
		try {
			const payload: HotSearchCache = {
				list: list,
				fetchedAt: Date.now()
			}
			setJsonObject<HotSearchCache>(HOT_SEARCH_KEY, payload)
		} catch (e) {
			// ignore
		}
	}

	function handleSearchInput() {
		const kw = normalizedKeyword()
		if (kw.length === 0) {
			clearSearchTimer()
			requestSeq = requestSeq + 1
			try {
				messageSearchService.cancelSearch()
			} catch (e) {
				// ignore
			}
			resetResultState(true)
			return
		}
		if (kw.length < MIN_SEARCH_KEYWORD_LENGTH) {
			clearSearchTimer()
			requestSeq = requestSeq + 1
			try {
				messageSearchService.cancelSearch()
			} catch (e) {
				// ignore
			}
			resetResultState(true)
			return
		}
		scheduleSearch(true)
	}

	function handleSearchConfirm() {
		const kw = normalizedKeyword()
		if (kw === '') {
			return
		}
		const next = historyList.value.filter(it => it != null && String(it).trim() !== '' && String(it) !== kw)
		next.unshift(kw)
		historyList.value = next.slice(0, 10)
		persistHistory()
		searchNow(true)
	}

	function scheduleSearch(reset: boolean): void {
		clearSearchTimer()
		searchTimer = setTimeout(() => {
			searchTimer = 0
			searchNow(reset)
		}, SEARCH_DEBOUNCE_MS)
	}

	async function searchNow(reset: boolean): Promise<void> {
		const kw = normalizedKeyword()
		if (kw.length < MIN_SEARCH_KEYWORD_LENGTH) {
			resetResultState(true)
			return
		}
		if (reset) {
			resetResultState(true)
		}
		if (!reset && !hasMore.value) {
			return
		}
		const pageNo = reset ? 1 : currentPageNo
		if (reset && pageNo === 1) {
			const firstPageKey = buildFirstPageKey(kw, activeTab.value)
			const now = Date.now()
			if (lastFirstPageResp != null && firstPageKey === lastFirstPageKey && (now - lastFirstPageAt) <= SEARCH_SAME_QUERY_DEDUP_MS) {
				applySearchResponse(lastFirstPageResp, pageNo, true)
				return
			}
		}
		const seq = ++requestSeq
		if (reset) {
			isLoading.value = true
		} else {
			isLoadingMore.value = true
		}
		try {
			const response = await fetchByGlobalApi(kw, activeTab.value, pageNo, PAGE_SIZE)
			if (seq !== requestSeq) {
				return
			}
			applySearchResponse(response, pageNo, reset)
			if (reset && pageNo === 1) {
				lastFirstPageKey = buildFirstPageKey(kw, activeTab.value)
				lastFirstPageAt = Date.now()
				lastFirstPageResp = response
			}
		} catch (e) {
			if (seq !== requestSeq) {
				return
			}
			if (reset) {
				resultList.value = []
			}
			hasMore.value = false
		} finally {
			if (reset) {
				isLoading.value = false
			} else {
				isLoadingMore.value = false
			}
		}
	}

	async function fetchByGlobalApi(kw: string, tab: string, pageNo: number, pageSize: number): Promise<SearchResponse> {
		const data = await searchGlobal(kw, tab, pageNo, pageSize, 'relevance', '') as any
		const list = data && Array.isArray(data.list) ? data.list : []
		const mapped = (list as any[]).map(it => mapGlobalItem(it))
		const fs = normalizeFacets(data && data.facets ? data.facets : null)
		const resp: SearchResponse = {
			list: mapped,
			total: data && data.total != null ? Number(data.total) : mapped.length,
			hasMore: data && data.hasMore === true,
			facets: fs,
			costMs: data && data.costMs != null ? Number(data.costMs) : 0
		}
		return resp
	}

	function normalizeFacets(raw: any): FacetsState {
		return {
			all: raw && raw.all != null ? Number(raw.all) : 0,
			message: raw && raw.message != null ? Number(raw.message) : 0,
			contact: raw && raw.contact != null ? Number(raw.contact) : 0,
			group: raw && raw.group != null ? Number(raw.group) : 0,
			media: raw && raw.media != null ? Number(raw.media) : 0
		}
	}

	function mergeResultItems(existing: ResultUiItem[], next: ResultUiItem[]): ResultUiItem[] {
		const map: any = {}
		const out: ResultUiItem[] = []
		for (let i = 0; i < existing.length; i++) {
			const item = existing[i]
			map[item.uniqueId] = true
			out.push(item)
		}
		for (let i = 0; i < next.length; i++) {
			const item = next[i]
			if (map[item.uniqueId]) {
				continue
			}
			map[item.uniqueId] = true
			out.push(item)
		}
		return out
	}

	function safeString(value: any): string {
		if (value == null) {
			return ''
		}
		return String(value)
	}

	function parseTimeMs(value: any): number {
		if (value == null) {
			return 0
		}
		if (typeof value === 'number') {
			return value > 100000000000 ? value : value * 1000
		}
		const text = String(value)
		if (text.trim() === '') {
			return 0
		}
		const t = new Date(text).getTime()
		if (isNaN(t)) {
			return 0
		}
		return t
	}

	function mapGlobalItem(raw: any): ResultUiItem {
		const type = safeString(raw && raw.type)
		const id = safeString(raw && raw.id)
		const chatId = safeString(raw && raw.chatId)
		const messageId = safeString(raw && raw.messageId)
		const sequence = safeString(raw && raw.sequence)
		const title = safeString(raw && raw.title)
		const subTitle = safeString(raw && raw.subTitle)
		const snippet = normalizeSnippet(type, safeString(raw && raw.snippet), raw && raw.meta)
		const typeLabel = buildTypeLabel(type, raw && raw.meta)
		const time = parseTimeMs(raw && raw.time)
		const avatar = buildAvatar(type, chatId !== '' ? chatId : id, title, raw && raw.meta, raw)
		return {
			uniqueId: `${type}:${id}:${chatId}:${messageId}`,
			id: id,
			type: type,
			typeLabel: typeLabel,
			title: title,
			subTitle: subTitle,
			snippet: snippet,
			time: time,
			chatId: chatId,
			messageId: messageId,
			sequence: sequence,
			avatarUrl: avatar.url,
			avatarText: avatar.text,
			avatarBg: avatar.bg,
			avatarIcon: avatar.icon,
			meta: raw && raw.meta ? raw.meta : null
		}
	}

	function normalizeSnippet(type: string, value: string, meta: any): string {
		const text = value != null ? String(value) : ''
		if (type !== 'message' && type !== 'media') {
			return text
		}
		const messageType = meta && meta.messageType != null ? String(meta.messageType) : ''
		if (messageType === '2') {
			return '[图片]'
		}
		if (messageType === '4') {
			return '[视频]'
		}
		if (messageType === '5') {
			const name = meta && (meta.fileName || meta.name) ? String(meta.fileName || meta.name) : ''
			return name !== '' ? `[文件] ${name}` : '[文件]'
		}
		if (messageType === '3') {
			return '[语音]'
		}
		if (messageType === '6') {
			return '[位置]'
		}
		if (messageType === '7') {
			return '[表情]'
		}
		if (messageType === '8') {
			return '[动画表情]'
		}
		if (text.startsWith('{') || text.startsWith('[')) {
			return '[消息]'
		}
		return text
	}

	function buildTypeLabel(type: string, meta: any): string {
		if (type === 'contact') {
			return '联系人'
		}
		if (type === 'group') {
			return '群聊'
		}
		if (type === 'media') {
			return '文件与媒体'
		}
		const conversationType = resolveConversationType(meta, meta)
		return conversationType === 2 ? '群消息' : '单聊消息'
	}

	type AvatarState = { url: string, text: string, bg: string, icon: string }

	function normalizeAvatarUrl(value: any): string {
		if (value == null) {
			return ''
		}
		const text = String(value).trim()
		if (text === '' || text === 'null' || text === 'undefined') {
			return ''
		}
		return text
	}

	function resolveMetaInt(meta: any, key: string): number {
		if (meta == null || key === '') {
			return 0
		}
		const raw = meta[key]
		if (raw == null) {
			return 0
		}
		const n = Number(raw)
		if (isNaN(n)) {
			return 0
		}
		return Math.floor(n)
	}

	function resolveConversationType(meta: any, raw: any): number {
		const typeFromMeta = resolveMetaInt(meta, 'conversationType')
		if (typeFromMeta === 1 || typeFromMeta === 2) {
			return typeFromMeta
		}
		const groupIdRaw = raw && raw.groupId != null ? String(raw.groupId).trim() : ''
		if (groupIdRaw !== '' && groupIdRaw !== '0' && groupIdRaw !== 'null' && groupIdRaw !== 'undefined') {
			return 2
		}
		return 1
	}

	function resolveAvatarUrlByType(type: string, meta: any, raw: any): string {
		if (type === 'contact') {
			return normalizeAvatarUrl(raw && (raw.avatar || raw.userAvatar)) || normalizeAvatarUrl(meta && meta.avatar)
		}
		if (type === 'group') {
			return normalizeAvatarUrl(raw && (raw.targetAvatar || raw.avatar)) || normalizeAvatarUrl(meta && meta.targetAvatar)
		}
		const conversationAvatar =
			normalizeAvatarUrl(raw && (raw.conversationAvatar || raw.targetAvatar)) ||
			normalizeAvatarUrl(meta && (meta.conversationAvatar || meta.targetAvatar))
		if (conversationAvatar !== '') {
			return conversationAvatar
		}
		return normalizeAvatarUrl(raw && raw.senderAvatar) || normalizeAvatarUrl(meta && meta.senderAvatar)
	}

	function buildAvatar(type: string, id: string, title: string, meta: any, raw: any): AvatarState {
		const avatarUrl = resolveAvatarUrlByType(type, meta, raw)
		const conversationType = resolveConversationType(meta, raw)
		const targetId = safeString(meta && meta.targetId) || safeString(raw && raw.groupId)
		const avatarId = targetId !== '' && targetId !== '0' ? targetId : (id !== '' ? id : title)
		if (type === 'contact') {
			return {
				url: avatarUrl,
				text: getAvatarText(title),
				bg: getUserAvatarColor(avatarId),
				icon: ''
			}
		}
		if (type === 'group' || conversationType === 2) {
			const groupText = getAvatarText(title !== '' ? title : (avatarId !== '' ? avatarId : '群'))
			return {
				url: avatarUrl,
				text: groupText,
				bg: getGroupAvatarColor(avatarId),
				icon: ''
			}
		}
		return {
			url: avatarUrl,
			text: getAvatarText(title !== '' ? title : avatarId),
			bg: getConversationAvatarColor(1, avatarId),
			icon: ''
		}
	}

	function highlightKeyword(text: string): string {
		try {
			const kw = normalizedKeyword()
			if (!kw || kw.length === 0) {
				return text
			}
			return messageSearchService.highlightKeyword(text, kw)
		} catch (e) {
			return text
		}
	}

	function formatResultTime(ts: number): string {
		if (!ts || ts <= 0) {
			return ''
		}
		const d = new Date(ts)
		if (isNaN(d.getTime())) {
			return ''
		}
		const now = new Date()
		const sameYear = d.getFullYear() === now.getFullYear()
		const isToday = d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth() && d.getDate() === now.getDate()
		if (isToday) {
			const hh = String(d.getHours()).padStart(2, '0')
			const mm = String(d.getMinutes()).padStart(2, '0')
			return `${hh}:${mm}`
		}
		const yest = new Date(now.getTime() - 24 * 60 * 60 * 1000)
		const isYesterday = d.getFullYear() === yest.getFullYear() && d.getMonth() === yest.getMonth() && d.getDate() === yest.getDate()
		if (isYesterday) {
			return '昨天'
		}
		const m = String(d.getMonth() + 1).padStart(2, '0')
		const day = String(d.getDate()).padStart(2, '0')
		if (sameYear) {
			return `${m}/${day}`
		}
		return `${d.getFullYear()}/${m}/${day}`
	}

	function buildTabLabel(key: string, label: string): string {
		if (!showResultPanel.value) {
			return label
		}
		const count = getTabCount(key)
		if (count <= 0) {
			return label
		}
		if (count > 99) {
			return `${label}(99+)`
		}
		return `${label}(${count})`
	}

	function getTabCount(key: string): number {
		if (key === 'all') {
			return facets.value.all
		}
		if (key === 'message') {
			return facets.value.message
		}
		if (key === 'contact') {
			return facets.value.contact
		}
		if (key === 'group') {
			return facets.value.group
		}
		if (key === 'media') {
			return facets.value.media
		}
		return 0
	}

	function switchTab(tabKey: string): void {
		if (tabKey === activeTab.value) {
			return
		}
		activeTab.value = tabKey
		const kw = normalizedKeyword()
		if (kw.length >= MIN_SEARCH_KEYWORD_LENGTH) {
			searchNow(true)
		} else {
			resetResultState(true)
		}
	}

	function loadMore(): void {
		if (!showResultPanel.value) {
			return
		}
		if (isLoading.value || isLoadingMore.value || !hasMore.value) {
			return
		}
		searchNow(false)
	}

	function clearHistory() {
		uni.showModal({
			title: '清空搜索历史',
			content: '确定要清空搜索历史吗？',
			success: (res) => {
				if (res.confirm) {
					historyList.value = []
					try {
						remove(SEARCH_HISTORY_KEY)
					} catch (e) {
						// ignore
					}
				}
			}
		})
	}

	function searchHistory(item: string) {
		keyword.value = item
		handleSearchConfirm()
	}

	function handleHistoryLongPress(item: string): void {
		const kw = item != null ? String(item).trim() : ''
		if (kw === '') {
			return
		}
		uni.showModal({
			title: '删除历史记录',
			content: `确定删除“${kw}”吗？`,
			success: (res) => {
				if (res.confirm) {
					historyList.value = historyList.value.filter(it => it != null && String(it) !== kw)
					persistHistory()
				}
			}
		})
	}

	function searchHot(item: string) {
		keyword.value = item
		handleSearchConfirm()
	}

	function buildGroupChatUrl(groupId: string, chatId: string, name: string): string {
		const params: string[] = []
		const normalizedGroupId = groupId != null ? String(groupId).trim() : ''
		const normalizedChatId = chatId != null ? String(chatId).trim() : ''
		if (normalizedChatId !== '' && normalizedChatId !== '0') {
			params.push(`chatId=${encodeIdParam(normalizedChatId)}`)
		}
		if (normalizedGroupId !== '' && normalizedGroupId !== '0') {
			const encodedGroupId = encodeIdParam(normalizedGroupId)
			params.push(`groupId=${encodedGroupId}`)
			params.push(`targetId=${encodedGroupId}`)
			params.push('targetType=2')
			params.push('type=group')
		}
		if (name != null && String(name).trim() !== '') {
			params.push(`name=${encodeURIComponent(String(name))}`)
		}
		params.push('entryMode=latest')
		return `/pages/message/chat?${params.join('&')}`
	}

	function buildMessageChatUrl(item: ResultUiItem): string {
		const params: string[] = []
		const chatId = item.chatId != null ? String(item.chatId).trim() : ''
		if (chatId !== '' && chatId !== '0') {
			params.push(`chatId=${encodeIdParam(chatId)}`)
		}
		const conversationType = resolveConversationType(item.meta, item.meta)
		const groupId = safeString(item.meta && (item.meta.groupId != null ? item.meta.groupId : item.meta.targetId))
		if (conversationType === 2 && groupId !== '' && groupId !== '0') {
			const encodedGroupId = encodeIdParam(groupId)
			params.push(`groupId=${encodedGroupId}`)
			params.push(`targetId=${encodedGroupId}`)
			params.push('targetType=2')
			params.push('type=group')
		}
		params.push('entryMode=anchor')
		const messageId = item.messageId || item.id
		const seq = item.sequence
		if (seq != null && String(seq) !== '' && String(seq) !== '0') {
			params.push(`anchorSequence=${encodeURIComponent(String(seq))}`)
		} else {
			params.push(`anchorMessageId=${encodeURIComponent(messageId)}`)
		}
		params.push(`messageId=${encodeURIComponent(messageId)}`)
		params.push('highlight=true')
		return `/pages/message/chat?${params.join('&')}`
	}

	function handleResultClick(item: ResultUiItem): void {
		if (item.type === 'contact') {
			const userIdParam = encodeIdParam(item.id)
			uni.navigateTo({
				url: '/pages/contacts/user-detail?userId=' + userIdParam
			})
			return
		}

		if (item.type === 'group') {
			uni.navigateTo({
				url: buildGroupChatUrl(item.id, item.chatId, item.title)
			})
			return
		}

		if (item.type === 'message' || item.type === 'media') {
			const chatId = item.chatId
			const messageId = item.messageId || item.id
			const seq = item.sequence
			if (!chatId || chatId === '0' || !messageId || messageId === '0') {
				return
			}
			uni.navigateTo({ url: buildMessageChatUrl(item) })
			return
		}
	}

	function handleResultAvatarError(item: ResultUiItem): void {
		try {
			if (item == null) {
				return
			}
			item.avatarUrl = ''
		} catch (e) {
			// ignore
		}
	}

	onLoad((options: any) => {
		loadHistoryFromStorage()
		loadHotFromStorage()
		try {
			if (options == null) {
				return
			}
			const raw = options.keyword != null ? String(options.keyword) : ''
			if (raw.trim() === '') {
				return
			}
			let kw = raw
			try {
				kw = decodeURIComponent(raw)
			} catch (e) {
				// keep raw
			}
			keyword.value = kw
			handleSearchConfirm()
		} catch (e) {
			// ignore
		}
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
		clearSearchTimer()
		requestSeq = requestSeq + 1
		try {
			messageSearchService.cancelSearch()
		} catch (e) {
			// ignore
		}
	})
</script>

