<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }">{{ t('locationViewer.title') }}</text>
			<view class="header-right"></view>
		</view>

		<view class="map-wrap" :style="{ backgroundColor: theme.cardBg }">
			<map
				class="map"
				:latitude="latitude"
				:longitude="longitude"
				:scale="16"
				:show-location="false"
				:enable-scroll="true"
				:enable-zoom="true"
			/>
			<view class="center-marker">
				<view class="marker-pin"></view>
				<view class="marker-shadow"></view>
			</view>
		</view>

		<view class="card" :style="{ backgroundColor: theme.cardBg }">
			<text class="name" :style="{ color: theme.textPrimary }">{{ displayName }}</text>
			<text class="address" :style="{ color: theme.textSecondary }">{{ displayAddress }}</text>
			<text class="coordinate" :style="{ color: theme.textTertiary }">{{ coordinateText }}</text>
		</view>

		<view class="actions">
			<view class="action-btn primary-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleCopy">
				<text class="action-text">{{ t('locationViewer.copy') }}</text>
			</view>
			<view
				v-if="systemLocationAvailable"
				class="action-btn secondary-btn"
				:style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }"
				@click="handleOpenSystemLocation"
			>
				<text class="secondary-text" :style="{ color: theme.textPrimary }">{{ t('locationViewer.systemMap') }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { useI18n } from '../../hooks/useI18n.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import type { ThemeTokens } from '../../config/theme.uts'
import { buildLocationClipboardPayload, canOpenSystemLocation, openLocationWithFallback } from '../../utils/location.uts'

const { t } = useI18n()
const theme = ref<ThemeTokens>(getThemeTokens())
const latitude = ref(0)
const longitude = ref(0)
const name = ref('')
const address = ref('')
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
	theme.value = tokens
})

const displayName = computed((): string => {
	return name.value !== '' ? name.value : t('chat.label.locationDefault')
})

const displayAddress = computed((): string => {
	return address.value !== '' ? address.value : t('chat.label.locationCoordinate')
})

const coordinateText = computed((): string => {
	return 'Lat ' + latitude.value.toFixed(6) + ' / Lng ' + longitude.value.toFixed(6)
})

const systemLocationAvailable = computed((): boolean => {
	return canOpenSystemLocation()
})

onLoad((options) => {
	latitude.value = options != null && options['latitude'] != null ? Number(options['latitude']) : 0
	longitude.value = options != null && options['longitude'] != null ? Number(options['longitude']) : 0
	name.value = options != null && options['name'] != null ? decodeURIComponent(String(options['name'])) : ''
	address.value = options != null && options['address'] != null ? decodeURIComponent(String(options['address'])) : ''
})

onUnload(() => {
	if (unsubscribeTheme != null) {
		unsubscribeTheme()
		unsubscribeTheme = null
	}
})

function handleBack(): void {
	uni.navigateBack()
}

function handleCopy(): void {
	uni.setClipboardData({
		data: buildLocationClipboardPayload(displayName.value, address.value, latitude.value, longitude.value),
		success: () => {
			uni.showToast({ title: t('locationViewer.copySuccess'), icon: 'none' })
		}
	})
}

function handleOpenSystemLocation(): void {
	if (!canOpenSystemLocation()) {
		uni.showToast({ title: t('chat.toast.locationOpenUnsupported'), icon: 'none' })
		return
	}
	openLocationWithFallback({
		latitude: latitude.value,
		longitude: longitude.value,
		name: displayName.value,
		address: address.value
	})
}
</script>

<style scoped>
.page {
	flex: 1;
}

.status-bar {
	height: 44px;
}

.header {
	height: 44px;
	padding: 0 12px;
	flex-direction: row;
	align-items: center;
	border-bottom-width: 0.5px;
}

.header-left,
.header-right {
	width: 40px;
	height: 44px;
	justify-content: center;
	align-items: center;
}

.back-icon {
	font-size: 18px;
}

.header-title {
	flex: 1;
	text-align: center;
	font-size: 16px;
	font-weight: 600;
}

.map-wrap {
	margin: 12px;
	height: 300px;
	border-radius: 16px;
	overflow: hidden;
	position: relative;
}

.map {
	width: 100%;
	height: 300px;
}

.center-marker {
	position: absolute;
	left: 50%;
	top: 50%;
	margin-left: -14px;
	margin-top: -34px;
	align-items: center;
}

.marker-pin {
	width: 28px;
	height: 28px;
	border-radius: 14px 14px 14px 0;
	background-color: #1677ff;
	transform: rotate(-45deg);
}

.marker-shadow {
	margin-top: 6px;
	width: 16px;
	height: 6px;
	border-radius: 8px;
	background-color: rgba(0, 0, 0, 0.16);
}

.card {
	margin: 0 12px;
	padding: 16px;
	border-radius: 16px;
}

.name {
	font-size: 18px;
	font-weight: 600;
}

.address {
	margin-top: 8px;
	font-size: 14px;
	line-height: 20px;
}

.coordinate {
	margin-top: 10px;
	font-size: 12px;
}

.actions {
	padding: 16px 12px 24px;
	flex-direction: row;
}

.action-btn {
	flex: 1;
	height: 44px;
	border-radius: 12px;
	justify-content: center;
	align-items: center;
}

.secondary-btn {
	margin-left: 12px;
	border-width: 1px;
}

.action-text {
	color: #ffffff;
	font-size: 15px;
	font-weight: 600;
}

.secondary-text {
	font-size: 15px;
	font-weight: 600;
}
</style>
