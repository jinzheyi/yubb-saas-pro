<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">返回</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }" :numberOfLines="1">{{ pageTitle }}</text>
			<view class="header-right"></view>
		</view>

		<view class="address-bar" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<text class="address-tag" :style="{ color: theme.brandPrimary, backgroundColor: theme.brandPrimarySoft }">{{ sourceTag }}</text>
			<text class="address-text" :style="{ color: theme.textSecondary }" :numberOfLines="1">{{ addressText }}</text>
		</view>

		<view class="content">
			<web-view v-if="webUrl !== ''" :src="webUrl" class="webview"></web-view>

			<view v-else class="blocked-wrap">
				<text class="blocked-title" :style="{ color: theme.textPrimary }">已拦截非受控内容</text>
				<text class="blocked-desc" :style="{ color: theme.textSecondary }">仅允许在 IM 内部容器中打开 http/https 链接，其他二维码或文本不会直接影响系统。</text>
				<view class="blocked-card" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }">
					<text class="blocked-label" :style="{ color: theme.textTertiary }">扫码/打开内容</text>
					<text class="blocked-raw" :style="{ color: theme.textPrimary }">{{ rawContent || '无可展示内容' }}</text>
				</view>
				<view class="blocked-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleCopy">
					<text class="blocked-btn-text">复制内容</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { normalizeWebUrl, readSecureBrowserTitle } from '../../utils/secure-browser.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const pageTitle = ref('安全浏览')
	const webUrl = ref('')
	const rawContent = ref('')
	const source = ref('external')
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const sourceTag = computed(() : string => {
		if (source.value === 'scan') {
			return '扫码结果'
		}
		if (source.value === 'message') {
			return '消息外链'
		}
		if (source.value === 'file') {
			return '文件访问'
		}
		return '外部内容'
	})

	const addressText = computed(() : string => {
		if (webUrl.value !== '') {
			return webUrl.value
		}
		return rawContent.value !== '' ? rawContent.value : '未识别到可安全打开的链接'
	})

	function handleBack() {
		uni.navigateBack()
	}

	function safeDecode(value : any) : string {
		if (value == null) {
			return ''
		}
		try {
			return decodeURIComponent(String(value))
		} catch (e) {
			return String(value)
		}
	}

	function handleCopy() {
		if (addressText.value === '') {
			uni.showToast({
				title: '暂无可复制内容',
				icon: 'none'
			})
			return
		}
		uni.setClipboardData({
			data: addressText.value,
			success: () => {
				uni.showToast({
					title: '已复制',
					icon: 'success'
				})
			}
		})
	}

	onLoad((options : any) => {
		pageTitle.value = readSecureBrowserTitle(options != null ? options['title'] : '', '安全浏览')
		source.value = options != null && options['source'] != null ? String(options['source']) : 'external'
		rawContent.value = options != null && options['raw'] != null ? safeDecode(options['raw']) : ''
		const rawUrl = options != null && options['url'] != null ? safeDecode(options['url']) : ''
		webUrl.value = normalizeWebUrl(rawUrl)
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 84px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 16px;
		font-weight: 600;
		max-width: 180px;
	}

	.header-right {
		width: 84px;
	}

	.address-bar {
		padding: 10px 12px;
		border-bottom-width: 0.5px;
	}

	.address-tag {
		font-size: 11px;
		color: #1677FF;
		background-color: #E8F2FF;
		padding: 2px 8px;
		border-radius: 10px;
		align-self: flex-start;
	}

	.address-text {
		margin-top: 6px;
		font-size: 12px;
	}

	.content {
		flex: 1;
	}

	.webview {
		flex: 1;
	}

	.blocked-wrap {
		flex: 1;
		padding: 32px 20px;
		align-items: center;
	}

	.blocked-title {
		font-size: 20px;
		font-weight: 600;
	}

	.blocked-desc {
		margin-top: 10px;
		font-size: 14px;
		text-align: center;
		line-height: 22px;
	}

	.blocked-card {
		width: 100%;
		margin-top: 22px;
		padding: 16px;
		border-radius: 14px;
		border-width: 0.5px;
		border-color: transparent;
	}

	.blocked-label {
		font-size: 13px;
	}

	.blocked-raw {
		margin-top: 10px;
		font-size: 14px;
		line-height: 22px;
	}

	.blocked-btn {
		margin-top: 22px;
		width: 100%;
		height: 46px;
		background-color: #1677FF;
		border-radius: 23px;
		justify-content: center;
		align-items: center;
	}

	.blocked-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}
</style>
