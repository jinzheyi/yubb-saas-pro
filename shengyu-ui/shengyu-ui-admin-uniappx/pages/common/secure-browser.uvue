<template>
	<view class="page" :style="{ backgroundColor: theme.pageBg }">
		<view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
		<view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
			<view class="header-left" @click.stop="handleBack">
				<text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
				<text class="back-text" :style="{ color: theme.headerText }">{{ t('common.back') }}</text>
			</view>
			<text class="header-title" :style="{ color: theme.headerText }" :numberOfLines="1">{{ pageTitle }}</text>
			<view class="header-right"></view>
		</view>

		<view class="address-bar" :style="{ backgroundColor: theme.cardBg, borderBottomColor: theme.borderColor }">
			<text class="address-tag" :style="{ color: theme.brandPrimary, backgroundColor: theme.brandPrimarySoft }">{{ sourceTag }}</text>
			<text class="address-text" :style="{ color: theme.textSecondary }" :numberOfLines="1">{{ addressText }}</text>
		</view>

		<view class="content">
			<web-view v-if="webUrl !== ''" :src="webUrl" class="webview"></web-view>
			<view v-if="webUrl !== ''" class="web-actions" :style="{ backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
				<view class="action-btn action-btn-secondary" :style="{ borderColor: theme.borderColor }" @click="handleCopy">
					<text class="action-btn-text action-btn-text-secondary" :style="{ color: theme.textPrimary }">{{ t('runtime.secureBrowser.copyLink') }}</text>
				</view>
				<view v-if="canOpenExternal" class="action-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleOpenExternal">
					<text class="action-btn-text">{{ t('runtime.secureBrowser.openExternally') }}</text>
				</view>
			</view>

			<view v-else class="blocked-wrap">
				<text class="blocked-title" :style="{ color: theme.textPrimary }">{{ t('runtime.secureBrowser.blockedTitle') }}</text>
				<text class="blocked-desc" :style="{ color: theme.textSecondary }">{{ t('runtime.secureBrowser.blockedDesc') }}</text>
				<view class="blocked-card" :style="{ backgroundColor: theme.cardBg, borderColor: theme.borderColor }">
					<text class="blocked-label" :style="{ color: theme.textTertiary }">{{ t('runtime.secureBrowser.blockedLabel') }}</text>
					<text class="blocked-raw" :style="{ color: theme.textPrimary }">{{ rawContent || t('runtime.secureBrowser.emptyContent') }}</text>
				</view>
				<view class="blocked-actions">
					<view class="blocked-btn blocked-btn-secondary" :style="{ borderColor: theme.borderColor }" @click="handleCopy">
						<text class="blocked-btn-text blocked-btn-text-secondary" :style="{ color: theme.textPrimary }">{{ t('runtime.secureBrowser.copyContent') }}</text>
					</view>
					<view v-if="canOpenExternal" class="blocked-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleOpenExternal">
						<text class="blocked-btn-text">{{ t('runtime.secureBrowser.openExternally') }}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad, onUnload } from '@dcloudio/uni-app'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { canOpenExternalUrl, openExternalUrl } from '../../utils/external-url.uts'
	import { normalizeWebUrl, readSecureBrowserTitle } from '../../utils/secure-browser.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()

	const pageTitle = ref('')
	const webUrl = ref('')
	const rawContent = ref('')
	const source = ref('external')
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	const sourceTag = computed(() : string => {
		if (source.value === 'scan') {
			return t('runtime.secureBrowser.tagScan')
		}
		if (source.value === 'message') {
			return t('runtime.secureBrowser.tagMessage')
		}
		if (source.value === 'file') {
			return t('runtime.secureBrowser.tagFile')
		}
		return t('runtime.secureBrowser.tagExternal')
	})

	const addressText = computed(() : string => {
		if (webUrl.value !== '') {
			return webUrl.value
		}
		return rawContent.value !== '' ? rawContent.value : t('runtime.secureBrowser.unknownSafeLink')
	})

	const canOpenExternal = computed(() : boolean => {
		return canOpenExternalUrl() && addressText.value.trim() !== ''
	})

	function handleBack() {
		uni.navigateBack()
	}

	function safeDecode(value : any) : string {
		if (value == null) {
			return ''
		}
		try {
			return decodeURIComponent(String(value))
		} catch (e) {
			return String(value)
		}
	}

	function handleCopy() {
		if (addressText.value === '') {
			uni.showToast({
				title: t('runtime.secureBrowser.nothingToCopy'),
				icon: 'none'
			})
			return
		}
		uni.setClipboardData({
			data: addressText.value,
			success: () => {
				uni.showToast({
					title: t('runtime.secureBrowser.copySuccess'),
					icon: 'success'
				})
			}
		})
	}

	async function handleOpenExternal() {
		try {
			if (addressText.value.trim() === '') {
				return
			}
			await openExternalUrl(addressText.value)
		} catch (e) {
			uni.showToast({
				title: t('runtime.secureBrowser.openExternalFailed'),
				icon: 'none'
			})
		}
	}

	onLoad((options : any) => {
		pageTitle.value = readSecureBrowserTitle(options != null ? options['title'] : '', t('runtime.secureBrowser.title'))
		source.value = options != null && options['source'] != null ? String(options['source']) : 'external'
		rawContent.value = options != null && options['raw'] != null ? safeDecode(options['raw']) : ''
		const rawUrl = options != null && options['url'] != null ? safeDecode(options['url']) : ''
		webUrl.value = normalizeWebUrl(rawUrl)
	})

	onUnload(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.page {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
	}

	.header {
		height: 44px;
		flex-direction: row;
		align-items: center;
		padding: 0 12px;
		justify-content: space-between;
		border-bottom-width: 0.5px;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
		width: 84px;
	}

	.back-icon {
		font-size: 20px;
	}

	.back-text {
		font-size: 16px;
		margin-left: 4px;
	}

	.header-title {
		font-size: 16px;
		font-weight: 600;
		max-width: 180px;
	}

	.header-right {
		width: 84px;
	}

	.address-bar {
		padding: 10px 12px;
		border-bottom-width: 0.5px;
	}

	.address-tag {
		font-size: 11px;
		color: #1677FF;
		background-color: #E8F2FF;
		padding: 2px 8px;
		border-radius: 10px;
		align-self: flex-start;
	}

	.address-text {
		margin-top: 6px;
		font-size: 12px;
	}

	.content {
		flex: 1;
		flex-direction: column;
	}

	.webview {
		flex: 1;
	}

	.blocked-wrap {
		flex: 1;
		padding: 32px 20px;
		align-items: center;
	}

	.blocked-title {
		font-size: 20px;
		font-weight: 600;
	}

	.blocked-desc {
		margin-top: 10px;
		font-size: 14px;
		text-align: center;
		line-height: 22px;
	}

	.blocked-card {
		width: 100%;
		margin-top: 22px;
		padding: 16px;
		border-radius: 14px;
		border-width: 0.5px;
		border-color: transparent;
	}

	.blocked-label {
		font-size: 13px;
	}

	.blocked-raw {
		margin-top: 10px;
		font-size: 14px;
		line-height: 22px;
	}

	.blocked-btn {
		width: 100%;
		height: 46px;
		border-radius: 23px;
		justify-content: center;
		align-items: center;
	}

	.blocked-btn-text {
		font-size: 16px;
		color: #FFFFFF;
		font-weight: 500;
	}

	.blocked-btn-secondary {
		background-color: transparent;
		border-width: 0.5px;
	}

	.blocked-btn-text-secondary {
		color: #111111;
	}

	.blocked-actions {
		margin-top: 22px;
		width: 100%;
	}

	.web-actions {
		flex-direction: row;
		justify-content: center;
		padding: 12px 16px 16px 16px;
		border-top-width: 0.5px;
	}

	.action-btn {
		padding: 10px 16px;
		border-radius: 8px;
		margin: 0 6px;
	}

	.action-btn-secondary {
		background-color: transparent;
		border-width: 0.5px;
	}

	.action-btn-text {
		color: #FFFFFF;
		font-size: 14px;
	}

	.action-btn-text-secondary {
		color: #111111;
	}
</style>
