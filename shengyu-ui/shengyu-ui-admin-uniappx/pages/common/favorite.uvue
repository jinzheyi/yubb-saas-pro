<template>
  <view class="page">
    <view class="status-bar"></view>
    <view class="header">
      <view class="header-left" @click="handleBack">
        <text class="iconfont back-icon">&#xeb04;</text>
      </view>
      <text class="header-title">{{ t('favoritePage.title') }}</text>
      <view class="header-right"></view>
    </view>

    <view class="filter-wrap">
      <view class="search-box">
        <input class="search-input" :value="searchKeyword" placeholder="搜索" @input="handleSearchInput" />
      </view>
      <scroll-view class="tab-scroll" scroll-x show-scrollbar="false">
        <view class="tab-list">
          <view
            v-for="tab in tabs"
            :key="tab.key"
            class="tab-item"
            :class="{ 'tab-item-active': currentTab === tab.key }"
            @click="switchTab(tab.key)"
          >
            <text class="tab-text" :class="{ 'tab-text-active': currentTab === tab.key }">{{ tab.label }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <scroll-view
      class="list"
      scroll-y
      show-scrollbar="false"
      @scrolltolower="loadMore"
      refresher-enabled="true"
      :refresher-triggered="refreshing"
      @refresherrefresh="handleRefresh"
    >
      <view v-if="displayItems.length === 0 && !loading" class="empty">
        <text class="empty-text">{{ t('favoritePage.empty') }}</text>
      </view>

      <view
        v-for="item in displayItems"
        :key="item.favoriteId"
        class="card"
        @click="handleItemClick(item)"
        @longpress="handleItemLongPress(item)"
      >
        <view class="card-head">
          <text class="card-type">{{ item.typeLabel }}</text>
          <text class="card-time">{{ formatTime(item.sendTime || item.favoriteTime) }}</text>
        </view>
        <view class="card-body">
          <view class="card-main">
            <text class="card-title" :numberOfLines="2">{{ item.title }}</text>
            <text v-if="item.subTitle !== ''" class="card-sub" :numberOfLines="1">{{ item.subTitle }}</text>
          </view>
          <image v-if="item.thumb !== ''" class="card-thumb" :src="item.thumb" mode="aspectFill" />
          <view v-else-if="item.kind === 'file'" class="card-file-icon">
            <text class="iconfont card-file-glyph">&#xea96;</text>
          </view>
        </view>
      </view>

      <view v-if="loading" class="loading">
        <text class="loading-text">{{ t('favoritePage.loading') }}</text>
      </view>
      <view v-else-if="!hasMore && items.length > 0" class="loading">
        <text class="loading-text">{{ t('favoritePage.noMore') }}</text>
      </view>
      <view v-else-if="displayItems.length > 0" class="loading">
        <text class="loading-text">上拉加载更多</text>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { useI18n } from '../../hooks/useI18n.uts'
import { getFavoriteList, removeFavorite, searchFavoriteList } from '../../api/favorite.uts'

type FavoriteItem = {
  favoriteId: string
  messageId: string
  messageType: number
  messagePreview: string
  messageContent: string
  messageExtra: string
  messageSnapshot: string
  sendTime: string
  favoriteTime: string
}

type FavoriteDisplayItem = FavoriteItem & {
  kind: string
  title: string
  subTitle: string
  thumb: string
  typeLabel: string
  searchText: string
}

const items = ref<FavoriteItem[]>([])
const pageNo = ref(1)
const pageSize = ref(20)
const hasMore = ref(true)
const loading = ref(false)
const refreshing = ref(false)
const totalCount = ref(0)
const searchKeyword = ref('')
const currentTab = ref('default')
const { t } = useI18n()
const SEARCH_DEBOUNCE_MS = 300
const SAME_QUERY_DEDUPE_MS = 1200
let searchDebounceTimer: any = null
let latestRequestToken = 0
let pendingResetFetch = false
const recentQueryResultCache = new Map<string, { at: number, data: any }>()

const tabs = [
  { key: 'default', label: '默认' },
  { key: 'normal', label: '普通消息' },
  { key: 'media', label: '图片与视频' },
  { key: 'file', label: '文件' }
]

function handleBack(): void {
  uni.navigateBack()
}

function handleSearchInput(e: any): void {
  const next = e != null && e.detail != null && e.detail.value != null ? String(e.detail.value) : ''
  searchKeyword.value = next
  scheduleSearch()
}

function switchTab(tabKey: string): void {
  currentTab.value = tabKey
  scheduleSearch()
}

function normalizeKeyword(raw: any): string {
  return raw != null ? String(raw).trim() : ''
}

function buildQueryCacheKey(keyword: string, tab: string, pageNoVal: number, pageSizeVal: number): string {
  return keyword + '|' + tab + '|' + pageNoVal + '|' + pageSizeVal
}

function canUseServerSearchByKeyword(keyword: string): boolean {
  const len = keyword.length
  return len >= 2 && len <= 64
}

function normalizePageResponse(resp: any): { listRaw: any[], total: number, hasMore: boolean | null } {
  const listRaw: any[] = resp != null && Array.isArray(resp.list) ? resp.list : []
  const totalVal = resp != null && resp.total != null ? Number(resp.total) : listRaw.length
  const hasMoreRaw = resp != null ? (resp as any).hasMore : null
  const hasMoreVal = typeof hasMoreRaw === 'boolean' ? hasMoreRaw : null
  return {
    listRaw: listRaw,
    total: isNaN(totalVal) ? listRaw.length : totalVal,
    hasMore: hasMoreVal
  }
}

function scheduleSearch(): void {
  if (searchDebounceTimer != null) {
    clearTimeout(searchDebounceTimer)
    searchDebounceTimer = null
  }
  searchDebounceTimer = setTimeout(() => {
    void fetchPage(true)
  }, SEARCH_DEBOUNCE_MS)
}

function pruneRecentQueryResultCache(now: number): void {
  if (recentQueryResultCache.size <= 80) {
    return
  }
  const keys: string[] = []
  recentQueryResultCache.forEach((_, k) => {
    keys.push(k)
  })
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    const item = recentQueryResultCache.get(key)
    if (item == null || now - item.at > SAME_QUERY_DEDUPE_MS) {
      recentQueryResultCache.delete(key)
    }
  }
  if (recentQueryResultCache.size <= 100) {
    return
  }
  let trimCount = recentQueryResultCache.size - 100
  const keyList: string[] = []
  recentQueryResultCache.forEach((_, k) => {
    keyList.push(k)
  })
  for (let i = 0; i < keyList.length && trimCount > 0; i++) {
    recentQueryResultCache.delete(keyList[i])
    trimCount--
  }
}

function formatTime(raw: string): string {
  try {
    if (raw == null || String(raw).trim() === '') {
      return ''
    }
    const rawText = String(raw).trim()
    let d = new Date(rawText)
    if (isNaN(d.getTime()) && /^[0-9]+$/.test(rawText)) {
      const numVal = Number(rawText)
      if (!isNaN(numVal) && numVal > 0) {
        d = new Date(rawText.length <= 10 ? (numVal * 1000) : numVal)
      }
    }
    if (isNaN(d.getTime())) {
      return String(raw)
    }
    const year = d.getFullYear()
    const nowYear = new Date().getFullYear()
    const mm = d.getMonth() + 1
    const dd = d.getDate()
    if (year === nowYear) {
      return mm + '月' + dd + '日'
    }
    return year + '年' + mm + '月' + dd + '日'
  } catch (e) {
    return ''
  }
}

function buildTypeText(type: number): string {
  if (type === 1) return t('favoritePage.type.text')
  if (type === 2) return t('favoritePage.type.image')
  if (type === 3) return t('favoritePage.type.voice')
  if (type === 4) return t('favoritePage.type.video')
  if (type === 5) return t('favoritePage.type.file')
  if (type === 6) return t('favoritePage.type.location')
  if (type === 8) return t('favoritePage.type.sticker')
  if (type === 9) return t('favoritePage.type.custom')
  return t('favoritePage.type.default')
}

function normalizeFavoriteItem(raw: any): FavoriteItem {
  return {
    favoriteId: raw != null && raw.favoriteId != null ? String(raw.favoriteId) : '0',
    messageId: raw != null && raw.messageId != null ? String(raw.messageId) : '0',
    messageType: raw != null && raw.messageType != null ? Number(raw.messageType) : 0,
    messagePreview: raw != null && raw.messagePreview != null ? String(raw.messagePreview) : '',
    messageContent: raw != null && raw.messageContent != null ? String(raw.messageContent) : '',
    messageExtra: raw != null && raw.messageExtra != null ? String(raw.messageExtra) : '',
    messageSnapshot: raw != null && raw.messageSnapshot != null ? String(raw.messageSnapshot) : '',
    sendTime: raw != null && raw.sendTime != null ? String(raw.sendTime) : '',
    favoriteTime: raw != null && raw.favoriteTime != null ? String(raw.favoriteTime) : ''
  }
}

function safeParseJson(raw: any): any | null {
  try {
    if (raw == null) {
      return null
    }
    if (typeof raw === 'object') {
      return raw
    }
    const text = String(raw).trim()
    if (text === '') {
      return null
    }
    const first = text.charAt(0)
    const last = text.charAt(text.length - 1)
    if (!((first === '{' && last === '}') || (first === '[' && last === ']'))) {
      return null
    }
    return JSON.parse(text)
  } catch (e) {
    return null
  }
}

function looksLikeLinkContent(raw: string): boolean {
  if (raw == null) {
    return false
  }
  const value = String(raw).trim()
  if (value === '') {
    return false
  }
  return /^https?:\/\/\S+$/i.test(value) || /^www\.\S+$/i.test(value)
}

function resolveUrlFromObject(obj: any): string {
  if (obj == null || typeof obj !== 'object') {
    return ''
  }
  const direct = obj.url != null ? String(obj.url).trim() : ''
  if (direct !== '') {
    return direct
  }
  const link = obj.link != null ? String(obj.link).trim() : ''
  if (link !== '') {
    return link
  }
  const href = obj.href != null ? String(obj.href).trim() : ''
  if (href !== '') {
    return href
  }
  const nested = obj.content
  if (nested != null) {
    if (typeof nested === 'string') {
      const contentText = String(nested).trim()
      if (looksLikeLinkContent(contentText)) {
        return contentText
      }
    } else if (typeof nested === 'object') {
      const nestedUrl = resolveUrlFromObject(nested)
      if (nestedUrl !== '') {
        return nestedUrl
      }
    }
  }
  return ''
}

function extractText(raw: any): string {
  if (raw == null) {
    return ''
  }
  if (typeof raw === 'string') {
    return String(raw)
  }
  if (typeof raw === 'object') {
    if (raw.content != null && String(raw.content) !== '') {
      return String(raw.content)
    }
    if (raw.text != null && String(raw.text) !== '') {
      return String(raw.text)
    }
    if (raw.title != null && String(raw.title) !== '') {
      return String(raw.title)
    }
  }
  return ''
}

function resolveNameFromObject(obj: any): string {
  if (obj == null || typeof obj !== 'object') {
    return ''
  }
  const fileName = obj.fileName != null ? String(obj.fileName).trim() : ''
  if (fileName !== '') {
    return fileName
  }
  const name = obj.name != null ? String(obj.name).trim() : ''
  if (name !== '') {
    return name
  }
  const filename = obj.filename != null ? String(obj.filename).trim() : ''
  if (filename !== '') {
    return filename
  }
  const title = obj.title != null ? String(obj.title).trim() : ''
  if (title !== '') {
    return title
  }
  const nested = obj.content
  if (nested != null && typeof nested === 'object') {
    const nestedName = resolveNameFromObject(nested)
    if (nestedName !== '') {
      return nestedName
    }
  }
  return ''
}

function buildFileSizeText(size: number): string {
  if (size <= 0) {
    return ''
  }
  if (size < 1024) {
    return size + 'B'
  }
  if (size < 1024 * 1024) {
    return (size / 1024).toFixed(1) + 'KB'
  }
  if (size < 1024 * 1024 * 1024) {
    return (size / 1024 / 1024).toFixed(1) + 'MB'
  }
  return (size / 1024 / 1024 / 1024).toFixed(1) + 'GB'
}

function buildDisplayItem(item: FavoriteItem): FavoriteDisplayItem {
  let kind = 'text'
  let title = item.messagePreview || t('favoritePage.preview.default')
  let subTitle = ''
  let thumb = ''
  let typeLabel = buildTypeText(item.messageType)

  const parsedContent = safeParseJson(item.messageContent)
  const parsedExtra = safeParseJson(item.messageExtra)
  const parsedSnapshot = safeParseJson(item.messageSnapshot)
  const snapshotContent = parsedSnapshot != null && parsedSnapshot.content != null ? safeParseJson((parsedSnapshot as any).content) : null
  const snapshotExtra = parsedSnapshot != null && parsedSnapshot.extra != null ? safeParseJson((parsedSnapshot as any).extra) : null

  if (item.messageType === 1) {
    const textContent = extractText(parsedContent != null ? parsedContent : item.messageContent).trim()
    if (looksLikeLinkContent(textContent)) {
      kind = 'link'
      title = textContent
      subTitle = textContent
      typeLabel = '普通消息'
    } else {
      kind = 'text'
      title = textContent !== '' ? textContent : title
      typeLabel = '普通消息'
    }
  } else if (item.messageType === 2) {
    kind = 'image'
    const imageUrl =
      resolveUrlFromObject(parsedContent) ||
      resolveUrlFromObject(parsedExtra) ||
      resolveUrlFromObject(snapshotContent) ||
      resolveUrlFromObject(snapshotExtra) ||
      (item.messageContent != null ? String(item.messageContent).trim() : '')
    const imageName =
      resolveNameFromObject(parsedContent) ||
      resolveNameFromObject(parsedExtra) ||
      resolveNameFromObject(snapshotContent) ||
      resolveNameFromObject(snapshotExtra)
    const previewText = item.messagePreview != null ? String(item.messagePreview).trim() : ''
    const safePreviewText = looksLikeLinkContent(previewText) ? '' : previewText
    thumb = imageUrl
    subTitle = ''
    title = imageName !== '' ? imageName : (safePreviewText !== '' ? safePreviewText : '图片')
    typeLabel = '图片'
  } else if (item.messageType === 4) {
    kind = 'video'
    const coverFromExtra = parsedExtra != null && typeof parsedExtra === 'object'
      ? (String((parsedExtra as any).cover || (parsedExtra as any).thumbnail || (parsedExtra as any).thumbUrl || ''))
      : ''
    thumb = coverFromExtra
    subTitle = ''
    title = item.messagePreview || '[视频]'
    typeLabel = '视频'
  } else if (item.messageType === 5) {
    kind = 'file'
    const fileObj = parsedExtra != null && typeof parsedExtra === 'object'
      ? parsedExtra
      : (snapshotExtra != null && typeof snapshotExtra === 'object' ? snapshotExtra : null)
    const fileName = fileObj != null && (fileObj as any).fileName != null ? String((fileObj as any).fileName) : ''
    const fileSizeRaw = fileObj != null && (fileObj as any).size != null ? Number((fileObj as any).size) : 0
    title = fileName !== '' ? fileName : (item.messagePreview || '[文件]')
    subTitle = buildFileSizeText(fileSizeRaw)
    typeLabel = '文件'
  } else if (item.messageType === 9) {
    const customObj = (parsedContent != null && typeof parsedContent === 'object')
      ? parsedContent
      : ((parsedExtra != null && typeof parsedExtra === 'object') ? parsedExtra : null)
    const customType = customObj != null && (customObj as any).type != null ? String((customObj as any).type).toUpperCase() : ''
    const customUrl =
      resolveUrlFromObject(customObj) ||
      resolveUrlFromObject(snapshotContent) ||
      resolveUrlFromObject(snapshotExtra)
    if (customType === 'LINK' || customType === 'URL' || customType === 'WEB_LINK' || customUrl !== '') {
      kind = 'link'
      const customTitle = customObj != null && (customObj as any).title != null ? String((customObj as any).title) : ''
      title = customTitle !== '' ? customTitle : (customUrl !== '' ? customUrl : title)
      subTitle = customUrl
      typeLabel = '普通消息'
    } else {
      kind = 'text'
      title = item.messagePreview || t('favoritePage.preview.default')
      typeLabel = '普通消息'
    }
  } else {
    kind = 'text'
    title = item.messagePreview || t('favoritePage.preview.default')
    typeLabel = '普通消息'
  }

  const searchText = (title + ' ' + subTitle + ' ' + typeLabel).toLowerCase()
  return {
    ...item,
    kind: kind,
    title: title,
    subTitle: subTitle,
    thumb: thumb,
    typeLabel: typeLabel,
    searchText: searchText
  }
}

function isTabMatch(item: FavoriteDisplayItem): boolean {
  if (currentTab.value === 'default') {
    return true
  }
  if (currentTab.value === 'normal') {
    return item.kind !== 'image' && item.kind !== 'video' && item.kind !== 'file'
  }
  if (currentTab.value === 'media') {
    return item.kind === 'image' || item.kind === 'video'
  }
  if (currentTab.value === 'file') {
    return item.kind === 'file'
  }
  return true
}

const displayItems = computed((): FavoriteDisplayItem[] => {
  const mapped = items.value.map((it: FavoriteItem) => buildDisplayItem(it))
  return mapped.filter((it: FavoriteDisplayItem) => {
    if (!isTabMatch(it)) {
      return false
    }
    return true
  })
})

async function fetchPage(reset: boolean): Promise<void> {
  if (loading.value) {
    if (reset) {
      pendingResetFetch = true
    }
    return
  }
  if (!reset && !hasMore.value) {
    return
  }
  loading.value = true
  const requestToken = ++latestRequestToken
  try {
    const nextPage = reset ? 1 : pageNo.value
    const tab = currentTab.value != null && String(currentTab.value).trim() !== '' ? String(currentTab.value).trim() : 'default'
    const keyword = normalizeKeyword(searchKeyword.value)
    if (keyword !== '' && !canUseServerSearchByKeyword(keyword)) {
      if (reset) {
        items.value = []
        totalCount.value = 0
        hasMore.value = false
        pageNo.value = 1
      }
      return
    }
    const useServerSearch = keyword !== ''
    let resp: any = null
    if (useServerSearch) {
      const cacheKey = buildQueryCacheKey(keyword, tab, nextPage, pageSize.value)
      const now = Date.now()
      pruneRecentQueryResultCache(now)
      const cached = recentQueryResultCache.get(cacheKey)
      if (cached != null && now - cached.at <= SAME_QUERY_DEDUPE_MS) {
        resp = cached.data
      } else {
        resp = await searchFavoriteList(keyword, tab, nextPage, pageSize.value)
        recentQueryResultCache.set(cacheKey, { at: now, data: resp })
      }
    } else {
      resp = await getFavoriteList(nextPage, pageSize.value)
    }
    if (requestToken !== latestRequestToken) {
      return
    }
    const pageData = normalizePageResponse(resp)
    const nextItems = pageData.listRaw.map((it: any) => normalizeFavoriteItem(it))
    if (reset) {
      items.value = nextItems
    } else {
      items.value = items.value.concat(nextItems)
    }
    totalCount.value = pageData.total
    hasMore.value = pageData.hasMore != null ? pageData.hasMore : (items.value.length < totalCount.value)
    pageNo.value = nextPage + 1
  } catch (e) {
    console.error('[Favorite] 加载失败:', e)
    uni.showToast({ title: t('favoritePage.toast.loadFailed'), icon: 'none' })
  } finally {
    if (requestToken === latestRequestToken) {
      loading.value = false
      if (pendingResetFetch) {
        pendingResetFetch = false
        void fetchPage(true)
      }
    }
  }
}

function loadMore(): void {
  void fetchPage(false)
}

function handleRefresh(): void {
  if (refreshing.value || loading.value) {
    return
  }
  refreshing.value = true
  void fetchPage(true).finally(() => {
    refreshing.value = false
  })
}

function handleItemClick(item: FavoriteDisplayItem): void {
  const favoriteId = item.favoriteId
  if (favoriteId === '' || favoriteId === '0') {
    uni.showToast({ title: t('favoritePage.toast.openFailed'), icon: 'none' })
    return
  }
  uni.navigateTo({
    url: '/pages/common/favorite-detail?favoriteId=' + encodeURIComponent(favoriteId)
  })
}

function handleItemLongPress(item: FavoriteDisplayItem): void {
  uni.showActionSheet({
    itemList: [t('favoritePage.action.cancelFavorite')],
    success: async (res) => {
      const idx = res != null && (res as any).tapIndex != null ? Number((res as any).tapIndex) : -1
      if (idx !== 0) {
        return
      }
      try {
        if (item.favoriteId === '' || item.favoriteId === '0') {
          uni.showToast({ title: t('favoritePage.toast.invalidItem'), icon: 'none' })
          return
        }
        await removeFavorite(item.favoriteId)
        items.value = items.value.filter((it) => it.favoriteId !== item.favoriteId)
        const nextTotal = totalCount.value > 0 ? totalCount.value - 1 : 0
        totalCount.value = nextTotal
        hasMore.value = items.value.length < totalCount.value
        uni.showToast({ title: t('favoritePage.toast.cancelSuccess'), icon: 'success' })
      } catch (e) {
        console.error('[Favorite] 取消收藏失败:', e)
        uni.showToast({ title: t('favoritePage.toast.actionFailed'), icon: 'none' })
      }
    }
  })
}

onLoad(() => {
  void fetchPage(true)
})

onUnload(() => {
  if (searchDebounceTimer != null) {
    clearTimeout(searchDebounceTimer)
    searchDebounceTimer = null
  }
  pendingResetFetch = false
  recentQueryResultCache.clear()
})
</script>

<style>
.page { height: 100%; background-color: #F5F6F8; display: flex; flex-direction: column; }
.status-bar { height: var(--status-bar-height); background-color: #FFFFFF; }
.header { height: 44px; padding: 0 12px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #FFFFFF; }
.header-left { width: 40px; height: 44px; justify-content: center; }
.header-right { width: 40px; height: 44px; }
.back-icon { font-size: 18px; color: #1F2329; }
.header-title { font-size: 18px; color: #1F2329; font-weight: 600; }
.filter-wrap { background-color: #FFFFFF; padding: 0 12px 8px; border-bottom-width: 0.5px; border-bottom-color: #ECEFF3; }
.search-box { height: 36px; border-radius: 10px; background-color: #F3F4F6; justify-content: center; padding: 0 12px; }
.search-input { width: 100%; font-size: 14px; color: #1F2329; }
.tab-scroll { margin-top: 10px; white-space: nowrap; }
.tab-list { flex-direction: row; align-items: center; }
.tab-item { padding: 4px 10px; margin-right: 12px; border-radius: 12px; background-color: transparent; }
.tab-item-active { background-color: #ECEFF7; }
.tab-text { font-size: 14px; color: #8A93A0; }
.tab-text-active { color: #4064A7; font-weight: 600; }
.list { flex: 1; height: 0; padding: 10px 10px 0; }
.card { background-color: #FFFFFF; border-radius: 12px; padding: 12px; margin-bottom: 10px; }
.card-head { flex-direction: row; align-items: center; justify-content: space-between; }
.card-type { font-size: 12px; color: #8A93A0; }
.card-time { font-size: 12px; color: #9AA3AF; }
.card-body { margin-top: 8px; flex-direction: row; align-items: flex-start; }
.card-main { flex: 1; min-width: 0; }
.card-title { font-size: 28rpx; color: #1F2329; line-height: 42rpx; }
.card-sub { margin-top: 6px; font-size: 12px; color: #8A93A0; }
.card-thumb { width: 64px; height: 64px; border-radius: 8px; margin-left: 12px; background-color: #ECEFF3; }
.card-file-icon { width: 64px; height: 64px; border-radius: 8px; margin-left: 12px; background-color: #F1F4FA; justify-content: center; align-items: center; }
.card-file-glyph { font-size: 26px; color: #4B70D0; }
