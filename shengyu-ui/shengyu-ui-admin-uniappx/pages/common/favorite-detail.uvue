<template>
  <view class="page" :style="{ backgroundColor: theme.pageBg }">
    <view class="status-bar" :style="{ backgroundColor: theme.headerBg }"></view>
    <view class="header" :style="{ backgroundColor: theme.headerBg, borderBottomColor: theme.borderColor }">
      <view class="header-left" @click="handleBack">
        <text class="iconfont back-icon" :style="{ color: theme.headerText }">&#xeb04;</text>
      </view>
      <text class="header-title" :style="{ color: theme.headerText }">{{ t('favoriteDetail.title') }}</text>
      <view class="header-right"></view>
    </view>

    <scroll-view class="content" scroll-y show-scrollbar="false">
      <view v-if="loading" class="loading-wrap">
        <text class="loading-text" :style="{ color: theme.textTertiary }">{{ t('favoriteDetail.loading') }}</text>
      </view>
      <view v-else-if="detail == null" class="empty-wrap">
        <text class="empty-text" :style="{ color: theme.textTertiary }">{{ t('favoriteDetail.empty') }}</text>
      </view>
      <view v-else class="card" :style="{ backgroundColor: theme.cardBg }">
        <view class="card-head">
          <text class="type" :style="{ color: theme.textTertiary }">{{ renderData.typeLabel }}</text>
          <text class="time" :style="{ color: theme.textTertiary }">{{ formatTime(detail.favoriteTime || detail.sendTime) }}</text>
        </view>

        <view class="body">
          <view v-if="renderData.kind === 'text'" class="text-block">
            <text class="text-content" :style="{ color: theme.textPrimary }">{{ renderData.text }}</text>
          </view>

          <view v-else-if="renderData.kind === 'image'" class="image-block">
            <image class="image-content" :src="renderData.url" mode="widthFix" @click="handlePreviewImage(renderData.url)" />
          </view>

          <view v-else-if="renderData.kind === 'video'" class="video-block" @click="handleOpenVideo(renderData.url)">
            <image v-if="renderData.thumb !== ''" class="video-cover" :src="renderData.thumb" mode="aspectFill" />
            <view v-else class="video-placeholder">
              <text class="video-placeholder-text">{{ renderData.title }}</text>
            </view>
            <view class="video-mask">
              <text class="iconfont video-play">&#xe602;</text>
            </view>
            <text v-if="renderData.url !== ''" class="video-url" :style="{ color: theme.textSecondary }" :numberOfLines="1">{{ renderData.url }}</text>
          </view>

          <view v-else-if="renderData.kind === 'file'" class="file-block" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleOpenFile(renderData)">
            <view class="file-icon-wrap" :style="{ backgroundColor: theme.brandPrimarySoft }">
              <text class="iconfont file-icon">&#xea96;</text>
            </view>
            <view class="file-main">
              <text class="file-name" :style="{ color: theme.textPrimary }">{{ renderData.fileName }}</text>
              <text v-if="renderData.fileSize !== ''" class="file-size" :style="{ color: theme.textTertiary }">{{ renderData.fileSize }}</text>
            </view>
          </view>

          <view v-else-if="renderData.kind === 'link'" class="link-block" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleOpenLink(renderData.url)">
            <text class="link-title" :style="{ color: theme.textPrimary }">{{ renderData.title }}</text>
            <text class="link-url" :style="{ color: theme.brandPrimary }">{{ renderData.url }}</text>
          </view>

          <view v-else-if="renderData.kind === 'location'" class="file-block" :style="{ backgroundColor: theme.cardBgMuted }" @click="handleOpenLocation(renderData)">
            <view class="file-icon-wrap" :style="{ backgroundColor: theme.brandPrimarySoft }">
              <text class="iconfont file-icon">&#xea72;</text>
            </view>
            <view class="file-main">
              <text class="file-name" :style="{ color: theme.textPrimary }">{{ renderData.title }}</text>
              <text class="file-size" :style="{ color: theme.textTertiary }">{{ renderData.text }}</text>
            </view>
          </view>

          <view v-else class="text-block">
            <text class="text-content" :style="{ color: theme.textPrimary }">{{ detail.messagePreview || t('favoritePage.preview.default') }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view v-if="detail != null" class="footer" :style="{ backgroundColor: theme.cardBg, borderTopColor: theme.borderColor }">
      <view class="send-btn" :style="{ backgroundColor: theme.brandPrimary }" @click="handleSendToChat">
        <text class="send-btn-text">{{ t('favoriteDetail.sendToChat') }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { onLoad, onUnload } from '@dcloudio/uni-app'
import { useI18n } from '../../hooks/useI18n.uts'
import { previewImages } from '../../utils/media-preview.uts'
import { getFavoriteDetail } from '../../api/favorite.uts'
import { buildLocationClipboardPayload, openLocationWithFallback } from '../../utils/location.uts'
import { navToFilePreview } from '../../utils/nav.uts'
import { navToSecureBrowser } from '../../utils/secure-browser.uts'
import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
import type { ThemeTokens } from '../../config/theme.uts'

type FavoriteDetail = {
  favoriteId: string
  messageType: number
  messagePreview: string
  messageContent: string
  messageExtra: string
  messageSnapshot: string
  sendTime: string
  favoriteTime: string
}

type FavoriteRenderData = {
  kind: string
  typeLabel: string
  text: string
  title: string
  url: string
  fileId: string
  thumb: string
  fileName: string
  fileSize: string
  latitude: number
  longitude: number
}

const { t } = useI18n()
const loading = ref(false)
const favoriteId = ref('')
const detail = ref<FavoriteDetail | null>(null)
const theme = ref<ThemeTokens>(getThemeTokens())
let unsubscribeTheme: (() => void) | null = null

unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
  theme.value = tokens
})

function handleBack(): void {
  uni.navigateBack()
}

function formatTime(raw: string): string {
  try {
    if (raw == null || String(raw).trim() === '') {
      return ''
    }
    const rawText = String(raw).trim()
    let d = new Date(rawText)
    if (isNaN(d.getTime()) && /^[0-9]+$/.test(rawText)) {
      const numVal = Number(rawText)
      if (!isNaN(numVal) && numVal > 0) {
        d = new Date(rawText.length <= 10 ? (numVal * 1000) : numVal)
      }
    }
    if (isNaN(d.getTime())) {
      return String(raw)
    }
    const year = d.getFullYear()
    const nowYear = new Date().getFullYear()
    const mm = d.getMonth() + 1
    const dd = d.getDate()
    if (year === nowYear) {
      return t('favoriteDetail.dateSameYear', { month: mm, day: dd })
    }
    return t('favoriteDetail.dateWithYear', { year, month: mm, day: dd })
  } catch (e) {
    return ''
  }
}

function buildTypeText(type: number): string {
  if (type === 1) return t('favoritePage.type.text')
  if (type === 2) return t('favoritePage.type.image')
  if (type === 3) return t('favoritePage.type.voice')
  if (type === 4) return t('favoritePage.type.video')
  if (type === 5) return t('favoritePage.type.file')
  if (type === 6) return t('favoritePage.type.location')
  if (type === 8) return t('favoritePage.type.sticker')
  if (type === 9) return t('favoritePage.type.custom')
  return t('favoritePage.type.default')
}

function normalizeFavoriteDetail(raw: any): FavoriteDetail {
  return {
    favoriteId: raw != null && raw.favoriteId != null ? String(raw.favoriteId) : '0',
    messageType: raw != null && raw.messageType != null ? Number(raw.messageType) : 0,
    messagePreview: raw != null && raw.messagePreview != null ? String(raw.messagePreview) : '',
    messageContent: raw != null && raw.messageContent != null ? String(raw.messageContent) : '',
    messageExtra: raw != null && raw.messageExtra != null ? String(raw.messageExtra) : '',
    messageSnapshot: raw != null && raw.messageSnapshot != null ? String(raw.messageSnapshot) : '',
    sendTime: raw != null && raw.sendTime != null ? String(raw.sendTime) : '',
    favoriteTime: raw != null && raw.favoriteTime != null ? String(raw.favoriteTime) : ''
  }
}

function safeParseJson(raw: any): any | null {
  try {
    if (raw == null) {
      return null
    }
    if (typeof raw === 'object') {
      return raw
    }
    const text = String(raw).trim()
    if (text === '') {
      return null
    }
    const first = text.charAt(0)
    const last = text.charAt(text.length - 1)
    if (!((first === '{' && last === '}') || (first === '[' && last === ']'))) {
      return null
    }
    return JSON.parse(text)
  } catch (e) {
    return null
  }
}

function looksLikeLinkContent(raw: string): boolean {
  if (raw == null) {
    return false
  }
  const value = String(raw).trim()
  if (value === '') {
    return false
  }
  return /^https?:\/\/\S+$/i.test(value) || /^www\.\S+$/i.test(value)
}

function ensureLinkScheme(raw: string): string {
  const url = raw != null ? String(raw).trim() : ''
  if (url === '') {
    return ''
  }
  if (/^https?:\/\//i.test(url)) {
    return url
  }
  if (/^www\./i.test(url)) {
    return 'https://' + url
  }
  return url
}

function resolveUrlFromObject(obj: any): string {
  if (obj == null || typeof obj !== 'object') {
    return ''
  }
  const direct = obj.url != null ? String(obj.url).trim() : ''
  if (direct !== '') {
    return direct
  }
  const link = obj.link != null ? String(obj.link).trim() : ''
  if (link !== '') {
    return link
  }
  const href = obj.href != null ? String(obj.href).trim() : ''
  if (href !== '') {
    return href
  }
  const nested = obj.content
  if (nested != null) {
    if (typeof nested === 'string') {
      const contentText = String(nested).trim()
      if (looksLikeLinkContent(contentText)) {
        return contentText
      }
    } else if (typeof nested === 'object') {
      const nestedUrl = resolveUrlFromObject(nested)
      if (nestedUrl !== '') {
        return nestedUrl
      }
    }
  }
  return ''
}

function resolveFileIdFromObject(obj: any): string {
  if (obj == null || typeof obj !== 'object') {
    return ''
  }
  const direct = obj.fileId != null ? String(obj.fileId).trim() : ''
  if (direct !== '' && direct !== '0') {
    return direct
  }
  const alt = obj.file_id != null ? String(obj.file_id).trim() : ''
  if (alt !== '' && alt !== '0') {
    return alt
  }
  const nested = obj.content
  if (nested != null && typeof nested === 'object') {
    const nestedId = resolveFileIdFromObject(nested)
    if (nestedId !== '') {
      return nestedId
    }
  }
  return ''
}

function extractText(raw: any): string {
  if (raw == null) {
    return ''
  }
  if (typeof raw === 'string') {
    return String(raw)
  }
  if (typeof raw === 'object') {
    if (raw.content != null && String(raw.content) !== '') {
      return String(raw.content)
    }
    if (raw.text != null && String(raw.text) !== '') {
      return String(raw.text)
    }
    if (raw.title != null && String(raw.title) !== '') {
      return String(raw.title)
    }
  }
  return ''
}

function buildFileSizeText(size: number): string {
  if (size <= 0) {
    return ''
  }
  if (size < 1024) {
    return size + 'B'
  }
  if (size < 1024 * 1024) {
    return (size / 1024).toFixed(1) + 'KB'
  }
  if (size < 1024 * 1024 * 1024) {
    return (size / 1024 / 1024).toFixed(1) + 'MB'
  }
  return (size / 1024 / 1024 / 1024).toFixed(1) + 'GB'
}

function buildRenderData(item: FavoriteDetail | null): FavoriteRenderData {
  const fallback: FavoriteRenderData = {
    kind: 'text',
    typeLabel: t('favoritePage.type.default'),
    text: t('favoritePage.preview.default'),
    title: t('favoritePage.preview.default'),
    url: '',
    fileId: '',
    thumb: '',
    fileName: '',
    fileSize: '',
    latitude: NaN,
    longitude: NaN
  }
  if (item == null) {
    return fallback
  }

  const parsedContent = safeParseJson(item.messageContent)
  const parsedExtra = safeParseJson(item.messageExtra)
  const parsedSnapshot = safeParseJson(item.messageSnapshot)
  const snapshotContent = parsedSnapshot != null && parsedSnapshot.content != null ? safeParseJson((parsedSnapshot as any).content) : null
  const snapshotExtra = parsedSnapshot != null && parsedSnapshot.extra != null ? safeParseJson((parsedSnapshot as any).extra) : null

  const result: FavoriteRenderData = {
    kind: 'text',
    typeLabel: buildTypeText(item.messageType),
    text: item.messagePreview || t('favoritePage.preview.default'),
    title: item.messagePreview || t('favoritePage.preview.default'),
    url: '',
    fileId: '',
    thumb: '',
    fileName: '',
    fileSize: '',
    latitude: NaN,
    longitude: NaN
  }

  if (item.messageType === 1) {
    const textContent = extractText(parsedContent != null ? parsedContent : item.messageContent).trim()
    if (looksLikeLinkContent(textContent)) {
      result.kind = 'link'
      result.typeLabel = t('favoriteDetail.type.link')
      result.title = textContent
      result.url = ensureLinkScheme(textContent)
    } else {
      result.kind = 'text'
      result.typeLabel = t('favoriteDetail.type.note')
      result.text = textContent !== '' ? textContent : result.text
      result.title = result.text
    }
    return result
  }

  if (item.messageType === 2) {
    const imageUrl =
      resolveUrlFromObject(parsedContent) ||
      resolveUrlFromObject(parsedExtra) ||
      resolveUrlFromObject(snapshotContent) ||
      resolveUrlFromObject(snapshotExtra) ||
      (item.messageContent != null ? String(item.messageContent).trim() : '')
    result.kind = 'image'
    result.typeLabel = t('favoriteDetail.type.image')
    result.url = imageUrl
    result.title = item.messagePreview || t('message.preview.image')
    return result
  }

  if (item.messageType === 4) {
    const videoUrl =
      resolveUrlFromObject(parsedContent) ||
      resolveUrlFromObject(parsedExtra) ||
      resolveUrlFromObject(snapshotContent) ||
      resolveUrlFromObject(snapshotExtra) ||
      (item.messageContent != null ? String(item.messageContent).trim() : '')
    const cover = parsedExtra != null && typeof parsedExtra === 'object'
      ? String((parsedExtra as any).cover || (parsedExtra as any).thumbnail || (parsedExtra as any).thumbUrl || '')
      : ''
    result.kind = 'video'
    result.typeLabel = t('favoriteDetail.type.video')
    result.url = videoUrl
    result.thumb = cover
    result.title = item.messagePreview || t('message.preview.video')
    return result
  }

  if (item.messageType === 5) {
    const fileObj = parsedExtra != null && typeof parsedExtra === 'object'
      ? parsedExtra
      : (snapshotExtra != null && typeof snapshotExtra === 'object' ? snapshotExtra : null)
    const fileUrl =
      resolveUrlFromObject(fileObj) ||
      resolveUrlFromObject(parsedContent) ||
      resolveUrlFromObject(snapshotContent) ||
      (item.messageContent != null ? String(item.messageContent).trim() : '')
    const fileId =
      resolveFileIdFromObject(fileObj) ||
      resolveFileIdFromObject(parsedContent) ||
      resolveFileIdFromObject(snapshotContent) ||
      resolveFileIdFromObject(snapshotExtra)
    const fileName = fileObj != null && (fileObj as any).fileName != null
      ? String((fileObj as any).fileName)
      : (item.messagePreview || t('message.preview.file'))
    const fileSizeVal = fileObj != null && (fileObj as any).size != null ? Number((fileObj as any).size) : 0
    result.kind = 'file'
    result.typeLabel = t('favoriteDetail.type.file')
    result.fileName = fileName
    result.fileSize = buildFileSizeText(fileSizeVal)
    result.url = fileUrl
    result.fileId = fileId
    result.title = fileName
    return result
  }

  if (item.messageType === 6) {
    const locationObj = parsedContent != null && typeof parsedContent === 'object'
      ? parsedContent
      : (snapshotContent != null && typeof snapshotContent === 'object' ? snapshotContent : null)
    const latitude = locationObj != null && (locationObj as any).latitude != null ? Number((locationObj as any).latitude) : NaN
    const longitude = locationObj != null && (locationObj as any).longitude != null ? Number((locationObj as any).longitude) : NaN
    const address = locationObj != null && (locationObj as any).address != null ? String((locationObj as any).address) : ''
    const locationName = locationObj != null && (locationObj as any).name != null
      ? String((locationObj as any).name)
      : (locationObj != null && (locationObj as any).locationName != null ? String((locationObj as any).locationName) : address)
    result.kind = 'location'
    result.typeLabel = t('favoritePage.type.location')
    result.title = locationName !== '' ? locationName : t('chat.label.locationDefault')
    result.text = address !== '' ? address : t('chat.label.locationCoordinate')
    result.latitude = latitude
    result.longitude = longitude
    return result
  }

  if (item.messageType === 9) {
    const customObj = (parsedContent != null && typeof parsedContent === 'object')
      ? parsedContent
      : ((parsedExtra != null && typeof parsedExtra === 'object') ? parsedExtra : null)
    const customType = customObj != null && (customObj as any).type != null ? String((customObj as any).type).toUpperCase() : ''
    const customUrl =
      resolveUrlFromObject(customObj) ||
      resolveUrlFromObject(snapshotContent) ||
      resolveUrlFromObject(snapshotExtra)
    if (customType === 'LINK' || customType === 'URL' || customType === 'WEB_LINK' || customUrl !== '') {
      const customTitle = customObj != null && (customObj as any).title != null ? String((customObj as any).title) : ''
      result.kind = 'link'
      result.typeLabel = t('favoriteDetail.type.link')
      result.title = customTitle !== '' ? customTitle : (customUrl !== '' ? customUrl : result.title)
      result.url = ensureLinkScheme(customUrl)
      return result
    }
  }

  result.kind = 'text'
  result.text = item.messagePreview || t('favoritePage.preview.default')
  result.title = result.text
  return result
}

const renderData = computed((): FavoriteRenderData => buildRenderData(detail.value))

async function loadDetail(): Promise<void> {
  if (favoriteId.value === '' || favoriteId.value === '0') {
    uni.showToast({ title: t('favoriteDetail.toast.invalidId'), icon: 'none' })
    return
  }
  loading.value = true
  try {
    const resp: any = await getFavoriteDetail(favoriteId.value)
    detail.value = normalizeFavoriteDetail(resp)
  } catch (e) {
    console.error('[FavoriteDetail] load failed:', e)
    uni.showToast({ title: t('favoriteDetail.toast.loadFailed'), icon: 'none' })
  } finally {
    loading.value = false
  }
}

function handlePreviewImage(url: string): void {
  if (url == null || String(url).trim() === '') {
    return
  }
  void previewImages([String(url)]).catch((_err) => {
    uni.showToast({ title: t('favoriteDetail.toast.loadFailed'), icon: 'none' })
  })
}

function handleOpenVideo(url: string): void {
  const finalUrl = url != null ? String(url).trim() : ''
  if (finalUrl === '') {
    uni.showToast({ title: t('favoriteDetail.toast.videoUrlEmpty'), icon: 'none' })
    return
  }
  uni.navigateTo({
    url: `/pages/message/video-player?url=${encodeURIComponent(finalUrl)}&title=${encodeURIComponent(renderData.value.title)}`
  })
}

function handleOpenFile(data: FavoriteRenderData): void {
  const fid = data != null && data.fileId != null ? String(data.fileId).trim() : ''
  const url = data != null && data.url != null ? String(data.url).trim() : ''
  const name = data != null && data.fileName != null && String(data.fileName).trim() !== ''
    ? String(data.fileName)
    : (data != null && data.title != null ? String(data.title) : '')
  if (fid === '' && url === '') {
    uni.showToast({ title: t('favoriteDetail.toast.fileUrlEmpty'), icon: 'none' })
    return
  }
  navToFilePreview({
    fileId: fid !== '' ? fid : null,
    url: url !== '' ? url : null,
    name: name !== '' ? name : null
  })
}

function handleCopyText(value: string, successText: string): void {
  const text = value != null ? String(value).trim() : ''
  if (text === '') {
    return
  }
  uni.setClipboardData({
    data: text,
    success: () => {
      uni.showToast({ title: successText, icon: 'none' })
    }
  })
}

function handleOpenLink(url: string): void {
  const finalUrl = ensureLinkScheme(url)
  if (finalUrl === '') {
    return
  }
  try {
    const globalAny: any = globalThis as any
    if (globalAny != null && globalAny.window != null && globalAny.window.open != null) {
      globalAny.window.open(finalUrl, '_blank')
      return
    }
  } catch (e) {
    // ignore
  }
  navToSecureBrowser(finalUrl, renderData.value.title, 'external')
}

function handleOpenLocation(data: FavoriteRenderData): void {
  const latitude = data != null ? Number(data.latitude) : NaN
  const longitude = data != null ? Number(data.longitude) : NaN
  if (isNaN(latitude) || isNaN(longitude)) {
    uni.showToast({ title: t('chat.toast.locationMissing'), icon: 'none' })
    return
  }
  const opened = openLocationWithFallback({
    latitude: latitude,
    longitude: longitude,
    name: data.title != null ? String(data.title) : '',
    address: data.text != null ? String(data.text) : ''
  })
  if (!opened) {
    uni.setClipboardData({
      data: buildLocationClipboardPayload(
        data.title != null ? String(data.title) : '',
        data.text != null ? String(data.text) : '',
        latitude,
        longitude
      )
    })
  }
}

function handleSendToChat(): void {
  if (favoriteId.value === '' || favoriteId.value === '0') {
    uni.showToast({ title: t('favoriteDetail.toast.invalidId'), icon: 'none' })
    return
  }
  uni.navigateTo({
    url: '/pages/message/forward-target?favoriteId=' + encodeURIComponent(favoriteId.value)
  })
}

onLoad((options: any) => {
  const fid = options != null && options['favoriteId'] != null ? String(options['favoriteId']) : ''
  favoriteId.value = fid
  void loadDetail()
})

onUnload(() => {
  if (unsubscribeTheme != null) {
    unsubscribeTheme()
    unsubscribeTheme = null
  }
})
</script>

<style>
.page { height: 100%; display: flex; flex-direction: column; }
.status-bar { height: var(--status-bar-height); }
.header { height: 44px; padding: 0 12px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 0.5px; }
.header-left { width: 40px; height: 44px; justify-content: center; }
.header-right { width: 40px; height: 44px; }
.back-icon { font-size: 18px; }
.header-title { font-size: 16px; font-weight: 600; }
.content { flex: 1; height: 0; }
.loading-wrap { padding-top: 80px; align-items: center; }
.loading-text { font-size: 14px; }
.empty-wrap { padding-top: 80px; align-items: center; }
.empty-text { font-size: 14px; }
.card { margin: 12px; border-radius: 12px; padding: 12px; }
.card-head { flex-direction: row; align-items: center; justify-content: space-between; }
.type { font-size: 12px; color: #8A93A0; }
.time { font-size: 12px; color: #9AA3AF; }
.body { margin-top: 10px; }
.text-content { font-size: 15px; line-height: 24px; }
.image-block { border-radius: 10px; overflow: hidden; background-color: #F3F4F6; }
.image-content { width: 100%; border-radius: 10px; }
.video-block { border-radius: 10px; overflow: hidden; position: relative; background-color: #111111; }
.video-cover { width: 100%; height: 220px; }
.video-placeholder { height: 180px; justify-content: center; align-items: center; padding: 0 16px; }
.video-placeholder-text { color: #FFFFFF; font-size: 14px; }
.video-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 30px; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.2); }
.video-play { color: #FFFFFF; font-size: 42px; }
.video-url { padding: 6px 10px 8px; color: #D4D9E1; font-size: 12px; }
.file-block { flex-direction: row; align-items: flex-start; padding: 12px; border-radius: 10px; }
.file-icon-wrap { width: 44px; height: 44px; border-radius: 8px; background-color: #E7EEFD; justify-content: center; align-items: center; margin-right: 10px; }
