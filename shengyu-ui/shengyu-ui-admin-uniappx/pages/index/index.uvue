<template>
	<view class="content">
		<image class="logo" src="/static/logo.png"></image>
		<text class="title">{{title}}</text>
		<view class="button-area">
			<button @click="logout">退出登录</button>
		</view>
	</view>
</template>

<script lang="uts">
	import { isLoggedIn, clearAuthInfo } from '@/utils/auth.uts'
	import { logout as logoutApi } from '@/api/auth.uts'
		export default {
		data() {
			return {
				title: '企业即时通讯'
			}
		},
		onLoad() {
			// 检查登录状态
			this.checkLoginStatus()
		},
		methods: {
			checkLoginStatus() {
				// 如果未登录，跳转到登录页
				if (!isLoggedIn()) {
					uni.redirectTo({
						url: '/pages/login/login'
					})
					return
				}
			},
			async logout() {
				try {
					// 调用登出接口
					await logoutApi()
				} catch (error) {
					console.error('登出失败', error)
				} finally {
					// 清除本地认证信息
					clearAuthInfo()
					// 跳转到登录页
					uni.redirectTo({
						url: '/pages/login/login'
					})
				}
			}
		}
	}
</script>

<style>
	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		padding: 20px;
	}

	.logo {
		height: 100px;
		width: 100px;
		margin: 20px auto 25px auto;
	}

	.title {
		font-size: 18px;
		color: #333;
    text-align: center;
    margin-bottom: 40px;
	}
	
	.button-area {
		margin-top: 20px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 100%;
		max-width: 400px;
	}
</style>
