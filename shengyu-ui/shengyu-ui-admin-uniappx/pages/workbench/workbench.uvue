<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<text class="header-title">{{ t('workbench.title') }}</text>
			<text class="edit-btn">{{ t('workbench.edit') }}</text>
		</view>

		<scroll-view class="content" scroll-y="true">
			<!-- 办公流程 -->
			<view class="section">
				<view class="section-header">
					<text class="section-title">{{ t('workbench.officeProcess') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
				<view class="grid">
					<view class="grid-item" v-for="(item, index) in processList" :key="index" @click="handleAction(item)">
						<view class="icon-wrap" :style="{ backgroundImage: item.gradient }">
							<text class="iconfont grid-icon">{{ item.icon }}</text>
							<view v-if="item.badge" class="badge">
								<text class="badge-text">{{ item.badge }}</text>
							</view>
						</view>
						<text class="grid-label">{{ t(item.nameKey) }}</text>
					</view>
				</view>
			</view>

			<!-- 常用功能 -->
			<view class="section mt-2">
				<view class="section-header">
					<text class="section-title">{{ t('workbench.commonFeatures') }}</text>
					<text class="iconfont arrow-icon">&#xea8d;</text>
				</view>
				<view class="grid">
					<view class="grid-item" v-for="(item, index) in featureList" :key="index" @click="handleAction(item)">
						<view class="icon-wrap" :style="{ backgroundImage: item.gradient }">
							<text class="iconfont grid-icon">{{ item.icon }}</text>
						</view>
						<text class="grid-label">{{ t(item.nameKey) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	const processList = [
		{ nameKey: 'workbench.todo', icon: '\uea83', gradient: 'linear-gradient(135deg, #fb923c, #f97316)', badge: '99+' },
		{ nameKey: 'workbench.done', icon: '\uea81', gradient: 'linear-gradient(135deg, #34d399, #10b981)', badge: '' },
		{ nameKey: 'workbench.finished', icon: '\uea80', gradient: 'linear-gradient(135deg, #fb7185, #f43f5e)', badge: '' },
		{ nameKey: 'workbench.myStarted', icon: '\uea97', gradient: 'linear-gradient(135deg, #38bdf8, #0ea5e9)', badge: '' },
		{ nameKey: 'workbench.newProcess', icon: '\uea9d', gradient: 'linear-gradient(135deg, #3b82f6, #2563eb)', badge: '' }
	]

	const featureList = [
		{ nameKey: 'workbench.notice', icon: '\uea93', gradient: 'linear-gradient(135deg, #fb923c, #f97316)' },
		{ nameKey: 'workbench.doc', icon: '\uea96', gradient: 'linear-gradient(135deg, #34d399, #10b981)' },
		{ nameKey: 'workbench.meeting', icon: '\uea94', gradient: 'linear-gradient(135deg, #2dd4bf, #14b8a6)' },
		{ nameKey: 'workbench.schedule', icon: '\uea8c', gradient: 'linear-gradient(135deg, #38bdf8, #0ea5e9)' },
		{ nameKey: 'workbench.mail', icon: '\uea93', gradient: 'linear-gradient(135deg, #fbbf24, #f59e0b)' },
		{ nameKey: 'workbench.proxy', icon: '\uea73', gradient: 'linear-gradient(135deg, #60a5fa, #3b82f6)' },
		{ nameKey: 'workbench.switchAccount', icon: '\uea9e', gradient: 'linear-gradient(135deg, #818cf8, #6366f1)' },
		{ nameKey: 'workbench.attendance', icon: '\uea81', gradient: 'linear-gradient(135deg, #60a5fa, #2563eb)' },
		{ nameKey: 'workbench.field', icon: '\uea72', gradient: 'linear-gradient(135deg, #fb923c, #f59e0b)' }
	]

	function handleAction(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}
</script>

