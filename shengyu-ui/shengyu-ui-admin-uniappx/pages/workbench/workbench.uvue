<template>
	<view class="container">
		<view class="header">
			<text class="title">工作台</text>
		</view>
		
		<scroll-view class="content" scroll-y>
			<!-- 快捷入口 -->
			<view class="section">
				<text class="section-title">快捷入口</text>
				<view class="grid">
					<view 
						v-for="(item, index) in quickEntries" 
						:key="index"
						class="grid-item"
						@click="handleEntryClick(item)"
					>
						<view class="icon-wrapper" :style="{ background: item.color }">
							<text class="icon">{{ item.icon }}</text>
						</view>
						<text class="label">{{ item.label }}</text>
					</view>
				</view>
			</view>
			
			<!-- 待办事项 -->
			<view class="section">
				<text class="section-title">待办事项</text>
				<view class="todo-list">
					<view 
						v-for="(item, index) in todoList" 
						:key="index"
						class="todo-item"
						@click="handleTodoClick(item)"
					>
						<view class="todo-left">
							<text class="todo-title">{{ item.title }}</text>
							<text class="todo-time">{{ item.time }}</text>
						</view>
						<view class="todo-badge">{{ item.count }}</view>
					</view>
					
					<view v-if="todoList.length === 0" class="empty">
						<text class="empty-text">暂无待办事项</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	// 快捷入口
	const quickEntries = ref<any[]>([
		{ icon: '📝', label: '审批', color: '#667eea' },
		{ icon: '📊', label: '报表', color: '#f093fb' },
		{ icon: '📁', label: '文件', color: '#4facfe' },
		{ icon: '⚙️', label: '设置', color: '#43e97b' }
	])
	
	// 待办事项
	const todoList = ref<any[]>([
		{
			id: 1,
			title: '待审批流程',
			time: '今天',
			count: 3
		},
		{
			id: 2,
			title: '待处理任务',
			time: '本周',
			count: 5
		}
	])
	
	// 点击快捷入口
	function handleEntryClick(item: any) {
		uni.showToast({
			title: item.label + '功能开发中',
			icon: 'none'
		})
	}
	
	// 点击待办事项
	function handleTodoClick(item: any) {
		uni.showToast({
			title: '待办详情功能开发中',
			icon: 'none'
		})
	}
</script>

