<template>
	<view class="page">
		<view class="status-bar"></view>
		<view class="header">
			<text class="header-title">{{ t('workbench.title') }}</text>
			<text class="edit-btn">{{ t('workbench.edit') }}</text>
		</view>

		<scroll-view class="content" scroll-y="true" show-scrollbar="false">
			<!-- 办公流程 -->
			<view class="section">
				<view class="section-header" @click="isProcessExpanded = !isProcessExpanded">
					<text class="section-title">{{ t('workbench.officeProcess') }}</text>
					<text class="iconfont arrow-icon">{{ isProcessExpanded ? '\ue68d' : '\ue60e' }}</text>
				</view>
				<view class="grid" v-if="isProcessExpanded">
					<view class="grid-item" hover-class="grid-item-active" v-for="(item, index) in processList" :key="index" @click="handleAction(item)">
						<view class="icon-wrap" :style="{ backgroundImage: item.gradient }">
							<text class="iconfont grid-icon">{{ item.icon }}</text>
							<view v-if="item.badge > 0" class="badge">
								<text class="badge-text">{{ item.badge > 99 ? '99+' : item.badge }}</text>
							</view>
						</view>
						<text class="grid-label">{{ t(item.nameKey) }}</text>
					</view>
				</view>
			</view>

			<!-- 常用功能 -->
			<view class="section mt-2">
				<view class="section-header" @click="isFeatureExpanded = !isFeatureExpanded">
					<text class="section-title">{{ t('workbench.commonFeatures') }}</text>
					<text class="iconfont arrow-icon">{{ isFeatureExpanded ? '\ue68d' : '\ue60e' }}</text>
				</view>
				<view class="grid" v-if="isFeatureExpanded">
					<view class="grid-item" hover-class="grid-item-active" v-for="(item, index) in featureList" :key="index" @click="handleAction(item)">
						<view class="icon-wrap" :style="{ backgroundImage: item.gradient }">
							<text class="iconfont grid-icon">{{ item.icon }}</text>
						</view>
						<text class="grid-label">{{ t(item.nameKey) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'
	import { badgeService, type BadgeData, type BadgeListener } from '../../services/badge-service.uts'
	import { tabBarBadgeService } from '../../services/tab-bar-badge-service.uts'

	const { t } = useI18n()
	const isProcessExpanded = ref(true)
	const isFeatureExpanded = ref(true)

	const processList = ref([
		{ nameKey: 'workbench.todo', icon: '\uea83', gradient: 'linear-gradient(135deg, #fb923c, #f97316)', badge: 0 },
		{ nameKey: 'workbench.done', icon: '\uea81', gradient: 'linear-gradient(135deg, #34d399, #10b981)', badge: 0 },
		{ nameKey: 'workbench.finished', icon: '\uea80', gradient: 'linear-gradient(135deg, #fb7185, #f43f5e)', badge: 0 },
		{ nameKey: 'workbench.myStarted', icon: '\uea97', gradient: 'linear-gradient(135deg, #38bdf8, #0ea5e9)', badge: 0 },
		{ nameKey: 'workbench.newProcess', icon: '\uea9d', gradient: 'linear-gradient(135deg, #3b82f6, #2563eb)', badge: 0 }
	])

	const featureList = [
		{ nameKey: 'workbench.notice', icon: '\uea93', gradient: 'linear-gradient(135deg, #fb923c, #f97316)' },
		{ nameKey: 'workbench.doc', icon: '\uea96', gradient: 'linear-gradient(135deg, #34d399, #10b981)' },
		{ nameKey: 'workbench.meeting', icon: '\uea94', gradient: 'linear-gradient(135deg, #2dd4bf, #14b8a6)' },
		{ nameKey: 'workbench.schedule', icon: '\uea8c', gradient: 'linear-gradient(135deg, #38bdf8, #0ea5e9)' },
		{ nameKey: 'workbench.mail', icon: '\uea93', gradient: 'linear-gradient(135deg, #fbbf24, #f59e0b)' },
		{ nameKey: 'workbench.proxy', icon: '\uea73', gradient: 'linear-gradient(135deg, #60a5fa, #3b82f6)' },
		{ nameKey: 'workbench.switchAccount', icon: '\uea9e', gradient: 'linear-gradient(135deg, #818cf8, #6366f1)' },
		{ nameKey: 'workbench.attendance', icon: '\uea81', gradient: 'linear-gradient(135deg, #60a5fa, #2563eb)' },
		{ nameKey: 'workbench.field', icon: '\uea72', gradient: 'linear-gradient(135deg, #fb923c, #f59e0b)' }
	]

	// 角标监听器
	let badgeListener: BadgeListener | null = null

	/**
	 * 将 nameKey 转换为 menuId
	 */
	function getMenuId(nameKey: string): string {
		// 提取 nameKey 的最后一部分作为 menuId
		// 例如: 'workbench.todo' -> 'todo'
		const parts = nameKey.split('.')
		return parts[parts.length - 1]
	}

	/**
	 * 更新菜单角标
	 */
	function updateMenuBadges(badgeData: BadgeData): void {
		processList.value.forEach((item: any) => {
			const menuId = getMenuId(item.nameKey)
			const badgeCount = badgeData.menuBadges.get(menuId) || 0
			item.badge = badgeCount
		})
	}

	onMounted(() => {
		console.log('[Workbench] 页面挂载，添加角标监听器')
		
		// 创建角标监听器
		badgeListener = {
			onBadgeUpdate: (badgeData: BadgeData) => {
				console.log('[Workbench] 收到角标更新通知')
				updateMenuBadges(badgeData)
			}
		}
		
		// 添加监听器
		badgeService.addListener(badgeListener)
		
		// 立即更新一次角标（使用当前缓存的数据）
		const currentBadgeData: BadgeData = {
			totalUnread: badgeService.getTotalUnread(),
			conversationBadges: new Map<number, number>(),
			menuBadges: new Map<string, number>(),
			lastUpdateTime: 0
		}
		
		// 手动填充 menuBadges
		processList.value.forEach((item: any) => {
			const menuId = getMenuId(item.nameKey)
			const badgeCount = badgeService.getMenuBadge(menuId)
			currentBadgeData.menuBadges.set(menuId, badgeCount)
		})
		
		updateMenuBadges(currentBadgeData)
	})

	onShow(() => {
		tabBarBadgeService.refresh()
	})

	onUnmounted(() => {
		console.log('[Workbench] 页面卸载，移除角标监听器')
		
		// 移除监听器
		if (badgeListener !== null) {
			badgeService.removeListener(badgeListener)
			badgeListener = null
		}
	})

	function handleAction(item : any) {
		uni.showToast({
			title: t(item.nameKey) + '功能开发中',
			icon: 'none'
		})
	}
</script>

<style>
	/* 页面基础样式 */
	.page {
		height: 100%;
		background-color: #FFFFFF;
		display: flex;
		flex-direction: column;
	}

	.status-bar {
		height: var(--status-bar-height);
		background-color: #FFFFFF;
	}

	.header {
		background-color: #FFFFFF;
		padding: 8px 16px 12px 16px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.header-title {
		color: #1F2329;
		font-size: 20px;
		font-weight: 600;
		height: 44px;
		line-height: 44px;
	}

	.edit-btn {
		color: #1677FF;
		font-size: 16px;
	}

	.content {
		flex: 1;
		height: 0;
		background-color: #FFFFFF;
	}

	.section {
		padding: 12px 16px;
	}

	.section-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}

	.section-title {
		font-size: 14px;
		color: #1F2329;
		font-weight: 600;
	}

	.arrow-icon {
		font-size: 14px;
		color: #8F959E;
	}

	.grid {
		flex-direction: row;
		flex-wrap: wrap;
		margin: 0 -8px;
	}

	.grid-item {
		width: 25%;
		align-items: center;
		padding: 12px 0;
	}

	.grid-item-active {
		background-color: #F5F7FA;
		border-radius: 8px;
	}

	.icon-wrap {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		justify-content: center;
		align-items: center;
		margin-bottom: 8px;
		position: relative;
	}

	.grid-icon {
		color: #FFFFFF;
		font-size: 22px;
	}

	.grid-label {
		font-size: 12px;
		color: #1F2329;
		font-weight: 400;
	}

	.badge {
		position: absolute;
		top: -6px;
		right: -6px;
		background-color: #F54A45;
		border-radius: 10px;
		min-width: 18px;
		height: 18px;
		padding: 0 4px;
		justify-content: center;
		align-items: center;
		border-width: 1.5px;
		border-color: #FFFFFF;
	}

	.badge-text {
		color: #FFFFFF;
		font-size: 10px;
		font-weight: bold;
	}

	.mt-2 {
		margin-top: 8px;
	}
</style>
