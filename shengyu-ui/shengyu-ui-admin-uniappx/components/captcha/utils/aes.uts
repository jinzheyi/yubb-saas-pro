/**
 * AES 加密工具
 * 使用 ECB 模式和 PKCS5/PKCS7 填充
 * 
 * UniApp X 原生 AES 加密实现
 * 兼容 crypto-js 的 AES.encrypt 方法
 * 
 * 支持平台：
 * - Android: 使用 javax.crypto.Cipher
 * - iOS: 使用 CommonCrypto (需要 Swift 桥接)
 * - Web: 使用 crypto-js 库
 */

// #ifdef APP-ANDROID
import Cipher from 'javax.crypto.Cipher';
import SecretKeySpec from 'javax.crypto.spec.SecretKeySpec';
import Base64 from 'android.util.Base64';
// #endif

/**
 * AES 加密
 * @param word 要加密的内容
 * @param keyWord 密钥（16 字节）
 * @returns Base64 编码的加密字符串
 */
export function aesEncrypt(word: string, keyWord: string): string {
	// #ifdef APP-ANDROID
	return aesEncryptAndroid(word, keyWord)
	// #endif
	
	// #ifdef APP-IOS
	return aesEncryptIOS(word, keyWord)
	// #endif
	
	// #ifdef H5
	return aesEncryptWeb(word, keyWord)
	// #endif
	
	// #ifndef APP-ANDROID || APP-IOS || H5
	// 其他平台暂不支持
	console.warn('当前平台暂不支持 AES 加密')
	return word
	// #endif
}

/**
 * AES 解密
 * @param word 要解密的内容（Base64）
 * @param keyWord 密钥
 * @returns 解密后的字符串
 */
export function aesDecrypt(word: string, keyWord: string): string {
	// #ifdef APP-ANDROID
	return aesDecryptAndroid(word, keyWord)
	// #endif
	
	// #ifdef APP-IOS
	return aesDecryptIOS(word, keyWord)
	// #endif
	
	// #ifdef H5
	return aesDecryptWeb(word, keyWord)
	// #endif
	
	// #ifndef APP-ANDROID || APP-IOS || H5
	return word
	// #endif
}

// #ifdef APP-ANDROID
/**
 * Android 平台 AES 加密
 * 使用 javax.crypto.Cipher
 */
function aesEncryptAndroid(word: string, keyWord: string): string {
	try {
		// 创建密钥
		const keyBytes = keyWord.toByteArray('utf-8')
		const secretKey = new SecretKeySpec(keyBytes, 'AES')
		
		// 创建加密器 - ECB 模式，PKCS5Padding 填充
		const cipher = Cipher.getInstance('AES/ECB/PKCS5Padding')
		cipher.init(Cipher.ENCRYPT_MODE, secretKey)
		
		// 加密
		const wordBytes = word.toByteArray('utf-8')
		const encrypted = cipher.doFinal(wordBytes)
		
		// 转换为 Base64
		const base64 = Base64.encodeToString(encrypted, Base64.NO_WRAP)
		
		console.log('AES 加密成功 (Android):', {
			原文长度: word.length,
			密钥长度: keyWord.length,
			结果长度: base64.length
		})
		
		return base64
	} catch (e : Exception) {
		console.error('AES 加密失败 (Android):', e.message)
		// 降级方案：返回明文（仅用于调试）
		return word
	}
}

/**
 * Android 平台 AES 解密
 */
function aesDecryptAndroid(word: string, keyWord: string): string {
	try {
		// 创建密钥
		const keyBytes = keyWord.toByteArray('utf-8')
		const secretKey = new SecretKeySpec(keyBytes, 'AES')
		
		// 创建解密器
		const cipher = Cipher.getInstance('AES/ECB/PKCS5Padding')
		cipher.init(Cipher.DECRYPT_MODE, secretKey)
		
		// Base64 解码
		const encrypted = Base64.decode(word, Base64.NO_WRAP)
		
		// 解密
		const decrypted = cipher.doFinal(encrypted)
		
		// 转换为字符串
		return decrypted.toString('utf-8')
	} catch (e : Exception) {
		console.error('AES 解密失败 (Android):', e.message)
		return word
	}
}
// #endif

// #ifdef APP-IOS
/**
 * iOS 平台 AES 加密
 * 使用 CryptoKit (iOS 13+) 或 CommonCrypto
 * 
 * 注意：由于 UTS 对 iOS 原生 API 的调用较为复杂，
 * 这里提供一个简化的实现框架。
 * 实际使用时可能需要创建 UTS 插件来封装 CommonCrypto。
 */
function aesEncryptIOS(word: string, keyWord: string): string {
	try {
		// 方案 1: 使用 CryptoKit (iOS 13+)
		// 需要导入: import CryptoKit
		// 但 UTS 目前可能不直接支持 CryptoKit
		
		// 方案 2: 使用 CommonCrypto
		// 需要通过 UTS 插件封装 CCCrypt 函数
		
		// 临时方案：调用 Objective-C 桥接方法
		// 假设已经创建了一个 Objective-C 类 AESCryptor
		const encrypted = UTSiOS.invokeMethod(
			'AESCryptor',
			'encryptString:withKey:',
			[word, keyWord]
		)
		
		if (encrypted != null) {
			console.log('AES 加密成功 (iOS):', {
				原文长度: word.length,
				密钥长度: keyWord.length,
				结果长度: encrypted.length
			})
			return encrypted as string
		} else {
			console.error('AES 加密失败 (iOS): 返回 null')
			return word
		}
	} catch (e) {
		console.error('AES 加密失败 (iOS):', e)
		// 降级方案：返回明文（仅用于调试）
		console.warn('iOS 平台 AES 加密失败，返回明文。请确保已实现 AESCryptor 类。')
		return word
	}
}

/**
 * iOS 平台 AES 解密
 */
function aesDecryptIOS(word: string, keyWord: string): string {
	try {
		const decrypted = UTSiOS.invokeMethod(
			'AESCryptor',
			'decryptString:withKey:',
			[word, keyWord]
		)
		
		if (decrypted != null) {
			return decrypted as string
		} else {
			console.error('AES 解密失败 (iOS): 返回 null')
			return word
		}
	} catch (e) {
		console.error('AES 解密失败 (iOS):', e)
		return word
	}
}
// #endif





// #ifdef H5
// @ts-ignore
import CryptoJS from 'crypto-js'

/**
 * Web 平台 AES 加密
 * 使用 crypto-js 库
 *
 * 注意：统一通过 npm 依赖加载，不允许再通过 index.html 或 CDN 注入脚本
 */
function aesEncryptWeb(word: string, keyWord: string): string {
	try {
		const crypto: any = CryptoJS as any
		if (crypto === null || crypto === undefined) {
			console.error('crypto-js 未安装或无法加载：请通过 npm 安装依赖（例如在项目根执行 npm i crypto-js）')
			return word
		}
		
		// 使用 crypto-js 加密
		// @ts-ignore
		const key = crypto.enc.Utf8.parse(keyWord)
		// @ts-ignore
		const srcs = crypto.enc.Utf8.parse(word)
		// @ts-ignore
		const encrypted = crypto.AES.encrypt(srcs, key, {
			// @ts-ignore
			mode: crypto.mode.ECB,
			// @ts-ignore
			padding: crypto.pad.Pkcs7
		})
		
		const result = encrypted.toString()
		
		console.log('AES 加密成功 (Web):', {
			原文长度: word.length,
			密钥长度: keyWord.length,
			结果长度: result.length
		})
		
		return result
	} catch (e) {
		console.error('AES 加密失败 (Web):', e)
		return word
	}
}

/**
 * Web 平台 AES 解密
 */
function aesDecryptWeb(word: string, keyWord: string): string {
	try {
		const crypto: any = CryptoJS as any
		if (crypto === null || crypto === undefined) {
			console.error('crypto-js 未安装或无法加载：请通过 npm 安装依赖（例如在项目根执行 npm i crypto-js）')
			return word
		}
		
		// @ts-ignore
		const key = crypto.enc.Utf8.parse(keyWord)
		// @ts-ignore
		const decrypted = crypto.AES.decrypt(word, key, {
			// @ts-ignore
			mode: crypto.mode.ECB,
			// @ts-ignore
			padding: crypto.pad.Pkcs7
		})
		
		// @ts-ignore
		return decrypted.toString(crypto.enc.Utf8)
	} catch (e) {
		console.error('AES 解密失败 (Web):', e)
		return word
	}
}
// #endif
