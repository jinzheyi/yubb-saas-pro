<template>
	<view class="slider-captcha" v-if="visible">
		<view class="captcha-modal">
			<!-- 标题栏 -->
			<view class="captcha-header">
				<text class="captcha-title">{{ t('captcha.verification') }}</text>
				<text class="captcha-close" @click="handleClose">✕</text>
			</view>
			
			<!-- 验证码内容 -->
			<view class="captcha-body">
				<!-- 背景图和滑块图 -->
				<view class="captcha-image-container">
					<image 
						class="captcha-bg-image" 
						:src="backImgBase ? ('data:image/png;base64,' + backImgBase) : ''"
						mode="aspectFill"
					></image>
					
					<!-- 滑块图片 -->
					<view 
						class="captcha-slider-image" 
						:style="{ left: sliderLeft }"
					>
						<image 
							:src="blockImgBase ? ('data:image/png;base64,' + blockImgBase) : ''"
							mode="aspectFill"
							style="width: 100%; height: 100%;"
						></image>
					</view>
					
					<!-- 刷新按钮 -->
					<view class="captcha-refresh" @click="refresh" v-if="showRefresh">
						<text class="refresh-icon">↻</text>
					</view>
					
					<!-- 提示信息 -->
					<view 
						class="captcha-tip" 
						v-if="tipText"
						:class="tipSuccess ? 'tip-success' : 'tip-error'"
					>
						{{ tipText }}
					</view>
				</view>
				
				<!-- 滑动条 -->
				<view class="captcha-slider-bar">
					<view 
						class="slider-track" 
						:style="{ width: trackWidth }"
					></view>
					<view 
						class="slider-button" 
						:style="{ left: sliderLeft, backgroundColor: buttonColor }"
						@touchstart="handleTouchStart"
						@touchmove="handleTouchMove"
						@touchend="handleTouchEnd"
						@mousedown="handleMouseDown"
					>
						<text class="slider-icon">{{ sliderIcon }}</text>
					</view>
					<text class="slider-text">{{ sliderText }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onUnmounted } from 'vue'
	import { getCaptcha, checkCaptcha } from '../../api/login.uts'
	import { aesEncrypt } from './utils/aes.uts'
	import { isHarmonyAESRuntimeReady } from './utils/harmony-aes-provider.uts'
	import { t } from '../../store/locale.uts'
	import { isHarmonyOS } from '../../utils/device.uts'
	
	// Props
	const props = defineProps({
		captchaType: {
			type: String,
			default: 'blockPuzzle'
		}
	})

	const CAPTCHA_FAIL_CODE_VERIFY_FAILED = 'VERIFY_FAILED'
	const CAPTCHA_FAIL_CODE_HARMONY_AES_REQUIRED = 'HARMONY_AES_REQUIRED'
	
	// Emits
	const emit = defineEmits(['success', 'fail'])
	
	// 状态
	const visible = ref<boolean>(false)
	const backImgBase = ref<string>('')
	const blockImgBase = ref<string>('')
	const token = ref<string>('')
	const secretKey = ref<string>('')
	const showRefresh = ref<boolean>(true)
	const tipText = ref<string>('')
	const tipSuccess = ref<boolean>(false)
	
	// 滑动相关
	const startX = ref<number>(0)
	const currentX = ref<number>(0)
	const isSliding = ref<boolean>(false)
	const startTime = ref<number>(0)
	const endTime = ref<number>(0)
	
	// 样式相关
	const sliderLeft = computed(() => {
		if (isSliding.value) {
			const left = currentX.value - startX.value
			if (left < 0) return '0px'
			if (left > 260) return '260px'
			return left + 'px'
		}
		return '0px'
	})
	
	const trackWidth = computed(() => {
		return sliderLeft.value
	})
	
	const buttonColor = ref<string>('#fff')
	const sliderIcon = ref<string>('→')
	const sliderText = ref<string>(t('captcha.slide'))

	function handleHarmonyAESUnavailable(): void {
		tipSuccess.value = false
		tipText.value = t('captcha.harmonyAesRequired')
		sliderText.value = t('captcha.slide')
		buttonColor.value = '#d9534f'
		sliderIcon.value = '✕'
		uni.showToast({
			title: t('captcha.harmonyAesRequired'),
			icon: 'none'
		})
		emit('fail', {
			code: CAPTCHA_FAIL_CODE_HARMONY_AES_REQUIRED,
			message: t('captcha.harmonyAesRequired')
		})
		setTimeout(() => {
			refresh()
		}, 1200)
	}

	function ensureHarmonyCaptchaRuntime(): boolean {
		if (!isHarmonyOS()) {
			return true
		}
		if (isHarmonyAESRuntimeReady()) {
			return true
		}
		console.error('HarmonyOS 滑块验证码缺少 AES runtime，已中止校验请求')
		handleHarmonyAESUnavailable()
		return false
	}
	
	// 生成 UUID
	function generateUUID(): string {
		const s: string[] = []
		const hexDigits = '0123456789abcdef'
		
		for (let i = 0; i < 36; i++) {
			s.push(hexDigits.charAt(Math.floor(Math.random() * 16)))
		}
		
		s[14] = '4'
		s[19] = hexDigits.charAt((parseInt(s[19]) & 0x3) | 0x8)
		s[8] = '-'
		s[13] = '-'
		s[18] = '-'
		s[23] = '-'
		
		return s.join('')
	}
	
	// 获取验证码
	async function loadCaptcha() {
		try {
			// 获取或生成 clientUid
			let clientUid = uni.getStorageSync('captcha_slider_uid')
			if (!clientUid) {
				clientUid = 'slider-' + generateUUID()
				uni.setStorageSync('captcha_slider_uid', clientUid)
			}
			
			const data = {
				captchaType: props.captchaType,
				clientUid: clientUid,
				ts: Date.now()
			}
			
			const result = await getCaptcha(data)
			
			// 验证码接口返回的数据结构不同，直接使用 result
			if (result && result.repCode == '0000') {
				backImgBase.value = result.repData.originalImageBase64
				blockImgBase.value = result.repData.jigsawImageBase64
				token.value = result.repData.token
				secretKey.value = result.repData.secretKey
			} else {
				console.error('获取验证码失败:', result)
				uni.showToast({
					title: result?.repMsg || t('captcha.loadFailed'),
					icon: 'none'
				})
			}
		} catch (e) {
			console.error('获取验证码异常:', e)
			uni.showToast({
				title: t('captcha.loadFailed'),
				icon: 'none'
			})
		}
	}
	
	// 触摸开始
	function handleTouchStart(e: any) {
		if (!isSliding.value) {
			const pageX = extractPointerPageX(e, true)
			if (pageX < 0) {
				return
			}
			beginSliding(pageX, e)
		}
	}

	function handleMouseDown(e: any) {
		if (!isSliding.value) {
			const pageX = extractPointerPageX(e, false)
			if (pageX < 0) {
				return
			}
			beginSliding(pageX, e)
			bindMouseDragListeners()
		}
	}
	
	// 触摸移动
	function handleTouchMove(e: any) {
		if (isSliding.value) {
			const pageX = extractPointerPageX(e, true)
			if (pageX < 0) {
				return
			}
			updateSliding(pageX, e)
		}
	}
	
	// 触摸结束
	async function handleTouchEnd(e: any) {
		if (isSliding.value) {
			await finishSliding(e)
		}
	}

	async function handleMouseMove(e: any) {
		if (!isSliding.value) {
			return
		}
		const pageX = extractPointerPageX(e, false)
		if (pageX < 0) {
			return
		}
		updateSliding(pageX, e)
	}

	async function handleMouseUp(e: any) {
		if (!isSliding.value) {
			unbindMouseDragListeners()
			return
		}
		await finishSliding(e)
		unbindMouseDragListeners()
	}

	function extractPointerPageX(e: any, preferTouch: boolean): number {
		if (preferTouch && e != null && e.touches != null && e.touches.length > 0) {
			return Number(e.touches[0].pageX)
		}
		if (e != null && e.changedTouches != null && e.changedTouches.length > 0) {
			return Number(e.changedTouches[0].pageX)
		}
		if (e != null && e.pageX != null) {
			return Number(e.pageX)
		}
		if (e != null && e.clientX != null) {
			return Number(e.clientX)
		}
		return -1
	}

	function stopPointerEvent(e: any): void {
		if (e != null && typeof e.stopPropagation === 'function') {
			e.stopPropagation()
		}
		if (e != null && typeof e.preventDefault === 'function') {
			e.preventDefault()
		}
	}

	function beginSliding(pageX: number, e: any): void {
		stopPointerEvent(e)
		startX.value = pageX
		currentX.value = pageX
		isSliding.value = true
		startTime.value = Date.now()
		sliderText.value = ''
		buttonColor.value = '#337ab7'
	}

	function updateSliding(pageX: number, e: any): void {
		stopPointerEvent(e)
		currentX.value = pageX
		const moveDistance = currentX.value - startX.value
		if (moveDistance < 0) {
			currentX.value = startX.value
		} else if (moveDistance > 260) {
			currentX.value = startX.value + 260
		}
	}

	async function finishSliding(e: any): Promise<void> {
		stopPointerEvent(e)
		endTime.value = Date.now()
		isSliding.value = false
		const moveDistance = currentX.value - startX.value
		if (moveDistance < 10) {
			reset()
			return
		}
		const realDistance = Math.round(moveDistance * 310 / 310)
		await verifyCaptcha(realDistance)
	}

	function bindMouseDragListeners(): void {
		// #ifdef H5
		const uniWindow = (globalThis as any).window
		if (uniWindow != null) {
			uniWindow.addEventListener('mousemove', handleMouseMove)
			uniWindow.addEventListener('mouseup', handleMouseUp)
		}
		// #endif
	}

	function unbindMouseDragListeners(): void {
		// #ifdef H5
		const uniWindow = (globalThis as any).window
		if (uniWindow != null) {
			uniWindow.removeEventListener('mousemove', handleMouseMove)
			uniWindow.removeEventListener('mouseup', handleMouseUp)
		}
		// #endif
	}
	
	// 校验验证码
	async function verifyCaptcha(distance: number) {
		try {
			if (!ensureHarmonyCaptchaRuntime()) {
				return
			}
			const pointJson = JSON.stringify({ x: distance, y: 5.0 })
			
			// 使用 AES 加密
			let encryptedPoint = pointJson
			if (secretKey.value) {
				try {
					encryptedPoint = aesEncrypt(pointJson, secretKey.value)
				} catch (e) {
					console.error('❌ AES 加密失败:', e)
					if (isHarmonyOS()) {
						handleHarmonyAESUnavailable()
						return
					}
					encryptedPoint = pointJson
				}
			} else {
				console.warn('⚠️ secretKey 为空')
				if (isHarmonyOS()) {
					handleHarmonyAESUnavailable()
					return
				}
			}
			
			const data = {
				captchaType: props.captchaType,
				pointJson: encryptedPoint,
				token: token.value
			}
			
			const result = await checkCaptcha(data)
			
			// 验证码接口返回的数据结构不同，直接使用 result
			if (result && result.repCode == '0000') {
				// 验证成功
				handleSuccess()
			} else {
				// 验证失败
				console.error('❌ 验证失败:', result)
				handleFail()
			}
		} catch (e) {
			console.error('❌ 验证异常:', e)
			handleFail()
		}
	}
	
	// 验证成功
	function handleSuccess() {
		buttonColor.value = '#5cb85c'
		sliderIcon.value = '✓'
		sliderText.value = t('captcha.success')
		tipSuccess.value = true
		tipText.value = t('captcha.successWithDuration', {
			duration: ((endTime.value - startTime.value) / 1000).toFixed(2)
		})
		
		setTimeout(() => {
			if (!ensureHarmonyCaptchaRuntime()) {
				return
			}
			const verificationPayload = token.value + '---' + JSON.stringify({ x: currentX.value - startX.value, y: 5.0 })
			let captchaVerification = verificationPayload
			if (secretKey.value) {
				try {
					captchaVerification = aesEncrypt(verificationPayload, secretKey.value)
				} catch (e) {
					console.error('❌ captchaVerification AES 加密失败:', e)
					if (isHarmonyOS()) {
						handleHarmonyAESUnavailable()
						return
					}
				}
			} else if (isHarmonyOS()) {
				handleHarmonyAESUnavailable()
				return
			}
			emit('success', { captchaVerification })
			visible.value = false
			reset()
		}, 1000)
	}
	
	// 验证失败
	function handleFail() {
		buttonColor.value = '#d9534f'
		sliderIcon.value = '✕'
		tipSuccess.value = false
		tipText.value = t('captcha.fail')
		
		emit('fail', {
			code: CAPTCHA_FAIL_CODE_VERIFY_FAILED,
			message: t('captcha.fail')
		})
		
		setTimeout(() => {
			refresh()
		}, 1000)
	}
	
	// 刷新
	function refresh() {
		reset()
		loadCaptcha()
	}
	
	// 重置
	function reset() {
		startX.value = 0
		currentX.value = 0
		isSliding.value = false
		buttonColor.value = '#fff'
		sliderIcon.value = '→'
		sliderText.value = t('captcha.slide')
		tipText.value = ''
		tipSuccess.value = false
	}
	
	// 关闭
	function handleClose() {
		visible.value = false
		unbindMouseDragListeners()
		reset()
	}
	
	// 显示
	function show() {
		visible.value = true
		loadCaptcha()
	}
	
	// 暴露方法
	defineExpose({
		show,
		refresh
	})

	onUnmounted(() => {
		unbindMouseDragListeners()
	})
</script>

<style>
	.slider-captcha {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 9999;
		background-color: rgba(0, 0, 0, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.captcha-modal {
		width: 340px;
		background-color: #fff;
		border-radius: 8px;
		overflow: hidden;
	}
	
	.captcha-header {
		height: 50px;
		padding: 0 15px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid #e4e7eb;
	}
	
	.captcha-title {
		font-size: 16px;
		color: #45494c;
		font-weight: 500;
	}
	
	.captcha-close {
		font-size: 24px;
		color: #999;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.captcha-body {
		padding: 15px;
	}
	
	.captcha-image-container {
		width: 310px;
		height: 155px;
		position: relative;
		margin-bottom: 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
		overflow: hidden;
	}
	
	.captcha-bg-image {
		width: 100%;
		height: 100%;
	}
	
	.captcha-slider-image {
		position: absolute;
		top: 0;
		width: 50px;
		height: 155px;
		/* 移除 transition，提高滑动流畅度 */
	}
	
	.captcha-refresh {
		position: absolute;
		top: 5px;
		right: 5px;
		width: 30px;
		height: 30px;
		background-color: rgba(0, 0, 0, 0.5);
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.refresh-icon {
		font-size: 20px;
		color: #fff;
	}
	
	.captcha-tip {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 30px;
		line-height: 30px;
		text-align: center;
		color: #fff;
		font-size: 14px;
	}
	
	.tip-success {
		background-color: rgba(92, 184, 92, 0.8);
	}
	
	.tip-error {
		background-color: rgba(217, 83, 79, 0.8);
	}
	
	.captcha-slider-bar {
		width: 310px;
		height: 40px;
		background-color: #f7f9fa;
		border: 1px solid #ddd;
		border-radius: 4px;
		position: relative;
		overflow: hidden;
	}
	
	.slider-track {
		height: 100%;
		background-color: #d1e9ff;
		/* 移除 transition，提高滑动流畅度 */
	}
	
	.slider-button {
		position: absolute;
		top: 0;
		width: 40px;
		height: 40px;
		background-color: #fff;
		border-radius: 4px;
		box-shadow: 0 0 4px rgba(0, 0, 0, 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
	}
	
	.slider-icon {
		font-size: 18px;
		color: #333;
	}
	
	.slider-text {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 40px;
		line-height: 40px;
		text-align: center;
		color: #999;
		font-size: 14px;
		pointer-events: none;
		z-index: 1;
	}
</style>
