<template>
	<view v-if="visible" class="member-selector">
		<view class="member-list">
			<!-- @所有人选项（仅群主和管理员） -->
			<view 
				v-if="canAtAll"
				class="member-item"
				@click="handleSelectMember({ userId: -1, userName: '所有人', avatar: '' })"
			>
				<view class="member-avatar" :style="{ backgroundColor: getBusinessAvatarColor('mention_all', '-1') }">
					<text class="avatar-text">@</text>
				</view>
				<text class="member-name">所有人</text>
			</view>
			
			<!-- 群成员列表 -->
			<view 
				v-for="(member, index) in members" 
				:key="index"
				class="member-item"
				@click="handleSelectMember(member)"
			>
				<view class="member-avatar" :style="{ backgroundColor: member.avatarBg }">
					<text class="avatar-text">{{ member.avatarText }}</text>
				</view>
				<text class="member-name">{{ member.userName }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { getBusinessAvatarColor } from '@/utils/avatar.uts'
	/**
	 * 群成员选择器组件
	 * 
	 * 功能：
	 * 1. 显示群成员列表
	 * 2. 支持@所有人（群主和管理员）
	 * 3. 选择成员后插入@提醒
	 */
	
	// Props
	const props = defineProps({
		visible: {
			type: Boolean,
			default: false
		},
		members: {
			type: Array as PropType<any[]>,
			default: () => []
		},
		canAtAll: {
			type: Boolean,
			default: false
		}
	})
	
	// Emits
	const emit = defineEmits(['select', 'close'])
	
	// 选择成员
	const handleSelectMember = (member: any) => {
		emit('select', member)
		emit('close')
	}
</script>

<style scoped>
	.member-selector {
		position: absolute;
		bottom: 100%;
		left: 0;
		right: 0;
		background-color: #ffffff;
		border-top: 1px solid #eeeeee;
		max-height: 200px;
		overflow-y: auto;
		z-index: 100;
	}
	
	.member-list {
		display: flex;
		flex-direction: column;
	}
	
	.member-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid #f5f5f5;
		cursor: pointer;
	}
	
	.member-item:active {
		background-color: #f5f5f5;
	}
	
	.member-avatar {
		width: 36px;
		height: 36px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}
	
	.avatar-text {
		font-size: 14px;
		color: #ffffff;
		font-weight: 500;
	}
	
	.member-name {
		font-size: 15px;
		color: #333333;
	}
</style>
