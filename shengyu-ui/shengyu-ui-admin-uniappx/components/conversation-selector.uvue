<template>
	<view v-if="visible" class="conversation-selector-overlay">
		<view class="conversation-selector">
			<!-- 头部 -->
			<view class="selector-header">
				<text class="header-title">选择会话</text>
				<text class="header-close iconfont" @click="handleClose">&#xe60e;</text>
			</view>
			
			<!-- 搜索框 -->
			<view class="selector-search">
				<view class="search-box">
					<text class="search-icon iconfont">&#xe6a4;</text>
					<input 
						class="search-input" 
						v-model="searchKeyword" 
						placeholder="搜索会话"
						@input="handleSearch"
					/>
				</view>
			</view>
			
			<!-- 会话列表 -->
			<scroll-view class="selector-list" scroll-y="true">
				<view 
					v-for="(conversation, index) in filteredConversations" 
					:key="index"
					class="conversation-item"
					:class="{ 'conversation-item-selected': isSelected(conversation.chatId) }"
					@click="handleToggleSelect(conversation)"
				>
					<view class="conversation-checkbox">
						<text v-if="isSelected(conversation.chatId)" class="iconfont checkbox-checked">&#xe65f;</text>
						<view v-else class="checkbox-unchecked"></view>
					</view>
					
					<view class="conversation-avatar" :style="{ backgroundColor: conversation.avatarBg }">
						<image
							v-if="shouldShowAvatar(conversation)"
							class="conversation-avatar-image"
							:src="conversation.targetAvatar"
							mode="aspectFill"
							@error="handleAvatarError(conversation)"
						/>
						<text v-else class="avatar-text">{{ conversation.avatarText }}</text>
					</view>
					
					<view class="conversation-info">
						<text class="conversation-name">{{ conversation.targetName }}</text>
					</view>
				</view>
				
				<view v-if="filteredConversations.length === 0" class="empty-tip">
					<text class="empty-text">暂无会话</text>
				</view>
			</scroll-view>
			
			<!-- 底部操作栏 -->
			<view class="selector-footer">
				<text class="footer-count">已选择 {{ selectedIds.length }} 个会话</text>
				<view class="footer-actions">
					<view class="footer-btn footer-btn-cancel" @click="handleClose">
						<text class="footer-btn-text">取消</text>
					</view>
					<view class="footer-btn footer-btn-confirm" @click="handleConfirm">
						<text class="footer-btn-text">确定</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref, computed } from 'vue'
	import { conversationService } from '@/services/conversation-service.uts'
	
	/**
	 * 会话选择器组件
	 * 
	 * 功能：
	 * 1. 显示会话列表
	 * 2. 支持多选
	 * 3. 搜索会话
	 * 4. 确认选择
	 */
	
	// Props
	const props = defineProps({
		visible: {
			type: Boolean,
			default: false
		},
		multiple: {
			type: Boolean,
			default: true
		}
	})
	
	// Emits
	const emit = defineEmits(['close', 'confirm'])
	
	// 数据
	const searchKeyword = ref('')
	const selectedIds = ref<string[]>([])
	const conversations = ref(conversationService.getConversations())
	
	// 过滤后的会话列表
	const filteredConversations = computed(() => {
		if (!searchKeyword.value) {
			return conversations.value
		}
		
		const keyword = searchKeyword.value.toLowerCase()
		return conversations.value.filter(c => 
			c.targetName.toLowerCase().includes(keyword)
		)
	})
	
	// 判断是否已选择
	const isSelected = (chatId: string): boolean => {
		return selectedIds.value.includes(chatId)
	}
	
	// 切换选择
	const handleToggleSelect = (conversation: any) => {
		const chatId = conversation && conversation.chatId != null ? conversation.chatId.toString() : '0'
		const index = selectedIds.value.indexOf(chatId)
		
		if (index !== -1) {
			// 取消选择
			selectedIds.value.splice(index, 1)
		} else {
			// 选择
			if (props.multiple) {
				selectedIds.value.push(chatId)
			} else {
				selectedIds.value = [chatId]
			}
		}
	}
	
	// 搜索
	const handleSearch = () => {
		// 搜索逻辑已在 computed 中实现
	}
	
	// 关闭
	const handleClose = () => {
		selectedIds.value = []
		searchKeyword.value = ''
		emit('close')
	}
	
	// 确认
	const handleConfirm = () => {
		if (selectedIds.value.length === 0) {
			uni.showToast({
				title: '请选择会话',
				icon: 'none'
			})
			return
		}
		
		emit('confirm', selectedIds.value)
		handleClose()
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(conversation: any): boolean {
		return normalizeAvatarUrl(conversation != null ? conversation.targetAvatar : '') !== '' && conversation.avatarError !== true
	}

	function handleAvatarError(conversation: any): void {
		if (conversation == null) {
			return
		}
		conversation.avatarError = true
	}
</script>

<style>
	.conversation-selector-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.conversation-selector {
		width: 80%;
		max-width: 500px;
		height: 70%;
		background-color: #ffffff;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
	}
	
	.selector-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 16px;
		border-bottom: 1px solid #eeeeee;
	}
	
	.header-title {
		font-size: 17px;
		font-weight: 500;
		color: #333333;
	}
	
	.header-close {
		font-size: 24px;
		color: #666666;
	}
	
	.selector-search {
		padding: 12px 16px;
		border-bottom: 1px solid #eeeeee;
	}
	
	.search-box {
		display: flex;
		flex-direction: row;
		align-items: center;
		background-color: #f5f5f5;
		border-radius: 8px;
		padding: 8px 12px;
	}
	
	.search-icon {
		font-size: 18px;
		color: #999999;
		margin-right: 8px;
	}
	
	.search-input {
		flex: 1;
		font-size: 15px;
		color: #333333;
	}
	
	.selector-list {
		flex: 1;
		overflow: auto;
	}
	
	.conversation-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom: 1px solid #f5f5f5;
	}
	
	.conversation-item-selected {
		background-color: #f0f9ff;
	}
	
	.conversation-checkbox {
		width: 24px;
		height: 24px;
		margin-right: 12px;
	}
	
	.checkbox-checked {
		font-size: 24px;
		color: #409EFF;
	}
	
	.checkbox-unchecked {
		width: 20px;
		height: 20px;
		border: 2px solid #cccccc;
		border-radius: 4px;
	}
	
	.conversation-avatar {
		width: 40px;
		height: 40px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.conversation-avatar-image {
		width: 40px;
		height: 40px;
		border-radius: 4px;
	}
	
	.avatar-text {
		font-size: 16px;
		color: #ffffff;
		font-weight: 500;
	}
	
	.conversation-info {
		flex: 1;
	}
	
	.conversation-name {
		font-size: 15px;
		color: #333333;
	}
	
	.empty-tip {
		padding: 40px 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	
	.empty-text {
		font-size: 14px;
		color: #999999;
	}
	
	.selector-footer {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 12px 16px;
		border-top: 1px solid #eeeeee;
	}
	
	.footer-count {
		font-size: 14px;
		color: #666666;
	}
	
	.footer-actions {
		display: flex;
		flex-direction: row;
		gap: 12px;
	}
	
	.footer-btn {
		padding: 8px 20px;
		border-radius: 6px;
	}
	
	.footer-btn-cancel {
		background-color: #f5f5f5;
	}
	
	.footer-btn-confirm {
		background-color: #409EFF;
	}
	
	.footer-btn-text {
		font-size: 14px;
	}
	
	.footer-btn-cancel .footer-btn-text {
		color: #666666;
	}
	
	.footer-btn-confirm .footer-btn-text {
		color: #ffffff;
	}
</style>
