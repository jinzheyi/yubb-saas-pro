<template>
	<view v-if="visible" class="message-action-menu-overlay" @click="handleClose">
		<view class="message-action-menu" :style="{ top: position.top + 'px', left: position.left + 'px' }" @click.stop>
			<view class="menu-item" v-for="(item, index) in menuItems" :key="index" @click="handleMenuClick(item.action)">
				<text class="menu-icon iconfont">{{ item.icon }}</text>
				<text class="menu-text">{{ item.text }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref, computed } from 'vue'
	
	/**
	 * 消息操作菜单组件
	 * 
	 * 功能：
	 * 1. 复制消息
	 * 2. 删除消息
	 * 3. 撤回消息
	 * 4. 转发消息
	 * 5. 引用回复
	 * 6. 多选模式
	 */
	
	// Props
	const props = defineProps({
		visible: {
			type: Boolean,
			default: false
		},
		message: {
			type: Object as PropType<any>,
			default: null
		},
		position: {
			type: Object as PropType<{ top: number, left: number }>,
			default: () => ({ top: 0, left: 0 })
		},
		isSelf: {
			type: Boolean,
			default: false
		},
		canRecall: {
			type: Boolean,
			default: false
		},
		canEdit: {
			type: Boolean,
			default: false
		}
	})
	
	// Emits
	const emit = defineEmits(['close', 'copy', 'delete', 'recall', 'forward', 'quote', 'multiSelect', 'reaction', 'edit'])
	
	// 菜单项
	const menuItems = computed(() => {
		const items = []
		
		// 表情回应
		items.push({
			action: 'reaction',
			icon: '\ue60c',
			text: '表情'
		})
		
		// 复制（仅文本消息）
		if (props.message && props.message.type === 'text') {
			items.push({
				action: 'copy',
				icon: '\ue692',
				text: '复制'
			})
		}
		
		// 编辑（仅自己的文本消息且在时间限制内）
		if (props.isSelf && props.canEdit && props.message && props.message.type === 'text') {
			items.push({
				action: 'edit',
				icon: '\ue6a5',
				text: '编辑'
			})
		}
		
		// 引用回复
		items.push({
			action: 'quote',
			icon: '\ue6a8',
			text: '引用'
		})
		
		// 转发
		items.push({
			action: 'forward',
			icon: '\ue6b5',
			text: '转发'
		})
		
		// 多选
		items.push({
			action: 'multiSelect',
			icon: '\ue65f',
			text: '多选'
		})
		
		// 撤回（仅自己的消息且在时间限制内）
		if (props.isSelf && props.canRecall) {
			items.push({
				action: 'recall',
				icon: '\ue6c3',
				text: '撤回'
			})
		}
		
		// 删除
		items.push({
			action: 'delete',
			icon: '\ue6d0',
			text: '删除'
		})
		
		return items
	})
	
	// 处理菜单点击
	const handleMenuClick = (action: string) => {
		emit(action)
		handleClose()
	}
	
	// 关闭菜单
	const handleClose = () => {
		emit('close')
	}
</script>

<style scoped>
	.message-action-menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.3);
		z-index: 9999;
	}
	
	.message-action-menu {
		position: absolute;
		background-color: #ffffff;
		border-radius: 8px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
		padding: 8px 0;
		min-width: 120px;
	}
	
	.menu-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		cursor: pointer;
	}
	
	.menu-item:active {
		background-color: #f5f5f5;
	}
	
	.menu-icon {
		font-size: 18px;
		color: #666666;
		margin-right: 8px;
	}
	
	.menu-text {
		font-size: 15px;
		color: #333333;
	}
</style>
