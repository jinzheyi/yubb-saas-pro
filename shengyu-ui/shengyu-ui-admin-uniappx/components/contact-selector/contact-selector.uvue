<template>
	<view class="contact-selector">
		<scroll-view 
			class="content" 
			scroll-y="true" 
			show-scrollbar="false"
			:scroll-into-view="scrollTarget"
			scroll-with-animation="true"
		>
			<!-- 快捷分类（可选） -->
			<view v-if="showCategories" class="category-section">
				<view class="section-label">
					<text class="section-text">{{ t('initiateGroup.selectExisting') }}</text>
				</view>
				<view class="category-group">
					<view class="category-item" v-for="(item, index) in categories" :key="index" @click="handleCategory(item)">
						<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
							<text class="iconfont category-icon">{{ item.icon }}</text>
						</view>
						<text class="category-name">{{ t(item.nameKey) }}</text>
						<view v-if="index < categories.length - 1" class="category-item-border"></view>
					</view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view v-for="(group, groupIndex) in groupedContacts" :key="groupIndex">
				<view class="section-header" :id="'group-' + group.letter">
					<text class="section-title">{{ group.letter }}</text>
				</view>
				<view class="contact-list">
					<view 
						class="contact-item" 
						v-for="(item, index) in group.contacts" 
						:key="index" 
						@click="toggleSelect(item)"
					>
						<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
							<text class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name">{{ item.name }}</text>
							<text class="contact-role">{{ item.role }}</text>
						</view>
						<view v-if="selectable" :class="['checkbox', item.selected ? 'checkbox-active' : '']">
							<text v-if="item.selected" class="iconfont check-icon">&#xea73;</text>
						</view>
						<view v-if="index < group.contacts.length - 1" class="contact-item-border"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 右侧字母索引 -->
		<view class="index-bar">
			<text 
				v-for="letter in indexList" 
				:key="letter" 
				class="index-item"
				@click="scrollToGroup(letter)"
			>
				{{ letter }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useI18n } from '../../hooks/useI18n.uts'

	const { t } = useI18n()

	// Props
	const props = defineProps({
		// 是否显示快捷分类
		showCategories: {
			type: Boolean,
			default: false
		},
		// 是否可选择（显示复选框）
		selectable: {
			type: Boolean,
			default: false
		},
		// 联系人数据
		contacts: {
			type: Array as PropType<any[]>,
			default: () : any[] => []
		}
	})

	// Emits
	const emit = defineEmits<{
		(e: 'select', item: any): void
		(e: 'category-click', item: any): void
	}>()

	const scrollTarget = ref('')

	// 快捷分类
	const categories = [
		{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' },
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	// 生成模拟联系人数据（使用假名）
	const generateDefaultContacts = () : any[] => {
		const firstNames = ['张', '李', '王', '刘', '陈', '杨', '赵', '黄', '周', '吴', '徐', '孙', '胡', '朱', '高', '林', '何', '郭', '马', '罗']
		const lastNames = ['伟', '芳', '娜', '秀英', '敏', '静', '丽', '强', '磊', '军', '洋', '勇', '艳', '杰', '娟', '涛', '明', '超', '秀兰', '霞']
		const roles = ['高级经理', '部门经理', '项目经理', '开发工程师', '测试工程师', '产品经理', '设计师', '运营专员', '市场专员', '行政专员']
		const colors = ['#0ea5e9', '#f472b6', '#c084fc', '#fb7185', '#10b981', '#f59e0b', '#ec4899', '#ef4444', '#3b82f6', '#8b5cf6']
		const pinyins = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')

		const list : any[] = []
		for (let i = 0; i < 50; i++) {
			const firstName = firstNames[i % firstNames.length]
			const lastName = lastNames[i % lastNames.length]
			const name = firstName + lastName
			const pinyin = pinyins[i % pinyins.length]
			
			list.push({
				id: i + 1,
				name: name,
				role: roles[i % roles.length],
				avatarText: name.substring(0, 2),
				avatarBg: colors[i % colors.length],
				pinyin: pinyin,
				selected: false
			})
		}
		return list
	}

	// 使用传入的联系人数据或默认数据
	const contactList = computed(() : any[] => {
		return props.contacts.length > 0 ? props.contacts : generateDefaultContacts()
	})

	// 按字母分组
	type ContactGroup = {
		letter: string,
		contacts: any[]
	}

	const groupedContacts = computed(() : ContactGroup[] => {
		const groups : ContactGroup[] = []
		const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
		
		letters.forEach(letter => {
			const filtered = contactList.value.filter(c => c.pinyin === letter)
			if (filtered.length > 0) {
				groups.push({
					letter: letter,
					contacts: filtered.sort((a, b) => a.name.localeCompare(b.name))
				})
			}
		})
		return groups
	})

	const indexList = computed(() : string[] => {
		return groupedContacts.value.map((g : ContactGroup) : string => g.letter)
	})

	function scrollToGroup(letter : string) {
		scrollTarget.value = 'group-' + letter
		setTimeout(() => {
			scrollTarget.value = ''
		}, 100)
	}

	function handleCategory(item : any) {
		emit('category-click', item)
	}

	function toggleSelect(item : any) {
		if (props.selectable) {
			// 如果是当前用户且已选中，不允许取消
			if (item.isCurrentUser && item.selected) {
				return
			}
			item.selected = !item.selected
		}
		emit('select', item)
	}
</script>

<style>
	.contact-selector {
		flex: 1;
		height: 0;
		position: relative;
	}

	.content {
		flex: 1;
		height: 100%;
		background-color: #FFFFFF;
	}

	/* 分类区域 */
	.category-section {
		background-color: #FFFFFF;
	}

	.section-label {
		padding: 12px 16px 8px 16px;
	}

	.section-text {
		font-size: 13px;
		color: #999999;
	}

	.category-group {
		background-color: #FFFFFF;
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.category-item:active {
		background-color: #F2F3F5;
	}

	.category-item-border {
		position: absolute;
		bottom: 0;
		left: 64px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #FFFFFF;
		font-size: 18px;
	}

	.category-name {
		font-size: 15px;
		color: #333333;
	}

	/* 分组标题 */
	.section-header {
		padding: 8px 16px;
		background-color: #F5F7FA;
	}

	.section-title {
		font-size: 12px;
		color: #8F959E;
		font-weight: 600;
	}

	/* 联系人列表 */
	.contact-list {
		background-color: #FFFFFF;
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		background-color: #FFFFFF;
		position: relative;
	}

	.contact-item:active {
		background-color: #F2F3F5;
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 68px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 15px;
		color: #333333;
		font-weight: 500;
	}

	.contact-role {
		font-size: 12px;
		color: #999999;
	}

	/* 复选框 */
	.checkbox {
		width: 20px;
		height: 20px;
		border-width: 1px;
		border-color: #d1d5db;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
	}

	.checkbox-active {
		background-color: #1677FF;
		border-color: #1677FF;
	}

	.check-icon {
		color: #ffffff;
		font-size: 12px;
	}

	/* 右侧索引栏 */
	.index-bar {
		position: absolute;
		right: 4px;
		top: 50%;
		transform: translateY(-40%);
		z-index: 10;
		align-items: center;
	}

	.index-item {
		font-size: 10px;
		color: #1F2329;
		padding: 2px 4px;
		font-weight: 600;
	}
</style>
