<template>
	<view class="contact-selector">
		<scroll-view 
			class="content"
			:style="{ backgroundColor: theme.pageBg }"
			scroll-y="true" 
			show-scrollbar="false"
			@scrolltolower="handleScrollToLower"
			:scroll-into-view="scrollTarget"
			scroll-with-animation="true"
		>
			<!-- 快捷分类（可选） -->
			<view v-if="showCategories" class="category-section" :style="{ backgroundColor: theme.cardBg }">
				<view class="section-label">
					<text class="section-text" :style="{ color: theme.textTertiary }">{{ t('initiateGroup.selectExisting') }}</text>
				</view>
				<view class="category-group" :style="{ backgroundColor: theme.cardBg }">
					<view class="category-item" :style="{ backgroundColor: theme.cardBg }" hover-class="category-item-active" v-for="(item, index) in categories" :key="index" @click="handleCategory(item)">
						<view class="category-icon-wrap" :style="{ backgroundColor: item.bg }">
							<text class="iconfont category-icon">{{ item.icon }}</text>
						</view>
						<text class="category-name" :style="{ color: theme.textPrimary }">{{ t(item.nameKey) }}</text>
						<view v-if="index < categories.length - 1" class="category-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
					</view>
				</view>
			</view>

			<!-- 联系人列表 -->
			<view v-for="(group, groupIndex) in groupedContacts" :key="groupIndex">
				<view class="section-header" :id="'group-' + group.letter" :style="{ backgroundColor: theme.pageBg }">
					<text class="section-title" :style="{ color: theme.textTertiary }">{{ group.letter }}</text>
				</view>
				<view class="contact-list" :style="{ backgroundColor: theme.cardBg }">
					<view 
						class="contact-item" 
						:style="{ backgroundColor: theme.cardBg }"
						hover-class="contact-item-active"
						v-for="(item, index) in group.contacts" 
						:key="index" 
						@click="toggleSelect(item)"
					>
						<view class="contact-avatar" :style="{ backgroundColor: item.avatarBg }">
							<image
								v-if="shouldShowAvatar(item)"
								class="contact-avatar-image"
								:src="item.avatar"
								mode="aspectFill"
								@error="handleAvatarError(item)"
							/>
							<text v-else class="avatar-text">{{ item.avatarText }}</text>
						</view>
						<view class="contact-info">
							<text class="contact-name" :style="{ color: theme.textPrimary }">{{ item.name }}</text>
							<text class="contact-role" :style="{ color: theme.textSecondary }">{{ item.role }}</text>
						</view>
						<view v-if="selectable" :class="['checkbox', item.selected ? 'checkbox-active' : '']" :style="{ borderColor: item.selected ? theme.brandPrimary : theme.textTertiary, backgroundColor: item.selected ? theme.brandPrimary : theme.cardBg }">
							<text v-if="item.selected" class="iconfont check-icon">&#xea73;</text>
						</view>
						<view v-if="index < group.contacts.length - 1" class="contact-item-border" :style="{ backgroundColor: theme.borderColor }"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 右侧字母索引 -->
		<view class="index-bar">
			<text 
				v-for="letter in indexList" 
				:key="letter" 
				class="index-item"
				:style="{ color: theme.textPrimary }"
				@click="scrollToGroup(letter)"
			>
				{{ letter }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onUnmounted } from 'vue'
	import { useI18n } from '../../hooks/useI18n.uts'
	import { getAvatarText, getUserAvatarColor } from '../../utils/avatar.uts'
	import { getThemeTokens, subscribeThemeChange } from '../../store/theme.uts'
	import type { ThemeTokens } from '../../config/theme.uts'

	const { t } = useI18n()
	const theme = ref<ThemeTokens>(getThemeTokens())
	let unsubscribeTheme: (() => void) | null = null

	unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
		theme.value = tokens
	})

	// Props
	const props = defineProps({
		// 是否显示快捷分类
		showCategories: {
			type: Boolean,
			default: false
		},
		// 是否可选择（显示复选框）
		selectable: {
			type: Boolean,
			default: false
		},
		// 联系人数据
		contacts: {
			type: Array as PropType<any[]>,
			default: () : any[] => []
		}
	})

	// Emits
	const emit = defineEmits<{
		(e: 'select', item: any): void
		(e: 'category-click', item: any): void
		(e: 'load-more'): void
	}>()

	const scrollTarget = ref('')

	// 快捷分类
	const categories = [
		{ icon: '\ue616', bg: '#fb923c', nameKey: 'contacts.groups' },
		{ icon: '\uea90', bg: '#facc15', nameKey: 'contacts.following' },
		{ icon: '\ue62b', bg: '#84cc16', nameKey: 'contacts.org' },
		{ icon: '\ue686', bg: '#06b6d4', nameKey: 'contacts.dept' }
	]

	// 生成模拟联系人数据（使用假名）
	const generateDefaultContacts = () : any[] => {
		const firstNames = ['张', '李', '王', '刘', '陈', '杨', '赵', '黄', '周', '吴', '徐', '孙', '胡', '朱', '高', '林', '何', '郭', '马', '罗']
		const lastNames = ['伟', '芳', '娜', '秀英', '敏', '静', '丽', '强', '磊', '军', '洋', '勇', '艳', '杰', '娟', '涛', '明', '超', '秀兰', '霞']
		const roles = ['高级经理', '部门经理', '项目经理', '开发工程师', '测试工程师', '产品经理', '设计师', '运营专员', '市场专员', '行政专员']
		const pinyins = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')

		const list : any[] = []
		for (let i = 0; i < 50; i++) {
			const firstName = firstNames[i % firstNames.length]
			const lastName = lastNames[i % lastNames.length]
			const name = firstName + lastName
			const pinyin = pinyins[i % pinyins.length]
			
			list.push({
				id: i + 1,
				name: name,
				role: roles[i % roles.length],
				avatarText: getAvatarText(name),
				avatarBg: getUserAvatarColor((i + 1).toString()),
				pinyin: pinyin,
				selected: false
			})
		}
		return list
	}

	// 使用传入的联系人数据或默认数据
	const contactList = computed(() : any[] => {
		return props.contacts
	})

	// 按字母分组
	type ContactGroup = {
		letter: string,
		contacts: any[]
	}

	const groupedContacts = computed(() : ContactGroup[] => {
		const groups : ContactGroup[] = []
		const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
		
		letters.forEach(letter => {
			const filtered = contactList.value.filter(c => c.pinyin === letter)
			if (filtered.length > 0) {
				groups.push({
					letter: letter,
					contacts: filtered.sort((a, b) => a.name.localeCompare(b.name))
				})
			}
		})
		return groups
	})

	const indexList = computed(() : string[] => {
		return groupedContacts.value.map((g : ContactGroup) : string => g.letter)
	})

	function scrollToGroup(letter : string) {
		scrollTarget.value = 'group-' + letter
		setTimeout(() => {
			scrollTarget.value = ''
		}, 100)
	}

	function handleCategory(item : any) {
		emit('category-click', item)
	}

	function toggleSelect(item : any) {
		if (props.selectable) {
			// 如果是当前用户且已选中，不允许取消
			if (item.isCurrentUser && item.selected) {
				return
			}
			item.selected = !item.selected
		}
		emit('select', item)
	}

	function handleScrollToLower() {
		emit('load-more')
	}

	function normalizeAvatarUrl(raw: any): string {
		if (raw == null) {
			return ''
		}
		const text = String(raw).trim()
		return (text !== '' && text !== 'null' && text !== 'undefined') ? text : ''
	}

	function shouldShowAvatar(item: any): boolean {
		return normalizeAvatarUrl(item != null ? item.avatar : '') !== '' && item.avatarError !== true
	}

	function handleAvatarError(item: any): void {
		if (item == null) {
			return
		}
		item.avatarError = true
	}

	onUnmounted(() => {
		if (unsubscribeTheme != null) {
			unsubscribeTheme()
			unsubscribeTheme = null
		}
	})
</script>

<style>
	.contact-selector {
		flex: 1;
		height: 0;
		position: relative;
	}

	.content {
		flex: 1;
		height: 100%;
	}

	/* 分类区域 */
	.category-section {
	}

	.section-label {
		padding: 12px 16px 8px 16px;
	}

	.section-text {
		font-size: 13px;
	}

	.category-group {
	}

	.category-item {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		position: relative;
	}

	.category-item-active {
		background-color: rgba(143, 149, 158, 0.08);
	}

	.category-item-border {
		position: absolute;
		bottom: 0;
		left: 64px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.category-icon-wrap {
		width: 36px;
		height: 36px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
	}

	.category-icon {
		color: #FFFFFF;
		font-size: 18px;
	}

	.category-name {
		font-size: 15px;
	}

	/* 分组标题 */
	.section-header {
		padding: 8px 16px;
	}

	.section-title {
		font-size: 12px;
		font-weight: 600;
	}

	/* 联系人列表 */
	.contact-list {
	}

	.contact-item {
		flex-direction: row;
		align-items: center;
		padding: 10px 16px;
		position: relative;
	}

	.contact-item-active {
		background-color: rgba(143, 149, 158, 0.08);
	}

	.contact-item-border {
		position: absolute;
		bottom: 0;
		left: 68px;
		right: 0;
		height: 0.5px;
		background-color: #EFF0F1;
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-right: 12px;
		overflow: hidden;
	}

	.contact-avatar-image {
		width: 40px;
		height: 40px;
		border-radius: 8px;
	}

	.avatar-text {
		color: #FFFFFF;
		font-size: 13px;
		font-weight: 600;
	}

	.contact-info {
		flex: 1;
	}

	.contact-name {
		font-size: 15px;
		font-weight: 500;
	}

	.contact-role {
		font-size: 12px;
	}

	/* 复选框 */
	.checkbox {
		width: 20px;
		height: 20px;
		border-width: 1px;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
	}

	.checkbox-active {
	}

	.check-icon {
		color: #ffffff;
		font-size: 12px;
	}

	/* 右侧索引栏 */
	.index-bar {
		position: absolute;
		right: 4px;
		top: 50%;
		transform: translateY(-40%);
		z-index: 10;
		align-items: center;
	}

	.index-item {
		font-size: 10px;
		padding: 2px 4px;
		font-weight: 600;
	}
</style>
