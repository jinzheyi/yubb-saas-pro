<template>
    <view style="position: relative">
        <view class="verify-image-out" v-show="showImage">
            <view class="verify-image-panel" :style="{'width': imgSize.width,
                                                   'height': imgSize.height,
                                                   'margin-bottom': vSpace + 'px'}">
                <view class="verify-refresh" style="z-index:3" @click="refresh" v-show="showRefresh">
                    <text class="iconfont icon-refresh"></text>
                </view>
                <image :src="pointBackImgBase?('data:image/png;base64,'+pointBackImgBase):defaultImg" 
                id="image"
                ref="canvas"
                style="width:100%;height:100%;display:block"
                @click="canvasClick($event)">
                </image>
                <view v-for="(tempPoint, index) in tempPoints" :key="index" class="point-area"
                     :style="{
                        'background-color':'#1abd6c',
                        color:'#fff',
                        'z-index':9999,
                        width:'20px',
                        height:'20px',
                        'text-align':'center',
                        'line-height':'20px',
                        'border-radius': '50%',
                        position:'absolute',
                        top:parseInt(tempPoint.y-10) + 'px',
                        left:parseInt(tempPoint.x-10) + 'px'
                     }">
                    {{index + 1}}
                </view>
            </view>
        </view>
        <view class="verify-bar-area"
             :style="{'width': imgSize.width,
                      'color': barAreaColor,
                      'border-color': barAreaBorderColor,
                      'line-height':'40px'}">
            <text class="verify-msg">{{text}}</text>
        </view>
    </view>
</template>

<script lang="uts">
    /**
     * VerifyPoint 点选验证码组件
     * @description 点选验证码
     * */
    import { ref, reactive, onMounted } from 'vue'
    import { aesEncrypt } from '../utils/ase.uts'
    import { myRequest } from '../utils/request.uts'

    export default {
        name: 'VerifyPoint',
        props: {
            //弹出式pop，固定fixed
            mode: {
                type: String,
                default: 'fixed'
            },
            captchaType: {
                type: String,
                default: 'clickWord'
            },
            //间隔
            vSpace: {
                type: Number,
                default: 5
            },
            imgSize: {
                type: Object,
                default() {
                    return {
                        width: '310px',
                        height: '155px'
                    }
                }
            },
            barSize: {
                type: Object,
                default() {
                    return {
                        width: '310px',
                        height: '40px'
                    }
                }
            },
            defaultImg: {
                type: String,
                default: ''
            }
        },
        emits: ['success'],
        setup(props, { emit }) {
            const secretKey = ref('')        //后端返回的加密秘钥 字段
            const checkNum = ref(3)           //需要点击的数量
            const fontPos = ref<Array<{x: number, y: number}>>([])                // 选中的坐标信息
            const checkPosArr = ref<Array<{x: number, y: number}>>([])            //用户点击的坐标
            const num = ref(1)                //点击的记数
            const pointBackImgBase = ref('')        //后端获取到的背景图片
            const poinTextList = ref<Array<string>>([])            //后端返回的点击字体顺序
            const backToken = ref('')               //后端返回的token值
            const tempPoints = ref<Array<{x: number, y: number}>>([])
            const text = ref('')
            const barAreaColor = ref('#000')
            const barAreaBorderColor = ref('#ddd')
            const showRefresh = ref(true)
            const bindingClick = ref(true)
            const showImage = ref(true)
            const imgLeft = ref(0) 
            const imgTop = ref(0)
            const canvas = ref(null)

            //初始化
            const init = () => {
                fontPos.value = []
                checkPosArr.value = []
                tempPoints.value = []
                num.value = 1
                text.value = ''
                barAreaColor.value = '#000'
                barAreaBorderColor.value = '#ddd'
                showRefresh.value = true
                bindingClick.value = true
                showImage.value = true
                refresh()
            }

            //刷新
            const refresh = () => {
                tempPoints.value = []
                barAreaColor.value = '#000'
                barAreaBorderColor.value = '#ddd'
                bindingClick.value = true
                fontPos.value = []
                checkPosArr.value = []
                num.value = 1
                getPictrue()
                showRefresh.value = true
            }

            // 请求背景图片和验证图片
            const getPictrue = () => {
                const data = {
                    captchaType: props.captchaType,
                    clientUid: uni.getStorageSync('point'),
                    ts: Date.now(), // 现在的时间戳
                }
                myRequest({
                    url: "/system/captcha/get",
                    data,
                    method: "POST",
                }).then((result: any) => {
                    // request工具已经处理了响应格式，直接获取data
                    const res = result.data
                    if (res.repCode == "0000") {
                        pointBackImgBase.value = res.repData.originalImageBase64
                        backToken.value = res.repData.token
                        secretKey.value = res.repData.secretKey
                        poinTextList.value = res.repData.wordList || []
                        text.value = '请依次点击【' + poinTextList.value.join(",") + '】'
                    }
                    // 判断接口请求次数是否失效
                    if (res.repCode == '6201') {
                        pointBackImgBase.value = ''
                    }
                }).catch((err: any) => {
                    console.error('获取验证码图片失败:', err)
                })
            }

            //图片点击事件
            const canvasClick = (e: any) => {
                if (!bindingClick.value) return
                
                const query = uni.createSelectorQuery()
                query.select('#image').boundingClientRect((data: any) => {
                    imgLeft.value = Math.ceil(data.left)
                    imgTop.value = Math.ceil(data.top)
                    
                    const position: { x: number; y: number } = {
                        x: Math.ceil(e.detail.x) - imgLeft.value,
                        y: Math.ceil(e.detail.y) - imgTop.value,
                    }
                    
                    checkPosArr.value.push(position)
                    tempPoints.value.push(Object.assign({}, position))
                    num.value++
                    
                    if (num.value > checkNum.value) {
                        //按比例转换坐标值
                        const transformedPos = pointTransfrom(checkPosArr.value, props.imgSize as { width: string; height: string })
                        
                        //发送后端请求
                        // 使用aesEncrypt函数进行Base64编码
                        const captchaVerification = aesEncrypt(backToken.value + '---' + JSON.stringify(transformedPos), secretKey.value)
                        
                        const data = {
                            captchaType: props.captchaType,
                            // 使用aesEncrypt函数进行Base64编码
                            "pointJson": aesEncrypt(JSON.stringify(transformedPos), secretKey.value),
                            "token": backToken.value
                        }
                        
                        myRequest({
                            url: `/system/captcha/check`, 
                            data,
                            method: "POST",
                        }).then((result: any) => {
                            // request工具已经处理了响应格式，直接获取data
                            const res = result.data
                            if (res.repCode == "0000") {
                                barAreaColor.value = '#4cae4c'
                                barAreaBorderColor.value = '#5cb85c'
                                text.value = '验证成功'
                                bindingClick.value = false
                                
                                setTimeout(() => {
                                    if (props.mode == 'pop') {
                                        // 弹出模式下关闭
                                    }
                                    emit('success', { captchaVerification })
                                }, 400)
                            } else {
                                barAreaColor.value = '#d9534f'
                                barAreaBorderColor.value = '#d9534f'
                                text.value = '验证失败'
                                setTimeout(() => {
                                    refresh()
                                }, 700)
                            }
                        }).catch((err: any) => {
                            console.error('验证码验证失败:', err)
                            barAreaColor.value = '#d9534f'
                            barAreaBorderColor.value = '#d9534f'
                            text.value = '验证失败'
                            setTimeout(() => {
                                refresh()
                            }, 700)
                        })
                    }
                }).exec()
            }

            //坐标转换函数
            const pointTransfrom = (pointArr: Array<{x: number, y: number}>, imgSize: {width: string, height: string}) => {
                return pointArr.map(p => {
                    const x = Math.round(310 * p.x / parseInt(imgSize.width)) 
                    const y = Math.round(155 * p.y / parseInt(imgSize.height)) 
                    return {x, y}
                })
            }

            onMounted(() => {
                init()
            })

            return {
                secretKey,
                checkNum,
                fontPos,
                checkPosArr,
                num,
                pointBackImgBase,
                poinTextList,
                backToken,
                tempPoints,
                text,
                barAreaColor,
                barAreaBorderColor,
                showRefresh,
                bindingClick,
                showImage,
                imgLeft,
                imgTop,
                canvas,
                canvasClick,
                refresh
            }
        }
    }
</script>

<style scoped>
    .verify-image-out {
        display: block;
    }

    .verify-image-panel {
        margin: 0;
        box-sizing: content-box;
        border-top: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        border-radius: 3px;
        position: relative;
    }

    .verify-refresh {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 2;
        width: 25px;
        height: 25px;
        padding: 5px;
        text-align: center;
        cursor: pointer;
        background-color: rgba(0, 0, 0, 0.3);
    }

    .verify-refresh .icon-refresh {
        font-size: 20px;
        color: #fff;
    }

    .point-area {
        position: absolute;
        background-color: #1abd6c;
        color: #fff;
        z-index: 9999;
        width: 20px;
        height: 20px;
        text-align: center;
        line-height: 20px;
        border-radius: 50%;
    }

    .verify-bar-area {
        position: relative;
        background: #FFFFFF;
        text-align: center;
        box-sizing: content-box;
        border: 1px solid #ddd;
        border-radius: 4px;
        margin-top: 10px;
    }

    .verify-msg {
        z-index: 3;
        font-size: 14px;
    }

    .iconfont {
        font-family: "iconfont" !important;
        font-size: 16px;
        font-style: normal;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .icon-refresh {
        content: "↻";
        display: block;
        width: 16px;
        height: 16px;
        position: absolute;
        margin: auto;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        text-align: center;
        line-height: 16px;
        font-size: 16px;
        color: #fff;
    }
</style>