// 导入项目中的request工具
import request from '@/utils/request.uts'
import type { RequestConfig } from '@/utils/request.uts'

/**
 * 验证码请求配置
 */
export type CaptchaRequestConfig = {
  url: string
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE'
  data?: any
}

/**
 * 验证码请求工具
 * @param option 请求配置
 * @returns Promise
 */
export const myRequest = (option: CaptchaRequestConfig = { url: '' }) => {
  return new Promise((resolve, reject) => {
    // 构建请求配置
    const requestConfig: RequestConfig = {
      url: option.url,
      method: option.method || 'GET',
      data: option.data,
      // 验证码接口不需要token认证，避免401错误
      header: {
        'Content-Type': 'application/json',
        // 移除Authorization头，避免token过期问题
        'Authorization': ''
      }
    }
    
    // 使用项目中的request工具发送请求
    request(requestConfig)
      .then(res => {
        resolve(res)
      })
      .catch(err => {
        // 处理请求失败
        console.error('请求失败:', err)
        reject(err)
      })
  })
}