<template>
  <view class="history-overlay" v-if="visible" @click="onClose">
    <view class="history-container" @click.stop>
      <view class="history-header">
        <text class="history-title">编辑历史</text>
        <view class="history-close" @click="onClose">
          <text class="history-close-icon">×</text>
        </view>
      </view>
      
      <scroll-view class="history-content" scroll-y="true">
        <view v-if="historyList.length === 0" class="history-empty">
          <text class="history-empty-text">暂无编辑历史</text>
        </view>
        
        <view 
          v-for="(item, index) in historyList" 
          :key="index"
          class="history-item"
        >
          <view class="history-item-header">
            <text class="history-item-time">{{ formatTime(item.editTime) }}</text>
            <text v-if="index === 0" class="history-item-badge">当前版本</text>
          </view>
          <view class="history-item-content">
            <text class="history-item-text">{{ item.content }}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, PropType } from 'vue'
import type { EditHistory } from '@/services/message-edit-service.uts'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  },
  historyList: {
    type: Array as PropType<EditHistory[]>,
    default: () => [] as EditHistory[]
  }
})

const emit = defineEmits<{
  close: []
}>()

const onClose = () => {
  emit('close')
}

/**
 * 格式化时间
 */
const formatTime = (timeStr: string): string => {
  const date = new Date(timeStr)
  const now = new Date()
  
  const year = date.getFullYear()
  const month = (date.getMonth() + 1).toString().padStart(2, '0')
  const day = date.getDate().toString().padStart(2, '0')
  const hours = date.getHours().toString().padStart(2, '0')
  const minutes = date.getMinutes().toString().padStart(2, '0')
  const seconds = date.getSeconds().toString().padStart(2, '0')
  
  // 如果是今天，只显示时间
  if (date.getFullYear() === now.getFullYear() &&
      date.getMonth() === now.getMonth() &&
      date.getDate() === now.getDate()) {
    return `今天 ${hours}:${minutes}:${seconds}`
  }
  
  // 如果是今年，不显示年份
  if (year === now.getFullYear()) {
    return `${month}-${day} ${hours}:${minutes}:${seconds}`
  }
  
  return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`
}
</script>

