<template>
  <view class="edit-dialog-overlay" v-if="visible" @click="onCancel">
    <view class="edit-dialog-container" @click.stop>
      <view class="edit-dialog-header">
        <text class="edit-dialog-title">编辑消息</text>
        <view class="edit-dialog-close" @click="onCancel">
          <text class="edit-dialog-close-icon">×</text>
        </view>
      </view>
      
      <view class="edit-dialog-content">
        <!-- 时间提示 -->
        <view class="edit-time-hint" v-if="timeHint">
          <text class="edit-time-hint-text">{{ timeHint }}</text>
        </view>
        
        <!-- 输入框 -->
        <textarea
          class="edit-textarea"
          v-model="editContent"
          :placeholder="placeholder"
          :maxlength="maxLength"
          :auto-height="true"
          :focus="visible"
        />
        
        <!-- 字数统计 -->
        <view class="edit-char-count">
          <text class="edit-char-count-text">{{ editContent.length }}/{{ maxLength }}</text>
        </view>
        
        <!-- 编辑历史入口 -->
        <view class="edit-history-link" v-if="showHistory" @click="onViewHistory">
          <text class="edit-history-link-text">查看编辑历史</text>
          <text class="edit-history-link-icon">›</text>
        </view>
      </view>
      
      <view class="edit-dialog-footer">
        <view class="edit-dialog-btn edit-dialog-btn-cancel" @click="onCancel">
          <text class="edit-dialog-btn-text">取消</text>
        </view>
        <view 
          class="edit-dialog-btn edit-dialog-btn-confirm" 
          :class="{ 'edit-dialog-btn-disabled': !canConfirm }"
          @click="onConfirm"
        >
          <text class="edit-dialog-btn-text">确定</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch, PropType } from 'vue'

const props = defineProps({
  visible: {
    type: Boolean,
    default: false
  },
  content: {
    type: String,
    default: ''
  },
  placeholder: {
    type: String,
    default: '请输入消息内容'
  },
  maxLength: {
    type: Number,
    default: 5000
  },
  timeHint: {
    type: String,
    default: ''
  },
  showHistory: {
    type: Boolean,
    default: false
  }
})

const emit = defineEmits<{
  cancel: []
  confirm: [content: string]
  viewHistory: []
}>()

const editContent = ref('')

// 监听 visible 变化，重置内容
watch(() => props.visible, (newVal) => {
  if (newVal) {
    editContent.value = props.content
  }
})

// 监听 content 变化
watch(() => props.content, (newVal) => {
  if (props.visible) {
    editContent.value = newVal
  }
})

// 是否可以确认
const canConfirm = computed(() => {
  const trimmed = editContent.value.trim()
  return trimmed.length > 0 && trimmed !== props.content.trim()
})

const onCancel = () => {
  emit('cancel')
}

const onConfirm = () => {
  if (!canConfirm.value) {
    return
  }
  emit('confirm', editContent.value.trim())
}

const onViewHistory = () => {
  emit('viewHistory')
}
</script>

<style scoped>
