  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.edit-dialog-container {
  width: 80%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.edit-dialog-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1px solid #f0f0f0;
}

.edit-dialog-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.edit-dialog-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-dialog-close-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 48rpx;
}

.edit-dialog-content {
  padding: 32rpx;
}

.edit-time-hint {
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background-color: #fff3e0;
  border-radius: 8rpx;
}

.edit-time-hint-text {
  font-size: 24rpx;
  color: #ff9800;
}

.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  max-height: 400rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 1px solid #e0e0e0;
}

.edit-char-count {
  margin-top: 8rpx;
  text-align: right;
}

.edit-char-count-text {
  font-size: 24rpx;
  color: #999;
}

.edit-history-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.edit-history-link-text {
  font-size: 28rpx;
  color: #2196f3;
}

.edit-history-link-icon {
  font-size: 32rpx;
  color: #2196f3;
}

.edit-dialog-footer {
  display: flex;
  flex-direction: row;
  padding: 32rpx;
  gap: 16rpx;
  border-top: 1px solid #f0f0f0;
}

.edit-dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.edit-dialog-btn-cancel {
  background-color: #f5f5f5;
}

.edit-dialog-btn-confirm {
  background-color: #2196f3;
}

.edit-dialog-btn-disabled {
  background-color: #e0e0e0;
  opacity: 0.6;
}

.edit-dialog-btn-text {
  font-size: 28rpx;
  color: #333;
}

.edit-dialog-btn-confirm .edit-dialog-btn-text {
  color: #fff;
}
</style>
