/**
 * 消息搜索服务
 * 
 * 功能:
 * 1. 全局消息搜索
 * 2. 会话内消息搜索
 * 3. 按类型筛选
 * 4. 关键词高亮
 * 5. 搜索防抖
 */

import { request } from '@/utils/request.uts'

/**
 * 搜索结果项
 */
export type SearchResultItem = {
  id: string
  messageId: string
  chatId: string
  conversationName: string
  conversationAvatar: string
  senderId: string
  senderName: string
  type: string
  content: string
  timestamp: number
  highlightedContent: string
	raw?: any
}

/**
 * 搜索选项
 */
export type SearchOptions = {
  keyword: string
  chatId?: string
  messageType?: string
  startTime?: number
  endTime?: number
  pageNo?: number
  pageSize?: number
}

/**
 * 消息搜索服务类（单例模式）
 */
export class MessageSearchService {
  
  private static instance: MessageSearchService | null = null
  
  // 搜索防抖定时器
  private searchTimer: number = 0
  
  // 搜索防抖延迟（300毫秒）
  private readonly SEARCH_DEBOUNCE = 300
  
  // 最小搜索关键词长度
  private readonly MIN_KEYWORD_LENGTH = 2
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): MessageSearchService {
    if (MessageSearchService.instance === null) {
      MessageSearchService.instance = new MessageSearchService()
    }
    return MessageSearchService.instance
  }
  
  /**
   * 搜索消息（带防抖）
   */
  public searchMessages(
    options: SearchOptions,
    callback: (results: SearchResultItem[]) => void
  ): void {
    // 验证关键词长度
    if (options.keyword.length < this.MIN_KEYWORD_LENGTH) {
      callback([])
      return
    }
    
    // 清除之前的定时器
    if (this.searchTimer > 0) {
      clearTimeout(this.searchTimer)
    }
    
    // 设置新的定时器（防抖）
    this.searchTimer = setTimeout(() => {
      this.doSearch(options, callback)
    }, this.SEARCH_DEBOUNCE)
  }

	/**
	 * 搜索消息（无防抖，适用于分页/明确触发的搜索）
	 */
	public async searchMessagesAsync(options: SearchOptions): Promise<SearchResultItem[]> {
		if (options.keyword.length < this.MIN_KEYWORD_LENGTH) {
			return []
		}
		try {
			const params: any = {
				keyword: options.keyword,
				pageNo: options.pageNo || 1,
				pageSize: options.pageSize || 20
			}

			if (options.chatId !== null) {
				params.chatId = options.chatId
			}

			if (options.messageType !== null) {
				params.messageType = options.messageType
			}

			if (options.startTime !== null) {
				params.startTime = options.startTime
			}

			if (options.endTime !== null) {
				params.endTime = options.endTime
			}

			const data: any = await request({
				url: '/system/im/message/search',
				method: 'GET',
				params: params
			})
			if (data == null) {
				return []
			}
			const list = (data.list != null ? data.list : []) as any[]
			return list.map((item: any) => this.mapToSearchResult(item, options.keyword))
		} catch (e) {
			console.error('[MessageSearchService] 搜索消息失败:', e)
			return []
		}
	}
  
  /**
   * 实际执行搜索
   */
  private async doSearch(
    options: SearchOptions,
    callback: (results: SearchResultItem[]) => void
  ): Promise<void> {
    try {
      const params: any = {
        keyword: options.keyword,
        pageNo: options.pageNo || 1,
        pageSize: options.pageSize || 20
      }
      
      if (options.chatId != null && options.chatId !== '') {
        params.chatId = options.chatId
      }
      
      if (options.messageType != null && options.messageType !== '') {
        params.messageType = options.messageType
      }
      
      if (options.startTime != null) {
        params.startTime = options.startTime
      }
      
      if (options.endTime != null) {
        params.endTime = options.endTime
      }
      
      const data: any = await request({
        url: '/system/im/message/search',
        method: 'GET',
        params: params
      })

      if (data == null) {
        callback([])
        return
      }
      const list = (data.list != null ? data.list : []) as any[]
      const results = list.map((item: any) => this.mapToSearchResult(item, options.keyword))
      callback(results)
    } catch (e) {
      console.error('[MessageSearchService] 搜索消息失败:', e)
      callback([])
    }
  }
  
  /**
   * 取消搜索
   */
  public cancelSearch(): void {
    if (this.searchTimer > 0) {
      clearTimeout(this.searchTimer)
      this.searchTimer = 0
    }
  }
  
  /**
   * 高亮关键词
   */
  public highlightKeyword(text: string, keyword: string): string {
    if (!keyword || keyword.length === 0) {
      return text
    }
    
    // 转义特殊字符
    const escapedKeyword = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    
    // 使用正则表达式替换（不区分大小写）
    const regex = new RegExp(escapedKeyword, 'gi')
    return text.replace(regex, (match) => {
      return '<span class="highlight">' + match + '</span>'
    })
  }
  
  /**
   * 获取消息内容摘要（用于搜索结果显示）
   */
  public getContentSummary(type: any, content: any, maxLength: number = 100): string {
    switch (type) {
      case 'text':
      case 1:
        const text = typeof content === 'string' ? content : content.content || ''
        return text.length > maxLength ? text.substring(0, maxLength) + '...' : text
      case 'image':
      case 2:
        return '[图片]'
      case 'voice':
      case 3:
        return '[语音]'
      case 'video':
      case 4:
        return '[视频]'
      case 'file':
      case 5:
        return '[文件]'
      case 'location':
      case 6:
        return '[位置]'
      case 'emoji':
      case 7:
        return '[表情]'
      case 'sticker':
      case 8:
        return '[动画表情]'
      default:
        return '[消息]'
    }
  }
  
  /**
   * 映射服务器数据到搜索结果项
   */
  private mapToSearchResult(data: any, keyword: string): SearchResultItem {
    const messageType = data.type != null ? data.type : data.messageType
    const senderName = data.senderName || data.senderNickname || ''
    const conversationName = data.conversationName || senderName || ''
    const conversationAvatar = data.conversationAvatar || data.senderAvatar || ''
    let timestamp = 0
    try {
      const sendTime = data.timestamp != null ? data.timestamp : data.sendTime
      if (typeof sendTime === 'number') {
        timestamp = sendTime
      } else if (sendTime != null && String(sendTime) !== '') {
        timestamp = new Date(String(sendTime)).getTime()
      }
    } catch (e) {
      timestamp = 0
    }
    const content = this.getContentSummary(messageType, data.content)
    
    return {
      id: data.id != null ? data.id.toString() : '0',
      messageId: data.messageId != null ? data.messageId.toString() : (data.id != null ? data.id.toString() : '0'),
      chatId: data.chatId != null ? data.chatId.toString() : '0',
      conversationName: conversationName,
      conversationAvatar: conversationAvatar,
      senderId: data.senderId != null ? data.senderId.toString() : '0',
      senderName: senderName,
      type: typeof messageType === 'number' ? String(messageType) : messageType,
      content: content,
      timestamp: timestamp,
      highlightedContent: this.highlightKeyword(content, keyword),
		raw: data
    }
  }
  
  /**
   * 按消息类型筛选
   */
  public filterByType(results: SearchResultItem[], messageType: string): SearchResultItem[] {
    if (!messageType || messageType === 'all') {
      return results
    }
    
    return results.filter(item => item.type === messageType)
  }
  
  /**
   * 按时间范围筛选
   */
  public filterByTimeRange(
    results: SearchResultItem[],
    startTime: number,
    endTime: number
  ): SearchResultItem[] {
    return results.filter(item => {
      return item.timestamp >= startTime && item.timestamp <= endTime
    })
  }
  
  /**
   * 按会话筛选
   */
  public filterByConversation(
    results: SearchResultItem[],
    chatId: string
  ): SearchResultItem[] {
    return results.filter(item => item.chatId === chatId)
  }
}

/**
 * 导出单例实例
 */
export const messageSearchService = MessageSearchService.getInstance()
