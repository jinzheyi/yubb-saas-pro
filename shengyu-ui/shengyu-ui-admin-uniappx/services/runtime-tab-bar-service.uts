import { subscribeLocaleChange, t } from '../store/locale.uts'
import { getThemeTokens, subscribeThemeChange } from '../store/theme.uts'
import type { ThemeTokens } from '../config/theme.uts'

type UnsubscribeFn = (() => void) | null

type TabBarItemConfig = {
	index: number
	textKey: string
}

const TAB_BAR_ITEMS: TabBarItemConfig[] = [
	{ index: 0, textKey: 'runtime.tabBar.message' },
	{ index: 1, textKey: 'runtime.tabBar.contacts' },
	{ index: 2, textKey: 'runtime.tabBar.workbench' },
	{ index: 3, textKey: 'runtime.tabBar.mine' }
]

function applyTabBarLabels(): void {
	for (let i = 0; i < TAB_BAR_ITEMS.length; i++) {
		const item = TAB_BAR_ITEMS[i]
		try {
			const result = uni.setTabBarItem({
				index: item.index,
				text: t(item.textKey)
			})
			const maybePromise: any = result as any
			if (maybePromise != null && typeof maybePromise.catch === 'function') {
				maybePromise.catch((_err: any) => {
					// ignore timing/platform differences
				})
			}
		} catch (e) {
			// ignore
		}
	}
}

function applyTabBarTheme(tokens: ThemeTokens): void {
	try {
		const result = uni.setTabBarStyle({
			color: tokens.tabBarText,
			selectedColor: tokens.tabBarActiveText,
			backgroundColor: tokens.tabBarBg,
			borderStyle: tokens.borderColor.toLowerCase() === '#eff0f1' ? 'black' : 'white'
		})
		const maybePromise: any = result as any
		if (maybePromise != null && typeof maybePromise.catch === 'function') {
			maybePromise.catch((_err: any) => {
				// ignore timing/platform differences
			})
		}
	} catch (e) {
		// ignore
	}
}

class RuntimeTabBarService {
	private static instance: RuntimeTabBarService | null = null
	private unsubscribeLocale: UnsubscribeFn = null
	private unsubscribeTheme: UnsubscribeFn = null
	private initialized: boolean = false
	private refreshTimerIds: number[] = []

	static getInstance(): RuntimeTabBarService {
		if (RuntimeTabBarService.instance == null) {
			RuntimeTabBarService.instance = new RuntimeTabBarService()
		}
		return RuntimeTabBarService.instance
	}

	init(): void {
		if (this.initialized) {
			this.refresh()
			return
		}
		this.initialized = true
		this.unsubscribeLocale = subscribeLocaleChange((_resolvedLocale, _languageMode) => {
			this.scheduleRefresh()
		})
		this.unsubscribeTheme = subscribeThemeChange((_resolvedTheme, _mode, tokens) => {
			this.scheduleRefresh()
		})
		this.scheduleRefresh()
	}

	refresh(): void {
		this.scheduleRefresh()
	}

	private clearRefreshTimers(): void {
		for (let i = 0; i < this.refreshTimerIds.length; i++) {
			clearTimeout(this.refreshTimerIds[i])
		}
		this.refreshTimerIds.length = 0
	}

	private applyNow(): void {
		applyTabBarLabels()
		applyTabBarTheme(getThemeTokens())
	}

	private scheduleRefresh(): void {
		this.clearRefreshTimers()
		this.applyNow()
		const retryDelays: number[] = [60, 180, 360]
		for (let i = 0; i < retryDelays.length; i++) {
			const timerId = setTimeout(() => {
				this.applyNow()
			}, retryDelays[i])
			this.refreshTimerIds.push(timerId)
		}
	}
}

export const runtimeTabBarService = RuntimeTabBarService.getInstance()
