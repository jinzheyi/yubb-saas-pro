/**
 * 群组服务
 * 
 * 功能:
 * 1. 群组创建和管理
 * 2. 群成员管理
 * 3. 群公告管理
 * 4. 群名片管理
 * 5. 群成员禁言
 */

import { getAvatarText, getUserAvatarColor } from '@/utils/avatar.uts'
import {
  createGroup as apiCreateGroup,
  getGroup as apiGetGroup,
  updateGroup as apiUpdateGroup,
  dissolveGroup as apiDissolveGroup,
  quitGroup as apiQuitGroup,
  addGroupMembers as apiAddGroupMembers,
  removeGroupMember as apiRemoveGroupMember,
  getGroupMembers as apiGetGroupMembers,
  setGroupMemberRole as apiSetGroupMemberRole,
  setGroupMemberMuted as apiSetGroupMemberMuted,
  setGroupMuteAll as apiSetGroupMuteAll,
  setGroupMemberNickname as apiSetGroupMemberNickname,
  transferGroupOwner as apiTransferGroupOwner,
  updateGroupNotice as apiUpdateGroupNotice
} from '@/api/group.uts'

/**
 * 群组信息
 */
export type GroupInfo = {
  id: string
  name: string
  avatar: string
  ownerId: string
  ownerName: string
  memberCount: number
  maxMembers: number
  notice: string
  noticePinned: boolean
  createTime: number
  muteAll: boolean
  myRole: number
}

/**
 * 群成员信息
 */
export type GroupMember = {
  userId: string
  userName: string
  avatar: string
  avatarText: string
  avatarBg: string
  role: number  // 0-普通成员 1-管理员 2-群主
  nickname: string  // 群名片
  joinTime: number
  muteEndTime: number  // 禁言结束时间，0表示未禁言
}

/**
 * 群公告信息
 */
export type GroupAnnouncement = {
  id: string
  groupId: string
  content: string
  publisherId: string
  publisherName: string
  publishTime: number
  mustRead: boolean
}

/**
 * 群组服务类（单例模式）
 */
export class GroupService {
  
  private static instance: GroupService | null = null
  
  // 群组信息缓存
  private groupCache: Map<string, GroupInfo> = new Map()
  
  // 群成员缓存
  private memberCache: Map<string, GroupMember[]> = new Map()
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): GroupService {
    if (GroupService.instance === null) {
      GroupService.instance = new GroupService()
    }
    return GroupService.instance
  }
  
  /**
   * 创建群组
   */
  public async createGroup(name: string, memberIds: string[]): Promise<string> {
    try {
      const data: any = await apiCreateGroup({
        name: name,
        memberIds: memberIds
      })

      if (data == null) {
        return '0'
      }

      // 兼容多种返回形态：number/string/object
      if (typeof data === 'number' || typeof data === 'string') {
        return (data as any).toString()
      }
      if (typeof data === 'object') {
        const groupId = (data.groupId != null ? data.groupId : data.id)
        return groupId != null ? groupId.toString() : '0'
      }

      return '0'
    } catch (e) {
      console.error('[GroupService] 创建群组失败:', e)
      return '0'
    }
  }
  
  /**
   * 获取群组信息
   */
  public async getGroupInfo(groupId: string): Promise<GroupInfo | null> {
    // 先从缓存获取
    const cached = this.groupCache.get(groupId)
    if (cached !== null) {
      return cached
    }
    
    try {
      const data: any = await apiGetGroup(groupId)

      if (data == null) {
        return null
      }
      const groupInfo = this.mapToGroupInfo(data)
      this.groupCache.set(groupId, groupInfo)
      return groupInfo
    } catch (e) {
      console.error('[GroupService] 获取群组信息失败:', e)
      return null
    }
  }
  
  /**
   * 更新群组信息
   */
  public async updateGroup(groupId: string, name: string, avatar: string): Promise<boolean> {
    try {
      await apiUpdateGroup({
        id: groupId,
        name: name,
        avatar: avatar
      })

      // 清除缓存
      this.groupCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 更新群组信息失败:', e)
      return false
    }
  }
  
  /**
   * 解散群组
   */
  public async dismissGroup(groupId: string): Promise<boolean> {
    try {
      await apiDissolveGroup(groupId)

      // 清除缓存
      this.groupCache.delete(groupId)
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 解散群组失败:', e)
      return false
    }
  }
  
  /**
   * 获取群成员列表
   */
  public async getGroupMembers(groupId: string): Promise<GroupMember[]> {
    // 先从缓存获取
    const cached = this.memberCache.get(groupId)
    if (cached !== null && cached.every((item: GroupMember) => {
      const userName = item != null && item.userName != null ? String(item.userName).trim() : ''
      const nickname = item != null && item.nickname != null ? String(item.nickname).trim() : ''
      return userName !== '' || nickname !== ''
    })) {
      return cached
    }
    
    try {
      const data: any = await apiGetGroupMembers(groupId)

      if (data == null) {
        return []
      }
      const members = (data as any[]).map((item: any) => this.mapToGroupMember(item))
      this.memberCache.set(groupId, members)
      return members
    } catch (e) {
      console.error('[GroupService] 获取群成员列表失败:', e)
      return []
    }
  }
  
  /**
   * 添加群成员
   */
  public async addMembers(groupId: string, memberIds: string[]): Promise<boolean> {
    try {
      await apiAddGroupMembers({
        groupId: groupId,
        memberIds: memberIds
      })

      // 清除缓存
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 添加群成员失败:', e)
      return false
    }
  }
  
  /**
   * 移除群成员
   */
  public async removeMembers(groupId: string, memberIds: string[]): Promise<boolean> {
    try {
      for (let i = 0; i < memberIds.length; i++) {
        const memberUserId = memberIds[i]
        await apiRemoveGroupMember(groupId, memberUserId)
      }

      // 清除缓存
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 移除群成员失败:', e)
      return false
    }
  }
  
  /**
   * 退出群组
   */
  public async quitGroup(groupId: string): Promise<boolean> {
    try {
      await apiQuitGroup(groupId)

      // 清除缓存
      this.groupCache.delete(groupId)
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 退出群组失败:', e)
      return false
    }
  }
  
  /**
   * 转让群组
   */
  public async transferGroup(groupId: string, newOwnerId: string): Promise<boolean> {
    try {
      await apiTransferGroupOwner(groupId, newOwnerId)

      // 清除缓存
      this.groupCache.delete(groupId)
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 转让群组失败:', e)
      return false
    }
  }
  
  /**
   * 设置管理员
   */
  public async setAdmin(groupId: string, userId: string, isAdmin: boolean): Promise<boolean> {
    try {
      await apiSetGroupMemberRole(groupId, userId, isAdmin ? 1 : 0)

      // 清除缓存
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 设置管理员失败:', e)
      return false
    }
  }
  
  /**
   * 禁言成员
   */
  public async muteMember(groupId: string, userId: string, duration: number): Promise<boolean> {
    try {
      await apiSetGroupMemberMuted(groupId, userId, true)

      // 清除缓存
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 禁言成员失败:', e)
      return false
    }
  }
  
  /**
   * 解除禁言
   */
  public async unmuteMember(groupId: string, userId: string): Promise<boolean> {
    try {
      await apiSetGroupMemberMuted(groupId, userId, false)

      // 清除缓存
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 解除禁言失败:', e)
      return false
    }
  }
  
  /**
   * 全员禁言
   */
  public async muteAll(groupId: string, mute: boolean): Promise<boolean> {
    try {
      await apiSetGroupMuteAll(groupId, mute)
      this.groupCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 全员禁言失败:', e)
      return false
    }
  }
  
  /**
   * 设置群名片
   */
  public async setMemberNickname(groupId: string, userId: string, nickname: string): Promise<boolean> {
    try {
      await apiSetGroupMemberNickname({
        groupId: groupId,
        memberUserId: userId,
        nickname: nickname
      })
      this.memberCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 设置群名片失败:', e)
      return false
    }
  }
  
  /**
   * 发布群公告
   */
  public async publishAnnouncement(
    groupId: string,
    content: string,
    mustRead: boolean
  ): Promise<boolean> {
    try {
      const currentGroupInfo = await this.getGroupInfo(groupId)
      await apiUpdateGroupNotice({
        groupId: groupId,
        notice: content,
        notifyMembers: mustRead,
        pinNotice: currentGroupInfo != null ? currentGroupInfo.noticePinned === true : false
      })
      this.groupCache.delete(groupId)
      return true
    } catch (e) {
      console.error('[GroupService] 发布群公告失败:', e)
      return false
    }
  }
  
  /**
   * 获取群公告列表
   */
  public async getAnnouncements(groupId: string): Promise<GroupAnnouncement[]> {
    try {
      const groupInfo = await this.getGroupInfo(groupId)
      if (groupInfo == null) {
        return []
      }
      const content = groupInfo.notice != null ? String(groupInfo.notice).trim() : ''
      if (content === '') {
        return []
      }
      return [{
        id: `${groupId}-notice`,
        groupId: groupId,
        content: content,
        publisherId: groupInfo.ownerId,
        publisherName: groupInfo.ownerName,
        publishTime: groupInfo.createTime,
        mustRead: false
      }]
    } catch (e) {
      console.error('[GroupService] 获取群公告列表失败:', e)
      return []
    }
  }
  
  /**
   * 映射服务器数据到群组信息
   */
  private mapToGroupInfo(data: any): GroupInfo {
    const createTime = this.normalizeTimeMs(data != null ? data.createTime : null)
    return {
      id: data.id != null ? data.id.toString() : '0',
      name: data.name || '',
      avatar: data.avatar || '',
      ownerId: data.ownerId != null ? data.ownerId.toString() : '0',
      ownerName: data.ownerName || '',
      memberCount: data.memberCount || 0,
      maxMembers: data.maxMemberCount || data.maxMembers || 500,
      notice: data.notice || '',
      noticePinned: data.noticePinned === true,
      createTime: createTime,
      muteAll: data.muteAll === true,
      myRole: data.myRole != null ? Number(data.myRole) : 0
    }
  }
  
  /**
   * 映射服务器数据到群成员信息
   */
  private mapToGroupMember(data: any): GroupMember {
    const userId = data.userId != null ? data.userId.toString() : '0'
    const userName = data.userName || data.userNickname || ''
    const nickname = data.nickname || ''
    const displayName = nickname || userName
    return {
      userId: userId,
      userName: userName,
      avatar: data.avatar || data.userAvatar || '',
      avatarText: data.avatarText || getAvatarText(displayName),
      avatarBg: data.avatarBg || getUserAvatarColor(userId),
      role: data.role != null ? Number(data.role) : 0,
      nickname: nickname,
      joinTime: this.normalizeTimeMs(data != null ? data.joinTime : null),
      muteEndTime: this.normalizeTimeMs(data != null ? data.muteEndTime : null)
    }
  }

  private normalizeTimeMs(raw: any): number {
    if (raw == null || raw === '') {
      return 0
    }
    try {
      if (typeof raw === 'number') {
        return Number.isFinite(raw) && raw > 0 ? Math.round(raw) : 0
      }
      const asNumber = Number(raw)
      if (!Number.isNaN(asNumber) && asNumber > 0) {
        return Math.round(asNumber)
      }
      const parsed = new Date(String(raw)).getTime()
      return Number.isNaN(parsed) || parsed <= 0 ? 0 : parsed
    } catch (e) {
      return 0
    }
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    this.groupCache.clear()
    this.memberCache.clear()
  }

  public invalidateGroupMembers(groupId: string): void {
    if (groupId == null || groupId === '') {
      return
    }
    this.memberCache.delete(groupId)
  }

  public invalidateGroupInfo(groupId: string): void {
    if (groupId == null || groupId === '') {
      return
    }
    this.groupCache.delete(groupId)
  }

  public invalidateGroup(groupId: string): void {
    if (groupId == null || groupId === '') {
      return
    }
    this.groupCache.delete(groupId)
    this.memberCache.delete(groupId)
  }
}

/**
 * 导出单例实例
 */
export const groupService = GroupService.getInstance()
