import { checkAppUpgrade, reportAppUpgradeEvent, type AppUpgradeCheckResp } from '../api/app-upgrade.uts'
import {
	getAppVersion,
	getAppVersionCode,
	getCurrentClientPlatform,
	getCurrentDeviceType,
	getDeviceId,
	getClientPlatformInfo,
	ClientPlatformCode
} from '../utils/device.uts'
import { openExternalUrl } from '../utils/external-url.uts'
import { t } from '../store/locale.uts'

export enum UpgradeResultCode {
	NO_UPDATE = 'NO_UPDATE',
	OPTIONAL_UPDATE = 'OPTIONAL_UPDATE',
	FORCE_UPDATE = 'FORCE_UPDATE',
	BLOCKED = 'BLOCKED'
}

export enum UpgradeAction {
	NONE = 'NONE',
	OPEN_URL = 'OPEN_URL',
	OPEN_STORE = 'OPEN_STORE',
	OPEN_APP_GALLERY = 'OPEN_APP_GALLERY',
	REFRESH_WEB = 'REFRESH_WEB'
}

export type ResolvedUpgradeInfo = {
	resultCode: string
	title: string
	content: string
	latestVersion: string
	latestVersionCode: number
	forceUpdate: boolean
	action: string
	targetUrl: string
	raw: AppUpgradeCheckResp | null
}

const DEFAULT_APP_CODE = 'shengyu-im-app'
const DEFAULT_CHANNEL = 'stable'
const UPGRADE_SILENT_CHECK_KEY = '__IM_APP_UPGRADE_LAST_CHECK_AT__'
const UPGRADE_OPTIONAL_IGNORE_KEY = '__IM_APP_UPGRADE_OPTIONAL_IGNORE_VERSION__'
const UPGRADE_SILENT_CHECK_INTERVAL = 6 * 60 * 60 * 1000

function getUpgradeAppCode(): string {
	return DEFAULT_APP_CODE
}

function getUpgradeChannel(): string {
	return DEFAULT_CHANNEL
}

function buildDefaultNoUpdateInfo(): ResolvedUpgradeInfo {
	return {
		resultCode: UpgradeResultCode.NO_UPDATE,
		title: '',
		content: '',
		latestVersion: getAppVersion(),
		latestVersionCode: getAppVersionCode(),
		forceUpdate: false,
		action: UpgradeAction.NONE,
		targetUrl: '',
		raw: null
	}
}

function normalizeUpgradeResponse(resp: AppUpgradeCheckResp | null): ResolvedUpgradeInfo {
	if (resp == null) {
		return buildDefaultNoUpdateInfo()
	}
	const resultCode = resp.resultCode && resp.resultCode !== '' ? resp.resultCode : UpgradeResultCode.NO_UPDATE
	const latestVersion = resp.latestVersion && resp.latestVersion !== '' ? resp.latestVersion : getAppVersion()
	const latestVersionCode = resp.latestVersionCode != null ? Number(resp.latestVersionCode) : getAppVersionCode()
	const action = resp.action && resp.action !== '' ? resp.action : UpgradeAction.NONE
	const targetUrl = String(resp.downloadUrl || resp.storeUrl || resp.marketUrl || resp.webUrl || '')
	return {
		resultCode: resultCode,
		title: String(resp.title || ''),
		content: String(resp.releaseNotes || resp.content || ''),
		latestVersion: latestVersion,
		latestVersionCode: latestVersionCode,
		forceUpdate: resp.forceUpdate === true || resultCode === UpgradeResultCode.FORCE_UPDATE,
		action: action,
		targetUrl: targetUrl,
		raw: resp
	}
}

class AppUpgradeService {
	async check(trigger: string = 'manual'): Promise<ResolvedUpgradeInfo> {
		const platformInfo = getClientPlatformInfo()
		const req = {
			appCode: getUpgradeAppCode(),
			platform: getCurrentClientPlatform(),
			channel: getUpgradeChannel(),
			clientVersion: getAppVersion(),
			clientVersionCode: getAppVersionCode(),
			deviceId: getDeviceId(),
			deviceType: getCurrentDeviceType(),
			osName: platformInfo.osName,
			osVersion: platformInfo.osVersion,
			manufacturer: platformInfo.deviceBrand,
			model: platformInfo.deviceModel,
			harmonyApiVersion: platformInfo.harmonyApiVersion,
			harmonyDisplayVersion: platformInfo.harmonyDisplayVersion
		}
		const resp = await checkAppUpgrade(req)
		void this.reportEvent('CHECK', {
			trigger: trigger,
			resultCode: resp != null ? String(resp.resultCode || '') : ''
		})
		return normalizeUpgradeResponse(resp)
	}

	async performUpgrade(info: ResolvedUpgradeInfo): Promise<void> {
		const platform = getCurrentClientPlatform()
		if (info.action === UpgradeAction.REFRESH_WEB || platform === ClientPlatformCode.WEB) {
			// #ifdef H5
			if (typeof window !== 'undefined' && window.location != null) {
				window.location.reload()
				return
			}
			// #endif
			throw new Error('web reload unsupported')
		}
		if (info.targetUrl === '') {
			throw new Error('missing target url')
		}
		await openExternalUrl(info.targetUrl)
		void this.reportEvent(platform === ClientPlatformCode.HARMONY ? 'OPEN_APP_GALLERY' : 'OPEN_STORE', {
			action: info.action,
			targetUrl: info.targetUrl
		})
	}

	isOptionalVersionIgnored(info: ResolvedUpgradeInfo): boolean {
		if (info.resultCode !== UpgradeResultCode.OPTIONAL_UPDATE) {
			return false
		}
		try {
			const raw = uni.getStorageSync(UPGRADE_OPTIONAL_IGNORE_KEY)
			const ignoredVersionCode = raw != null ? Number(raw) : 0
			return !isNaN(ignoredVersionCode) && ignoredVersionCode > 0 && ignoredVersionCode === info.latestVersionCode
		} catch (e) {
			return false
		}
	}

	ignoreOptionalVersion(info: ResolvedUpgradeInfo): void {
		if (info.resultCode !== UpgradeResultCode.OPTIONAL_UPDATE) {
			return
		}
		try {
			uni.setStorageSync(UPGRADE_OPTIONAL_IGNORE_KEY, info.latestVersionCode)
		} catch (e) {
			console.warn('[AppUpgrade] ignoreOptionalVersion failed:', e)
		}
	}

	clearIgnoredOptionalVersion(): void {
		try {
			uni.removeStorageSync(UPGRADE_OPTIONAL_IGNORE_KEY)
		} catch (e) {
			// ignore
		}
	}

	shouldCheckSilently(): boolean {
		try {
			const raw = uni.getStorageSync(UPGRADE_SILENT_CHECK_KEY)
			const lastCheckAt = raw != null ? Number(raw) : 0
			if (!isNaN(lastCheckAt) && lastCheckAt > 0 && Date.now() - lastCheckAt < UPGRADE_SILENT_CHECK_INTERVAL) {
				return false
			}
		} catch (e) {
			// ignore
		}
		return true
	}

	markSilentCheckAt(): void {
		try {
			uni.setStorageSync(UPGRADE_SILENT_CHECK_KEY, Date.now())
		} catch (e) {
			// ignore
		}
	}

	async checkSilentlyIfNeeded(): Promise<void> {
		if (!this.shouldCheckSilently()) {
			return
		}
		this.markSilentCheckAt()
		try {
			const info = await this.check('silent')
			if (this.isOptionalVersionIgnored(info)) {
				return
			}
			if (info.resultCode !== UpgradeResultCode.FORCE_UPDATE && info.resultCode !== UpgradeResultCode.BLOCKED) {
				return
			}
			const modalTitle = info.title !== '' ? info.title : t('profile.settingsPage.updateFoundTitle', { version: info.latestVersion })
			const modalContent = info.content !== ''
				? info.content
				: t('profile.settingsPage.updateFoundContent', { version: info.latestVersion })
			await this.reportEvent('SHOW_DIALOG', {
				trigger: 'silent',
				resultCode: info.resultCode,
				latestVersion: info.latestVersion
			})
			if (info.resultCode === UpgradeResultCode.BLOCKED) {
				uni.showModal({
					title: modalTitle,
					content: modalContent,
					showCancel: false,
					confirmText: t('common.ok')
				})
				return
			}
			uni.showModal({
				title: modalTitle,
				content: modalContent,
				showCancel: false,
				confirmText: getCurrentClientPlatform() === ClientPlatformCode.HARMONY
					? t('profile.settingsPage.goToAppGallery')
					: t('profile.settingsPage.updateNow'),
				success: async (res) => {
					if (!res.confirm) {
						return
					}
					await this.reportEvent('CLICK_UPDATE', {
						trigger: 'silent',
						resultCode: info.resultCode,
						latestVersion: info.latestVersion
					})
					try {
						await this.performUpgrade(info)
					} catch (e) {
						console.error('[AppUpgrade] silent performUpgrade failed:', e)
						uni.showToast({
							title: t('profile.settingsPage.openUpgradeFailed'),
							icon: 'none'
						})
					}
				}
			})
		} catch (e) {
			console.warn('[AppUpgrade] silent check failed:', e)
		}
	}

	async reportEvent(eventType: string, payload?: UTSJSONObject | null): Promise<void> {
		try {
			await reportAppUpgradeEvent({
				appCode: getUpgradeAppCode(),
				platform: getCurrentClientPlatform(),
				eventType: eventType,
				clientVersion: getAppVersion(),
				clientVersionCode: getAppVersionCode(),
				deviceId: getDeviceId(),
				payload: payload || null
			})
		} catch (e) {
			console.warn('[AppUpgrade] reportEvent failed:', e)
		}
	}
}

export const appUpgradeService = new AppUpgradeService()
