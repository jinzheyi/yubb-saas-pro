/**
 * 已读回执服务
 * 
 * 功能:
 * 1. 发送已读回执
 * 2. 接收已读回执
 * 3. 更新消息已读状态
 * 4. 查看已读详情（群聊）
 * 5. 批量标记已读
 */

import { messageService } from './message-service.uts'
import { badgeService } from './badge-service.uts'
import { getReadReceiptDetail, getReadReceiptSummary } from '../api/read-receipt.uts'
import { markMessageRead } from '../api/message.uts'

/**
 * 已读详情项
 */
export type ReadDetailItem = {
  userId: string
  userName: string
  avatar: string
  readTime: number
}

export type ReadReceiptSummary = {
  messageId: string
  chatId: string
  sequence: string
  readCount: number
  unreadCount: number
  totalCount: number
  messageType: number
  readBasis: string
}

export type ReadReceiptDetailPage = {
  list: ReadDetailItem[]
  total: number
}

/**
 * 已读回执服务类（单例模式）
 */
export class ReadReceiptService {
  
  private static instance: ReadReceiptService | null = null
  
  // 已读状态缓存（messageId -> 已读用户ID列表）
  private readStatus: Map<string, string[]> = new Map()
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): ReadReceiptService {
    if (ReadReceiptService.instance === null) {
      ReadReceiptService.instance = new ReadReceiptService()
    }
    return ReadReceiptService.instance
  }
  
  /**
   * 标记消息为已读（进入会话时调用）
   */
  public async markMessagesAsRead(chatId: string, messageIds: string[]): Promise<boolean> {
    if (messageIds.length === 0) {
      return true
    }

    try {
      await markMessageRead(messageIds)
      return true
    } catch (e) {
      console.error('[ReadReceiptService] markMessagesAsRead failed:', e)
      return false
    }
  }
  
  /**
   * 发送已读回执
   */
  private sendReadReceipt(chatId: string, messageIds: string[]): void {
    // 通过 MessageService 发送已读回执
    // 注意：这里需要知道接收者ID，实际应该从会话信息中获取
    // 简化处理：使用 chatId 作为 receiverId
    messageService.sendReadReceipt(chatId, messageIds)
  }
  
  /**
   * 接收已读回执（更新本地消息状态）
   */
  public receiveReadReceipt(messageIds: string[], readUserId: string): void {
    messageIds.forEach(messageId => {
      // 获取或创建已读用户列表
      let readUserIds = this.readStatus.get(messageId)
      if (readUserIds === null) {
        readUserIds = []
        this.readStatus.set(messageId, readUserIds)
      }
      
      // 添加已读用户（去重）
      if (!readUserIds.includes(readUserId)) {
        readUserIds.push(readUserId)
      }
    })
    
    console.log('[ReadReceiptService] 接收已读回执, messageIds:', messageIds, 'readUserId:', readUserId)
  }
  
  /**
   * 获取消息的已读状态（单聊）
   */
  public getReadStatus(messageId: string): 'unread' | 'read' {
    const readUserIds = this.readStatus.get(messageId)
    return (readUserIds !== null && readUserIds.length > 0) ? 'read' : 'unread'
  }
  
  /**
   * 获取消息的已读人数（群聊）
   */
  public getReadCount(messageId: string): number {
    const readUserIds = this.readStatus.get(messageId)
    return readUserIds !== null ? readUserIds.length : 0
  }

  public async getSummary(messageId: string): Promise<ReadReceiptSummary | null> {
    try {
      const data: any = await getReadReceiptSummary(messageId)
      if (data == null) {
        return null
      }
      return {
        messageId: data.messageId != null ? data.messageId.toString() : messageId,
        chatId: data.chatId != null ? data.chatId.toString() : '0',
        sequence: data.sequence != null ? data.sequence.toString() : '0',
        readCount: data.readCount != null ? Number(data.readCount) : 0,
        unreadCount: data.unreadCount != null ? Number(data.unreadCount) : 0,
        totalCount: data.totalCount != null ? Number(data.totalCount) : 0,
        messageType: data.messageType != null ? Number(data.messageType) : 0,
        readBasis: data.readBasis != null ? data.readBasis.toString() : ''
      }
    } catch (e) {
      try {
        const err: any = e as any
        const code = err != null && err.code != null ? Number(err.code) : 0
        const msg = err != null && err.msg != null ? String(err.msg) : ''
        if (code === 1002030100 || msg === '消息不存在') {
          return null
        }
      } catch (ignore) {
      }
      console.error('[ReadReceiptService] getSummary failed:', e)
      return null
    }
  }

  public async getDetailPage(messageId: string, status: 'read' | 'unread', pageNo: number = 1, pageSize: number = 20): Promise<ReadReceiptDetailPage> {
    try {
      const data: any = await getReadReceiptDetail(messageId, status, pageNo, pageSize)
      const listRaw: any[] = data && data.list != null ? data.list : []
      const list: ReadDetailItem[] = listRaw.map((it: any) => {
        let readTime = 0
        try {
          if (it.readTime) {
            const ts = new Date(it.readTime).getTime()
            if (!isNaN(ts) && ts > 0) {
              readTime = ts
            }
          }
        } catch (e) {
          // ignore
        }
        return {
          userId: it.userId != null ? it.userId.toString() : '0',
          userName: (it.userNickname || '').toString(),
          avatar: (it.userAvatar || '').toString(),
          readTime
        }
      })
      const total = data && data.total != null ? Number(data.total) : list.length
      return { list, total }
    } catch (e) {
      console.error('[ReadReceiptService] getDetailPage failed:', e)
      return { list: [], total: 0 }
    }
  }
  
  /**
   * 获取消息的已读详情（群聊）
   */
  public async getReadDetail(messageId: string): Promise<ReadDetailItem[]> {
    try {
      const page = await this.getDetailPage(messageId, 'read', 1, 200)
      return page.list
    } catch (e) {
      console.error('[ReadReceiptService] 获取已读详情失败:', e)
      return []
    }
  }
  
  /**
   * 获取消息的未读详情（群聊）
   */
  public async getUnreadDetail(messageId: string): Promise<ReadDetailItem[]> {
    try {
      const page = await this.getDetailPage(messageId, 'unread', 1, 200)
      return page.list
    } catch (e) {
      console.error('[ReadReceiptService] 获取未读详情失败:', e)
      return []
    }
  }
  
  /**
   * 批量标记会话消息为已读
   */
  public async markConversationAsRead(chatId: string): Promise<boolean> {
    try {
      // 最优路径：会话已读由进入会话时上报 readSequence（水位）处理，这里不再直接调用后端接口

      // 更新本地会话未读数（不触发服务端水位推进）
      badgeService.clearConversationBadgeLocal(chatId)
      return true
    } catch (e) {
      console.error('[ReadReceiptService] 标记会话已读失败:', e)
      return false
    }
  }
  
  /**
   * 获取会话的未读消息列表
   */
  public async getUnreadMessages(chatId: string): Promise<string[]> {
    try {
      const normalizedChatId = chatId != null ? String(chatId).trim() : ''
      if (normalizedChatId === '' || normalizedChatId === '0') {
        return []
      }
      const list = messageService.getMessages(normalizedChatId)
      const unreadMessageIds: string[] = []
      for (let i = 0; i < list.length; i++) {
        const item = list[i]
        if (item == null || item.isSelf === true) {
          continue
        }
        const messageId = item.messageId != null ? String(item.messageId) : ''
        if (messageId === '' || messageId === '0') {
          continue
        }
        const status: any = item.status
        if (status === 'read' || status === 4) {
          continue
        }
        unreadMessageIds.push(messageId)
      }
      return unreadMessageIds
    } catch (e) {
      console.error('[ReadReceiptService] 获取未读消息列表失败:', e)
      return []
    }
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    this.readStatus.clear()
  }
  
  /**
   * 清空指定消息的已读状态
   */
  public clearMessageReadStatus(messageId: string): void {
    this.readStatus.delete(messageId)
  }
}

/**
 * 导出单例实例
 */
export const readReceiptService = ReadReceiptService.getInstance()
