import { getHarmonyAESRuntimeSource, getHarmonyNativeAesPluginImplementationName, isHarmonyAESRuntimeReady, isHarmonyNativeAesPluginReady } from '../components/captcha/utils/harmony-aes-provider.uts'
import { ClientPlatformCode, getClientPlatformInfo } from '../utils/device.uts'
import { canSaveImageToAlbum, canSaveVideoToAlbum } from '../utils/album.uts'
import { canCreateInnerAudioContext, canUseRecorderManager } from '../utils/audio-capability.uts'
import { readAlbumAuthorized, readCameraAuthorized, readLocationAccuracy as readLocationAccuracyStatus, readLocationAuthorized as readLocationAuthorizedStatus, readMicrophoneAuthorized } from '../utils/app-authorize.uts'
import { canOpenExternalUrl } from '../utils/external-url.uts'
import { canOpenDocument } from '../utils/file.uts'
import { canOpenSystemLocation } from '../utils/location.uts'
import { canPreviewImage } from '../utils/media-preview.uts'
import { canUseSystemScanner } from '../utils/scan-capability.uts'
import { canUseSystemShare } from '../utils/system-share.uts'
// #ifdef APP-HARMONY
import { harmonyCameraBridgeApi } from '../uni_modules/uni-im-harmony-camera-bridge/utssdk/app-harmony/index.uts'
import { harmonyLocationBridgeApi } from '../uni_modules/uni-im-harmony-location-bridge/utssdk/app-harmony/index.uts'
import { harmonyMicrophoneBridgeApi } from '../uni_modules/uni-im-harmony-microphone-bridge/utssdk/app-harmony/index.uts'
// #endif

export type HarmonyReadinessSnapshot = {
	isHarmony: boolean
	platformCode: string
	osVersion: string
	harmonyApiVersion: number | null
	deviceBrand: string
	deviceModel: string
	aesRuntimeReady: boolean
	aesRuntimeSource: string
	nativeAesPluginReady: boolean
	nativeAesPluginImplementation: string
	sliderCaptchaReady: boolean
	cameraPermissionBridgeReady: boolean
	microphonePermissionBridgeReady: boolean
	cameraAuthorized: string
	microphoneAuthorized: string
	voiceRecordReady: boolean
	voicePlaybackReady: boolean
	systemScanReady: boolean
	systemShareReady: boolean
	imagePreviewReady: boolean
	documentOpenReady: boolean
	saveImageToAlbumReady: boolean
	saveVideoToAlbumReady: boolean
	albumAuthorized: string
	locationPermissionBridgeReady: boolean
	inAppLocationViewerReady: boolean
	openLocationReady: boolean
	locationEnabled: boolean | null
	locationAuthorized: string
	locationAccuracy: string
	upgradeEntryMode: string
	upgradeEntryReady: boolean
}

export enum HarmonyUpgradeEntryMode {
	APP_GALLERY = 'APP_GALLERY',
	UNKNOWN = 'UNKNOWN'
}

export function getHarmonyReadinessSnapshot(): HarmonyReadinessSnapshot {
	const platformInfo = getClientPlatformInfo()
	const isHarmony = platformInfo.platformCode === ClientPlatformCode.HARMONY
	const systemShareReady = isHarmony && canUseSystemShare()
	const systemScanReady = isHarmony && canUseSystemScanner()
	const imagePreviewReady = isHarmony && canPreviewImage()
	const documentOpenReady = isHarmony && canOpenDocument()
	const aesRuntimeReady = isHarmony && isHarmonyAESRuntimeReady()
	const aesRuntimeSource = isHarmony ? getHarmonyAESRuntimeSource() : ''
	const nativeAesPluginReady = isHarmony && isHarmonyNativeAesPluginReady()
	const nativeAesPluginImplementation = isHarmony ? getHarmonyNativeAesPluginImplementationName() : ''
	const saveImageToAlbumReady = isHarmony && canSaveImageToAlbum()
	const saveVideoToAlbumReady = isHarmony && canSaveVideoToAlbum()
	const cameraPermissionBridgeReady = isHarmony && isHarmonyCameraPermissionBridgeReady()
	const microphonePermissionBridgeReady = isHarmony && isHarmonyMicrophonePermissionBridgeReady()
	const cameraAuthorized = readAuthorizeState(isHarmony, readCameraAuthorized)
	const microphoneAuthorized = readAuthorizeState(isHarmony, readMicrophoneAuthorized)
	const voiceRecordReady = isHarmony && canUseRecorderManager()
	const voicePlaybackReady = isHarmony && canCreateInnerAudioContext()
	const albumAuthorized = readAuthorizeState(isHarmony, readAlbumAuthorized)
	const locationPermissionBridgeReady = isHarmony && isHarmonyLocationPermissionBridgeReady()
	const inAppLocationViewerReady = isHarmony
	const openLocationReady = isHarmony && (canOpenSystemLocation() || inAppLocationViewerReady)
	const locationEnabled = readLocationEnabled(isHarmony)
	const locationAuthorized = readLocationAuthorized(isHarmony)
	const locationAccuracy = readLocationAccuracy(isHarmony)
	return {
		isHarmony: isHarmony,
		platformCode: platformInfo.platformCode,
		osVersion: platformInfo.harmonyDisplayVersion !== '' ? platformInfo.harmonyDisplayVersion : platformInfo.osVersion,
		harmonyApiVersion: platformInfo.harmonyApiVersion,
		deviceBrand: platformInfo.deviceBrand,
		deviceModel: platformInfo.deviceModel,
		aesRuntimeReady: aesRuntimeReady,
		aesRuntimeSource: aesRuntimeSource,
		nativeAesPluginReady: nativeAesPluginReady,
		nativeAesPluginImplementation: nativeAesPluginImplementation,
		sliderCaptchaReady: aesRuntimeReady,
		cameraPermissionBridgeReady: cameraPermissionBridgeReady,
		microphonePermissionBridgeReady: microphonePermissionBridgeReady,
		cameraAuthorized: cameraAuthorized,
		microphoneAuthorized: microphoneAuthorized,
		voiceRecordReady: voiceRecordReady,
		voicePlaybackReady: voicePlaybackReady,
		systemScanReady: systemScanReady,
		systemShareReady: systemShareReady,
		imagePreviewReady: imagePreviewReady,
		documentOpenReady: documentOpenReady,
		saveImageToAlbumReady: saveImageToAlbumReady,
		saveVideoToAlbumReady: saveVideoToAlbumReady,
		albumAuthorized: albumAuthorized,
		locationPermissionBridgeReady: locationPermissionBridgeReady,
		inAppLocationViewerReady: inAppLocationViewerReady,
		openLocationReady: openLocationReady,
		locationEnabled: locationEnabled,
		locationAuthorized: locationAuthorized,
		locationAccuracy: locationAccuracy,
		upgradeEntryMode: isHarmony ? HarmonyUpgradeEntryMode.APP_GALLERY : HarmonyUpgradeEntryMode.UNKNOWN,
		upgradeEntryReady: isHarmony ? canOpenExternalUrl() : true
	}
}

function readLocationEnabled(isHarmony: boolean): boolean | null {
	if (!isHarmony) {
		return null
	}
	try {
		const anyUni = uni as any
		if (anyUni == null || typeof anyUni.getSystemSetting !== 'function') {
			return null
		}
		const result = anyUni.getSystemSetting()
		if (result != null && typeof result.locationEnabled === 'boolean') {
			return result.locationEnabled as boolean
		}
	} catch (e) {
		console.warn('[HarmonyOS] 读取系统定位开关失败:', e)
	}
	return null
}

function readLocationAuthorized(isHarmony: boolean): string {
	return readAuthorizeState(isHarmony, readLocationAuthorizedStatus)
}

function readLocationAccuracy(isHarmony: boolean): string {
	return readAuthorizeState(isHarmony, readLocationAccuracyStatus)
}

function readAuthorizeState(isHarmony: boolean, reader: () => string): string {
	if (!isHarmony) {
		return ''
	}
	try {
		return reader()
	} catch (e) {
		return 'unknown'
	}
}

export function canUseHarmonySliderCaptcha(): boolean {
	const snapshot = getHarmonyReadinessSnapshot()
	return !snapshot.isHarmony || snapshot.sliderCaptchaReady
}

export function logHarmonyReadiness(context: string = 'runtime'): void {
	const snapshot = getHarmonyReadinessSnapshot()
	if (!snapshot.isHarmony) {
		return
	}
	console.log(`[HarmonyOS] readiness(${context}):`, snapshot)
	if (!snapshot.aesRuntimeReady) {
		console.warn('[HarmonyOS] AES runtime 未注入，滑块验证码将被阻断')
	}
	if (snapshot.nativeAesPluginReady) {
		console.log('[HarmonyOS] native AES plugin ready, runtime source:', snapshot.aesRuntimeSource)
	}
	if (!snapshot.systemShareReady) {
		console.warn('[HarmonyOS] shareWithSystem 不可用，二维码分享将退回链接复制兜底')
	}
	if (!snapshot.imagePreviewReady) {
		console.warn('[HarmonyOS] previewImage 能力未检测到，图片预览将受限')
	}
	if (!snapshot.documentOpenReady) {
		console.warn('[HarmonyOS] openDocument 能力未检测到，文件下载后打开将受限')
	}
	if (!snapshot.systemScanReady) {
		console.warn('[HarmonyOS] scanCode 能力未检测到，扫码页将无法拉起系统扫码')
	}
	if (!snapshot.cameraPermissionBridgeReady) {
		console.warn('[HarmonyOS] 摄像头权限桥接插件未就绪，需确认 Harmony 权限声明是否已编入产物')
	}
	if (!snapshot.microphonePermissionBridgeReady) {
		console.warn('[HarmonyOS] 麦克风权限桥接插件未就绪，需确认 Harmony 权限声明是否已编入产物')
	}
	if (snapshot.cameraAuthorized !== '' && snapshot.cameraAuthorized !== 'authorized') {
		console.warn('[HarmonyOS] App 摄像头权限未就绪:', snapshot.cameraAuthorized)
	}
	if (snapshot.microphoneAuthorized !== '' && snapshot.microphoneAuthorized !== 'authorized') {
		console.warn('[HarmonyOS] App 麦克风权限未就绪:', snapshot.microphoneAuthorized)
	}
	if (!snapshot.voiceRecordReady) {
		console.warn('[HarmonyOS] getRecorderManager 能力未检测到，语音录制将不可用')
	}
	if (!snapshot.voicePlaybackReady) {
		console.warn('[HarmonyOS] createInnerAudioContext 能力未检测到，语音播放将不可用')
	}
	if (!snapshot.openLocationReady) {
		console.warn('[HarmonyOS] openLocation 能力未检测到，位置卡片查看仍需补齐 uni-openlocation 或官方等效能力')
	}
	if (!snapshot.locationPermissionBridgeReady) {
		console.warn('[HarmonyOS] 位置权限桥接插件未就绪，需确认 Harmony 权限声明是否已编入产物')
	}
	if (snapshot.locationEnabled === false) {
		console.warn('[HarmonyOS] 系统定位开关未开启，定位相关能力将受限')
	}
	if (snapshot.locationAuthorized !== '' && snapshot.locationAuthorized !== 'authorized') {
		console.warn('[HarmonyOS] App 定位权限未就绪:', snapshot.locationAuthorized)
	}
	if (!snapshot.saveVideoToAlbumReady) {
		console.warn('[HarmonyOS] saveVideoToPhotosAlbum 能力未检测到，视频保存需以运行时能力为准')
	}
	if (snapshot.albumAuthorized !== '' && snapshot.albumAuthorized !== 'authorized') {
		console.warn('[HarmonyOS] App 相册权限未就绪:', snapshot.albumAuthorized)
	}
	if (!snapshot.upgradeEntryReady) {
		console.warn('[HarmonyOS] 升级入口能力尚未完成官方口径验证')
	}
}

function isHarmonyLocationPermissionBridgeReady(): boolean {
	// #ifdef APP-HARMONY
	try {
		return harmonyLocationBridgeApi != null && harmonyLocationBridgeApi.ensureLoaded()
	} catch (e) {
		return false
	}
	// #endif
	return false
}

function isHarmonyCameraPermissionBridgeReady(): boolean {
	// #ifdef APP-HARMONY
	try {
		return harmonyCameraBridgeApi != null && harmonyCameraBridgeApi.ensureLoaded()
	} catch (e) {
		return false
	}
	// #endif
	return false
}

function isHarmonyMicrophonePermissionBridgeReady(): boolean {
	// #ifdef APP-HARMONY
	try {
		return harmonyMicrophoneBridgeApi != null && harmonyMicrophoneBridgeApi.ensureLoaded()
	} catch (e) {
		return false
	}
	// #endif
	return false
}
