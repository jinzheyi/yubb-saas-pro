/**
 * 消息服务
 * 
 * 功能:
 * 1. 消息发送（文本、图片、语音、视频、文件、位置）
 * 2. 消息接收处理
 * 3. 消息状态管理（发送中、已发送、已读、失败）
 * 4. 会话列表更新
 * 5. 未读消息数管理
 */

import { wsManager, MessageType, WebSocketState } from '../utils/websocket.uts'
import { MessageBuilder, MessageParser, ImMessage } from '../utils/message-handler.uts'
import { getAvatarText, getUserAvatarColor } from '@/utils/avatar.uts'
import { getUserInfo } from '@/store/user.uts'
import { getUserDetail } from '@/api/user.uts'
import { pullMessages as pullMessagesApi } from '@/api/message.uts'
import { badgeService, BadgeUpdateMessage } from './badge-service.uts'
import { conversationService } from './conversation-service.uts'

/**
 * 消息状态枚举
 */
export enum MessageStatus {
  SENDING = 0,    // 发送中
  SENT = 1,       // 已发送
  READ = 2,       // 已读
  FAILED = 3      // 发送失败
}

/**
 * 队列中的消息
 */
export type QueuedMessage = {
  message: any
  retryCount: number
  timestamp: number
}

/**
 * 消息状态监听器类型
 */
export type MessageStatusListener = (messageId: string, status: MessageStatus) => void

/**
 * 消息项（用于 UI 显示）
 */
export type MessageItem = {
  id: string
  messageId: string
  sequence?: string
  senderId: string
  receiverId: string
  groupId: string
  type: MessageType
  content: any
  status: MessageStatus
  timestamp: number
  isSelf: boolean
  showTime: boolean
  avatarText: string
  avatarBg: string
  senderName: string
}

/**
 * 会话项（用于 UI 显示）
 * 字段名与后端 AppImConversationRespVO 保持一致
 */
export type ConversationItem = {
  chatId: string           // 对应后端 chatId
  conversationType: number  // 1-单聊 2-群聊，对应后端 conversationType
  targetId: string         // 对应后端 targetId
  targetName: string       // 对应后端 targetName
  targetAvatar: string     // 对应后端 targetAvatar
  avatarText: string
  avatarBg: string
  lastMessageType: number     // 对应后端 lastMessageType
  lastMessageContent: string  // 对应后端 lastMessageContent
  lastMessageTime: string     // 对应后端 lastMessageTime（格式化后）
  timestamp: number        // 对应后端 lastMessageTime（原始时间戳）
  unreadCount: number       // 对应后端 unreadCount
  lastMessageSequence: string // 对应后端 lastMessageSequence（服务端权威水位）
  lastReadSequence: string    // 对应后端 lastReadSequence（服务端权威水位）
  isPinned: boolean        // 对应后端 isPinned
  noDisturb: boolean       // 对应后端 noDisturb
  groupMemberCount: number // 对应后端 groupMemberCount
}

/**
 * 消息监听器类型
 */
export type MessageListener = (message: MessageItem) => void

/**
 * 会话更新监听器类型
 */
export type ConversationUpdateListener = (conversation: ConversationItem) => void

/**
 * 消息服务类（单例模式）
 */
export class MessageService {
  
  private static instance: MessageService | null = null
  
  // 消息监听器列表
  private messageListeners: MessageListener[] = []
  
  // 消息状态监听器列表
  private messageStatusListeners: MessageStatusListener[] = []
  
  
  // 当前用户信息
  private currentUserId: string = '0'
  private currentTenantId: string = '0'

  // 用户信息缓存（用于补齐实时消息的 senderName/avatarText）
  private userNicknameCache: Map<string, string> = new Map()
  private userNicknameLoading: Map<string, Promise<string>> = new Map()
  
  // 消息缓存（按会话ID分组）
  private messageCache: Map<string, MessageItem[]> = new Map()

  // 每个会话最后拉取/确认的序列号（用于断线补偿水位）
  private lastPulledSequence: Map<string, string> = new Map()
  
  // 消息队列（用于离线消息重发）
  private messageQueue: QueuedMessage[] = []
  
  // 最大重试次数
  private static readonly MAX_RETRY_COUNT = 3
  
  // 是否正在处理队列
  private isProcessingQueue: boolean = false
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    this.initWebSocketListeners()
    this.initWebSocketStateListener()
  }

  private initWebSocketStateListener(): void {
    // 认证成功后 websocket.uts 不会向业务层分发 AUTH_RESP，这里通过状态监听 + isConnected() 轮询兜底
    wsManager.addStateListener((state) => {
      if (state !== WebSocketState.OPEN) {
        return
      }
      // 延迟一点，等认证流程完成
      setTimeout(() => {
        void this.tryPullAfterConnected()
      }, 300)
    })
  }

  private async tryPullAfterConnected(): Promise<void> {
    if (!wsManager.isConnected()) {
      // 最多等待 3 秒（每 200ms 检查一次）
      for (let i = 0; i < 15; i++) {
        await new Promise<void>((resolve) => setTimeout(() => resolve(), 200))
        if (wsManager.isConnected()) {
          break
        }
      }
    }
    if (!wsManager.isConnected()) {
      return
    }
    await this.pullMissingMessagesForLoadedConversations()
  }

  /**
   * 连接恢复后，对已加载的会话执行断线补偿拉取
   */
  private async pullMissingMessagesForLoadedConversations(): Promise<void> {
    try {
      // 如果会话未加载，这里主动加载一次
      const conversations = conversationService.getConversations()
      if (conversations == null || conversations.length === 0) {
        await conversationService.loadConversations()
      }
      const list = conversationService.getConversations()
      if (list == null || list.length === 0) {
        return
      }

      for (let i = 0; i < list.length; i++) {
        const c = list[i]
        const chatId = c.chatId != null ? (c.chatId as any).toString() : '0'
        await this.pullMissingMessagesForChat(chatId)
      }
    } catch (e) {
      console.warn('[MessageService] pullMissingMessagesForLoadedConversations failed:', e)
    }
  }

  private async pullMissingMessagesForChat(chatId: string): Promise<void> {
    try {
      const lastSeq = this.getLastPulledSequence(chatId)
      const resp = await pullMessagesApi(chatId, lastSeq, 200)
      const arr = resp as any[]
      if (arr == null || arr.length === 0) {
        return
      }

      for (let i = 0; i < arr.length; i++) {
        const m: any = arr[i]
        const senderIdStr = m.senderId != null ? m.senderId.toString() : '0'
        const isSelf = senderIdStr === this.currentUserId
        const senderName = (m.senderNickname != null && m.senderNickname !== '')
          ? m.senderNickname
          : (isSelf ? (getUserInfo()?.user?.nickname || '') : await this.resolveUserNickname(senderIdStr))

        const messageItem: MessageItem = {
          id: '0',
          messageId: m.id != null ? m.id.toString() : '0',
          sequence: m.sequence != null ? m.sequence.toString() : undefined,
          senderId: senderIdStr,
          receiverId: m.receiverId != null ? m.receiverId.toString() : '0',
          groupId: m.groupId != null ? m.groupId.toString() : '0',
          type: m.messageType,
          content: { content: m.content, extra: m.extra },
          status: MessageStatus.SENT,
          timestamp: m.sendTime != null ? new Date(m.sendTime as string).getTime() : Date.now(),
          isSelf: isSelf,
          showTime: true,
          avatarText: senderName ? getAvatarText(senderName) : '?',
          avatarBg: getUserAvatarColor(senderIdStr),
          senderName: senderName
        }

        this.addMessageToCache(chatId, messageItem)
        if (messageItem.sequence != null) {
          this.updateLastPulledSequence(chatId, messageItem.sequence)
        }
      }
    } catch (e) {
      console.warn('[MessageService] pullMissingMessagesForChat failed:', { chatId: chatId, e: e })
    }
  }

  private async resolveUserNickname(userId: string): Promise<string> {
    if (userId === '0' || userId === '') {
      return ''
    }

    if (userId === this.currentUserId) {
      const userInfo = getUserInfo()
      return userInfo?.user?.nickname || ''
    }

    const cached = this.userNicknameCache.get(userId)
    if (cached !== null && cached !== undefined) {
      return cached
    }

    const loading = this.userNicknameLoading.get(userId)
    if (loading !== null && loading !== undefined) {
      return await loading
    }

    const task = (async (): Promise<string> => {
      try {
        const resp = await getUserDetail(userId)
        const userObj: any = (resp && typeof resp === 'object' && 'data' in resp)
          ? resp.data
          : resp

        const nickname = userObj ? (userObj.nickname || userObj.name || '') : ''
        if (nickname) {
          this.userNicknameCache.set(userId, nickname)
        }
        return nickname
      } catch (e) {
        console.warn('[MessageService] resolveUserNickname failed:', userId, e)
        return ''
      } finally {
        this.userNicknameLoading.delete(userId)
      }
    })()

    this.userNicknameLoading.set(userId, task)
    return await task
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): MessageService {
    if (MessageService.instance === null) {
      MessageService.instance = new MessageService()
    }
    return MessageService.instance
  }
  
  /**
   * 初始化 WebSocket 监听器
   */
  private initWebSocketListeners(): void {
    // 监听文本消息
    wsManager.addMessageListener(MessageType.TEXT, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听图片消息
    wsManager.addMessageListener(MessageType.IMAGE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听语音消息
    wsManager.addMessageListener(MessageType.VOICE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听视频消息
    wsManager.addMessageListener(MessageType.VIDEO, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听文件消息
    wsManager.addMessageListener(MessageType.FILE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听位置消息
    wsManager.addMessageListener(MessageType.LOCATION, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听已读回执
    wsManager.addMessageListener(MessageType.READ_RECEIPT, (message) => {
      this.handleReadReceipt(message)
    })
    
    // 监听消息撤回
    wsManager.addMessageListener(MessageType.RECALL, (message) => {
      this.handleRecall(message)
    })
  }
  
  /**
   * 设置当前用户信息
   */
  public setCurrentUser(userId: string, tenantId: string): void {
    this.currentUserId = userId
    this.currentTenantId = tenantId
  }
  
  /**
   * 发送文本消息
   */
  public sendTextMessage(
    receiverId: string,
    groupId: string,
    content: string,
    atUserIds: string[] = []
  ): MessageItem {
    const message = MessageBuilder.buildTextMessage(
      this.currentUserId,
      receiverId,
      groupId,
      this.currentTenantId,
      content,
      atUserIds
    )
    
    return this.sendMessage(message)
  }

