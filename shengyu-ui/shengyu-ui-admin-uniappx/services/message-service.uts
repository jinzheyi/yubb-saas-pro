/**
 * 消息服务
 * 
 * 功能:
 * 1. 消息发送（文本、图片、语音、视频、文件、位置）
 * 2. 消息接收处理
 * 3. 消息状态管理（发送中、已发送、已读、失败）
 * 4. 会话列表更新
 * 5. 未读消息数管理
 */

import { wsManager, MessageType, WebSocketState } from '../utils/websocket.uts'
import { MessageBuilder, MessageParser, ImMessage } from '../utils/message-handler.uts'
import { getAvatarText, getUserAvatarColor } from '@/utils/avatar.uts'
import { getUserInfo } from '@/store/user.uts'
import { getUserDetail } from '@/api/user.uts'
import { pullMessages as pullMessagesApi } from '@/api/message.uts'
import { badgeService, BadgeUpdateMessage } from './badge-service.uts'
import { conversationService } from './conversation-service.uts'

/**
 * 消息状态枚举
 */
export enum MessageStatus {
  SENDING = 0,    // 发送中
  SENT = 1,       // 已发送
  READ = 2,       // 已读
  FAILED = 5,     // 发送失败
  RECALLED = 6    // 已撤回（最终态，禁止被旧内容覆盖）
}

/**
 * 队列中的消息
 */
export type QueuedMessage = {
  message: any
  retryCount: number
  timestamp: number
}

/**
 * 消息状态监听器类型
 */
export type MessageStatusListener = (messageId: string, status: MessageStatus) => void

/**
 * 消息项（用于 UI 显示）
 */
export type MessageItem = {
  id: string
  messageId: string
  sequence?: string
  rev?: string
  // enterprise: re-edit-after-recall metadata (sender devices only)
  reeditContent?: string
  reeditDeadlineTs?: string
  senderId: string
  receiverId: string
  groupId?: string
  type: MessageType
  content: any
  status: MessageStatus
  timestamp: number
  isSelf: boolean
  showTime: boolean
  avatarText: string
  avatarBg: string
  senderName: string
}

/**
 * 会话项（用于 UI 显示）
 * 字段名与后端 AppImConversationRespVO 保持一致
 */
export type ConversationItem = {
  chatId: string           // 对应后端 chatId
  conversationType: number  // 1-单聊 2-群聊，对应后端 conversationType
  targetId: string         // 对应后端 targetId
  targetName: string       // 对应后端 targetName
  targetAvatar: string     // 对应后端 targetAvatar
  avatarText: string
  avatarBg: string
  lastMessageType: number     // 对应后端 lastMessageType
  lastMessageContent: string  // 对应后端 lastMessageContent
  lastMessageTime: string     // 对应后端 lastMessageTime（格式化后）
  timestamp: number        // 对应后端 lastMessageTime（原始时间戳）
  unreadCount: number       // 对应后端 unreadCount
  lastMessageSequence: string // 对应后端 lastMessageSequence（服务端权威水位）
  lastReadSequence: string    // 对应后端 lastReadSequence（服务端权威水位）
  isPinned: boolean        // 对应后端 isPinned
  noDisturb: boolean       // 对应后端 noDisturb
  groupMemberCount: number // 对应后端 groupMemberCount
}

/**
 * 消息监听器类型
 */
export type MessageListener = (message: MessageItem) => void

/**
 * 会话更新监听器类型
 */
export type ConversationUpdateListener = (conversation: ConversationItem) => void

/**
 * 消息服务类（单例模式）
 */
export class MessageService {
  
  private static instance: MessageService | null = null
  
  // 消息监听器列表
  private messageListeners: MessageListener[] = []
  
  // 消息状态监听器列表
  private messageStatusListeners: MessageStatusListener[] = []
  
  
  // 当前用户信息
  private currentUserId: string = '0'
  private currentTenantId: string = '0'

	private getReeditHintStorageKey(chatId: string, messageId: string): string {
		const tenantId = this.currentTenantId != null ? this.currentTenantId : '0'
		const userId = this.currentUserId != null ? this.currentUserId : '0'
		return `im_reedit_hint_${tenantId}_${userId}_${chatId}_${messageId}`
	}

	public getReeditHint(chatId: string, messageId: string): { content: string, deadlineTs: string } | null {
		return this.loadReeditHint(chatId, messageId)
	}

	private persistReeditHint(chatId: string, messageId: string, content: string, deadlineTs: string): void {
		try {
			if (!chatId || !messageId || !content) {
				return
			}
			const payload: any = { c: content }
			if (deadlineTs != null && deadlineTs !== '') {
				payload.d = deadlineTs
			}
			uni.setStorageSync(this.getReeditHintStorageKey(chatId, messageId), JSON.stringify(payload))
		} catch (e) {
			// ignore
		}
	}

	private loadReeditHint(chatId: string, messageId: string): { content: string, deadlineTs: string } | null {
		try {
			if (!chatId || !messageId) {
				return null
			}
			const raw: any = uni.getStorageSync(this.getReeditHintStorageKey(chatId, messageId))
			if (raw == null || raw === '') {
				return null
			}
			const obj: any = typeof raw === 'string' ? JSON.parse(raw) : raw
			const c = obj != null && obj.c != null ? obj.c.toString() : ''
			const d = obj != null && obj.d != null ? obj.d.toString() : ''
			if (!c) {
				return null
			}
			return { content: c, deadlineTs: d }
		} catch (e) {
			return null
		}
	}

  // 用户信息缓存（用于补齐实时消息的 senderName/avatarText）
  private userNicknameCache: Map<string, string> = new Map()
  private userNicknameLoading: Map<string, Promise<string>> = new Map()
  
  // 消息缓存（按会话ID分组）
  private messageCache: Map<string, MessageItem[]> = new Map()

  // 每个会话最后拉取/确认的序列号（用于断线补偿水位）
  private lastPulledSequence: Map<string, string> = new Map()

  private activeChatId: string = ''

  private activeChatAutoReadEnabled: boolean = true

  private lastReconnectPullAt: number = 0

  private debugStats: {
    reconnectAttempt: number
    reconnectSkippedByThrottle: number
    reconnectSyncMs: number
    reconnectPullMs: number
    pullCallCount: number
    pullFetchedCount: number
    pullRoundCount: number
    pullNoProgressStopCount: number
    wsGapDetectedCount: number
    wsGapTriggeredPullCount: number
    dedupMergeHitCount: number
  } = {
    reconnectAttempt: 0,
    reconnectSkippedByThrottle: 0,
    reconnectSyncMs: 0,
    reconnectPullMs: 0,
    pullCallCount: 0,
    pullFetchedCount: 0,
    pullRoundCount: 0,
    pullNoProgressStopCount: 0,
    wsGapDetectedCount: 0,
    wsGapTriggeredPullCount: 0,
    dedupMergeHitCount: 0
  }

  public removeMessageFromCache(chatId: string, messageId: string): void {
    const cid = chatId != null ? chatId.toString() : ''
    const mid = messageId != null ? messageId.toString() : ''
    if (cid === '' || cid === '0' || mid === '' || mid === '0') {
      return
    }
    try {
      const messages = this.messageCache.get(cid)
      if (messages == null || messages.length === 0) {
        return
      }
      const idx = messages.findIndex((m: any) => m != null && m.messageId === mid)
      if (idx < 0) {
        return
      }
      messages.splice(idx, 1)
      this.messageCache.set(cid, messages)
    } catch (e) {
      // ignore
    }
  }

	private normalizeOutboundMessageId(message: ImMessage): string {
		try {
			const raw = message != null && message.header != null && message.header.messageId != null
				? message.header.messageId.toString()
				: ''
			let ok = false
			if (raw !== '' && raw !== '0') {
				const re = /^\d+$/
				if (re.test(raw)) {
					try {
						const v = BigInt(raw)
						const max = BigInt('9223372036854775807')
						ok = v > BigInt(0) && v <= max
					} catch (e) {
						ok = false
					}
				}
			}
			if (ok) {
				return raw
			}
			const regenerated = MessageBuilder.generateMessageId()
			try {
				if (message != null && message.header != null) {
					message.header.messageId = regenerated
				}
			} catch (e) {
				// ignore
			}
			return regenerated
		} catch (e) {
			const regenerated = MessageBuilder.generateMessageId()
			try {
				if (message != null && message.header != null) {
					message.header.messageId = regenerated
				}
			} catch (e2) {
				// ignore
			}
			return regenerated
		}
	}

	private normalizeInboundMessageId(rawId: any): string {
		try {
			const raw = rawId != null ? rawId.toString() : ''
			if (raw === '' || raw === '0') {
				return ''
			}
			const re = /^\d+$/
			if (!re.test(raw)) {
				return ''
			}
			return raw
		} catch (e) {
			return ''
		}
	}
  
  // 消息队列（用于离线消息重发）
  private messageQueue: QueuedMessage[] = []
  
  // 最大重试次数
  private static readonly MAX_RETRY_COUNT = 3

  private sendRetryEnabled: boolean = false

  private pendingRetryMap: Map<string, { message: any, retryCount: number, timer: any }> = new Map()

  private static readonly SEND_RETRY_BASE_DELAY_MS = 2000
  
  // 是否正在处理队列
  private isProcessingQueue: boolean = false
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    this.initWebSocketListeners()
    this.initWebSocketStateListener()
  }

  private initWebSocketStateListener(): void {
    // 认证成功后 websocket.uts 不会向业务层分发 AUTH_RESP，这里通过状态监听 + isConnected() 轮询兜底
    wsManager.addStateListener((state) => {
      if (state !== WebSocketState.OPEN) {
        return
      }
      // 延迟一点，等认证流程完成
      setTimeout(() => {
        void this.tryPullAfterConnected()
      }, 300)
    })
  }

  public getDebugStats(): any {
    return { ...this.debugStats }
  }

  public resetDebugStats(): void {
    this.debugStats = {
      reconnectAttempt: 0,
      reconnectSkippedByThrottle: 0,
      reconnectSyncMs: 0,
      reconnectPullMs: 0,
      pullCallCount: 0,
      pullFetchedCount: 0,
      pullRoundCount: 0,
      pullNoProgressStopCount: 0,
      wsGapDetectedCount: 0,
      wsGapTriggeredPullCount: 0,
      dedupMergeHitCount: 0
    }
  }

  /**
   * 初始化/修正会话的本地拉取水位
   * 场景：聊天页通过 HTTP 加载了最新历史消息，但 MessageService 还未收到 WS 推送，避免后续 gap 检测/重连补偿从 0 拉爆。
   */
  public seedLastPulledSequence(chatId: string, seq: string): void {
    try {
      const id = chatId != null ? chatId.toString() : ''
      const s = seq != null ? seq.toString() : ''
      if (id === '' || id === '0' || s === '' || s === '0') {
        return
      }
      this.updateLastPulledSequence(id, s)
    } catch (e) {
      // ignore
    }
  }

  private async tryPullAfterConnected(): Promise<void> {
    if (!wsManager.isConnected()) {
      // 最多等待 3 秒（每 200ms 检查一次）
      for (let i = 0; i < 15; i++) {
        await new Promise<void>((resolve) => setTimeout(() => resolve(), 200))
        if (wsManager.isConnected()) {
          break
        }
      }
    }
    if (!wsManager.isConnected()) {
      return
    }

    const now = Date.now()
    if (now - this.lastReconnectPullAt < 1000) {
      this.debugStats.reconnectSkippedByThrottle += 1
      return
    }
    this.lastReconnectPullAt = now

    this.debugStats.reconnectAttempt += 1

    // 重连一致性：先对齐会话水位（cursorVersion 增量 sync），再按会话 lastMessageSequence 拉取缺失消息
    const syncStart = Date.now()
    try {
      await conversationService.syncConversationsIncrementally(false)
    } catch (e) {
      console.error('[MessageService][Reconnect] sync failed:', e)
    }
    this.debugStats.reconnectSyncMs = Date.now() - syncStart

    const pullStart = Date.now()
    await this.pullMissingMessagesForLoadedConversations()
    this.debugStats.reconnectPullMs = Date.now() - pullStart
  }

  /**
   * 连接恢复后，对已加载的会话执行断线补偿拉取
   */
  private async pullMissingMessagesForLoadedConversations(): Promise<void> {
    try {
      // 如果会话未加载，这里主动加载一次（load 内部会走 sync 增量兜底）
      const conversations = conversationService.getConversations()
      if (conversations == null || conversations.length === 0) {
        await conversationService.loadConversations()
      }
      const list = conversationService.getConversations()
      if (list == null || list.length === 0) {
        return
      }

      const candidates: any[] = []
      const active = this.getActiveChatId()
      for (let i = 0; i < list.length; i++) {
        const c = list[i] as any
        const chatId = c != null && c.chatId != null ? c.chatId.toString() : '0'
        const unread = c != null && c.unreadCount != null ? Number(c.unreadCount) : 0
        if ((active != null && active !== '' && chatId === active) || unread > 0) {
          candidates.push(c)
        }
      }
      // active chat 优先
      candidates.sort((a, b) => {
        const ac = active != null && active !== ''
        const aIsActive = ac && (a != null && a.chatId != null && a.chatId.toString() === active)
        const bIsActive = ac && (b != null && b.chatId != null && b.chatId.toString() === active)
        if (aIsActive && !bIsActive) return -1
        if (!aIsActive && bIsActive) return 1
        return 0
      })

      for (let i = 0; i < candidates.length; i++) {
        const c = candidates[i]
        const chatId = c.chatId != null ? (c.chatId as any).toString() : '0'
        const targetSeq = (c as any).lastMessageSequence != null ? (c as any).lastMessageSequence.toString() : '0'
        await this.pullMissingMessagesForChatToSequence(chatId, targetSeq)
      }
    } catch (e) {
      console.error('[MessageService] pullMissingMessagesForLoadedConversations failed:', e)
    }
  }

  public setActiveChatId(chatId: string | null): void {
    const v = chatId != null ? chatId.toString() : ''
    this.activeChatId = v
  }

  public setActiveChatAutoReadEnabled(enabled: boolean): void {
    this.activeChatAutoReadEnabled = enabled
  }

  public getActiveChatId(): string {
    return this.activeChatId
  }

  public async ingestRestHistoryPage(chatId: string, serverMessages: any[]): Promise<void> {
    const cid = chatId != null ? chatId.toString() : ''
    if (cid === '' || cid === '0') {
      return
    }
    if (serverMessages == null || !Array.isArray(serverMessages) || serverMessages.length === 0) {
      return
    }
    try {
      for (let i = 0; i < serverMessages.length; i++) {
        const m: any = serverMessages[i]
        if (m == null) {
          continue
        }
        const senderIdStr = m.senderId != null ? m.senderId.toString() : '0'
        const isSelf = senderIdStr === this.currentUserId
        const senderName = (m.senderNickname != null && m.senderNickname !== '')
          ? m.senderNickname
          : (isSelf ? (getUserInfo()?.user?.nickname || '') : await this.resolveUserNickname(senderIdStr))

        const messageIdStr = m.id != null ? m.id.toString() : '0'
        if (messageIdStr === '' || messageIdStr === '0') {
          continue
        }

        const seqStr = m.sequence != null ? m.sequence.toString() : undefined
        const revStr = (m as any).rev != null && (m as any).rev !== '' ? (m as any).rev.toString() : '1'
        const serverStatusRaw: any = (m as any).status
        const serverStatus = serverStatusRaw != null ? Number(serverStatusRaw) : null
        const isRecalled = serverStatus === 6

        const messageItem: MessageItem = {
          id: '0',
          messageId: messageIdStr,
          sequence: seqStr,
          rev: revStr,
          senderId: senderIdStr,
          receiverId: m.receiverId != null ? m.receiverId.toString() : '0',
          groupId: m.groupId != null ? m.groupId.toString() : '0',
          type: isRecalled ? MessageType.TEXT : m.messageType,
          content: isRecalled
            ? { content: (isSelf ? '你撤回了一条消息' : `${senderName} 撤回了一条消息`) }
            : { content: m.content, extra: m.extra },
          status: isRecalled ? MessageStatus.RECALLED : MessageStatus.SENT,
          timestamp: m.sendTime != null ? new Date(m.sendTime as string).getTime() : Date.now(),
          isSelf: isSelf,
          showTime: true,
          avatarText: senderName ? getAvatarText(senderName) : '?',
          avatarBg: getUserAvatarColor(senderIdStr),
          senderName: senderName
        }

        // enterprise: re-edit-after-recall rehydration for refresh/re-enter
        try {
          if (isRecalled && isSelf) {
            const hint = this.loadReeditHint(cid, messageIdStr)
            if (hint != null && hint.content !== '') {
              ;(messageItem as any).reeditContent = hint.content
              if (hint.deadlineTs !== '') {
                ;(messageItem as any).reeditDeadlineTs = hint.deadlineTs
              }
            }
          }
        } catch (e) {
        }

        this.addMessageToCache(cid, messageItem)
        if (seqStr != null) {
          this.updateLastPulledSequence(cid, seqStr)
        }
      }
    } catch (e) {
      console.error('[MessageService] ingestRestHistoryPage failed:', e)
    }
  }

  private compareSeq(a: string, b: string): number {
    const as = a != null && a !== '' ? a : '0'
    const bs = b != null && b !== '' ? b : '0'
    try {
      const diff = BigInt(as) - BigInt(bs)
      if (diff === BigInt(0)) {
        return 0
      }
      return diff > BigInt(0) ? 1 : -1
    } catch (e) {
      if (as === bs) {
        return 0
      }
      return as > bs ? 1 : -1
    }
  }

  private async pullMissingMessagesForChatToSequence(chatId: string, targetSequence: string): Promise<void> {
    const target = targetSequence != null && targetSequence !== '' ? targetSequence.toString() : '0'
    const current = this.getLastPulledSequence(chatId)
    if (this.compareSeq(current, target) >= 0) {
      return
    }
    await this.pullMissingMessagesForChat(chatId)
    const updated = this.getLastPulledSequence(chatId)
    if (this.compareSeq(updated, target) < 0) {
      // 仍未追平：再次拉取（后端 pull 受 limit 限制，这里再兜底一次）
      await this.pullMissingMessagesForChat(chatId)
    }
  }

  private async pullMissingMessagesForChat(chatId: string): Promise<void> {
    try {
      this.debugStats.pullCallCount += 1
      const pageSize = 200
      let cursor = this.getLastPulledSequence(chatId)

      const shouldNotify = this.activeChatId != null && this.activeChatId !== '' && this.activeChatId === chatId

      const startedAt = Date.now()
      let fetched = 0
      let rounds = 0

      // 循环拉取，直到无更多或水位不再推进（防御性）
      for (let round = 0; round < 10; round++) {
        rounds += 1
        this.debugStats.pullRoundCount += 1
        const resp = await pullMessagesApi(chatId, cursor, pageSize)
        const arr = resp as any[]
        if (arr == null || arr.length === 0) {
          return
        }

        let maxSeqInBatch = cursor
        for (let i = 0; i < arr.length; i++) {
          const m: any = arr[i]
          fetched += 1
          const senderIdStr = m.senderId != null ? m.senderId.toString() : '0'
          const isSelf = senderIdStr === this.currentUserId
          const senderName = (m.senderNickname != null && m.senderNickname !== '')
            ? m.senderNickname
            : (isSelf ? (getUserInfo()?.user?.nickname || '') : await this.resolveUserNickname(senderIdStr))

          const seqStr = m.sequence != null ? m.sequence.toString() : undefined
          const revStr = (m as any).rev != null && (m as any).rev !== '' ? (m as any).rev.toString() : '1'
          const serverStatusRaw: any = (m as any).status
          const serverStatus = serverStatusRaw != null ? Number(serverStatusRaw) : null

          const messageIdStr = m.id != null ? m.id.toString() : '0'
          const isRecalled = serverStatus === 6

          const messageItem: MessageItem = {
            id: '0',
            messageId: messageIdStr,
            sequence: seqStr,
            rev: revStr,
            senderId: senderIdStr,
            receiverId: m.receiverId != null ? m.receiverId.toString() : '0',
            groupId: m.groupId != null ? m.groupId.toString() : '0',
            type: isRecalled ? MessageType.TEXT : m.messageType,
            content: isRecalled
              ? { content: (isSelf ? '你撤回了一条消息' : `${senderName} 撤回了一条消息`) }
              : { content: m.content, extra: m.extra },
            status: isRecalled ? MessageStatus.RECALLED : MessageStatus.SENT,
            timestamp: m.sendTime != null ? new Date(m.sendTime as string).getTime() : Date.now(),
            isSelf: isSelf,
            showTime: true,
            avatarText: senderName ? getAvatarText(senderName) : '?',
            avatarBg: getUserAvatarColor(senderIdStr),
            senderName: senderName
          }
				// enterprise: re-edit-after-recall rehydration for refresh/re-enter
				try {
					if (isRecalled && isSelf) {
						const hint = this.loadReeditHint(chatId, messageIdStr)
						if (hint != null && hint.content !== '') {
							;(messageItem as any).reeditContent = hint.content
							if (hint.deadlineTs !== '') {
								;(messageItem as any).reeditDeadlineTs = hint.deadlineTs
							}
						}
					}
				} catch (e) {
				}

          this.addMessageToCache(chatId, messageItem)
          if (shouldNotify) {
            this.notifyMessageListeners(messageItem)
          }
          if (seqStr != null) {
            this.updateLastPulledSequence(chatId, seqStr)
            try {
              if (BigInt(seqStr) > BigInt(maxSeqInBatch)) {
                maxSeqInBatch = seqStr
              }
            } catch (e) {
              if (seqStr > maxSeqInBatch) {
                maxSeqInBatch = seqStr
              }
            }
          }
        }

        // 水位未推进则停止，避免死循环
        if (maxSeqInBatch === cursor) {
          this.debugStats.pullNoProgressStopCount += 1
          console.warn('[MessageService][Pull] stop(no progress):', { chatId: chatId, cursor: cursor, rounds: rounds, fetched: fetched, costMs: Date.now() - startedAt })
          return
        }
        cursor = maxSeqInBatch

        // 未满页则认为无更多
        if (arr.length < pageSize) {
          return
        }
      }

      if (fetched > 0) {
        this.debugStats.pullFetchedCount += fetched
      }
    } catch (e) {
      console.error('[MessageService] pullMissingMessagesForChat failed:', { chatId: chatId, e: e })
    }
  }

  private async resolveUserNickname(userId: string): Promise<string> {
    if (userId === '0' || userId === '') {
      return ''
    }

    if (userId === this.currentUserId) {
      const userInfo = getUserInfo()
      return userInfo?.user?.nickname || ''
    }

    const cached = this.userNicknameCache.get(userId)
    if (cached !== null && cached !== undefined) {
      return cached
    }

    const loading = this.userNicknameLoading.get(userId)
    if (loading !== null && loading !== undefined) {
      return await loading
    }

    const task = (async (): Promise<string> => {
      try {
        const resp = await getUserDetail(userId)
        const userObj: any = (resp && typeof resp === 'object' && 'data' in resp)
          ? resp.data
          : resp

        const nickname = userObj ? (userObj.nickname || userObj.name || '') : ''
        if (nickname) {
          this.userNicknameCache.set(userId, nickname)
        }
        return nickname
      } catch (e) {
        console.error('[MessageService] resolveUserNickname failed:', userId, e)
        return ''
      } finally {
        this.userNicknameLoading.delete(userId)
      }
    })()

    this.userNicknameLoading.set(userId, task)
    return await task
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): MessageService {
    if (MessageService.instance === null) {
      MessageService.instance = new MessageService()
    }
    return MessageService.instance
  }
  
  /**
   * 初始化 WebSocket 监听器
   */
  private initWebSocketListeners(): void {
    // 监听文本消息
    wsManager.addMessageListener(MessageType.TEXT, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听图片消息
    wsManager.addMessageListener(MessageType.IMAGE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听语音消息
    wsManager.addMessageListener(MessageType.VOICE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听视频消息
    wsManager.addMessageListener(MessageType.VIDEO, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听文件消息
    wsManager.addMessageListener(MessageType.FILE, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听位置消息
    wsManager.addMessageListener(MessageType.LOCATION, (message) => {
      void this.handleReceivedMessage(message)
    })
    
    // 监听已读回执
    wsManager.addMessageListener(MessageType.READ_RECEIPT, (message) => {
      this.handleReadReceipt(message)
    })
    
    // 监听消息撤回
    wsManager.addMessageListener(MessageType.RECALL, (message) => {
      this.handleRecall(message)
    })

    // 监听系统通知（用于会话快照推送等轻量事件）
    wsManager.addMessageListener(MessageType.SYSTEM_NOTIFY, (message) => {
      this.handleSystemNotify(message)
    })
  }

  private handleSystemNotify(message: any): void {
    try {
      const body: any = message != null ? (message as any).body : null
      const content: any = body != null ? (body as any).content : null
      if (content == null) {
        // enterprise: re-edit-after-recall hint (ONLY for sender devices)
        try {
          const extraRaw: any = message != null && (message as any).header != null ? (message as any).header.extra : null
          if (extraRaw != null && extraRaw !== '') {
            const extraObj = typeof extraRaw === 'string' ? JSON.parse(extraRaw) : extraRaw
            if (extraObj != null && extraObj.action === 'reedit_after_recall') {
              const chatId = extraObj.chatId != null ? extraObj.chatId.toString() : ''
              const messageId = extraObj.messageId != null ? extraObj.messageId.toString() : ''
              const originalContent = extraObj.originalContent != null ? extraObj.originalContent.toString() : ''
              const deadlineTsStr = extraObj.deadlineTs != null ? extraObj.deadlineTs.toString() : ''
              if (chatId !== '' && messageId !== '' && originalContent !== '') {
                const list = this.messageCache.get(chatId)
                if (list != null) {
                  const idx = list.findIndex((m: any) => m != null && (m as any).messageId === messageId)
                  if (idx > -1) {
                    try {
                      const existing: any = list[idx]
                      const next: any = { ...existing }
                      next.reeditContent = originalContent
                      if (deadlineTsStr !== '') {
                        next.reeditDeadlineTs = deadlineTsStr
                      }
                      list[idx] = next
                      this.notifyMessageListeners(next)
                      try {
                        this.persistReeditHint(chatId, messageId, originalContent, deadlineTsStr)
                      } catch (e) {
                      }
                    } catch (e) {
                    }
                  }
                }
              }
              return
            }
          }
        } catch (e) {
        }

        // enterprise: cursorVersion-only notify, trigger incremental sync for cross-device state (read watermark/preview/etc)
        try {
          const cv: any = (message as any).cursorVersion
          if (cv != null && cv !== '') {
            conversationService.handleRealtimeCursorVersion(cv)
          }
        } catch (e) { /* ignore */ }
        try {
          void conversationService.syncConversationsIncrementally(false)
        } catch (e) { /* ignore */ }
        return
      }
      const lastMessage = snapshot.lastMessageContent != null ? snapshot.lastMessageContent.toString() : ''
      let ts = Date.now()
      try {
        if (snapshot.lastMessageTime != null && snapshot.lastMessageTime !== '') {
          const parsed = new Date(snapshot.lastMessageTime as string).getTime()
          if (!isNaN(parsed) && parsed > 0) {
            ts = parsed
          }
        }
      } catch (e) {
        // ignore
      }

      conversationService.upsertFromSnapshot(snapshot, lastMessage, ts, false, snapshot.lastMessageSequence != null ? snapshot.lastMessageSequence.toString() : null)
    } catch (e) {
      console.error('[MessageService] handleSystemNotify failed:', e)
    }
  }
  
