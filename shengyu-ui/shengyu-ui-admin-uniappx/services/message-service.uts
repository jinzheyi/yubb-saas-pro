  /**
   * 发送消息（通用方法）
   */
  private sendMessage(message: ImMessage): MessageItem {
    // 从store获取当前用户信息
    const userInfo = getUserInfo()
    const currentUser = userInfo?.user

    console.log('[MessageService] sendMessage()', {
      currentUserId: this.currentUserId,
      currentTenantId: this.currentTenantId,
      header: {
        messageId: message?.header?.messageId,
        messageType: message?.header?.messageType,
        senderId: message?.header?.senderId,
        receiverId: message?.header?.receiverId,
        groupId: message?.header?.groupId,
        tenantId: message?.header?.tenantId,
        timestamp: message?.header?.timestamp
      }
    })
    
    // 生成头像信息
    const userName = currentUser?.nickname || ''
    const avatarText = getAvatarText(userName)
    const avatarBg = getUserAvatarColor(this.currentUserId)
    
    // 创建消息项
    const messageItem: MessageItem = {
      id: '0',  // 临时ID，服务端返回后更新
      messageId: message.header.messageId,
      sequence: message.header.sequence != null ? message.header.sequence.toString() : undefined,
      senderId: message.header.senderId,
      receiverId: message.header.receiverId,
      groupId: message.header.groupId,
      type: message.header.messageType,
      content: message.body,
      status: MessageStatus.SENDING,
      timestamp: message.header.timestamp,
      isSelf: true,
      showTime: true,
      avatarText: avatarText,
      avatarBg: avatarBg,
      senderName: userName
    }
    
    // 添加到缓存（群聊优先使用真实 chatId，而不是 groupId）
    const isGroup = message.header.groupId !== '0' && message.header.groupId !== ''
    let chatId = '0'
    if (isGroup) {
      const groupIdStr = message.header.groupId != null ? (message.header.groupId as any).toString() : '0'
      const cached = conversationService.getCachedChatIdByTarget(groupIdStr, 2)
      chatId = cached != null && cached !== '' ? cached : groupIdStr
    } else {
      const rawChatId = message.header.receiverId
      chatId = rawChatId != null ? (rawChatId as any).toString() : '0'
    }
    console.log('[MessageService] computed chatId:', chatId)
    this.addMessageToCache(chatId, messageItem)
    
    // 通知监听器
    this.notifyMessageListeners(messageItem)
    
    // 通过 WebSocket 发送
    console.log('[MessageService] wsManager.isConnected():', wsManager.isConnected())
    wsManager.send(message)

    try {
      const mid = message != null && message.header != null && message.header.messageId != null ? message.header.messageId.toString() : ''
      if (mid !== '' && mid !== '0') {
        this.scheduleSendRetry(mid, message)
      }
    } catch (e) {
      // ignore
    }
    
    // 更新会话（群聊摘要增加发送者前缀）
    if (isGroup) {
      const summary = MessageParser.getSummary({
        header: { messageType: messageItem.type } as any,
        body: messageItem.content
      } as any)
      const prefix = '我'
      conversationService.updateConversation(
        chatId,
        messageItem.type,
        `${prefix}: ${summary}`,
        messageItem.timestamp,
        false,
        null
      )
    } else {
      this.updateConversation(chatId, messageItem)
    }
    
    return messageItem
  }

  private isMessageStillSending(messageId: string): boolean {
    if (messageId == null || messageId === '' || messageId === '0') {
      return false
    }
    let still = false
    try {
      this.messageCache.forEach((messages) => {
        for (let i = 0; i < messages.length; i++) {
          const msg: any = messages[i]
          if (msg != null && msg.messageId === messageId && msg.status === MessageStatus.SENDING) {
            still = true
            break
          }
        }
      })
    } catch (e) {
      return false
    }
    return still
  }

  private setMessageFailed(messageId: string): void {
    if (messageId == null || messageId === '' || messageId === '0') {
      return
    }
    try {
      this.messageCache.forEach((messages) => {
        messages.forEach((msg: any) => {
          if (msg != null && msg.messageId === messageId && msg.status === MessageStatus.SENDING) {
            msg.status = MessageStatus.FAILED
          }
        })
      })
    } catch (e) {
      // ignore
    }
    try {
      this.notifyStatusListeners(messageId, MessageStatus.FAILED)
    } catch (e) {
      // ignore
    }
  }

  private clearSendRetry(messageId: string): void {
    if (messageId == null || messageId === '' || messageId === '0') {
      return
    }
    const pending = this.pendingRetryMap.get(messageId)
    if (pending != null && pending.timer != null) {
      try {
        clearTimeout(pending.timer)
      } catch (e) {
        // ignore
      }
    }
    this.pendingRetryMap.delete(messageId)
  }

  private scheduleSendRetry(messageId: string, message: any): void {
    if (messageId == null || messageId === '' || messageId === '0') {
      return
    }
    if (!this.isMessageStillSending(messageId)) {
      this.clearSendRetry(messageId)
      return
    }

    const existing = this.pendingRetryMap.get(messageId)
    const retryCount = existing != null ? existing.retryCount : 0
    if (retryCount >= MessageService.MAX_RETRY_COUNT) {
      this.clearSendRetry(messageId)
      this.setMessageFailed(messageId)
      return
    }

    if (existing != null && existing.timer != null) {
      return
    }

    const delay = MessageService.SEND_RETRY_BASE_DELAY_MS * (retryCount + 1)
    const timer = setTimeout(() => {
      const latest = this.pendingRetryMap.get(messageId)
      const latestRetry = latest != null ? latest.retryCount : retryCount
      if (!this.isMessageStillSending(messageId)) {
        this.clearSendRetry(messageId)
        return
      }
      if (latestRetry >= MessageService.MAX_RETRY_COUNT) {
        this.clearSendRetry(messageId)
        this.setMessageFailed(messageId)
        return
      }

      try {
        this.pendingRetryMap.set(messageId, { message: message, retryCount: latestRetry + 1, timer: null })
        wsManager.send(message)
      } catch (e) {
        this.pendingRetryMap.set(messageId, { message: message, retryCount: latestRetry + 1, timer: null })
      }

      this.scheduleSendRetry(messageId, message)
    }, delay)

    this.pendingRetryMap.set(messageId, { message: message, retryCount: retryCount, timer: timer })
  }
  
  /**
   * 处理接收到的消息
   */
  private async handleReceivedMessage(data: any): Promise<void> {
    const message = data as ImMessage
    
    // 处理角标更新消息 (messageType = 204)
    if (message.header.messageType === 204) {
      this.handleBadgeUpdateMessage(message)
      return
    }

    const senderIdStr = message.header.senderId != null ? message.header.senderId.toString() : '0'
    const isSelf = senderIdStr === this.currentUserId
    const senderName = isSelf ? (getUserInfo()?.user?.nickname || '') : await this.resolveUserNickname(senderIdStr)
    const avatarText = senderName ? getAvatarText(senderName) : '?'

    // 自己发送的消息：服务端回推用于确认投递（SENDING -> SENT），避免重复插入
    if (isSelf) {
      const msgId = message.header.messageId
      const seq = message.header.sequence
      let updated = false
      let resolvedChatId = this.resolveChatIdFromHeader(message.header)
      this.messageCache.forEach((messages) => {
        messages.forEach(msg => {
          if (msg.messageId === msgId && msg.status === MessageStatus.SENDING) {
            msg.status = MessageStatus.SENT
            if (seq !== null && seq !== undefined) {
              msg.sequence = seq.toString()
              resolvedChatId = this.resolveChatIdFromHeader(message.header)
              this.updateLastPulledSequence(resolvedChatId, msg.sequence)
            }
            updated = true
          }
        })
      })
      if (updated) {
        try {
          this.clearSendRetry(msgId)
        } catch (e) {
          // ignore
        }
        this.notifyStatusListeners(msgId, MessageStatus.SENT)

			// 自己的消息也需要更新会话（否则会话水位/红点会错）
			const seqStr = seq != null && seq !== undefined ? seq.toString() : null
			const isGroupSelf = message.header.groupId !== '0' && message.header.groupId !== ''
			const summary = MessageParser.getSummary({
				header: { messageType: message.header.messageType } as any,
				body: message.body
			} as any)
			let preview = isGroupSelf ? `我: ${summary}` : summary

			const snapshot: any = (message as any).conversationSnapshot
			if (snapshot != null) {
				try {
					const cv = (snapshot as any).cursorVersion
					conversationService.handleRealtimeCursorVersion(cv)
				} catch (e) { /* ignore */ }
				try {
					if ((snapshot as any).lastMessageContent != null && (snapshot as any).lastMessageContent !== '') {
						preview = (snapshot as any).lastMessageContent.toString()
					}
				} catch (e) { /* ignore */ }
				try {
					const snapChatId = conversationService.upsertFromSnapshot(
						snapshot,
						preview,
						message.header.timestamp,
						false,
						seqStr
					)
					if (snapChatId != null && snapChatId !== '') {
						resolvedChatId = snapChatId
					}
				} catch (e) { /* ignore */ }
			} else {
				try {
					const cv = (message as any).cursorVersion
					conversationService.handleRealtimeCursorVersion(cv)
				} catch (e) { /* ignore */ }
			}

			conversationService.updateConversation(
				resolvedChatId,
				message.header.messageType,
				preview,
				message.header.timestamp,
				false,
				seqStr
			)

			// 发送端：自己发送的消息视为已读，推进读水位避免出现红点
			if (seqStr != null && seqStr !== '') {
				conversationService.applyReadWatermark(resolvedChatId, seqStr)
			}
			return
      }
    }

    // 创建消息项
    const messageItem: MessageItem = {
      id: '0',
      messageId: message.header.messageId,
      sequence: message.header.sequence != null ? message.header.sequence.toString() : undefined,
      senderId: senderIdStr,
      receiverId: message.header.receiverId,
      groupId: message.header.groupId,
      type: message.header.messageType,
      content: message.body,
      status: MessageStatus.SENT,
      timestamp: message.header.timestamp,
      isSelf: isSelf,
      showTime: true,
      avatarText: avatarText,
      avatarBg: getUserAvatarColor(senderIdStr),
      senderName: senderName
    }

    const isGroup = message.header.groupId !== '0' && message.header.groupId !== ''
	let chatId = this.resolveChatIdFromHeader(message.header)
	// gap 检测：sequence 跳跃则优先补偿拉取，避免渲染乱序/丢洞
	try {
		const seqStr = messageItem.sequence != null ? messageItem.sequence.toString() : ''
		if (seqStr !== '') {
			const lastPulled = this.getLastPulledSequence(chatId)
			let hasGap = false
			try {
				hasGap = BigInt(seqStr) > BigInt(lastPulled) + BigInt(1)
			} catch (e) {
				// ignore
			}
			if (hasGap) {
				this.debugStats.wsGapDetectedCount += 1
				console.warn('[MessageService][Gap] detected:', { chatId: chatId, lastPulled: lastPulled, incoming: seqStr })
				await this.pullMissingMessagesForChat(chatId)
				this.debugStats.wsGapTriggeredPullCount += 1
			}
		}
	} catch (e) {
		// ignore
	}
	const summary = MessageParser.getSummary({
	  header: { messageType: messageItem.type } as any,
	  body: messageItem.content
	})
	let preview = isGroup ? `${(messageItem.isSelf ? '我' : senderName)}: ${summary}` : summary
	const seq = messageItem.sequence != null ? messageItem.sequence.toString() : null
    const targetId = isGroup
      ? (message.header.groupId != null ? message.header.groupId.toString() : '0')
      : (isSelf
        ? (message.header.receiverId != null ? message.header.receiverId.toString() : '0')
        : senderIdStr)
    const conversationType = isGroup ? 2 : 1

    const snapshot: any = (message as any).conversationSnapshot
    if (snapshot != null) {
		try {
			const cv = (snapshot as any).cursorVersion
			conversationService.handleRealtimeCursorVersion(cv)
		} catch (e) { /* ignore */ }
		try {
			if ((snapshot as any).lastMessageContent != null && (snapshot as any).lastMessageContent !== '') {
				preview = (snapshot as any).lastMessageContent.toString()
			}
		} catch (e) { /* ignore */ }
      const snapChatId = conversationService.upsertFromSnapshot(snapshot, preview, messageItem.timestamp, !messageItem.isSelf, seq)
      if (snapChatId != null && snapChatId !== '') {
        chatId = snapChatId
      }
    } else {
      try {
        const cv = (message as any).cursorVersion
        conversationService.handleRealtimeCursorVersion(cv)
      } catch (e) { /* ignore */ }
    }

    if (conversationService.getConversation(chatId) == null) {
      const ensuredChatId = await conversationService.ensureConversationByTarget(
        targetId,
        conversationType,
        preview,
        messageItem.timestamp,
        !messageItem.isSelf,
        seq
      )
      if (ensuredChatId != null && ensuredChatId !== '') {
        chatId = ensuredChatId
      }
    }

    // 添加到缓存
    this.addMessageToCache(chatId, messageItem)
    if (messageItem.sequence != null) {
      this.updateLastPulledSequence(chatId, messageItem.sequence)
    }
    
    // 通知监听器
    this.notifyMessageListeners(messageItem)
    
    // 更新会话
    conversationService.updateConversation(
      chatId,
      messageItem.type,
      preview,
      messageItem.timestamp,
      !messageItem.isSelf,
      seq
    )
    
    // 如果不是自己发送的消息，增加未读数和角标
    if (!messageItem.isSelf) {
      try {
        const active = this.getActiveChatId()
        if (active != null && active !== '' && active === chatId) {
          if (seq != null && seq !== '') {
            conversationService.applyReadWatermark(chatId, seq)
          }
          badgeService.clearConversationBadgeLocal(chatId)
          return
        }
      } catch (e) {
        // ignore
      }
      // 自动增加对应会话的角标未读数
      badgeService.incrementConversationBadge(chatId)
    }
  }
  
  /**
   * 处理已读回执
   */
  private handleReadReceipt(data: any): void {
    const message = data as ImMessage
    const body = message.body as any
    
    // 解析 messageIds：支持数组和单个 ID 两种格式
    let messageIds: string[] = []
    if (body.messageIds !== null && body.messageIds !== undefined) {
      messageIds = body.messageIds as string[]
    } else if (body.messageId !== null && body.messageId !== undefined) {
      messageIds = [body.messageId as string]
    }
    
    console.log('[MessageService] 收到已读回执:', messageIds)
    
    if (messageIds.length === 0) {
      return
    }
    
    // 更新消息状态为已读
    const updatedIds: string[] = []
    this.messageCache.forEach((messages) => {
      messages.forEach(msg => {
        if (messageIds.includes(msg.messageId) && msg.status !== MessageStatus.READ) {
          msg.status = MessageStatus.READ
          updatedIds.push(msg.messageId)
        }
      })
    })
    
    // 通知状态监听器
    updatedIds.forEach(msgId => {
      this.notifyStatusListeners(msgId, MessageStatus.READ)
    })
    
    console.log('[MessageService] 已将', updatedIds.length, '条消息状态更新为已读')
  }
  
  /**
   * 处理消息撤回
   */
  private handleRecall(data: any): void {
    const message = data as ImMessage
    const body = message.body as any
    const messageId = body.messageId as string
    const recallerId = message.header.senderId
    
    console.log('[MessageService] 收到消息撤回:', messageId, '撤回者:', recallerId)
    
    // 从缓存中查找并更新消息
    this.messageCache.forEach((messages, chatId) => {
      const index = messages.findIndex(m => m.messageId === messageId)
      if (index !== -1) {
        const originalMessage = messages[index]
        
        // 创建撤回提示消息
        const recallTip: MessageItem = {
          id: originalMessage.id,
          messageId: originalMessage.messageId,
          senderId: recallerId,
          receiverId: originalMessage.receiverId,
          groupId: originalMessage.groupId,
          type: MessageType.TEXT,  // 使用文本类型显示撤回提示
          content: recallerId === this.currentUserId ? '你撤回了一条消息' : `${originalMessage.senderName} 撤回了一条消息`,
          status: MessageStatus.SENT,
          timestamp: Date.now(),
          isSelf: recallerId === this.currentUserId,
          showTime: false,
          avatarText: originalMessage.avatarText,
          avatarBg: originalMessage.avatarBg,
          senderName: originalMessage.senderName
        }
        
        // 替换原消息
        messages[index] = recallTip
        
        // 通知监听器
        this.notifyMessageListeners(recallTip)
        
        // 更新会话最后消息
        this.updateConversation(chatId, recallTip)
      }
    })
  }
  
  /**
   * 处理角标更新消息
   */
  private handleBadgeUpdateMessage(message: ImMessage): void {
    try {
      // 解析 message.body 为 BadgeUpdateMessage 对象
      const badgeUpdate = JSON.parse(message.body as string) as BadgeUpdateMessage
      
      console.log('[MessageService] 收到角标更新消息:', badgeUpdate)
      
      // 调用 badgeService 处理角标更新
      badgeService.handleBadgeUpdate(badgeUpdate)
    } catch (e) {
      console.error('[MessageService] 解析角标更新消息失败:', e)
      // 解析失败时记录错误并使用本地数据
      // badgeService 会继续使用本地缓存的角标数据
    }
  }
  
  /**
   * 发送已读回执
   */
  public sendReadReceipt(receiverId: string, messageIds: string[]): void {
    const message = MessageBuilder.buildReadReceiptMessage(
      this.currentUserId,
      receiverId,
      this.currentTenantId,
      messageIds
    )
    
    wsManager.send(message)
  }
  
  /**
   * 撤回消息
   */
  public recallMessage(receiverId: string, groupId: string, messageId: string): void {
    const message = MessageBuilder.buildRecallMessage(
      this.currentUserId,
      receiverId,
      groupId,
      this.currentTenantId,
      messageId
    )
    
    wsManager.send(message)
  }
  
  /**
   * 添加消息到缓存
   */
  private addMessageToCache(chatId: string, message: MessageItem): void {
    let messages = this.messageCache.get(chatId)
    if (messages === null || messages === undefined) {
      messages = []
      this.messageCache.set(chatId, messages)
    }

    // 去重/合并：pull 补偿与 WS/ACK 可能重叠；以 messageId 为幂等键
    const incomingId = message.messageId != null ? message.messageId.toString() : ''
    if (incomingId !== '') {
      const existing = messages.find(m => m != null && m.messageId === incomingId)
      if (existing != null) {
        this.debugStats.dedupMergeHitCount += 1
        // 仅做“信息补齐”，避免覆盖已确认的状态
        if ((existing.sequence == null || existing.sequence === '') && message.sequence != null && message.sequence !== '') {
          existing.sequence = message.sequence
        }
        if ((existing.status == null || existing.status === MessageStatus.SENDING) && message.status != null) {
          existing.status = message.status
        }
        if ((existing.content == null || existing.content === '') && message.content != null) {
          existing.content = message.content
        }
        if ((existing.timestamp == null || existing.timestamp <= 0) && message.timestamp != null) {
          existing.timestamp = message.timestamp
        }
        // 合并后仍需要排序
      } else {
        messages.push(message)
      }
    } else {
      messages.push(message)
    }

    // 优先按 sequence 排序（断线补偿/严格顺序），否则退化为 timestamp+messageId
    messages.sort((a, b) => {
      const as = a.sequence
      const bs = b.sequence
      if (as != null && bs != null) {
        try {
          const diff = BigInt(as) - BigInt(bs)
          if (diff !== BigInt(0)) {
            return diff > BigInt(0) ? 1 : -1
          }
        } catch (e) {
          // ignore
        }
      } else if (as != null && bs == null) {
        return 1
      } else if (as == null && bs != null) {
        return -1
      }

      if (a.timestamp !== b.timestamp) {
        return a.timestamp - b.timestamp
      }
      if (a.messageId !== b.messageId) {
        return a.messageId > b.messageId ? 1 : -1
      }
      return 0
    })
  }
  
  /**
   * 获取会话的消息列表
   */
  public getMessages(chatId: string): MessageItem[] {
    const messages = this.messageCache.get(chatId)
    return messages !== null && messages !== undefined ? messages : []
  }

  private resolveChatIdFromHeader(header: any): string {
    if (header != null && header.chatId != null && header.chatId !== '') {
      return (header.chatId as any).toString()
    }
    const isGroup = header.groupId !== '0' && header.groupId !== ''
    if (isGroup) {
      const groupId = header.groupId != null ? (header.groupId as any).toString() : '0'
      const cached = conversationService.getCachedChatIdByTarget(groupId, 2)
      if (cached != null) {
        return cached
      }
      return groupId
    }
    const receiverId = header.receiverId != null ? (header.receiverId as any).toString() : '0'
    const cached = conversationService.getCachedChatIdByTarget(receiverId, 1)
    if (cached != null) {
      return cached
    }
    return receiverId
  }

  private getLastPulledSequenceStorageKey(chatId: string): string {
    const tenantId = this.currentTenantId != null ? this.currentTenantId : '0'
    const userId = this.currentUserId != null ? this.currentUserId : '0'
    return `im_last_pulled_sequence_${tenantId}_${userId}_${chatId}`
  }

  public getLastPulledSequence(chatId: string): string {
    const cached = this.lastPulledSequence.get(chatId)
    if (cached != null) {
      return cached
    }
    try {
      const v = uni.getStorageSync(this.getLastPulledSequenceStorageKey(chatId))
      const s = v != null && v !== '' ? v.toString() : '0'
      this.lastPulledSequence.set(chatId, s)
      return s
    } catch (e) {
      return '0'
    }
  }

  private updateLastPulledSequence(chatId: string, seq: string): void {
    if (seq == null || seq === '') {
      return
    }
    const current = this.getLastPulledSequence(chatId)
    let shouldUpdate = false
    try {
      shouldUpdate = BigInt(seq) > BigInt(current)
    } catch (e) {
      shouldUpdate = seq > current
    }
    if (!shouldUpdate) {
      return
    }
    this.lastPulledSequence.set(chatId, seq)
    try {
      uni.setStorageSync(this.getLastPulledSequenceStorageKey(chatId), seq)
    } catch (e) {
      // ignore
    }
  }
  
  /**
   * 更新会话
   */
  private updateConversation(chatId: string, message: MessageItem): void {
    const summary = MessageParser.getSummary({
      header: { messageType: message.type } as any,
      body: message.content
    } as any)
    const seq = message.sequence != null ? message.sequence.toString() : null
    conversationService.updateConversation(
      chatId,
      message.type,
      summary,
      message.timestamp,
      !message.isSelf,
      seq
    )
  }
  
  /**
   * 处理消息队列（重连后调用）
   */
  public processQueue(): void {
    if (this.isProcessingQueue || this.messageQueue.length === 0) {
      return
    }
    
    this.isProcessingQueue = true
    console.log('[MessageService] 开始处理消息队列，共', this.messageQueue.length, '条消息')
    
    const processNext = (): void => {
      if (this.messageQueue.length === 0) {
        this.isProcessingQueue = false
        console.log('[MessageService] 消息队列处理完成')
        this.saveQueueToLocal()
        return
      }
      
      const queued = this.messageQueue[0]
      
      // 超过最大重试次数则丢弃
      if (queued.retryCount >= MessageService.MAX_RETRY_COUNT) {
        this.messageQueue.shift()
        console.warn('[MessageService] 消息重试次数超限，已丢弃')
        processNext()
        return
      }
      
      try {
        wsManager.send(queued.message)
        this.messageQueue.shift()
        queued.retryCount++
        console.log('[MessageService] 队列消息发送成功')
      } catch (e) {
        queued.retryCount++
        console.error('[MessageService] 队列消息发送失败:', e)
        this.isProcessingQueue = false
        this.saveQueueToLocal()
        return
      }
      
      // 逐条处理，限速100ms
      setTimeout(() => {
        processNext()
      }, 100)
    }
    
    processNext()
  }
  
  /**
   * 保存队列到本地存储
   */
  private saveQueueToLocal(): void {
    try {
      const queueData = this.messageQueue.map(item => ({
        retryCount: item.retryCount,
        timestamp: item.timestamp
      }))
      uni.setStorageSync('message_queue_count', queueData.length.toString())
    } catch (e) {
      console.error('[MessageService] 保存队列失败:', e)
    }
  }
  
  /**
   * 获取队列长度
   */
  public getQueueLength(): number {
    return this.messageQueue.length
  }
  
  /**
   * 清空消息队列
   */
  public clearQueue(): void {
    this.messageQueue = []
    this.saveQueueToLocal()
  }
  
  /**
   * 添加消息状态监听器
   */
  public addMessageStatusListener(listener: MessageStatusListener): void {
    this.messageStatusListeners.push(listener)
  }
  
  /**
   * 移除消息状态监听器
   */
  public removeMessageStatusListener(listener: MessageStatusListener): void {
    const index = this.messageStatusListeners.indexOf(listener)
    if (index !== -1) {
      this.messageStatusListeners.splice(index, 1)
    }
  }
  
  /**
   * 通知消息状态监听器
   */
  private notifyStatusListeners(messageId: string, status: MessageStatus): void {
    this.messageStatusListeners.forEach(listener => {
      try {
        listener(messageId, status)
      } catch (e) {
        console.error('[MessageService] 状态监听器执行失败:', e)
      }
    })
  }
  
  /**
   * 更新消息状态
   */
  public updateMessageStatus(messageId: string, status: MessageStatus): void {
    let updated = false
    this.messageCache.forEach(messages => {
      const msg = messages.find(m => m.messageId === messageId)
      if (msg !== null && msg !== undefined && msg.status !== status) {
        msg.status = status
        updated = true
      }
    })
    
    if (updated) {
      this.notifyStatusListeners(messageId, status)
    }
  }
  
  public clearUnreadCount(chatId: string): void {
    badgeService.clearConversationBadgeLocal(chatId)
  }

  public getConversations(): ConversationItem[] {
    return conversationService.getConversations() as any
  }
  
  /**
   * 添加消息监听器
   */
  public addMessageListener(listener: MessageListener): void {
    this.messageListeners.push(listener)
  }
  
  /**
   * 移除消息监听器
   */
  public removeMessageListener(listener: MessageListener): void {
    const index = this.messageListeners.indexOf(listener)
    if (index !== -1) {
      this.messageListeners.splice(index, 1)
    }
  }
  
  /**
   * 通知消息监听器
   */
  private notifyMessageListeners(message: MessageItem): void {
    this.messageListeners.forEach((listener) => {
      try {
        listener(message)
      } catch (e) {
        console.error('[MessageService] 消息监听器执行失败:', e)
      }
    })
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    this.messageCache.clear()
  }
}

/**
 * 导出单例实例
 */
export const messageService = MessageService.getInstance()
