/**
 * 会话服务
 * 
 * 功能:
 * 1. 会话列表管理
 * 2. 会话操作（置顶、删除、免打扰、清空未读）
 * 3. 会话更新和排序
 * 4. 已读未读管理
 * 5. 草稿管理
 */

import { request } from '@/utils/request.uts'
import { badgeService } from './badge-service.uts'
import { getConversationAvatarColor } from '@/utils/avatar.uts'

/**
 * 会话类型枚举
 * 与后端 ImConversationTypeEnum 保持一致
 */
export enum ConversationType {
  SINGLE = 1,  // 单聊
  GROUP = 2    // 群聊
}

/**
 * 会话项（用于 UI 显示）
 * 字段名与后端 AppImConversationRespVO 保持一致
 */
export type ConversationItem = {
  chatId: string              // 对应后端 chatId
  conversationType: number     // 对应后端 conversationType (1-单聊 2-群聊)
  targetId: string            // 对应后端 targetId
  targetName: string          // 对应后端 targetName
  targetAvatar: string        // 对应后端 targetAvatar
  avatarText: string           // 头像文字
  avatarBg: string            // 头像背景色
  lastMessageType: number      // 对应后端 lastMessageType
  lastMessageContent: string  // 对应后端 lastMessageContent
  lastMessageTime: string     // 对应后端 lastMessageTime (格式化后)
  timestamp: number           // 时间戳（用于排序）
  unreadCount: number         // 对应后端 unreadCount
  lastMessageSequence: string // 对应后端 lastMessageSequence（服务端权威水位）
  lastReadSequence: string    // 对应后端 lastReadSequence（服务端权威水位）
  isPinned: boolean           // 对应后端 isPinned
  noDisturb: boolean          // 对应后端 noDisturb
  draft: string               // 草稿
  groupMemberCount: number    // 对应后端 groupMemberCount
}

/**
 * 会话更新监听器类型
 */
export type ConversationUpdateListener = (conversations: ConversationItem[]) => void

/**
 * 会话服务类（单例模式）
 */
export class ConversationService {
  
  private static instance: ConversationService | null = null
  
  // 会话列表缓存
  private conversations: ConversationItem[] = []

  private loaded: boolean = false

  private targetChatIdCache: Map<string, string> = new Map()
  
  // 会话更新监听器列表
  private updateListeners: ConversationUpdateListener[] = []
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }

  public upsertFromSnapshot(
    snapshot: any,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): string | null {
    if (snapshot == null) {
      return null
    }

    const conv = this.mapToConversationItem(snapshot)
    if (conv.chatId == null || conv.chatId === '' || conv.chatId === '0') {
      return null
    }

    if (conv.targetId != null && conv.targetId !== '' && conv.conversationType != null) {
      this.cacheTargetChatId(conv.targetId, conv.conversationType, conv.chatId)
    }

    const existing = this.getConversation(conv.chatId)
    if (existing == null) {
      this.conversations.unshift(conv)
    } else {
      existing.targetId = conv.targetId
      existing.targetName = conv.targetName
      existing.targetAvatar = conv.targetAvatar
      existing.avatarText = conv.avatarText
      existing.avatarBg = conv.avatarBg
      existing.groupMemberCount = conv.groupMemberCount
      existing.isPinned = conv.isPinned
      existing.noDisturb = conv.noDisturb
      existing.lastReadSequence = conv.lastReadSequence
      existing.lastMessageSequence = conv.lastMessageSequence
      existing.unreadCount = conv.unreadCount
      existing.lastMessageType = conv.lastMessageType
      existing.lastMessageContent = conv.lastMessageContent
      existing.lastMessageTime = conv.lastMessageTime
      existing.timestamp = conv.timestamp
    }

    const preview = conv.lastMessageContent != null && conv.lastMessageContent !== '' ? conv.lastMessageContent : lastMessage
    const ts = timestamp != null && timestamp > 0 ? timestamp : conv.timestamp
    this.updateConversation(conv.chatId, conv.lastMessageType, preview, ts, incrementUnread, messageSequence)
    return conv.chatId
  }

  private buildTargetKey(targetId: string, conversationType: number): string {
    const t = targetId != null ? (targetId as any).toString() : ''
    return `${conversationType}_${t}`
  }

  public getCachedChatIdByTarget(targetId: string, conversationType: number): string | null {
    const key = this.buildTargetKey(targetId, conversationType)
    const cached = this.targetChatIdCache.get(key)
    return cached != null && cached !== '' ? cached : null
  }

  private cacheTargetChatId(targetId: string, conversationType: number, chatId: string): void {
    if (targetId == null || targetId === '' || chatId == null || chatId === '') {
      return
    }
    const key = this.buildTargetKey(targetId, conversationType)
    this.targetChatIdCache.set(key, chatId)
  }

  public async ensureConversationByTarget(
    targetId: string,
    conversationType: number,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): Promise<string | null> {
    const cachedChatId = this.getCachedChatIdByTarget(targetId, conversationType)
    if (cachedChatId != null) {
      return cachedChatId
    }

    try {
      const targetIdStr = targetId != null ? (targetId as any).toString() : ''
      const data = await request({
        url: `/system/im/conversation/get-by-target?targetId=${targetIdStr}&conversationType=${conversationType}`,
        method: 'GET'
      })
      if (data == null) {
        return null
      }
      const conv = this.mapToConversationItem(data as any)
      if (conv.chatId != null && conv.chatId !== '') {
        this.cacheTargetChatId(targetIdStr, conversationType, conv.chatId)
      }

      const existing = this.getConversation(conv.chatId)
      if (existing == null) {
        this.conversations.unshift(conv)
      }

      const preview = conv.lastMessageContent != null && conv.lastMessageContent !== '' ? conv.lastMessageContent : lastMessage
      const ts = timestamp != null && timestamp > 0 ? timestamp : conv.timestamp
      this.updateConversation(conv.chatId, conv.lastMessageType, preview, ts, incrementUnread, messageSequence)
      return conv.chatId
    } catch (e) {
      console.error('[ConversationService] ensureConversationByTarget 失败:', e)
      return null
    }
  }

  public applyReadWatermark(chatId: string, readSequence: string): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    if (conversation == null) {
      return
    }
    const seq = readSequence != null && readSequence !== '' ? readSequence.toString() : '0'
    const currentRead = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    let shouldUpdate = false
    try {
      shouldUpdate = BigInt(seq) > BigInt(currentRead)
    } catch (e) {
      shouldUpdate = seq > currentRead
    }
    if (shouldUpdate) {
      conversation.lastReadSequence = seq
    }
    const lastMsgSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
    const lastReadSeq = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    let unread = 0
    try {
      const diff = BigInt(lastMsgSeq) - BigInt(lastReadSeq)
      unread = diff > BigInt(0) ? Number(diff) : 0
    } catch (e) {
      const diff = parseInt(lastMsgSeq) - parseInt(lastReadSeq)
      unread = diff > 0 ? diff : 0
    }
    conversation.unreadCount = unread
    this.sortConversations()
    this.notifyUpdateListeners()
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): ConversationService {
    if (ConversationService.instance === null) {
      ConversationService.instance = new ConversationService()
    }
    return ConversationService.instance
  }
  
  /**
   * 从服务器加载会话列表
   */
  public async loadConversations(): Promise<void> {
    try {
      const data = await request({
        url: '/system/im/conversation/list',
        method: 'GET'
      })

      if (data != null) {
        this.conversations = (data as any[]).map((item: any) => this.mapToConversationItem(item))
      } else {
        this.conversations = []
      }
      this.conversations.forEach(c => {
        if (c != null && c.targetId != null && c.targetId !== '' && c.chatId != null && c.chatId !== '') {
          this.cacheTargetChatId(c.targetId, c.conversationType, c.chatId)
        }
      })
      this.sortConversations()
      this.notifyUpdateListeners()
    } catch (e) {
      console.error('[ConversationService] 加载会话列表失败:', e)
    } finally {
      this.loaded = true
    }
  }
  
  /**
   * 获取会话列表
   */
  public getConversations(): ConversationItem[] {
    return this.conversations
  }
  
  /**
   * 获取单个会话
   */
  public getConversation(chatId: string): ConversationItem | null {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    return conversation != null ? conversation : null
  }
  
  /**
   * 更新会话（接收到新消息时调用）
   */
  public updateConversation(
    chatId: string,
    lastMessageType: number,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (!this.loaded) {
      void this.loadConversations()
      return
    }

    if (lastMessageType == null || (lastMessageType as any) === '' || (lastMessageType as any) === 0) {
      console.warn('[ConversationService] lastMessageType 缺失，可能导致摘要不准确:', chatIdStr, lastMessage)
    }

    let conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    // 兼容调用方传入 targetId 的情况（群聊：groupId；单聊：对方 userId）
    if (conversation == null) {
      conversation = this.conversations.find(c => c.targetId === chatIdStr)
    }
    
    if (conversation != null) {
      // 更新现有会话
      conversation.lastMessageType = lastMessageType
      conversation.lastMessageContent = lastMessage
      conversation.timestamp = timestamp

	  if (timestamp != null && timestamp > 0 && !isNaN(timestamp)) {
		  conversation.lastMessageTime = this.formatTime(timestamp)
	  } else {
		  conversation.lastMessageTime = ''
	  }

      if (messageSequence != null && messageSequence !== '') {
        const newSeq = messageSequence.toString()
        const currentSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
        let shouldUpdate = false
        try {
          shouldUpdate = BigInt(newSeq) > BigInt(currentSeq)
        } catch (e) {
          shouldUpdate = newSeq > currentSeq
        }
        if (shouldUpdate) {
          conversation.lastMessageSequence = newSeq
        }
      }
      
      if (incrementUnread) {
        const lastMsgSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
        const lastReadSeq = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
        let unread = 0
        try {
          const diff = BigInt(lastMsgSeq) - BigInt(lastReadSeq)
          unread = diff > BigInt(0) ? Number(diff) : 0
        } catch (e) {
          const diff = parseInt(lastMsgSeq) - parseInt(lastReadSeq)
          unread = diff > 0 ? diff : 0
        }
        conversation.unreadCount = unread
      }
    } else {
      // 创建新会话（实际应该从服务器获取完整信息）
      console.warn('[ConversationService] 会话不存在，需要从服务器获取:', chatIdStr)
      // TODO: 从服务器获取会话详情
    }
    
    this.sortConversations()
    this.notifyUpdateListeners()
  }
  
  /**
   * 置顶会话
   */
  public async pinConversation(chatId: string, isPinned: boolean): Promise<boolean> {
    try {
      await request({
        url: '/system/im/conversation/update',
        method: 'PUT',
        data: {
          chatId: chatId,
          isPinned: isPinned
        }
      })

      const conversation = this.conversations.find(c => c.chatId === chatId || ((c as any).id === chatId))
      if (conversation != null) {
        conversation.isPinned = isPinned
        this.sortConversations()
        this.notifyUpdateListeners()
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 置顶会话失败:', e)
      return false
    }
  }
  
  /**
   * 删除会话
   */
  public async deleteConversation(chatId: string): Promise<boolean> {
    try {
      await request({
        url: '/system/im/conversation/delete',
        method: 'DELETE',
        params: {
          chatId: chatId
        }
      })

      const index = this.conversations.findIndex(c => c.chatId === chatId || ((c as any).id === chatId))
      if (index !== -1) {
        this.conversations.splice(index, 1)
        this.notifyUpdateListeners()
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 删除会话失败:', e)
      return false
    }
  }
  
  /**
   * 设置免打扰
   */
  public async setMute(chatId: string, noDisturb: boolean): Promise<boolean> {
    try {
      await request({
        url: '/system/im/conversation/update',
        method: 'PUT',
        data: {
          chatId: chatId,
          noDisturb: noDisturb
        }
      })

      const conversation = this.conversations.find(c => c.chatId === chatId)
      if (conversation != null) {
        conversation.noDisturb = noDisturb
        this.notifyUpdateListeners()
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 设置免打扰失败:', e)
      return false
    }
  }
  
  /**
   * 清空未读数
   */
  public async clearUnread(chatId: string): Promise<boolean> {
    try {
      const conversation = this.conversations.find(c => c.chatId === chatId)
      const seq = conversation != null && (conversation as any).lastMessageSequence != null
        ? (conversation as any).lastMessageSequence.toString()
        : '0'

      badgeService.clearConversationBadge(chatId, seq)

      if (conversation != null) {
        conversation.unreadCount = 0
        this.notifyUpdateListeners()

        // 同步清空角标
        // badgeService 已在上面触发服务端水位推进
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 清空未读数失败:', e)
      return false
    }
  }
  
  /**
   * 保存草稿
   */
  public saveDraft(chatId: string, draft: string): void {
    const conversation = this.conversations.find(c => c.chatId === chatId)
    if (conversation != null) {
      conversation.draft = draft
      this.notifyUpdateListeners()
    }
  }
  
  /**
   * 获取草稿
   */
  public getDraft(chatId: string): string {
    const conversation = this.conversations.find(c => c.chatId === chatId)
    return conversation != null ? conversation.draft : ''
  }
  
  /**
   * 会话排序（置顶优先，按时间倒序）
   */
  private sortConversations(): void {
    this.conversations.sort((a, b) => {
      // 置顶的会话排在前面
      if (a.isPinned !== b.isPinned) {
        return a.isPinned ? -1 : 1
      }
      // 按时间戳降序排序
      return b.timestamp - a.timestamp
    })
  }
  
  /**
   * 格式化时间
   */
  private formatTime(timestamp: number): string {
    const now = Date.now()
    const diff = now - timestamp
    const oneDay = 24 * 60 * 60 * 1000
    
    if (diff < 60 * 1000) {
      return '刚刚'
    } else if (diff < 60 * 60 * 1000) {
      return Math.floor(diff / (60 * 1000)) + '分钟前'
    } else if (diff < oneDay) {
      const date = new Date(timestamp)
      return date.getHours() + ':' + String(date.getMinutes()).padStart(2, '0')
    } else if (diff < 2 * oneDay) {
      return '昨天'
    } else if (diff < 7 * oneDay) {
      const days = ['日', '一', '二', '三', '四', '五', '六']
      const date = new Date(timestamp)
      return '星期' + days[date.getDay()]
    } else {
      const date = new Date(timestamp)
      return (date.getMonth() + 1) + '/' + date.getDate()
    }
  }
  
  /**
   * 映射服务器数据到会话项
   * 字段名与后端 AppImConversationRespVO 保持一致
   */
  private mapToConversationItem(data: any): ConversationItem {
    const targetId = data.targetId != null ? data.targetId.toString() : '0'
    const conversationType = data.conversationType ?? 1
	let ts = 0
	try {
		if (data.lastMessageTime) {
			const parsed = new Date(data.lastMessageTime).getTime()
			ts = !isNaN(parsed) && parsed > 0 ? parsed : 0
		}
	} catch (e) {
		ts = 0
	}
    return {
      chatId: data.chatId != null ? data.chatId.toString() : '0',
      conversationType: conversationType,
      targetId: targetId,
      targetName: data.targetName || '',
      targetAvatar: data.targetAvatar || '',
      avatarText: data.avatarText || '',
      avatarBg: data.avatarBg || getConversationAvatarColor(conversationType, targetId),
      lastMessageType: data.lastMessageType != null ? Number(data.lastMessageType) : 0,
      lastMessageContent: data.lastMessageContent || '',
      lastMessageTime: ts > 0 ? this.formatTime(ts) : '',
      timestamp: ts,
      unreadCount: data.unreadCount || 0,
      lastMessageSequence: data.lastMessageSequence != null ? data.lastMessageSequence.toString() : '0',
      lastReadSequence: data.lastReadSequence != null ? data.lastReadSequence.toString() : '0',
      isPinned: data.isPinned || false,
      noDisturb: data.noDisturb || false,
      draft: data.draft || '',
      groupMemberCount: data.groupMemberCount || 0
    }
  }
  
  /**
   * 添加更新监听器
   */
  public addUpdateListener(listener: ConversationUpdateListener): void {
    this.updateListeners.push(listener)
  }
  
  /**
   * 移除更新监听器
   */
  public removeUpdateListener(listener: ConversationUpdateListener): void {
    const index = this.updateListeners.indexOf(listener)
    if (index !== -1) {
      this.updateListeners.splice(index, 1)
    }
  }
  
  /**
   * 通知更新监听器
   */
  private notifyUpdateListeners(): void {
    this.updateListeners.forEach((listener) => {
      try {
        listener(this.conversations)
      } catch (e) {
        console.error('[ConversationService] 更新监听器执行失败:', e)
      }
    })
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    this.conversations = []
    this.loaded = false
  }
}

/**
 * 导出单例实例
 */
export const conversationService = ConversationService.getInstance()
