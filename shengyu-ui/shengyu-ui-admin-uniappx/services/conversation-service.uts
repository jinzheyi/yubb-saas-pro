/**
 * 会话服务
 * 
 * 功能:
 * 1. 会话列表管理
 * 2. 会话操作（置顶、删除、免打扰、清空未读）
 * 3. 会话更新和排序
 * 4. 已读未读管理
 * 5. 草稿管理
 */

import { request } from '@/utils/request.uts'
import { badgeService } from './badge-service.uts'
import { getConversationAvatarColor, getAvatarText } from '@/utils/avatar.uts'
import { getTenantIdStr, getUserIdStr } from '@/store/user.uts'

/**
 * 会话类型枚举
 * 与后端 ImConversationTypeEnum 保持一致
 */
export enum ConversationType {
  SINGLE = 1,  // 单聊
  GROUP = 2    // 群聊
}

/**
 * 会话项（用于 UI 显示）
 * 字段名与后端 AppImConversationRespVO 保持一致
 */
export type ConversationItem = {
  chatId: string              // 对应后端 chatId
  conversationType: number     // 对应后端 conversationType (1-单聊 2-群聊)
  targetId: string            // 对应后端 targetId
  targetName: string          // 对应后端 targetName
  targetAvatar: string        // 对应后端 targetAvatar
  avatarText: string           // 头像文字
  avatarBg: string            // 头像背景色
  lastMessageType: number      // 对应后端 lastMessageType
  lastMessageContent: string  // 对应后端 lastMessageContent
  lastMessageHasAtMe: boolean // 对应后端 lastMessageHasAtMe
  lastMessageTime: string     // 对应后端 lastMessageTime (格式化后)
  timestamp: number           // 时间戳（用于排序）
  unreadCount: number         // 对应后端 unreadCount
  lastMessageSequence: string // 对应后端 lastMessageSequence（服务端权威水位）
  lastReadSequence: string    // 对应后端 lastReadSequence（服务端权威水位）
  isPinned: boolean           // 对应后端 isPinned
  noDisturb: boolean          // 对应后端 noDisturb
  draft: string               // 草稿
  groupMemberCount: number    // 对应后端 groupMemberCount

  conversationVersion?: string // 端侧幂等/乱序保护用（服务端单会话版本）
}

/**
 * 会话更新监听器类型
 */
export type ConversationUpdateListener = (conversations: ConversationItem[]) => void

/**
 * 会话服务类（单例模式）
 */
export class ConversationService {
  
  private static instance: ConversationService | null = null
  
  // 会话列表缓存
  private conversations: ConversationItem[] = []

  private loaded: boolean = false

  private targetChatIdCache: Map<string, string> = new Map()
  private manualUnreadChatIds: Set<string> = new Set()
  private manualUnreadLoaded: boolean = false
  
  // 会话更新监听器列表
  private updateListeners: ConversationUpdateListener[] = []

  private lastGapSyncAt: number = 0
  private incrementalSyncInFlight: boolean = false
  private incrementalSyncPending: boolean = false
  private incrementalSyncPendingReset: boolean = false
  private incrementalSyncPendingLimit: number = 200

  private normalizeTimestampMs(raw: any): number {
    try {
      if (raw == null) {
        return 0
      }
      if (typeof raw === 'number') {
        if (!isFinite(raw) || raw <= 0) {
          return 0
        }
        const ms = raw < 100000000000 ? raw * 1000 : raw
        if (ms < 946684800000) {
          return 0
        }
        return Math.floor(ms)
      }
      const text = String(raw).trim()
      if (text === '') {
        return 0
      }
      if (/^[0-9]+$/.test(text)) {
        const numVal = Number(text)
        if (!isFinite(numVal) || numVal <= 0) {
          return 0
        }
        const ms = text.length <= 10 ? numVal * 1000 : numVal
        if (ms < 946684800000) {
          return 0
        }
        return Math.floor(ms)
      }
      const parsed = new Date(text).getTime()
      if (isNaN(parsed) || parsed <= 0 || parsed < 946684800000) {
        return 0
      }
      return parsed
    } catch (e) {
      return 0
    }
  }

  private buildAvatarText(targetName: string, targetId: string): string {
    const name = targetName != null ? String(targetName).trim() : ''
    if (name !== '') {
      return getAvatarText(name)
    }
    const idText = targetId != null ? String(targetId).trim() : ''
    if (idText !== '' && idText !== '0') {
      return getAvatarText(idText)
    }
    return '?'
  }

  private isInvalidSingleTargetId(targetId: string): boolean {
    const tid = targetId != null ? String(targetId).trim() : ''
    if (tid === '' || tid === '0') {
      return true
    }
    if (tid.indexOf('sid:') === 0 || tid.indexOf('sid%3A') === 0 || tid.indexOf('sid%253A') === 0) {
      return true
    }
    return false
  }

  private shouldKeepConversation(conv: ConversationItem | null): boolean {
    if (conv == null) {
      return false
    }
    const chatId = conv.chatId != null ? String(conv.chatId).trim() : ''
    if (chatId === '' || chatId === '0') {
      return false
    }
    const conversationType = Number(conv.conversationType)
    const targetId = conv.targetId != null ? String(conv.targetId).trim() : ''
    const targetName = conv.targetName != null ? String(conv.targetName).trim() : ''
    if (conversationType === ConversationType.SINGLE) {
      if (this.isInvalidSingleTargetId(targetId)) {
        return false
      }
      if (targetName === '') {
        return false
      }
    }
    if (conversationType === ConversationType.GROUP && (targetId === '' || targetId === '0')) {
      return false
    }
    return true
  }

  private logInvalidConversation(source: string, conv: ConversationItem | null): void {
    try {
      console.warn('[ConversationService] skip invalid conversation:', {
        source: source,
        chatId: conv != null ? conv.chatId : '',
        conversationType: conv != null ? conv.conversationType : 0,
        targetId: conv != null ? conv.targetId : '',
        targetName: conv != null ? conv.targetName : ''
      })
    } catch (e) {
      // ignore
    }
  }

  private normalizeCursorVersion(v: string | number | null): string {
    if (v == null) {
      return '0'
    }
    const s = String(v)
    if (s === '') {
      return '0'
    }
    // 仅允许纯数字，避免 NaN/空白等异常写入
    return /^[0-9]+$/.test(s) ? s : '0'
  }

  private isCursorGreater(a: string, b: string): boolean {
    const av = a != null && a !== '' ? a.toString() : '0'
    const bv = b != null && b !== '' ? b.toString() : '0'
    try {
      return BigInt(av) > BigInt(bv)
    } catch (e) {
      if (av.length !== bv.length) {
        return av.length > bv.length
      }
      return av > bv
    }
  }

  private isCursorEqual(a: string, b: string): boolean {
    return (a != null ? a.toString() : '0') === (b != null ? b.toString() : '0')
  }

  private addCursorOne(v: string): string {
    const s = v != null && v !== '' ? v.toString() : '0'
    try {
      return (BigInt(s) + BigInt(1)).toString()
    } catch (e) {
      // 极端兜底：无法加 1 时返回原值
      return s
    }
  }

  private isSeqGreater(a: string, b: string): boolean {
    const av = a != null && a !== '' ? a.toString() : '0'
    const bv = b != null && b !== '' ? b.toString() : '0'
    try {
      return BigInt(av) > BigInt(bv)
    } catch (e) {
      return av > bv
    }
  }

  private maxSeq(a: string, b: string): string {
    return this.isSeqGreater(a, b) ? (a != null && a !== '' ? a.toString() : '0') : (b != null && b !== '' ? b.toString() : '0')
  }

  private computeUnreadCount(lastMessageSequence: string, lastReadSequence: string): number {
    const lastMsgSeq = lastMessageSequence != null && lastMessageSequence !== '' ? lastMessageSequence.toString() : '0'
    const lastReadSeq = lastReadSequence != null && lastReadSequence !== '' ? lastReadSequence.toString() : '0'
    try {
      const diff = BigInt(lastMsgSeq) - BigInt(lastReadSeq)
      return diff > BigInt(0) ? Number(diff) : 0
    } catch (e) {
      // BigInt 不可用或序列号非纯数字时，禁止使用 parseInt/Number 做兜底（可能触发精度丢失）
      // 这里仅做“是否存在未读”的保守判断，避免 badge/未读状态错乱
      if (lastMsgSeq === lastReadSeq) {
        return 0
      }
      if (lastMsgSeq.length !== lastReadSeq.length) {
        return lastMsgSeq.length > lastReadSeq.length ? 1 : 0
      }
      return lastMsgSeq > lastReadSeq ? 1 : 0
    }
  }

  private buildCursorStorageKey(): string {
    const tenantId = getTenantIdStr()
    const userId = getUserIdStr()
    return `IM_CONV_CURSOR_${tenantId}_${userId}`
  }

  private buildManualUnreadStorageKey(): string {
    const tenantId = getTenantIdStr()
    const userId = getUserIdStr()
    return `IM_MANUAL_UNREAD_${tenantId}_${userId}`
  }

  private ensureManualUnreadLoaded(): void {
    if (this.manualUnreadLoaded) {
      return
    }
    try {
      const raw = uni.getStorageSync(this.buildManualUnreadStorageKey())
      if (raw != null && raw !== '') {
        const parsed = JSON.parse(String(raw))
        if (Array.isArray(parsed)) {
          this.manualUnreadChatIds = new Set(parsed.map((id: any) => String(id)))
        }
      }
    } catch (e) {
      this.manualUnreadChatIds = new Set()
    } finally {
      this.manualUnreadLoaded = true
    }
  }

  private persistManualUnreadChatIds(): void {
    this.ensureManualUnreadLoaded()
    try {
      uni.setStorageSync(this.buildManualUnreadStorageKey(), JSON.stringify(Array.from(this.manualUnreadChatIds)))
    } catch (e) {
      // ignore
    }
  }

  private hasManualUnread(chatId: string): boolean {
    this.ensureManualUnreadLoaded()
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (chatIdStr === '') {
      return false
    }
    return this.manualUnreadChatIds.has(chatIdStr)
  }

  private setManualUnreadState(chatId: string, unread: boolean): void {
    this.ensureManualUnreadLoaded()
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (chatIdStr === '') {
      return
    }
    const had = this.manualUnreadChatIds.has(chatIdStr)
    if (unread) {
      if (!had) {
        this.manualUnreadChatIds.add(chatIdStr)
        this.persistManualUnreadChatIds()
      }
      return
    }
    if (had) {
      this.manualUnreadChatIds.delete(chatIdStr)
      this.persistManualUnreadChatIds()
    }
  }

  private applyManualUnreadOverlay(conversation: ConversationItem | null): void {
    if (conversation == null) {
      return
    }
    const chatIdStr = conversation.chatId != null ? conversation.chatId.toString() : ''
    if (chatIdStr === '') {
      return
    }
    const serverUnread = this.computeUnreadCount(
      conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0',
      conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    )
    if (serverUnread > 0) {
      conversation.unreadCount = serverUnread
      this.setManualUnreadState(chatIdStr, false)
      return
    }
    if (this.hasManualUnread(chatIdStr)) {
      conversation.unreadCount = 1
      return
    }
    conversation.unreadCount = 0
  }

  public handleRealtimeCursorVersion(cursorVersion: string | number | null): void {
    const incoming = this.normalizeCursorVersion(cursorVersion)
    if (incoming === '0') {
      return
    }
    const stored = this.getStoredCursorVersion()
    if (!this.isCursorGreater(incoming, stored)) {
      return
    }
    const now = Date.now()
    // gap：触发补偿 sync，但不要推进本地 cursor，避免跳过缺失版本
    const storedPlusOne = this.addCursorOne(stored)
    if (stored !== '0' && this.isCursorGreater(incoming, storedPlusOne)) {
      if (now - this.lastGapSyncAt > 800) {
        this.lastGapSyncAt = now
        void this.syncConversationsIncrementally(false)
      }
      return
    }
    // no gap：可以安全推进
    this.setStoredCursorVersion(incoming)
  }

  private getStoredCursorVersion(): string {
    try {
      const key = this.buildCursorStorageKey()
      const v = uni.getStorageSync(key)
      return this.normalizeCursorVersion(v as any)
    } catch (e) {
      return '0'
    }
  }

  private setStoredCursorVersion(cursorVersion: string): void {
    try {
      const key = this.buildCursorStorageKey()
      const v = this.normalizeCursorVersion(cursorVersion)
      uni.setStorageSync(key, v)
    } catch (e) {
      // ignore
    }
  }
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }

  public upsertFromSnapshot(
    snapshot: any,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): string | null {
    if (snapshot == null) {
      return null
    }

    const conv = this.mapToConversationItem(snapshot)
    if (conv.chatId == null || conv.chatId === '' || conv.chatId === '0') {
      return null
    }
    if (!this.shouldKeepConversation(conv)) {
      this.logInvalidConversation('snapshot', conv)
      return null
    }

    if (conv.targetId != null && conv.targetId !== '' && conv.conversationType != null) {
      this.cacheTargetChatId(conv.targetId, conv.conversationType, conv.chatId)
    }

    const existing = this.getConversation(conv.chatId)
    if (existing == null) {
      this.conversations.unshift(conv)
      this.applyManualUnreadOverlay(conv)
    } else {
	  // P2：幂等/乱序保护（旧 snapshot 不覆盖新状态）
	  const incomingVer = (snapshot as any).conversationVersion != null ? (snapshot as any).conversationVersion.toString() : ''
	  const currentVer = (existing as any).conversationVersion != null ? (existing as any).conversationVersion.toString() : ''
	  if (incomingVer !== '' && currentVer !== '') {
		let shouldApply = true
		try {
			shouldApply = BigInt(incomingVer) > BigInt(currentVer)
		} catch (e) {
			shouldApply = incomingVer > currentVer
		}
		if (!shouldApply) {
			return existing.chatId
		}
	  }
	  ;(existing as any).conversationVersion = incomingVer !== '' ? incomingVer : (existing as any).conversationVersion
      existing.targetId = conv.targetId
      existing.targetName = conv.targetName
      existing.targetAvatar = conv.targetAvatar
      existing.avatarText = conv.avatarText
      existing.avatarBg = conv.avatarBg
      existing.groupMemberCount = conv.groupMemberCount
      existing.isPinned = conv.isPinned
      existing.noDisturb = conv.noDisturb
      existing.lastMessageHasAtMe = conv.lastMessageHasAtMe
      existing.lastReadSequence = this.maxSeq(existing.lastReadSequence, conv.lastReadSequence)
	      existing.lastMessageSequence = this.maxSeq(existing.lastMessageSequence, conv.lastMessageSequence)
	      existing.unreadCount = this.computeUnreadCount(existing.lastMessageSequence, existing.lastReadSequence)
	      existing.lastMessageType = conv.lastMessageType
	      existing.lastMessageContent = conv.lastMessageContent
	      existing.lastMessageTime = conv.lastMessageTime
	      existing.timestamp = conv.timestamp
        this.applyManualUnreadOverlay(existing)
	    }

    const preview = conv.lastMessageContent != null && conv.lastMessageContent !== '' ? conv.lastMessageContent : lastMessage
    const ts = timestamp != null && timestamp > 0 ? timestamp : conv.timestamp
    this.updateConversation(conv.chatId, conv.lastMessageType, preview, ts, incrementUnread, messageSequence)
    return conv.chatId
  }

  private buildTargetKey(targetId: string, conversationType: number): string {
    const t = targetId != null ? (targetId as any).toString() : ''
    return `${conversationType}_${t}`
  }

  public getCachedChatIdByTarget(targetId: string, conversationType: number): string | null {
    const key = this.buildTargetKey(targetId, conversationType)
    const cached = this.targetChatIdCache.get(key)
    return cached != null && cached !== '' ? cached : null
  }

  private cacheTargetChatId(targetId: string, conversationType: number, chatId: string): void {
    if (targetId == null || targetId === '' || chatId == null || chatId === '') {
      return
    }
    const key = this.buildTargetKey(targetId, conversationType)
    this.targetChatIdCache.set(key, chatId)
  }

  public async ensureConversationByTarget(
    targetId: string,
    conversationType: number,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): Promise<string | null> {
    const cachedChatId = this.getCachedChatIdByTarget(targetId, conversationType)
    if (cachedChatId != null) {
      return cachedChatId
    }

    try {
      const targetIdStr = targetId != null ? (targetId as any).toString() : ''
      const data = await request({
        url: `/system/im/conversation/get-by-target?targetId=${targetIdStr}&conversationType=${conversationType}`,
        method: 'GET'
      })
      if (data == null) {
        return null
      }
      const conv = this.mapToConversationItem(data as any)
      if (!this.shouldKeepConversation(conv)) {
        this.logInvalidConversation('ensure-by-target', conv)
        return null
      }
      if (conv.chatId != null && conv.chatId !== '') {
        this.cacheTargetChatId(targetIdStr, conversationType, conv.chatId)
      }

      const existing = this.getConversation(conv.chatId)
      if (existing == null) {
        this.conversations.unshift(conv)
        this.applyManualUnreadOverlay(conv)
      }

      const preview = conv.lastMessageContent != null && conv.lastMessageContent !== '' ? conv.lastMessageContent : lastMessage
      const ts = timestamp != null && timestamp > 0 ? timestamp : conv.timestamp
      this.updateConversation(conv.chatId, conv.lastMessageType, preview, ts, incrementUnread, messageSequence)
      return conv.chatId
    } catch (e) {
      console.error('[ConversationService] ensureConversationByTarget 失败:', e)
      return null
    }
  }

  public applyReadWatermark(chatId: string, readSequence: string): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    if (conversation == null) {
      return
    }
    const seq = readSequence != null && readSequence !== '' ? readSequence.toString() : '0'
    const currentRead = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    let shouldUpdate = false
    try {
      shouldUpdate = BigInt(seq) > BigInt(currentRead)
    } catch (e) {
      shouldUpdate = seq > currentRead
    }
    if (shouldUpdate) {
      conversation.lastReadSequence = seq
    }
    const lastMsgSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
    const lastReadSeq = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    let unread = 0
    try {
      const diff = BigInt(lastMsgSeq) - BigInt(lastReadSeq)
      unread = diff > BigInt(0) ? Number(diff) : 0
    } catch (e) {
      if (lastMsgSeq === lastReadSeq) {
        unread = 0
      } else if (lastMsgSeq.length !== lastReadSeq.length) {
        unread = lastMsgSeq.length > lastReadSeq.length ? 1 : 0
      } else {
        unread = lastMsgSeq > lastReadSeq ? 1 : 0
      }
    }
    conversation.unreadCount = unread
    this.setManualUnreadState(chatIdStr, false)
    const readSeq = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
    const msgSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
    let shouldClearAtMe = false
    try {
      shouldClearAtMe = BigInt(readSeq) >= BigInt(msgSeq)
    } catch (e) {
      if (readSeq.length !== msgSeq.length) {
        shouldClearAtMe = readSeq.length > msgSeq.length
      } else {
        shouldClearAtMe = readSeq >= msgSeq
      }
    }
    if (shouldClearAtMe) {
      conversation.lastMessageHasAtMe = false
    }
    this.sortConversations()
    this.notifyUpdateListeners()
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): ConversationService {
    if (ConversationService.instance === null) {
      ConversationService.instance = new ConversationService()
    }
    return ConversationService.instance
  }
  
  /**
   * 从服务器加载会话列表
   */
  public async loadConversations(): Promise<void> {
    try {
      const stored = this.getStoredCursorVersion()
      const shouldReset = stored === '0'
      await this.syncConversationsIncrementally(shouldReset)
    } catch (e) {
      try {
        const data = await request({
          url: '/system/im/conversation/list',
          method: 'GET'
        })

        if (data != null) {
          this.conversations = (data as any[]).map((item: any) => {
            const conv = this.mapToConversationItem(item)
            this.applyManualUnreadOverlay(conv)
            return conv
          }).filter((conv: ConversationItem) => {
            const keep = this.shouldKeepConversation(conv)
            if (!keep) {
              this.logInvalidConversation('list', conv)
            }
            return keep
          })
        } else {
          this.conversations = []
        }
        this.conversations.forEach(c => {
          if (c != null && c.targetId != null && c.targetId !== '' && c.chatId != null && c.chatId !== '') {
            this.cacheTargetChatId(c.targetId, c.conversationType, c.chatId)
          }
        })
        this.sortConversations()
        this.notifyUpdateListeners()
      } catch (e2) {
        console.error('[ConversationService] 加载会话列表失败:', e2)
      }
    } finally {
      this.loaded = true
    }
  }

  public async syncConversationsIncrementally(reset: boolean = false, limit: number = 200): Promise<void> {
    const pageSize = limit != null && limit > 0 ? Math.min(limit, 200) : 200
    if (this.incrementalSyncInFlight) {
      this.incrementalSyncPending = true
      this.incrementalSyncPendingReset = this.incrementalSyncPendingReset || reset
      this.incrementalSyncPendingLimit = Math.max(this.incrementalSyncPendingLimit, pageSize)
      return
    }

    this.incrementalSyncInFlight = true
    let nextRunReset = reset
    let nextRunLimit = pageSize
    try {
      while (true) {
        const storedCursor = this.getStoredCursorVersion()
        const shouldForceReset = nextRunReset !== true && (this.conversations == null || this.conversations.length === 0) && storedCursor !== '0'
        let cursor = (nextRunReset || shouldForceReset) ? '0' : storedCursor
        let hasMore = true
        let maxCursor = cursor
        while (hasMore) {
          const data = await request({
            url: `/system/im/conversation/sync?cursorVersion=${cursor}&limit=${nextRunLimit}`,
            method: 'GET'
          })
          const nextCursorVersion = data != null && (data as any).nextCursorVersion != null
            ? this.normalizeCursorVersion((data as any).nextCursorVersion)
            : cursor
          const items: any[] = data != null && Array.isArray((data as any).items) ? (data as any).items : []
          hasMore = data != null && (data as any).hasMore === true

          if (this.isCursorGreater(nextCursorVersion, maxCursor)) {
            maxCursor = nextCursorVersion
          }

          if (items.length > 0) {
            items.forEach((it: any) => {
              if (it == null) {
                return
              }
              const chatId = it.chatId != null ? it.chatId.toString() : '0'
              const deletedByUser = it.deletedByUser === true
              if (deletedByUser) {
                const idx = this.conversations.findIndex(c => c.chatId === chatId || ((c as any).id === chatId))
                if (idx !== -1) {
                  const removed = this.conversations[idx]
                  try {
                    if (removed != null && removed.targetId != null && removed.targetId !== '') {
                      const key = this.buildTargetKey(removed.targetId, removed.conversationType)
                      this.targetChatIdCache.delete(key)
                    }
                  } catch (e) {
                    // ignore
                  }
                  this.conversations.splice(idx, 1)
                }
                return
              }

              const conv = this.mapToConversationItem(it)
              if (!this.shouldKeepConversation(conv)) {
                this.logInvalidConversation('sync', conv)
                return
              }
              if (conv != null && conv.targetId != null && conv.targetId !== '' && conv.chatId != null && conv.chatId !== '') {
                this.cacheTargetChatId(conv.targetId, conv.conversationType, conv.chatId)
              }

	              const existing = this.getConversation(chatId)
	              if (existing == null) {
	                this.conversations.unshift(conv)
                  this.applyManualUnreadOverlay(conv)
	              } else {
			  // 幂等/乱序保护（旧数据不覆盖新状态）
			  const incomingVer = (it as any).conversationVersion != null ? (it as any).conversationVersion.toString() : ''
			  const currentVer = (existing as any).conversationVersion != null ? (existing as any).conversationVersion.toString() : ''
			  if (incomingVer !== '' && currentVer !== '') {
				  let shouldApply = true
				  try {
					  shouldApply = BigInt(incomingVer) > BigInt(currentVer)
				  } catch (e) {
					  shouldApply = incomingVer > currentVer
				  }
				  if (!shouldApply) {
					  return
				  }
			  }
			  ;(existing as any).conversationVersion = incomingVer !== '' ? incomingVer : (existing as any).conversationVersion
                existing.conversationType = conv.conversationType
                existing.targetId = conv.targetId
                existing.targetName = conv.targetName
                existing.targetAvatar = conv.targetAvatar
                existing.avatarText = conv.avatarText
                existing.avatarBg = conv.avatarBg
                existing.groupMemberCount = conv.groupMemberCount
                existing.isPinned = conv.isPinned
                existing.noDisturb = conv.noDisturb
                existing.lastMessageHasAtMe = conv.lastMessageHasAtMe
                existing.draft = conv.draft
			  existing.lastReadSequence = this.maxSeq(existing.lastReadSequence, conv.lastReadSequence)
			  existing.lastMessageSequence = this.maxSeq(existing.lastMessageSequence, conv.lastMessageSequence)
				  existing.unreadCount = this.computeUnreadCount(existing.lastMessageSequence, existing.lastReadSequence)
	                existing.lastMessageType = conv.lastMessageType
	                existing.lastMessageContent = conv.lastMessageContent
	                existing.lastMessageTime = conv.lastMessageTime
	                existing.timestamp = conv.timestamp
                  this.applyManualUnreadOverlay(existing)
	              }
	            })
          }

          cursor = nextCursorVersion
          if (!hasMore) {
            break
          }
        }

        this.setStoredCursorVersion(maxCursor)
        this.sortConversations()
        this.notifyUpdateListeners()

        if (!this.incrementalSyncPending) {
          break
        }
        nextRunReset = this.incrementalSyncPendingReset
        nextRunLimit = this.incrementalSyncPendingLimit
        this.incrementalSyncPending = false
        this.incrementalSyncPendingReset = false
        this.incrementalSyncPendingLimit = 200
      }
    } finally {
      this.incrementalSyncInFlight = false
      this.incrementalSyncPending = false
      this.incrementalSyncPendingReset = false
      this.incrementalSyncPendingLimit = 200
    }
  }
  
  /**
   * 获取会话列表
   */
  public getConversations(): ConversationItem[] {
    return this.conversations
  }
  
  /**
   * 获取单个会话
   */
  public getConversation(chatId: string): ConversationItem | null {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    return conversation != null ? conversation : null
  }
  
  /**
   * 更新会话（接收到新消息时调用）
   */
  public updateConversation(
    chatId: string,
    lastMessageType: number,
    lastMessage: string,
    timestamp: number,
    incrementUnread: boolean = false,
    messageSequence: string | null = null
  ): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (!this.loaded) {
      void this.loadConversations()
      return
    }

    const seqStr = messageSequence != null ? messageSequence.toString() : ''
    const hasBizMessage = (seqStr !== '' && seqStr !== '0') || (lastMessage != null && lastMessage.toString().trim() !== '')
    if (hasBizMessage && (lastMessageType == null || (lastMessageType as any) === '' || (lastMessageType as any) === 0)) {
      console.warn('[ConversationService] lastMessageType 缺失，可能导致摘要不准确:', chatIdStr, lastMessage)
    }

    let conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    // 兼容调用方传入 targetId 的情况（群聊：groupId；单聊：对方 userId）
    if (conversation == null) {
      conversation = this.conversations.find(c => c.targetId === chatIdStr)
    }
    
	    if (conversation != null) {
      // 更新现有会话
      conversation.lastMessageType = lastMessageType
      conversation.lastMessageContent = lastMessage
      conversation.timestamp = timestamp

	  if (timestamp != null && timestamp > 0 && !isNaN(timestamp)) {
		  conversation.lastMessageTime = this.formatTime(timestamp)
	  } else {
		  conversation.lastMessageTime = ''
	  }

      if (messageSequence != null && messageSequence !== '') {
        const newSeq = messageSequence.toString()
        const currentSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
        let shouldUpdate = false
        try {
          shouldUpdate = BigInt(newSeq) > BigInt(currentSeq)
        } catch (e) {
          shouldUpdate = newSeq > currentSeq
        }
        if (shouldUpdate) {
          conversation.lastMessageSequence = newSeq
        }
      }
      
	      if (incrementUnread) {
        const lastMsgSeq = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
        const lastReadSeq = conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
        let unread = 0
        try {
          const diff = BigInt(lastMsgSeq) - BigInt(lastReadSeq)
          unread = diff > BigInt(0) ? Number(diff) : 0
        } catch (e) {
          if (lastMsgSeq === lastReadSeq) {
            unread = 0
          } else if (lastMsgSeq.length !== lastReadSeq.length) {
            unread = lastMsgSeq.length > lastReadSeq.length ? 1 : 0
          } else {
            unread = lastMsgSeq > lastReadSeq ? 1 : 0
          }
        }
	        conversation.unreadCount = unread
	      }
        this.applyManualUnreadOverlay(conversation)
	    } else {
	      console.warn('[ConversationService] 会话不存在，触发增量同步兜底:', chatIdStr)
        if (this.loaded) {
          void this.syncConversationsIncrementally(false)
        } else {
          void this.loadConversations()
        }
	      return
	    }
    
    this.sortConversations()
    this.notifyUpdateListeners()
  }
  
  /**
   * 置顶会话
   */
  public async pinConversation(chatId: string, isPinned: boolean): Promise<boolean> {
    try {
      const chatIdStr = chatId != null ? (chatId as any).toString() : ''
      const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
      if (conversation != null && conversation.isPinned === isPinned) {
        return true
      }
      await request({
        url: '/system/im/conversation/update',
        method: 'PUT',
        data: {
          chatId: chatIdStr,
          isPinned: isPinned
        }
      })

      if (conversation != null) {
        conversation.isPinned = isPinned
        this.sortConversations()
        this.notifyUpdateListeners()
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 置顶会话失败:', e)
      return false
    }
  }
  
  /**
   * 删除会话
   */
  public async deleteConversation(chatId: string): Promise<boolean> {
    try {
      const chatIdStr = chatId != null ? (chatId as any).toString() : ''
      await request({
        url: `/system/im/conversation/delete?chatId=${chatIdStr}`,
        method: 'DELETE'
      })
      this.removeConversationLocal(chatIdStr)
      return true
    } catch (e) {
      console.error('[ConversationService] 删除会话失败:', e)
      return false
    }
  }

  public removeConversationLocal(chatId: string): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (chatIdStr === '') {
      return
    }
    const index = this.conversations.findIndex(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    if (index === -1) {
      return
    }
    this.setManualUnreadState(chatIdStr, false)
    const removed = this.conversations[index]
    try {
      if (removed != null && removed.targetId != null && removed.targetId !== '') {
        const key = this.buildTargetKey(removed.targetId, removed.conversationType)
        this.targetChatIdCache.delete(key)
      }
    } catch (e) {
      // ignore
    }
    this.conversations.splice(index, 1)
    this.notifyUpdateListeners()
  }
  
  /**
   * 设置免打扰
   */
  public async setMute(chatId: string, noDisturb: boolean): Promise<boolean> {
    try {
      const chatIdStr = chatId != null ? (chatId as any).toString() : ''
      const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
      if (conversation != null && conversation.noDisturb === noDisturb) {
        return true
      }
      await request({
        url: '/system/im/conversation/update',
        method: 'PUT',
        data: {
          chatId: chatIdStr,
          noDisturb: noDisturb
        }
      })

      if (conversation != null) {
        conversation.noDisturb = noDisturb
        this.notifyUpdateListeners()
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 设置免打扰失败:', e)
      return false
    }
  }
  
  /**
   * 清空未读数
   */
  public async clearUnread(chatId: string): Promise<boolean> {
    try {
      const conversation = this.conversations.find(c => c.chatId === chatId)
      const seq = conversation != null && (conversation as any).lastMessageSequence != null
        ? (conversation as any).lastMessageSequence.toString()
        : '0'

      badgeService.clearConversationBadge(chatId, seq)

	      if (conversation != null) {
	        conversation.unreadCount = 0
          this.setManualUnreadState(chatId, false)
	        this.notifyUpdateListeners()

        // 同步清空角标
        // badgeService 已在上面触发服务端水位推进
      }
      return true
    } catch (e) {
      console.error('[ConversationService] 清空未读数失败:', e)
      return false
    }
  }

  public clearUnreadLocal(chatId: string): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (chatIdStr === '') {
      return
    }
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    if (conversation == null) {
      return
    }
    conversation.unreadCount = 0
    this.setManualUnreadState(chatIdStr, false)
    const lastMessageSequence = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
    conversation.lastReadSequence = lastMessageSequence
    this.notifyUpdateListeners()
  }

  public markConversationUnread(chatId: string, unread: boolean): void {
    const chatIdStr = chatId != null ? (chatId as any).toString() : ''
    if (chatIdStr === '') {
      return
    }
    const conversation = this.conversations.find(c => c.chatId === chatIdStr || ((c as any).id === chatIdStr))
    this.setManualUnreadState(chatIdStr, unread)
    if (conversation != null) {
      const serverUnread = this.computeUnreadCount(
        conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0',
        conversation.lastReadSequence != null ? conversation.lastReadSequence.toString() : '0'
      )
      conversation.unreadCount = unread && serverUnread <= 0 ? 1 : serverUnread
      this.applyManualUnreadOverlay(conversation)
    }
    this.notifyUpdateListeners()
  }

  public applyBadgeSnapshot(conversationBadges: Map<string, number>): void {
    if (conversationBadges == null || this.conversations.length === 0) {
      return
    }
    let changed = false
    this.conversations.forEach((conversation) => {
      if (conversation == null || conversation.chatId == null || conversation.chatId === '') {
        return
      }
      const chatId = conversation.chatId.toString()
      const serverUnread = conversationBadges.get(chatId) || 0
      if (serverUnread > 0) {
        this.setManualUnreadState(chatId, false)
        if (conversation.unreadCount !== serverUnread) {
          conversation.unreadCount = serverUnread
          changed = true
        }
        return
      }
      const lastMessageSequence = conversation.lastMessageSequence != null ? conversation.lastMessageSequence.toString() : '0'
      if (conversation.lastReadSequence !== lastMessageSequence) {
        conversation.lastReadSequence = lastMessageSequence
        changed = true
      }
      const nextUnread = this.hasManualUnread(chatId) ? 1 : 0
      if (conversation.unreadCount !== nextUnread) {
        conversation.unreadCount = nextUnread
        changed = true
      }
    })
    if (changed) {
      this.notifyUpdateListeners()
    }
  }
  
  /**
   * 保存草稿
   */
  public saveDraft(chatId: string, draft: string): void {
    const conversation = this.conversations.find(c => c.chatId === chatId)
    if (conversation != null) {
      conversation.draft = draft
      this.notifyUpdateListeners()
    }
  }
  
  /**
   * 获取草稿
   */
  public getDraft(chatId: string): string {
    const conversation = this.conversations.find(c => c.chatId === chatId)
    return conversation != null ? conversation.draft : ''
  }
  
  /**
   * 会话排序（置顶优先，按时间倒序）
   */
  private sortConversations(): void {
    this.conversations.sort((a, b) => {
      // 置顶的会话排在前面
      if (a.isPinned !== b.isPinned) {
        return a.isPinned ? -1 : 1
      }
      // 按时间戳降序排序
      return b.timestamp - a.timestamp
    })
  }
  
  /**
   * 格式化时间
   */
  private formatTime(timestamp: number): string {
    const now = Date.now()
    const diff = now - timestamp
    const oneDay = 24 * 60 * 60 * 1000
    
    if (diff < 60 * 1000) {
      return '刚刚'
    } else if (diff < 60 * 60 * 1000) {
      return Math.floor(diff / (60 * 1000)) + '分钟前'
    } else if (diff < oneDay) {
      const date = new Date(timestamp)
      return date.getHours() + ':' + String(date.getMinutes()).padStart(2, '0')
    } else if (diff < 2 * oneDay) {
      return '昨天'
    } else if (diff < 7 * oneDay) {
      const days = ['日', '一', '二', '三', '四', '五', '六']
      const date = new Date(timestamp)
      return '星期' + days[date.getDay()]
    } else {
      const date = new Date(timestamp)
      return (date.getMonth() + 1) + '/' + date.getDate()
    }
  }
  
  /**
   * 映射服务器数据到会话项
   * 字段名与后端 AppImConversationRespVO 保持一致
   */
  private mapToConversationItem(data: any): ConversationItem {
    const targetId = data.targetId != null ? data.targetId.toString() : '0'
    const conversationType = data.conversationType ?? 1
    const ts = this.normalizeTimestampMs(data.lastMessageTime)
    const targetName = data.targetName != null ? String(data.targetName).trim() : ''
    const avatarText = data.avatarText != null && String(data.avatarText).trim() !== ''
      ? String(data.avatarText).trim()
      : this.buildAvatarText(targetName, targetId)
    let hasAtMe = false
    try {
      const v: any = (data as any).lastMessageHasAtMe
      if (v === true) {
        hasAtMe = true
      } else if (v === 1 || v === '1') {
        hasAtMe = true
      } else {
        hasAtMe = false
      }
    } catch (e) {
      hasAtMe = false
    }

    return {
      chatId: data.chatId != null ? data.chatId.toString() : '0',
      conversationType: conversationType,
      targetId: targetId,
      targetName: targetName,
      targetAvatar: data.targetAvatar || '',
      avatarText: avatarText,
      avatarBg: data.avatarBg || getConversationAvatarColor(conversationType, targetId),
      lastMessageType: data.lastMessageType != null ? Number(data.lastMessageType) : 0,
      lastMessageContent: data.lastMessageContent || '',
      lastMessageHasAtMe: hasAtMe,
      lastMessageTime: ts > 0 ? this.formatTime(ts) : '',
      timestamp: ts,
      unreadCount: data.unreadCount || 0,
      lastMessageSequence: data.lastMessageSequence != null ? data.lastMessageSequence.toString() : '0',
      lastReadSequence: data.lastReadSequence != null ? data.lastReadSequence.toString() : '0',
      isPinned: data.isPinned || false,
      noDisturb: data.noDisturb || false,
      draft: data.draft || '',
      groupMemberCount: data.groupMemberCount || 0,
	  conversationVersion: data.conversationVersion != null ? data.conversationVersion.toString() : null
    }
  }
  
  /**
   * 添加更新监听器
   */
  public addUpdateListener(listener: ConversationUpdateListener): void {
    this.updateListeners.push(listener)
  }
  
  /**
   * 移除更新监听器
   */
  public removeUpdateListener(listener: ConversationUpdateListener): void {
    const index = this.updateListeners.indexOf(listener)
    if (index !== -1) {
      this.updateListeners.splice(index, 1)
    }
  }
  
  /**
   * 通知更新监听器
   */
  private notifyUpdateListeners(): void {
    this.updateListeners.forEach((listener) => {
      try {
        listener(this.conversations)
      } catch (e) {
        console.error('[ConversationService] 更新监听器执行失败:', e)
      }
    })
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    try {
      const key = this.buildCursorStorageKey()
      uni.removeStorageSync(key)
    } catch (e) {
      // ignore
    }
    this.conversations = []
    this.targetChatIdCache.clear()
    this.manualUnreadChatIds.clear()
    this.manualUnreadLoaded = false
    this.loaded = false
    this.lastGapSyncAt = 0
    this.incrementalSyncInFlight = false
    this.incrementalSyncPending = false
    this.incrementalSyncPendingReset = false
    this.incrementalSyncPendingLimit = 200
    try {
      uni.removeStorageSync(this.buildManualUnreadStorageKey())
    } catch (e) {
      // ignore
    }
  }
}

/**
 * 导出单例实例
 */
export const conversationService = ConversationService.getInstance()
