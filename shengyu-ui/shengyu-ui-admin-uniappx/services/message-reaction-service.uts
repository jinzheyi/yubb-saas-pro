/**
 * 消息表情回应服务
 * 
 * 功能:
 * 1. 添加表情回应
 * 2. 取消表情回应
 * 3. 获取表情回应列表
 * 4. 表情回应合并显示
 */

import { request } from '@/utils/request.uts'

/**
 * 表情回应项
 */
export type ReactionItem = {
  emoji: string
  count: number
  userIds: number[]
  userNames: string[]
  isSelf: boolean
}

/**
 * 表情回应详情
 */
export type ReactionDetail = {
  messageId: number
  reactions: ReactionItem[]
}

/**
 * 常用表情列表
 */
export const COMMON_EMOJIS = [
  '👍', '❤️', '😄', '😂', '😮', '😢', '🙏', '👏'
]

/**
 * 消息表情回应服务类（单例模式）
 */
export class MessageReactionService {
  
  private static instance: MessageReactionService | null = null
  
  // 表情回应缓存（messageId -> ReactionDetail）
  private reactionCache: Map<number, ReactionDetail> = new Map()
  
  /**
   * 私有构造函数（单例模式）
   */
  private constructor() {
    // 初始化
  }
  
  /**
   * 获取单例实例
   */
  public static getInstance(): MessageReactionService {
    if (MessageReactionService.instance === null) {
      MessageReactionService.instance = new MessageReactionService()
    }
    return MessageReactionService.instance
  }
  
  /**
   * 添加表情回应
   */
  public async addReaction(messageId: number, emoji: string): Promise<boolean> {
    try {
      const response = await request({
        url: '/system/im-message/add-reaction',
        method: 'POST',
        data: {
          messageId: messageId,
          emoji: emoji
        }
      })
      
      if (response.code === 0) {
        // 清除缓存，强制重新加载
        this.reactionCache.delete(messageId)
        return true
      }
      return false
    } catch (e) {
      console.error('[MessageReactionService] 添加表情回应失败:', e)
      return false
    }
  }
  
  /**
   * 取消表情回应
   */
  public async removeReaction(messageId: number, emoji: string): Promise<boolean> {
    try {
      const response = await request({
        url: '/system/im-message/remove-reaction',
        method: 'POST',
        data: {
          messageId: messageId,
          emoji: emoji
        }
      })
      
      if (response.code === 0) {
        // 清除缓存，强制重新加载
        this.reactionCache.delete(messageId)
        return true
      }
      return false
    } catch (e) {
      console.error('[MessageReactionService] 取消表情回应失败:', e)
      return false
    }
  }
  
  /**
   * 获取消息的表情回应列表
   */
  public async getReactions(messageId: number): Promise<ReactionItem[]> {
    // 先从缓存获取
    const cached = this.reactionCache.get(messageId)
    if (cached !== null && cached !== undefined) {
      return cached.reactions
    }
    
    try {
      const response = await request({
        url: '/system/im-message/reactions',
        method: 'GET',
        params: {
          messageId: messageId
        }
      })
      
      if (response.code === 0 && response.data) {
        const reactions = this.mergeReactions(response.data)
        
        // 缓存结果
        this.reactionCache.set(messageId, {
          messageId: messageId,
          reactions: reactions
        })
        
        return reactions
      }
      return []
    } catch (e) {
      console.error('[MessageReactionService] 获取表情回应失败:', e)
      return []
    }
  }
  
  /**
   * 合并相同表情的回应
   */
  private mergeReactions(data: any[]): ReactionItem[] {
    const reactionMap: Map<string, ReactionItem> = new Map()
    
    data.forEach((item: any) => {
      const emoji = item.emoji
      const userId = item.userId
      const userName = item.userName || ''
      const isSelf = item.isSelf || false
      
      let reaction = reactionMap.get(emoji)
      if (reaction === null || reaction === undefined) {
        reaction = {
          emoji: emoji,
          count: 0,
          userIds: [],
          userNames: [],
          isSelf: false
        }
        reactionMap.set(emoji, reaction)
      }
      
      reaction.count++
      reaction.userIds.push(userId)
      reaction.userNames.push(userName)
      if (isSelf) {
        reaction.isSelf = true
      }
    })
    
    // 转换为数组并按数量排序
    const reactions: ReactionItem[] = []
    reactionMap.forEach((reaction) => {
      reactions.push(reaction)
    })
    
    reactions.sort((a, b) => b.count - a.count)
    
    return reactions
  }
  
  /**
   * 切换表情回应（如果已存在则取消，否则添加）
   */
  public async toggleReaction(messageId: number, emoji: string, currentIsSelf: boolean): Promise<boolean> {
    if (currentIsSelf) {
      // 已经回应过，取消回应
      return await this.removeReaction(messageId, emoji)
    } else {
      // 未回应过，添加回应
      return await this.addReaction(messageId, emoji)
    }
  }
  
  /**
   * 获取表情回应的用户列表文本
   */
  public getReactionUsersText(reaction: ReactionItem, maxUsers: number = 3): string {
    if (reaction.userNames.length === 0) {
      return ''
    }
    
    const names = reaction.userNames.slice(0, maxUsers)
    let text = names.join('、')
    
    if (reaction.userNames.length > maxUsers) {
      text += ` 等${reaction.userNames.length}人`
    }
    
    return text
  }
  
  /**
   * 格式化表情回应显示文本
   */
  public formatReactionText(reaction: ReactionItem): string {
    return `${reaction.emoji} ${reaction.count}`
  }
  
  /**
   * 清空缓存
   */
  public clearCache(): void {
    this.reactionCache.clear()
  }
  
  /**
   * 清空指定消息的表情回应缓存
   */
  public clearMessageReactions(messageId: number): void {
    this.reactionCache.delete(messageId)
  }
}

/**
 * 导出单例实例
 */
export const messageReactionService = MessageReactionService.getInstance()
