/**
 * 应用配置
 * 严格参考 PC 端 .env 文件配置
 */

/**
 * 验证码的开关
 * PC 端：VITE_APP_CAPTCHA_ENABLE=true
 * 
 * 使用说明：
 * - 'true'：启用验证码（账号登录时显示滑块验证码）
 * - 'false'：禁用验证码（直接登录，无需验证码）
 * 
 * 注意：手机号登录不使用滑块验证码，仅使用短信验证码
 */
export const CAPTCHA_ENABLE = 'true'

/**
 * 租户开关
 * PC 端：VITE_APP_TENANT_ENABLE=true
 * 
 * 使用说明：
 * - 'true'：启用租户功能（请求时自动添加 tenant-id 请求头）
 * - 'false'：禁用租户功能（不添加 tenant-id 请求头）
 * 
 * 注意：后端已做用户兼容多租户处理，前端登录时不需要调用获取租户 ID 接口
 */
export const TENANT_ENABLE = 'true'

/**
 * 默认租户名称
 */
export const DEFAULT_TENANT_NAME = '圣钰科技'

/**
 * API 基础地址（后端接口地址）
 * 根据实际部署环境修改
 * 
 * 注意：uniappx 的 image 组件不支持 localhost，开发时请使用本机 IP 地址
 * 例如：export const BASE_URL = 'http://192.168.1.100:48080'
 * 
 * 获取本机 IP 的方法：
 * - macOS/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
 * - Windows: ipconfig | findstr IPv4
 */
export const BASE_URL = 'http://localhost:48080'

/**
 * API 前缀配置
 * 
 * 后端路由规范：
 * - /admin-api/** → Web 管理后台（租户端）
 * - /app-api/** → 移动端 App（租户端）
 * - /platform-api/** → 平台端（独立模块）
 * 
 * 移动端统一使用 /app-api 前缀
 */
export const API_PREFIX = '/app-api'

/**
 * 完整的 API 地址（BASE_URL + API_PREFIX）
 * 移动端所有接口请求都应使用此地址
 */
export const API_BASE_URL = BASE_URL + API_PREFIX

/**
 * 移动端应用域名（前端页面地址）
 * 用于生成二维码、分享链接等场景
 * 
 * 使用说明：
 * - 开发环境：使用本机 IP 地址，如 'http://192.168.1.100:48080'
 * - 测试环境：使用测试域名，如 'https://app-test.shengyu.com'
 * - 生产环境：使用生产域名，如 'https://app.shengyu.com'
 * 
 * 注意：
 * - 此域名用于用户扫码后跳转到移动端页面
 * - 开发时建议使用本机 IP，方便其他设备访问
 * - 生产环境必须使用 HTTPS 协议
 */
export const ADMIN_APP_DOMAIN = 'http://169.254.81.175:5173/#'

/**
 * 请求超时时间（毫秒）
 */
export const TIMEOUT = 30000

/**
 * 文件上传大小限制（字节）
 */
export const MAX_FILE_SIZE = 100 * 1024 * 1024      // 100MB - 普通文件
export const MAX_IMAGE_SIZE = 10 * 1024 * 1024      // 10MB - 图片
export const MAX_VIDEO_SIZE = 100 * 1024 * 1024     // 100MB - 视频
export const MAX_VOICE_SIZE = 10 * 1024 * 1024      // 10MB - 语音

/**
 * 短信验证码倒计时（秒）
 */
export const SMS_CODE_COUNTDOWN = 60

/**
 * WebSocket 服务器地址
 * 根据实际部署环境修改
 * 
 * 开发环境：ws://localhost:9000/ws
 * 生产环境：wss://api.example.com:9000/ws
 */
export const WS_URL = 'ws://localhost:9000/ws'

/**
 * WebSocket 心跳间隔（毫秒）
 */
export const WS_HEARTBEAT_INTERVAL = 30000

/**
 * WebSocket 心跳超时（毫秒）
 */
export const WS_HEARTBEAT_TIMEOUT = 10000

/**
 * WebSocket 最大重连次数
 */
export const WS_MAX_RECONNECT_COUNT = 5

/**
 * IM 媒体消息是否优先使用 fileId（灰度开关）
 * - 'true'：上传走 /infra/file/upload-and-return-id，消息 body 双写 fileId + url
 * - 'false'：沿用旧逻辑，仅使用 url
 */
export const IM_MEDIA_USE_FILE_ID = 'true'
