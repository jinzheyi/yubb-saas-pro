package com.shengyu.module.system.service.im.impl;

import cn.hutool.core.util.IdUtil;
import com.shengyu.framework.websocket.core.protocol.ImMessage;
import com.shengyu.framework.websocket.core.protocol.TextMessage;
import com.shengyu.framework.websocket.core.service.MessageStorageService;
import com.shengyu.module.system.dal.dataobject.im.SystemImMessageDO;
import com.shengyu.module.system.dal.mapper.im.SystemImMessageMapper;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.Base64;

/**
 * system 模块消息存储服务实现
 * 
 * 说明：
 * 1. 这是业务模块的实现示例
 * 2. 实现了中间件的 MessageStorageService 接口
 * 3. 负责将消息存储到 system_im_message 表
 * 4. 可以实现额外的业务逻辑（更新会话、统计未读数等）
 *
 * @author 圣钰科技
 */
@Slf4j
@Service
public class SystemMessageStorageServiceImpl implements MessageStorageService {

    @Autowired
    private SystemImMessageMapper messageMapper;

    @Autowired
    private SystemImConversationService conversationService;

    @Override
    public void saveMessage(ImMessage message) {
        try {
            // 1. 转换为业务 DO 对象
            SystemImMessageDO messageDO = convertToMessageDO(message);

            // 2. 保存到数据库
            messageMapper.insert(messageDO);
            log.info("[SystemIM] 消息已保存: messageId={}, type={}, senderId={}, receiverId={}",
                messageDO.getId(), messageDO.getMessageType(), messageDO.getSenderId(), messageDO.getReceiverId());

            // 3. 更新会话（最后一条消息、未读数）
            conversationService.updateConversation(messageDO);

            // 4. 其他业务逻辑...

        } catch (Exception e) {
            log.error("[SystemIM] 保存消息失败", e);
            throw new RuntimeException("保存消息失败", e);
        }
    }

    @Override
    public Long saveMessageWithId(ImMessage message) {
        saveMessage(message);
        return message.getHeader().getMessageId();
    }

    /**
     * 转换 Protobuf 消息为 DO 对象
     */
    private SystemImMessageDO convertToMessageDO(ImMessage message) {
        return SystemImMessageDO.builder()
            .id(message.getHeader().getMessageId())
            .messageType(message.getHeader().getMessageType().getNumber())
            .senderId(message.getHeader().getSenderId())
            .receiverId(message.getHeader().getReceiverId())
            .groupId(message.getHeader().getGroupId())
            .tenantId(message.getHeader().getTenantId())
            .body(Base64.getEncoder().encodeToString(message.getBody().toByteArray()))
            .sequence(message.getHeader().getSequence())
            .status(0) // 默认未读
            .extra(message.getHeader().getExtra())
            .build();
    }
}
